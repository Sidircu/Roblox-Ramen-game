	{ id = "ikura_gunkan", station = "sushi", ing = { "nori", "ikura" }, rice = true, steps = { "combine", "roll" }, price = 180, xp = 44, cat = "sushi", license = "lic_sushi4", icon = "🍣", dish = "gunkan" },
	-- Street food
	{ id = "takoyaki", station = "takoyaki", ing = { "octopus", "batter", "scallion" }, steps = { "pour", "flip" }, price = 110, xp = 28, cat = "side", license = "lic_street", icon = "🐙", dish = "takoyaki" },
	-- Ramen IV
	{ id = "tsukemen", station = "ramen", ing = { "tsukemen_noodles", "chashu", "egg" }, broth = "broth_tonkotsu", steps = { "boil", "pour", "top" }, price = 200, xp = 50, cat = "ramen", license = "lic_ramen4", icon = "🍜", dish = "tsukemen" },
	-- Desserts & matcha
	{ id = "mochi", station = "dessert", ing = { "mochi", "matcha" }, steps = { "combine", "mold" }, price = 70, xp = 18, cat = "dessert", license = "lic_dessert", icon = "🍡", dish = "mochi" },
	{ id = "matcha_latte", station = "drink", ing = { "matcha" }, steps = { "pour" }, price = 60, xp = 14, cat = "drink", license = "lic_dessert", icon = "🍵", dish = "cup" },
	{ id = "ramune", station = "drink", ing = { "ramune" }, steps = { "pour" }, price = 35, xp = 6, cat = "drink", license = "lic_dessert", icon = "🥤", dish = "bottle" },
	-- Masters
	{ id = "otoro_nigiri", station = "sushi", ing = { "otoro" }, rice = true, steps = { "cut", "combine" }, price = 300, xp = 75, cat = "sushi", license = "lic_sushi_master", icon = "🍣", dish = "nigiri" },
	{ id = "omakase", station = "sushi", ing = { "otoro", "yellowtail", "ikura", "shrimp", "nori" }, rice = true, steps = { "cut", "cut", "combine", "roll" }, price = 900, xp = 200, cat = "sushi", license = "lic_sushi_master", icon = "🍱", dish = "platter" },
	{ id = "mayu_ramen", station = "ramen", ing = { "noodles", "black_garlic", "chashu", "egg", "kikurage" }, broth = "broth_tonkotsu", steps = { "boil", "pour", "top" }, price = 320, xp = 80, cat = "ramen", license = "lic_ramen_master", icon = "🍜", dish = "bowl" },
	{ id = "kaiseki", station = "sushi", ing = { "otoro", "ikura", "noodles", "matcha", "mochi" }, rice = true, broth = "broth_tonkotsu", steps = { "cut", "combine", "boil", "pour", "top" }, price = 2000, xp = 450, cat = "sushi", license = "lic_grandmaster", icon = "🎌", dish = "platter" },
	-- Regional dishes (Franchise cities, unlocked at level 5 in that city)
	{ id = "yudofu", station = "ramen", ing = { "tofu", "scallion" }, broth = "broth_shio", steps = { "combine", "pour" }, price = 120, xp = 30, cat = "side", city = "kyoto", icon = "🍲", dish = "soup" },
	{ id = "matcha_soba", station = "ramen", ing = { "tsukemen_noodles", "matcha", "scallion" }, broth = "broth_shoyu", steps = { "boil", "pour", "top" }, price = 220, xp = 55, cat = "ramen", city = "kyoto", icon = "🍵", dish = "bowl" },
	{ id = "okonomiyaki", station = "griddle", ing = { "batter", "minced_pork", "scallion" }, steps = { "pour", "flip", "flip" }, price = 180, xp = 45, cat = "side", city = "osaka", icon = "🥞", dish = "okonomiyaki" },
	{ id = "kushikatsu", station = "fryer", ing = { "chicken", "batter", "sesame" }, steps = { "batter", "fry" }, price = 140, xp = 35, cat = "side", city = "osaka", icon = "🍢", dish = "fried" },
	{ id = "butter_corn_ramen", station = "ramen", ing = { "noodles", "butter", "corn", "chashu" }, broth = "broth_miso", steps = { "boil", "pour", "top" }, price = 260, xp = 65, cat = "ramen", city = "sapporo", icon = "🌽", dish = "bowl" },
	{ id = "jingisukan", station = "griddle", ing = { "minced_pork", "scallion", "corn" }, steps = { "flip", "flip" }, price = 200, xp = 50, cat = "side", city = "sapporo", icon = "🥩", dish = "okonomiyaki" },
	{ id = "hakata_ramen", station = "ramen", ing = { "noodles", "scallion", "kikurage" }, broth = "broth_tonkotsu", steps = { "boil", "pour", "top" }, price = 240, xp = 60, cat = "ramen", city = "fukuoka", icon = "🍜", dish = "bowl" },
	{ id = "yatai_gyoza", station = "griddle", ing = { "gyoza_raw", "chili_oil" }, steps = { "flip", "flip" }, price = 150, xp = 38, cat = "side", city = "fukuoka", icon = "🥟", dish = "gyoza" },
	{ id = "okinawa_soba", station = "ramen", ing = { "noodles", "chashu", "scallion" }, broth = "broth_shio", steps = { "boil", "pour", "top" }, price = 250, xp = 62, cat = "ramen", city = "okinawa", icon = "🍜", dish = "bowl" },
	{ id = "goya_champuru", station = "griddle", ing = { "tofu", "egg", "minced_pork" }, steps = { "combine", "flip" }, price = 210, xp = 52, cat = "side", city = "okinawa", icon = "🥗", dish = "okonomiyaki" },
}

local byId = {}
local byStation = {}
for i, r in ipairs(list) do
	r.order = i
	byId[r.id] = r
	byStation[r.station] = byStation[r.station] or {}
	table.insert(byStation[r.station], r)
	-- sorted ingredient key for exact matching on the board
	local sorted = table.clone(r.ing)
	table.sort(sorted)
	r.key = table.concat(sorted, "+")
end

return {
	list = list,
	byId = byId,
	byStation = byStation,
	Stations = { "sushi", "ramen", "drink", "griddle", "fryer", "takoyaki", "dessert" },
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000021"><Properties><string name="Name">Rewards</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Roblox-style rewards: free gifts for the minutes played in a session, redeemable codes, the
-- serving combo and running. See docs/03-BILANCIAMENTO.md §11.
return {
	-- free gifts unlocked by minutes played in this session (they start again when you rejoin)
	-- yen grow with the level: yen * (1 + level * GiftYenPerLevel); boxes go to the storage room
	Gifts = {
		{ min = 2, yen = 250 },
		{ min = 5, sakura = 2 },
		{ min = 9, boxes = { salmon = 1, noodles = 1 } },
		{ min = 14, yen = 900 },
		{ min = 20, sakura = 5 },
		{ min = 28, yen = 2200 },
		{ min = 38, boxes = { broth_shoyu = 2, rice = 1 } },
		{ min = 50, sakura = 10 },
		{ min = 65, yen = 6000 },
	},
	GiftYenPerLevel = 0.12,
	-- yen given instead of boxes to a helper (boxes belong to the owner's storage room)
	GiftBoxYen = 400,
	-- codes (case does not matter), each works once per player
	Codes = {
		RAMEN = { yen = 500 },
		SAKURA = { sakura = 5 },
		ITADAKIMASU = { yen = 1500 },
		OISHII = { sakura = 10 },
		NEWSHOP = { yen = 3000 },
	},
	-- serving combo: each dish served within Window seconds of the previous one raises the tip
	-- of that customer by Step, up to Max steps
	Combo = { Window = 30, Step = 0.05, Max = 10 },
	-- running: hold Shift (the 🏃 button on phones and tablets)
	RunMultiplier = 1.45,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000022"><Properties><string name="Name">Sets</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Decoration sets: placing every item of a set grants its bonus.
local list = {
	{ id = "matsuri", items = { "lantern_string", "nobori", "taiko", "yatai", "koinobori" }, bonus = { tip = 0.05 } },
	{ id = "zen", items = { "moss_garden", "zen_garden", "shishi_odoshi", "stone_path", "bonsai_pine" }, bonus = { popularity = 0.10 } },
	{ id = "samurai", items = { "samurai_armor", "kakejiku", "byobu", "daruma", "wave_painting" }, bonus = { tip = 0.05 } },
	{ id = "neon", items = { "neon_ramen", "neon_sushi", "vending_machine", "gashapon", "chochin_red" }, bonus = { popularity = 0.10 } },
	{ id = "sakura", items = { "sakura_tree", "koi_pond", "red_bridge", "torii_small", "wagasa" }, bonus = { tip = 0.05, popularity = 0.05 } },
	{ id = "ramenya", items = { "ramenya_canopy", "noren_banner", "menu_posters", "stool_red", "water_pitcher" }, bonus = { tip = 0.04, popularity = 0.06 } },
}
local byId = {}
for i, s in ipairs(list) do
	s.order = i
	byId[s.id] = s
end
return { list = list, byId = byId }
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000023"><Properties><string name="Name">Staff</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Staff roles. Training levels 1..5: cost = hire * 0.8 * 2.2^(level-1), +15% speed per level.
local list = {
	{ id = "staff_waiter", icon = "🧑‍🍳", lv = 5, hire = 3500, salary = 300, tasks = { "order", "serve", "collect", "wash" }, shirt = "#2E3A5C" },
	{ id = "staff_dishwasher", icon = "🧽", lv = 4, hire = 2000, salary = 250, tasks = { "wash", "collect" }, shirt = "#4A7A8C" },
	{ id = "staff_stocker", icon = "📦", lv = 7, hire = 6000, salary = 400, tasks = { "restock", "appliance" }, shirt = "#7A5A2E" },
	{ id = "staff_sushi_chef", icon = "🍣", lv = 9, hire = 15000, salary = 900, tasks = { "cook" }, stations = { "sushi" }, shirt = "#F4F1EA" },
	{ id = "staff_ramen_chef", icon = "🍜", lv = 10, hire = 18000, salary = 1000, tasks = { "cook", "appliance" }, stations = { "ramen" }, shirt = "#F4F1EA" },
	{ id = "staff_line_cook", icon = "🍤", lv = 13, hire = 24000, salary = 1100, tasks = { "cook" }, stations = { "drink", "griddle", "fryer", "takoyaki", "dessert" }, shirt = "#B3262E" },
	{ id = "staff_manager", icon = "🎩", lv = 18, hire = 120000, salary = 3000, tasks = {}, manager = true, shirt = "#1E1E22" },
}

local byId = {}
for i, s in ipairs(list) do
	s.order = i
	byId[s.id] = s
end

local NAMES = {
	"Kenji", "Yuki", "Haruto", "Sakura", "Ren", "Aoi", "Sota", "Hina", "Daiki", "Mei",
	"Takumi", "Yui", "Riku", "Nanami", "Kaito", "Rin", "Hiro", "Emi", "Shun", "Koharu",
}

return {
	list = list,
	byId = byId,
	Names = NAMES,
	MaxTrainLevel = 5,
	-- base slots and extra slots granted by expansions
	BaseSlots = 2,
	SlotsByZone = { zone_east = 1, zone_west = 1, zone_terrace = 1, zone_kitchen_pro = 3, zone_floor2 = 3 },
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000024"><Properties><string name="Name">StarterLayout</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Objects placed in a brand-new restaurant (all can be moved later). The start is plain on
-- purpose: decorations and renovations (Config/Expansions) are bought over time.
-- s: "f" floor, "w" wall (y = height of the object's center), "c" ceiling, "t" on top of item index p
return {
	items = {
		-- long counter facing the dining room: twelve 3-stud modules (one seat and one place setting
		-- each, so customers never overlap) between two ends, 40 studs, low (3) and deep (3.8)
		{ i = "counter_end", x = -23, z = 30.05, r = 0, s = "f" },
		{ i = "counter_straight", x = -20.5, z = 30.05, r = 0, s = "f" },
		{ i = "counter_straight", x = -17.5, z = 30.05, r = 0, s = "f" },
		{ i = "counter_straight", x = -14.5, z = 30.05, r = 0, s = "f" },
		{ i = "counter_straight", x = -11.5, z = 30.05, r = 0, s = "f" },
		{ i = "counter_straight", x = -8.5, z = 30.05, r = 0, s = "f" },
		{ i = "counter_straight", x = -5.5, z = 30.05, r = 0, s = "f" },
		{ i = "counter_straight", x = -2.5, z = 30.05, r = 0, s = "f" },
		{ i = "counter_straight", x = 0.5, z = 30.05, r = 0, s = "f" },
		{ i = "counter_straight", x = 3.5, z = 30.05, r = 0, s = "f" },
		{ i = "counter_straight", x = 6.5, z = 30.05, r = 0, s = "f" },
		{ i = "counter_straight", x = 9.5, z = 30.05, r = 0, s = "f" },
		{ i = "counter_straight", x = 12.5, z = 30.05, r = 0, s = "f" },
		{ i = "counter_end", x = 15, z = 30.05, r = 0, s = "f" },
		-- tip jar on the far end of the counter (index 14 = that end)
		{ i = "tip_jar", x = 15, z = 30.05, r = 0, s = "t", p = 14 },
		{ i = "stool_wood", x = -20.5, z = 27.3, r = 0, s = "f" },
		{ i = "stool_wood", x = -17.5, z = 27.3, r = 0, s = "f" },
		{ i = "stool_wood", x = -14.5, z = 27.3, r = 0, s = "f" },
		{ i = "stool_wood", x = -11.5, z = 27.3, r = 0, s = "f" },
		{ i = "stool_wood", x = -8.5, z = 27.3, r = 0, s = "f" },
		{ i = "stool_wood", x = -5.5, z = 27.3, r = 0, s = "f" },
		{ i = "stool_wood", x = -2.5, z = 27.3, r = 0, s = "f" },
		{ i = "stool_wood", x = 0.5, z = 27.3, r = 0, s = "f" },
		{ i = "stool_wood", x = 3.5, z = 27.3, r = 0, s = "f" },
		{ i = "stool_wood", x = 6.5, z = 27.3, r = 0, s = "f" },
		{ i = "stool_wood", x = 9.5, z = 27.3, r = 0, s = "f" },
		{ i = "stool_wood", x = 12.5, z = 27.3, r = 0, s = "f" },
		-- stations right behind the counter, the cook works facing it
		{ i = "sushi_station", x = -11, z = 33.3, r = 180, s = "f" },
		{ i = "ramen_station", x = -3, z = 33.3, r = 180, s = "f" },
		-- everything against the back wall, 9 studs behind the stations: the two shelves right behind
		-- the stations (the trip you make for every order), then the fitted kitchen unit (rice
		-- cooker, gas range, worktop, sink, worktop) towards the storage door
		{ i = "shelf_small", x = -10.2, z = 44.55, r = 0, s = "f" },
		{ i = "shelf_small", x = -4.4, z = 44.55, r = 0, s = "f" },
		{ i = "rice_cooker", x = -0.1, z = 44.3, r = 0, s = "f" },
		{ i = "broth_pot", x = 3.2, z = 44.3, r = 0, s = "f" },
		{ i = "kitchen_counter", x = 6.5, z = 44.3, r = 0, s = "f" },
		{ i = "sink", x = 9.8, z = 44.3, r = 0, s = "f" },
		{ i = "kitchen_counter", x = 13.1, z = 44.3, r = 0, s = "f" },
		{ i = "storage_rack", x = 48, z = 54.6, r = 0, s = "f" },
		-- a single paper lantern: every other decoration is bought (see docs/01-GAME-DESIGN.md)
		{ i = "chochin_white", x = -6, z = 20, r = 0, s = "c" },
	},
	-- a brand-new restaurant can serve its first customers within seconds: the two shelves start
	-- stocked with the ramen ingredients (one list per shelf, in the order above, one ingredient per
	-- slot, each slot full), the pot full of this broth, the rice cooker full of rice, and a box of
	-- the ingredients that run out first waits in the storage room for the first restock
	stock = {
		{ "noodles", "noodles", "scallion", "naruto" },
		{ "naruto", "scallion" },
	},
	boxes = {
		{ g = "noodles", n = 1 },
		{ g = "naruto", n = 1 },
		{ g = "broth_shoyu", n = 1 },
	},
	broth = "broth_shoyu",

}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000025"><Properties><string name="Name">Surfaces</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Floor and wall styles, applied per zone.
local list = {
	{ id = "floor_wood_light", kind = "floor", price = 0, lv = 1, color = "#C8A27A", material = "WoodPlanks" },
	{ id = "floor_wood_dark", kind = "floor", price = 2000, lv = 3, color = "#5E3E28", material = "WoodPlanks" },
	{ id = "floor_tatami", kind = "floor", price = 5000, lv = 6, color = "#C9C083", material = "Fabric" },
	{ id = "floor_slate", kind = "floor", price = 8000, lv = 10, color = "#4A4D52", material = "Slate" },
	{ id = "floor_pebble", kind = "floor", price = 12000, lv = 14, color = "#9A948A", material = "Cobblestone" },
	{ id = "floor_marble", kind = "floor", price = 40000, lv = 26, color = "#1E1E22", material = "Marble" },
	{ id = "floor_hinoki", kind = "floor", price = 80000, lv = 34, color = "#E3C79A", material = "Wood" },
	{ id = "wall_plaster", kind = "wall", price = 0, lv = 1, color = "#EFE3CC", material = "Plaster" },
	{ id = "wall_wood", kind = "wall", price = 2500, lv = 3, color = "#8A5A36", material = "WoodPlanks" },
	{ id = "wall_shoji", kind = "wall", price = 6000, lv = 7, color = "#F6F0E0", material = "SmoothPlastic", lattice = true },
	{ id = "wall_brick", kind = "wall", price = 9000, lv = 12, color = "#5A3A30", material = "Brick" },
	{ id = "wall_bamboo", kind = "wall", price = 15000, lv = 16, color = "#B8A15A", material = "Wood", stripes = true },
	{ id = "wall_yakisugi", kind = "wall", price = 30000, lv = 22, color = "#262220", material = "Wood" },
	{ id = "wall_gold", kind = "wall", price = 120000, lv = 38, color = "#B8862E", material = "Foil" },
}

local byId = {}
for i, s in ipairs(list) do
	s.order = i
	s.amb = math.min(40, s.price / 1000)
	byId[s.id] = s
end

return {
	list = list,
	byId = byId,
	DefaultFloor = "floor_wood_light",
	DefaultWall = "wall_plaster",
	OutdoorFloor = "deck",
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000026"><Properties><string name="Name">Tutorial</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The first two minutes (Controllers/Tutorial) and the one-time tips that come after it
-- (Controllers/Hints). Rewards are given by the server (Services/Meta) only when the player
-- really did the thing: a dish served, a dish washed.
return {
	-- after the first dish is served: yen to spend in the shop at once
	ServeYen = 1000,
	-- at the end of the tutorial
	DoneSakura = 10,
	-- one-time tips: id -> when it shows (see Controllers/Hints)
	Hints = {
		restock = { shelfLeft = 3 }, -- an ingredient of the menu has this many portions or fewer on the shelves
		dishes = { pile = 3 }, -- this many dirty dishes in the sink
		shop = {}, -- something in the shop can be bought
		staff = { level = 6 }, -- the first member of staff can be hired
	},
	HintSeconds = 12, -- a tip stays this long (or until it is done)
	HintGap = 20, -- seconds between two tips
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000027"><Properties><string name="Name">Upgrades</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Upgrades: costs[n] buys level n, levels[n] is the required restaurant level,
-- values[n + 1] is the effect at level n (values[1] = level 0).
local function geometric(base, factor, count)
	local out = {}
	for i = 1, count do
		out[i] = math.floor(base * factor ^ (i - 1) + 0.5)
	end
	return out
end

local list = {
	{ id = "up_tray", icon = "🍱", max = 4, costs = { 900, 6000, 30000, 120000 }, levels = { 2, 8, 18, 30 }, values = { 1, 2, 3, 4, 5 }, effect = "tray" },
	{ id = "up_shoes", icon = "👟", max = 5, costs = geometric(600, 3, 5), levels = { 1, 4, 8, 14, 22 }, values = { 1, 1.08, 1.16, 1.24, 1.32, 1.40 }, effect = "walk" },
	{ id = "up_knife", icon = "🔪", max = 4, costs = { 1200, 12000, 80000, 350000 }, levels = { 2, 8, 16, 28 }, values = { 1, 0.9, 0.81, 0.73, 0.66 }, effect = "step" },
	{ id = "up_mat", icon = "🎋", max = 3, costs = { 1800, 18000, 120000 }, levels = { 3, 10, 20 }, values = { 1, 0.88, 0.77, 0.68 }, effect = "step" },
	{ id = "up_strainer", icon = "🥢", max = 3, costs = { 1800, 18000, 120000 }, levels = { 3, 10, 20 }, values = { 1, 0.88, 0.77, 0.68 }, effect = "step" },
	{ id = "up_shelf", icon = "🗄️", max = 3, costs = { 5000, 30000, 200000 }, levels = { 4, 12, 24 }, values = { 1, 1.25, 1.5, 1.75 }, effect = "shelf" },
	-- deliveries are immediate (the truck takes a few seconds): this upgrade is a box cart instead
	{ id = "up_cart", icon = "🛒", max = 2, costs = { 1500, 12000 }, levels = { 3, 10 }, values = { 1, 2, 3 }, effect = "cart" },
	{ id = "up_supplier", icon = "📦", max = 2, costs = { 20000, 200000 }, levels = { 10, 25 }, values = { 0, 0.10, 0.20 }, effect = "discount" },
	{ id = "up_sign", icon = "🏮", max = 5, costs = geometric(1200, 4, 5), levels = { 2, 6, 12, 20, 30 }, values = { 0, 0.08, 0.16, 0.24, 0.32, 0.40 }, effect = "popularity" },
	-- customers order by themselves: the order bar holds one ticket per seat at least
	{ id = "up_ticket", icon = "🧾", max = 2, costs = { 6000, 60000 }, levels = { 5, 15 }, values = { 12, 16, 20 }, effect = "tickets" },
	{ id = "up_jukebox", icon = "🎶", max = 3, costs = { 5000, 50000, 300000 }, levels = { 4, 14, 26 }, values = { 0, 15, 40, 90 }, effect = "ambience" },
	{ id = "up_safe", icon = "💰", max = 5, costs = geometric(10000, 4, 5), levels = { 6, 12, 18, 26, 34 }, values = { 0, 2, 4, 8, 12, 24 }, pct = { 0, 0.10, 0.15, 0.20, 0.25, 0.30 }, effect = "offline" },
	{ id = "up_autorestock", icon = "🔁", max = 1, costs = { 120000 }, levels = { 20 }, values = { 0, 1 }, effect = "autorestock", needsStaff = "staff_stocker" },
}

local byId = {}
for i, u in ipairs(list) do
	u.order = i
	byId[u.id] = u
end

local function value(upgrades, id)
	local u = byId[id]
	local lvl = (upgrades and upgrades[id]) or 0
	return u.values[lvl + 1] or u.values[#u.values]
end

return {
	list = list,
	byId = byId,
	value = value,
}
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX000031"><Properties><string name="Name">Locale</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Localization: Locale.t("key", { param = value }). Languages: en (base), it.
local Signal = require(script.Parent.Util.Signal)
local Format = require(script.Parent.Util.Format)

local Locale = {}

local tables = {
	en = require(script.en),
	it = require(script.it),
}

local current = "en"
Locale.Changed = Signal.new()
Locale.Languages = { "en", "it" }

function Locale.resolve(localeId)
	if type(localeId) == "string" and string.sub(string.lower(localeId), 1, 2) == "it" then
		return "it"
	end
	return "en"
end

function Locale.set(lang)
	if not tables[lang] then
		lang = "en"
	end
	if lang ~= current then
		current = lang
		Locale.Changed:Fire(lang)
	end
end

function Locale.get()
	return current
end

function Locale.has(key)
	return tables.en[key] ~= nil
end

local function translate(lang, key, params)
	local s = (tables[lang] or tables.en)[key] or tables.en[key]
	if not s then
		return key
	end
	if params then
		s = string.gsub(s, "{([%w_]+)}", function(name)
			local v = params[name]
			if v == nil then
				return "{" .. name .. "}"
			end
			if type(v) == "number" then
				if math.floor(v) == v then
					return Format.number(v, lang)
				end
				return Format.decimal(v, 1, lang)
			end
			if type(v) == "string" and v ~= key and Locale.has(v) then
				-- nested key (e.g. a dish name); it may use the same params ({n})
				return translate(lang, v, params)
			end
			return tostring(v)
		end)
	end
	return s
end

function Locale.t(key, params)
	return translate(current, key, params)
end

-- Text in a given language (the server uses it for a player's own language, e.g. kick messages)
function Locale.tFor(lang, key, params)
	return translate(Locale.resolve(lang), key, params)
end

-- Display name helpers for config ids
function Locale.name(prefix, id)
	return Locale.t(prefix .. "." .. id)
end

return Locale
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX000029"><Properties><string name="Name">en</string><ProtectedString name="Source"><![CDATA[--!nonstrict
