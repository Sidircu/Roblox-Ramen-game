-- Ambience score, tiers and decoration set bonuses (pure).
local Ambience = {}

Ambience.Tiers = {
	{ min = 0, patience = 0, tip = 0, popularity = 0 },
	{ min = 30, patience = 0.10, tip = 0.05, popularity = 0.10 },
	{ min = 100, patience = 0.20, tip = 0.10, popularity = 0.25 },
	{ min = 250, patience = 0.30, tip = 0.18, popularity = 0.45 },
	{ min = 600, patience = 0.40, tip = 0.25, popularity = 0.70 },
}

function Ambience.tier(points)
	local idx = 1
	for i, t in ipairs(Ambience.Tiers) do
		if points >= t.min then
			idx = i
		end
	end
	return idx - 1, Ambience.Tiers[idx]
end

-- placed: list of placed entries; items: Items.byId; surfaces: Surfaces.byId;
-- zoneSurfaces: { [zoneId] = {floor = id, wall = id} }; extra: flat bonus points
-- sets: Sets.list
function Ambience.compute(placed, items, surfaces, zoneSurfaces, extra, sets)
	local counts = {}
	for _, e in ipairs(placed) do
		counts[e.i] = (counts[e.i] or 0) + 1
	end
	local points = extra or 0
	local maneki = 0
	for id, n in pairs(counts) do
		local item = items[id]
		if item then
			local amb = item.amb or 0
			for k = 1, n do
				points = points + amb * 0.8 ^ (k - 1)
			end
			if item.tipBonus then
				maneki = maneki + item.tipBonus * math.min(n, item.tipMax or n)
			end
		end
	end
	for _, s in pairs(zoneSurfaces or {}) do
		for _, sid in pairs(s) do
			local surf = surfaces[sid]
			if surf then
				points = points + surf.amb
			end
		end
	end
	local setTip, setPop, complete = 0, 0, {}
	for _, set in ipairs(sets or {}) do
		local all = true
		for _, id in ipairs(set.items) do
			if not counts[id] then
				all = false
				break
			end
		end
		if all then
			complete[set.id] = true
			setTip = setTip + (set.bonus.tip or 0)
			setPop = setPop + (set.bonus.popularity or 0)
		end
	end
	local tierIndex, tier = Ambience.tier(points)
	return {
		points = math.floor(points),
		tier = tierIndex,
		patience = tier.patience,
		tip = tier.tip + setTip + maneki,
		popularity = tier.popularity + setPop,
		sets = complete,
	}
end

return Ambience
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000033"><Properties><string name="Name">Footprint</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- 2D oriented rectangles on the XZ plane (pure). A footprint is {x, z, w, d, r} (r in degrees).
local Footprint = {}

function Footprint.new(x, z, w, d, r)
	return { x = x, z = z, w = w, d = d, r = r or 0 }
end

function Footprint.axes(fp)
	local a = math.rad(fp.r)
	-- local X axis and local Z axis expressed in world XZ (rotation around Y)
	local c, s = math.cos(a), math.sin(a)
	return { x = c, z = -s }, { x = s, z = c }
end

function Footprint.corners(fp)
	local ax, az = Footprint.axes(fp)
	local hw, hd = fp.w / 2, fp.d / 2
	local out = {}
	for _, sgn in ipairs({ { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }) do
		table.insert(out, {
			x = fp.x + ax.x * hw * sgn[1] + az.x * hd * sgn[2],
			z = fp.z + ax.z * hw * sgn[1] + az.z * hd * sgn[2],
		})
	end
	return out
end

function Footprint.bounds(fp)
	local minX, minZ, maxX, maxZ = math.huge, math.huge, -math.huge, -math.huge
	for _, c in ipairs(Footprint.corners(fp)) do
		minX = math.min(minX, c.x)
		minZ = math.min(minZ, c.z)
		maxX = math.max(maxX, c.x)
		maxZ = math.max(maxZ, c.z)
	end
	return minX, minZ, maxX, maxZ
end

local function project(corners, axis)
	local mn, mx = math.huge, -math.huge
	for _, c in ipairs(corners) do
		local p = c.x * axis.x + c.z * axis.z
		mn = math.min(mn, p)
		mx = math.max(mx, p)
	end
	return mn, mx
end

-- True when the rectangles overlap by more than `eps` (touching is allowed).
function Footprint.overlaps(a, b, eps)
	eps = eps or 0.05
	local ca, cb = Footprint.corners(a), Footprint.corners(b)
	local a1, a2 = Footprint.axes(a)
	local b1, b2 = Footprint.axes(b)
	for _, axis in ipairs({ a1, a2, b1, b2 }) do
		local amin, amax = project(ca, axis)
		local bmin, bmax = project(cb, axis)
		if amax - eps <= bmin or bmax - eps <= amin then
			return false
		end
	end
	return true
end

function Footprint.inflate(fp, by)
	return { x = fp.x, z = fp.z, w = fp.w + by * 2, d = fp.d + by * 2, r = fp.r }
end

function Footprint.rectToFp(rect)
	local x0, z0, x1, z1 = rect[1], rect[2], rect[3], rect[4]
	return { x = (x0 + x1) / 2, z = (z0 + z1) / 2, w = x1 - x0, d = z1 - z0, r = 0 }
end

function Footprint.pointInRect(x, z, rect, tol)
	tol = tol or 0
	return x >= rect[1] - tol and x <= rect[3] + tol and z >= rect[2] - tol and z <= rect[4] + tol
end

function Footprint.pointIn(fp, x, z, tol)
	tol = tol or 0
	local ax, az = Footprint.axes(fp)
	local dx, dz = x - fp.x, z - fp.z
	local lx = dx * ax.x + dz * ax.z
	local lz = dx * az.x + dz * az.z
	return math.abs(lx) <= fp.w / 2 + tol and math.abs(lz) <= fp.d / 2 + tol
end

-- Sample points (corners, edge midpoints, center) all inside the union of rects.
function Footprint.insideRects(fp, rects, tol)
	tol = tol or 0.01
	local pts = Footprint.corners(fp)
	local n = #pts
	for i = 1, n do
		local a, b = pts[i], pts[i % n + 1]
		table.insert(pts, { x = (a.x + b.x) / 2, z = (a.z + b.z) / 2 })
	end
	table.insert(pts, { x = fp.x, z = fp.z })
	for _, p in ipairs(pts) do
		local inside = false
		for _, r in ipairs(rects) do
			if Footprint.pointInRect(p.x, p.z, r, tol) then
				inside = true
				break
			end
		end
		if not inside then
			return false
		end
	end
	return true
end

-- Footprint of a wall segment {axis, line, a, b} with given thickness.
function Footprint.wallFp(seg, thickness)
	if seg.axis == "z" then
		return { x = (seg.a + seg.b) / 2, z = seg.line, w = seg.b - seg.a, d = thickness, r = 0 }
	end
	return { x = seg.line, z = (seg.a + seg.b) / 2, w = thickness, d = seg.b - seg.a, r = 0 }
end

-- Subtracts rect `hole` from rect `r`; returns up to 4 rects.
function Footprint.subtractRect(r, hole)
	local x0, z0, x1, z1 = r[1], r[2], r[3], r[4]
	local hx0, hz0 = math.max(x0, hole[1]), math.max(z0, hole[2])
	local hx1, hz1 = math.min(x1, hole[3]), math.min(z1, hole[4])
	if hx0 >= hx1 or hz0 >= hz1 then
		return { r }
	end
	local out = {}
	if hz0 > z0 then
		table.insert(out, { x0, z0, x1, hz0 })
	end
	if hz1 < z1 then
		table.insert(out, { x0, hz1, x1, z1 })
	end
	if hx0 > x0 then
		table.insert(out, { x0, hz0, hx0, hz1 })
	end
	if hx1 < x1 then
		table.insert(out, { hx1, hz0, x1, hz1 })
	end
	return out
end

return Footprint
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000034"><Properties><string name="Name">Formulas</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Pure game formulas (no Roblox APIs). See docs/03-BILANCIAMENTO.md §1.
local Formulas = {}

Formulas.MaxLevel = 50
Formulas.MasteryThresholds = { 25, 100, 500, 2000, 10000 }

function Formulas.round(x)
	return math.floor(x + 0.5)
end

function Formulas.xpForLevel(level)
	return Formulas.round(50 * level ^ 1.6)
end

-- Adds xp to (level, xp) and returns newLevel, newXp, levelsGained
function Formulas.addXp(level, xp, amount)
	xp = xp + amount
	local gained = 0
	while level < Formulas.MaxLevel and xp >= Formulas.xpForLevel(level) do
		xp = xp - Formulas.xpForLevel(level)
		level = level + 1
		gained = gained + 1
	end
	if level >= Formulas.MaxLevel then
		xp = math.min(xp, Formulas.xpForLevel(level))
	end
	return level, xp, gained
end

function Formulas.levelReward(level)
	return 50 * level * level, (level % 5 == 0) and 5 or 0
end

function Formulas.masteryLevel(served)
	local lvl = 0
	for i, t in ipairs(Formulas.MasteryThresholds) do
		if (served or 0) >= t then
			lvl = i
		end
	end
	return lvl
end

-- Price paid for a dish before tips.
function Formulas.dishPrice(basePrice, served, priceMult)
	local m = Formulas.masteryLevel(served)
	return Formulas.round(basePrice * (1 + 0.05 * m) * (priceMult or 1))
end

-- Relative order probability for a menu price multiplier (0.7 .. 1.3)
function Formulas.demandFactor(priceMult)
	return math.max(0.1, 1 - 1.2 * ((priceMult or 1) - 1))
end

function Formulas.patienceFactor(priceMult)
	return math.clamp(1 - 0.5 * ((priceMult or 1) - 1), 0.75, 1.2)
end

-- opts: fresh(bool), ambienceTip, comfort (0-5), patienceLeft (0-1), customerTip, extraTip
function Formulas.tip(price, opts)
	local pct = 0.05
	if opts.fresh then
		pct = pct + (opts.freshBonus or 0.10)
	end
	pct = pct + (opts.ambienceTip or 0)
	pct = pct + 0.02 * (opts.comfort or 0)
	pct = pct + 0.10 * math.clamp(opts.patienceLeft or 0, 0, 1)
	pct = pct + (opts.extraTip or 0)
	return Formulas.round(price * pct * (opts.customerTip or 1))
end

-- Review stars (1..5). opts: patienceLeft, dirtyNearby, fresh, ambienceTier (0..4), comfort (0..5), left (walked out)
function Formulas.review(opts)
	if opts.left then
		return 1
	end
	local used = 1 - math.clamp(opts.patienceLeft or 1, 0, 1)
	local wait = 0
	if used > 0.5 then
		wait = (used - 0.5) / 0.5 * 2
	end
	local stars = 4.2 - wait
	if opts.dirtyNearby then
		stars = stars - 0.5
	end
	if opts.fresh then
		stars = stars + (opts.freshBonus or 0.3)
	end
	stars = stars + 0.125 * (opts.ambienceTier or 0)
	stars = stars + 0.06 * (opts.comfort or 0)
	return math.clamp(Formulas.round(stars * 2) / 2, 1, 5)
end

-- Weighted average of recent reviews { {s = stars, w = weight}, ... }
function Formulas.rating(recent, default)
	local sum, weight = 0, 0
	for _, r in ipairs(recent or {}) do
		sum = sum + r.s * (r.w or 1)
		weight = weight + (r.w or 1)
	end
	if weight == 0 then
		return default or 3
	end
	return sum / weight
end

-- opts: level, rating, ambience (tier popularity), sign, ads, sets, event, extra
function Formulas.popularity(opts)
	local p = 0.15 * ((opts.level or 1) / 10)
		+ 0.35 * ((opts.rating or 3) - 3)
		+ (opts.ambience or 0)
		+ (opts.sign or 0)
		+ (opts.ads or 0)
		+ (opts.sets or 0)
		+ (opts.event or 0)
		+ (opts.extra or 0)
	return math.max(0, p)
end

function Formulas.customerInterval(base, minInterval, popularity, peak, peakFactor, rush)
	local v = math.max(minInterval, base / (1 + popularity))
	if peak then
		v = v * (peakFactor or 0.6)
	end
	if rush then
		v = v * 0.5
	end
	return math.max(minInterval * 0.5, v)
end

function Formulas.staffTrainCost(hire, nextLevel)
	return Formulas.round(hire * 0.8 * 2.2 ^ (nextLevel - 2))
end

function Formulas.staffSpeed(level, perLevel, managerBonus)
	return 1 + (perLevel or 0.15) * ((level or 1) - 1) + (managerBonus or 0)
end

function Formulas.offlineEarnings(hourly, pct, hours)
	return Formulas.round(math.max(0, hourly) * pct * hours)
end

function Formulas.questTarget(base, perLevel, level)
	return math.max(1, Formulas.round(base + perLevel * level))
end

function Formulas.yenPack(baseYen, level, scale)
	return Formulas.round(baseYen * (1 + level * (scale or 0.2)))
end

-- Multiplier applied to every yen income: VIP/2x passes, franchise stars, boosts
function Formulas.incomeMultiplier(opts)
	local m = 1 + (opts.franchiseStars or 0) * (opts.yenPerStar or 0.25)
	m = m * (opts.passMult or 1)
	return m
end

return Formulas
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000035"><Properties><string name="Name">Geometry</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Unlocked restaurant geometry (zones, openings, stairs, walls, door clearances) computed from
-- the owner's `zones` map. Shared by the server world builder and the client build preview.
local Walls = require(script.Parent.Walls)

local Geometry = {}

-- Normalised stairs: every staircase gets rects (lower floor footprint), hole (opening in the
-- floor above), entry / exit points and their clearance rects. Old single-rect stairs rise
-- towards +Z.
function Geometry.stairs(s)
	if s.hole then
		return s
	end
	local r = s.rect
	local cx = (r[1] + r[3]) / 2
	return {
		floor = s.floor,
		rect = r,
		rects = { r },
		hole = r,
		flights = { { rect = r, dir = "+z", from = 0, to = 1 } },
		entry = { x = cx, z = r[2] - 0.5 },
		exit = { x = cx, z = r[4] + 1 },
		exitSide = "z+",
		entryRect = { r[1], r[2] - 2.5, r[3], r[2] },
		exitRect = { r[1], r[4], r[3], r[4] + 2.5 },
	}
end

-- expansions: Config.Expansions.list ; unlocked: { [expansionId] = true }
-- points: the Config.Expansions module (Supplier, MenuBoard, FacadeBand) or just the supplier
function Geometry.compute(expansions, unlocked, points)
	local zones, openings, stairs, exps = {}, {}, {}, {}
	for _, e in ipairs(expansions) do
		if unlocked[e.id] then
			table.insert(exps, e)
			for _, z in ipairs(e.zones or {}) do
				table.insert(zones, z)
			end
			for _, o in ipairs(e.openings or {}) do
				table.insert(openings, o)
			end
			for _, s in ipairs(e.stairs or {}) do
				table.insert(stairs, Geometry.stairs(s))
			end
		end
	end
	local fixed = {}
	for _, o in ipairs(openings) do
		if o.axis == "z" then
			table.insert(fixed, { floor = o.floor, rect = { o.from, o.at - 2.5, o.to, o.at + 2.5 } })
		else
			table.insert(fixed, { floor = o.floor, rect = { o.at - 2.5, o.from, o.at + 2.5, o.to } })
		end
	end
	for _, s in ipairs(stairs) do
		table.insert(fixed, { floor = s.floor, rect = s.entryRect })
		table.insert(fixed, { floor = s.floor + 1, rect = s.exitRect })
	end
	points = points or {}
	local supplier = points.Supplier or (points.x and points) or nil
	-- machiya facade details (lattice, bamboo fence, pines) in front of the street wall
	table.insert(fixed, { floor = 0, rect = points.FacadeBand or { -60, -1.6, 50, 0 } })
	local mb = points.MenuBoard
	if mb then
		table.insert(fixed, { floor = 0, rect = { mb.x - 1.6, mb.z - 1, mb.x + 1.6, mb.z + 1 } })
	end
	if supplier then
		table.insert(fixed, { floor = 0, rect = { supplier.x - 1.2, supplier.z - 1.5, supplier.x + 0.3, supplier.z + 1.5 } })
	end
	return {
		zones = zones,
		openings = openings,
		stairs = stairs,
		expansions = exps,
		walls = Walls.compute(zones, openings, stairs),
		fixed = fixed,
	}
end

function Geometry.ctx(geo, items, placed, cfg)
	return {
		items = items,
		zones = geo.zones,
		walls = geo.walls,
		stairs = geo.stairs,
		placed = placed,
		fixed = geo.fixed,
		entrance = { x = 0, z = 0.75 },
		floorHeight = cfg.FloorHeight,
		wallHeight = cfg.WallHeight,
		wallThickness = 0.8,
	}
end

return Geometry
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000036"><Properties><string name="Name">Grid</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Grid snapping helpers (pure).
local Grid = {}

function Grid.normRot(deg)
	deg = deg % 360
	if deg < 0 then
		deg = deg + 360
	end
	return deg
end

-- Axis-aligned extents of a w x d rectangle rotated by deg around Y.
function Grid.aabb(w, d, deg)
	local r = math.rad(deg)
	local c, s = math.abs(math.cos(r)), math.abs(math.sin(r))
	return w * c + d * s, w * s + d * c
end

function Grid.snapValue(v, g)
	return math.floor(v / g + 0.5) * g
end

-- Snaps the footprint's minimum corner to the grid (relative to origin 0,0) and returns the center.
function Grid.snapFloor(x, z, w, d, deg, g)
	local ew, ed = Grid.aabb(w, d, deg)
	local minX = Grid.snapValue(x - ew / 2, g)
	local minZ = Grid.snapValue(z - ed / 2, g)
	return minX + ew / 2, minZ + ed / 2
end

-- Snaps a position along a wall (1D) and a height.
function Grid.snapWall(along, y, w, h, g, floorY)
	local a = Grid.snapValue(along - w / 2, g) + w / 2
	local yy = Grid.snapValue(y - h / 2 - floorY, math.min(g, 5)) + h / 2 + floorY
	return a, yy
end

function Grid.nextRotation(deg, step)
	return Grid.normRot(deg + step)
end

return Grid
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000037"><Properties><string name="Name">Locks</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- What a station or the rice cooker still needs before it can be used (for the 🔒 hints): the
-- cheapest-level license that unlocks one of its recipes, or nil when an owned license already does.
local Locks = {}

local function firstLicense(recipes, licenses, owned, match)
	local best = nil
	for _, r in ipairs(recipes.list) do
		if match(r) and not r.city then
			if owned[r.license] then
				return nil
			end
			local lic = licenses.byId[r.license]
			if lic and (not best or lic.level < best.level) then
				best = lic
			end
		end
	end
	return best
end

-- stationType = Items fn.station ("sushi", "ramen"...); owned = { [licenseId] = true }
function Locks.station(stationType, owned, recipes, licenses)
	return firstLicense(recipes, licenses, owned or {}, function(r)
		return r.station == stationType
	end)
end

function Locks.rice(owned, recipes, licenses)
	return firstLicense(recipes, licenses, owned or {}, function(r)
		return r.rice == true
	end)
end

return Locks
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000038"><Properties><string name="Name">Pathgrid</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Walkability check used when placing objects: every seat must stay reachable from the
-- entrance, the kitchen and the storage must stay reachable, stairs must stay usable.
-- Works on a 0.5-stud grid per floor (pure).
local Footprint = require(script.Parent.Footprint)
local Walls = require(script.Parent.Walls)

local Pathgrid = {}

local CELL = 0.5
local WALL_CLEAR = 0.4 + 0.6 -- half wall thickness + body radius

-- ctx: { zones = {...}, walls = Walls.compute(...) result, stairs = {...}, entrance = {x, z} }
-- obstacles: list of { fp = footprint, floor = n }
-- targets: list of { floor, x, z, radius, label }
function Pathgrid.check(ctx, obstacles, targets, clearance)
	clearance = clearance or 0.8
	local byFloor = {}
	for _, z in ipairs(ctx.zones) do
		byFloor[z.floor] = byFloor[z.floor] or { rects = {} }
		table.insert(byFloor[z.floor].rects, z.rect)
	end
	local grids = {}
	local function grid(floor)
		if grids[floor] then
			return grids[floor]
		end
		local f = byFloor[floor]
		if not f then
			return nil
		end
		local minX, minZ, maxX, maxZ = math.huge, math.huge, -math.huge, -math.huge
		for _, r in ipairs(f.rects) do
			minX, minZ = math.min(minX, r[1]), math.min(minZ, r[2])
			maxX, maxZ = math.max(maxX, r[3]), math.max(maxZ, r[4])
		end
		local nx = math.floor((maxX - minX) / CELL + 0.5)
		local nz = math.floor((maxZ - minZ) / CELL + 0.5)
		local g = { minX = minX, minZ = minZ, nx = nx, nz = nz, free = {} }
		local floorWalls = ctx.walls[floor] or { walls = {}, rails = {} }
		local free = g.free
		-- visit every cell whose center lies inside the box [x0,x1] x [z0,z1]
		local function each(x0, z0, x1, z1, fn)
			local i0 = math.max(0, math.ceil((x0 - minX) / CELL - 0.5))
			local i1 = math.min(nx - 1, math.floor((x1 - minX) / CELL - 0.5))
			local j0 = math.max(0, math.ceil((z0 - minZ) / CELL - 0.5))
			local j1 = math.min(nz - 1, math.floor((z1 - minZ) / CELL - 0.5))
			for i = i0, i1 do
				for j = j0, j1 do
					fn(i, j, minX + (i + 0.5) * CELL, minZ + (j + 0.5) * CELL)
				end
			end
		end
		for _, r in ipairs(f.rects) do
			each(r[1], r[2], r[3], r[4], function(i, j)
				free[i * nz + j] = true
			end)
		end
		local function clearBox(x0, z0, x1, z1)
			each(x0, z0, x1, z1, function(i, j)
				free[i * nz + j] = nil
			end)
		end
		for _, s in ipairs(ctx.stairs or {}) do
			local h = s.hole or s.rect
			if s.floor == floor - 1 then
				clearBox(h[1], h[2], h[3], h[4])
			elseif s.floor == floor then
				-- the stairs themselves are not floor you can walk across
				for _, r in ipairs(s.rects or { s.rect }) do
					clearBox(r[1], r[2], r[3], r[4])
				end
			end
		end
		for _, list in ipairs({ floorWalls.walls, floorWalls.rails }) do
			for _, seg in ipairs(list) do
				if seg.axis == "z" then
					clearBox(seg.a - WALL_CLEAR, seg.line - WALL_CLEAR, seg.b + WALL_CLEAR, seg.line + WALL_CLEAR)
				else
					clearBox(seg.line - WALL_CLEAR, seg.a - WALL_CLEAR, seg.line + WALL_CLEAR, seg.b + WALL_CLEAR)
				end
			end
		end
		for _, o in ipairs(obstacles) do
			if o.floor == floor then
				local fp = Footprint.inflate(o.fp, clearance)
				local bx0, bz0, bx1, bz1 = Footprint.bounds(fp)
				each(bx0, bz0, bx1, bz1, function(i, j, x, z)
					if Footprint.pointIn(fp, x, z) then
						free[i * nz + j] = nil
					end
				end)
			end
		end
		grids[floor] = g
		return g
	end

	local function cellOf(g, x, z)
		return math.floor((x - g.minX) / CELL), math.floor((z - g.minZ) / CELL)
	end

	local reached = {}
	local function flood(floor, sx, sz)
		local g = grid(floor)
		if not g then
			return
		end
		reached[floor] = reached[floor] or {}
		local seen = reached[floor]
		-- start from the nearest free cell within 2 studs of the start point
		local si, sj = cellOf(g, sx, sz)
		local start = nil
		for radius = 0, 4 do
			for di = -radius, radius do
				for dj = -radius, radius do
					local i, j = si + di, sj + dj
					if not start and i >= 0 and j >= 0 and i < g.nx and j < g.nz and g.free[i * g.nz + j] then
						start = { i, j }
					end
				end
			end
			if start then
				break
			end
		end
		if not start then
			return
		end
		local queue = { start }
		local head = 1
		seen[start[1] * g.nz + start[2]] = true
		while head <= #queue do
			local c = queue[head]
			head = head + 1
			local i, j = c[1], c[2]
			for _, d in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
				local ni, nj = i + d[1], j + d[2]
				if ni >= 0 and nj >= 0 and ni < g.nx and nj < g.nz then
					local id = ni * g.nz + nj
					if g.free[id] and not seen[id] then
						seen[id] = true
						table.insert(queue, { ni, nj })
					end
				end
			end
		end
	end

	local function isReached(floor, x, z, radius)
		local g = grid(floor)
		if not g or not reached[floor] then
			return false
		end
		local ci, cj = cellOf(g, x, z)
		local cells = math.ceil(radius / CELL)
		for di = -cells, cells do
			for dj = -cells, cells do
				local i, j = ci + di, cj + dj
				if i >= 0 and j >= 0 and i < g.nx and j < g.nz and reached[floor][i * g.nz + j] then
					local px = g.minX + (i + 0.5) * CELL
					local pz = g.minZ + (j + 0.5) * CELL
					if (px - x) ^ 2 + (pz - z) ^ 2 <= radius * radius then
						return true
					end
				end
			end
		end
		return false
	end

	-- Floor 0 from the entrance, upper floors from the top of their stairs
	flood(0, ctx.entrance.x, ctx.entrance.z)
	local stairs = ctx.stairs or {}
	table.sort(stairs, function(a, b)
		return a.floor < b.floor
	end)
	for _, s in ipairs(stairs) do
		local r = s.rect
		local cx = (r[1] + r[3]) / 2
		local entry = s.entry or { x = cx, z = r[2] - 0.5 }
		local exit = s.exit or { x = cx, z = r[4] + 1 }
		if isReached(s.floor, entry.x, entry.z, 1.6) then
			flood(s.floor + 1, exit.x, exit.z)
		end
	end
	local function isReachedRect(floor, rect)
		local g = grid(floor)
		if not g or not reached[floor] then
			return false
		end
		for id in pairs(reached[floor]) do
			local i = math.floor(id / g.nz)
			local j = id - i * g.nz
			local px = g.minX + (i + 0.5) * CELL
			local pz = g.minZ + (j + 0.5) * CELL
			if Footprint.pointInRect(px, pz, rect) then
				return true
			end
		end
		return false
	end
	for _, t in ipairs(targets) do
		local ok
		if t.rect then
			ok = isReachedRect(t.floor, t.rect)
		else
			ok = isReached(t.floor, t.x, t.z, t.radius or 2)
		end
		if not ok then
			return false, t.label
		end
	end
	return true
end

return Pathgrid
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000039"><Properties><string name="Name">Placement</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Placement validation shared by the client preview and the server (pure).
--
-- ctx = {
--   items = Items.byId, zones = { unlocked zone configs }, walls = Walls.compute(...),
--   stairs = { {floor, rect} }, placed = { placed entries }, fixed = { {floor, rect} },
--   entrance = {x, z}, floorHeight = 15, wallHeight = 14, wallThickness = 0.8,
--   extraTargets = { pathgrid targets },
-- }
-- req = { i = itemId, x, y, z, r, f, s, p, u (when moving an existing object) }
local Footprint = require(script.Parent.Footprint)
local Walls = require(script.Parent.Walls)
local Pathgrid = require(script.Parent.Pathgrid)

local Placement = {}

local PLACE_CODE = { floor = "f", wall = "w", ceiling = "c", top = "t" }
Placement.PlaceCode = PLACE_CODE

local SURFACE_FN = { counter = true, table = true, booth = true, worktop = true }

local function contains(list, v)
	for _, x in ipairs(list) do
		if x == v then
			return true
		end
	end
	return false
end

function Placement.floorY(ctx, f)
	return (f or 0) * ctx.floorHeight
end

function Placement.footprint(ctx, entry)
	local item = ctx.items[entry.i]
	return Footprint.new(entry.x, entry.z, item.size[1], item.size[3], entry.r or 0)
end

-- World-space axis aligned box {x0,y0,z0,x1,y1,z1} of a placed entry (rotations multiple of 90 for walls)
function Placement.box(ctx, entry)
	local item = ctx.items[entry.i]
	local fp = Placement.footprint(ctx, entry)
	local x0, z0, x1, z1 = Footprint.bounds(fp)
	local y0
	if entry.s == "f" then
		y0 = Placement.floorY(ctx, entry.f)
	elseif entry.s == "c" then
		y0 = Placement.floorY(ctx, entry.f) + ctx.wallHeight - item.size[2]
	else
		y0 = (entry.y or 0) - item.size[2] / 2
	end
	return { x0, y0, z0, x1, y0 + item.size[2], z1 }
end

local function boxesOverlap(a, b, eps)
	eps = eps or 0.05
	return a[1] < b[4] - eps and b[1] < a[4] - eps and a[2] < b[5] - eps and b[2] < a[5] - eps and a[3] < b[6] - eps and b[3] < a[6] - eps
end

local function zoneRects(ctx, floor, areas, indoorOnly)
	local out = {}
	for _, z in ipairs(ctx.zones) do
		if z.floor == floor and contains(areas, z.area) and not (indoorOnly and z.outdoor) then
			table.insert(out, z.rect)
		end
	end
	return out
end

-- Pathgrid targets for the current layout (seats, kitchen, storage, stairs, terrace gap)
function Placement.pathTargets(ctx, placed)
	local targets = {}
	for _, e in ipairs(placed) do
		local item = ctx.items[e.i]
		if item and item.fn and e.s == "f" then
			if item.fn.type == "seat" then
				table.insert(targets, { floor = e.f or 0, x = e.x, z = e.z, radius = math.max(item.size[1], item.size[3]) / 2 + 1.5, label = "msg.place_blocks_seat" })
			elseif item.fn.type == "booth" then
				table.insert(targets, { floor = e.f or 0, x = e.x, z = e.z, radius = math.max(item.size[1], item.size[3]) / 2 + 1.5, label = "msg.place_blocks_seat" })
			elseif item.fn.type == "shelf" or item.fn.type == "station" or item.fn.type == "rack" then
				table.insert(targets, { floor = e.f or 0, x = e.x, z = e.z, radius = math.max(item.size[1], item.size[3]) / 2 + 1.5, label = "msg.place_blocks_work" })
			end
		end
	end
	for _, z in ipairs(ctx.zones) do
		if z.area == "kitchen" or z.area == "storage" then
			table.insert(targets, { floor = z.floor, rect = z.rect, label = "msg.place_blocks_path" })
		end
	end
	for _, s in ipairs(ctx.stairs or {}) do
		local r = s.rect
		local entry = s.entry or { x = (r[1] + r[3]) / 2, z = r[2] - 0.5 }
		table.insert(targets, { floor = s.floor, x = entry.x, z = entry.z, radius = 1.6, label = "msg.place_blocks_stairs" })
	end
	for _, t in ipairs(ctx.extraTargets or {}) do
		table.insert(targets, t)
	end
	return targets
end

function Placement.pathOk(ctx, placed)
	local obstacles = {}
	for _, e in ipairs(placed) do
		local item = ctx.items[e.i]
		if item and e.s == "f" and not item.walkable then
			table.insert(obstacles, { fp = Placement.footprint(ctx, e), floor = e.f or 0 })
		end
	end
	return Pathgrid.check(ctx, obstacles, Placement.pathTargets(ctx, placed))
end

-- Returns ok, reasonKey, resolved (req with y filled in)
function Placement.validate(ctx, req, skipPath)
	local item = ctx.items[req.i]
	if not item then
		return false, "msg.invalid"
	end
	local code = PLACE_CODE[item.place]
	if req.s ~= code then
		return false, "msg.invalid"
	end
	local f = req.f or 0
	local floorY = Placement.floorY(ctx, f)
	local w, h, d = item.size[1], item.size[2], item.size[3]
	local fp = Footprint.new(req.x, req.z, w, d, req.r or 0)
	local resolved = { i = req.i, x = req.x, z = req.z, r = req.r or 0, f = f, s = code, p = req.p, u = req.u }
	local floorWalls = ctx.walls[f] or { walls = {}, rails = {} }

	local others = {}
	for _, e in ipairs(ctx.placed) do
		if e.u ~= req.u then
			table.insert(others, e)
		end
	end

	if code == "f" then
		resolved.y = floorY
		if not Footprint.insideRects(fp, zoneRects(ctx, f, item.areas, false)) then
			return false, "msg.place_area"
		end
		for _, list in ipairs({ floorWalls.walls, floorWalls.rails }) do
			for _, seg in ipairs(list) do
				if Footprint.overlaps(fp, Footprint.wallFp(seg, ctx.wallThickness), 0.02) then
					return false, "msg.place_wall"
				end
			end
		end
		for _, s in ipairs(ctx.stairs or {}) do
			local blocked = false
			if s.floor == f then
				for _, r in ipairs(s.rects or { s.rect }) do
					if Footprint.overlaps(fp, Footprint.rectToFp(r), 0.02) then
						blocked = true
					end
				end
			elseif s.floor == f - 1 and Footprint.overlaps(fp, Footprint.rectToFp(s.hole or s.rect), 0.02) then
				blocked = true
			end
			if blocked then
				return false, "msg.place_stairs"
			end
		end
		for _, fx in ipairs(ctx.fixed or {}) do
			if fx.floor == f and Footprint.overlaps(fp, Footprint.rectToFp(fx.rect), 0.02) then
				return false, "msg.place_door"
			end
		end
		for _, e in ipairs(others) do
			if e.s == "f" and (e.f or 0) == f then
				if Footprint.overlaps(fp, Placement.footprint(ctx, e)) then
					return false, "msg.place_overlap"
				end
			elseif e.s == "w" and (e.f or 0) == f then
				local box = { 0, floorY, 0, 0, floorY + h, 0 }
				local x0, z0, x1, z1 = Footprint.bounds(fp)
				box[1], box[3], box[4], box[6] = x0, z0, x1, z1
				if boxesOverlap(box, Placement.box(ctx, e)) then
					return false, "msg.place_overlap"
				end
			end
		end
		if not skipPath and not item.walkable then
			local layout = table.clone(others)
			table.insert(layout, resolved)
			local ok, reason = Placement.pathOk(ctx, layout)
			if not ok then
				return false, reason or "msg.place_blocks_path"
			end
		end
		return true, nil, resolved
	elseif code == "w" then
		local half = ctx.wallThickness / 2 + d / 2
		local best, bestErr = nil, math.huge
		for _, seg in ipairs(floorWalls.walls) do
			local dist
			if seg.axis == "z" then
				dist = math.abs(req.z - seg.line)
			else
				dist = math.abs(req.x - seg.line)
			end
			local along = Walls.along(seg, req.x, req.z)
			if math.abs(dist - half) < 0.2 and along - w / 2 >= seg.a - 0.01 and along + w / 2 <= seg.b + 0.01 then
				if math.abs(dist - half) < bestErr then
					best, bestErr = seg, math.abs(dist - half)
				end
			end
		end
		if not best then
			return false, "msg.place_wall_only"
		end
		-- facing away from the wall
		local rot
		if best.axis == "z" then
			rot = (req.z < best.line) and 0 or 180
			resolved.z = best.line + ((req.z < best.line) and -half or half)
		else
			rot = (req.x < best.line) and 90 or 270
			resolved.x = best.line + ((req.x < best.line) and -half or half)
		end
		resolved.r = rot
		local y = req.y or (floorY + 6)
		if y - h / 2 < floorY + 0.3 or y + h / 2 > floorY + ctx.wallHeight - 0.3 then
			return false, "msg.place_height"
		end
		resolved.y = y
		local insideArea = false
		for _, z in ipairs(ctx.zones) do
			if z.floor == f and not z.outdoor and contains(item.areas, z.area) and Footprint.pointInRect(resolved.x, resolved.z, z.rect) then
				insideArea = true
			end
		end
		if not insideArea then
			return false, "msg.place_area"
		end
		local myBox = Placement.box(ctx, resolved)
		for _, e in ipairs(others) do
			if (e.f or 0) == f and (e.s == "w" or e.s == "f") then
				if boxesOverlap(myBox, Placement.box(ctx, e)) then
					return false, "msg.place_overlap"
				end
			end
		end
		return true, nil, resolved
	elseif code == "c" then
		resolved.y = floorY + ctx.wallHeight - h / 2
		if not Footprint.insideRects(fp, zoneRects(ctx, f, item.areas, true)) then
			return false, "msg.place_area"
		end
		for _, s in ipairs(ctx.stairs or {}) do
			if s.floor == f and Footprint.overlaps(fp, Footprint.rectToFp(s.rect), 0.02) then
				return false, "msg.place_stairs"
			end
		end
		for _, e in ipairs(others) do
			if e.s == "c" and (e.f or 0) == f and Footprint.overlaps(fp, Placement.footprint(ctx, e)) then
				return false, "msg.place_overlap"
			end
		end
		return true, nil, resolved
	elseif code == "t" then
		local parent = nil
		for _, e in ipairs(others) do
			if e.u == req.p then
				parent = e
			end
		end
		if not parent then
			return false, "msg.place_top_only"
		end
		local pItem = ctx.items[parent.i]
		if not (pItem and pItem.fn and SURFACE_FN[pItem.fn.type]) then
			return false, "msg.place_top_only"
		end
		resolved.f = parent.f or 0
		resolved.y = Placement.floorY(ctx, resolved.f) + pItem.size[2]
		local pfp = Placement.footprint(ctx, parent)
		for _, c in ipairs(Footprint.corners(fp)) do
			if not Footprint.pointIn(pfp, c.x, c.z, -0.05) then
				return false, "msg.place_top_only"
			end
		end
		for _, e in ipairs(others) do
			if e.s == "t" and e.p == req.p and Footprint.overlaps(fp, Placement.footprint(ctx, e)) then
				return false, "msg.place_overlap"
			end
		end
		return true, nil, resolved
	end
	return false, "msg.invalid"
end

return Placement
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000040"><Properties><string name="Name">ShelfGrid</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Product grid of a shelf slot. A slot holds half a supplier box (GameConfig.BoxShelfSlots = 2) laid
-- out like a chessboard (2x3, 2x5, 3x5...), so a glance tells how many products fit and how many
-- are missing. The shelf upgrade adds rows towards the back.
local ShelfGrid = {}

-- columns (across) and rows (front to back) for n products: the most square layout with at most
-- 5 columns; numbers that do not split evenly leave a few cells of the last row unused
function ShelfGrid.dims(n)
	n = math.max(1, math.floor(n))
	local bestC, bestR = nil, nil
	for r = 1, n do
		if n % r == 0 then
			local c = math.floor(n / r)
			if c >= r and c <= 5 then
				if not bestC or (c - r) < (bestC - bestR) then
					bestC, bestR = c, r
				end
			end
		end
	end
	if not bestC then
		bestC = math.min(5, n)
		bestR = math.ceil(n / bestC)
	end
	return bestC, bestR
end

-- grid of one slot for an ingredient whose box holds `units`, split over `slotsPerBox` slots;
-- mult = shelf upgrade multiplier (extra rows, rounded)
function ShelfGrid.forIngredient(units, slotsPerBox, mult)
	local per = math.max(1, math.ceil(units / math.max(1, slotsPerBox)))
	local cols, rows = ShelfGrid.dims(per)
	local upgraded = math.max(rows, math.floor(rows * (mult or 1) + 0.5))
	return cols, upgraded
end

-- local (x, z) of the centre of cell k (1-based) on a slot `width` wide and `depth` deep, plus
-- the cell size. The front row (-z) fills first, from the left of a player facing the shelf (+x).
function ShelfGrid.cell(k, cols, rows, width, depth)
	local i = (k - 1) % cols
	local j = math.floor((k - 1) / cols)
	local cw, cd = width / cols, depth / rows
	local x = width / 2 - cw * (i + 0.5)
	local z = -depth / 2 + cd * (j + 0.5)
	return x, z, cw, cd
end

return ShelfGrid
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000041"><Properties><string name="Name">Shop</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- What the shop shows for each thing on sale, from the restaurant data `w`:
--   state "buy"    affordable now
--         "poor"   unlocked, but not enough yen (missing = how much is missing)
--         "locked" something comes first (need = { kind = "level" | "license" | "zone" | "staff" |
--                  "rating" | "slots" | "manager", ... })
--         "owned"  bought (licenses, rooms, renovations) / "max" (upgrades at their last level) /
--         "active" (today's advert)
-- The server checks the same rules when a purchase arrives (Services/Progression and
-- Services/Staff). Pure: the caller passes the data and the configuration tables, so this module
-- runs in the logic tests too.
local Shop = {}

local function finish(w, state, price, need, extra)
	local r = { state = state, price = price, need = need }
	if state == "buy" and (w.yen or 0) < (price or 0) then
		r.state = "poor"
	end
	if r.state == "poor" then
		r.missing = (price or 0) - (w.yen or 0)
	end
	for k, v in pairs(extra or {}) do
		r[k] = v
	end
	return r
end

local function level(w)
	return w.level or 1
end

-- staff slots of a restaurant (base slots + slots that come with rooms)
function Shop.staffSlots(w, staffCfg, maxStaff)
	local n = staffCfg.BaseSlots
	for zone, extra in pairs(staffCfg.SlotsByZone) do
		if w.zones and w.zones[zone] then
			n = n + extra
		end
	end
	return math.min(n, maxStaff or n)
end

function Shop.upgrade(w, u)
	local lvl = (w.upgrades and w.upgrades[u.id]) or 0
	local extra = { level = lvl, max = u.max }
	if lvl >= u.max then
		return finish(w, "max", nil, nil, extra)
	end
	local price = u.costs[lvl + 1]
	local need = u.levels[lvl + 1]
	if level(w) < need then
		return finish(w, "locked", price, { kind = "level", level = need }, extra)
	end
	if u.needsStaff then
		local has = false
		for _, s in ipairs(w.staff or {}) do
			if s.role == u.needsStaff then
				has = true
			end
		end
		if not has then
			return finish(w, "locked", price, { kind = "staff", id = u.needsStaff }, extra)
		end
	end
	return finish(w, "buy", price, nil, extra)
end

function Shop.ad(w, ad)
	local day = ((w.stats and w.stats.days) or 0) + 1
	if w.ads and w.ads[ad.id] == day then
		return finish(w, "active", nil, nil)
	end
	if level(w) < ad.lv then
		return finish(w, "locked", ad.cost, { kind = "level", level = ad.lv })
	end
	return finish(w, "buy", ad.cost, nil)
end

-- rating: the restaurant's current star rating (the server keeps it, the client reads it from
-- the plot's "Rating" attribute)
function Shop.license(w, lic, rating)
	if w.licenses and w.licenses[lic.id] then
		return finish(w, "owned", nil, nil)
	end
	if level(w) < lic.level then
		return finish(w, "locked", lic.cost, { kind = "level", level = lic.level })
	end
	for _, req in ipairs(lic.requires or {}) do
		if not (w.licenses and w.licenses[req]) then
			return finish(w, "locked", lic.cost, { kind = "license", id = req })
		end
	end
	if (lic.rating or 0) > 0 and (rating or 0) < lic.rating then
		return finish(w, "locked", lic.cost, { kind = "rating", rating = lic.rating })
	end
	return finish(w, "buy", lic.cost, nil)
end

-- rooms, floors and renovations
function Shop.expansion(w, e)
	if w.zones and w.zones[e.id] then
		return finish(w, "owned", nil, nil)
	end
	if level(w) < e.lv then
		return finish(w, "locked", e.cost, { kind = "level", level = e.lv })
	end
	for _, req in ipairs(e.requires or {}) do
		if not (w.zones and w.zones[req]) then
			return finish(w, "locked", e.cost, { kind = "zone", id = req })
		end
	end
	return finish(w, "buy", e.cost, nil)
end

function Shop.hire(w, cfg, slots)
	if level(w) < cfg.lv then
		return finish(w, "locked", cfg.hire, { kind = "level", level = cfg.lv })
	end
	if cfg.manager then
		for _, s in ipairs(w.staff or {}) do
			if s.role == cfg.id then
				return finish(w, "locked", cfg.hire, { kind = "manager" })
			end
		end
	end
	if #(w.staff or {}) >= slots then
		return finish(w, "locked", cfg.hire, { kind = "slots" })
	end
	return finish(w, "buy", cfg.hire, nil)
end

-- cfg = { Upgrades, Ads, Licenses, Expansions, Staff, MaxStaff }; returns the number of things
-- the restaurant can buy right now, per shop tab and in total
function Shop.buyable(w, cfg, rating)
	local tabs = { upgrades = 0, recipes = 0, staff = 0, rooms = 0, reno = 0 }
	for _, u in ipairs(cfg.Upgrades.list) do
		if Shop.upgrade(w, u).state == "buy" then
			tabs.upgrades = tabs.upgrades + 1
		end
	end
	-- today's advert counts too (it comes back every day)
	for _, ad in ipairs(cfg.Ads and cfg.Ads.list or {}) do
		if Shop.ad(w, ad).state == "buy" then
			tabs.upgrades = tabs.upgrades + 1
		end
	end
	for _, lic in ipairs(cfg.Licenses.list) do
		if Shop.license(w, lic, rating).state == "buy" then
			tabs.recipes = tabs.recipes + 1
		end
	end
	local slots = Shop.staffSlots(w, cfg.Staff, cfg.MaxStaff)
	for _, s in ipairs(cfg.Staff.list) do
		if Shop.hire(w, s, slots).state == "buy" then
			tabs.staff = tabs.staff + 1
		end
	end
	for _, e in ipairs(cfg.Expansions.list) do
		if e.id ~= "zone_base" and Shop.expansion(w, e).state == "buy" then
			if e.reno then
				tabs.reno = tabs.reno + 1
			else
				tabs.rooms = tabs.rooms + 1
			end
		end
	end
	local total = tabs.upgrades + tabs.recipes + tabs.staff + tabs.rooms + tabs.reno
	return total, tabs
end

-- the order cards are shown in: things to buy first (cheapest first), then the ones that need
-- more yen, then locked ones, then what is already owned
local RANK = { buy = 1, poor = 2, active = 3, locked = 4, owned = 5, max = 5 }
function Shop.sort(entries)
	table.sort(entries, function(a, b)
		local ra, rb = RANK[a.st.state] or 9, RANK[b.st.state] or 9
		if ra ~= rb then
			return ra < rb
		end
		local pa, pb = a.st.price or 0, b.st.price or 0
		if pa ~= pb and ra <= 4 then
			return pa < pb
		end
		return (a.order or 0) < (b.order or 0)
	end)
	return entries
end

return Shop
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000042"><Properties><string name="Name">Walls</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Computes wall and railing segments from the unlocked zones (pure).
-- Segment: { axis = "z" (runs along X at z = line) | "x" (runs along Z at x = line), line, a, b, floor, kind }
-- Wall segments separate indoor cells from outside or from another room.
-- Railings surround outdoor zones (and stair holes on upper floors).
local Walls = {}

local CELL = 1

local function key(x, z)
	return x .. "," .. z
end

local function floorCells(zones, floor)
	local cells = {}
	for _, z in ipairs(zones) do
		if z.floor == floor then
			local r = z.rect
			for x = r[1], r[3] - CELL, CELL do
				for zz = r[2], r[4] - CELL, CELL do
					cells[key(x, zz)] = { room = z.outdoor and "_outdoor" or (z.room or "main"), outdoor = z.outdoor, zone = z.id }
				end
			end
		end
	end
	return cells
end

local function merge(edges, floor, kind)
	-- edges: list of {axis, line, a, b}; merge contiguous ones on the same line
	local groups = {}
	for _, e in ipairs(edges) do
		local k = e.axis .. ":" .. e.line
		groups[k] = groups[k] or { axis = e.axis, line = e.line, list = {} }
		table.insert(groups[k].list, e)
	end
	local out = {}
	for _, g in pairs(groups) do
		table.sort(g.list, function(p, q)
			return p.a < q.a
		end)
		local cur = nil
		for _, e in ipairs(g.list) do
			if cur and math.abs(cur.b - e.a) < 1e-6 then
				cur.b = e.b
			else
				if cur then
					table.insert(out, cur)
				end
				cur = { axis = g.axis, line = g.line, a = e.a, b = e.b, floor = floor, kind = kind }
			end
		end
		if cur then
			table.insert(out, cur)
		end
	end
	table.sort(out, function(p, q)
		if p.axis ~= q.axis then
			return p.axis < q.axis
		end
		if p.line ~= q.line then
			return p.line < q.line
		end
		return p.a < q.a
	end)
	return out
end

-- Removes the intervals of `cuts` ({axis, at, from, to}) from the segments.
local function cut(segments, cuts)
	local result = segments
	for _, c in ipairs(cuts) do
		local next = {}
		for _, s in ipairs(result) do
			if s.axis == c.axis and math.abs(s.line - c.at) < 1e-6 and c.to > s.a and c.from < s.b then
				if c.from > s.a then
					table.insert(next, { axis = s.axis, line = s.line, a = s.a, b = c.from, floor = s.floor, kind = s.kind })
				end
				if c.to < s.b then
					table.insert(next, { axis = s.axis, line = s.line, a = c.to, b = s.b, floor = s.floor, kind = s.kind })
				end
			else
				table.insert(next, s)
			end
		end
		result = next
	end
	return result
end

-- zones: unlocked zone configs; openings: list; stairs: list {floor, rect}
function Walls.compute(zones, openings, stairs)
	local floors = {}
	for _, z in ipairs(zones) do
		floors[z.floor] = true
	end
	local result = {}
	for floor in pairs(floors) do
		local cells = floorCells(zones, floor)
		local below = floor > 0 and floorCells(zones, floor - 1) or nil
		local wallEdges, railEdges = {}, {}
		for k, c in pairs(cells) do
			local sx, sz = k:match("^(-?[%d%.]+),(-?[%d%.]+)$")
			local x, z = tonumber(sx), tonumber(sz)
			local neighbours = {
				{ dx = -CELL, dz = 0, axis = "x", line = x, a = z, b = z + CELL },
				{ dx = CELL, dz = 0, axis = "x", line = x + CELL, a = z, b = z + CELL },
				{ dx = 0, dz = -CELL, axis = "z", line = z, a = x, b = x + CELL },
				{ dx = 0, dz = CELL, axis = "z", line = z + CELL, a = x, b = x + CELL },
			}
			for _, nb in ipairs(neighbours) do
				local other = cells[key(x + nb.dx, z + nb.dz)]
				local edge = { axis = nb.axis, line = nb.line, a = nb.a, b = nb.b }
				if not c.outdoor then
					if not other then
						table.insert(wallEdges, edge)
					elseif other.room ~= c.room and not other.outdoor and c.room < other.room then
						table.insert(wallEdges, edge)
					elseif other.outdoor then
						table.insert(wallEdges, edge)
					end
				else
					if not other then
						-- outdoor edge that faces nothing: railing, unless the building below continues (rooftop parapet still needed)
						table.insert(railEdges, edge)
					end
				end
			end
		end
		local floorOpenings = {}
		for _, o in ipairs(openings) do
			if o.floor == floor then
				table.insert(floorOpenings, o)
			end
		end
		local walls = cut(merge(wallEdges, floor, "wall"), floorOpenings)
		local gaps = {}
		for _, z in ipairs(zones) do
			if z.floor == floor and z.gaps then
				for _, g in ipairs(z.gaps) do
					table.insert(gaps, g)
				end
			end
		end
		local rails = cut(merge(railEdges, floor, "rail"), gaps)
		-- railing around stair holes on this floor (stairs that start on floor - 1)
		for _, s in ipairs(stairs) do
			if s.floor == floor - 1 then
				local r = s.hole or s.rect
				local open = s.exitSide or "z+"
				if open ~= "x-" then
					table.insert(rails, { axis = "x", line = r[1], a = r[2], b = r[4], floor = floor, kind = "rail" })
				end
				if open ~= "x+" then
					table.insert(rails, { axis = "x", line = r[3], a = r[2], b = r[4], floor = floor, kind = "rail" })
				end
				if open ~= "z-" then
					table.insert(rails, { axis = "z", line = r[2], a = r[1], b = r[3], floor = floor, kind = "rail" })
				end
				if open ~= "z+" then
					table.insert(rails, { axis = "z", line = r[4], a = r[1], b = r[3], floor = floor, kind = "rail" })
				end
			end
		end
		local _ = below
		result[floor] = { walls = walls, rails = rails }
	end
	return result
end

-- Distance from point to segment (on the XZ plane)
function Walls.distance(seg, x, z)
	if seg.axis == "z" then
		local cx = math.clamp(x, seg.a, seg.b)
		return math.sqrt((x - cx) ^ 2 + (z - seg.line) ^ 2)
	end
	local cz = math.clamp(z, seg.a, seg.b)
	return math.sqrt((x - seg.line) ^ 2 + (z - cz) ^ 2)
end

-- Position along the segment for a point
function Walls.along(seg, x, z)
	if seg.axis == "z" then
		return x
	end
	return z
end

return Walls
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000057"><Properties><string name="Name">Models</string></Properties><Item class="Folder" referent="RBX000052"><Properties><string name="Name">Builders</string></Properties><Item class="ModuleScript" referent="RBX000044"><Properties><string name="Name">Building</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Building shell pieces used by the server WorldService (floors, walls, roof, stairs, facade).
-- All coordinates are world coordinates (the plot origin is the world origin).
local CollectionService = game:GetService("CollectionService")

local Kit = require(script.Parent.Parent.Kit)
local P = require(script.Parent.Parent.Palette)
local Color = require(script.Parent.Parent.Parent.Util.Color)
local M = P.M

local JP_FONT = Font.new("rbxasset://fonts/families/FredokaOne.json", Enum.FontWeight.Bold)
local B = {}

local function tag(part, name, attrs)
	CollectionService:AddTag(part, name)
	if attrs then
		for k, v in pairs(attrs) do
			part:SetAttribute(k, v)
		end
	end
	return part
end

function B.floorSkin(parent, rect, y, style, attrs)
	local w, d = rect[3] - rect[1], rect[4] - rect[2]
	local p = Kit.box(parent, w, 0.2, d, (rect[1] + rect[3]) / 2, y - 0.1, (rect[2] + rect[4]) / 2, style.color, style.material, { collide = true })
	p.Name = "Floor"
	tag(p, "Floor", attrs)
	return p
end

function B.slab(parent, rect, y0, thickness, color, material, name)
	local w, d = rect[3] - rect[1], rect[4] - rect[2]
	local p = Kit.box(parent, w, thickness, d, (rect[1] + rect[3]) / 2, y0 + thickness / 2, (rect[2] + rect[4]) / 2, color, material, { collide = true })
	p.Name = name or "Slab"
	return p
end

-- Wall segment. style = {color, material, lattice, stripes}; outsideSign = -1/1 side of the
-- exterior (nil when both sides are interior).
function B.wall(parent, seg, y0, height, thickness, style, outsideSign, exteriorStyle)
	local len = seg.b - seg.a
	local cx, cz, sx, sz
	if seg.axis == "z" then
		cx, cz = (seg.a + seg.b) / 2, seg.line
		sx, sz = len + thickness, thickness
	else
		cx, cz = seg.line, (seg.a + seg.b) / 2
		sx, sz = thickness, len + thickness
	end
	local wall = Kit.box(parent, sx, height, sz, cx, y0 + height / 2, cz, style.color, style.material, { collide = true })
	wall.Name = "Wall"
	tag(wall, "Wall", { FloorIndex = seg.floor })
	-- baseboard on both faces
	local base = Kit.box(parent, sx + 0.06, 0.6, sz + 0.06, cx, y0 + 0.3, cz, P.wood_dark, M.wood, { collide = false })
	tag(base, "Wall", { FloorIndex = seg.floor })
	-- interior decoration
	if style.lattice or style.stripes then
		local step = style.lattice and 2 or 0.8
		local n = math.floor(len / step)
		for i = 1, n - 1 do
			local along = seg.a + i * step
			for side = -1, 1, 2 do
				if side ~= outsideSign then
					local off = side * (thickness / 2 + 0.03)
					local x, z = (seg.axis == "z") and along or seg.line + off, (seg.axis == "z") and seg.line + off or along
					local bar = Kit.box(parent, seg.axis == "z" and 0.12 or 0.06, height - 1, seg.axis == "z" and 0.06 or 0.12, x, y0 + 0.6 + (height - 1) / 2, z, style.lattice and P.wood_dark or Color.hex("#8A7A3A"), M.wood, { collide = false, shadow = false })
					tag(bar, "Wall", { FloorIndex = seg.floor })
				end
			end
		end
	end
	if outsideSign then
		local ext = exteriorStyle or { color = P.cream, material = M.plaster }
		local off = outsideSign * (thickness / 2 + 0.1)
		local ex, ez = cx, cz
		local esx, esz = sx, sz
		if seg.axis == "z" then
			ez = cz + off
			esz = 0.2
		else
			ex = cx + off
			esx = 0.2
		end
		local skin = Kit.box(parent, esx, height, esz, ex, y0 + height / 2, ez, ext.color, ext.material, { collide = false })
		tag(skin, "Roof")
		local stone = Kit.box(parent, esx + (seg.axis == "x" and 0.1 or 0), 1.4, esz + (seg.axis == "z" and 0.1 or 0), ex, y0 + 0.7, ez, P.stone_dark, M.slate, { collide = false })
		tag(stone, "Roof")
		local beam = Kit.box(parent, esx + (seg.axis == "x" and 0.2 or 0), 0.7, esz + (seg.axis == "z" and 0.2 or 0), ex, y0 + height - 0.35, ez, P.wood_dark, M.wood, { collide = false })
		tag(beam, "Roof")
		local posts = math.floor(len / 6)
		for i = 0, posts do
			local along = seg.a + (len) * (posts == 0 and 0.5 or i / posts)
			local px = seg.axis == "z" and along or ex + outsideSign * 0.08
			local pz = seg.axis == "z" and ez + outsideSign * 0.08 or along
			local post = Kit.box(parent, seg.axis == "z" and 0.5 or 0.25, height, seg.axis == "z" and 0.25 or 0.5, px, y0 + height / 2, pz, P.wood_dark, M.wood, { collide = false })
			tag(post, "Roof")
		end
	end
	return wall
end

function B.doorFrame(parent, o, y0, height)
	local h = height or 9
	local function post(along)
		local x = o.axis == "z" and along or o.at
		local z = o.axis == "z" and o.at or along
		Kit.box(parent, 0.6, h, 0.6, x, y0 + h / 2, z, P.wood_dark, M.wood, { collide = true })
	end
	post(o.from + 0.3)
	post(o.to - 0.3)
	local len = o.to - o.from
	local cx = o.axis == "z" and (o.from + o.to) / 2 or o.at
	local cz = o.axis == "z" and o.at or (o.from + o.to) / 2
	Kit.box(parent, o.axis == "z" and len or 0.9, 0.6, o.axis == "z" and 0.9 or len, cx, y0 + h + 0.3, cz, P.wood_dark, M.wood, { collide = true })
	-- fill above the door up to the wall top
	Kit.box(parent, o.axis == "z" and len or 0.8, 14 - h - 0.6, o.axis == "z" and 0.8 or len, cx, y0 + h + 0.6 + (14 - h - 0.6) / 2, cz, P.cream, M.plaster, { collide = true })
end

-- The noren print (the word ramen and a white bowl crest) drawn on the cloth itself. The whole
-- design is laid out across the curtain and every panel shows its own slice of it, so the print
-- sways with the fabric and is cut by the slits between panels like a real noren.
-- offset = studs from the design's left edge (as seen on this face) to the panel's left edge.
local function norenPrint(cloth, face, width, height, offset)
	local pps = 60
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Print"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pps
	gui.LightInfluence = 1
	gui.Parent = cloth
	local design = Instance.new("Frame")
	design.BackgroundTransparency = 1
	design.Position = UDim2.fromOffset(-offset * pps, 0)
	design.Size = UDim2.fromOffset(width * pps, height * pps)
	design.Parent = gui
	local white = Color.of(P.white)
	-- x, y: centre in studs from the design's top-left corner
	local function shape(parent, x, y, w, h, color, round, rot)
		local blot = Instance.new("Frame")
		blot.AnchorPoint = Vector2.new(0.5, 0.5)
		blot.Position = UDim2.fromOffset(x * pps, y * pps)
		blot.Size = UDim2.fromOffset(w * pps, h * pps)
		blot.BackgroundColor3 = color
		blot.BorderSizePixel = 0
		blot.Rotation = rot or 0
		if round then
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(round, 0)
			c.Parent = blot
		end
		blot.Parent = parent
		return blot
	end
	local word = Instance.new("TextLabel")
	word.AnchorPoint = Vector2.new(0.5, 0.5)
	word.Position = UDim2.fromOffset(width / 2 * pps, 0.66 * pps)
	word.Size = UDim2.fromOffset((width - 0.4) * pps, 1.05 * pps)
	word.BackgroundTransparency = 1
	word.Text = "ら ー め ん"
	word.TextScaled = true
	word.TextColor3 = white
	word.FontFace = JP_FONT
	word.AutoLocalize = false
	word.Parent = design
	-- bowl: the lower half of an ellipse, a rim line and a small foot
	local cx = width / 2
	local clip = Instance.new("Frame")
	clip.AnchorPoint = Vector2.new(0.5, 0)
	clip.Position = UDim2.fromOffset(cx * pps, 2.2 * pps)
	clip.Size = UDim2.fromOffset(1.8 * pps, 0.66 * pps)
	clip.BackgroundTransparency = 1
	clip.ClipsDescendants = true
	clip.Parent = design
	shape(clip, 0.9, 0, 1.8, 1.32, white, 0.5)
	shape(design, cx, 2.2, 1.95, 0.09, white, 0.5)
	shape(design, cx, 2.9, 0.62, 0.1, white, 0.3)
	-- noodles lifted out of the bowl and two chopsticks
	for k = -1, 1 do
		shape(design, cx + k * 0.2, 1.86, 0.07, 0.6, white, 0.5)
	end
	for k = 0, 1 do
		shape(design, cx + 0.42 + k * 0.15, 1.72, 0.06, 1.0, white, 0.5, 28)
	end
	return gui
end

-- Fixed noren curtain hanging in the entrance (customers walk through it)
function B.entranceNoren(parent, o, y0)
	local len = o.to - o.from
	local cx = (o.from + o.to) / 2
	local z = o.at - 0.6
	Kit.cylH(parent, 0.18, len, cx, y0 + 8.7, z, P.wood_dark, M.wood, { collide = false })
	local panels = 4
	local h = 3.2
	local pw = len / panels - 0.12
	for i = 0, panels - 1 do
		local x = o.from + len / panels * (i + 0.5)
		local cloth = Kit.box(parent, pw, h, 0.06, x, y0 + 7, z, P.indigo, M.fabric, { collide = false })
		cloth.CanQuery = false
		cloth:SetAttribute("Animate", "sway")
		-- the front (street side, -Z) shows world +X on its left; the back shows world -X on its left
		norenPrint(cloth, Enum.NormalId.Front, len, h, o.to - (x + pw / 2))
		norenPrint(cloth, Enum.NormalId.Back, len, h, (x - pw / 2) - o.from)
	end
end

function B.railing(parent, seg, y0, color)
	local len = seg.b - seg.a
	local h = 3
	local cx = seg.axis == "z" and (seg.a + seg.b) / 2 or seg.line
	local cz = seg.axis == "z" and seg.line or (seg.a + seg.b) / 2
	local rail = Kit.box(parent, seg.axis == "z" and len or 0.3, 0.25, seg.axis == "z" and 0.3 or len, cx, y0 + h, cz, color or P.wood_dark, M.wood, { collide = true })
	tag(rail, "Wall", { FloorIndex = seg.floor, Rail = true })
	Kit.box(parent, seg.axis == "z" and len or 0.15, 0.15, seg.axis == "z" and 0.15 or len, cx, y0 + h / 2, cz, color or P.wood_dark, M.wood, { collide = false })
	-- invisible blocker so nobody falls off
	local block = Kit.box(parent, seg.axis == "z" and len or 0.4, h + 1, seg.axis == "z" and 0.4 or len, cx, y0 + (h + 1) / 2, cz, P.white, M.smooth, { collide = true, transparency = 1, shadow = false })
	block.CanQuery = false
	local n = math.max(1, math.floor(len / 2))
	for i = 0, n do
		local along = seg.a + len * i / n
		local x = seg.axis == "z" and along or seg.line
		local z = seg.axis == "z" and seg.line or along
		Kit.box(parent, 0.3, h, 0.3, x, y0 + h / 2, z, color or P.wood_dark, M.wood, { collide = false })
	end
end

-- Stairs rising toward +Z inside rect, from y0 to y0 + rise
-- Staircase: flights of treads and risers on sloped stringers, a landing on a post, and wooden
-- handrails with balusters on the open sides. s = normalised stairs (Logic/Geometry.stairs).
function B.stairs(parent, s, y0, rise)
	if s[1] then
		s = { flights = { { rect = s, dir = "+z", from = 0, to = 1 } }, rects = { s } }
	end
	local NC = { collide = false, shadow = false }
	local railColor, treadColor, riserColor = P.wood_dark, P.hinoki, P.wood

	-- point on a flight: t = distance from the start edge, u = offset across the flight
	local function at(f, t, u)
		local r = f.rect
		if f.dir == "+z" then
			return (r[1] + r[3]) / 2 + u, r[2] + t
		elseif f.dir == "+x" then
			return r[1] + t, (r[2] + r[4]) / 2 + u
		end
		return r[3] - t, (r[2] + r[4]) / 2 + u
	end
	local function dims(f)
		local r = f.rect
		if f.dir == "+z" then
			return r[4] - r[2], r[3] - r[1]
		end
		return r[3] - r[1], r[4] - r[2]
	end
	local function boxAlong(f, t, u, len, width, y, h, color, mat, props)
		local x, z = at(f, t, u)
		local sx, sz = width, len
		if f.dir ~= "+z" then
			sx, sz = len, width
		end
		return Kit.box(parent, sx, h, sz, x, y, z, color, mat, props)
	end
	local function beam(a, b, size, color, props)
		local mid = (a + b) / 2
		return Kit.part(parent, Vector3.new(size.X, size.Y, (b - a).Magnitude), CFrame.lookAt(mid, b), color, M.wood, props)
	end
	-- handrail with balusters from p0 (height h0) to p1 (height h1)
	local function rail(x0, z0, h0, x1, z1, h1)
		local a = Vector3.new(x0, h0 + 3.2, z0)
		local b = Vector3.new(x1, h1 + 3.2, z1)
		beam(a, b, Vector3.new(0.3, 0.22, 0), railColor, NC)
		local len = (Vector3.new(x1, 0, z1) - Vector3.new(x0, 0, z0)).Magnitude
		local n = math.max(2, math.floor(len / 1.1))
		for i = 0, n do
			local t = i / n
			local x, z = x0 + (x1 - x0) * t, z0 + (z1 - z0) * t
			local h = h0 + (h1 - h0) * t
			Kit.box(parent, 0.14, 3.1, 0.14, x, h + 1.6, z, (i == 0 or i == n) and railColor or P.wood_light, M.wood, NC)
		end
	end

	for fi, f in ipairs(s.flights or {}) do
		local along, width = dims(f)
		local h0, h1 = y0 + f.from * rise, y0 + f.to * rise
		local n = math.max(4, math.floor((h1 - h0) / 0.75 + 0.5))
		local depth = along / n
		local riser = (h1 - h0) / n
		for k = 0, n - 1 do
			local top = h0 + (k + 1) * riser
			local tread = boxAlong(f, (k + 0.5) * depth, 0, depth + 0.08, width, top - 0.1, 0.2, treadColor, M.wood, { collide = true })
			tread.Name = "Step"
			tag(tread, "Floor", { FloorIndex = -1, Stairs = true })
			local rs = boxAlong(f, k * depth + 0.04, 0, 0.08, width - 0.1, top - riser / 2 - 0.1, riser, riserColor, M.wood, { collide = true })
			tag(rs, "Floor", { FloorIndex = -1, Stairs = true })
			-- nosing line
			boxAlong(f, k * depth + 0.02, 0, 0.06, width, top + 0.01, 0.06, P.wood_dark, M.wood, NC)
		end
		-- sloped stringers on both sides and an underside board
		for _, u in ipairs({ -width / 2 + 0.12, width / 2 - 0.12 }) do
			local ax, az = at(f, 0, u)
			local bx, bz = at(f, along, u)
			beam(Vector3.new(ax, h0 + 0.05, az), Vector3.new(bx, h1 - riser + 0.05, bz), Vector3.new(0.24, 0.7, 0), railColor, NC)
		end
		local ax, az = at(f, 0, 0)
		local bx, bz = at(f, along, 0)
		beam(Vector3.new(ax, h0 - 0.45, az), Vector3.new(bx, h1 - riser - 0.45, bz), Vector3.new(width - 0.3, 0.15, 0), P.wood, NC)
		-- handrails on the open sides (s.railSides lists them; default: both)
		local sides = (s.railSides and s.railSides[fi]) or { -1, 1 }
		for _, side in ipairs(sides) do
			local u = side * (width / 2 - 0.12)
			local x0, z0 = at(f, 0.2, u)
			local x1, z1 = at(f, along, u)
			rail(x0, z0, h0, x1, z1, h1 - riser)
		end
	end
	-- landing on a corner post, with a rail along its open side
	if s.landing then
		local r = s.landing
		local hy = y0 + rise * 0.5
		local land = Kit.box(parent, r[3] - r[1], 0.4, r[4] - r[2], (r[1] + r[3]) / 2, hy - 0.2, (r[2] + r[4]) / 2, treadColor, M.wood, { collide = true })
		tag(land, "Floor", { FloorIndex = -1, Stairs = true })
		Kit.box(parent, r[3] - r[1] + 0.1, 0.25, r[4] - r[2] + 0.1, (r[1] + r[3]) / 2, hy - 0.5, (r[2] + r[4]) / 2, P.wood_dark, M.wood, NC)
		for _, c in ipairs(s.landingPosts or { { r[3] - 0.3, r[4] - 0.3 } }) do
			Kit.box(parent, 0.5, hy - y0, 0.5, c[1], y0 + (hy - y0) / 2, c[2], P.wood_dark, M.wood, { collide = true })
		end
		for _, seg in ipairs(s.landingRails or {}) do
			rail(seg[1], seg[2], hy, seg[3], seg[4], hy)
		end
	end
end

-- Tiled eave (hisashi) projecting from a street facing wall (axis "z" segment).
-- outsideSign -1 means the street is at -Z. Tiles rows, round tile channels, rafter tails, end caps.
-- Street eave. tiled = renovation "tiled eaves" (kawara channels, ridge, rafters, onigawara);
-- otherwise a plain sheet-metal canopy.
function B.eave(parent, seg, y, outsideSign, depth, tiled)
	depth = depth or 3
	local len = seg.b - seg.a + 2
	local cx = (seg.a + seg.b) / 2
	local z = seg.line + outsideSign * (depth / 2 + 0.5)
	local yaw = outsideSign < 0 and 0 or 180
	local rise = tiled and 1.6 or 0.8
	local roof = Kit.wedge(parent, len, rise, depth, CFrame.new(cx, y + rise / 2, z) * CFrame.Angles(0, math.rad(yaw), 0), tiled and P.tile or P.steel, tiled and M.roof or M.metal, { collide = false })
	tag(roof, "Roof")
	if not tiled then
		local edge = Kit.box(parent, len, 0.2, 0.12, cx, y - 0.05, seg.line + outsideSign * (depth + 0.45), P.steel_dark, M.metal, { collide = false })
		tag(edge, "Roof")
		return
	end
	-- round tile channels running down the slope
	local slope = math.sqrt(depth * depth + rise * rise)
	local n = math.floor(len / 0.7)
	for i = 0, n do
		local x = seg.a - 1 + len * i / n
		local top = Vector3.new(x, y + rise + 0.08, seg.line + outsideSign * 0.5)
		local bottom = Vector3.new(x, y + 0.08, seg.line + outsideSign * (depth + 0.5))
		local mid = (top + bottom) / 2
		local cf = CFrame.lookAt(mid, bottom) * CFrame.Angles(0, math.rad(90), 0)
		local ch = Kit.part(parent, Vector3.new(slope, 0.22, 0.22), cf, P.charcoal, M.roof, { collide = false, shadow = false, shape = Enum.PartType.Cylinder })
		ch.CanQuery = false
		tag(ch, "Roof")
		-- round end tile (tomoe) facing the street
		local cap = Kit.cylH(parent, 0.34, 0.12, x, y + 0.1, seg.line + outsideSign * (depth + 0.56), P.charcoal, M.roof, { collide = false, shadow = false }, "z")
		cap.CanQuery = false
		tag(cap, "Roof")
	end
	-- ridge, fascia board and rafter tails
	local ridge = Kit.box(parent, len, 0.55, 0.7, cx, y + rise + 0.2, seg.line + outsideSign * 0.65, P.charcoal, M.roof, { collide = false })
	tag(ridge, "Roof")
	local ridgeTop = Kit.cylH(parent, 0.4, len, cx, y + rise + 0.5, seg.line + outsideSign * 0.65, P.tile, M.roof, { collide = false, shadow = false })
	tag(ridgeTop, "Roof")
	local fascia = Kit.box(parent, len, 0.32, 0.18, cx, y - 0.05, seg.line + outsideSign * (depth + 0.42), P.wood_dark, M.wood, { collide = false })
	tag(fascia, "Roof")
	for i = 0, math.floor(len / 1.1) do
		local x = seg.a - 1 + 0.55 + i * 1.1
		if x < seg.b + 1 then
			local tail = Kit.box(parent, 0.22, 0.22, depth - 0.3, x, y - 0.3, seg.line + outsideSign * (depth / 2 + 0.35), P.wood_dark, M.wood, { collide = false, shadow = false })
			tail.CanQuery = false
			tag(tail, "Roof")
		end
	end
	for _, sx in ipairs({ seg.a - 1.05, seg.b + 1.05 }) do
		local cap = Kit.box(parent, 0.5, 0.9, 0.6, sx, y + 0.5, seg.line + outsideSign * (depth + 0.2), P.charcoal, M.roof, { collide = false })
		tag(cap, "Roof")
		local oni = Kit.box(parent, 0.55, 0.9, 0.7, sx, y + rise + 0.45, seg.line + outsideSign * 0.65, P.charcoal, M.roof, { collide = false })
		tag(oni, "Roof")
	end
end

-- Coordinates on the face of a wall segment: along the wall, height, distance from the wall
-- line towards `side` (+1 / -1). Returns the created part.
local function faceBox(parent, seg, side, sa, sy, so, along, y, out, color, mat, props)
	if seg.axis == "z" then
		return Kit.box(parent, sa, sy, so, along, y, seg.line + side * out, color, mat, props)
	end
	return Kit.box(parent, so, sy, sa, seg.line + side * out, y, along, color, mat, props)
end
B.faceBox = faceBox

local function inAvoid(along, avoid)
	for _, r in ipairs(avoid or {}) do
		if along > r[1] and along < r[2] then
			return true
		end
	end
	return false
end

-- Interior finishes on one side of a wall: koshi-ita wainscot, hashira posts and nageshi beam
-- in dining rooms; white tiles in kitchens; plain concrete wainscot in storage rooms.
-- reno = { wainscot, beams, tiles, storage } (owned renovations); the plain room only gets
-- a skirting board.
function B.wallTrim(parent, seg, y0, side, area, height, reno)
	reno = reno or {}
	local len = seg.b - seg.a
	local mid = (seg.a + seg.b) / 2
	local NC = { collide = false, shadow = false }
	local parts = {}
	local function add(p)
		p.CanQuery = true
		tag(p, "Wall", { FloorIndex = seg.floor })
		table.insert(parts, p)
		return p
	end
	local skirting = area == "kitchen" and P.steel or (area == "storage" and P.stone_dark or P.wood_dark)
	add(faceBox(parent, seg, side, len, 0.35, 0.06, mid, y0 + 0.175, 0.43, skirting, area == "kitchen" and M.metal or M.wood, NC))
	if area == "kitchen" then
		if reno.tiles then
			add(faceBox(parent, seg, side, len, 6.4, 0.06, mid, y0 + 0.6 + 3.2, 0.44, P.white, M.tiles, NC))
			add(faceBox(parent, seg, side, len, 0.12, 0.12, mid, y0 + 7.05, 0.47, P.metal, M.metal, NC))
		end
	elseif area == "storage" then
		if reno.storage then
			add(faceBox(parent, seg, side, len, 3, 0.06, mid, y0 + 1.5, 0.44, P.concrete, M.concrete, NC))
			add(faceBox(parent, seg, side, len, 0.15, 0.1, mid, y0 + 3.05, 0.46, P.neon_yellow, M.smooth, NC))
		end
	else
		if reno.wainscot then
			local panel = area == "tatami" and P.hinoki or P.wood_dark
			add(faceBox(parent, seg, side, len, 2.7, 0.08, mid, y0 + 1.35, 0.45, panel, M.planks, NC))
			add(faceBox(parent, seg, side, len, 0.18, 0.16, mid, y0 + 2.75, 0.49, P.wood_light, M.wood, NC))
		end
		if reno.beams then
			add(faceBox(parent, seg, side, len, 0.4, 0.2, mid, y0 + 10.2, 0.5, P.wood_dark, M.wood, NC))
			local posts = math.max(1, math.floor(len / 6))
			for i = 0, posts do
				local along = seg.a + len * i / posts
				along = math.clamp(along, seg.a + 0.25, seg.b - 0.25)
				add(faceBox(parent, seg, side, 0.45, height - 0.2, 0.14, along, y0 + (height - 0.2) / 2, 0.48, P.wood_dark, M.wood, NC))
			end
		end
	end
	return parts
end

-- Kyoto machiya street front: koshi lattice band, timber frame and inu-yarai bamboo fence.
-- avoid = list of {from, to} ranges along the wall to keep clear (doors).
-- opts = { koshi = bool (timber bands and lattice), bamboo = bool (inu-yarai fence) }
function B.facadeDetail(parent, seg, y0, side, avoid, opts)
	opts = opts or { koshi = true, bamboo = true }
	local len = seg.b - seg.a
	local mid = (seg.a + seg.b) / 2
	local NC = { collide = false, shadow = false }
	local function add(p)
		p.CanQuery = false
		tag(p, "Roof")
		return p
	end
	if opts.koshi then
		-- timber frame bands
		add(faceBox(parent, seg, side, len, 0.35, 0.16, mid, y0 + 4.5, 0.68, P.wood_dark, M.wood, NC))
		add(faceBox(parent, seg, side, len, 0.3, 0.16, mid, y0 + 9.6, 0.68, P.wood_dark, M.wood, NC))
		-- koshi lattice (lower band)
		add(faceBox(parent, seg, side, len, 0.18, 0.2, mid, y0 + 1.5, 0.72, P.wood_dark, M.wood, NC))
		add(faceBox(parent, seg, side, len, 0.18, 0.2, mid, y0 + 4.15, 0.72, P.wood_dark, M.wood, NC))
		local step = 0.42
		for i = 0, math.floor(len / step) do
			local along = seg.a + 0.2 + i * step
			if along < seg.b - 0.2 and not inAvoid(along, avoid) then
				add(faceBox(parent, seg, side, 0.13, 2.6, 0.12, along, y0 + 2.85, 0.76, P.wood, M.wood, NC))
			end
	end
	end
	if not opts.bamboo then
		return
	end
	-- inu-yarai: curved bamboo fence leaning against the base of the wall
	for i = 0, math.floor(len / 0.55) do
		local along = seg.a + 0.3 + i * 0.55
		if along < seg.b - 0.3 and not inAvoid(along, avoid) then
			local a = (seg.axis == "z") and Vector3.new(along, y0 + 0.02, seg.line + side * 1.45) or Vector3.new(seg.line + side * 1.45, y0 + 0.02, along)
			local b = (seg.axis == "z") and Vector3.new(along, y0 + 1.25, seg.line + side * 0.8) or Vector3.new(seg.line + side * 0.8, y0 + 1.25, along)
			local midp = (a + b) / 2
			local rod = Kit.part(parent, Vector3.new((b - a).Magnitude, 0.14, 0.14), CFrame.lookAt(midp, b) * CFrame.Angles(0, math.rad(90), 0), P.bamboo, M.wood, { collide = false, shadow = false, shape = Enum.PartType.Cylinder })
			add(rod)
		end
	end
	for _, h in ipairs({ 0.45, 0.95 }) do
		local out = 1.45 - (h / 1.25) * 0.65
		add(faceBox(parent, seg, side, len, 0.08, 0.08, mid, y0 + h, out + 0.04, P.bamboo_green, M.wood, NC))
	end
end

-- Details around the main entrance: parked sliding lattice doors, stone step, salt cones, pines
function B.entranceDetail(parent, o, y0)
	local NC = { collide = false, shadow = false }
	local z = o.at - 0.75
	for _, sgn in ipairs({ -1, 1 }) do
		local edge = sgn < 0 and o.from or o.to
		local cx = edge + sgn * 1.45
		-- sliding koshi-do door pushed aside
		Kit.box(parent, 2.8, 8.4, 0.12, cx, y0 + 4.3, z, P.wood_dark, M.wood, NC)
		Kit.box(parent, 2.4, 3.6, 0.04, cx, y0 + 6.3, z - 0.08, P.paper_warm, M.fabric, NC)
		for k = 0, 5 do
			Kit.box(parent, 0.1, 7.8, 0.08, cx - 1.1 + k * 0.44, y0 + 4.3, z - 0.11, P.wood, M.wood, NC)
		end
		Kit.box(parent, 2.8, 0.12, 0.1, cx, y0 + 4.3, z - 0.12, P.wood, M.wood, NC)
		-- morishio: salt cone on a small dish
		local sx = edge - sgn * 0.45
		Kit.cyl(parent, 0.6, 0.06, sx, y0 + 0.03, o.at - 1.0, P.porcelain, M.smooth, NC)
		for k = 0, 3 do
			Kit.cyl(parent, 0.42 - k * 0.1, 0.12, sx, y0 + 0.12 + k * 0.11, o.at - 1.0, P.white, M.sand, NC)
		end
		-- potted pine
		local px = edge + sgn * 3.6
		Kit.cyl(parent, 1.1, 0.9, px, y0 - 0.4 + 0.45, o.at - 1.25, P.indigo, M.smooth, NC)
		Kit.cyl(parent, 0.18, 1.3, px, y0 + 1.1, o.at - 1.25, P.wood_dark, M.wood, NC)
		Kit.blob(parent, 1.4, 0.5, 1.1, px - 0.2, y0 + 1.75, o.at - 1.25, P.leaf_dark, M.leafy, NC)
		Kit.blob(parent, 1.0, 0.4, 0.9, px + 0.25, y0 + 2.15, o.at - 1.25, P.leaf_dark, M.leafy, NC)
	end
	-- stone step
	Kit.box(parent, o.to - o.from - 0.6, 0.3, 1.2, (o.from + o.to) / 2, -0.25, o.at - 1.0, P.stone, M.granite, { collide = true })
end

-- Loading door: rolled-up shutter, hazard stripe and a small sign
-- marked = renovation "tidy storage" (hazard stripes and the loading sign)
function B.shutter(parent, o, y0, height, marked)
	local NC = { collide = false, shadow = false }
	local len = o.to - o.from
	local cx = (o.from + o.to) / 2
	local z = o.at - 0.5
	Kit.box(parent, len + 0.4, 1.1, 0.9, cx, y0 + height + 0.1, z - 0.2, P.steel, M.metal, NC)
	for k = 0, 3 do
		Kit.box(parent, len, 0.22, 0.06, cx, y0 + height - 0.4 - k * 0.3, z, P.metal, M.metal, NC)
	end
	if not marked then
		return
	end
	for k = 0, math.floor(len / 0.6) do
		local stripe = Kit.box(parent, 0.3, 0.02, 0.6, o.from + 0.3 + k * 0.6, y0 - 0.33, o.at - 1.2, k % 2 == 0 and P.neon_yellow or P.black, M.smooth, NC)
		stripe.CanQuery = false
	end
	local plate = Kit.box(parent, 2.2, 0.7, 0.06, o.to + 1.6, y0 + 7, z, P.white, M.smooth, NC)
	Kit.text(plate, Enum.NormalId.Front, "搬入口", { color = "#2B2320", font = JP_FONT })
end

function B.parapet(parent, seg, y0)
	local len = seg.b - seg.a
	local cx = seg.axis == "z" and (seg.a + seg.b) / 2 or seg.line
	local cz = seg.axis == "z" and seg.line or (seg.a + seg.b) / 2
	local p = Kit.box(parent, seg.axis == "z" and len + 0.8 or 0.7, 0.8, seg.axis == "z" and 0.7 or len + 0.8, cx, y0 + 0.4, cz, P.cream, M.plaster, { collide = true })
	tag(p, "Roof")
	local cap = Kit.box(parent, seg.axis == "z" and len + 1 or 1, 0.22, seg.axis == "z" and 1 or len + 1, cx, y0 + 0.9, cz, P.tile, M.roof, { collide = false, shadow = false })
	tag(cap, "Roof")
	return p
end

-- Paper-lit lattice window on an exterior wall
-- fancy = renovation "lattice windows" (kumiko grid, sill and flower box); else a plain frame
function B.window(parent, along, y, seg, outsideSign, w, h, fancy)
	local off = outsideSign * 0.65
	local x = seg.axis == "z" and along or seg.line + off
	local z = seg.axis == "z" and seg.line + off or along
	local sx, sz = seg.axis == "z" and w or 0.1, seg.axis == "z" and 0.1 or w
	local glow = Kit.box(parent, sx, h, sz, x, y, z, P.paper_warm, M.neon, { collide = false })
	glow.Transparency = 0.15
	tag(glow, "Roof")
	local cols, rows = math.max(2, math.floor(w / 0.8)), math.max(2, math.floor(h / 0.8))
	if not fancy then
		cols, rows = 2, 1
	end
	for i = 0, cols do
		local a = along - w / 2 + w * i / cols
		local bx = seg.axis == "z" and a or x + outsideSign * 0.06
		local bz = seg.axis == "z" and z + outsideSign * 0.06 or a
		local bar = Kit.box(parent, seg.axis == "z" and 0.1 or 0.08, h, seg.axis == "z" and 0.08 or 0.1, bx, y, bz, P.wood_dark, M.wood, { collide = false, shadow = false })
		tag(bar, "Roof")
	end
	if fancy then
		-- sill with a flower box
		local sillA = seg.axis == "z" and w + 0.6 or 0.5
		local sillB = seg.axis == "z" and 0.5 or w + 0.6
		local sill = Kit.box(parent, sillA, 0.18, sillB, x + (seg.axis == "x" and outsideSign * 0.2 or 0), y - h / 2 - 0.12, z + (seg.axis == "z" and outsideSign * 0.2 or 0), P.wood_dark, M.wood, { collide = false, shadow = false })
		tag(sill, "Roof")
		for k = 0, math.floor(w / 0.6) do
			local fa = along - w / 2 + 0.3 + k * 0.6
			local fx = seg.axis == "z" and fa or x + outsideSign * 0.3
			local fz = seg.axis == "z" and z + outsideSign * 0.3 or fa
			local leaf = Kit.blob(parent, 0.55, 0.4, 0.55, fx, y - h / 2 + 0.12, fz, k % 3 == 1 and P.sakura_dark or P.leaf, M.leafy, { collide = false, shadow = false })
			tag(leaf, "Roof")
	end
	end
	for j = 0, rows do
		local yy = y - h / 2 + h * j / rows
		local bar = Kit.box(parent, sx + (seg.axis == "x" and 0.04 or 0), 0.1, sz + (seg.axis == "z" and 0.04 or 0), x + (seg.axis == "x" and outsideSign * 0.06 or 0), yy, z + (seg.axis == "z" and outsideSign * 0.06 or 0), P.wood_dark, M.wood, { collide = false, shadow = false })
		tag(bar, "Roof")
	end
end

-- Big shop sign above the entrance
function B.sign(parent, x, y, z, w, text, deluxe)
	local board = Kit.box(parent, w, 2.6, 0.4, x, y, z, deluxe and P.black or P.wood_dark, M.wood, { collide = false })
	tag(board, "Roof")
	local face = Kit.box(parent, w - 0.4, 2.1, 0.05, x, y, z - 0.23, deluxe and P.black or P.hinoki, M.wood, { collide = false })
	tag(face, "Roof")
	Kit.text(face, Enum.NormalId.Front, text, { color = deluxe and "#FFD23B" or "#2B2320", font = JP_FONT, glow = deluxe, pps = 30 })
	if deluxe then
		for _, dy in ipairs({ -1.25, 1.25 }) do
			local tube = Kit.box(parent, w, 0.1, 0.1, x, y + dy, z - 0.25, P.neon_yellow, M.neon, { collide = false })
			tag(tube, "Roof")
		end
		Kit.light(face, "Surface", P.neon_yellow, 12, 2, { face = Enum.NormalId.Front })
	end
	return face
end

-- "Open / preparing" plate next to the door; returns the TextLabel
function B.openSign(parent, x, y, z)
	local plate = Kit.box(parent, 1.6, 0.8, 0.1, x, y, z, P.wood_light, M.wood, { collide = false })
	Kit.cyl(parent, 0.04, 0.8, x, y + 0.6, z, P.black, M.fabric, { collide = false })
	local _, label = Kit.text(plate, Enum.NormalId.Front, "準備中", { color = "#2B2320", font = JP_FONT })
	return label, plate
end

function B.tag(part, name, attrs)
	return tag(part, name, attrs)
end

return function(Registry)
	Registry.Building = B
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000045"><Properties><string name="Name">Decor</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Decorations: lighting, plants, art, statues, garden, festival, seasonal and city items.
-- Parts with the attribute "Animate" are animated by the client (AmbientController).
local Kit = require(script.Parent.Parent.Kit)
local P = require(script.Parent.Parent.Palette)
local M = P.M

local function size(item)
	return Vector3.new(item.size[1], item.size[2], item.size[3])
end

local JP_FONT = Font.new("rbxasset://fonts/families/FredokaOne.json", Enum.FontWeight.Bold)

-- Paper lantern hanging from the top of its box
local function chochin(m, item, bodyColor, text, textColor, scale)
	Kit.finish(m, size(item))
	local h = item.size[2]
	scale = scale or 1
	local bodyH, bodyD = 1.5 * scale, 1.15 * scale
	local cy = h - 0.6 - bodyH / 2
	Kit.cyl(m, 0.05, 0.6, 0, h - 0.3, 0, P.black, M.fabric, { collide = false })
	Kit.cyl(m, 0.7 * scale, 0.18, 0, cy + bodyH / 2 + 0.05, 0, P.black, M.smooth, { collide = false })
	Kit.cyl(m, 0.7 * scale, 0.18, 0, cy - bodyH / 2 - 0.05, 0, P.black, M.smooth, { collide = false })
	local body = Kit.blob(m, bodyD, bodyH, bodyD, 0, cy, 0, bodyColor, M.fabric, { collide = false })
	body.Material = M.smooth
	for i = -2, 2 do
		local yy = cy + i * bodyH * 0.18
		local ring = 1 - (i * 0.18) ^ 2 * 1.2
		Kit.cyl(m, bodyD * ring + 0.02, 0.03, 0, yy, 0, Color3.new(0, 0, 0):Lerp(bodyColor, 0.6), M.smooth, { collide = false, shadow = false })
	end
	if text then
		local panel = Kit.box(m, bodyD * 0.55, bodyH * 0.8, 0.02, 0, cy, -bodyD / 2 - 0.01, P.white, M.smooth, { transparency = 1, collide = false, shadow = false })
		Kit.text(panel, Enum.NormalId.Front, text, { color = textColor or "#141414", font = JP_FONT, pps = 40 })
	end
	Kit.light(body, "Point", P.lamp_warm, 12 * scale, 1.2)
	body:SetAttribute("Animate", "sway")
	return body
end

local function plantPot(m, d, h, color)
	Kit.cyl(m, d, h, 0, h / 2, 0, color or P.charcoal, M.smooth)
	Kit.cyl(m, d + 0.1, 0.1, 0, h - 0.05, 0, color or P.charcoal, M.smooth, { collide = false })
	Kit.cyl(m, d - 0.15, 0.05, 0, h - 0.04, 0, P.wood_dark, M.sand, { collide = false })
end

local function foliage(m, list, color, material)
	for _, b in ipairs(list) do
		Kit.blob(m, b[4], b[5] or b[4] * 0.6, b[6] or b[4], b[1], b[2], b[3], color, material or M.leafy, { collide = false })
	end
end

local function tree(m, item, leafColor, petals)
	Kit.finish(m, size(item))
	local w, h = item.size[1], item.size[2]
	Kit.cyl(m, 0.9, h * 0.5, 0, h * 0.25, 0, P.wood_dark, M.wood)
	Kit.cyl(m, 0.5, h * 0.35, -0.8, h * 0.55, 0.2, P.wood_dark, M.wood, { rot = CFrame.Angles(0, 0, math.rad(30)) })
	Kit.cyl(m, 0.5, h * 0.35, 0.9, h * 0.55, -0.3, P.wood_dark, M.wood, { rot = CFrame.Angles(0, 0, math.rad(-35)) })
	local blobs = {
		{ 0, h * 0.78, 0, w * 0.55 }, { -w * 0.28, h * 0.68, 0.4, w * 0.42 }, { w * 0.3, h * 0.7, -0.3, w * 0.45 },
		{ 0.3, h * 0.88, -0.6, w * 0.4 }, { -0.4, h * 0.62, -w * 0.25, w * 0.35 }, { 0.5, h * 0.6, w * 0.25, w * 0.35 },
	}
	foliage(m, blobs, leafColor, M.leafy)
	if petals then
		local emitter = Kit.box(m, w * 0.6, 0.2, w * 0.6, 0, h * 0.7, 0, P.white, M.smooth, { transparency = 1, collide = false, shadow = false })
		Kit.particles(emitter, "petals")
	end
	Kit.cyl(m, 2, 0.15, 0, 0.075, 0, P.wood_dark, M.ground or M.sand, { collide = false })
end

local function stoneLantern(m, item, stoneColor, roofColor, glowColor)
	Kit.finish(m, size(item))
	local h = item.size[2]
	local s = h / 4.5
	Kit.cyl(m, 1.6 * s, 0.4 * s, 0, 0.2 * s, 0, stoneColor, M.granite)
	Kit.cyl(m, 0.6 * s, 1.6 * s, 0, 1.2 * s, 0, stoneColor, M.granite)
	Kit.box(m, 1.4 * s, 0.25 * s, 1.4 * s, 0, 2.1 * s, 0, stoneColor, M.granite)
	local light = Kit.box(m, 0.9 * s, 0.9 * s, 0.9 * s, 0, 2.7 * s, 0, glowColor or P.paper_warm, M.neon, { collide = false })
	Kit.box(m, 1.05 * s, 0.95 * s, 0.3 * s, 0, 2.7 * s, 0, stoneColor, M.granite)
	Kit.box(m, 0.3 * s, 0.95 * s, 1.05 * s, 0, 2.7 * s, 0, stoneColor, M.granite)
	Kit.light(light, "Point", P.lamp_warm, 10, 1)
	-- roof: four wedges forming a shallow pyramid
	local ry = 3.35 * s
	for i = 0, 3 do
		local rot = CFrame.Angles(0, math.rad(90 * i), 0)
		Kit.wedge(m, 1.9 * s, 0.5 * s, 0.95 * s, CFrame.new(0, ry, 0) * rot * CFrame.new(0, 0, -0.475 * s), roofColor or stoneColor, M.granite)
	end
	Kit.ball(m, 0.4 * s, 0, ry + 0.45 * s, 0, roofColor or stoneColor, M.granite)
end

local function neon(m, item, text, color)
	Kit.finish(m, size(item))
	local w, h, d = item.size[1], item.size[2], item.size[3]
	local board = Kit.box(m, w, h, 0.15, 0, h / 2, d / 2 - 0.075, P.charcoal, M.smooth)
	local face = Kit.box(m, w - 0.2, h - 0.2, 0.05, 0, h / 2, d / 2 - 0.18, P.charcoal, M.smooth, { collide = false })
	Kit.text(face, Enum.NormalId.Front, text, { color = color, glow = true, font = JP_FONT, pps = 40 })
	Kit.light(face, "Surface", color, 10, 1.5, { face = Enum.NormalId.Front, angle = 120 })
	for _, x in ipairs({ -w / 2 + 0.05, w / 2 - 0.05 }) do
		Kit.box(m, 0.06, h - 0.1, 0.06, x, h / 2, d / 2 - 0.2, color, M.neon, { collide = false })
	end
	local _ = board
end

local function noren(m, item, color, text, textColor)
	Kit.finish(m, size(item))
	local w, h, d = item.size[1], item.size[2], item.size[3]
	Kit.cylH(m, 0.15, w + 0.3, 0, h - 0.1, d / 2 - 0.1, P.wood_dark, M.wood, { collide = false })
	local panels = 3
	local pw = w / panels
	for i = 0, panels - 1 do
		local x = -w / 2 + pw * (i + 0.5)
		local cloth = Kit.box(m, pw - 0.08, h - 0.25, 0.05, x, (h - 0.25) / 2 + 0.05, d / 2 - 0.12, color, M.fabric, { collide = false })
		cloth:SetAttribute("Animate", "sway")
	end
	if text then
		local panel = Kit.box(m, w - 0.2, h * 0.5, 0.02, 0, h * 0.55, d / 2 - 0.16, P.white, M.smooth, { transparency = 1, collide = false, shadow = false })
		Kit.text(panel, Enum.NormalId.Front, text, { color = textColor or "#FFFFFF", font = JP_FONT, pps = 40 })
	end
end

local function frame(m, w, h, d, color)
	for _, s in ipairs({ { 0, h - 0.1, w, 0.2 }, { 0, 0.1, w, 0.2 } }) do
		Kit.box(m, s[3], s[4], d, s[1], s[2], 0, color, M.wood, { collide = false })
	end
	for _, x in ipairs({ -w / 2 + 0.1, w / 2 - 0.1 }) do
		Kit.box(m, 0.2, h, d, x, h / 2, 0, color, M.wood, { collide = false })
	end
end

local function torii(m, item, color, capColor)
	Kit.finish(m, size(item))
	local w, h = item.size[1], item.size[2]
	for _, x in ipairs({ -w / 2 + 0.9, w / 2 - 0.9 }) do
		Kit.cyl(m, 0.7, h - 0.8, x, (h - 0.8) / 2, 0, color, M.smooth)
		Kit.cyl(m, 0.85, 0.5, x, 0.25, 0, capColor, M.smooth)
	end
	Kit.box(m, w - 0.8, 0.4, 0.5, 0, h - 2.2, 0, color, M.smooth)
	Kit.box(m, w + 0.4, 0.45, 0.8, 0, h - 0.7, 0, color, M.smooth)
	Kit.box(m, w + 0.8, 0.3, 0.9, 0, h - 0.3, 0, capColor, M.smooth)
	for _, sgn in ipairs({ -1, 1 }) do
		Kit.wedge(m, 0.9, 0.35, 0.6, CFrame.new(sgn * (w / 2 + 0.55), h - 0.25, 0) * CFrame.Angles(0, math.rad(sgn * 90), 0), capColor, M.smooth)
	end
	Kit.box(m, 0.4, 1.2, 0.3, 0, h - 1.45, 0, color, M.smooth)
end

local function shisa(m, x, color, mouthOpen)
	Kit.box(m, 1.6, 0.5, 1.4, x, 0.25, 0, P.stone, M.granite)
	Kit.blob(m, 1.2, 1.2, 1.1, x, 1.05, 0.1, color, M.granite)
	Kit.ball(m, 0.9, x, 1.9, -0.15, color, M.granite)
	Kit.blob(m, 1.2, 0.5, 0.4, x, 2.2, 0.1, P.wood, M.granite, { collide = false })
	for _, ex in ipairs({ -0.22, 0.22 }) do
		Kit.ball(m, 0.18, x + ex, 2.0, -0.55, P.white, M.smooth, { collide = false })
		Kit.ball(m, 0.08, x + ex, 2.0, -0.63, P.black, M.smooth, { collide = false })
	end
	Kit.box(m, 0.5, mouthOpen and 0.25 or 0.08, 0.1, x, 1.7, -0.6, P.lacquer_dark, M.smooth, { collide = false })
end

return function(Registry)
	-- Lighting --------------------------------------------------------------------------------
	Registry.register("chochin_red", function(m, item)
		chochin(m, item, P.lacquer, "ラーメン", "#141414")
	end)
	Registry.register("chochin_white", function(m, item)
		chochin(m, item, P.paper, "寿司", "#B3262E")
	end)
	Registry.register("fireworks_lantern", function(m, item)
		chochin(m, item, P.neon_blue, "花火", "#FFFFFF")
	end)
	Registry.register("andon_lamp", function(m, item)
		Kit.finish(m, size(item))
		local h = item.size[2]
		for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }) do
			Kit.box(m, 0.12, h, 0.12, c[1] * 0.6, h / 2, c[2] * 0.6, P.wood_black, M.wood)
		end
		local paper = Kit.box(m, 1.1, h - 0.9, 1.1, 0, (h - 0.9) / 2 + 0.6, 0, P.paper_warm, M.neon, { collide = false })
		paper.Transparency = 0.1
		for i = 0, 3 do
			Kit.box(m, 1.25, 0.08, 1.25, 0, 0.6 + i * (h - 0.9) / 3, 0, P.wood_black, M.wood, { collide = false })
		end
		Kit.light(paper, "Point", P.lamp_warm, 12, 1)
	end)
	Registry.register("paper_pendant", function(m, item)
		Kit.finish(m, size(item))
		local h = item.size[2]
		Kit.cyl(m, 0.05, 0.8, 0, h - 0.4, 0, P.black, M.fabric, { collide = false })
		local globe = Kit.ball(m, 1.7, 0, h - 1.65, 0, P.paper, M.neon, { collide = false })
		globe.Transparency = 0.05
		for i = -1, 1 do
			Kit.cyl(m, 1.7 - math.abs(i) * 0.5, 0.03, 0, h - 1.65 + i * 0.5, 0, P.paper_warm, M.smooth, { collide = false })
		end
		Kit.light(globe, "Point", P.lamp_warm, 14, 1.1)
		globe:SetAttribute("Animate", "sway")
	end)
	Registry.register("toro_stone", function(m, item)
		stoneLantern(m, item, P.stone, P.stone_dark)
	end)
	Registry.register("kyoto_lantern", function(m, item)
		stoneLantern(m, item, P.stone_light, P.moss, P.lamp)
	end)
	Registry.register("snow_lantern", function(m, item)
		stoneLantern(m, item, P.stone, P.white, P.paper_warm)
	end)
	Registry.register("neon_ramen", function(m, item)
		neon(m, item, "ラーメン", P.neon_red)
	end)
	Registry.register("neon_sushi", function(m, item)
		neon(m, item, "寿司", P.neon_blue)
	end)
	local function lanternString(m, item, colors, scale)
		Kit.finish(m, size(item))
		local w, h = item.size[1], item.size[2]
		Kit.cylH(m, 0.05, w, 0, h - 0.1, 0, P.black, M.fabric, { collide = false })
		local n = 5
		for i = 0, n - 1 do
			local x = -w / 2 + 0.6 + (w - 1.2) * i / (n - 1)
			local sag = 0.4 * math.sin(math.pi * i / (n - 1))
			local c = colors[i % #colors + 1]
			local b = Kit.blob(m, 0.7 * scale, 1 * scale, 0.7 * scale, x, h - 0.75 * scale - sag, 0, c, M.smooth, { collide = false })
			Kit.cyl(m, 0.45 * scale, 0.1, x, h - 0.2 * scale - sag, 0, P.black, M.smooth, { collide = false })
			b:SetAttribute("Animate", "sway")
			if i % 2 == 0 then
				Kit.light(b, "Point", P.lamp_warm, 9, 0.8)
			end
		end
	end
	Registry.register("lantern_string", function(m, item)
		lanternString(m, item, { P.lacquer, P.paper }, 1)
	end)
	Registry.register("yatai_lanterns", function(m, item)
		lanternString(m, item, { P.lacquer, P.lacquer, P.gold }, 1.4)
	end)

	-- Plants ------------------------------------------------------------------------------------
	Registry.register("bamboo_pot", function(m, item)
		Kit.finish(m, size(item))
		local h = item.size[2]
		plantPot(m, 1.4, 1.1, P.charcoal)
		for i, c in ipairs({ { -0.3, -0.2 }, { 0.25, -0.25 }, { 0, 0.3 }, { 0.35, 0.2 }, { -0.35, 0.25 } }) do
			local sh = h - 1.2 - (i % 3) * 0.4
			Kit.cyl(m, 0.16, sh, c[1], 1.1 + sh / 2, c[2], P.bamboo_green, M.wood)
			for k = 1, 3 do
				Kit.cyl(m, 0.19, 0.06, c[1], 1.1 + sh * k / 4, c[2], P.leaf_dark, M.wood, { collide = false })
			end
			Kit.box(m, 0.6, 0.04, 0.18, c[1] + 0.3, 1.1 + sh - 0.1, c[2], P.leaf, M.leafy, { collide = false, rot = CFrame.Angles(0, math.rad(i * 70), math.rad(-25)) })
			Kit.box(m, 0.6, 0.04, 0.18, c[1] - 0.3, 1.1 + sh - 0.4, c[2], P.leaf_light, M.leafy, { collide = false, rot = CFrame.Angles(0, math.rad(i * 40), math.rad(25)) })
		end
	end)
	Registry.register("kokedama", function(m, item)
		Kit.finish(m, size(item))
		local h = item.size[2]
		Kit.cyl(m, 0.04, 1.2, 0, h - 0.6, 0, P.wood, M.fabric, { collide = false })
		local ball = Kit.ball(m, 0.9, 0, h - 1.6, 0, P.moss, M.leafy, { collide = false })
		ball:SetAttribute("Animate", "sway")
		foliage(m, { { 0, h - 1.05, 0, 0.6, 0.4 }, { 0.25, h - 1.0, 0.1, 0.4, 0.3 } }, P.leaf_light)
	end)
	local function bonsai(m, item, scale, pot)
		Kit.finish(m, size(item))
		local s = scale
		Kit.box(m, 1.6 * s, 0.35 * s, 1.0 * s, 0, 0.175 * s, 0, pot or P.indigo, M.smooth)
		Kit.box(m, 1.5 * s, 0.05, 0.9 * s, 0, 0.36 * s, 0, P.moss, M.leafy, { collide = false })
		Kit.cyl(m, 0.22 * s, 0.7 * s, -0.1 * s, 0.7 * s, 0, P.wood_dark, M.wood, { rot = CFrame.Angles(0, 0, math.rad(-20)) })
		Kit.cyl(m, 0.16 * s, 0.6 * s, 0.2 * s, 1.05 * s, 0, P.wood_dark, M.wood, { rot = CFrame.Angles(0, 0, math.rad(45)) })
		foliage(m, {
			{ -0.35 * s, 1.15 * s, 0, 0.8 * s, 0.3 * s }, { 0.45 * s, 1.3 * s, 0.05 * s, 0.7 * s, 0.25 * s },
			{ 0.05 * s, 1.45 * s, -0.05 * s, 0.6 * s, 0.25 * s },
		}, P.leaf_dark)
	end
	Registry.register("bonsai_pine", function(m, item)
		bonsai(m, item, 1)
	end)
	Registry.register("bonsai_ancient", function(m, item)
		Kit.finish(m, size(item))
		Kit.box(m, 2.6, 1.2, 2.2, 0, 0.6, 0, P.wood_black, M.wood)
		local sub = Kit.model("b")
		sub.Parent = m
		local fake = { size = { 2.6, 2.6, 2.2 } }
		bonsai(sub, fake, 1.6, P.lacquer_dark)
		sub.PrimaryPart:Destroy()
		for _, d in ipairs(sub:GetDescendants()) do
			if d:IsA("BasePart") then
				d.CFrame = CFrame.new(0, 1.2, 0) * d.CFrame
			end
		end
	end)
	Registry.register("ikebana", function(m, item)
		Kit.finish(m, size(item))
		Kit.cyl(m, 0.6, 0.7, 0, 0.35, 0, P.ink, M.smooth)
		Kit.cyl(m, 0.05, 1.1, -0.1, 1.2, 0, P.leaf, M.wood, { collide = false, rot = CFrame.Angles(0, 0, math.rad(15)) })
		Kit.cyl(m, 0.05, 0.9, 0.15, 1.1, 0.05, P.leaf, M.wood, { collide = false, rot = CFrame.Angles(0, 0, math.rad(-20)) })
		Kit.ball(m, 0.3, -0.25, 1.7, 0, P.sakura, M.smooth, { collide = false })
		Kit.ball(m, 0.25, 0.32, 1.5, 0.05, P.lacquer, M.smooth, { collide = false })
		Kit.ball(m, 0.2, 0, 1.35, -0.15, P.white, M.smooth, { collide = false })
	end)
	Registry.register("maple_tree", function(m, item)
		tree(m, item, P.maple, false)
	end)
	Registry.register("sakura_tree", function(m, item)
		tree(m, item, P.sakura, true)
	end)

	-- Art & walls --------------------------------------------------------------------------------
	Registry.register("noren_red", function(m, item)
		noren(m, item, P.lacquer, "ラーメン", "#FFFFFF")
	end)
	Registry.register("noren_indigo", function(m, item)
		noren(m, item, P.indigo, "寿司", "#FFFFFF")
	end)
	Registry.register("menu_plaques", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		Kit.box(m, w, 0.15, d, 0, h - 0.1, 0, P.wood_dark, M.wood, { collide = false })
		local words = { "醤油", "塩", "味噌", "鮭", "鮪", "茶" }
		for i, word in ipairs(words) do
			local x = -w / 2 + w / #words * (i - 0.5)
			local tag = Kit.box(m, w / #words - 0.1, h - 0.35, 0.08, x, (h - 0.35) / 2, d / 2 - 0.1, P.hinoki, M.wood, { collide = false })
			Kit.text(tag, Enum.NormalId.Front, word, { color = "#2B2320", font = JP_FONT, pps = 40 })
		end
	end)
	Registry.register("fan_wall", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		local cx, cy = 0, 0.2
		for i = 0, 8 do
			local a = math.rad(-80 + i * 20)
			local len = h - 0.3
			local cf = CFrame.new(cx, cy, d / 2 - 0.1) * CFrame.Angles(0, 0, a) * CFrame.new(0, len / 2, 0)
			Kit.part(m, Vector3.new(w / 6, len, 0.04), cf, (i % 2 == 0) and P.lacquer or P.gold, M.fabric, { collide = false })
		end
		Kit.ball(m, 0.25, cx, cy, d / 2 - 0.05, P.wood_black, M.smooth, { collide = false })
	end)
	Registry.register("kakejiku", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		local paper = Kit.box(m, w - 0.2, h - 0.7, 0.04, 0, h / 2, d / 2 - 0.1, P.paper, M.fabric, { collide = false })
		Kit.box(m, w, h - 0.4, 0.03, 0, h / 2, d / 2 - 0.07, P.indigo, M.fabric, { collide = false })
		Kit.text(paper, Enum.NormalId.Front, "和", { color = "#141414", font = JP_FONT, pps = 30 })
		Kit.cylH(m, 0.12, w + 0.2, 0, h - 0.15, d / 2 - 0.1, P.wood_dark, M.wood, { collide = false })
		Kit.cylH(m, 0.16, w + 0.4, 0, 0.15, d / 2 - 0.1, P.wood_black, M.wood, { collide = false })
	end)
	Registry.register("wagasa", function(m, item)
		Kit.finish(m, size(item))
		local w, h = item.size[1], item.size[2]
		Kit.cyl(m, 0.8, 0.3, 0, 0.15, 0, P.wood_black, M.wood)
		Kit.cyl(m, 0.12, h - 0.4, 0, (h - 0.4) / 2 + 0.3, 0, P.wood_dark, M.wood)
		local canopy = Kit.cyl(m, w, 0.12, 0, h - 0.5, 0, P.lacquer, M.fabric, { collide = false })
		local _ = canopy
		Kit.cyl(m, w * 0.6, 0.2, 0, h - 0.35, 0, P.lacquer, M.fabric, { collide = false })
		Kit.ball(m, 0.3, 0, h - 0.15, 0, P.wood_black, M.smooth, { collide = false })
		for i = 0, 7 do
			local a = math.rad(i * 45)
			local cf = CFrame.new(0, h - 0.55, 0) * CFrame.Angles(0, a, 0) * CFrame.new(w / 4, -0.02, 0)
			Kit.part(m, Vector3.new(w / 2, 0.03, 0.06), cf, P.gold, M.wood, { collide = false })
		end
	end)
	Registry.register("wave_painting", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		local z = d / 2 - 0.08
		Kit.box(m, w - 0.3, h - 0.3, 0.04, 0, h / 2, z, P.paper_warm, M.fabric, { collide = false })
		local bands = { P.navy, P.indigo, P.water_dark, P.water }
		for i, c in ipairs(bands) do
			local bh = (h - 0.6) * 0.5 / #bands
			Kit.box(m, w - 0.5, bh, 0.03, 0, 0.3 + bh * (i - 0.5), z - 0.02, c, M.fabric, { collide = false })
		end
		for i = 0, 5 do
			Kit.blob(m, 0.6, 0.35, 0.02, -w / 2 + 0.6 + i * (w - 1.2) / 5, 0.3 + (h - 0.6) * 0.5 + 0.05 * (i % 2), z - 0.04, P.white, M.smooth, { collide = false })
		end
		Kit.ball(m, 0.6, w / 2 - 0.9, h - 0.8, z - 0.03, P.lacquer, M.smooth, { collide = false })
		frame(m, w, h, 0.2, P.wood_black)
	end)
	Registry.register("byobu", function(m, item)
		Kit.finish(m, size(item))
		local w, h = item.size[1], item.size[2]
		local n = 6
		local pw = w / n
		for i = 0, n - 1 do
			local x = -w / 2 + pw * (i + 0.5)
			local z = (i % 2 == 0) and -0.15 or 0.15
			local yaw = (i % 2 == 0) and 12 or -12
			local cf = CFrame.new(x, h / 2, z) * CFrame.Angles(0, math.rad(yaw), 0)
			Kit.part(m, Vector3.new(pw - 0.04, h, 0.1), cf, P.gold, M.foil)
			Kit.part(m, Vector3.new(pw + 0.02, 0.15, 0.14), cf * CFrame.new(0, h / 2 - 0.07, 0), P.wood_black, M.wood, { collide = false })
			Kit.part(m, Vector3.new(pw + 0.02, 0.15, 0.14), cf * CFrame.new(0, -h / 2 + 0.07, 0), P.wood_black, M.wood, { collide = false })
			Kit.blob(m, pw * 0.8, 0.6, 0.05, x, h * 0.62 + (i % 3) * 0.2, z - 0.08, P.leaf_dark, M.smooth, { collide = false })
		end
	end)
	Registry.register("kimono_display", function(m, item)
		Kit.finish(m, size(item))
		local w, h = item.size[1], item.size[2]
		Kit.box(m, w * 0.6, 0.3, 0.8, 0, 0.15, 0, P.wood_black, M.wood)
		Kit.box(m, 0.15, h - 0.4, 0.15, 0, h / 2, 0.2, P.wood_black, M.wood)
		Kit.cylH(m, 0.12, w, 0, h - 0.6, 0.1, P.wood_black, M.wood, { collide = false })
		Kit.box(m, 1.6, h - 1.8, 0.25, 0, (h - 1.8) / 2 + 0.6, 0, P.lacquer, M.fabric)
		Kit.box(m, w - 0.2, 1.4, 0.2, 0, h - 1.4, 0, P.lacquer, M.fabric, { collide = false })
		Kit.box(m, 1.65, 0.5, 0.3, 0, h - 2.6, 0, P.gold, M.fabric, { collide = false })
		for i = 0, 4 do
			Kit.ball(m, 0.35, -0.6 + i * 0.3, 1.2 + (i % 2) * 0.9, -0.14, P.sakura, M.fabric, { collide = false })
		end
	end)

	-- Statues & objects ------------------------------------------------------------------------
	local function maneki(m, item, body, accent)
		Kit.finish(m, size(item))
		local s = item.size[2] / 1.3
		Kit.blob(m, 0.75 * s, 0.7 * s, 0.6 * s, 0, 0.35 * s, 0, body, M.smooth)
		Kit.ball(m, 0.62 * s, 0, 0.95 * s, -0.02 * s, body, M.smooth, { collide = false })
		for _, x in ipairs({ -0.2, 0.2 }) do
			Kit.wedge(m, 0.05, 0.22 * s, 0.18 * s, CFrame.new(x * s, 1.27 * s, 0) * CFrame.Angles(0, math.rad(90), 0), body, M.smooth, { collide = false })
			Kit.ball(m, 0.08 * s, x * 0.6 * s, 1.0 * s, -0.3 * s, P.black, M.smooth, { collide = false })
		end
		Kit.cyl(m, 0.55 * s, 0.06 * s, 0, 0.68 * s, 0, P.lacquer, M.smooth, { collide = false })
		Kit.ball(m, 0.12 * s, 0, 0.64 * s, -0.27 * s, accent, M.metal, { collide = false })
		Kit.cyl(m, 0.3 * s, 0.05, 0.15 * s, 0.35 * s, -0.31 * s, accent, M.metal, { collide = false, rot = CFrame.Angles(math.rad(90), 0, 0) })
		local paw = Kit.blob(m, 0.18 * s, 0.4 * s, 0.18 * s, -0.33 * s, 1.0 * s, -0.12 * s, body, M.smooth, { collide = false, name = "Paw" })
		paw:SetAttribute("Animate", "paw")
	end
	Registry.register("maneki_neko", function(m, item)
		maneki(m, item, P.white, P.gold)
	end)
	Registry.register("maneki_gold", function(m, item)
		maneki(m, item, P.gold, P.lacquer)
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("BasePart") and d.Color == P.gold then
				d.Material = M.foil
			end
		end
	end)
	Registry.register("daruma", function(m, item)
		Kit.finish(m, size(item))
		Kit.blob(m, 1, 1.1, 0.95, 0, 0.55, 0, P.lacquer, M.smooth)
		Kit.blob(m, 0.6, 0.5, 0.1, 0, 0.62, -0.42, P.porcelain, M.smooth, { collide = false })
		Kit.ball(m, 0.14, -0.13, 0.68, -0.47, P.black, M.smooth, { collide = false })
		Kit.ball(m, 0.14, 0.13, 0.68, -0.47, P.white, M.smooth, { collide = false })
		Kit.box(m, 0.4, 0.15, 0.02, 0, 0.3, -0.47, P.gold, M.smooth, { collide = false })
	end)
	Registry.register("soy_barrel", function(m, item)
		Kit.finish(m, size(item))
		local w, h = item.size[1], item.size[2]
		local body = Kit.cyl(m, w - 0.1, h - 0.2, 0, (h - 0.2) / 2, 0, P.wood, M.wood)
		Kit.cyl(m, w - 0.2, 0.2, 0, h - 0.1, 0, P.paper_warm, M.fabric, { collide = false })
		for _, y in ipairs({ 0.4, h / 2, h - 0.5 }) do
			Kit.cyl(m, w + 0.02, 0.12, 0, y, 0, P.bamboo, M.fabric, { collide = false })
		end
		local label = Kit.box(m, 0.9, 1.1, 0.02, 0, h / 2, -w / 2 + 0.02, P.white, M.smooth, { collide = false })
		Kit.text(label, Enum.NormalId.Front, "醤油", { color = "#141414", font = JP_FONT, bg = "#F4EBDD" })
		local _ = body
	end)
	Registry.register("tanuki", function(m, item)
		Kit.finish(m, size(item))
		Kit.blob(m, 1.5, 1.6, 1.3, 0, 0.8, 0, P.wood, M.smooth)
		Kit.blob(m, 1.0, 1.0, 0.4, 0, 0.75, -0.5, P.sand, M.smooth, { collide = false })
		Kit.ball(m, 1.1, 0, 1.95, 0, P.wood, M.smooth)
		Kit.cyl(m, 1.4, 0.12, 0, 2.5, 0, P.bamboo, M.fabric, { collide = false })
		Kit.ball(m, 0.6, 0, 2.6, 0, P.bamboo, M.fabric, { collide = false })
		Kit.blob(m, 0.7, 0.3, 0.2, 0, 1.95, -0.5, P.sand, M.smooth, { collide = false })
		for _, x in ipairs({ -0.2, 0.2 }) do
			Kit.ball(m, 0.15, x, 2.05, -0.5, P.black, M.smooth, { collide = false })
		end
		Kit.cyl(m, 0.4, 0.7, 0.7, 0.9, -0.2, P.porcelain, M.smooth, { collide = false })
	end)
	Registry.register("aquarium", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		Kit.box(m, w, 2, d, 0, 1, 0, P.wood_black, M.wood)
		Kit.box(m, w, h - 2.2, d, 0, 2 + (h - 2.2) / 2, 0, P.glass, M.glass, { transparency = 0.7 })
		Kit.box(m, w - 0.2, h - 2.6, d - 0.2, 0, 2 + (h - 2.6) / 2 + 0.1, 0, P.water, M.glass, { transparency = 0.55, collide = false })
		Kit.box(m, w - 0.2, 0.3, d - 0.2, 0, 2.15, 0, P.sand, M.pebble, { collide = false })
		Kit.box(m, w, 0.2, d, 0, h - 0.1, 0, P.wood_black, M.wood)
		for i = 0, 4 do
			local fish = Kit.blob(m, 0.4, 0.22, 0.12, -1.5 + i * 0.7, 2.8 + (i % 3) * 0.5, -0.2 + (i % 2) * 0.4, (i % 2 == 0) and P.koi_orange or P.neon_yellow, M.smooth, { collide = false })
			fish:SetAttribute("Animate", "fish")
		end
		for i = 0, 3 do
			Kit.cyl(m, 0.1, 1.2, -1.8 + i * 1.2, 2.9, 0.3, P.leaf, M.leafy, { collide = false })
		end
		local lamp = Kit.box(m, w - 0.4, 0.05, 0.4, 0, h - 0.25, 0, P.white, M.neon, { collide = false })
		Kit.light(lamp, "Surface", P.neon_blue, 8, 1, { face = Enum.NormalId.Bottom })
	end)
	Registry.register("samurai_armor", function(m, item)
		Kit.finish(m, size(item))
		local h = item.size[2]
		Kit.box(m, 2.2, 0.5, 1.8, 0, 0.25, 0, P.wood_black, M.wood)
		Kit.box(m, 0.3, 2, 0.3, 0, 1.4, 0.2, P.wood_black, M.wood)
		for i = 0, 3 do
			Kit.box(m, 1.6 - i * 0.05, 0.3, 1.0, 0, 2.2 + i * 0.32, 0, (i % 2 == 0) and P.lacquer or P.black, M.smooth)
		end
		for _, x in ipairs({ -1, 1 }) do
			for i = 0, 2 do
				Kit.box(m, 0.7, 0.25, 0.9, x * 1.05, 3.5 - i * 0.28, 0, (i % 2 == 0) and P.black or P.lacquer, M.smooth, { rot = CFrame.Angles(0, 0, math.rad(x * -15)) })
			end
		end
		for i = 0, 2 do
			Kit.box(m, 1.8, 0.3, 1.1, 0, 1.7 - i * 0.3, 0, (i % 2 == 0) and P.black or P.lacquer, M.smooth, { collide = false })
		end
		Kit.ball(m, 1, 0, h - 1.4, 0, P.black, M.smooth)
		Kit.box(m, 1.6, 0.15, 1.4, 0, h - 1.6, 0, P.black, M.smooth, { collide = false })
		Kit.box(m, 0.7, 0.4, 0.15, 0, h - 1.5, -0.5, P.lacquer_dark, M.smooth, { collide = false })
		for _, x in ipairs({ -1, 1 }) do
			Kit.wedge(m, 0.1, 1, 0.3, CFrame.new(x * 0.35, h - 0.55, -0.35) * CFrame.Angles(0, math.rad(90), math.rad(x * 15)), P.gold, M.foil, { collide = false })
		end
	end)
	Registry.register("dragon_statue", function(m, item)
		Kit.finish(m, size(item))
		local w, h = item.size[1], item.size[2]
		Kit.cyl(m, w - 0.5, 0.8, 0, 0.4, 0, P.stone_dark, M.granite)
		for i = 0, 16 do
			local t = i / 16
			local a = t * math.pi * 3
			local r = 1.6 * (1 - t * 0.5)
			Kit.ball(m, 0.9 - t * 0.35, math.cos(a) * r, 1.1 + t * (h - 2.4), math.sin(a) * r, (i % 2 == 0) and P.matcha or P.leaf_dark, M.smooth, { collide = false })
			if i % 3 == 0 then
				Kit.wedge(m, 0.08, 0.4, 0.3, CFrame.new(math.cos(a) * r, 1.5 + t * (h - 2.4), math.sin(a) * r) * CFrame.Angles(0, -a, 0), P.gold, M.foil, { collide = false })
			end
		end
		local hy = h - 1
		Kit.blob(m, 1.1, 0.8, 1.4, 0, hy, -0.4, P.matcha, M.smooth, { collide = false })
		Kit.blob(m, 0.8, 0.4, 0.6, 0, hy - 0.2, -1.1, P.leaf_dark, M.smooth, { collide = false })
		for _, x in ipairs({ -0.3, 0.3 }) do
			Kit.ball(m, 0.18, x, hy + 0.15, -0.95, P.neon_yellow, M.neon, { collide = false })
			Kit.cyl(m, 0.1, 0.9, x, hy + 0.7, 0, P.gold, M.foil, { collide = false, rot = CFrame.Angles(math.rad(-30), 0, math.rad(x * 30)) })
		end
	end)
	Registry.register("shisa_pair", function(m, item)
		Kit.finish(m, size(item))
		shisa(m, -1.6, P.copper, true)
		shisa(m, 1.6, P.copper, false)
	end)

	-- Garden & water ----------------------------------------------------------------------------
	Registry.register("stone_path", function(m, item)
		Kit.finish(m, size(item))
		Kit.cyl(m, 1.4, 0.18, -0.2, 0.09, -0.15, P.stone, M.slate, { collide = true })
		Kit.cyl(m, 0.8, 0.16, 0.55, 0.08, 0.55, P.stone_light, M.slate)
	end)
	Registry.register("moss_garden", function(m, item)
		Kit.finish(m, size(item))
		local w = item.size[1]
		Kit.box(m, w, 0.3, w, 0, 0.15, 0, P.wood_dark, M.ground or M.sand)
		foliage(m, { { -0.8, 0.4, -0.6, 1.6, 0.5 }, { 0.7, 0.4, 0.5, 1.8, 0.6 }, { 0.6, 0.35, -1, 1, 0.4 } }, P.moss)
		Kit.blob(m, 0.9, 0.7, 0.8, -0.6, 0.55, 0.9, P.stone_dark, M.rock)
		Kit.blob(m, 0.6, 0.5, 0.6, 1.2, 0.5, -0.2, P.stone, M.rock)
	end)
	Registry.register("shishi_odoshi", function(m, item)
		Kit.finish(m, size(item))
		Kit.cyl(m, 1.4, 0.8, 0.8, 0.4, 0, P.stone, M.granite)
		Kit.cyl(m, 1.1, 0.05, 0.8, 0.78, 0, P.water, M.glass, { collide = false, transparency = 0.2 })
		Kit.cyl(m, 0.18, 2.2, -1.3, 1.1, 0, P.bamboo_green, M.wood)
		Kit.cylH(m, 0.14, 1.2, -0.8, 2.1, 0, P.bamboo_green, M.wood, { collide = false })
		for _, z in ipairs({ -0.35, 0.35 }) do
			Kit.box(m, 0.12, 1.4, 0.12, 0.2, 0.7, z, P.bamboo, M.wood)
		end
		local arm = Kit.cylH(m, 0.28, 1.8, 0.4, 1.5, 0, P.bamboo_green, M.wood, { collide = false, name = "Arm" })
		arm:SetAttribute("Animate", "shishi")
		local drip = Kit.box(m, 0.1, 0.1, 0.1, -0.2, 2.0, 0, P.white, M.smooth, { transparency = 1, collide = false })
		Kit.particles(drip, "water", { rate = 4 })
	end)
	Registry.register("zen_garden", function(m, item)
		Kit.finish(m, size(item))
		local w = item.size[1]
		for _, s in ipairs({ { 0, -w / 2 + 0.15, w, 0.3 }, { 0, w / 2 - 0.15, w, 0.3 }, { -w / 2 + 0.15, 0, 0.3, w }, { w / 2 - 0.15, 0, 0.3, w } }) do
			Kit.box(m, s[3], 0.6, s[4], s[1], 0.3, s[2], P.wood_dark, M.wood)
		end
		Kit.box(m, w - 0.6, 0.4, w - 0.6, 0, 0.2, 0, P.sand, M.sand)
		for i = 0, 6 do
			Kit.box(m, w - 0.8, 0.02, 0.08, 0, 0.41, -w / 2 + 0.8 + i * (w - 1.6) / 6, P.stone_light, M.sand, { collide = false })
		end
		Kit.blob(m, 1.2, 0.8, 1, -1, 0.6, -0.8, P.stone_dark, M.rock)
		Kit.blob(m, 0.8, 0.6, 0.7, 1.2, 0.55, 0.9, P.stone, M.rock)
		Kit.blob(m, 0.5, 0.4, 0.5, 0.6, 0.5, -1.4, P.stone, M.rock)
	end)
	Registry.register("koi_pond", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		for i = 0, 13 do
			local a = i / 14 * math.pi * 2
			Kit.blob(m, 1.3, 0.8, 1, math.cos(a) * (w / 2 - 0.6), 0.4, math.sin(a) * (d / 2 - 0.6), (i % 2 == 0) and P.stone or P.stone_dark, M.rock)
		end
		Kit.box(m, w - 1.4, 0.1, d - 1.4, 0, 0.1, 0, P.stone_dark, M.pebble, { collide = false })
		Kit.box(m, w - 1.2, 0.1, d - 1.2, 0, 0.55, 0, P.water, M.glass, { collide = false, transparency = 0.35 })
		for i = 0, 3 do
			local koi = Kit.blob(m, 0.7, 0.18, 0.28, -1.5 + i, 0.45, -0.6 + (i % 2) * 1.1, (i % 2 == 0) and P.koi_orange or P.white, M.smooth, { collide = false })
			koi:SetAttribute("Animate", "koi")
		end
		for i = 0, 2 do
			Kit.cyl(m, 0.8, 0.03, 1.2 - i * 0.9, 0.62, 1 - i * 0.6, P.leaf, M.leafy, { collide = false })
		end
	end)
	Registry.register("red_bridge", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		local n = 8
		for i = 0, n - 1 do
			local t = (i + 0.5) / n
			local y = math.sin(t * math.pi) * (h - 1.2)
			local z = -d / 2 + d * t
			Kit.box(m, w, 0.25, d / n + 0.05, 0, y + 0.12, z, P.wood_light, M.planks)
			for _, x in ipairs({ -w / 2 + 0.1, w / 2 - 0.1 }) do
				Kit.box(m, 0.15, 1, 0.15, x, y + 0.6, z, P.lacquer, M.smooth, { collide = false })
			end
		end
		for _, x in ipairs({ -w / 2 + 0.1, w / 2 - 0.1 }) do
			for i = 0, n - 2 do
				local t1, t2 = (i + 0.5) / n, (i + 1.5) / n
				local y1 = math.sin(t1 * math.pi) * (h - 1.2) + 1.1
				local y2 = math.sin(t2 * math.pi) * (h - 1.2) + 1.1
				local z1, z2 = -d / 2 + d * t1, -d / 2 + d * t2
				local mid = Vector3.new(x, (y1 + y2) / 2, (z1 + z2) / 2)
				local len = math.sqrt((z2 - z1) ^ 2 + (y2 - y1) ^ 2)
				Kit.part(m, Vector3.new(0.18, 0.15, len), CFrame.lookAt(mid, Vector3.new(x, y2, z2)), P.lacquer, M.smooth, { collide = false })
			end
		end
	end)
	Registry.register("torii_small", function(m, item)
		torii(m, item, P.vermilion, P.black)
	end)
	Registry.register("torii_gold", function(m, item)
		torii(m, item, P.gold, P.black)
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("BasePart") and d.Color == P.gold then
				d.Material = M.foil
			end
		end
	end)
	Registry.register("waterfall", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		for i, b in ipairs({ { -1.8, 1.5, 0.8, 2.6, 3, 2 }, { 1.8, 1.8, 0.6, 2.4, 3.6, 2.2 }, { 0, h - 1.6, 1, 3.6, 3, 2 }, { -1.5, 4, 1, 2, 3, 1.8 }, { 1.6, 4.4, 1, 2, 3, 1.8 } }) do
			Kit.blob(m, b[4], b[5], b[6], b[1], b[2], b[3], (i % 2 == 0) and P.stone_dark or P.stone, M.rock)
		end
		local fall = Kit.box(m, 1.4, h - 2, 0.2, 0, (h - 2) / 2 + 1, 0, P.water, M.glass, { collide = false, transparency = 0.3 })
		Kit.particles(fall, "water", { rate = 25 })
		Kit.box(m, w - 0.6, 0.6, 2, 0, 0.3, -d / 2 + 1, P.water, M.glass, { collide = false, transparency = 0.35 })
		local mist = Kit.box(m, 1.6, 0.2, 1, 0, 0.8, -0.6, P.white, M.smooth, { transparency = 1, collide = false })
		Kit.particles(mist, "smoke", { rate = 5 })
	end)

	-- Festival -------------------------------------------------------------------------------------
	Registry.register("nobori", function(m, item)
		Kit.finish(m, size(item))
		local h = item.size[2]
		Kit.cyl(m, 0.8, 0.3, 0, 0.15, 0, P.charcoal, M.concrete)
		Kit.cyl(m, 0.12, h - 0.3, -0.5, h / 2, 0, P.metal, M.metal)
		Kit.cylH(m, 0.08, 1.1, 0.05, h - 0.4, 0, P.metal, M.metal, { collide = false })
		local banner = Kit.box(m, 1.0, h - 2, 0.04, 0.05, h - 0.4 - (h - 2) / 2, 0, P.lacquer, M.fabric, { collide = false })
		banner:SetAttribute("Animate", "sway")
		Kit.text(banner, Enum.NormalId.Front, "ラ\nー\nメ\nン", { color = "#FFFFFF", font = JP_FONT, pps = 30 })
		Kit.text(banner, Enum.NormalId.Back, "ラ\nー\nメ\nン", { color = "#FFFFFF", font = JP_FONT, pps = 30 })
	end)
	Registry.register("vending_machine", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		Kit.box(m, w, h, d, 0, h / 2, 0, P.lacquer, M.smooth)
		local glass = Kit.box(m, w - 0.5, h * 0.5, 0.05, -0.1, h * 0.65, -d / 2 - 0.02, P.white, M.neon, { collide = false })
		glass.Transparency = 0.3
		for r = 0, 2 do
			for c = 0, 4 do
				Kit.cyl(m, 0.3, 0.6, -w / 2 + 0.5 + c * 0.42, h * 0.45 + r * 0.95, -d / 2 + 0.15, ({ P.neon_blue, P.neon_yellow, P.matcha, P.white, P.koi_orange })[c + 1], M.smooth, { collide = false })
			end
		end
		Kit.box(m, w - 0.8, 0.5, 0.2, -0.1, 0.6, -d / 2 - 0.05, P.black, M.smooth, { collide = false })
		Kit.light(glass, "Surface", P.white, 8, 1, { face = Enum.NormalId.Front })
	end)
	Registry.register("gashapon", function(m, item)
		Kit.finish(m, size(item))
		local h = item.size[2]
		Kit.box(m, 1.6, h * 0.45, 1.4, 0, h * 0.225, 0, P.neon_pink, M.smooth)
		Kit.box(m, 0.4, 0.4, 0.1, 0, h * 0.3, -0.72, P.white, M.smooth, { collide = false })
		Kit.ball(m, 1.6, 0, h * 0.45 + 0.75, 0, P.glass, M.glass, { transparency = 0.6 })
		for i = 0, 9 do
			Kit.ball(m, 0.4, -0.4 + (i % 4) * 0.27, h * 0.45 + 0.3 + math.floor(i / 4) * 0.35, -0.2 + (i % 3) * 0.2, ({ P.neon_red, P.neon_blue, P.neon_yellow, P.matcha })[i % 4 + 1], M.smooth, { collide = false })
		end
		Kit.box(m, 1.7, 0.2, 1.5, 0, h - 0.1, 0, P.neon_pink, M.smooth)
	end)
	Registry.register("koinobori", function(m, item)
		Kit.finish(m, size(item))
		local h = item.size[2]
		Kit.cyl(m, 0.25, h, 0, h / 2, 0, P.wood_light, M.wood)
		Kit.ball(m, 0.4, 0, h, 0, P.gold, M.metal)
		for i, c in ipairs({ P.black, P.lacquer, P.navy }) do
			local fish = Kit.blob(m, 2.6 - i * 0.3, 0.7, 0.5, 1.5, h - 1 - i * 1.2, 0, c, M.fabric, { collide = false })
			fish:SetAttribute("Animate", "streamer")
			Kit.ball(m, 0.25, 0.5, h - 0.9 - i * 1.2, -0.2, P.white, M.smooth, { collide = false })
		end
	end)
	Registry.register("taiko", function(m, item)
		Kit.finish(m, size(item))
		local w, h = item.size[1], item.size[2]
		for _, x in ipairs({ -1, 1 }) do
			Kit.box(m, 0.25, h - 0.5, 0.25, x, (h - 0.5) / 2, 0.5, P.wood_black, M.wood)
			Kit.box(m, 0.25, h - 0.5, 0.25, x, (h - 0.5) / 2, -0.5, P.wood_black, M.wood)
		end
		Kit.cylH(m, 2.3, 1.6, 0, h - 1.3, 0, P.lacquer_dark, M.wood, nil, "z")
		Kit.cylH(m, 2.1, 1.7, 0, h - 1.3, 0, P.paper, M.leather, { collide = false }, "z")
		Kit.cylH(m, 2.35, 0.1, 0, h - 1.3, -0.75, P.gold, M.metal, { collide = false }, "z")
		Kit.cylH(m, 2.35, 0.1, 0, h - 1.3, 0.75, P.gold, M.metal, { collide = false }, "z")
		Kit.cyl(m, 0.12, 1.2, 0.8, h - 0.4, -0.9, P.wood_light, M.wood, { collide = false, rot = CFrame.Angles(0, 0, math.rad(40)) })
		Kit.cyl(m, 0.12, 1.2, -0.8, h - 0.4, -0.9, P.wood_light, M.wood, { collide = false, rot = CFrame.Angles(0, 0, math.rad(-40)) })
	end)
	Registry.register("yatai", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		Kit.box(m, w - 1, 2.6, d - 1.4, 0, 1.6, 0.2, P.wood, M.planks)
		Kit.box(m, w - 0.6, 0.2, d - 0.8, 0, 3, 0, P.wood_light, M.wood)
		for _, x in ipairs({ -w / 2 + 0.8, w / 2 - 0.8 }) do
			Kit.cylH(m, 1.4, 0.3, x, 0.7, -d / 2 + 0.9, P.wood_dark, M.wood, nil, "z")
			Kit.box(m, 0.2, h - 3, 0.2, x, 3 + (h - 3) / 2, -d / 2 + 0.6, P.wood_dark, M.wood)
			Kit.box(m, 0.2, h - 3, 0.2, x, 3 + (h - 3) / 2, d / 2 - 0.6, P.wood_dark, M.wood)
		end
		Kit.box(m, w, 0.3, d, 0, h - 0.15, 0, P.wood_black, M.wood)
		local cloth = Kit.box(m, w - 0.4, 1.2, 0.05, 0, h - 0.9, -d / 2 + 0.5, P.lacquer, M.fabric, { collide = false })
		cloth:SetAttribute("Animate", "sway")
		Kit.text(cloth, Enum.NormalId.Front, "おでん・ラーメン", { color = "#FFFFFF", font = JP_FONT, pps = 30 })
		for _, x in ipairs({ -w / 2 + 0.5, w / 2 - 0.5 }) do
			local l = Kit.blob(m, 0.6, 0.9, 0.6, x, h - 1.3, -d / 2 + 0.35, P.lacquer, M.smooth, { collide = false })
			Kit.light(l, "Point", P.lamp_warm, 10, 1)
			l:SetAttribute("Animate", "sway")
		end
		Kit.cyl(m, 1, 0.8, -0.8, 3.5, 0.2, P.metal, M.metal, { collide = false })
	end)

	-- Seasonal ---------------------------------------------------------------------------------------
	Registry.register("hanami_dango", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		Kit.box(m, w, 2.4, d, 0, 1.2, 0, P.wood_light, M.wood)
		local cloth = Kit.box(m, w + 0.1, 0.6, d + 0.1, 0, 2.2, 0, P.sakura, M.fabric, { collide = false })
		local _ = cloth
		for i = 0, 4 do
			local x = -1 + i * 0.5
			Kit.cyl(m, 0.05, 1.2, x, 3, -0.4, P.wood_light, M.wood, { collide = false })
			for k, c in ipairs({ P.sakura, P.white, P.matcha }) do
				Kit.ball(m, 0.3, x, 2.75 + k * 0.28, -0.4, c, M.smooth, { collide = false })
			end
		end
		Kit.cylH(m, 0.1, w, 0, h - 0.4, 0.8, P.wood_dark, M.wood, { collide = false })
		local sign = Kit.box(m, 1.6, 0.8, 0.05, 0, h - 0.9, 0.8, P.paper, M.smooth, { collide = false })
		Kit.text(sign, Enum.NormalId.Front, "団子", { color = "#B3262E", font = JP_FONT })
	end)
	Registry.register("sakura_garland", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		for i = 0, 11 do
			local x = -w / 2 + 0.3 + i * (w - 0.6) / 11
			local y = h - 0.3 - 0.4 * math.sin(math.pi * i / 11)
			Kit.ball(m, 0.4, x, y, d / 2 - 0.2, (i % 2 == 0) and P.sakura or P.white, M.fabric, { collide = false })
		end
	end)
	Registry.register("tanabata_bamboo", function(m, item)
		Kit.finish(m, size(item))
		local h = item.size[2]
		Kit.cyl(m, 1.2, 0.8, 0, 0.4, 0, P.wood_dark, M.wood)
		Kit.cyl(m, 0.25, h - 0.5, 0, h / 2, 0, P.bamboo_green, M.wood)
		for i = 0, 9 do
			local y = 2.5 + i * 0.5
			local a = math.rad(i * 70)
			Kit.part(m, Vector3.new(0.25, 0.7, 0.03), CFrame.new(math.cos(a) * 0.6, y, math.sin(a) * 0.6) * CFrame.Angles(0, a, 0), ({ P.neon_yellow, P.neon_pink, P.neon_blue, P.matcha, P.lacquer })[i % 5 + 1], M.fabric, { collide = false })
			Kit.box(m, 1.2, 0.04, 0.2, math.cos(a) * 0.5, y + 0.3, math.sin(a) * 0.5, P.leaf, M.leafy, { collide = false, rot = CFrame.Angles(0, a, math.rad(-20)) })
		end
	end)
	Registry.register("moon_rabbit", function(m, item)
		Kit.finish(m, size(item))
		Kit.blob(m, 1.1, 0.9, 1, 0, 0.45, 0.1, P.white, M.smooth)
		Kit.ball(m, 0.7, 0, 1.05, -0.2, P.white, M.smooth, { collide = false })
		for _, x in ipairs({ -0.15, 0.15 }) do
			Kit.blob(m, 0.15, 0.7, 0.1, x, 1.6, -0.15, P.white, M.smooth, { collide = false })
			Kit.ball(m, 0.08, x, 1.1, -0.53, P.lacquer, M.smooth, { collide = false })
		end
		for i = 0, 2 do
			Kit.ball(m, 0.25, 0.45 + i * 0.05, 0.12 + i * 0.2, -0.4, P.paper, M.smooth, { collide = false })
		end
	end)
	Registry.register("susuki_vase", function(m, item)
		Kit.finish(m, size(item))
		Kit.cyl(m, 0.6, 0.8, 0, 0.4, 0, P.stone_dark, M.smooth)
		for i = 0, 4 do
			local a = math.rad(-30 + i * 15)
			Kit.part(m, Vector3.new(0.05, 1.4, 0.05), CFrame.new(0, 0.8, 0) * CFrame.Angles(0, 0, a) * CFrame.new(0, 0.7, 0), P.bamboo, M.wood, { collide = false })
			Kit.blob(m, 0.12, 0.4, 0.12, math.sin(-a) * 1.3, 0.8 + math.cos(a) * 1.3, 0, P.sand, M.fabric, { collide = false })
		end
	end)
	Registry.register("kadomatsu", function(m, item)
		Kit.finish(m, size(item))
		local h = item.size[2]
		Kit.cyl(m, 1.6, 1.2, 0, 0.6, 0, P.bamboo, M.fabric)
		for i, hh in ipairs({ h - 0.2, h - 0.9, h - 1.4 }) do
			local a = math.rad(i * 120)
			local x, z = math.cos(a) * 0.3, math.sin(a) * 0.3
			Kit.cyl(m, 0.3, hh - 1, x, 1 + (hh - 1) / 2, z, P.bamboo_green, M.wood)
			Kit.wedge(m, 0.3, 0.5, 0.3, CFrame.new(x, hh + 0.2, z) * CFrame.Angles(0, a, 0), P.bamboo_green, M.wood, { collide = false })
		end
		foliage(m, { { 0, 1.4, 0.6, 1.2, 0.5 }, { -0.5, 1.5, -0.3, 0.9, 0.5 } }, P.leaf_dark)
	end)
	Registry.register("kagami_mochi", function(m, item)
		Kit.finish(m, size(item))
		Kit.box(m, 0.9, 0.3, 0.9, 0, 0.15, 0, P.wood_light, M.wood)
		Kit.blob(m, 0.85, 0.4, 0.85, 0, 0.5, 0, P.white, M.smooth)
		Kit.blob(m, 0.65, 0.32, 0.65, 0, 0.82, 0, P.white, M.smooth, { collide = false })
		Kit.ball(m, 0.35, 0, 1.12, 0, P.koi_orange, M.smooth, { collide = false })
	end)
	Registry.register("osaka_octopus_sign", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		local z = d / 2 - 0.3
		Kit.box(m, w, h * 0.35, 0.2, 0, h * 0.18, d / 2 - 0.1, P.neon_yellow, M.smooth)
		local label = Kit.box(m, w - 0.4, h * 0.3, 0.05, 0, h * 0.18, d / 2 - 0.22, P.neon_yellow, M.smooth, { collide = false })
		Kit.text(label, Enum.NormalId.Front, "たこ焼き", { color = "#B3262E", font = JP_FONT })
		Kit.blob(m, 2.4, 2, 0.6, 0, h * 0.6, z, P.neon_red, M.smooth, { collide = false })
		for _, x in ipairs({ -0.4, 0.4 }) do
			Kit.ball(m, 0.5, x, h * 0.65, z - 0.3, P.white, M.smooth, { collide = false })
			Kit.ball(m, 0.22, x, h * 0.65, z - 0.5, P.black, M.smooth, { collide = false })
		end
		for i = 0, 5 do
			local a = math.rad(-75 + i * 30)
			local tentacle = Kit.part(m, Vector3.new(0.35, 1.5, 0.3), CFrame.new(0, h * 0.42, z) * CFrame.Angles(0, 0, a) * CFrame.new(0, -0.9, 0), P.neon_red, M.smooth, { collide = false })
			tentacle:SetAttribute("Animate", "sway")
		end
	end)
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000046"><Properties><string name="Name">Food</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Food visuals: dishes (per recipe), ingredients, supplier boxes, dirty dishes, cooking tools.
-- Everything is built from primitives with real-world proportions and colours: curved bowls
-- with a glazed band, glossy broth with fat drops, wavy noodles, chashu with a browned edge and a
-- fat ring, jammy eggs, fish with fat lines, translucent roe, crispy batter and so on.
-- Dishes: bottom at y = 0, Root 1.6 x 1 x 1.2 (callers pivot the Root 0.5 above the surface).
local Kit = require(script.Parent.Parent.Kit)
local P = require(script.Parent.Parent.Palette)
local Color = require(script.Parent.Parent.Parent.Util.Color)
local Recipes = require(script.Parent.Parent.Parent.Config.Recipes)
local Ingredients = require(script.Parent.Parent.Parent.Config.Ingredients)
local M = P.M

local function nc(extra)
	local p = { collide = false, shadow = false }
	if extra then
		for k, v in pairs(extra) do
			p[k] = v
		end
	end
	return p
end

local function c(hex)
	return Color.hex(hex)
end

-- Food palette (real colours, not game-y primaries)
local F = {
	rice = c("#F7F4EC"), riceShade = c("#E9E3D3"),
	nori = c("#1C2A1E"), noriLight = c("#2C3D2E"),
	salmon = c("#F27A4A"), salmonFat = c("#FBD3BE"),
	tuna = c("#A8162A"), tunaLight = c("#C2303F"),
	otoro = c("#F0A39A"), otoroFat = c("#FBE4DE"),
	hamachi = c("#F2D9C8"), blood = c("#C8505A"),
	shrimp = c("#F6EDE6"), shrimpRed = c("#EE5A36"),
	eel = c("#5A3418"), sauce = c("#3B2414"),
	ikura = c("#F2541B"), tobiko = c("#F48A1E"),
	wasabi = c("#8DB04A"), gari = c("#F5C6C0"), shiso = c("#3F7A2A"), baran = c("#3E8A34"),
	cucumber = c("#2F6B2A"), cucumberIn = c("#CFE6A8"), avocado = c("#B7C95A"), avocadoSkin = c("#6E9A3A"),
	crab = c("#E8544A"), daikon = c("#F4F4EE"), lemon = c("#F2D84A"),
	noodle = c("#F2D27A"), noodleThick = c("#E8C26A"), soba = c("#7E9A4E"),
	chashuEdge = c("#8A4A2A"), chashuMeat = c("#D9A089"), chashuFat = c("#F3DCCB"),
	eggWhite = c("#F6EEDF"), eggMarinated = c("#D8A86A"), yolk = c("#F09A2A"), yolkCore = c("#E57A12"),
	naruto = c("#FFFFFF"), narutoPink = c("#E8548A"),
	menma = c("#C9A25A"), scallion = c("#5FA63A"), scallionLight = c("#B5D98A"),
	corn = c("#F4CF3B"), butter = c("#F7E39A"), kikurage = c("#2E2420"),
	pork = c("#8A4A3A"), chili = c("#C0261E"), sesame = c("#EDE3C8"), blackSesame = c("#2A2420"),
	tofu = c("#F6F2E6"), wakame = c("#2E4A22"), batter = c("#E9B85A"), golden = c("#D9962E"),
	karaage = c("#B8692A"), takoyaki = c("#C08848"), okoSauce = c("#3E1F12"), mayo = c("#F6F0DC"),
	aonori = c("#5E8A2A"), bonito = c("#D9B48A"), beniShoga = c("#D8343E"), cabbage = c("#D8E8B0"),
	lamb = c("#9A5A4A"), pumpkin = c("#E8902A"), goya = c("#4E8A2E"), scrambled = c("#F3D25A"),
	matcha = c("#7A9A3A"), matchaFoam = c("#A9C25A"), tea = c("#B8C86A"),
	porcelain = c("#F7F5F0"), indigo = c("#2E5A8C"), lacquerRed = c("#B3262E"), lacquerBlack = c("#1A1414"),
}

local BROTH = {
	broth_shoyu = "#7A4A22",
	broth_shio = "#E6C980",
	broth_miso = "#C58A3E",
	broth_tonkotsu = "#F1E4C8",
}

-- Bowl look per recipe (outer, inner, band)
local BOWLS = {
	shoyu_ramen = { P.porcelain, F.porcelain, F.lacquerRed },
	shio_ramen = { P.porcelain, F.porcelain, F.indigo },
	butter_corn_ramen = { P.porcelain, F.porcelain, F.indigo },
	miso_ramen = { c("#5A2A1A"), F.lacquerRed, P.gold },
	tantanmen = { F.lacquerBlack, F.lacquerRed, F.lacquerRed },
	tonkotsu_ramen = { F.lacquerBlack, F.lacquerRed, P.gold },
	hakata_ramen = { F.lacquerBlack, F.lacquerRed, F.lacquerRed },
	mayu_ramen = { F.lacquerBlack, F.lacquerBlack, P.gold },
	okinawa_soba = { c("#E8EEF2"), F.porcelain, c("#3A6A9A") },
}

local function ingColor(id)
	local ing = Ingredients.byId[id]
	return ing and Color.hex(ing.color) or P.white
end

local function has(recipe, id)
	for _, g in ipairs(recipe.ing) do
		if g == id then
			return true
		end
	end
	return false
end

-- Deterministic pseudo random (same dish always looks the same)
local function seq(seed)
	local s = (seed or 1) % 2147483646 + 1
	return function()
		s = (s * 16807) % 2147483647
		return s / 2147483647
	end
end

local function lerp(a, b, t)
	return a:Lerp(b, t)
end

-- Ellipsoid (sphere mesh) placed with a full CFrame
local function blobAt(m, sx, sy, sz, cf, color, mat, props)
	local p = Kit.blob(m, sx, sy, sz, 0, 0, 0, color, mat, props)
	p.CFrame = cf
	return p
end

-- Cylinder of diameter d and height h whose axis is the local Y of cf
local function cylAt(m, d, h, cf, color, mat, props)
	local pr = props or nc()
	pr.shape = Enum.PartType.Cylinder
	return Kit.part(m, Vector3.new(h, d, d), cf * CFrame.Angles(0, 0, math.rad(90)), color, mat, pr)
end

---------------------------------------------------------------------------------------------------
-- Tableware
---------------------------------------------------------------------------------------------------

-- Ramen bowl (donburi): curved wall from stacked rings, foot ring, glazed band and rim. Returns the
-- liquid level y. The inner glaze shows as a ring around the broth.
local function donburi(m, d, h, outer, inner, band)
	local foot = d * 0.42
	Kit.cyl(m, foot, 0.08, 0, 0.04, 0, outer, M.smooth, nc())
	local n = 6
	for i = 1, n do
		local t = i / n
		local dd = foot + (d - foot) * math.sin(t * math.pi / 2)
		local hh = (h - 0.08) / n + 0.012
		local y0 = 0.08 + (h - 0.08) * (i - 1) / n
		Kit.cyl(m, dd, hh, 0, y0 + hh / 2, 0, outer, M.smooth, nc({ reflectance = 0.06 }))
	end
	if band then
		Kit.cyl(m, d + 0.012, 0.08, 0, h - 0.11, 0, band, M.smooth, nc({ reflectance = 0.06 }))
		-- meander notches (raimon pattern) cut into the band
		for k = 0, 15 do
			local a = k * math.pi / 8
			local r = d / 2 + 0.01
			Kit.box(m, 0.045, 0.045, 0.02, math.cos(a) * r, h - 0.11 + ((k % 2 == 0) and 0.012 or -0.012), math.sin(a) * r, outer, M.smooth, nc({ rot = CFrame.Angles(0, math.pi / 2 - a, 0) }))
		end
	end
	Kit.cyl(m, d + 0.02, 0.025, 0, h - 0.012, 0, band or outer, M.smooth, nc())
	Kit.cyl(m, d - 0.02, 0.02, 0, h, 0, inner, M.smooth, nc())
	return h + 0.012
end

-- Glossy liquid with a few fat drops
local function liquid(m, d, y, color, drops, seed)
	Kit.cyl(m, d, 0.02, 0, y, 0, color, M.smooth, nc({ reflectance = 0.14 }))
	local rnd = seq(seed or 7)
	for _ = 1, drops or 0 do
		local a, r = rnd() * math.pi * 2, rnd() * d * 0.4
		local s = 0.04 + rnd() * 0.06
		Kit.cyl(m, s, 0.01, math.cos(a) * r, y + 0.012, math.sin(a) * r, lerp(color, P.white, 0.35), M.smooth, nc({ reflectance = 0.3, transparency = 0.2 }))
	end
end

-- White ceramic plate with a coloured rim line
local function plateRound(m, d, color, rim)
	Kit.cyl(m, d * 0.6, 0.05, 0, 0.025, 0, color or F.porcelain, M.smooth, nc())
	Kit.cyl(m, d, 0.05, 0, 0.07, 0, color or F.porcelain, M.smooth, nc({ reflectance = 0.06 }))
	Kit.cyl(m, d - 0.04, 0.052, 0, 0.072, 0, rim or lerp(color or F.porcelain, P.black, 0.12), M.smooth, nc())
	Kit.cyl(m, d - 0.12, 0.055, 0, 0.073, 0, color or F.porcelain, M.smooth, nc({ reflectance = 0.06 }))
	return 0.1
end

-- Rectangular ceramic plate with raised edges
local function plateRect(m, w, d, color, rim)
	Kit.box(m, w * 0.85, 0.04, d * 0.8, 0, 0.02, 0, color, M.smooth, nc())
	Kit.box(m, w, 0.05, d, 0, 0.065, 0, color, M.smooth, nc({ reflectance = 0.06 }))
	for _, s in ipairs({ -1, 1 }) do
		Kit.box(m, w, 0.05, 0.05, 0, 0.1, s * (d / 2 - 0.025), rim or color, M.smooth, nc())
		Kit.box(m, 0.05, 0.05, d, s * (w / 2 - 0.025), 0.1, 0, rim or color, M.smooth, nc())
	end
	return 0.09
end

-- Wooden geta board for sushi
local function geta(m, w, d)
	Kit.box(m, w, 0.08, d, 0, 0.14, 0, P.hinoki, M.wood, nc())
	Kit.box(m, w - 0.02, 0.01, d - 0.02, 0, 0.185, 0, lerp(P.hinoki, P.white, 0.25), M.wood, nc())
	for _, x in ipairs({ -w / 2 + 0.18, w / 2 - 0.18 }) do
		Kit.box(m, 0.1, 0.1, d - 0.04, x, 0.05, 0, P.wood_light, M.wood, nc())
	end
	return 0.19
end

-- Chopsticks resting on a little ceramic rest (hashioki)
local function chopsticks(m, x, z, yaw, y0)
	local base = CFrame.new(x, y0 or 0, z) * CFrame.Angles(0, math.rad(yaw or 0), 0)
	Kit.part(m, Vector3.new(0.18, 0.06, 0.1), base * CFrame.new(-0.45, 0.03, 0), F.indigo, M.smooth, nc())
	for k = 0, 1 do
		Kit.part(m, Vector3.new(1.3, 0.035, 0.035), base * CFrame.new(0.15, 0.075, -0.03 + k * 0.06) * CFrame.Angles(0, 0, math.rad(-2)), lerp(P.wood_light, P.lacquer_dark, 0.15), M.wood, nc())
	end
end

-- Ceramic soup spoon (renge)
local function renge(m, x, y, z, yaw)
	local base = CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(yaw or 0), 0)
	blobAt(m, 0.34, 0.1, 0.24, base, F.porcelain, M.smooth, nc({ reflectance = 0.08 }))
	blobAt(m, 0.28, 0.04, 0.19, base * CFrame.new(0, 0.035, 0), lerp(F.porcelain, F.indigo, 0.12), M.smooth, nc())
	Kit.part(m, Vector3.new(0.32, 0.04, 0.08), base * CFrame.new(0.28, 0.08, 0) * CFrame.Angles(0, 0, math.rad(25)), F.porcelain, M.smooth, nc())
end

-- Small soy sauce dish
local function soyDish(m, x, z, withChili)
	Kit.cyl(m, 0.36, 0.06, x, 0.03, z, F.porcelain, M.smooth, nc())
	Kit.cyl(m, 0.28, 0.01, x, 0.065, z, F.sauce, M.smooth, nc({ reflectance = 0.2 }))
	if withChili then
		for k = 0, 3 do
			Kit.cyl(m, 0.05, 0.012, x - 0.06 + (k % 2) * 0.1, 0.072, z - 0.05 + math.floor(k / 2) * 0.08, F.chili, M.smooth, nc({ reflectance = 0.2 }))
		end
	end
end

local function wasabiAndGari(m, x, z, y)
	Kit.blob(m, 0.16, 0.12, 0.14, x, y + 0.05, z, F.wasabi, M.sand, nc())
	for k = 0, 3 do
		Kit.blob(m, 0.2, 0.025, 0.14, x + 0.18 + (k % 2) * 0.05, y + 0.02 + k * 0.018, z + 0.02 - (k % 2) * 0.04, F.gari, M.smooth, nc({ rot = CFrame.Angles(math.rad(k * 9), math.rad(k * 35), 0), transparency = 0.1 }))
	end
end

-- Serrated green baran leaf divider
local function baran(m, x, z, y, yaw)
	local base = CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(yaw or 0), 0)
	Kit.part(m, Vector3.new(0.5, 0.12, 0.02), base * CFrame.new(0, 0.06, 0), F.baran, M.smooth, nc())
	for k = 0, 3 do
		Kit.part(m, Vector3.new(0.08, 0.08, 0.021), base * CFrame.new(-0.18 + k * 0.12, 0.12, 0) * CFrame.Angles(0, 0, math.rad(45)), F.baran, M.smooth, nc())
	end
end

---------------------------------------------------------------------------------------------------
-- Sushi pieces
---------------------------------------------------------------------------------------------------

-- Hand-pressed rice with a few loose grains
local function shari(m, base, len)
	len = len or 0.5
	blobAt(m, len, 0.24, 0.3, base, F.rice, M.sand, nc())
	for k = 0, 3 do
		local p = base * CFrame.new(-len / 2 + 0.1 + k * (len - 0.2) / 3, -0.02 + (k % 2) * 0.04, (k % 2 == 0) and 0.14 or -0.14)
		blobAt(m, 0.06, 0.035, 0.035, p * CFrame.Angles(0, k, 0), F.rice, M.smooth, nc())
	end
end

-- Fish slice draped over the rice. kind: salmon | tuna | otoro | hamachi | shrimp | eel
local function neta(m, base, kind, len)
	len = len or 0.62
	local col = ({ salmon = F.salmon, tuna = F.tuna, otoro = F.otoro, hamachi = F.hamachi, shrimp = F.shrimp, eel = F.eel })[kind] or F.salmon
	-- soft rounded slice: an ellipsoid for the draped edges and a flat top
	blobAt(m, len + 0.1, 0.13, 0.36, base * CFrame.new(0, -0.02, 0), col, M.smooth, nc({ reflectance = 0.1 }))
	Kit.part(m, Vector3.new(len - 0.06, 0.07, 0.28), base, col, M.smooth, nc({ reflectance = 0.1 }))
	if kind == "salmon" or kind == "otoro" then
		local fat = kind == "salmon" and F.salmonFat or F.otoroFat
		for k = 0, 3 do
			Kit.part(m, Vector3.new(0.025, 0.083, 0.36), base * CFrame.new(-len / 2 + 0.12 + k * (len - 0.2) / 3, 0.003, 0) * CFrame.Angles(0, math.rad(28), 0), fat, M.smooth, nc())
		end
	elseif kind == "tuna" then
		for k = 0, 1 do
			Kit.part(m, Vector3.new(0.02, 0.082, 0.3), base * CFrame.new(-0.12 + k * 0.24, 0.002, 0) * CFrame.Angles(0, math.rad(25), 0), F.tunaLight, M.smooth, nc())
		end
	elseif kind == "hamachi" then
		Kit.part(m, Vector3.new(len - 0.06, 0.082, 0.05), base * CFrame.new(0, 0.002, 0.11), F.blood, M.smooth, nc())
	elseif kind == "shrimp" then
		for k = 0, 3 do
			Kit.part(m, Vector3.new(0.06, 0.084, 0.32), base * CFrame.new(-len / 2 + 0.12 + k * 0.13, 0.002, 0), F.shrimpRed, M.smooth, nc())
		end
		for _, s in ipairs({ -1, 1 }) do
			Kit.wedge(m, 0.03, 0.18, 0.14, base * CFrame.new(len / 2 + 0.12, -0.02, s * 0.06) * CFrame.Angles(0, math.rad(90), math.rad(-60)), F.shrimpRed, M.smooth, nc())
		end
	elseif kind == "eel" then
		for k = 0, 2 do
			Kit.part(m, Vector3.new(0.025, 0.083, 0.3), base * CFrame.new(-0.18 + k * 0.18, 0.003, 0), lerp(F.eel, P.black, 0.4), M.smooth, nc())
		end
		Kit.part(m, Vector3.new(len - 0.1, 0.02, 0.26), base * CFrame.new(0, 0.05, 0), F.sauce, M.smooth, nc({ reflectance = 0.3, transparency = 0.15 }))
	end
end

local function nigiri(m, x, z, y0, kind, yaw)
	local base = CFrame.new(x, y0 + 0.13, z) * CFrame.Angles(0, math.rad(yaw or 0), 0)
	shari(m, base, 0.46)
	neta(m, base * CFrame.new(0, 0.14, 0), kind, 0.48)
end

-- Thin roll (hosomaki) standing with the cut face up
local function hosomaki(m, x, z, y0, filling)
	Kit.cyl(m, 0.34, 0.3, x, y0 + 0.15, z, F.nori, M.smooth, nc({ reflectance = 0.05 }))
	Kit.cyl(m, 0.3, 0.305, x, y0 + 0.153, z, F.rice, M.sand, nc())
	if filling == "cucumber" then
		Kit.box(m, 0.11, 0.31, 0.11, x, y0 + 0.155, z, F.cucumber, M.smooth, nc())
		Kit.box(m, 0.07, 0.312, 0.07, x, y0 + 0.156, z, F.cucumberIn, M.smooth, nc())
	else
		Kit.box(m, 0.13, 0.31, 0.12, x, y0 + 0.155, z, F.tuna, M.smooth, nc({ reflectance = 0.1 }))
	end
end

-- Inside-out roll piece; style: "california" | "dragon"
local function uramaki(m, x, z, y0, style)
	Kit.cyl(m, 0.42, 0.28, x, y0 + 0.14, z, F.rice, M.sand, nc())
	Kit.cyl(m, 0.25, 0.285, x, y0 + 0.142, z, F.nori, M.smooth, nc())
	Kit.cyl(m, 0.21, 0.29, x, y0 + 0.145, z, F.rice, M.sand, nc())
	if style == "dragon" then
		Kit.box(m, 0.12, 0.292, 0.07, x - 0.02, y0 + 0.146, z, F.eel, M.smooth, nc())
		Kit.box(m, 0.06, 0.292, 0.07, x + 0.06, y0 + 0.146, z + 0.02, F.cucumber, M.smooth, nc())
	else
		Kit.box(m, 0.08, 0.292, 0.06, x - 0.04, y0 + 0.146, z, F.crab, M.smooth, nc())
		Kit.box(m, 0.07, 0.292, 0.06, x + 0.04, y0 + 0.146, z + 0.02, F.avocado, M.smooth, nc())
		Kit.box(m, 0.05, 0.292, 0.05, x + 0.02, y0 + 0.146, z - 0.05, F.cucumber, M.smooth, nc())
		-- tobiko rim and sesame on the outside
		Kit.cyl(m, 0.44, 0.2, x, y0 + 0.13, z, F.tobiko, M.sand, nc())
		for k = 0, 3 do
			local a = k * math.pi / 2 + 0.4
			Kit.box(m, 0.03, 0.02, 0.015, x + math.cos(a) * 0.2, y0 + 0.2, z + math.sin(a) * 0.2, F.sesame, M.smooth, nc())
		end
	end
end

---------------------------------------------------------------------------------------------------
-- Ramen toppings
---------------------------------------------------------------------------------------------------

local function noodleNest(m, y, r, color, thick, seed)
	local rnd = seq(seed or 3)
	Kit.blob(m, r * 1.6, 0.1, r * 1.3, -r * 0.1, y, r * 0.05, color, M.smooth, nc())
	for k = 0, 15 do
		local a = rnd() * math.pi * 2
		local cx, cz = (rnd() - 0.5) * r * 1.1, (rnd() - 0.5) * r * 0.9
		local cf = CFrame.new(cx, y + 0.04 + rnd() * 0.02, cz) * CFrame.Angles(0, a, math.rad((rnd() - 0.5) * 10))
		Kit.part(m, Vector3.new(0.3 + rnd() * 0.15, thick, thick), cf, lerp(color, P.white, rnd() * 0.15), M.smooth, nc({ shape = Enum.PartType.Cylinder, reflectance = 0.08 }))
	end
end

local function chashuSlice(m, x, y, z, d, yaw, tilt)
	local base = CFrame.new(x, y, z) * CFrame.Angles(math.rad(tilt or 8), math.rad(yaw or 0), 0)
	cylAt(m, d, 0.06, base, F.chashuEdge, M.smooth)
	cylAt(m, d - 0.05, 0.065, base * CFrame.new(0, 0.002, 0), F.chashuFat, M.smooth)
	cylAt(m, d - 0.16, 0.07, base * CFrame.new(0.02, 0.004, 0.01), F.chashuMeat, M.smooth, nc({ reflectance = 0.05 }))
	Kit.part(m, Vector3.new(d - 0.25, 0.072, 0.025), base * CFrame.new(0.02, 0.005, 0.03), F.chashuFat, M.smooth, nc())
end

-- Half marinated egg, cut side up
local function eggHalf(m, x, y, z, yaw)
	local base = CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(yaw or 0), 0)
	blobAt(m, 0.36, 0.14, 0.26, base, F.eggMarinated, M.smooth, nc())
	blobAt(m, 0.32, 0.14, 0.22, base * CFrame.new(0, 0.012, 0), F.eggWhite, M.smooth, nc())
	blobAt(m, 0.18, 0.13, 0.15, base * CFrame.new(0.01, 0.022, 0), F.yolk, M.smooth, nc({ reflectance = 0.15 }))
	blobAt(m, 0.09, 0.12, 0.08, base * CFrame.new(0.01, 0.03, 0), F.yolkCore, M.smooth, nc({ reflectance = 0.2 }))
end

local function narutoSlice(m, x, y, z, yaw)
	Kit.cyl(m, 0.32, 0.05, x, y, z, F.naruto, M.smooth, nc())
	for k, col in ipairs({ F.narutoPink, F.naruto, F.narutoPink }) do
		Kit.cyl(m, 0.24 - (k - 1) * 0.07, 0.052 + k * 0.002, x + k * 0.01, y, z, col, M.smooth, nc())
	end
	for k = 0, 7 do
		local a = k * math.pi / 4 + math.rad(yaw or 0)
		Kit.box(m, 0.05, 0.05, 0.05, x + math.cos(a) * 0.16, y, z + math.sin(a) * 0.16, F.naruto, M.smooth, nc({ rot = CFrame.Angles(0, -a, 0) }))
	end
end

local function scallions(m, x, y, z, n, seed)
	local rnd = seq(seed or 11)
	for _ = 1, n do
		local px, pz = x + (rnd() - 0.5) * 0.3, z + (rnd() - 0.5) * 0.3
		local col = rnd() < 0.3 and F.scallionLight or F.scallion
		Kit.cyl(m, 0.07, 0.022, px, y + rnd() * 0.02, pz, col, M.smooth, nc({ rot = CFrame.Angles(math.rad(rnd() * 30), 0, 0) }))
	end
end

local function menma(m, x, y, z)
	for k = 0, 3 do
		Kit.box(m, 0.3, 0.04, 0.06, x, y + k * 0.015, z + k * 0.065, lerp(F.menma, P.wood, (k % 2) * 0.2), M.smooth, nc({ rot = CFrame.Angles(0, math.rad(10 - k * 6), math.rad(4)) }))
	end
end

local function noriSheet(m, x, y, z, yaw)
	local base = CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(yaw or 0), 0) * CFrame.Angles(math.rad(-22), 0, 0)
	Kit.part(m, Vector3.new(0.36, 0.44, 0.02), base, F.nori, M.smooth, nc({ reflectance = 0.04 }))
	for k = 0, 2 do
		Kit.part(m, Vector3.new(0.36, 0.012, 0.022), base * CFrame.new(0, -0.13 + k * 0.13, 0), F.noriLight, M.smooth, nc())
	end
end

local function ramenToppings(m, recipe, y)
	local slots = {
		{ 0.3, 0.12 }, { -0.28, 0.18 }, { 0.05, -0.32 }, { -0.3, -0.18 }, { 0.32, -0.2 },
	}
	local i = 0
	local function nextSlot()
		i += 1
		local s = slots[(i - 1) % #slots + 1]
		return s[1], s[2]
	end
	for _, id in ipairs(recipe.ing) do
		if id == "chashu" then
			local x, z = nextSlot()
			chashuSlice(m, x, y + 0.04, z, 0.52, 20, 10)
			chashuSlice(m, x - 0.14, y + 0.08, z + 0.07, 0.5, -15, 14)
		elseif id == "egg" then
			local x, z = nextSlot()
			eggHalf(m, x, y + 0.05, z, 30)
			eggHalf(m, x + 0.08, y + 0.06, z - 0.16, -20)
		elseif id == "naruto" then
			local x, z = nextSlot()
			narutoSlice(m, x, y + 0.03, z, 0)
		elseif id == "corn" then
			local x, z = nextSlot()
			for k = 0, 11 do
				Kit.ball(m, 0.07, x + (k % 4) * 0.065 - 0.1, y + 0.035 + (k % 3) * 0.012, z + math.floor(k / 4) * 0.065 - 0.06, lerp(F.corn, P.white, (k % 3) * 0.08), M.smooth, nc({ reflectance = 0.1 }))
			end
		elseif id == "butter" then
			local x, z = nextSlot()
			Kit.blob(m, 0.24, 0.06, 0.22, x, y + 0.02, z, lerp(F.butter, P.white, 0.2), M.smooth, nc({ reflectance = 0.25, transparency = 0.2 }))
			Kit.box(m, 0.15, 0.1, 0.15, x, y + 0.07, z, F.butter, M.smooth, nc({ rot = CFrame.Angles(0, math.rad(20), math.rad(6)), reflectance = 0.1 }))
		elseif id == "kikurage" then
			local x, z = nextSlot()
			for k = 0, 3 do
				Kit.blob(m, 0.2, 0.04, 0.09, x + (k % 2) * 0.1, y + 0.03 + k * 0.008, z + math.floor(k / 2) * 0.1, F.kikurage, M.smooth, nc({ rot = CFrame.Angles(0, k * 0.9, math.rad(10)), reflectance = 0.15 }))
			end
		elseif id == "minced_pork" then
			local x, z = nextSlot()
			for k = 0, 9 do
				Kit.ball(m, 0.08 + (k % 3) * 0.02, x + (k % 4) * 0.07 - 0.1, y + 0.04, z + math.floor(k / 4) * 0.07 - 0.07, lerp(F.pork, P.black, (k % 2) * 0.2), M.sand, nc())
			end
		elseif id == "chili_oil" then
			for k = 0, 4 do
				Kit.cyl(m, 0.12 + k * 0.03, 0.012, -0.2 + k * 0.1, y + 0.012, 0.15 - k * 0.08, F.chili, M.smooth, nc({ reflectance = 0.35, transparency = 0.25 }))
			end
		elseif id == "black_garlic" then
			for k = 0, 3 do
				Kit.cyl(m, 0.18 + k * 0.04, 0.012, 0.15 - k * 0.12, y + 0.013, -0.05 + k * 0.06, P.black, M.smooth, nc({ reflectance = 0.35, transparency = 0.1 }))
			end
		elseif id == "matcha" then
			Kit.cyl(m, 0.3, 0.012, 0.1, y + 0.012, 0.1, F.matcha, M.sand, nc())
		end
	end
	if has(recipe, "scallion") or recipe.id == "tonkotsu_ramen" then
		scallions(m, -0.05, y + 0.04, 0.05, 12, #recipe.id)
	end
	if recipe.broth == "broth_shoyu" or recipe.id == "tonkotsu_ramen" or recipe.id == "hakata_ramen" then
		menma(m, 0.18, y + 0.03, 0.22)
	end
	if recipe.broth == "broth_tonkotsu" then
		for k = 0, 5 do
			Kit.box(m, 0.025, 0.012, 0.015, -0.2 + k * 0.08, y + 0.03, -0.05 + (k % 2) * 0.06, F.sesame, M.smooth, nc())
		end
	end
end

local function ramenBowl(m, recipe)
	local style = BOWLS[recipe.id] or BOWLS.shoyu_ramen
	local y = donburi(m, 1.4, 0.58, style[1], style[2], style[3])
	local broth = Color.hex(BROTH[recipe.broth] or "#C58A3E")
	liquid(m, 1.24, y, broth, recipe.broth == "broth_tonkotsu" and 3 or 7, #recipe.id)
	local thick = recipe.id == "okinawa_soba" and 0.075 or 0.055
	noodleNest(m, y + 0.01, 0.42, recipe.id == "okinawa_soba" and F.noodleThick or F.noodle, thick, #recipe.id)
	ramenToppings(m, recipe, y + 0.02)
	noriSheet(m, -0.28, y + 0.18, 0.42, 15)
	renge(m, 0.42, y + 0.06, 0.3, -40)
	chopsticks(m, 0.05, -0.92, 0)
	local steam = Kit.box(m, 0.6, 0.05, 0.6, 0, y + 0.25, 0, P.white, M.smooth, nc({ transparency = 1 }))
	Kit.particles(steam, "steam", { rate = 3 })
end

---------------------------------------------------------------------------------------------------
-- Dishes
---------------------------------------------------------------------------------------------------

local FISH_KIND = { salmon = "salmon", tuna = "tuna", otoro = "otoro", yellowtail = "hamachi", shrimp = "shrimp", eel = "eel" }

local function fishOf(recipe)
	for _, id in ipairs(recipe.ing) do
		if FISH_KIND[id] then
			return FISH_KIND[id]
		end
	end
	return "salmon"
end

local function dishNigiri(m, recipe)
	local y = geta(m, 1.5, 0.75)
	local kind = fishOf(recipe)
	nigiri(m, -0.42, 0, y, kind, 82)
	nigiri(m, -0.02, 0, y, kind, 98)
	baran(m, 0.26, -0.05, y, 90)
	wasabiAndGari(m, 0.42, 0.12, y)
end

local function dishMaki(m, recipe)
	local y = plateRect(m, 1.5, 0.85, F.porcelain, F.indigo)
	local filling = has(recipe, "cucumber") and "cucumber" or "tuna"
	for i = 0, 5 do
		hosomaki(m, -0.42 + (i % 3) * 0.38, -0.12 + math.floor(i / 3) * 0.32 + (i % 2) * 0.03, y, filling)
	end
	wasabiAndGari(m, 0.52, 0.28, y)
end

local function dishRoll(m, recipe)
	local y = plateRect(m, 1.7, 0.75, P.charcoal, P.black)
	local style = recipe.id == "dragon_roll" and "dragon" or "california"
	for i = 0, 5 do
		uramaki(m, -0.62 + i * 0.25, (i % 2) * 0.02, y, style)
	end
	if style == "dragon" then
		-- fanned avocado slices along the top and an eel-sauce zigzag
		for i = 0, 7 do
			Kit.blob(m, 0.24, 0.05, 0.4, -0.66 + i * 0.19, y + 0.31, 0, lerp(F.avocado, F.avocadoSkin, (i % 2) * 0.35), M.smooth, nc({ rot = CFrame.Angles(0, 0, math.rad(-12)), reflectance = 0.12 }))
		end
		for i = 0, 6 do
			Kit.box(m, 0.26, 0.02, 0.03, -0.6 + i * 0.2, y + 0.35, ((i % 2) * 2 - 1) * 0.08, F.sauce, M.smooth, nc({ rot = CFrame.Angles(0, math.rad(((i % 2) * 2 - 1) * 35), 0), reflectance = 0.3 }))
		end
	end
	wasabiAndGari(m, 0.62, 0.25, y)
end

local function dishTemaki(m, recipe)
	local y = plateRect(m, 1.3, 0.85, F.porcelain, P.wood_dark)
	-- cone of nori built from shrinking rings along a tilted axis
	local axis = CFrame.new(-0.1, y + 0.48, 0) * CFrame.Angles(0, 0, math.rad(-55))
	for i = 0, 5 do
		cylAt(m, 0.46 - i * 0.075, 0.12, axis * CFrame.new(0, -i * 0.1, 0), i % 2 == 0 and F.nori or F.noriLight, M.smooth)
	end
	local mouth = axis * CFrame.new(0, 0.1, 0)
	Kit.blob(m, 0.4, 0.18, 0.4, mouth.X, mouth.Y, mouth.Z, F.rice, M.sand, nc())
	for k = 0, 2 do
		local p = mouth * CFrame.new(-0.08 + k * 0.08, 0.1 + k * 0.03, 0.04 - k * 0.04)
		Kit.part(m, Vector3.new(0.08, 0.32, 0.14), p * CFrame.Angles(0, 0, math.rad(-20 + k * 15)), k == 1 and F.avocado or F.salmon, M.smooth, nc({ reflectance = 0.1 }))
	end
	local _ = recipe
	Kit.part(m, Vector3.new(0.04, 0.3, 0.04), mouth * CFrame.new(0.12, 0.15, 0.1), F.cucumber, M.smooth, nc())
	wasabiAndGari(m, 0.42, 0.25, y)
end

local function dishGunkan(m, recipe)
	local y = geta(m, 1.3, 0.75)
	for gi, x in ipairs({ -0.3, 0.3 }) do
		Kit.blob(m, 0.42, 0.18, 0.34, x, y + 0.1, 0, F.rice, M.sand, nc())
		Kit.cyl(m, 0.46, 0.26, x, y + 0.13, 0, F.nori, M.smooth, nc({ rot = CFrame.Angles(0, 0, 0) }))
		local rnd = seq(gi * 17)
		for _ = 1, 12 do
			local a, r = rnd() * math.pi * 2, rnd() * 0.15
			Kit.ball(m, 0.11, x + math.cos(a) * r, y + 0.3 + rnd() * 0.07, math.sin(a) * r, F.ikura, M.glass, nc({ transparency = 0.15, reflectance = 0.25 }))
		end
		Kit.cyl(m, 0.16, 0.02, x + 0.12, y + 0.34, 0.1, F.cucumber, M.smooth, nc({ rot = CFrame.Angles(math.rad(30), 0, 0) }))
	end
	local _ = recipe
	wasabiAndGari(m, 0.45, 0.26, y)
end

local function slices(m, x, z, y, col, fat, n, yaw)
	local base = CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(yaw or 0), 0)
	for k = 0, n - 1 do
		local p = base * CFrame.new(0, 0.1, -0.14 + k * 0.12) * CFrame.Angles(math.rad(-35), 0, 0)
		Kit.part(m, Vector3.new(0.42, 0.24, 0.07), p, col, M.smooth, nc({ reflectance = 0.1 }))
		if fat then
			for f = 0, 1 do
				Kit.part(m, Vector3.new(0.02, 0.24, 0.072), p * CFrame.new(-0.08 + f * 0.16, 0, 0.001) * CFrame.Angles(0, 0, math.rad(25)), fat, M.smooth, nc())
			end
		end
	end
end

local function dishSashimi(m, recipe)
	if #recipe.ing <= 2 then
		-- salmon sashimi: five slices fanned on daikon and shiso, wasabi and a lemon wedge
		local y0 = plateRound(m, 1.3, F.porcelain, F.indigo)
		Kit.blob(m, 0.55, 0.2, 0.45, 0, y0 + 0.07, 0.25, F.daikon, M.fabric, nc())
		Kit.blob(m, 0.42, 0.03, 0.28, -0.25, y0 + 0.04, 0.05, F.shiso, M.smooth, nc({ rot = CFrame.Angles(0, math.rad(25), math.rad(8)) }))
		slices(m, 0, -0.08, y0, F.salmon, F.salmonFat, 5, 0)
		Kit.blob(m, 0.14, 0.12, 0.12, 0.4, y0 + 0.06, 0.3, F.wasabi, M.sand, nc())
		Kit.cyl(m, 0.28, 0.04, 0.42, y0 + 0.05, 0.05, F.lemon, M.smooth, nc({ rot = CFrame.Angles(math.rad(70), 0, 0) }))
		return
	end
	local y = plateRound(m, 1.55, F.indigo, F.porcelain)
	-- shredded daikon mound and shiso leaves under the fish
	Kit.blob(m, 0.6, 0.22, 0.5, -0.05, y + 0.08, 0.28, F.daikon, M.fabric, nc())
	for k = 0, 5 do
		Kit.part(m, Vector3.new(0.3, 0.02, 0.02), CFrame.new(-0.05 + (k % 3) * 0.08 - 0.08, y + 0.18, 0.2 + math.floor(k / 3) * 0.12) * CFrame.Angles(0, k * 0.7, math.rad(15)), F.daikon, M.smooth, nc())
	end
	for k = 0, 1 do
		Kit.blob(m, 0.42, 0.03, 0.28, -0.35 + k * 0.6, y + 0.04, 0.05, F.shiso, M.smooth, nc({ rot = CFrame.Angles(0, math.rad(30 - k * 60), math.rad(8)) }))
	end
	slices(m, -0.42, -0.05, y, F.salmon, F.salmonFat, 3, 10)
	slices(m, 0.02, -0.15, y, F.tuna, nil, 3, 0)
	slices(m, 0.45, -0.05, y, F.hamachi, F.blood, 3, -10)
	Kit.blob(m, 0.14, 0.12, 0.12, 0.35, y + 0.06, 0.4, F.wasabi, M.sand, nc())
	Kit.cyl(m, 0.3, 0.04, 0.55, y + 0.05, 0.3, F.lemon, M.smooth, nc({ rot = CFrame.Angles(math.rad(70), 0, 0) }))
	local _ = recipe
end

local function dishPlatter(m, recipe)
	if recipe.id == "kaiseki" then
		-- black lacquer bento box with four compartments
		Kit.box(m, 1.6, 0.18, 1.15, 0, 0.09, 0, F.lacquerBlack, M.smooth, nc({ reflectance = 0.12 }))
		Kit.box(m, 1.5, 0.02, 1.05, 0, 0.17, 0, F.lacquerRed, M.smooth, nc())
		Kit.box(m, 0.04, 0.12, 1.05, 0, 0.22, 0, F.lacquerBlack, M.smooth, nc())
		Kit.box(m, 1.5, 0.12, 0.04, 0, 0.22, 0, F.lacquerBlack, M.smooth, nc())
		slices(m, -0.38, -0.25, 0.12, F.otoro, F.otoroFat, 3, 90)
		Kit.blob(m, 0.3, 0.1, 0.25, -0.38, 0.22, 0.27, F.daikon, M.fabric, nc())
		for k = 0, 8 do
			Kit.ball(m, 0.09, -0.42 + (k % 3) * 0.08, 0.3, 0.2 + math.floor(k / 3) * 0.08, F.ikura, M.glass, nc({ transparency = 0.15, reflectance = 0.25 }))
		end
		noodleNest(m, 0.22, 0.25, F.soba, 0.035, 5)
		for k, col in ipairs({ c("#F4B6C8"), F.porcelain, F.matcha }) do
			Kit.ball(m, 0.17, 0.22 + k * 0.13, 0.28, 0.28, col, M.smooth, nc())
		end
		Kit.cyl(m, 0.02, 0.6, 0.48, 0.28, 0.28, P.wood_light, M.wood, nc({ rot = CFrame.Angles(0, 0, math.rad(90)) }))
		return
	end
	local y = plateRect(m, 1.7, 1.05, F.lacquerBlack, F.lacquerRed)
	nigiri(m, -0.6, -0.2, y, "otoro", 85)
	nigiri(m, -0.25, -0.2, y, "hamachi", 95)
	nigiri(m, 0.1, -0.2, y, "shrimp", 88)
	nigiri(m, 0.45, -0.2, y, "salmon", 92)
	for i = 0, 2 do
		hosomaki(m, -0.5 + i * 0.36, 0.25, y, "tuna")
	end
	Kit.blob(m, 0.38, 0.16, 0.3, 0.55, y + 0.09, 0.25, F.rice, M.sand, nc())
	Kit.cyl(m, 0.42, 0.24, 0.55, y + 0.12, 0.25, F.nori, M.smooth, nc())
	for k = 0, 6 do
		Kit.ball(m, 0.1, 0.5 + (k % 3) * 0.06, y + 0.28, 0.2 + math.floor(k / 3) * 0.06, F.ikura, M.glass, nc({ transparency = 0.15, reflectance = 0.25 }))
	end
	baran(m, 0.18, 0.25, y, 90)
	wasabiAndGari(m, 0.62, -0.42, y)
end

local function dishTsukemen(m, recipe)
	-- thick glossy noodles folded on a plate, dipping broth in a small bowl
	local y = plateRound(m, 1.15, F.porcelain, F.indigo)
	for k = 0, 9 do
		Kit.part(m, Vector3.new(0.6, 0.07, 0.07), CFrame.new(-0.2, y + 0.05 + (k % 3) * 0.04, -0.25 + k * 0.05) * CFrame.Angles(0, math.rad(-8 + (k % 4) * 5), math.rad((k % 2) * 3)), lerp(F.noodleThick, P.white, (k % 3) * 0.06), M.smooth, nc({ shape = Enum.PartType.Cylinder, reflectance = 0.15 }))
	end
	noriSheet(m, -0.55, y + 0.15, 0.25, 30)
	Kit.cyl(m, 0.22, 0.04, -0.05, y + 0.16, -0.32, F.lemon, M.smooth, nc({ rot = CFrame.Angles(math.rad(60), 0, 0) }))
	-- dipping bowl
	local dip = Kit.model("Dip")
	dip.Parent = m
	local dy = donburi(dip, 0.6, 0.42, F.lacquerBlack, F.lacquerRed, P.gold)
	liquid(dip, 0.5, dy, c("#7A4A22"), 4, 9)
	chashuSlice(dip, 0.05, dy + 0.03, 0.02, 0.3, 10, 12)
	eggHalf(dip, -0.1, dy + 0.04, -0.08, 20)
	scallions(dip, 0.08, dy + 0.04, -0.12, 6, 4)
	for _, d in ipairs(dip:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CFrame = CFrame.new(0.5, 0, 0.2) * d.CFrame
		end
	end
	local _ = recipe
end

local function dishZaruSoba(m, recipe)
	-- square lacquer tray, bamboo mat, green soba, nori strips, tsuyu cup
	Kit.box(m, 1.15, 0.1, 1.0, -0.15, 0.05, 0, F.lacquerBlack, M.smooth, nc({ reflectance = 0.1 }))
	for k = 0, 8 do
		Kit.cylH(m, 0.04, 0.95, -0.15, 0.12, -0.4 + k * 0.1, P.bamboo, M.wood, nc())
	end
	noodleNest(m, 0.18, 0.38, F.soba, 0.035, 21)
	for k = 0, 5 do
		Kit.box(m, 0.03, 0.01, 0.16, -0.25 + k * 0.05, 0.27, -0.05 + (k % 2) * 0.06, F.nori, M.smooth, nc({ rot = CFrame.Angles(0, math.rad(k * 25), 0) }))
	end
	Kit.cyl(m, 0.34, 0.3, 0.62, 0.15, -0.15, F.porcelain, M.smooth, nc())
	Kit.cyl(m, 0.36, 0.03, 0.62, 0.28, -0.15, F.indigo, M.smooth, nc())
	Kit.cyl(m, 0.28, 0.01, 0.62, 0.3, -0.15, c("#5A3418"), M.smooth, nc({ reflectance = 0.2 }))
	Kit.cyl(m, 0.3, 0.04, 0.62, 0.02, 0.32, F.porcelain, M.smooth, nc())
	scallions(m, 0.62, 0.06, 0.3, 6, 5)
	Kit.blob(m, 0.1, 0.08, 0.08, 0.7, 0.07, 0.36, F.wasabi, M.sand, nc())
	if has(recipe, "matcha") then
		Kit.cyl(m, 0.12, 0.01, 0.62, 0.31, -0.18, F.matcha, M.sand, nc())
	end
end

local function dishSoup(m, recipe)
	if recipe.id == "yudofu" then
		-- clay pot with kombu, clear dashi and tofu blocks
		local base = c("#A0785A")
		Kit.cyl(m, 0.9, 0.08, 0, 0.04, 0, lerp(base, P.black, 0.3), M.slate, nc())
		Kit.cyl(m, 1.15, 0.36, 0, 0.26, 0, base, M.slate, nc())
		Kit.cyl(m, 1.2, 0.05, 0, 0.45, 0, lerp(base, P.black, 0.45), M.slate, nc())
		for _, s in ipairs({ -1, 1 }) do
			Kit.box(m, 0.16, 0.08, 0.22, s * 0.64, 0.38, 0, base, M.slate, nc())
		end
		Kit.cyl(m, 1.04, 0.02, 0, 0.45, 0, c("#E6E2C8"), M.smooth, nc({ reflectance = 0.2, transparency = 0.15 }))
		Kit.box(m, 0.7, 0.01, 0.4, 0, 0.42, 0.1, F.wakame, M.smooth, nc())
		for k = 0, 3 do
			Kit.box(m, 0.26, 0.16, 0.26, -0.22 + (k % 2) * 0.36, 0.48, -0.15 + math.floor(k / 2) * 0.32, F.tofu, M.smooth, nc({ rot = CFrame.Angles(0, math.rad(k * 12), 0) }))
		end
		scallions(m, 0.05, 0.56, 0.02, 6, 2)
		chopsticks(m, 0, -0.75, 0)
		return
	end
	-- miso soup in a red and black lacquer owan
	Kit.cyl(m, 0.42, 0.1, 0, 0.05, 0, F.lacquerBlack, M.smooth, nc())
	for i = 1, 4 do
		local d = 0.55 + (0.95 - 0.55) * math.sin(i / 4 * math.pi / 2)
		Kit.cyl(m, d, 0.1, 0, 0.1 + (i - 0.5) * 0.09, 0, F.lacquerBlack, M.smooth, nc({ reflectance = 0.12 }))
	end
	Kit.cyl(m, 0.97, 0.03, 0, 0.47, 0, F.lacquerRed, M.smooth, nc())
	local broth = Color.hex(BROTH[recipe.broth or "broth_miso"] or "#C58A3E")
	liquid(m, 0.86, 0.48, broth, 0, 1)
	Kit.blob(m, 0.5, 0.012, 0.42, 0.05, 0.495, -0.02, lerp(broth, P.white, 0.2), M.smooth, nc({ transparency = 0.4 }))
	for k = 0, 5 do
		Kit.box(m, 0.09, 0.07, 0.09, -0.2 + (k % 3) * 0.17, 0.5, -0.12 + math.floor(k / 3) * 0.2, F.tofu, M.smooth, nc({ rot = CFrame.Angles(0, k, 0) }))
	end
	for k = 0, 2 do
		Kit.blob(m, 0.2, 0.02, 0.1, 0.18 - k * 0.15, 0.5, 0.18 - k * 0.12, F.wakame, M.smooth, nc({ rot = CFrame.Angles(0, k * 1.2, 0) }))
	end
	scallions(m, 0, 0.51, 0, 7, 3)
end

local function dishEdamame(m, recipe)
	local y = plateRound(m, 1.0, c("#E8E0D0"), c("#8A6A4A"))
	local rnd = seq(13)
	for k = 0, 9 do
		local a = rnd() * math.pi * 2
		local r = rnd() * 0.28
		local base = CFrame.new(math.cos(a) * r, y + 0.05 + (k % 3) * 0.04, math.sin(a) * r) * CFrame.Angles(math.rad((rnd() - 0.5) * 30), rnd() * 6, 0)
		local pod = lerp(c("#6FAE3E"), c("#9ACB5E"), rnd() * 0.5)
		blobAt(m, 0.4, 0.08, 0.13, base, pod, M.smooth, nc({ reflectance = 0.06 }))
		for b = -1, 1 do
			blobAt(m, 0.12, 0.1, 0.11, base * CFrame.new(b * 0.1, 0.012, 0), lerp(pod, P.white, 0.1), M.smooth, nc())
		end
	end
	for k = 0, 5 do
		Kit.box(m, 0.02, 0.02, 0.02, -0.2 + k * 0.08, y + 0.17, (k % 2) * 0.1, P.white, M.smooth, nc())
	end
	local _ = recipe
end

local function dishCup(m, recipe)
	Kit.cyl(m, 0.7, 0.04, 0, 0.02, 0, P.wood_dark, M.wood, nc())
	if recipe.id == "matcha_latte" then
		Kit.cyl(m, 0.5, 0.5, 0, 0.29, 0, F.porcelain, M.smooth, nc({ reflectance = 0.06 }))
		Kit.cylH(m, 0.24, 0.06, 0.3, 0.3, 0, F.porcelain, M.smooth, nc(), "z")
		Kit.cyl(m, 0.44, 0.01, 0, 0.54, 0, F.matchaFoam, M.smooth, nc())
		-- latte-art heart
		Kit.ball(m, 0.12, -0.04, 0.54, -0.03, F.porcelain, M.smooth, nc())
		Kit.ball(m, 0.12, 0.04, 0.54, -0.03, F.porcelain, M.smooth, nc())
		Kit.wedge(m, 0.16, 0.012, 0.12, CFrame.new(0, 0.546, 0.06) * CFrame.Angles(0, math.rad(180), 0), F.porcelain, M.smooth, nc())
	else
		-- tall stoneware yunomi with a dripping glaze
		Kit.cyl(m, 0.42, 0.6, 0, 0.34, 0, c("#7A6A52"), M.slate, nc())
		Kit.cyl(m, 0.43, 0.25, 0, 0.5, 0, c("#5E7A4A"), M.smooth, nc({ reflectance = 0.1 }))
		Kit.cyl(m, 0.36, 0.01, 0, 0.64, 0, F.tea, M.smooth, nc({ reflectance = 0.2 }))
	end
	local steam = Kit.box(m, 0.3, 0.05, 0.3, 0, 0.75, 0, P.white, M.smooth, nc({ transparency = 1 }))
	Kit.particles(steam, "steam", { rate = 2 })
end

-- Codd-neck ramune bottle: body, shoulder, pinched neck with the glass marble, blue cap, label
local function dishRamune(m, s)
	s = s or 1
	local glass = c("#8FD3EA")
	local function gl()
		return nc({ transparency = 0.35, reflectance = 0.2 })
	end
	Kit.cyl(m, 0.42 * s, 0.62 * s, 0, 0.32 * s, 0, glass, M.glass, gl())
	Kit.cyl(m, 0.36 * s, 0.1 * s, 0, 0.68 * s, 0, glass, M.glass, gl())
	Kit.cyl(m, 0.24 * s, 0.12 * s, 0, 0.78 * s, 0, glass, M.glass, gl())
	Kit.cyl(m, 0.18 * s, 0.08 * s, 0, 0.87 * s, 0, glass, M.glass, gl())
	Kit.cyl(m, 0.22 * s, 0.16 * s, 0, 0.99 * s, 0, glass, M.glass, gl())
	Kit.ball(m, 0.15 * s, 0, 0.84 * s, 0, c("#DDF2F8"), M.glass, nc({ transparency = 0.1, reflectance = 0.4 }))
	Kit.cyl(m, 0.24 * s, 0.07 * s, 0, 1.1 * s, 0, P.neon_blue, M.smooth, nc())
	Kit.cyl(m, 0.43 * s, 0.22 * s, 0, 0.32 * s, 0, P.white, M.smooth, nc({ transparency = 0.15 }))
	Kit.cyl(m, 0.432 * s, 0.05 * s, 0, 0.32 * s, 0, F.indigo, M.smooth, nc())
	Kit.cyl(m, 0.38 * s, 0.4 * s, 0, 0.26 * s, 0, c("#BFE8F4"), M.glass, nc({ transparency = 0.5 }))
end

local function gyozaPiece(m, base, crispy)
	Kit.part(m, Vector3.new(0.42, 0.06, 0.2), base * CFrame.new(0, 0.03, 0), crispy and F.golden or lerp(F.golden, F.batter, 0.5), M.sand, nc())
	blobAt(m, 0.44, 0.18, 0.22, base * CFrame.new(0, 0.11, 0), c("#F1E2C2"), M.smooth, nc({ reflectance = 0.04 }))
	for k = -1, 1 do
		Kit.part(m, Vector3.new(0.04, 0.06, 0.06), base * CFrame.new(k * 0.1, 0.19, 0) * CFrame.Angles(0, 0, math.rad(k * 15)), c("#E9D7B2"), M.smooth, nc())
	end
end

local function dishGyoza(m, recipe)
	local y = plateRect(m, 1.5, 0.8, F.porcelain, F.indigo)
	-- crispy lace wing (hane) joining the dumplings
	Kit.blob(m, 1.15, 0.02, 0.45, -0.1, y + 0.01, 0, F.golden, M.sand, nc({ transparency = 0.15 }))
	for k = 0, 5 do
		local base = CFrame.new(-0.5 + k * 0.17, y, (k % 2) * 0.02) * CFrame.Angles(0, math.rad(80), math.rad(-12))
		gyozaPiece(m, base, true)
	end
	soyDish(m, 0.55, 0.22, has(recipe, "chili_oil") or recipe.id == "yatai_gyoza")
	if has(recipe, "chili_oil") then
		for k = 0, 4 do
			Kit.cyl(m, 0.05, 0.012, -0.4 + k * 0.17, y + 0.23, 0, F.chili, M.smooth, nc({ reflectance = 0.3 }))
		end
	end
end

local function shrimpTempura(m, base)
	for k = 0, 4 do
		local s = 0.24 - k * 0.025
		blobAt(m, s, s * 0.9, s, base * CFrame.new(-0.3 + k * 0.13, 0.12 + math.sin(k * 0.8) * 0.02, 0) * CFrame.Angles(k, k * 2, 0), lerp(F.batter, F.golden, (k % 2) * 0.4), M.sand, nc())
	end
	for _, s in ipairs({ -1, 1 }) do
		Kit.wedge(m, 0.03, 0.2, 0.14, base * CFrame.new(0.38, 0.14, s * 0.05) * CFrame.Angles(0, math.rad(90), math.rad(-50)), F.shrimpRed, M.smooth, nc())
	end
end

local function cabbage(m, x, z, y)
	Kit.blob(m, 0.5, 0.16, 0.4, x, y + 0.06, z, F.cabbage, M.fabric, nc())
	for k = 0, 4 do
		Kit.part(m, Vector3.new(0.3, 0.015, 0.02), CFrame.new(x - 0.08 + k * 0.04, y + 0.14, z - 0.05 + (k % 2) * 0.08) * CFrame.Angles(0, k * 0.8, math.rad(10)), lerp(F.cabbage, P.white, 0.3), M.smooth, nc())
	end
end

local function lemonWedge(m, x, z, y)
	Kit.wedge(m, 0.08, 0.12, 0.26, CFrame.new(x, y + 0.06, z) * CFrame.Angles(0, math.rad(30), 0), F.lemon, M.smooth, nc())
	Kit.box(m, 0.02, 0.12, 0.26, x - 0.04, y + 0.06, z, c("#F7EDA0"), M.smooth, nc({ rot = CFrame.Angles(0, math.rad(30), 0) }))
end

local function dishFried(m, recipe)
	if recipe.id == "ebi_tempura" then
		-- bamboo basket with kaishi paper, three shrimp and a dipping cup
		Kit.cyl(m, 1.2, 0.1, -0.1, 0.05, 0, P.bamboo, M.wood, nc())
		Kit.cyl(m, 1.24, 0.06, -0.1, 0.12, 0, lerp(P.bamboo, P.wood, 0.3), M.wood, nc())
		Kit.box(m, 0.8, 0.01, 0.8, -0.1, 0.12, 0, P.paper, M.fabric, nc({ rot = CFrame.Angles(0, math.rad(45), 0) }))
		for k = 0, 2 do
			shrimpTempura(m, CFrame.new(-0.12, 0.12 + k * 0.05, -0.2 + k * 0.2) * CFrame.Angles(0, math.rad(15 - k * 15), 0))
		end
		Kit.cyl(m, 0.34, 0.2, 0.6, 0.1, 0.3, F.porcelain, M.smooth, nc())
		Kit.cyl(m, 0.28, 0.01, 0.6, 0.2, 0.3, c("#8A5A2E"), M.smooth, nc({ reflectance = 0.2 }))
		Kit.blob(m, 0.12, 0.06, 0.1, 0.6, 0.22, 0.3, F.daikon, M.sand, nc())
		lemonWedge(m, 0.3, -0.35, 0.12)
		return
	end
	local y = plateRound(m, 1.2, F.porcelain, c("#C8B898"))
	cabbage(m, 0.3, 0.15, y)
	if recipe.id == "kushikatsu" then
		for k = 0, 2 do
			local base = CFrame.new(-0.1, y + 0.08, -0.25 + k * 0.22) * CFrame.Angles(0, math.rad(-5 + k * 5), 0)
			Kit.part(m, Vector3.new(1.0, 0.025, 0.025), base, P.wood_light, M.wood, nc())
			for p = 0, 2 do
				Kit.part(m, Vector3.new(0.18, 0.14, 0.16), base * CFrame.new(-0.2 + p * 0.2, 0.02, 0) * CFrame.Angles(p, 0, 0.2 * p), lerp(F.batter, F.golden, 0.6), M.sand, nc())
			end
		end
		Kit.cyl(m, 0.3, 0.18, 0.45, y + 0.09, -0.3, P.charcoal, M.smooth, nc())
		Kit.cyl(m, 0.25, 0.01, 0.45, y + 0.18, -0.3, F.okoSauce, M.smooth, nc({ reflectance = 0.2 }))
		for k = 0, 3 do
			Kit.box(m, 0.02, 0.01, 0.02, -0.2 + k * 0.1, y + 0.18, -0.25 + (k % 2) * 0.2, F.sesame, M.smooth, nc())
		end
	else
		-- karaage: craggy golden nuggets
		local rnd = seq(29)
		for k = 0, 5 do
			local x, z = -0.35 + (k % 3) * 0.2, -0.2 + math.floor(k / 3) * 0.25
			for b = 0, 2 do
				local k2 = 0.8 + rnd() * 0.4
				blobAt(m, 0.17 * k2, 0.14 * k2, 0.16 * k2, CFrame.new(x + (rnd() - 0.5) * 0.08, y + 0.08 + b * 0.03, z + (rnd() - 0.5) * 0.08) * CFrame.Angles(rnd() * 3, rnd() * 3, rnd() * 3), lerp(F.karaage, F.golden, rnd() * 0.6), M.sand, nc())
			end
		end
		Kit.blob(m, 0.16, 0.08, 0.14, 0.3, y + 0.15, -0.25, F.mayo, M.smooth, nc({ reflectance = 0.1 }))
	end
	lemonWedge(m, 0.4, -0.05, y)
end

local function dishTakoyaki(m, recipe)
	-- wooden boat tray
	Kit.box(m, 1.3, 0.04, 0.72, 0, 0.02, 0, P.wood_light, M.wood, nc())
	for _, s in ipairs({ -1, 1 }) do
		Kit.box(m, 1.3, 0.12, 0.03, 0, 0.07, s * 0.36, P.wood_light, M.wood, nc())
		Kit.box(m, 0.03, 0.12, 0.72, s * 0.65, 0.07, 0, P.wood_light, M.wood, nc())
	end
	for k = 0, 5 do
		local x, z = -0.38 + (k % 3) * 0.38, -0.16 + math.floor(k / 3) * 0.32
		Kit.ball(m, 0.34, x, 0.2, z, F.takoyaki, M.sand, nc())
		Kit.blob(m, 0.3, 0.1, 0.3, x, 0.33, z, F.okoSauce, M.smooth, nc({ reflectance = 0.25 }))
		for l = 0, 1 do
			Kit.box(m, 0.3, 0.02, 0.025, x, 0.385, z - 0.05 + l * 0.1, F.mayo, M.smooth, nc({ rot = CFrame.Angles(0, math.rad(l == 0 and 25 or -25), 0) }))
		end
		Kit.box(m, 0.03, 0.02, 0.03, x - 0.06, 0.39, z + 0.04, F.aonori, M.smooth, nc())
		Kit.box(m, 0.03, 0.02, 0.03, x + 0.07, 0.39, z - 0.03, F.aonori, M.smooth, nc())
		Kit.box(m, 0.1, 0.005, 0.07, x + 0.02, 0.4, z + 0.02, F.bonito, M.smooth, nc({ rot = CFrame.Angles(math.rad(20), k, 0) }))
	end
	for k = 0, 1 do
		Kit.part(m, Vector3.new(0.02, 0.5, 0.02), CFrame.new(0.38 - k * 0.06, 0.45, -0.16) * CFrame.Angles(math.rad(25), 0, math.rad(-20 + k * 8)), P.wood_light, M.wood, nc())
	end
	local _ = recipe
end

local function dishMochi(m, recipe)
	-- hanami dango on skewers and a bowl of whisked matcha
	local y = plateRect(m, 1.1, 0.65, c("#E8E0D0"), c("#8A6A4A"))
	for s = 0, 1 do
		local z = -0.12 + s * 0.24
		Kit.part(m, Vector3.new(0.9, 0.025, 0.025), CFrame.new(-0.05, y + 0.12, z), P.wood_light, M.wood, nc())
		for k, col in ipairs({ c("#F4B6C8"), F.porcelain, F.matcha }) do
			Kit.ball(m, 0.22, -0.3 + k * 0.17, y + 0.12, z, col, M.smooth, nc({ reflectance = 0.05 }))
		end
	end
	Kit.cyl(m, 0.42, 0.24, 0.62, 0.12, 0.28, c("#3A3A32"), M.slate, nc())
	Kit.cyl(m, 0.36, 0.01, 0.62, 0.245, 0.28, F.matchaFoam, M.sand, nc())
	local _ = recipe
end

local function dishGriddle(m, recipe)
	if recipe.id == "jingisukan" then
		-- cast-iron dome grill with lamb slices and vegetables around the rim
		Kit.cyl(m, 1.4, 0.06, 0, 0.03, 0, P.wood_dark, M.wood, nc())
		Kit.cyl(m, 1.3, 0.08, 0, 0.1, 0, P.charcoal, M.metal, nc())
		Kit.blob(m, 0.95, 0.42, 0.95, 0, 0.14, 0, P.charcoal, M.metal, nc())
		for k = 0, 5 do
			local a = k * math.pi / 3
			Kit.box(m, 0.02, 0.03, 0.4, math.cos(a) * 0.25, 0.3, math.sin(a) * 0.25, P.black, M.metal, nc({ rot = CFrame.Angles(0, math.pi / 2 - a, math.rad(25)) }))
		end
		for k = 0, 3 do
			Kit.blob(m, 0.32, 0.04, 0.22, -0.12 + (k % 2) * 0.24, 0.33 + math.floor(k / 2) * 0.03, -0.1 + math.floor(k / 2) * 0.2, lerp(F.lamb, c("#5A2E22"), (k % 2) * 0.3), M.smooth, nc({ rot = CFrame.Angles(math.rad(14), k, 0), reflectance = 0.1 }))
		end
		for k = 0, 7 do
			local a = k * math.pi / 4
			local col = ({ F.pumpkin, F.cabbage, c("#F3EEDC"), F.scallion })[k % 4 + 1]
			Kit.blob(m, 0.2, 0.06, 0.12, math.cos(a) * 0.55, 0.17, math.sin(a) * 0.55, col, M.smooth, nc({ rot = CFrame.Angles(0, -a, 0) }))
		end
		return
	end
	local y = plateRound(m, 1.3, F.porcelain, F.indigo)
	if recipe.id == "goya_champuru" then
		local rnd = seq(41)
		Kit.blob(m, 0.85, 0.08, 0.7, 0, y + 0.03, 0, lerp(F.scrambled, P.white, 0.3), M.smooth, nc())
		for k = 0, 23 do
			local x, z = (rnd() - 0.5) * 0.75, (rnd() - 0.5) * 0.6
			local kind = k % 4
			if kind == 0 then
				Kit.part(m, Vector3.new(0.16, 0.05, 0.12), CFrame.new(x, y + 0.06, z) * CFrame.Angles(0, rnd() * 6, 0), F.goya, M.sand, nc())
			elseif kind == 1 then
				Kit.box(m, 0.14, 0.1, 0.14, x, y + 0.07, z, lerp(F.tofu, F.golden, 0.25), M.smooth, nc({ rot = CFrame.Angles(0, rnd() * 3, 0) }))
			elseif kind == 2 then
				Kit.blob(m, 0.18, 0.07, 0.14, x, y + 0.07, z, F.scrambled, M.smooth, nc())
			else
				Kit.blob(m, 0.2, 0.04, 0.12, x, y + 0.08, z, F.chashuMeat, M.smooth, nc({ rot = CFrame.Angles(0, rnd() * 3, 0) }))
			end
		end
		for k = 0, 4 do
			Kit.box(m, 0.09, 0.005, 0.06, -0.1 + k * 0.06, y + 0.15, (k % 2) * 0.06, F.bonito, M.smooth, nc({ rot = CFrame.Angles(math.rad(20), k, 0) }))
		end
		return
	end
	-- okonomiyaki: thick pancake, glossy sauce, mayo lattice, aonori, bonito and red ginger
	Kit.cyl(m, 1.0, 0.16, 0, y + 0.08, 0, lerp(F.takoyaki, P.black, 0.25), M.sand, nc())
	Kit.cyl(m, 0.96, 0.17, 0, y + 0.09, 0, F.takoyaki, M.sand, nc())
	Kit.cyl(m, 0.9, 0.02, 0, y + 0.18, 0, F.okoSauce, M.smooth, nc({ reflectance = 0.25 }))
	for k = -2, 2 do
		Kit.box(m, 0.85 - math.abs(k) * 0.15, 0.015, 0.025, k * 0.06, y + 0.195, k * 0.12, F.mayo, M.smooth, nc({ rot = CFrame.Angles(0, math.rad(35), 0) }))
		Kit.box(m, 0.85 - math.abs(k) * 0.15, 0.015, 0.025, -k * 0.06, y + 0.197, k * 0.12, F.mayo, M.smooth, nc({ rot = CFrame.Angles(0, math.rad(-35), 0) }))
	end
	for k = 0, 7 do
		Kit.box(m, 0.03, 0.01, 0.03, -0.3 + (k % 4) * 0.2, y + 0.2, -0.2 + math.floor(k / 4) * 0.35, F.aonori, M.smooth, nc())
	end
	for k = 0, 5 do
		Kit.box(m, 0.12, 0.005, 0.08, -0.15 + (k % 3) * 0.12, y + 0.21, -0.05 + math.floor(k / 3) * 0.1, F.bonito, M.smooth, nc({ rot = CFrame.Angles(math.rad(25), k * 1.1, 0) }))
	end
	for k = 0, 3 do
		Kit.box(m, 0.12, 0.02, 0.02, 0.25 + (k % 2) * 0.04, y + 0.21, 0.25 + k * 0.03, F.beniShoga, M.smooth, nc({ rot = CFrame.Angles(0, k * 0.6, 0) }))
	end
end

local function dish(recipeId, gold)
	local recipe = Recipes.byId[recipeId]
	local m = Kit.model("Dish")
	if gold then
		Kit.cyl(m, 1.75, 0.04, 0, 0.01, 0, P.gold, M.foil, nc())
		local shine = Kit.box(m, 0.3, 0.05, 0.3, 0, 0.6, 0, P.gold, M.smooth, nc({ transparency = 1 }))
		Kit.particles(shine, "sparkle", { rate = 2, color = "#FFE08A", glow = 0.6 })
	end
	if not recipe then
		plateRound(m, 1.2)
		Kit.finish(m, Vector3.new(1.6, 1, 1.2))
		return m
	end
	local kind = recipe.dish
	if kind == "nigiri" then
		dishNigiri(m, recipe)
	elseif kind == "maki" then
		dishMaki(m, recipe)
	elseif kind == "roll" then
		dishRoll(m, recipe)
	elseif kind == "temaki" then
		dishTemaki(m, recipe)
	elseif kind == "gunkan" then
		dishGunkan(m, recipe)
	elseif kind == "sashimi" then
		dishSashimi(m, recipe)
	elseif kind == "platter" then
		dishPlatter(m, recipe)
	elseif kind == "bowl" then
		if recipe.id == "matcha_soba" then
			dishZaruSoba(m, recipe)
		else
			ramenBowl(m, recipe)
		end
	elseif kind == "tsukemen" then
		dishTsukemen(m, recipe)
	elseif kind == "soup" then
		dishSoup(m, recipe)
	elseif kind == "edamame" then
		dishEdamame(m, recipe)
	elseif kind == "cup" then
		dishCup(m, recipe)
	elseif kind == "bottle" then
		dishRamune(m)
	elseif kind == "gyoza" then
		dishGyoza(m, recipe)
	elseif kind == "fried" then
		dishFried(m, recipe)
	elseif kind == "takoyaki" then
		dishTakoyaki(m, recipe)
	elseif kind == "mochi" then
		dishMochi(m, recipe)
	elseif kind == "okonomiyaki" then
		dishGriddle(m, recipe)
	else
		plateRound(m, 1.2)
	end
	Kit.finish(m, Vector3.new(1.6, 1, 1.2))
	m:SetAttribute("Recipe", recipeId)
	return m
end

---------------------------------------------------------------------------------------------------
-- Ingredients (what you carry from the shelves and put on the board)
---------------------------------------------------------------------------------------------------

-- Fish block (saku) or fillet with fat lines / skin
local function ingFish(m, id, col)
	if id == "shrimp" then
		-- two raw shrimp, curled, with segments and tail
		for s = 0, 1 do
			local base = CFrame.new(-0.14 + s * 0.28, 0.12, -0.06 + s * 0.12) * CFrame.Angles(0, math.rad(s * 160), 0)
			for k = 0, 5 do
				local a = k * 0.42
				blobAt(m, 0.17, 0.17 - k * 0.014, 0.19 - k * 0.014, base * CFrame.new(math.cos(a) * 0.22, 0, math.sin(a) * 0.22) * CFrame.Angles(0, -a, 0), lerp(c("#F2A08A"), c("#E86A4A"), (k % 2) * 0.4), M.smooth, nc({ reflectance = 0.1 }))
			end
			Kit.wedge(m, 0.04, 0.2, 0.18, base * CFrame.new(-0.04, 0.02, 0.27) * CFrame.Angles(0, 0, math.rad(90)), F.shrimpRed, M.smooth, nc())
		end
		return
	elseif id == "octopus" then
		-- boiled tentacle with suckers
		for k = 0, 5 do
			local a = k * 0.5
			local s = 0.2 - k * 0.022
			local p = CFrame.new(math.cos(a) * 0.22 - 0.05, s / 2, math.sin(a) * 0.22)
			Kit.ball(m, s, p.X, p.Y, p.Z, lerp(c("#B8344A"), c("#8A2A3A"), k * 0.1), M.smooth, nc({ reflectance = 0.12 }))
			Kit.ball(m, s * 0.45, p.X - 0.03, p.Y - s * 0.25, p.Z + 0.05, c("#F2D8D8"), M.smooth, nc())
		end
		return
	elseif id == "eel" then
		-- grilled kabayaki fillet with char lines and glaze
		Kit.box(m, 0.75, 0.08, 0.32, 0, 0.06, 0, F.eel, M.smooth, nc({ reflectance = 0.25 }))
		for k = 0, 3 do
			Kit.box(m, 0.03, 0.085, 0.3, -0.27 + k * 0.18, 0.063, 0, lerp(F.eel, P.black, 0.5), M.smooth, nc())
		end
		Kit.box(m, 0.75, 0.02, 0.3, 0, 0.11, 0, F.sauce, M.smooth, nc({ reflectance = 0.35, transparency = 0.2 }))
		return
	end
	-- saku block: tuna/otoro/yellowtail/salmon
	local fat = ({ salmon = F.salmonFat, otoro = F.otoroFat, tuna = F.tunaLight, yellowtail = F.blood })[id]
	-- the block sits on a sheet of butcher paper
	Kit.box(m, 0.8, 0.01, 0.42, 0, 0.005, 0, P.paper, M.smooth, nc())
	Kit.box(m, 0.75, 0.2, 0.34, 0, 0.11, 0, col, M.smooth, nc({ reflectance = 0.12 }))
	if id == "salmon" then
		Kit.box(m, 0.75, 0.05, 0.345, 0, 0.035, 0, c("#C8CED2"), M.metal, nc({ reflectance = 0.2 }))
	end
	if id == "yellowtail" then
		Kit.box(m, 0.76, 0.012, 0.06, 0, 0.215, 0.1, F.blood, M.smooth, nc())
		Kit.box(m, 0.76, 0.2, 0.012, 0, 0.11, -0.172, lerp(col, F.blood, 0.3), M.smooth, nc())
	elseif fat then
		for k = 0, 3 do
			local x = -0.27 + k * 0.18
			Kit.box(m, 0.03, 0.012, 0.36, x, 0.215, 0, fat, M.smooth, nc({ rot = CFrame.Angles(0, math.rad(25), 0) }))
			Kit.box(m, 0.03, 0.2, 0.012, x + 0.04, 0.11, -0.172, fat, M.smooth, nc({ rot = CFrame.Angles(0, 0, math.rad(15)) }))
		end
	end
end

local function ingredient(id)
	local ing = Ingredients.byId[id]
	local m = Kit.model("Ing")
	local col = ing and Color.hex(ing.color) or P.white
	local shape = ing and ing.shape or "pack"
	if shape == "fillet" then
		ingFish(m, id, col)
	elseif id == "cucumber" then
		-- two Japanese cucumbers: bumpy dark skin, pale cut ends
		for s = 0, 1 do
			local z = -0.08 + s * 0.16
			Kit.cylH(m, 0.17, 0.72, 0, 0.09, z, F.cucumber, M.sand, nc({ rot = CFrame.Angles(0, math.rad(s * 8), 0) }))
			Kit.cylH(m, 0.13, 0.725, 0, 0.09, z, F.cucumberIn, M.smooth, nc({ rot = CFrame.Angles(0, math.rad(s * 8), 0) }))
		end
	elseif id == "avocado" then
		-- pear shape with a halved one showing the stone
		Kit.blob(m, 0.32, 0.42, 0.3, -0.18, 0.21, 0, c("#3E4A22"), M.sand, nc())
		Kit.blob(m, 0.24, 0.24, 0.22, -0.18, 0.38, 0, c("#3E4A22"), M.sand, nc())
		Kit.blob(m, 0.3, 0.12, 0.38, 0.18, 0.06, 0, c("#3E4A22"), M.sand, nc())
		Kit.blob(m, 0.27, 0.1, 0.34, 0.18, 0.1, 0, F.avocado, M.smooth, nc())
		Kit.blob(m, 0.14, 0.1, 0.14, 0.18, 0.13, 0.04, c("#8A5A2A"), M.smooth, nc({ reflectance = 0.2 }))
	elseif id == "daikon" then
		Kit.cylH(m, 0.26, 0.6, 0, 0.13, 0, F.daikon, M.smooth, nc())
		Kit.cylH(m, 0.16, 0.2, -0.38, 0.13, 0, F.daikon, M.smooth, nc())
		for k = 0, 3 do
			Kit.part(m, Vector3.new(0.35, 0.04, 0.1), CFrame.new(0.42, 0.18 + k * 0.03, -0.06 + k * 0.04) * CFrame.Angles(0, math.rad(-15 + k * 10), math.rad(20)), c("#5E9A3A"), M.smooth, nc())
		end
	elseif shape == "veg" then
		Kit.cylH(m, 0.2, 0.75, 0, 0.12, 0, col, M.smooth, nc())
	elseif shape == "sack" then
		-- paper sack, folded top, printed label
		Kit.blob(m, 0.6, 0.62, 0.42, 0, 0.3, 0, P.paper_warm, M.fabric, nc())
		Kit.box(m, 0.5, 0.12, 0.3, 0, 0.6, 0, P.paper_warm, M.fabric, nc())
		Kit.box(m, 0.52, 0.04, 0.31, 0, 0.66, 0, lerp(P.paper_warm, P.wood, 0.25), M.fabric, nc())
		Kit.box(m, 0.34, 0.22, 0.02, 0, 0.32, -0.21, id == "rice" and F.lacquerRed or F.indigo, M.smooth, nc())
		Kit.box(m, 0.2, 0.1, 0.022, 0, 0.32, -0.212, P.white, M.smooth, nc())
	elseif shape == "jar" then
		if id == "ikura" then
			Kit.cyl(m, 0.5, 0.16, 0, 0.08, 0, P.white, M.plastic, nc())
			for k = 0, 9 do
				Kit.ball(m, 0.1, -0.15 + (k % 4) * 0.1, 0.18, -0.1 + math.floor(k / 4) * 0.1, F.ikura, M.glass, nc({ transparency = 0.15, reflectance = 0.25 }))
			end
		elseif id == "matcha" or id == "green_tea" then
			-- tea tin with a paper label
			Kit.cyl(m, 0.36, 0.48, 0, 0.24, 0, id == "matcha" and F.matcha or c("#2E5A3A"), M.metal, nc({ reflectance = 0.15 }))
			Kit.cyl(m, 0.38, 0.1, 0, 0.5, 0, P.metal, M.metal, nc())
			Kit.cyl(m, 0.37, 0.2, 0, 0.22, 0, P.paper, M.smooth, nc())
		elseif id == "miso_paste" then
			Kit.cyl(m, 0.5, 0.28, 0, 0.14, 0, P.white, M.plastic, nc())
			Kit.cyl(m, 0.46, 0.02, 0, 0.29, 0, col, M.sand, nc())
			Kit.cyl(m, 0.52, 0.04, 0, 0.3, 0, F.lacquerRed, M.plastic, nc({ transparency = 0.5 }))
		elseif id == "sesame" then
			Kit.cyl(m, 0.32, 0.4, 0, 0.2, 0, P.glass, M.glass, nc({ transparency = 0.4 }))
			Kit.cyl(m, 0.28, 0.3, 0, 0.16, 0, col, M.sand, nc())
			Kit.cyl(m, 0.34, 0.08, 0, 0.44, 0, F.lacquerRed, M.plastic, nc())
		else
			-- broth stock in a glass jar with a wooden lid and a label
			Kit.cyl(m, 0.42, 0.46, 0, 0.23, 0, P.glass, M.glass, nc({ transparency = 0.4, reflectance = 0.15 }))
			Kit.cyl(m, 0.38, 0.34, 0, 0.18, 0, col, M.smooth, nc({ reflectance = 0.15 }))
			Kit.cyl(m, 0.44, 0.1, 0, 0.5, 0, P.wood_dark, M.wood, nc())
			Kit.cyl(m, 0.43, 0.14, 0, 0.26, 0, P.paper, M.smooth, nc())
		end
	elseif shape == "bottle" then
		if id == "ramune" then
			dishRamune(m, 0.55)
		else
			Kit.cyl(m, 0.26, 0.5, 0, 0.25, 0, col, M.glass, nc({ transparency = 0.15, reflectance = 0.15 }))
			Kit.cyl(m, 0.2, 0.08, 0, 0.54, 0, col, M.glass, nc({ transparency = 0.15 }))
			Kit.cyl(m, 0.12, 0.18, 0, 0.66, 0, col, M.glass, nc({ transparency = 0.15 }))
			Kit.cyl(m, 0.14, 0.06, 0, 0.77, 0, F.lacquerRed, M.plastic, nc())
			Kit.cyl(m, 0.27, 0.2, 0, 0.25, 0, P.paper, M.smooth, nc())
		end
	elseif shape == "noodle" then
		-- portions of fresh wavy noodles on a tray
		Kit.box(m, 0.75, 0.04, 0.45, 0, 0.02, 0, P.white, M.plastic, nc())
		local thick = id == "tsukemen_noodles" and 0.06 or 0.04
		for p = 0, 1 do
			local px = -0.18 + p * 0.36
			Kit.blob(m, 0.32, 0.1, 0.32, px, 0.08, 0, col, M.smooth, nc())
			for k = 0, 5 do
				Kit.part(m, Vector3.new(0.28, thick, thick), CFrame.new(px + (k % 2) * 0.03 - 0.015, 0.11 + (k % 3) * 0.02, -0.1 + k * 0.04) * CFrame.Angles(0, math.rad(-20 + k * 9), math.rad((k % 2) * 6)), lerp(col, P.white, (k % 3) * 0.08), M.smooth, nc({ shape = Enum.PartType.Cylinder }))
			end
		end
	elseif shape == "egg" then
		-- carton of four brown eggs
		Kit.box(m, 0.62, 0.1, 0.36, 0, 0.05, 0, c("#C9B8A0"), M.cardboard, nc())
		for k = 0, 3 do
			Kit.blob(m, 0.2, 0.26, 0.2, -0.22 + k * 0.145, 0.2, 0, c("#C9894A"), M.smooth, nc({ reflectance = 0.04 }))
		end
	elseif shape == "sheet" then
		-- stack of nori sheets in a clear pack
		for k = 0, 4 do
			Kit.box(m, 0.6, 0.012, 0.52, 0, 0.02 + k * 0.016, 0, k % 2 == 0 and F.nori or F.noriLight, M.smooth, nc({ reflectance = 0.06 }))
		end
		Kit.box(m, 0.64, 0.1, 0.56, 0, 0.05, 0, P.glass, M.glass, nc({ transparency = 0.7 }))
		Kit.box(m, 0.2, 0.08, 0.02, 0.15, 0.06, -0.285, P.gold, M.smooth, nc())
	elseif shape == "ball" then
		for k, cc in ipairs({ c("#F4B6C8"), P.white, F.matcha, c("#F4B6C8"), P.white, F.matcha }) do
			local x, z = -0.2 + ((k - 1) % 3) * 0.2, -0.1 + math.floor((k - 1) / 3) * 0.2
			Kit.blob(m, 0.2, 0.15, 0.2, x, 0.1, z, cc, M.smooth, nc())
		end
		Kit.box(m, 0.66, 0.03, 0.46, 0, 0.015, 0, P.wood_light, M.wood, nc())
	elseif shape == "leaf" then
		-- bunch of scallions with white ends and roots, tied with a band
		for k = -2, 2 do
			Kit.part(m, Vector3.new(0.7, 0.06, 0.06), CFrame.new(0.05, 0.05, k * 0.05) * CFrame.Angles(0, math.rad(k * 3), 0), col, M.smooth, nc({ shape = Enum.PartType.Cylinder }))
			Kit.part(m, Vector3.new(0.2, 0.065, 0.065), CFrame.new(-0.32, 0.05, k * 0.05) * CFrame.Angles(0, math.rad(k * 3), 0), P.white, M.smooth, nc({ shape = Enum.PartType.Cylinder }))
		end
		Kit.box(m, 0.04, 0.16, 0.3, -0.2, 0.06, 0, F.indigo, M.plastic, nc())
		Kit.box(m, 0.06, 0.05, 0.22, -0.44, 0.05, 0, c("#D8D0B0"), M.fabric, nc())
	elseif id == "naruto" then
		Kit.cylH(m, 0.3, 0.6, 0, 0.15, 0, F.naruto, M.smooth, nc())
		for k, cc in ipairs({ F.narutoPink, F.naruto, F.narutoPink }) do
			Kit.cylH(m, 0.24 - (k - 1) * 0.07, 0.605 + k * 0.002, 0, 0.15, 0, cc, M.smooth, nc())
		end
		for k = 0, 5 do
			local a = k * math.pi / 3
			Kit.box(m, 0.6, 0.04, 0.04, 0, 0.15 + math.sin(a) * 0.15, math.cos(a) * 0.15, F.naruto, M.smooth, nc())
		end
	elseif id == "tofu" then
		Kit.box(m, 0.62, 0.12, 0.44, 0, 0.06, 0, P.white, M.plastic, nc({ transparency = 0.3 }))
		Kit.box(m, 0.52, 0.22, 0.36, 0, 0.13, 0, F.tofu, M.smooth, nc())
		Kit.box(m, 0.6, 0.02, 0.42, 0, 0.1, 0, P.water, M.glass, nc({ transparency = 0.6 }))
	elseif id == "chashu" then
		-- rolled braised pork belly tied with string
		Kit.cylH(m, 0.36, 0.62, 0, 0.18, 0, F.chashuEdge, M.smooth, nc({ reflectance = 0.15 }))
		Kit.cylH(m, 0.3, 0.625, 0, 0.18, 0, F.chashuFat, M.smooth, nc())
		Kit.cylH(m, 0.18, 0.63, 0, 0.18, 0, F.chashuMeat, M.smooth, nc())
		for k = 0, 2 do
			Kit.cylH(m, 0.37, 0.02, -0.18 + k * 0.18, 0.18, 0, P.paper, M.fabric, nc())
		end
	elseif id == "surimi" then
		for k = 0, 3 do
			Kit.cylH(m, 0.1, 0.6, 0, 0.06 + math.floor(k / 2) * 0.09, -0.06 + (k % 2) * 0.12, P.white, M.smooth, nc())
			Kit.box(m, 0.6, 0.04, 0.06, 0, 0.1 + math.floor(k / 2) * 0.09, -0.06 + (k % 2) * 0.12, F.crab, M.smooth, nc())
		end
	elseif id == "corn" then
		Kit.cylH(m, 0.26, 0.6, 0, 0.13, 0, F.corn, M.sand, nc())
		for k = 0, 4 do
			Kit.cylH(m, 0.27, 0.025, -0.24 + k * 0.12, 0.13, 0, lerp(F.corn, P.wood, 0.2), M.sand, nc())
		end
		Kit.cylH(m, 0.12, 0.12, 0.36, 0.13, 0, c("#C8B87A"), M.wood, nc())
	elseif id == "butter" then
		Kit.box(m, 0.5, 0.18, 0.28, 0, 0.09, 0, P.paper, M.smooth, nc())
		Kit.box(m, 0.36, 0.19, 0.285, 0.08, 0.09, 0, F.butter, M.smooth, nc({ reflectance = 0.1 }))
		Kit.box(m, 0.16, 0.18, 0.3, -0.18, 0.09, 0, F.indigo, M.smooth, nc())
	elseif id == "edamame" then
		Kit.box(m, 0.6, 0.06, 0.4, 0, 0.03, 0, P.white, M.plastic, nc())
		for k = 0, 5 do
			Kit.blob(m, 0.32, 0.08, 0.12, -0.15 + (k % 2) * 0.28, 0.08 + math.floor(k / 2) * 0.02, -0.12 + math.floor(k / 2) * 0.12, c("#6FAE3E"), M.smooth, nc({ rot = CFrame.Angles(0, k * 0.4, 0) }))
		end
	elseif id == "gyoza_raw" then
		Kit.box(m, 0.7, 0.04, 0.44, 0, 0.02, 0, P.white, M.plastic, nc())
		for k = 0, 5 do
			gyozaPiece(m, CFrame.new(-0.22 + (k % 3) * 0.22, 0.02, -0.1 + math.floor(k / 3) * 0.2) * CFrame.Angles(0, math.rad(10), 0), false)
		end
	elseif id == "kikurage" then
		Kit.box(m, 0.5, 0.38, 0.06, 0, 0.19, 0, P.glass, M.glass, nc({ transparency = 0.6 }))
		for k = 0, 4 do
			Kit.blob(m, 0.18, 0.12, 0.05, -0.12 + (k % 3) * 0.12, 0.12 + math.floor(k / 3) * 0.14, 0, F.kikurage, M.smooth, nc({ rot = CFrame.Angles(0, 0, k) }))
		end
		Kit.box(m, 0.5, 0.06, 0.07, 0, 0.36, 0, F.lacquerRed, M.plastic, nc())
	elseif id == "minced_pork" or id == "chicken" then
		-- butcher tray with cling film
		Kit.box(m, 0.62, 0.05, 0.42, 0, 0.025, 0, P.white, M.plastic, nc())
		if id == "minced_pork" then
			for k = 0, 11 do
				Kit.ball(m, 0.12, -0.2 + (k % 4) * 0.13, 0.08 + (k % 3) * 0.015, -0.1 + math.floor(k / 4) * 0.1, lerp(c("#C8665A"), c("#E8A898"), (k % 3) * 0.25), M.sand, nc())
			end
		else
			for k = 0, 2 do
				Kit.blob(m, 0.24, 0.1, 0.3, -0.17 + k * 0.17, 0.08, 0, lerp(c("#E8B48A"), c("#F2CBB0"), (k % 2) * 0.5), M.smooth, nc({ rot = CFrame.Angles(0, k * 0.5, 0), reflectance = 0.08 }))
			end
		end
		Kit.box(m, 0.64, 0.01, 0.44, 0, 0.15, 0, P.glass, M.glass, nc({ transparency = 0.75, reflectance = 0.3 }))
	elseif id == "mochi" then
		Kit.box(m, 0.66, 0.03, 0.46, 0, 0.015, 0, P.wood_light, M.wood, nc())
		for k = 0, 5 do
			Kit.blob(m, 0.2, 0.15, 0.2, -0.2 + (k % 3) * 0.2, 0.1, -0.1 + math.floor(k / 3) * 0.2, k % 2 == 0 and c("#F4B6C8") or P.white, M.smooth, nc())
		end
	else
		-- generic pack with a coloured label
		Kit.box(m, 0.5, 0.3, 0.35, 0, 0.15, 0, col, M.smooth, nc())
		Kit.box(m, 0.52, 0.1, 0.37, 0, 0.18, 0, P.white, M.smooth, nc())
	end
	Kit.finish(m, Vector3.new(0.8, 0.6, 0.6))
	m:SetAttribute("Ingredient", id)
	return m
end

---------------------------------------------------------------------------------------------------
-- Supplier boxes, dirty dishes, stacks and tools
---------------------------------------------------------------------------------------------------

local BOX_BAND = { fish = "#2E5A8C", fridge = "#3E8A4A", dry = "#B3262E" }

-- Paper label on a big face of a box: the ingredient icon in the middle and "left/total" in the
-- lower-right corner (TextLabel "Count", updated by SupplyService)
local function boxLabel(body, face, icon, count, cap)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Label"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 60
	gui.LightInfluence = 1
	gui.Parent = body
	local paper = Instance.new("Frame")
	paper.AnchorPoint = Vector2.new(0.5, 0.5)
	paper.Position = UDim2.fromScale(0.5, 0.48)
	paper.Size = UDim2.fromScale(0.8, 0.72)
	paper.BackgroundColor3 = Color3.fromRGB(244, 235, 221)
	paper.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.08, 0)
	corner.Parent = paper
	local iconLabel = Instance.new("TextLabel")
	iconLabel.Name = "Icon"
	iconLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	iconLabel.Position = UDim2.fromScale(0.42, 0.5)
	iconLabel.Size = UDim2.fromScale(0.62, 0.86)
	iconLabel.BackgroundTransparency = 1
	iconLabel.Text = icon
	iconLabel.TextScaled = true
	iconLabel.AutoLocalize = false
	iconLabel.Parent = paper
	local countLabel = Instance.new("TextLabel")
	countLabel.Name = "Count"
	countLabel.AnchorPoint = Vector2.new(1, 1)
	countLabel.Position = UDim2.new(1, -4, 1, -4)
	countLabel.Size = UDim2.fromScale(0.44, 0.34)
	countLabel.BackgroundColor3 = Color3.fromRGB(43, 35, 32)
	countLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	countLabel.Text = tostring(count) .. "/" .. tostring(cap)
	countLabel.TextScaled = true
	countLabel.FontFace = Font.new("rbxasset://fonts/families/FredokaOne.json")
	countLabel.AutoLocalize = false
	countLabel.Parent = paper
	local round = Instance.new("UICorner")
	round.CornerRadius = UDim.new(0.25, 0)
	round.Parent = countLabel
	return gui
end

-- Supplier cardboard box: packing tape, hand holes, coloured band by storage type, and on both big
-- faces the icon with the portions left (language independent). cap = portions of a full box.
-- Products peeking out of an open box: up to 6 in a 3x2 grid, tops just above the rim
local function boxContents(m, id, n, W, H, D)
	local shown = math.min(n, 6)
	local cols, rows = 3, 2
	local cw, cd = (W - 0.25) / cols, (D - 0.25) / rows
	for k = 1, shown do
		local p = ingredient(id)
		local ok, ext = pcall(function()
			return p:GetExtentsSize()
		end)
		if ok and ext then
			local fit = math.min(0.9 * cw / math.max(ext.X, 0.01), 0.9 * cd / math.max(ext.Z, 0.01), 0.7 / math.max(ext.Y, 0.01), 1)
			pcall(function()
				p:ScaleTo(fit)
			end)
		end
		local i, j = (k - 1) % cols, math.floor((k - 1) / cols)
		local x = -(W - 0.25) / 2 + cw * (i + 0.5)
		local z = -(D - 0.25) / 2 + cd * (j + 0.5)
		local target = CFrame.new(x, H - 0.5, z) * CFrame.Angles(0, math.rad((k * 37) % 20 - 10), 0)
		p:PivotTo(target)
		local okBox, bb, size = pcall(function()
			return p:GetBoundingBox()
		end)
		if okBox and bb then
			p:PivotTo(target + Vector3.new(0, target.Position.Y - (bb.Position.Y - size.Y / 2), 0))
		end
		for _, d in ipairs(p:GetDescendants()) do
			if d:IsA("BasePart") then
				d.CanCollide = false
				d.CanQuery = false
			end
		end
		p.Parent = m
	end
end

-- Supplier cardboard box, closed on the racks: packing tape, hand holes, coloured band by storage
-- type, and on both big faces the icon with the portions left (language independent).
-- cap = portions of a full box. open = the box you carry: flaps folded out and some of the
-- products inside visible (as in shop tycoons), as long as something is left in it.
local function box(id, count, cap, open)
	local ing = Ingredients.byId[id]
	local m = Kit.model("Box")
	local W, H, D, T = 1.8, 1.3, 1.5, 0.07
	local icon = ing and ing.icon or "📦"
	local n = count or (ing and ing.units) or 0
	local full = math.max(cap or (ing and ing.units) or n, n)
	local band = BOX_BAND[ing and ing.storage or "dry"] or BOX_BAND.dry
	local front, back
	if open and n > 0 then
		local inside = lerp(P.cardboard, P.black, 0.35)
		Kit.box(m, W - 2 * T, T, D - 2 * T, 0, T / 2 + 0.02, 0, inside, M.cardboard, nc())
		front = Kit.box(m, W, H, T, 0, H / 2, -D / 2 + T / 2, P.cardboard, M.cardboard, { name = "Body" })
		back = Kit.box(m, W, H, T, 0, H / 2, D / 2 - T / 2, P.cardboard, M.cardboard, nc())
		for _, sx in ipairs({ -1, 1 }) do
			Kit.box(m, T, H, D - 2 * T, sx * (W / 2 - T / 2), H / 2, 0, P.cardboard, M.cardboard, nc())
			Kit.box(m, 0.02, 0.14, 0.4, sx * (W / 2 + 0.005), 0.95, 0, lerp(P.cardboard, P.black, 0.55), M.smooth, nc())
		end
		-- the inner faces of the walls are a little darker
		Kit.box(m, W - 2 * T, H - 0.1, 0.01, 0, H / 2, -D / 2 + T + 0.005, inside, M.cardboard, nc())
		Kit.box(m, W - 2 * T, H - 0.1, 0.01, 0, H / 2, D / 2 - T - 0.005, inside, M.cardboard, nc())
		-- coloured band on the outside of the walls only (the inside stays cardboard)
		for _, sz in ipairs({ -1, 1 }) do
			Kit.box(m, W + 0.02, 0.18, 0.01, 0, 0.18, sz * (D / 2 + 0.005), c(band), M.smooth, nc())
		end
		for _, sx in ipairs({ -1, 1 }) do
			Kit.box(m, 0.01, 0.18, D + 0.02, sx * (W / 2 + 0.005), 0.18, 0, c(band), M.smooth, nc())
		end
		-- four flaps folded outwards
		local a = math.rad(50)
		local len = 0.62
		local fl = lerp(P.cardboard, P.white, 0.08)
		for _, sz in ipairs({ -1, 1 }) do
			local hinge = Vector3.new(0, H, sz * D / 2)
			local dir = Vector3.new(0, math.sin(a), sz * math.cos(a))
			Kit.part(m, Vector3.new(W - 0.04, 0.04, len), CFrame.new(hinge + dir * (len / 2)) * CFrame.Angles(-sz * a, 0, 0), fl, M.cardboard, nc())
		end
		for _, sx in ipairs({ -1, 1 }) do
			local hinge = Vector3.new(sx * W / 2, H, 0)
			local dir = Vector3.new(sx * math.cos(a), math.sin(a), 0)
			Kit.part(m, Vector3.new(len * 0.8, 0.04, D - 0.06), CFrame.new(hinge + dir * (len * 0.4)) * CFrame.Angles(0, 0, sx * a), fl, M.cardboard, nc())
		end
		boxContents(m, id, n, W, H, D)
	else
		local body = Kit.box(m, W, H, D, 0, H / 2, 0, P.cardboard, M.cardboard, { name = "Body" })
		Kit.box(m, W + 0.02, 0.12, 0.3, 0, H - 0.05, 0, c("#D8C49A"), M.smooth, nc({ transparency = 0.1 }))
		Kit.box(m, W - 0.2, 0.012, 0.012, 0, H + 0.01, 0, lerp(P.cardboard, P.black, 0.35), M.smooth, nc())
		Kit.box(m, W + 0.02, 0.18, D + 0.02, 0, 0.18, 0, c(band), M.smooth, nc())
		for _, sx in ipairs({ -1, 1 }) do
			Kit.box(m, 0.02, 0.14, 0.4, sx * 0.905, 0.95, 0, lerp(P.cardboard, P.black, 0.55), M.smooth, nc())
		end
		front, back = body, body
	end
	-- front faces the shelf / aisle, back faces you when you carry it
	boxLabel(front, Enum.NormalId.Front, icon, n, full)
	boxLabel(back, Enum.NormalId.Back, icon, n, full)
	Kit.finish(m, Vector3.new(W, H, D))
	m:SetAttribute("Ingredient", id)
	return m
end

local function dirty(kind)
	local m = Kit.model("Dirty")
	if kind == "bowl" then
		local y = donburi(m, 1.3, 0.55, P.porcelain, F.porcelain, F.lacquerRed)
		Kit.cyl(m, 0.9, 0.012, 0.05, y - 0.005, 0, c("#A8865A"), M.smooth, nc({ transparency = 0.25, reflectance = 0.2 }))
		for k = 0, 2 do
			Kit.part(m, Vector3.new(0.3, 0.04, 0.04), CFrame.new(-0.1 + k * 0.08, y + 0.01, -0.05 + k * 0.08) * CFrame.Angles(0, k, 0), F.noodle, M.smooth, nc({ shape = Enum.PartType.Cylinder }))
		end
		scallions(m, 0.15, y + 0.01, 0.1, 3, 9)
	else
		local y = plateRound(m, 1.2, F.porcelain, F.indigo)
		Kit.cyl(m, 0.3, 0.008, 0.2, y + 0.002, 0.1, F.sauce, M.smooth, nc({ transparency = 0.3 }))
		for k = 0, 4 do
			Kit.ball(m, 0.06, -0.2 + k * 0.1, y + 0.02, (k % 2) * 0.15 - 0.05, F.rice, M.sand, nc())
		end
		Kit.blob(m, 0.3, 0.12, 0.24, -0.25, y + 0.06, 0.2, P.white, M.fabric, nc())
	end
	chopsticks(m, 0.1, -0.6, 10, 0.05)
	Kit.finish(m, Vector3.new(1.3, 0.6, 1.3))
	return m
end

local function dishStack(count, kind)
	local m = Kit.model("Stack")
	for k = 0, math.min(count, 5) - 1 do
		local col = kind == "dirty" and c("#D8D0C0") or F.porcelain
		Kit.cyl(m, 1.1, 0.1, 0, 0.06 + k * 0.12, 0, col, M.smooth, nc({ reflectance = 0.05 }))
		Kit.cyl(m, 1.12, 0.02, 0, 0.08 + k * 0.12, 0, F.indigo, M.smooth, nc())
	end
	Kit.finish(m, Vector3.new(1.2, 0.7, 1.2))
	return m
end

local function tool(kind)
	local m = Kit.model("Tool")
	if kind == "knife" then
		-- yanagiba: long single-bevel blade, spine, collar and wooden handle
		Kit.box(m, 1.25, 0.22, 0.025, 0.42, 0, 0, P.metal, M.metal, nc({ reflectance = 0.35 }))
		Kit.box(m, 1.25, 0.04, 0.03, 0.42, 0.1, 0, P.steel, M.metal, nc({ reflectance = 0.2 }))
		Kit.wedge(m, 0.025, 0.22, 0.2, CFrame.new(1.13, 0, 0) * CFrame.Angles(0, math.rad(90), 0), P.metal, M.metal, nc({ reflectance = 0.35 }))
		Kit.box(m, 0.08, 0.16, 0.1, -0.24, 0, 0, P.black, M.smooth, nc())
		Kit.box(m, 0.55, 0.14, 0.1, -0.55, 0, 0, P.hinoki, M.wood, nc())
	elseif kind == "mat" then
		for k = -4, 4 do
			Kit.cylH(m, 0.06, 1.3, 0, 0, k * 0.1, P.bamboo, M.wood, nc())
		end
		for _, x in ipairs({ -0.4, 0, 0.4 }) do
			Kit.box(m, 0.02, 0.065, 0.9, x, 0, 0, c("#E8E0C8"), M.fabric, nc())
		end
	elseif kind == "ladle" then
		Kit.cyl(m, 0.06, 1.4, 0, 0.5, 0, P.metal, M.metal, nc({ reflectance = 0.25 }))
		Kit.blob(m, 0.4, 0.2, 0.4, 0, -0.2, 0, P.metal, M.metal, nc({ reflectance = 0.25 }))
		Kit.cyl(m, 0.08, 0.4, 0, 1.0, 0, P.wood_dark, M.wood, nc())
	elseif kind == "spatula" then
		Kit.box(m, 0.5, 0.03, 0.4, 0.3, 0, 0, P.metal, M.metal, nc({ reflectance = 0.25 }))
		Kit.box(m, 0.8, 0.08, 0.08, -0.3, 0.05, 0, P.wood_dark, M.wood, nc())
	else
		-- tebo noodle strainer: mesh basket and long handle
		Kit.cyl(m, 0.5, 0.4, 0, 0, 0, P.metal, M.metal, nc({ transparency = 0.35 }))
		Kit.cyl(m, 0.52, 0.04, 0, 0.2, 0, P.steel, M.metal, nc())
		Kit.cylH(m, 0.06, 1.0, 0.7, 0.1, 0, P.wood_dark, M.wood, nc())
	end
	Kit.finish(m, Vector3.new(1.4, 0.4, 0.6))
	return m
end

return function(Registry)
	Registry.registerFood("dish", dish)
	Registry.registerFood("ingredient", ingredient)
	Registry.registerFood("box", box)
	Registry.registerFood("dirty", dirty)
	Registry.registerFood("stack", dishStack)
	Registry.registerFood("tool", tool)
	Registry.Food.BrothColors = BROTH
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000047"><Properties><string name="Name">Furniture</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Seating, counters, tables, benches and storage racks.
local Kit = require(script.Parent.Parent.Kit)
local P = require(script.Parent.Parent.Palette)
local M = P.M
local JP_FONT = Font.new("rbxasset://fonts/families/FredokaOne.json", Enum.FontWeight.Bold)

local function size(item)
	return Vector3.new(item.size[1], item.size[2], item.size[3])
end

-- Attachment on Root at local bottom-relative position (x, y, z) facing `look` (+Z/-Z/...)
local function point(root, name, x, y, z, yaw)
	local h = root.Size.Y
	return Kit.attach(root, name, CFrame.new(x, y - h / 2, z) * CFrame.Angles(0, math.rad(yaw or 0), 0))
end

local function nc()
	return { collide = false, shadow = false }
end

-- Condiment set: soy dispenser, shichimi tin, chopstick box and toothpick holder
local function condiments(m, x, y, z, rotY)
	local base = CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(rotY or 0), 0)
	local function at(dx, dz)
		local p = base * CFrame.new(dx, 0, dz)
		return p.X, p.Z
	end
	local sx, sz = at(-0.45, 0)
	Kit.cyl(m, 0.24, 0.42, sx, y + 0.21, sz, P.glass, M.glass, { collide = false, shadow = false, transparency = 0.25 })
	Kit.cyl(m, 0.2, 0.26, sx, y + 0.14, sz, P.wood_black, M.smooth, nc())
	Kit.cyl(m, 0.26, 0.1, sx, y + 0.47, sz, P.lacquer, M.smooth, nc())
	local tx, tz = at(-0.12, 0.05)
	Kit.cyl(m, 0.2, 0.3, tx, y + 0.15, tz, P.vermilion, M.metal, nc())
	Kit.cyl(m, 0.21, 0.05, tx, y + 0.32, tz, P.gold, M.metal, nc())
	local bx, bz = at(0.35, 0)
	Kit.box(m, 0.6, 0.28, 0.3, bx, y + 0.14, bz, P.wood_black, M.wood, { collide = false, shadow = false, rot = CFrame.Angles(0, math.rad(rotY or 0), 0) })
	Kit.box(m, 0.56, 0.04, 0.26, bx, y + 0.29, bz, P.lacquer_dark, M.smooth, { collide = false, shadow = false, rot = CFrame.Angles(0, math.rad(rotY or 0), 0) })
	local px, pz = at(0.8, 0.02)
	Kit.cyl(m, 0.16, 0.24, px, y + 0.12, pz, P.bamboo, M.wood, nc())
	Kit.cyl(m, 0.1, 0.12, px, y + 0.3, pz, P.hinoki, M.wood, nc())
end

local function stool(m, item, seatColor, seatMat, legColor, swivel)
	local root = Kit.finish(m, size(item))
	local h = item.size[2]
	if swivel then
		Kit.cyl(m, 1.5, 0.12, 0, 0.06, 0, P.steel_dark, M.metal)
		Kit.cyl(m, 0.28, h - 0.5, 0, (h - 0.5) / 2 + 0.1, 0, P.metal, M.metal, { reflectance = 0.2 })
		Kit.cyl(m, 1.2, 0.08, 0, 0.9, 0, P.metal, M.metal, { collide = false })
		Kit.cyl(m, 1.6, 0.35, 0, h - 0.2, 0, seatColor, seatMat)
		Kit.cyl(Kit.detail(m, "furnish"), 1.66, 0.06, 0, h - 0.38, 0, P.gold, M.metal, { collide = false })
	else
		for _, c in ipairs({ { -0.5, -0.5 }, { 0.5, -0.5 }, { 0.5, 0.5 }, { -0.5, 0.5 } }) do
			Kit.box(m, 0.18, h - 0.3, 0.18, c[1], (h - 0.3) / 2, c[2], legColor, M.wood, { rot = CFrame.Angles(c[2] * 0.08, 0, -c[1] * 0.08) })
		end
		for _, r in ipairs({ { 0, -0.48, 1, 0.1 }, { 0, 0.48, 1, 0.1 }, { -0.48, 0, 0.1, 1 }, { 0.48, 0, 0.1, 1 } }) do
			Kit.box(m, r[3], 0.1, r[4], r[1], 0.8, r[2], legColor, M.wood, { collide = false })
		end
		Kit.cyl(m, 1.55, 0.28, 0, h - 0.16, 0, P.wood_light, M.wood)
		local df = Kit.detail(m, "furnish")
		Kit.cyl(df, 1.6, 0.06, 0, h - 0.29, 0, P.wood_dark, M.wood, nc())
		if seatMat == M.fabric then
			Kit.cyl(m, 1.45, 0.2, 0, h + 0.02, 0, seatColor, M.fabric, { collide = false })
			Kit.cyl(df, 1.47, 0.04, 0, h - 0.07, 0, P.gold, M.fabric, nc())
			Kit.ball(df, 0.14, 0, h + 0.13, 0, P.gold, M.fabric, nc())
		else
			-- wood grain rings on the bare seat
			Kit.cyl(df, 1.0, 0.02, 0, h, 0, P.wood, M.wood, nc())
			Kit.cyl(df, 0.5, 0.025, 0, h + 0.005, 0, P.wood_light, M.wood, nc())
		end
	end
	point(root, "SitPoint", 0, h, 0, 0)
end

-- Plain counter: cabinet, wooden top, chef ledge, kick plate and foot rail.
-- Detail_counter (renovation "hinoki counter"): slats, brass hooks and brackets, light strip,
-- hinoki top and edge band, plate niche. Detail_tableware: condiments on the ledge.
-- One place setting at the front of a counter module, around the spot where the dish goes:
-- chopsticks in a paper sleeve on a rest, a folded napkin and a small menu flyer
local function placeSetting(m, x, y, zFront)
	local z = zFront + 0.75
	Kit.box(m, 0.16, 0.04, 0.85, x + 0.78, y + 0.02, z, P.paper, M.smooth, nc())
	Kit.box(m, 0.05, 0.04, 0.6, x + 0.75, y + 0.06, z - 0.05, P.wood_light, M.wood, nc())
	Kit.box(m, 0.05, 0.04, 0.6, x + 0.81, y + 0.06, z - 0.05, P.wood_light, M.wood, nc())
	Kit.box(m, 0.22, 0.06, 0.1, x + 0.78, y + 0.03, z - 0.42, P.lacquer, M.smooth, nc())
	Kit.box(m, 0.4, 0.03, 0.4, x - 0.8, y + 0.015, z + 0.05, P.white, M.fabric, nc())
	local flyer = Kit.box(m, 0.48, 0.02, 0.62, x - 0.8, y + 0.04, z + 0.05, P.cream, M.smooth, { collide = false, shadow = false, rot = CFrame.Angles(0, math.rad(-8), 0) })
	Kit.text(flyer, Enum.NormalId.Top, "🍜 MENU", { color = "#B3262E", pps = 60 })
end

-- On the raised ledge: a menu stand (お品書き), a cup of chopsticks, soy sauce and chili
local function ledgeProps(m, x, y, z)
	local card = Kit.box(m, 0.7, 0.55, 0.04, x, y + 0.3, z - 0.05, P.cream, M.smooth, { collide = false, shadow = false, rot = CFrame.Angles(math.rad(-12), 0, 0) })
	Kit.text(card, Enum.NormalId.Front, "お品書き", { color = "#2B2320", font = JP_FONT, pps = 50 })
	Kit.box(m, 0.72, 0.05, 0.2, x, y + 0.03, z + 0.05, P.wood_dark, M.wood, nc())
	Kit.cyl(m, 0.3, 0.42, x - 0.8, y + 0.21, z, P.wood_black, M.smooth, nc())
	for k = 0, 4 do
		Kit.box(m, 0.04, 0.6, 0.04, x - 0.86 + (k % 3) * 0.06, y + 0.5, z - 0.04 + math.floor(k / 3) * 0.07, P.wood_light, M.wood, nc())
	end
	Kit.cyl(m, 0.18, 0.4, x + 0.62, y + 0.2, z, P.glass, M.glass, { collide = false, shadow = false, transparency = 0.25 })
	Kit.cyl(m, 0.14, 0.26, x + 0.62, y + 0.13, z, P.wood_black, M.smooth, nc())
	Kit.cyl(m, 0.19, 0.08, x + 0.62, y + 0.44, z, P.lacquer, M.smooth, nc())
	Kit.cyl(m, 0.18, 0.26, x + 0.88, y + 0.13, z, P.vermilion, M.metal, nc())
end

local function counter(m, item, kind)
	local root = Kit.finish(m, size(item))
	local w, h, d = item.size[1], item.size[2], item.size[3]
	local dc = Kit.detail(m, "counter")
	-- cabinet (customer side faces -Z)
	Kit.box(m, w, h - 0.25, d - 0.6, 0, (h - 0.25) / 2, 0.3, P.wood_dark, M.wood)
	-- kick plate and foot rail
	Kit.box(m, w, 0.35, 0.1, 0, 0.175, -d / 2 + 0.62, P.black, M.smooth, nc())
	Kit.cylH(m, 0.12, w, 0, 0.7, -d / 2 + 0.25, P.steel, M.metal, { collide = false, reflectance = 0.1 })
	-- top with front overhang and the raised chef ledge (tsukedai) on the kitchen side
	Kit.box(m, w, 0.22, d, 0, h - 0.11, 0, P.wood_light, M.wood)
	Kit.box(m, w, 0.35, 0.5, 0, h + 0.15, d / 2 - 0.25, P.wood, M.wood, nc())
	if kind == "corner" then
		Kit.box(m, 0.5, 0.35, d - 0.5, w / 2 - 0.25, h + 0.15, -0.25, P.wood, M.wood, nc())
	elseif kind == "end" then
		Kit.box(m, 0.15, h - 0.4, d - 0.4, w / 2 - 0.075, (h - 0.4) / 2 + 0.1, 0, P.wood_black, M.wood, nc())
	end

	-- renovated look: vertical slats on the customer side with dark rails above and below
	local n = math.max(2, math.floor(w / 0.5))
	for i = 0, n - 1 do
		local x = -w / 2 + 0.25 + (w - 0.5) * i / math.max(1, n - 1)
		Kit.box(dc, 0.12, h - 0.75, 0.08, x, (h - 0.25) / 2 + 0.1, -d / 2 + 0.58, P.wood, M.wood, nc())
	end
	Kit.box(dc, w, 0.12, 0.12, 0, h - 0.5, -d / 2 + 0.56, P.wood_black, M.wood, nc())
	Kit.box(dc, w, 0.12, 0.12, 0, 0.42, -d / 2 + 0.56, P.wood_black, M.wood, nc())
	-- brass bag hooks under the overhang, brass foot rail sleeve and brackets
	for x = -w / 2 + 0.7, w / 2 - 0.4, 1.4 do
		Kit.box(dc, 0.08, 0.2, 0.08, x, h - 0.7, -d / 2 + 0.5, P.brass, M.metal, nc())
		Kit.box(dc, 0.08, 0.06, 0.2, x, h - 0.82, -d / 2 + 0.42, P.brass, M.metal, nc())
	end
	Kit.cylH(dc, 0.13, w, 0, 0.7, -d / 2 + 0.25, P.brass, M.metal, { collide = false, shadow = false, reflectance = 0.15 })
	for x = -w / 2 + 0.5, w / 2 - 0.3, 2 do
		Kit.box(dc, 0.08, 0.08, 0.36, x, 0.7, -d / 2 + 0.43, P.brass, M.metal, nc())
	end
	-- warm light strip hidden under the overhang
	Kit.box(dc, w - 0.1, 0.05, 0.08, 0, h - 0.27, -d / 2 + 0.66, P.lamp_warm, M.neon, nc())
	-- hinoki top with a dark edge band, hinoki cap on the ledge
	Kit.box(dc, w, 0.04, d, 0, h + 0.005, 0, P.hinoki, M.wood, nc())
	Kit.box(dc, w, 0.1, 0.06, 0, h - 0.17, -d / 2 - 0.02, P.wood_dark, M.wood, nc())
	Kit.box(dc, w, 0.06, 0.56, 0, h + 0.35, d / 2 - 0.25, P.hinoki, M.wood, nc())
	-- kitchen side: open niche with stacked plates and bowls
	Kit.box(dc, w - 0.4, 1.2, 0.08, 0, h - 1.05, d / 2 + 0.01, P.wood_black, M.wood, nc())
	Kit.box(dc, w - 0.4, 0.06, 0.4, 0, h - 1.05, d / 2 - 0.2, P.wood, M.wood, nc())
	for x = -w / 2 + 0.6, w / 2 - 0.5, 1 do
		for k = 0, 2 do
			Kit.cyl(dc, 0.6, 0.07, x, h - 0.98 + k * 0.08, d / 2 - 0.2, k == 2 and P.indigo or P.porcelain, M.smooth, nc())
		end
	end
	if kind == "corner" then
		Kit.box(dc, 0.56, 0.06, d - 0.5, w / 2 - 0.25, h + 0.35, -0.25, P.hinoki, M.wood, nc())
	elseif kind == "end" then
		Kit.box(dc, 0.2, 0.12, d, w / 2 - 0.1, h - 0.06, 0, P.wood_black, M.wood, nc())
	end
	-- every straight module seats one customer: a place setting in front, props on the ledge
	if kind == "straight" then
		placeSetting(m, 0, h, -d / 2)
		ledgeProps(m, 0, h + 0.33, d / 2 - 0.25)
	end
	-- renovated tableware: the lacquered condiment tray on the ledge of corner modules
	if kind == "corner" then
		condiments(Kit.detail(m, "tableware"), -0.3, h + 0.38, d / 2 - 0.25, 0)
	end
	root:SetAttribute("TopY", h)
end

local function tableTop(m, item, topColor, legColor, low)
	local root = Kit.finish(m, size(item))
	local w, h, d = item.size[1], item.size[2], item.size[3]
	if low then
		-- round chabudai with an inlaid rim and four folding legs
		local r = math.min(w, d) - 0.2
		Kit.cyl(m, r, 0.2, 0, h - 0.1, 0, topColor, M.wood)
		local df = Kit.detail(m, "furnish")
		Kit.cyl(df, r - 0.3, 0.04, 0, h + 0.005, 0, Color3.new(1, 1, 1):Lerp(topColor, 0.85), M.wood, nc())
		Kit.cyl(df, r + 0.04, 0.06, 0, h - 0.18, 0, P.wood_black, M.wood, nc())
		for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }) do
			Kit.box(m, 0.3, h - 0.2, 0.3, c[1] * r * 0.3, (h - 0.2) / 2, c[2] * r * 0.3, legColor, M.wood)
		end
		Kit.box(m, r * 0.7, 0.1, 0.2, 0, h - 0.27, 0, legColor, M.wood, nc())
		Kit.box(m, 0.2, 0.1, r * 0.7, 0, h - 0.27, 0, legColor, M.wood, nc())
		-- tea set: kyusu teapot and cups on a small tray
		local dt = Kit.detail(m, "tableware")
		Kit.cyl(dt, 1.1, 0.05, 0.6, h + 0.03, -0.5, P.bamboo, M.wood, nc())
		Kit.blob(dt, 0.45, 0.4, 0.45, 0.45, h + 0.25, -0.5, P.matcha, M.smooth, nc())
		Kit.cylH(dt, 0.08, 0.3, 0.75, h + 0.3, -0.5, P.matcha, M.smooth, nc())
		Kit.cyl(dt, 0.12, 0.06, 0.45, h + 0.47, -0.5, P.wood_dark, M.smooth, nc())
		for _, cx in ipairs({ 0.85, 1.0 }) do
			Kit.cyl(dt, 0.2, 0.2, cx, h + 0.15, -0.25, P.porcelain, M.smooth, nc())
		end
	else
		Kit.box(m, w, 0.2, d, 0, h - 0.1, 0, topColor, M.wood)
		local df = Kit.detail(m, "furnish")
		Kit.box(df, w - 0.1, 0.06, d - 0.1, 0, h + 0.005, 0, Color3.new(1, 1, 1):Lerp(topColor, 0.85), M.wood, nc())
		Kit.box(df, w + 0.04, 0.08, d + 0.04, 0, h - 0.18, 0, legColor, M.wood, nc())
		Kit.box(m, 0.4, h - 0.5, 0.4, 0, (h - 0.5) / 2 + 0.2, 0, legColor, M.wood)
		Kit.box(m, math.min(w, 2.2), 0.2, 0.4, 0, 0.1, 0, legColor, M.wood)
		Kit.box(m, 0.4, 0.2, math.min(d, 2.2), 0, 0.1, 0, legColor, M.wood)
		Kit.box(m, w - 0.6, 0.15, 0.3, 0, h - 0.28, 0, legColor, M.wood, nc())
		-- brass caps on the cross feet
		for _, c in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
			Kit.box(df, 0.44, 0.22, 0.44, c[1] * (math.min(w, 2.2) / 2 - 0.2), 0.11, c[2] * (math.min(d, 2.2) / 2 - 0.2), P.brass, M.metal, nc())
		end
		-- condiments along the back edge and a folded menu card
		local dt = Kit.detail(m, "tableware")
		condiments(dt, 0, h, d / 2 - 0.3, 0)
		Kit.wedge(dt, 0.5, 0.4, 0.3, CFrame.new(-w / 2 + 0.45, h + 0.2, d / 2 - 0.3), P.paper_warm, M.smooth, nc())
		Kit.box(dt, 0.42, 0.12, 0.02, -w / 2 + 0.45, h + 0.21, d / 2 - 0.32, P.lacquer, M.smooth, { collide = false, shadow = false, rot = CFrame.Angles(math.rad(37), 0, 0) })
	end
	root:SetAttribute("TopY", h)
end
local function chair(m, item, color, mat)
	local root = Kit.finish(m, size(item))
	local seatH = item.fn.height
	for _, c in ipairs({ { -0.6, -0.6 }, { 0.6, -0.6 }, { 0.6, 0.6 }, { -0.6, 0.6 } }) do
		Kit.box(m, 0.18, seatH - 0.12, 0.18, c[1], (seatH - 0.12) / 2, c[2], color, mat)
	end
	Kit.box(m, 1.5, 0.15, 1.5, 0, seatH - 0.06, 0, color, mat)
	Kit.box(Kit.detail(m, "furnish"), 1.4, 0.08, 1.4, 0, seatH + 0.02, 0, P.paper_warm, M.fabric, { collide = false })
	-- backrest on +Z (the sitter faces -Z)
	Kit.box(m, 0.16, 1.6, 0.16, -0.6, seatH + 0.8, 0.66, color, mat)
	Kit.box(m, 0.16, 1.6, 0.16, 0.6, seatH + 0.8, 0.66, color, mat)
	Kit.box(m, 1.36, 0.3, 0.1, 0, seatH + 1.45, 0.66, color, mat)
	Kit.box(m, 1.2, 0.12, 0.08, 0, seatH + 0.9, 0.66, color, mat)
	point(root, "SitPoint", 0, seatH, 0, 0)
end

local function cushion(m, root, x, z, color, h)
	Kit.box(m, 1.7, h, 1.7, x, h / 2, z, color, M.fabric)
	Kit.box(m, 1.5, 0.04, 1.5, x, h + 0.01, z, Color3.new(1, 1, 1):Lerp(color, 0.7), M.fabric, { collide = false })
	for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }) do
		Kit.ball(Kit.detail(m, "furnish"), 0.16, x + c[1] * 0.85, h / 2, z + c[2] * 0.85, P.gold, M.fabric, { collide = false })
	end
end

return function(Registry)
	Registry.register("stool_wood", function(m, item)
		stool(m, item, P.wood_light, M.wood, P.wood)
	end)
	Registry.register("stool_cushion", function(m, item)
		stool(m, item, P.lacquer, M.fabric, P.wood_dark)
	end)
	Registry.register("stool_swivel", function(m, item)
		stool(m, item, P.lacquer, M.leather, P.steel, true)
	end)
	Registry.register("counter_straight", function(m, item)
		counter(m, item, "straight")
	end)
	Registry.register("counter_corner", function(m, item)
		counter(m, item, "corner")
	end)
	Registry.register("counter_end", function(m, item)
		counter(m, item, "end")
	end)
	Registry.register("table_2", function(m, item)
		tableTop(m, item, P.wood_light, P.wood_dark)
	end)
	Registry.register("table_4", function(m, item)
		tableTop(m, item, P.wood_light, P.wood_dark)
	end)
	Registry.register("chabudai", function(m, item)
		tableTop(m, item, P.wood_dark, P.wood_black, true)
	end)
	Registry.register("chair_wood", function(m, item)
		chair(m, item, P.wood, M.wood)
	end)
	Registry.register("chair_lacquer", function(m, item)
		chair(m, item, P.lacquer, M.smooth)
	end)
	Registry.register("zabuton", function(m, item)
		local root = Kit.finish(m, size(item))
		cushion(m, root, 0, 0, P.indigo, 0.35)
		point(root, "SitPoint", 0, 0.4, 0, 0)
	end)
	Registry.register("booth", function(m, item)
		local root = Kit.finish(m, size(item))
		local w, h = item.size[1], item.size[2]
		-- two benches facing each other along Z
		for side = -1, 1, 2 do
			local z = side * 1.85
			Kit.box(m, w, 1.6, 1.3, 0, 0.8, z, P.wood_dark, M.wood)
			Kit.box(m, w - 0.2, 0.3, 1.2, 0, 1.75, z, P.lacquer_dark, M.leather)
			Kit.box(m, w, h - 1.6, 0.3, 0, 1.6 + (h - 1.6) / 2, z + side * 0.5, P.wood_dark, M.wood)
			Kit.box(m, w - 0.3, h - 2.2, 0.15, 0, 1.9 + (h - 2.2) / 2, z + side * 0.33, P.lacquer_dark, M.leather, { collide = false })
		end
		Kit.box(m, w - 1.2, 0.2, 2, 0, 2.6, 0, P.wood_light, M.wood)
		Kit.box(m, 0.4, 2.4, 0.4, 0, 1.3, 0, P.wood_black, M.wood)
		local df = Kit.detail(m, "furnish")
		Kit.box(df, w - 1.25, 0.08, 2.05, 0, 2.48, 0, P.wood_dark, M.wood, nc())
		Kit.box(df, 1.6, 0.15, 0.8, 0, 0.08, 0, P.wood_black, M.wood, nc())
		condiments(Kit.detail(m, "tableware"), 0, 2.7, 0, 90)
		-- kumiko lattice panels on top of both backrests and dark cap rails
		for side = -1, 1, 2 do
			local z = side * 1.85 + side * 0.5
			Kit.box(df, w, 0.12, 0.36, 0, h + 0.06, z, P.wood_black, M.wood, nc())
			Kit.box(df, w - 0.2, 0.7, 0.06, 0, h + 0.47, z, P.paper, M.smooth, { collide = false, shadow = false, transparency = 0.1 })
			for x = -w / 2 + 0.1, w / 2 - 0.05, 0.45 do
				Kit.box(df, 0.05, 0.7, 0.1, x, h + 0.47, z, P.wood_dark, M.wood, nc())
			end
			for _, y in ipairs({ h + 0.3, h + 0.6 }) do
				Kit.box(df, w - 0.2, 0.05, 0.1, 0, y, z, P.wood_dark, M.wood, nc())
			end
			Kit.box(df, w, 0.1, 0.2, 0, h + 0.86, z, P.wood_black, M.wood, nc())
		end
		local i = 0
		for side = -1, 1, 2 do
			for _, x in ipairs({ -1.2, 1.2 }) do
				i += 1
				point(root, "Seat" .. i, x, 1.9, side * 1.85, side < 0 and 180 or 0)
				point(root, "Dish" .. i, x, 2.7, side * 0.55, 0)
			end
		end
		root:SetAttribute("TopY", 2.7)
	end)
	Registry.register("zashiki_table", function(m, item)
		local root = Kit.finish(m, size(item))
		Kit.box(m, 4, 0.2, 2.4, 0, 1.2, 0, P.wood_black, M.wood)
		Kit.box(m, 3.9, 0.04, 2.3, 0, 1.31, 0, P.lacquer_dark, M.smooth, { collide = false })
		Kit.box(Kit.detail(m, "furnish"), 4.06, 0.08, 2.46, 0, 1.08, 0, P.gold, M.metal, nc())
		-- sake set: tokkuri flask and choko cups on a lacquer tray, plus a small ikebana
		local dt = Kit.detail(m, "tableware")
		Kit.box(dt, 0.9, 0.06, 0.5, 0, 1.36, 0, P.lacquer, M.smooth, nc())
		Kit.blob(dt, 0.28, 0.42, 0.28, -0.2, 1.58, 0, P.porcelain, M.smooth, nc())
		Kit.cyl(dt, 0.12, 0.16, -0.2, 1.85, 0, P.porcelain, M.smooth, nc())
		Kit.cyl(dt, 0.14, 0.1, 0.12, 1.44, -0.08, P.indigo, M.smooth, nc())
		Kit.cyl(dt, 0.14, 0.1, 0.3, 1.44, 0.08, P.indigo, M.smooth, nc())
		Kit.cyl(dt, 0.3, 0.3, 1.5, 1.48, 0, P.wood_black, M.smooth, nc())
		Kit.box(dt, 0.04, 0.6, 0.04, 1.5, 1.85, 0, P.leaf_dark, M.wood, nc())
		Kit.ball(dt, 0.2, 1.5, 2.15, 0, P.maple, M.smooth, nc())
		Kit.ball(dt, 0.14, 1.6, 1.98, 0.06, P.sakura, M.smooth, nc())
		for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }) do
			Kit.box(m, 0.3, 1.1, 0.3, c[1] * 1.7, 0.55, c[2] * 0.95, P.wood_black, M.wood)
		end
		local i = 0
		for side = -1, 1, 2 do
			for _, x in ipairs({ -1.1, 1.1 }) do
				i += 1
				cushion(m, root, x, side * 2.2, P.lacquer, 0.3)
				point(root, "Seat" .. i, x, 0.35, side * 2.2, side < 0 and 180 or 0)
				point(root, "Dish" .. i, x, 1.32, side * 0.6, 0)
			end
		end
		root:SetAttribute("TopY", 1.32)
	end)
	Registry.register("waiting_bench", function(m, item)
		local root = Kit.finish(m, size(item))
		local w = item.size[1]
		Kit.box(m, w, 0.2, 1.2, 0, 1.5, 0, P.wood_light, M.wood)
		for _, x in ipairs({ -w / 2 + 0.4, w / 2 - 0.4 }) do
			Kit.box(m, 0.25, 1.4, 1, x, 0.7, 0, P.wood_dark, M.wood)
		end
		Kit.box(m, w, 0.5, 0.15, 0, 2.2 - 0.25, 0.6, P.wood_light, M.wood, { collide = false })
		for _, x in ipairs({ -w / 2 + 0.4, w / 2 - 0.4 }) do
			Kit.box(m, 0.15, 0.7, 0.15, x, 1.95, 0.6, P.wood_dark, M.wood, nc())
		end
		-- red felt runner (mosen) like a tea house bench
		local df = Kit.detail(m, "furnish")
		Kit.box(df, w - 0.6, 0.04, 1.1, 0, 1.62, 0, P.lacquer, M.fabric, nc())
		Kit.box(df, w - 0.6, 0.6, 0.04, 0, 1.33, -0.56, P.lacquer, M.fabric, nc())
		Kit.box(df, 0.6, 0.18, 0.5, w / 2 - 0.7, 1.73, 0.15, P.indigo, M.fabric, nc())
		for i, x in ipairs({ -1.6, 0, 1.6 }) do
			point(root, "Queue" .. i, x, 1.6, 0, 0)
		end
	end)
	-- storage racks: box slots BoxN on Root
	local function rack(m, item)
		local root = Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		local rows, cols = item.fn.rows, item.fn.cols
		for _, x in ipairs({ -w / 2 + 0.1, w / 2 - 0.1 }) do
			for _, z in ipairs({ -d / 2 + 0.1, d / 2 - 0.1 }) do
				Kit.box(m, 0.15, h, 0.15, x, h / 2, z, P.steel_dark, M.metal)
			end
		end
		local slot = 0
		for r = 0, rows - 1 do
			local y = 0.15 + r * 2.0
			Kit.box(m, w - 0.1, 0.12, d - 0.1, 0, y, 0, P.wood, M.planks)
			for c = 0, cols - 1 do
				slot += 1
				local x = -w / 2 + w / cols * (c + 0.5)
				point(root, "Box" .. slot, x, y + 0.06, 0, 0)
			end
		end
		Kit.box(m, w - 0.1, 0.12, d - 0.1, 0, h - 0.06, 0, P.steel_dark, M.metal, { collide = false })
	end
	Registry.register("storage_rack", rack)
	Registry.register("storage_rack_large", rack)
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000048"><Properties><string name="Name">Kitchen</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Kitchen equipment: shelves, neta case, rice cookers, broth pots, stations, sink, dishwasher, fridge.
-- Functional points (on Root): SlotN parts (shelves), Board/Plate/Tool attachments (stations).
local Kit = require(script.Parent.Parent.Kit)
local P = require(script.Parent.Parent.Palette)
local M = P.M

local function size(item)
	return Vector3.new(item.size[1], item.size[2], item.size[3])
end

local function point(root, name, x, y, z, yaw)
	local h = root.Size.Y
	return Kit.attach(root, name, CFrame.new(x, y - h / 2, z) * CFrame.Angles(0, math.rad(yaw or 0), 0))
end

-- Invisible clickable slot volume
local function slot(m, index, sx, sy, sz, x, y, z)
	local p = Kit.box(m, sx, sy, sz, x, y, z, P.white, M.smooth, { transparency = 1, collide = false, shadow = false, name = "Slot" .. index })
	p.CanQuery = true
	p:SetAttribute("Slot", index)
	return p
end

local NC = { collide = false, shadow = false }
local function nc()
	return { collide = false, shadow = false }
end
local JP_FONT = Font.new("rbxasset://fonts/families/FredokaOne.json", Enum.FontWeight.Bold)

-- Steel (or wooden) work cabinet: recessed kick plate, framed doors with bar handles,
-- thick top with a front lip. The cook side is -Z.
local function cabinet(m, w, h, d, top, body, wood)
	local bodyColor = body or P.metal
	local mat = wood and M.wood or M.metal
	Kit.box(m, w - 0.24, 0.35, d - 0.3, 0, 0.175, 0.05, P.charcoal, M.smooth)
	Kit.box(m, w, h - 0.55, d, 0, 0.35 + (h - 0.55) / 2, 0, bodyColor, mat)
	Kit.box(m, w + 0.08, 0.2, d + 0.1, 0, h - 0.1, 0.02, top or P.metal, wood and M.wood or M.metal, { reflectance = wood and 0 or 0.12 })
	Kit.box(m, w + 0.08, 0.08, 0.1, 0, h + 0.02, -d / 2 - 0.02, top or P.metal, M.metal, nc())
	local doors = math.max(1, math.floor(w / 1.6))
	local dw = w / doors
	for i = 0, doors - 1 do
		local x = -w / 2 + dw * (i + 0.5)
		local doorH = h - 1.1
		local cy = 0.4 + doorH / 2
		Kit.box(m, dw - 0.18, doorH, 0.05, x, cy, -d / 2 - 0.025, wood and P.wood or P.steel, mat, nc())
		Kit.box(m, dw - 0.42, doorH - 0.3, 0.03, x, cy, -d / 2 - 0.06, wood and P.wood_light or P.metal, mat, nc())
		local hx = x + (i % 2 == 0 and (dw / 2 - 0.35) or -(dw / 2 - 0.35))
		Kit.box(m, 0.07, 0.9, 0.07, hx, cy + 0.3, -d / 2 - 0.13, P.steel_dark, M.metal, nc())
	end
end

-- Small wooden name plate with kanji on the cook side of a station
local function plate(m, x, y, z, text)
	local p = Kit.box(m, 1.0, 0.45, 0.06, x, y, z, P.hinoki, M.wood, nc())
	Kit.text(p, Enum.NormalId.Front, text, { color = "#2B2320", font = JP_FONT, pps = 40 })
	return p
end

local function knobs(m, n, x0, y, z)
	for i = 0, n - 1 do
		Kit.cylH(m, 0.22, 0.12, x0 + i * 0.4, y, z, P.charcoal, M.smooth, nc(), "z")
		Kit.box(m, 0.04, 0.12, 0.04, x0 + i * 0.4, y + 0.05, z - 0.07, P.neon_red, M.smooth, nc())
	end
end

-- Extraction hood with a duct to the ceiling (over hot stations)
local function hood(m, w, h, d)
	-- high and shallow so it never hides the board from the game camera
	local y = h + 5.2
	local hd = 1.5
	local hz = d / 2 - hd / 2
	Kit.box(m, w - 0.8, 0.7, hd, 0, y, hz, P.metal, M.metal, { collide = false, reflectance = 0.15 })
	Kit.wedge(m, w - 0.8, 0.5, hd, CFrame.new(0, y + 0.6, hz) * CFrame.Angles(0, math.rad(180), 0), P.metal, M.metal, nc())
	Kit.box(m, w - 0.9, 0.06, hd - 0.1, 0, y - 0.36, hz, P.steel_dark, M.metal, nc())
	Kit.box(m, 0.8, 13.9 - (y + 0.85), 0.8, 0, (y + 0.85 + 13.9) / 2, d / 2 - 0.45, P.metal, M.metal, nc())
	local light = Kit.box(m, w - 1.6, 0.05, 0.3, 0, y - 0.38, hz - 0.4, P.lamp, M.neon, nc())
	Kit.light(light, "Surface", P.lamp, 8, 0.8, { face = Enum.NormalId.Bottom, night = false })
end

-- Backsplash with a narrow shelf (back = +Z)
local function backsplash(m, w, h, d, tiles)
	Kit.box(m, w, 1.0, 0.1, 0, h + 0.5, d / 2 - 0.05, tiles and P.white or P.metal, tiles and M.tiles or M.metal, nc())
	Kit.box(m, w, 0.08, 0.35, 0, h + 1.04, d / 2 - 0.2, P.metal, M.metal, nc())
end

-- Fitted kitchen: every back-line module (rice cooker, range, worktop, sink) shares this base:
-- wooden drawers and doors, a stainless worktop and white tiles up to RUN_TOP with a wooden ledge,
-- so modules placed side by side read as one long kitchen unit. Back = +Z.
-- opts: oven (range door instead of cupboards), noDrawers, cutout = { x0, x1, z0, z1 } (hole in
-- the worktop for basins; the cabinet stops lower so the basins are open)
local RUN_TOP = 4.6
local function fittedBase(m, w, h, d, opts)
	opts = opts or {}
	local cut = opts.cutout
	local carcassTop = cut and (h - 0.8) or (h - 0.2)
	Kit.box(m, w, 0.3, d - 0.3, 0, 0.15, 0.08, P.charcoal, M.smooth)
	Kit.box(m, w, carcassTop - 0.3, d - 0.1, 0, 0.3 + (carcassTop - 0.3) / 2, 0.05, P.wood_dark, M.wood)
	if cut then
		-- apron and sides around the basins
		Kit.box(m, w, h - 0.2 - carcassTop, 0.12, 0, (carcassTop + h - 0.2) / 2, -d / 2 + 0.11, P.wood_dark, M.wood)
		Kit.box(m, w, h - 0.2 - carcassTop, 0.12, 0, (carcassTop + h - 0.2) / 2, d / 2 - 0.06, P.wood_dark, M.wood)
		for _, sx in ipairs({ -1, 1 }) do
			Kit.box(m, 0.12, h - 0.2 - carcassTop, d - 0.1, sx * (w / 2 - 0.06), (carcassTop + h - 0.2) / 2, 0.05, P.wood_dark, M.wood)
		end
		-- worktop in four strips around the hole
		local x0, x1, z0, z1 = cut[1], cut[2], cut[3], cut[4]
		local top = { reflectance = 0.12 }
		Kit.box(m, x0 + w / 2 + 0.01, 0.18, d + 0.04, (-w / 2 - 0.01 + x0) / 2, h - 0.09, -0.02, P.metal, M.metal, top)
		Kit.box(m, w / 2 + 0.01 - x1, 0.18, d + 0.04, (x1 + w / 2 + 0.01) / 2, h - 0.09, -0.02, P.metal, M.metal, top)
		Kit.box(m, x1 - x0, 0.18, z0 + d / 2 + 0.02, (x0 + x1) / 2, h - 0.09, (-d / 2 - 0.04 + z0) / 2, P.metal, M.metal, top)
		Kit.box(m, x1 - x0, 0.18, d / 2 - z1, (x0 + x1) / 2, h - 0.09, (z1 + d / 2) / 2, P.metal, M.metal, top)
	else
		Kit.box(m, w + 0.02, 0.18, d + 0.04, 0, h - 0.09, -0.02, P.metal, M.metal, { reflectance = 0.12 })
	end
	Kit.box(m, w + 0.02, 0.06, 0.08, 0, h - 0.2, -d / 2 - 0.02, P.steel, M.metal, nc())
	-- fronts: drawers on top, doors (or the oven door of the range) below
	local front = -d / 2 + 0.02
	local drawerH = 0.55
	local noDrawers = opts.noDrawers or cut ~= nil
	local doorTop = h - 0.2 - (noDrawers and 0.1 or drawerH + 0.05)
	if not noDrawers then
		local nd = math.max(1, math.floor(w / 1.3))
		local dw = w / nd
		for i = 0, nd - 1 do
			local x = -w / 2 + dw * (i + 0.5)
			Kit.box(m, dw - 0.1, drawerH - 0.08, 0.06, x, h - 0.2 - drawerH / 2, front - 0.03, P.wood, M.wood, nc())
			Kit.box(m, math.min(0.6, dw - 0.5), 0.06, 0.06, x, h - 0.2 - drawerH / 2, front - 0.09, P.brass, M.metal, nc())
		end
	end
	if opts.oven then
		Kit.box(m, w - 0.3, doorTop - 0.45, 0.06, 0, 0.35 + (doorTop - 0.45) / 2, front - 0.03, P.steel, M.metal, nc({ reflectance = 0.1 }))
		Kit.box(m, w - 1.1, (doorTop - 0.45) * 0.42, 0.04, 0, 0.35 + (doorTop - 0.45) * 0.5, front - 0.07, P.charcoal, M.glass, nc({ transparency = 0.15 }))
		Kit.cylH(m, 0.08, w - 0.9, 0, doorTop - 0.3, front - 0.17, P.metal, M.metal, nc(), "x")
	else
		local doors = math.max(1, math.floor(w / 1.3))
		local dw = w / doors
		local hgt = doorTop - 0.4
		local cy = 0.35 + hgt / 2
		for i = 0, doors - 1 do
			local x = -w / 2 + dw * (i + 0.5)
			Kit.box(m, dw - 0.1, hgt, 0.06, x, cy, front - 0.03, P.wood, M.wood, nc())
			Kit.box(m, dw - 0.42, hgt - 0.35, 0.03, x, cy, front - 0.075, P.wood_light, M.wood, nc())
			local hx = x + (i % 2 == 0 and (dw / 2 - 0.25) or -(dw / 2 - 0.25))
			Kit.box(m, 0.06, 0.6, 0.06, hx, cy + hgt / 2 - 0.45, front - 0.12, P.brass, M.metal, nc())
		end
	end
	-- white tiles up to the shared line, a wooden ledge on top
	local bs = RUN_TOP - h
	Kit.box(m, w, bs, 0.1, 0, h + bs / 2, d / 2 - 0.05, P.white, M.tiles, nc())
	Kit.box(m, w + 0.02, 0.1, 0.4, 0, RUN_TOP + 0.05, d / 2 - 0.2, P.wood_dark, M.wood, nc())
end

-- Utensil rail with hanging tools
local function utensilRail(m, w, h, d, tools)
	local y = h + 1.6
	local z = d / 2 - 0.15
	Kit.cylH(m, 0.06, w - 0.6, 0, y, z, P.metal, M.metal, nc())
	local n = #tools
	for i, t in ipairs(tools) do
		local x = -w / 2 + 0.6 + (w - 1.2) * (i - 0.5) / n
		Kit.cyl(m, 0.04, 0.9, x, y - 0.45, z, P.metal, M.metal, nc())
		if t == "ladle" then
			Kit.blob(m, 0.35, 0.18, 0.35, x, y - 0.95, z - 0.05, P.metal, M.metal, nc())
		elseif t == "strainer" then
			Kit.cyl(m, 0.42, 0.06, x, y - 0.95, z - 0.1, P.steel, M.metal, { collide = false, shadow = false, rot = CFrame.Angles(math.rad(80), 0, 0) })
		elseif t == "spatula" then
			Kit.box(m, 0.35, 0.3, 0.03, x, y - 0.95, z - 0.03, P.metal, M.metal, nc())
		elseif t == "towel" then
			Kit.box(m, 0.5, 0.8, 0.04, x, y - 0.4, z - 0.05, P.white, M.fabric, nc())
			Kit.box(m, 0.5, 0.1, 0.045, x, y - 0.55, z - 0.05, P.indigo, M.fabric, nc())
		end
	end
end

local function bowlStack(m, x, z, y0, n, color)
	for i = 0, n - 1 do
		Kit.cyl(m, 0.7, 0.14, x, y0 + 0.07 + i * 0.15, z, color, M.smooth, nc())
		Kit.cyl(m, 0.72, 0.03, x, y0 + 0.14 + i * 0.15, z, P.lacquer, M.smooth, nc())
	end
end

local function pan(m, x, z, y0, color)
	Kit.box(m, 0.42, 0.14, 0.42, x, y0 + 0.07, z, P.metal, M.metal, nc())
	Kit.box(m, 0.36, 0.05, 0.36, x, y0 + 0.13, z, color, M.smooth, nc())
end

-- Shelf looks (fn.style): frame, back, boards, crown, header kanji and extras
local SHELF_STYLES = {
	wood = { frame = P.wood_dark, back = P.hinoki, board = P.wood_light, crown = P.wood_black, sign = "食材" },
	tall = { frame = P.wood, back = P.hinoki, board = P.wood_light, crown = P.wood_dark, sign = "食材", noren = true },
	bamboo = { frame = P.bamboo, back = P.cream, board = P.bamboo, crown = P.lacquer, sign = "市場", lanterns = true },
	lacquer = { frame = P.wood_black, back = P.lacquer_dark, board = P.wood_dark, crown = P.wood_black, sign = "極上", trim = P.gold, lights = true },
}

local function shelfUnit(m, item)
	local root = Kit.finish(m, size(item))
	local w, h, d = item.size[1], item.size[2], item.size[3]
	local slots = item.fn.slots
	local cols = item.fn.cols or (slots > 4 and 2 or 1)
	local rows = math.ceil(slots / cols)
	local st = SHELF_STYLES[item.fn.style or "wood"] or SHELF_STYLES.wood
	-- frame: posts on feet and a back panel
	Kit.box(m, w, h, 0.12, 0, h / 2, d / 2 - 0.06, st.frame, M.planks)
	local dk = Kit.detail(m, "kitchen")
	Kit.box(m, w - 0.4, h - 0.3, 0.03, 0, h / 2, d / 2 - 0.135, st.back, M.planks, nc())
	for _, x in ipairs({ -w / 2 + 0.1, w / 2 - 0.1 }) do
		Kit.box(m, 0.2, h, d, x, h / 2, 0, st.frame, M.wood)
		Kit.box(m, 0.28, 0.12, d + 0.08, x, 0.06, 0, P.wood_black, M.wood, nc())
		for _, y in ipairs({ 0.55, h - 0.55 }) do
			Kit.box(dk, 0.24, 0.3, 0.03, x, y, -d / 2 - 0.015, P.charcoal, M.metal, nc())
			Kit.ball(dk, 0.07, x, y, -d / 2 - 0.04, P.brass, M.metal, nc())
		end
	end
	-- dividers between columns
	for c = 1, cols - 1 do
		local x = -w / 2 + 0.15 + (w - 0.3) * c / cols
		Kit.box(m, 0.14, h, d, x, h / 2, 0, st.frame, M.wood)
	end
	local rowH = (h - 0.3) / rows
	local idx = 0
	for r = 0, rows - 1 do
		local y = 0.15 + r * rowH
		Kit.box(m, w - 0.2, 0.12, d, 0, y, 0, st.board, M.wood)
		Kit.box(m, w - 0.3, 0.16, 0.05, 0, y + 0.02, -d / 2 - 0.02, st.trim or P.wood_dark, st.trim and M.metal or M.wood, nc())
		if st.lights and r > 0 then
			-- warm strip under each board lights the products below
			Kit.box(m, w - 0.5, 0.04, 0.08, 0, y - 0.08, -d / 2 + 0.3, P.lamp_warm, M.neon, nc())
		end
		for c = 0, cols - 1 do
			idx += 1
			if idx <= slots then
				local cw = (w - 0.3) / cols
				local x = -w / 2 + 0.15 + cw * (c + 0.5)
				local s = slot(m, idx, cw - 0.1, rowH - 0.2, d - 0.1, x, y + 0.06 + (rowH - 0.2) / 2, 0)
				s:SetAttribute("Width", cw - 0.2)
				-- the paper tag on the lip is drawn by each client in its language (ShelfTags)
			end
		end
	end
	-- crown with a kanji header board
	Kit.box(m, w + 0.2, 0.18, d + 0.15, 0, h - 0.06, -0.02, st.crown, M.wood)
	if st.trim then
		Kit.box(m, w + 0.22, 0.05, d + 0.17, 0, h + 0.04, -0.02, st.trim, M.metal, nc())
	end
	local sign = Kit.box(m, math.min(2.4, w - 0.8), 0.6, 0.08, 0, h + 0.4, -d / 2 + 0.2, st.trim and P.wood_black or P.hinoki, M.wood, nc())
	Kit.text(sign, Enum.NormalId.Front, st.sign, { color = st.trim and "#D4A23C" or "#2B2320", font = JP_FONT, pps = 40 })
	if st.noren then
		-- short split curtain hanging from the crown
		for k = 0, 3 do
			local x = -w / 2 + 0.4 + (w - 0.8) * (k + 0.5) / 4
			local cloth = Kit.box(m, (w - 0.8) / 4 - 0.08, 0.7, 0.03, x, h - 0.5, -d / 2 - 0.05, P.indigo, M.fabric, nc())
			cloth:SetAttribute("Animate", "sway")
		end
	end
	if st.lanterns then
		-- two small red lanterns on the sides of the header
		for _, sx in ipairs({ -1, 1 }) do
			local lx = sx * (w / 2 - 0.5)
			Kit.cyl(m, 0.05, 0.3, lx, h + 0.35, -d / 2 + 0.25, P.wood_black, M.wood, nc())
			local lamp = Kit.blob(m, 0.5, 0.6, 0.5, lx, h + 0.05, -d / 2 + 0.25, P.lacquer, M.fabric, nc())
			Kit.light(lamp, "Point", P.lamp_warm, 8, 0.6)
		end
	end
end

local function riceCooker(m, item, pro)
	local root = Kit.finish(m, size(item))
	local w, d = item.size[1], item.size[3]
	local standH = 3.5
	-- a module of the fitted kitchen, the cooker on its worktop
	fittedBase(m, w, standH, d)
	local dk = Kit.detail(m, "kitchen")
	local label = Kit.box(dk, 0.8, 0.34, 0.03, 0, standH - 0.85, -d / 2 - 0.08, P.paper, M.smooth, nc())
	Kit.text(label, Enum.NormalId.Front, "炊飯", { color = "#2B2320", font = JP_FONT, pps = 40 })
	-- cooker body with side handles, lid, steam vent and control panel
	local r = math.min(w, d) - (pro and 0.5 or 0.7)
	local body = Kit.cyl(m, r, 1.0, 0, standH + 0.5, 0, pro and P.metal or P.white, pro and M.metal or M.smooth, { name = "Body", reflectance = pro and 0.12 or 0 })
	Kit.cyl(m, r + 0.04, 0.08, 0, standH + 0.12, 0, P.charcoal, M.smooth, nc())
	Kit.cyl(dk, r + 0.04, 0.05, 0, standH + 0.98, 0, pro and P.steel or P.sakura_dark, M.smooth, nc())
	for _, sx in ipairs({ -1, 1 }) do
		Kit.box(dk, 0.12, 0.1, 0.5, sx * (r / 2 + 0.04), standH + 0.85, 0, P.charcoal, M.smooth, nc())
	end
	Kit.blob(m, r - 0.05, 0.35, r - 0.05, 0, standH + 1.05, 0, pro and P.steel or P.porcelain, M.smooth, nc())
	Kit.box(m, 0.5, 0.12, 0.1, 0, standH + 1.25, -0.25, P.charcoal, M.smooth, nc())
	Kit.cyl(m, 0.16, 0.08, 0, standH + 1.24, 0.15, P.steel_dark, M.metal, nc())
	local panel = Kit.box(m, 0.6, 0.3, 0.06, 0, standH + 0.55, -r / 2 - 0.02, P.charcoal, M.smooth, nc())
	Kit.box(m, 0.42, 0.08, 0.03, -0.05, standH + 0.6, -r / 2 - 0.06, P.neon_blue, M.neon, nc())
	local led = Kit.box(m, 0.12, 0.12, 0.04, 0.15, standH + 0.48, -r / 2 - 0.06, P.neon_red, M.neon, { collide = false, name = "Led" })
	local _ = panel
	local _2 = led
	-- rice paddle (shamoji) in its holder
	Kit.cyl(dk, 0.16, 0.4, r / 2 + 0.12, standH + 0.55, -0.2, P.white, M.smooth, nc())
	Kit.box(dk, 0.08, 0.6, 0.04, r / 2 + 0.12, standH + 0.8, -0.2, P.hinoki, M.wood, nc())
	Kit.blob(dk, 0.24, 0.3, 0.06, r / 2 + 0.12, standH + 1.15, -0.2, P.hinoki, M.wood, nc())
	local vent = Kit.box(m, 0.2, 0.1, 0.2, 0, standH + 1.3, 0.15, P.white, M.smooth, { transparency = 1, collide = false, name = "Steam" })
	Kit.particles(vent, "steam", { enabled = false })
	local _3 = body
	point(root, "Content", 0, standH + 1.1, 0)
end

-- Gas range of the fitted kitchen: oven door and knobs, black cooktop with two burners, the big
-- stock pot on the main one and a small saucepan on the other, hood above
local function brothPot(m, item, large)
	local root = Kit.finish(m, size(item))
	local w, d = item.size[1], item.size[3]
	local stoveH = 3.0
	fittedBase(m, w, stoveH, d, { oven = true, noDrawers = true })
	local dk = Kit.detail(m, "kitchen")
	knobs(m, 4, -0.6, stoveH - 0.35, -d / 2 - 0.08)
	plate(dk, w / 2 - 0.7, stoveH + 1.0, d / 2 - 0.12, "出汁")
	Kit.box(m, w - 0.1, 0.06, d - 0.2, 0, stoveH + 0.03, -0.05, P.charcoal, M.metal, nc())
	local dPot = large and 2.3 or 1.9
	local potH = large and 1.45 or 1.2
	local px = -w / 2 + dPot / 2 + 0.2
	-- main burner: blue flame ring (lit while cooking) and a cast iron grate
	Kit.cyl(m, dPot * 0.55, 0.05, px, stoveH + 0.08, 0, P.neon_blue, M.neon, { collide = false, name = "Flame" })
	Kit.cyl(m, dPot * 0.3, 0.07, px, stoveH + 0.09, 0, P.charcoal, M.metal, nc())
	for i = 0, 3 do
		Kit.box(m, dPot * 0.95, 0.07, 0.09, px, stoveH + 0.13, 0, P.charcoal, M.metal, { collide = false, shadow = false, rot = CFrame.Angles(0, math.rad(i * 45), 0) })
	end
	-- the stock pot
	local y0 = stoveH + 0.16
	Kit.cyl(m, dPot, potH, px, y0 + potH / 2, 0, P.metal, M.metal, { reflectance = 0.15, name = "Body" })
	for _, y in ipairs({ 0.3, potH - 0.35 }) do
		Kit.cyl(dk, dPot + 0.05, 0.06, px, y0 + y, 0, P.steel, M.metal, nc())
	end
	Kit.cyl(m, dPot + 0.1, 0.1, px, y0 + potH, 0, P.steel, M.metal, { collide = false })
	local broth = Kit.cyl(m, dPot - 0.15, 0.06, px, y0 + potH - 0.12, 0, P.wood, M.smooth, { collide = false, name = "Broth", transparency = 1 })
	broth:SetAttribute("Fill", true)
	for _, sx in ipairs({ -1, 1 }) do
		Kit.box(m, 0.28, 0.1, 0.55, px + sx * (dPot / 2 + 0.12), y0 + potH - 0.25, 0, P.steel_dark, M.metal, { collide = false })
	end
	-- long ladle resting in the pot
	Kit.cyl(m, 0.08, 1.9, px + dPot / 4, y0 + potH + 0.4, 0, P.metal, M.metal, { collide = false, rot = CFrame.Angles(0, 0, math.rad(25)) })
	Kit.cyl(m, 0.1, 0.4, px + dPot / 4 - 0.45, y0 + potH + 1.2, 0, P.wood_dark, M.wood, { collide = false, rot = CFrame.Angles(0, 0, math.rad(25)) })
	local vent = Kit.box(m, dPot - 0.4, 0.1, dPot - 0.4, px, y0 + potH + 0.15, 0, P.white, M.smooth, { transparency = 1, collide = false, name = "Steam" })
	Kit.particles(vent, "steam", { enabled = false, rate = large and 10 or 6 })
	Kit.particles(broth, "bubbles", { enabled = false })
	-- second burner with a small saucepan
	local sx2 = w / 2 - 0.65
	Kit.cyl(m, 0.7, 0.05, sx2, stoveH + 0.08, 0.15, P.charcoal, M.metal, nc())
	Kit.cyl(dk, 0.9, 0.45, sx2, stoveH + 0.35, 0.15, P.copper, M.metal, nc({ reflectance = 0.1 }))
	Kit.box(dk, 0.7, 0.08, 0.1, sx2, stoveH + 0.5, -0.55, P.wood_dark, M.wood, nc())
	-- hood low enough to frame the range in first person, still above your head
	hood(m, w, stoveH - 1.4, d)
	point(root, "Content", px, y0 + potH, 0)
end

-- Work station: cabinet with the board area (-x), the plate spot (+x) and a tool hovering point.
-- opts: { wood = bool, hood = bool, plate = "寿司", tools = {...}, tiles = bool, knobs = n }
local function station(m, item, deco, opts)
	opts = opts or {}
	local root = Kit.finish(m, size(item))
	local w, h, d = item.size[1], item.size[2], item.size[3]
	-- plain steel cabinet; the "chef gear" renovation (Detail_kitchen) adds the wooden sushi
	-- counter front, backsplash, utensil rail, kanji plate and the small props of each station
	local dk = Kit.detail(m, "kitchen")
	cabinet(m, w, h, d, P.metal, P.metal, false)
	if opts.wood then
		Kit.box(dk, w + 0.1, h - 0.6, 0.06, 0, 0.35 + (h - 0.55) / 2, -d / 2 - 0.16, P.wood_dark, M.wood, nc())
		for i = 0, math.floor(w / 0.45) do
			Kit.box(dk, 0.1, h - 0.8, 0.06, -w / 2 + 0.2 + i * 0.45, 0.35 + (h - 0.55) / 2, -d / 2 - 0.21, P.wood, M.wood, nc())
		end
		Kit.box(dk, w + 0.1, 0.06, d + 0.12, 0, h + 0.03, 0.02, P.hinoki, M.wood, nc())
	end
	backsplash(dk, w, h, d, opts.tiles)
	if opts.tools then
		utensilRail(dk, w, h, d, opts.tools)
	end
	if opts.hood then
		hood(m, w, h, d)
	end
	if opts.knobs then
		knobs(m, opts.knobs, -0.4 * (opts.knobs - 1) / 2, h - 0.45, -d / 2 - 0.08)
	end
	if opts.plate then
		plate(dk, w / 2 - 0.8, h - 0.75, -d / 2 - 0.12, opts.plate)
	end
	local boardX = -w / 2 + 1.4
	local plateX = w / 2 - 0.9
	deco(m, w, h, d, boardX, plateX, dk)
	point(root, "Board", boardX, h + 0.1, 0.05)
	point(root, "Plate", plateX, h + 0.05, 0.1)
	point(root, "Tool", boardX, h + 1.2, -0.1)
	point(root, "Cook", 0, 0, -d / 2 - 1.3, 0)
end

return function(Registry)
	Registry.register("shelf_small", shelfUnit)
	Registry.register("shelf_large", shelfUnit)
	Registry.register("shelf_tall", shelfUnit)
	Registry.register("shelf_market", shelfUnit)
	Registry.register("shelf_deluxe", shelfUnit)

	Registry.register("neta_case", function(m, item)
		local root = Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		local baseH = 2.1
		Kit.box(m, w, baseH, d, 0, baseH / 2, 0, P.wood_dark, M.wood)
		Kit.box(m, w + 0.05, 0.12, d + 0.05, 0, baseH + 0.06, 0, P.hinoki, M.wood)
		local caseH = h - baseH - 0.12
		Kit.box(m, w - 0.1, 0.06, d - 0.5, 0, baseH + 0.15, 0.1, P.white, M.smooth, { collide = false })
		Kit.box(m, w, caseH, 0.08, 0, baseH + 0.12 + caseH / 2, d / 2 - 0.25, P.glass, M.glass, { transparency = 0.6 })
		Kit.wedge(m, w, caseH, 1.2, CFrame.new(0, baseH + 0.12 + caseH / 2, -d / 2 + 0.85) * CFrame.Angles(0, math.rad(180), 0), P.glass, M.glass, { transparency = 0.65, collide = false })
		Kit.box(m, w, 0.08, 1.7, 0, baseH + 0.12 + caseH, 0.4, P.steel, M.metal, { collide = false })
		local lightBar = Kit.box(m, w - 0.3, 0.05, 0.2, 0, baseH + 0.08 + caseH, 0.4, P.white, M.neon, { collide = false })
		Kit.light(lightBar, "Surface", P.white, 6, 1.2, { face = Enum.NormalId.Bottom, night = false })
		for i = 1, 4 do
			local x = -w / 2 + w / 4 * (i - 0.5)
			slot(m, i, w / 4 - 0.1, caseH - 0.1, d - 0.4, x, baseH + 0.12 + caseH / 2, 0.1):SetAttribute("Width", w / 4 - 0.3)
		end
		-- ice bed
		Kit.box(m, w - 0.2, 0.1, d - 0.6, 0, baseH + 0.2, 0.1, P.glass, M.glass, { collide = false, transparency = 0.2 })
	end)

	Registry.register("rice_cooker", function(m, item)
		riceCooker(m, item, false)
	end)
	Registry.register("rice_cooker_pro", function(m, item)
		riceCooker(m, item, true)
	end)
	Registry.register("broth_pot", function(m, item)
		brothPot(m, item, false)
	end)
	Registry.register("broth_pot_large", function(m, item)
		brothPot(m, item, true)
	end)

	Registry.register("sushi_station", function(m, item)
		station(m, item, function(model, w, h, d, boardX, plateX, extra)
			-- hinoki board with a yanagiba knife and a wet cloth
			Kit.box(model, 2.0, 0.18, 1.5, boardX, h + 0.09, 0.05, P.hinoki, M.wood)
			Kit.box(model, 1.9, 0.02, 1.4, boardX, h + 0.185, 0.05, P.paper_warm, M.wood, nc())
			Kit.box(extra, 1.2, 0.02, 0.12, boardX + 0.2, h + 0.2, -0.62, P.metal, M.metal, { collide = false, shadow = false, reflectance = 0.3 })
			Kit.box(extra, 0.45, 0.06, 0.1, boardX - 0.6, h + 0.2, -0.62, P.wood_black, M.wood, nc())
			-- hangiri rice tub with shamoji paddle
			local tx, tz = boardX + 1.5, 0.72
			Kit.cyl(extra, 1.1, 0.36, tx, h + 0.18, tz, P.hinoki, M.wood, nc())
			Kit.cyl(extra, 1.14, 0.06, tx, h + 0.1, tz, P.copper, M.metal, nc())
			Kit.cyl(extra, 1.14, 0.06, tx, h + 0.3, tz, P.copper, M.metal, nc())
			Kit.blob(extra, 0.9, 0.25, 0.9, tx, h + 0.36, tz, P.rice, M.sand, nc())
			Kit.box(extra, 0.18, 0.04, 0.8, tx + 0.25, h + 0.48, tz - 0.1, P.wood_light, M.wood, { collide = false, shadow = false, rot = CFrame.Angles(math.rad(-12), math.rad(25), 0) })
			-- small dishes: wasabi and pickled ginger, water bowl (tezu)
			Kit.cyl(extra, 0.4, 0.06, plateX - 0.75, h + 0.03, -0.65, P.porcelain, M.smooth, nc())
			Kit.blob(extra, 0.2, 0.12, 0.2, plateX - 0.75, h + 0.1, -0.65, P.matcha, M.smooth, nc())
			Kit.cyl(extra, 0.4, 0.06, plateX - 0.3, h + 0.03, -0.65, P.porcelain, M.smooth, nc())
			Kit.blob(extra, 0.24, 0.1, 0.24, plateX - 0.3, h + 0.09, -0.65, P.sakura, M.smooth, nc())
			Kit.cyl(extra, 0.5, 0.25, boardX - 0.95, h + 0.13, 0.65, P.indigo, M.smooth, nc())
			Kit.cyl(extra, 0.44, 0.02, boardX - 0.95, h + 0.24, 0.65, P.water, M.glass, { collide = false, shadow = false, transparency = 0.3 })
			-- geta plate for the finished dish and a stack of spare plates
			Kit.box(model, 1.4, 0.12, 0.8, plateX, h + 0.06, 0.1, P.wood_light, M.wood, nc())
			for _, sx in ipairs({ -0.55, 0.55 }) do
				Kit.box(model, 0.12, 0.08, 0.8, plateX + sx, h + 0.0, 0.1, P.wood_light, M.wood, nc())
			end
			for i = 0, 3 do
				Kit.box(extra, 0.9, 0.06, 0.5, plateX + 0.15, h + 1.1 + i * 0.07, d / 2 - 0.2, P.wood_light, M.wood, nc())
			end
			-- rolled makisu and bamboo leaves on the shelf
			Kit.cylH(extra, 0.22, 0.9, -0.9, h + 1.2, d / 2 - 0.2, P.bamboo, M.wood, nc())
			for i = 0, 2 do
				Kit.blob(extra, 0.7, 0.03, 0.22, -2 + i * 0.25, h + 1.12, d / 2 - 0.22, P.leaf, M.leafy, { collide = false, shadow = false, rot = CFrame.Angles(0, math.rad(i * 20), 0) })
			end
			Kit.cyl(extra, 0.2, 0.45, 1.2, h + 1.3, d / 2 - 0.2, P.charcoal, M.smooth, nc())
			Kit.cyl(extra, 0.22, 0.06, 1.2, h + 1.55, d / 2 - 0.2, P.lacquer, M.smooth, nc())
		end, { wood = true, plate = "寿司", tools = { "towel", "ladle" } })
	end)

	Registry.register("ramen_station", function(m, item)
		station(m, item, function(model, w, h, d, boardX, plateX, extra)
			-- noodle boiler with four tebo baskets
			local bx = boardX - 0.3
			Kit.box(model, 1.9, 0.6, 1.5, bx, h + 0.3, 0.05, P.steel_dark, M.metal)
			local water = Kit.box(model, 1.7, 0.05, 1.3, bx, h + 0.6, 0.05, P.water, M.glass, { collide = false, transparency = 0.3, name = "Water" })
			Kit.particles(water, "steam", { rate = 3 })
			for _, c in ipairs({ { -0.45, -0.3 }, { 0.45, -0.3 }, { -0.45, 0.35 }, { 0.45, 0.35 } }) do
				Kit.cyl(model, 0.5, 0.5, bx + c[1], h + 0.65, 0.05 + c[2], P.metal, M.metal, { collide = false, transparency = 0.2 })
				Kit.cylH(model, 0.06, 0.9, bx + c[1], h + 1.0, 0.05 + c[2] - 0.55, P.wood_dark, M.wood, nc(), "z")
			end
			-- bowl for the finished dish on a wooden tray
			Kit.box(model, 1.5, 0.12, 1.2, plateX - 0.1, h + 0.06, 0.1, P.wood_light, M.wood, nc())
			-- topping pans: scallion, naruto, chashu, corn, egg
			local colors = { P.leaf_light, P.sakura, P.copper, P.neon_yellow }
			for i, c in ipairs(colors) do
				pan(extra, -0.2 + (i - 1) * 0.44, -0.72, h, c)
			end
			-- tare pots and bowl stacks on the back shelf
			for i = 0, 2 do
				Kit.cyl(extra, 0.38, 0.4, -1.8 + i * 0.5, h + 1.3, d / 2 - 0.2, P.metal, M.metal, nc())
				Kit.cyl(extra, 0.32, 0.03, -1.8 + i * 0.5, h + 1.51, d / 2 - 0.2, ({ P.wood, P.cream, P.copper })[i + 1], M.smooth, nc())
			end
			bowlStack(extra, 0.6, d / 2 - 0.25, h + 1.08, 4, P.charcoal)
			bowlStack(extra, 1.4, d / 2 - 0.25, h + 1.08, 4, P.lacquer_dark)
		end, { hood = true, plate = "麺", tools = { "ladle", "ladle", "strainer", "towel" }, tiles = true, knobs = 3 })
	end)

	Registry.register("drink_station", function(m, item)
		station(m, item, function(model, w, h, d, boardX, plateX, extra)
			-- tea urn with a tap
			Kit.cyl(model, 0.9, 1.3, boardX - 0.3, h + 0.65, 0.35, P.metal, M.metal, { reflectance = 0.15 })
			Kit.cyl(model, 0.95, 0.12, boardX - 0.3, h + 1.32, 0.35, P.steel_dark, M.metal, nc())
			Kit.box(model, 0.18, 0.18, 0.35, boardX - 0.3, h + 0.35, -0.2, P.charcoal, M.smooth, nc())
			-- ramune bottles in an ice bucket
			Kit.cyl(extra, 0.8, 0.5, boardX + 0.75, h + 0.25, 0.45, P.metal, M.metal, nc())
			Kit.cyl(extra, 0.7, 0.05, boardX + 0.75, h + 0.48, 0.45, P.glass, M.glass, { collide = false, shadow = false, transparency = 0.2 })
			for i = 0, 3 do
				local a = i * math.pi / 2
				Kit.cyl(extra, 0.16, 0.5, boardX + 0.75 + math.cos(a) * 0.18, h + 0.6, 0.45 + math.sin(a) * 0.18, P.glass, M.glass, { collide = false, shadow = false, transparency = 0.25 })
			end
			-- matcha bowl and whisk, cups
			Kit.cyl(extra, 0.5, 0.22, boardX + 0.2, h + 0.11, -0.55, P.stone_dark, M.smooth, nc())
			Kit.cyl(extra, 0.42, 0.02, boardX + 0.2, h + 0.21, -0.55, P.matcha, M.smooth, nc())
			Kit.cyl(extra, 0.2, 0.3, boardX + 0.75, h + 0.15, -0.55, P.bamboo, M.wood, nc())
			for i = 0, 3 do
				Kit.cyl(extra, 0.3, 0.32, -0.2 + i * 0.36, h + 1.25, d / 2 - 0.2, P.porcelain, M.smooth, nc())
			end
			Kit.box(model, 1.2, 0.08, 0.8, plateX, h + 0.04, 0.1, P.wood_dark, M.wood, nc())
		end, { plate = "茶", tools = { "towel" } })
	end)

	Registry.register("griddle", function(m, item)
		station(m, item, function(model, w, h, d, boardX, plateX, extra)
			Kit.box(model, 2.6, 0.12, 1.6, boardX + 0.1, h + 0.06, 0.05, P.charcoal, M.metal, { reflectance = 0.05 })
			for _, e in ipairs({ { 0, 0.82, 2.6, 0.06 }, { -1.27, 0, 0.06, 1.6 }, { 1.27, 0, 0.06, 1.6 } }) do
				Kit.box(model, e[3], 0.18, e[4], boardX + 0.1 + e[1], h + 0.15, 0.05 + e[2], P.steel_dark, M.metal, nc())
			end
			local heat = Kit.box(model, 2.4, 0.02, 1.4, boardX + 0.1, h + 0.13, 0.05, P.steel_dark, M.metal, { collide = false, name = "Heat" })
			Kit.particles(heat, "smoke", { enabled = false })
			Kit.cyl(extra, 0.22, 0.6, plateX + 0.5, h + 0.3, 0.6, P.gold, M.glass, { collide = false, shadow = false, transparency = 0.2 })
			Kit.box(extra, 0.1, 0.05, 0.8, boardX + 1.5, h + 0.2, -0.5, P.metal, M.metal, nc())
			Kit.box(model, 1, 0.08, 0.7, plateX + 0.1, h + 0.04, 0.1, P.wood_light, M.wood, nc())
		end, { hood = true, plate = "餃子", tools = { "spatula", "spatula", "towel" }, tiles = true, knobs = 2 })
	end)

	Registry.register("fryer", function(m, item)
		station(m, item, function(model, w, h, d, boardX, plateX, extra)
			Kit.box(model, 1.4, 0.5, 1.4, boardX - 0.1, h + 0.25, 0.05, P.steel_dark, M.metal)
			local oil = Kit.box(model, 1.2, 0.04, 1.2, boardX - 0.1, h + 0.5, 0.05, P.gold, M.glass, { collide = false, transparency = 0.2, name = "Oil" })
			Kit.particles(oil, "bubbles", { enabled = false })
			Kit.box(model, 0.9, 0.35, 0.9, boardX - 0.1, h + 0.75, 0.05, P.metal, M.metal, { collide = false, transparency = 0.4 })
			Kit.cylH(model, 0.06, 0.8, boardX - 0.1, h + 0.95, -0.7, P.charcoal, M.smooth, nc(), "z")
			-- draining rack with paper
			Kit.box(model, 0.8, 0.08, 0.6, plateX + 0.2, h + 0.04, 0.1, P.paper, M.smooth, nc())
		end, { hood = true, plate = "天ぷら", tools = { "strainer", "towel" }, tiles = true, knobs = 2 })
	end)

	Registry.register("takoyaki_stove", function(m, item)
		station(m, item, function(model, w, h, d, boardX, plateX, extra)
			Kit.box(model, 1.6, 0.25, 1.3, boardX - 0.1, h + 0.125, 0.05, P.charcoal, M.metal)
			for i = 0, 3 do
				for j = 0, 2 do
					Kit.cyl(model, 0.28, 0.02, boardX - 0.65 + i * 0.36, h + 0.26, -0.3 + j * 0.35, P.black, M.smooth, nc())
					if (i + j) % 2 == 0 then
						Kit.ball(model, 0.26, boardX - 0.65 + i * 0.36, h + 0.3, -0.3 + j * 0.35, P.copper, M.sand, nc())
					end
				end
			end
			Kit.box(model, 0.8, 0.1, 0.6, plateX + 0.2, h + 0.05, 0.1, P.wood_light, M.wood, nc())
		end, { hood = true, plate = "たこ焼", tools = { "towel" }, tiles = true, knobs = 1 })
	end)

	Registry.register("dessert_station", function(m, item)
		station(m, item, function(model, w, h, d, boardX, plateX, extra)
			Kit.box(model, 2, 0.12, 1.3, boardX, h + 0.06, 0.05, P.porcelain, M.marble)
			for i, c in ipairs({ P.sakura, P.white, P.matcha }) do
				Kit.ball(extra, 0.35, boardX - 0.6 + i * 0.35, h + 0.3, -0.45, c, M.smooth, nc())
			end
			-- glass cloche over a tray of mochi
			Kit.cyl(extra, 0.9, 0.06, plateX - 0.2, h + 1.12, d / 2 - 0.25, P.wood_dark, M.wood, nc())
			for i = 0, 2 do
				Kit.ball(extra, 0.25, plateX - 0.45 + i * 0.25, h + 1.27, d / 2 - 0.25, ({ P.sakura, P.white, P.matcha })[i + 1], M.smooth, nc())
			end
			Kit.ball(extra, 0.85, plateX - 0.2, h + 1.32, d / 2 - 0.25, P.glass, M.glass, { collide = false, shadow = false, transparency = 0.7 })
			Kit.box(model, 1, 0.08, 0.7, plateX, h + 0.04, 0.1, P.lacquer, M.smooth, nc())
		end, { plate = "甘味", tools = { "towel" } })
	end)

	-- plain worktop module of the fitted kitchen, with a few tools on it
	Registry.register("kitchen_counter", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		fittedBase(m, w, h, d)
		-- wooden knife block with handles, a stack of bowls, a crock of ladles
		Kit.box(m, 0.5, 0.6, 0.45, -w / 2 + 0.5, h + 0.3, d / 2 - 0.45, P.wood_dark, M.wood, nc())
		for k = 0, 2 do
			Kit.box(m, 0.08, 0.3, 0.12, -w / 2 + 0.36 + k * 0.14, h + 0.72, d / 2 - 0.45, P.charcoal, M.smooth, nc())
		end
		bowlStack(m, 0.25, -0.1, h, 4, P.white)
		Kit.cyl(m, 0.45, 0.55, w / 2 - 0.45, h + 0.28, d / 2 - 0.5, P.steel, M.metal, nc())
		for k = 0, 2 do
			Kit.cyl(m, 0.05, 1.0, w / 2 - 0.55 + k * 0.1, h + 0.75, d / 2 - 0.5, P.wood_dark, M.wood, { collide = false, rot = CFrame.Angles(0, 0, math.rad(-8 + k * 8)) })
		end
		local dk = Kit.detail(m, "kitchen")
		-- a hinoki board leaning on the tiles and soy sauce bottles on the ledge
		Kit.box(dk, 1.2, 0.8, 0.08, 0.2, h + 0.45, d / 2 - 0.2, P.hinoki, M.wood, nc({ rot = CFrame.Angles(math.rad(-12), 0, 0) }))
		for k = 0, 1 do
			Kit.cyl(dk, 0.2, 0.5, -0.4 + k * 0.3, RUN_TOP + 0.35, d / 2 - 0.2, P.soy or "#2B1A10", M.glass, nc())
		end
	end)

	Registry.register("sink", function(m, item)
		local root = Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		local bdHalf = (d - 0.75) / 2
		fittedBase(m, w, h, d, { cutout = { -1.725, 0.875, -bdHalf, bdHalf } })
		local dk = Kit.detail(m, "kitchen")
		plate(dk, w / 2 - 0.8, h - 0.75, -d / 2 - 0.12, "洗い場")
		-- double basin (built from walls so it looks hollow), soapy water in the left one
		local bw, bd = 1.25, d - 0.75
		for i, bx in ipairs({ -1.1, 0.25 }) do
			Kit.box(m, bw, 0.08, bd, bx, h - 0.7, 0, P.steel_dark, M.metal, nc())
			for _, s in ipairs({ { 0, -bd / 2, bw, 0.08 }, { 0, bd / 2, bw, 0.08 }, { -bw / 2, 0, 0.08, bd }, { bw / 2, 0, 0.08, bd } }) do
				Kit.box(m, s[3], 0.7, s[4], bx + s[1], h - 0.35, s[2], P.metal, M.metal, { collide = false, reflectance = 0.1 })
			end
			Kit.cyl(m, 0.2, 0.02, bx, h - 0.65, 0, P.charcoal, M.metal, nc())
			if i == 1 then
				Kit.box(m, bw - 0.1, 0.05, bd - 0.1, bx, h - 0.45, 0, P.water, M.glass, { transparency = 0.35, collide = false, name = "Water" })
				for k = 0, 4 do
					Kit.ball(dk, 0.18 + (k % 2) * 0.08, bx - 0.4 + k * 0.2, h - 0.4, -0.2 + (k % 3) * 0.15, P.white, M.smooth, { collide = false, shadow = false, transparency = 0.15 })
				end
			end
		end
		-- gooseneck faucet between the basins with a pre-rinse sprayer
		local fx, fz = -0.42, bd / 2 + 0.12
		Kit.cyl(m, 0.2, 0.12, fx, h + 0.06, fz, P.metal, M.metal, nc())
		Kit.cyl(m, 0.1, 1.4, fx, h + 0.8, fz, P.metal, M.metal, { collide = false, reflectance = 0.2 })
		Kit.cylH(m, 0.1, 0.6, fx, h + 1.5, fz - 0.27, P.metal, M.metal, { collide = false, shadow = false, reflectance = 0.2 }, "z")
		local spout = Kit.cyl(m, 0.1, 0.3, fx, h + 1.36, fz - 0.55, P.metal, M.metal, { collide = false, name = "Spout" })
		Kit.particles(spout, "water", { enabled = false })
		for _, sx in ipairs({ -0.3, 0.3 }) do
			Kit.cylH(dk, 0.12, 0.25, fx + sx, h + 0.35, fz, P.metal, M.metal, nc(), "x")
			Kit.box(dk, 0.05, 0.05, 0.25, fx + sx * 1.3, h + 0.35, fz - 0.1, sx < 0 and P.neon_red or P.neon_blue, M.smooth, nc())
		end
		-- sponge, dish soap and a tenugui towel over the cabinet lip
		Kit.box(dk, 0.35, 0.14, 0.22, -1.6, h + 0.07, bd / 2 + 0.2, P.leaf_light, M.fabric, nc())
		Kit.box(dk, 0.35, 0.05, 0.22, -1.6, h + 0.165, bd / 2 + 0.2, P.neon_yellow, M.fabric, nc())
		Kit.cyl(dk, 0.24, 0.5, -1.15, h + 0.25, bd / 2 + 0.2, P.leaf, M.plastic, { collide = false, shadow = false, transparency = 0.2 })
		Kit.cyl(dk, 0.08, 0.12, -1.15, h + 0.56, bd / 2 + 0.2, P.white, M.plastic, nc())
		Kit.box(dk, 0.6, 0.9, 0.03, 0.3, h - 0.4, -d / 2 - 0.16, P.white, M.fabric, nc())
		Kit.box(dk, 0.6, 0.12, 0.035, 0.3, h - 0.6, -d / 2 - 0.165, P.indigo, M.fabric, nc())
		-- wire drying rack with clean plates
		local rx = w / 2 - 0.55
		Kit.box(dk, 0.9, 0.05, d - 0.5, rx, h + 0.05, 0, P.metal, M.metal, nc())
		for _, sx in ipairs({ -0.42, 0.42 }) do
			for k = 0, 5 do
				Kit.box(dk, 0.03, 0.4, 0.03, rx + sx, h + 0.25, -0.75 + k * 0.3, P.metal, M.metal, nc())
			end
		end
		for i = 0, 3 do
			Kit.cyl(dk, 0.7, 0.06, rx, h + 0.42, -0.45 + i * 0.3, P.porcelain, M.smooth, { collide = false, rot = CFrame.Angles(math.rad(90), 0, 0) })
			Kit.cyl(dk, 0.74, 0.03, rx, h + 0.42, -0.45 + i * 0.3, P.indigo, M.smooth, { collide = false, shadow = false, rot = CFrame.Angles(math.rad(90), 0, 0) })
		end
		point(root, "Basin", -0.4, h, 0)
		point(root, "Dirty", w / 2 - 0.55, h + 0.1, 0.45)
	end)

	Registry.register("dishwasher", function(m, item)
		local root = Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		Kit.box(m, w, h, d, 0, h / 2, 0, P.metal, M.metal, { reflectance = 0.1 })
		Kit.box(m, w - 0.3, h - 1, 0.06, 0, h / 2 - 0.2, -d / 2 - 0.02, P.steel, M.metal, { collide = false })
		Kit.box(m, w - 0.8, 0.8, 0.04, 0, h / 2 + 0.2, -d / 2 - 0.05, P.glass, M.glass, { collide = false, transparency = 0.3 })
		Kit.box(m, w - 0.6, 0.12, 0.12, 0, h - 0.55, -d / 2 - 0.1, P.steel_dark, M.metal, { collide = false })
		Kit.box(m, 0.18, 0.18, 0.05, w / 2 - 0.35, h - 0.25, -d / 2 - 0.03, P.neon_blue, M.neon, { collide = false, name = "Led" })
		local steam = Kit.box(m, 0.4, 0.1, 0.4, 0, h + 0.05, 0, P.white, M.smooth, { transparency = 1, collide = false, name = "Steam" })
		Kit.particles(steam, "steam", { enabled = false })
		point(root, "Content", 0, h, 0)
	end)

	Registry.register("fridge", function(m, item)
		local root = Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		Kit.box(m, w, h, d, 0, h / 2, 0, P.metal, M.metal, { reflectance = 0.15 })
		for _, x in ipairs({ -w / 4, w / 4 }) do
			Kit.box(m, w / 2 - 0.08, h - 0.6, 0.06, x, h / 2, -d / 2 - 0.03, P.steel, M.metal, { collide = false, reflectance = 0.2 })
			Kit.box(m, 0.08, 1.6, 0.12, x + (x < 0 and w / 4 - 0.2 or -w / 4 + 0.2), h / 2 + 0.5, -d / 2 - 0.1, P.steel_dark, M.metal, { collide = false })
		end
		local display = Kit.box(m, 0.8, 0.3, 0.04, 0, h - 0.25, -d / 2 - 0.04, P.charcoal, M.smooth, { collide = false })
		Kit.text(display, Enum.NormalId.Front, "2°C", { color = "#3BC8FF", glow = true })
		local _ = root
	end)
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000049"><Properties><string name="Name">People</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Detailed NPC looks built on the R15 rig: per-part clothing colours, layered clothes (sleeves,
-- collars, jackets, ties, skirts, shoes), voluminous hair styles, accessories and a procedural
-- face (eyes with highlights, brows, mouth, blush) whose expression follows the customer's mood.
-- Everything is welded to the rig parts, so it follows the animations. Sizes are taken from the
-- real parts, so different body scales (children, tall adults) still fit.
local Kit = require(script.Parent.Parent.Kit)
local P = require(script.Parent.Parent.Palette)
local Color = require(script.Parent.Parent.Parent.Util.Color)
local M = P.M

local People = {}

local function c(hex)
	return Color.hex(hex)
end

local function nc(extra)
	local p = { collide = false, shadow = false }
	if extra then
		for k, v in pairs(extra) do
			p[k] = v
		end
	end
	return p
end

local function weld(part, to, parent)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	local w = Instance.new("WeldConstraint")
	w.Part0 = to
	w.Part1 = part
	w.Parent = part
	part.Parent = parent or to.Parent
	return part
end

-- Box welded to `base`, offset in base space
local function add(base, size, offset, color, mat, props, parent)
	local p = Kit.part(nil, size, base.CFrame * offset, color, mat or M.fabric, props or nc())
	return weld(p, base, parent)
end

-- Ellipsoid welded to `base`
local function blob(base, size, offset, color, mat, props, parent)
	local p = Kit.blob(nil, size.X, size.Y, size.Z, 0, 0, 0, color, mat or M.smooth, props or nc())
	p.CFrame = base.CFrame * offset
	return weld(p, base, parent)
end

local function cyl(base, d, h, offset, color, mat, props, parent)
	local pr = nc(props)
	pr.shape = Enum.PartType.Cylinder
	local p = Kit.part(nil, Vector3.new(h, d, d), base.CFrame * offset * CFrame.Angles(0, 0, math.rad(90)), color, mat or M.fabric, pr)
	return weld(p, base, parent)
end

local function ball(base, d, offset, color, mat, props, parent)
	local pr = nc(props)
	pr.shape = Enum.PartType.Ball
	local p = Kit.part(nil, Vector3.new(d, d, d), base.CFrame * offset, color, mat or M.smooth, pr)
	return weld(p, base, parent)
end

local function body(character)
	local function g(n)
		return character:FindFirstChild(n)
	end
	return {
		head = g("Head"), ut = g("UpperTorso") or g("Torso"), lt = g("LowerTorso") or g("Torso"),
		lua = g("LeftUpperArm"), lla = g("LeftLowerArm"), lh = g("LeftHand"),
		rua = g("RightUpperArm"), rla = g("RightLowerArm"), rh = g("RightHand"),
		lul = g("LeftUpperLeg"), lll = g("LeftLowerLeg"), lf = g("LeftFoot"),
		rul = g("RightUpperLeg"), rll = g("RightLowerLeg"), rf = g("RightFoot"),
	}
end

-- Visual size of the head (classic heads are a 2x1x1 part with a scaled Head mesh)
local function headSize(head)
	local mesh = head:FindFirstChildOfClass("SpecialMesh")
	if mesh and mesh.MeshType == Enum.MeshType.Head then
		return mesh.Scale
	end
	return head.Size
end

local function setColor(part, color)
	if part then
		part.Color = color
	end
end

-- Base colours of the body parts: skin, top, sleeves, legs, shoes
local function paint(b, skin, top, sleeves, legs, shoes)
	-- the rig's BodyColors would put the description colours back, the parts are coloured here
	local model = b.head and b.head.Parent
	local bc = model and model:FindFirstChildOfClass("BodyColors")
	if bc then
		bc:Destroy()
	end
	setColor(b.head, skin)
	setColor(b.lh, skin)
	setColor(b.rh, skin)
	setColor(b.ut, top)
	setColor(b.lt, legs)
	for _, k in ipairs({ "lua", "lla", "rua", "rla" }) do
		setColor(b[k], sleeves)
	end
	for _, k in ipairs({ "lul", "lll", "rul", "rll" }) do
		setColor(b[k], legs)
	end
	setColor(b.lf, shoes)
	setColor(b.rf, shoes)
end

---------------------------------------------------------------------------------------------------
-- Face
---------------------------------------------------------------------------------------------------

-- Depth of the front of the head at horizontal offset x. Heads range from rounded cylinders
-- (classic mesh) to rounded boxes, so follow half of the cylinder curve: features sit on the
-- surface of both shapes.
local function front(hs, x)
	local r = math.min(hs.X, hs.Z) / 2
	local curve = r - math.sqrt(math.max(r * r - x * x, 0.01))
	return -r + curve * 0.5 - 0.014
end

-- Procedural face. Mood variants are kept in the Face folder and shown with People.setMood.
function People.face(character, r, opts)
	opts = opts or {}
	local head = character:FindFirstChild("Head")
	if not head then
		return
	end
	for _, d in ipairs(head:GetChildren()) do
		if d:IsA("Decal") then
			d:Destroy()
		end
	end
	local folder = Instance.new("Folder")
	folder.Name = "Face"
	folder.Parent = character
	local hs = headSize(head)
	local k = hs.X / 1.25
	local eyeY = hs.Y * 0.04
	local eyeX = hs.X * 0.17
	local eyeColor = opts.eyes or c("#2B2320")
	local big = r:NextNumber() < 0.5
	for _, s in ipairs({ -1, 1 }) do
		local x = s * eyeX
		local z = front(hs, x)
		blob(head, Vector3.new(0.13 * k, (big and 0.2 or 0.15) * k, 0.06), CFrame.new(x, eyeY, z), eyeColor, M.smooth, nc({ reflectance = 0.1 }), folder)
		ball(head, 0.05 * k, CFrame.new(x + 0.025 * k, eyeY + 0.04 * k, z - 0.025), P.white, M.neon, nc(), folder)
		-- brows: normal and angry variants
		local by = eyeY + 0.17 * k
		local bz = front(hs, x) + 0.005
		local n = add(head, Vector3.new(0.17 * k, 0.035 * k, 0.03), CFrame.new(x, by, bz) * CFrame.Angles(0, 0, math.rad(s * 6)), opts.brows or c("#2E2018"), M.smooth, nc(), folder)
		n:SetAttribute("Mood", "brow_calm")
		local a = add(head, Vector3.new(0.17 * k, 0.04 * k, 0.03), CFrame.new(x, by - 0.02 * k, bz) * CFrame.Angles(0, 0, math.rad(-s * 22)), opts.brows or c("#2E2018"), M.smooth, nc({ transparency = 1 }), folder)
		a:SetAttribute("Mood", "brow_angry")
		-- blush
		blob(head, Vector3.new(0.16 * k, 0.07 * k, 0.03), CFrame.new(s * hs.X * 0.27, eyeY - 0.12 * k, front(hs, s * hs.X * 0.27) + 0.01), c("#F2A0A0"), M.smooth, nc({ transparency = 0.45 }), folder)
	end
	-- mouths: smile (calm), open smile (happy), flat line (worried), frown (angry)
	local mz = front(hs, 0)
	local my = eyeY - 0.22 * k
	local function arc(mood, curve, visible)
		for i = -1, 1 do
			local p = add(head, Vector3.new(0.09 * k, 0.03 * k, 0.03), CFrame.new(i * 0.075 * k, my + math.abs(i) * curve * k, mz) * CFrame.Angles(0, 0, math.rad(-i * curve * 300)), c("#5A2A2A"), M.smooth, nc({ transparency = visible and 0 or 1 }), folder)
			p:SetAttribute("Mood", mood)
		end
	end
	arc("calm", 0.025, true)
	arc("angry", -0.03, false)
	local flat = add(head, Vector3.new(0.18 * k, 0.03 * k, 0.03), CFrame.new(0, my, mz), c("#5A2A2A"), M.smooth, nc({ transparency = 1 }), folder)
	flat:SetAttribute("Mood", "worried")
	local open = blob(head, Vector3.new(0.2 * k, 0.12 * k, 0.04), CFrame.new(0, my, mz), c("#6A2228"), M.smooth, nc({ transparency = 1 }), folder)
	open:SetAttribute("Mood", "happy")
	local tongue = blob(head, Vector3.new(0.1 * k, 0.05 * k, 0.04), CFrame.new(0, my - 0.03 * k, mz - 0.005), c("#E8707A"), M.smooth, nc({ transparency = 1 }), folder)
	tongue:SetAttribute("Mood", "happy")
	-- nose hint
	blob(head, Vector3.new(0.06 * k, 0.05 * k, 0.04), CFrame.new(0, eyeY - 0.09 * k, mz - 0.01), opts.skin and opts.skin:Lerp(c("#C88A6A"), 0.35) or c("#E8B996"), M.smooth, nc(), folder)
	character:SetAttribute("Mood", "calm")
end

-- mood: "calm" | "happy" | "worried" | "angry". Mouth parts carry the mood name, brows carry
-- "brow_calm" / "brow_angry".
function People.setMood(character, mood)
	local folder = character:FindFirstChild("Face")
	if not folder or character:GetAttribute("Mood") == mood then
		return
	end
	character:SetAttribute("Mood", mood)
	local brow = mood == "angry" and "brow_angry" or "brow_calm"
	for _, p in ipairs(folder:GetChildren()) do
		local m = p:GetAttribute("Mood")
		if m then
			p.Transparency = (m == mood or m == brow) and 0 or 1
		end
	end
end

---------------------------------------------------------------------------------------------------
-- Hair and hats
---------------------------------------------------------------------------------------------------

-- style: short | bob | long | ponytail | bun | spiky | bald | twin
function People.hair(character, color, style)
	local head = character:FindFirstChild("Head")
	if not head then
		return
	end
	local hs = headSize(head)
	local W, H, D = hs.X, hs.Y, hs.Z
	local sheen = nc({ reflectance = 0.08 })
	if style ~= "bald" then
		-- cap of hair over the top and back of the head
		blob(head, Vector3.new(W * 1.1, H * 0.66, D * 1.12), CFrame.new(0, H * 0.22, D * 0.05), color, M.smooth, sheen)
		blob(head, Vector3.new(W * 1.06, H * 0.8, D * 0.62), CFrame.new(0, -H * 0.02, D * 0.27), color, M.smooth, sheen)
		-- fringe across the forehead
		local n = style == "spiky" and 3 or 4
		for i = 1, n do
			local t = (i - 0.5) / n - 0.5
			local x = t * W * 0.8
			blob(head, Vector3.new(W * 0.32, H * 0.24, D * 0.16), CFrame.new(x, H * 0.27, front(hs, x) + D * 0.08) * CFrame.Angles(math.rad(-15), 0, math.rad(t * 40)), color, M.smooth, sheen)
		end
	else
		-- balding: hair around the sides and back only
		blob(head, Vector3.new(W * 1.06, H * 0.42, D * 0.6), CFrame.new(0, -H * 0.02, D * 0.27), color, M.smooth, sheen)
		for _, s in ipairs({ -1, 1 }) do
			blob(head, Vector3.new(W * 0.18, H * 0.38, D * 0.6), CFrame.new(s * W * 0.5, -H * 0.02, D * 0.05), color, M.smooth, sheen)
		end
	end
	if style == "bob" or style == "long" or style == "twin" then
		for _, s in ipairs({ -1, 1 }) do
			blob(head, Vector3.new(W * 0.24, H * (style == "long" and 1.15 or 0.75), D * 0.7), CFrame.new(s * W * 0.5, -H * (style == "long" and 0.3 or 0.12), D * 0.05), color, M.smooth, sheen)
		end
	end
	if style == "long" then
		add(head, Vector3.new(W * 1.0, H * 1.2, D * 0.25), CFrame.new(0, -H * 0.55, D * 0.52), color, M.smooth, sheen)
	elseif style == "ponytail" then
		ball(head, W * 0.28, CFrame.new(0, H * 0.1, D * 0.6), c("#B3262E"), M.fabric)
		blob(head, Vector3.new(W * 0.34, H * 0.9, D * 0.32), CFrame.new(0, -H * 0.35, D * 0.7) * CFrame.Angles(math.rad(12), 0, 0), color, M.smooth, sheen)
	elseif style == "bun" then
		ball(head, W * 0.5, CFrame.new(0, H * 0.55, D * 0.28), color, M.smooth, sheen)
		add(head, Vector3.new(0.04, 0.04, W * 0.7), CFrame.new(W * 0.08, H * 0.62, D * 0.28) * CFrame.Angles(0, math.rad(60), 0), P.lacquer, M.smooth)
	elseif style == "spiky" then
		for i = -2, 2 do
			local sp = Kit.wedge(nil, W * 0.18, H * 0.4, D * 0.3, head.CFrame * CFrame.new(i * W * 0.17, H * 0.6, D * 0.05) * CFrame.Angles(math.rad(-10), 0, math.rad(i * 12)), color, M.smooth, nc())
			weld(sp, head)
		end
	elseif style == "twin" then
		for _, s in ipairs({ -1, 1 }) do
			ball(head, W * 0.2, CFrame.new(s * W * 0.55, H * 0.15, D * 0.25), c("#F25A9A"), M.fabric)
			blob(head, Vector3.new(W * 0.3, H * 0.75, D * 0.3), CFrame.new(s * W * 0.68, -H * 0.2, D * 0.3), color, M.smooth, sheen)
		end
	end
end

-- kind: cap | bucket | chef | hachimaki | bandana | sunhat | flatcap | fedora | school
function People.hat(character, kind, color)
	local head = character:FindFirstChild("Head")
	if not head then
		return
	end
	local hs = headSize(head)
	local W, H, D = hs.X, hs.Y, hs.Z
	if kind == "cap" then
		blob(head, Vector3.new(W * 1.14, H * 0.62, D * 1.16), CFrame.new(0, H * 0.28, D * 0.02), color, M.fabric)
		add(head, Vector3.new(W * 0.85, 0.06, D * 0.55), CFrame.new(0, H * 0.24, -D * 0.68) * CFrame.Angles(math.rad(-8), 0, 0), color, M.fabric)
		ball(head, 0.12, CFrame.new(0, H * 0.6, 0), color:Lerp(P.black, 0.3), M.fabric)
		add(head, Vector3.new(W * 0.3, H * 0.18, 0.02), CFrame.new(0, H * 0.4, front(hs, 0) - 0.02), P.white, M.fabric)
	elseif kind == "bucket" or kind == "school" then
		local col = kind == "school" and c("#F4CF3B") or color
		cyl(head, W * 1.2, H * 0.42, CFrame.new(0, H * 0.42, 0), col, M.fabric)
		cyl(head, W * 1.7, 0.06, CFrame.new(0, H * 0.24, 0) * CFrame.Angles(math.rad(-6), 0, 0), col, M.fabric)
		cyl(head, W * 1.22, H * 0.08, CFrame.new(0, H * 0.32, 0), col:Lerp(P.black, 0.35), M.fabric)
	elseif kind == "chef" then
		cyl(head, W * 1.12, H * 0.25, CFrame.new(0, H * 0.45, 0), P.white, M.fabric)
		for i = 0, 5 do
			local a = i * math.pi / 3
			blob(head, Vector3.new(W * 0.45, H * 0.8, W * 0.45), CFrame.new(math.cos(a) * W * 0.28, H * 0.95, math.sin(a) * W * 0.28), P.white, M.fabric)
		end
		blob(head, Vector3.new(W * 0.9, H * 0.4, W * 0.9), CFrame.new(0, H * 1.28, 0), P.white, M.fabric)
	elseif kind == "hachimaki" or kind == "bandana" then
		local col = kind == "bandana" and (color or P.indigo) or P.white
		cyl(head, W * 1.1, H * 0.2, CFrame.new(0, H * 0.3, 0), col, M.fabric)
		if kind == "hachimaki" then
			cyl(head, H * 0.17, 0.02, CFrame.new(0, H * 0.3, -D * 0.56) * CFrame.Angles(math.rad(90), 0, 0), P.lacquer, M.fabric)
		end
		-- knot and tails at the back
		ball(head, H * 0.2, CFrame.new(0, H * 0.3, D * 0.58), col, M.fabric)
		for _, s in ipairs({ -1, 1 }) do
			add(head, Vector3.new(0.12, H * 0.4, 0.04), CFrame.new(s * 0.08, H * 0.12, D * 0.62) * CFrame.Angles(0, 0, math.rad(s * 18)), col, M.fabric)
		end
		if kind == "bandana" then
			blob(head, Vector3.new(W * 1.1, H * 0.55, D * 1.12), CFrame.new(0, H * 0.32, D * 0.04), col, M.fabric)
			for k = 0, 5 do
				ball(head, 0.06, CFrame.new(-W * 0.3 + (k % 3) * W * 0.3, H * 0.5 + math.floor(k / 3) * 0.12, -D * 0.3 + math.floor(k / 3) * D * 0.2), P.white, M.fabric)
			end
		end
	elseif kind == "sunhat" then
		cyl(head, W * 2.0, 0.06, CFrame.new(0, H * 0.3, 0), color, M.fabric)
		cyl(head, W * 1.15, H * 0.4, CFrame.new(0, H * 0.48, 0), color, M.fabric)
		cyl(head, W * 1.17, H * 0.1, CFrame.new(0, H * 0.33, 0), P.lacquer, M.fabric)
	elseif kind == "flatcap" then
		blob(head, Vector3.new(W * 1.2, H * 0.4, D * 1.25), CFrame.new(0, H * 0.4, -D * 0.05), color, M.fabric)
		add(head, Vector3.new(W * 0.8, 0.06, D * 0.35), CFrame.new(0, H * 0.32, -D * 0.62), color, M.fabric)
	elseif kind == "fedora" then
		cyl(head, W * 1.75, 0.06, CFrame.new(0, H * 0.32, 0), color, M.fabric)
		cyl(head, W * 1.12, H * 0.5, CFrame.new(0, H * 0.58, 0), color, M.fabric)
		cyl(head, W * 1.14, H * 0.1, CFrame.new(0, H * 0.4, 0), P.gold, M.fabric)
	end
end

function People.glasses(character, color, sun)
	local head = character:FindFirstChild("Head")
	if not head then
		return
	end
	local hs = headSize(head)
	local k = hs.X / 1.25
	local y = hs.Y * 0.04
	for _, s in ipairs({ -1, 1 }) do
		local x = s * hs.X * 0.17
		local z = front(hs, x) - 0.035
		add(head, Vector3.new(0.3 * k, (sun and 0.2 or 0.24) * k, 0.03), CFrame.new(x, y, z), sun and P.black or c("#BFE0F0"), M.glass, nc({ transparency = sun and 0.05 or 0.6, reflectance = 0.3 }))
		add(head, Vector3.new(0.32 * k, 0.03, 0.035), CFrame.new(x, y + 0.13 * k, z), color or P.black, M.metal)
		add(head, Vector3.new(0.03, 0.03, hs.Z * 0.6), CFrame.new(s * hs.X * 0.5, y + 0.1 * k, -hs.Z * 0.15), color or P.black, M.metal)
	end
	add(head, Vector3.new(0.1 * k, 0.03, 0.03), CFrame.new(0, y + 0.08 * k, front(hs, 0) - 0.04), color or P.black, M.metal)
end

---------------------------------------------------------------------------------------------------
-- Clothes
---------------------------------------------------------------------------------------------------

-- Short sleeves over the upper arms (arms keep the skin colour)
local function sleeves(b, color, long)
	for _, k in ipairs({ "lua", "rua" }) do
		local a = b[k]
		if a then
			local s = a.Size
			add(a, Vector3.new(s.X * 1.1, s.Y * (long and 1.02 or 0.6), s.Z * 1.1), CFrame.new(0, s.Y * (long and 0 or 0.22), 0), color, M.fabric)
		end
	end
end

local function cuffs(b, color)
	for _, k in ipairs({ "lla", "rla" }) do
		local a = b[k]
		if a then
			local s = a.Size
			add(a, Vector3.new(s.X * 1.08, s.Y * 0.14, s.Z * 1.08), CFrame.new(0, -s.Y * 0.43, 0), color, M.fabric)
		end
	end
end

local function hems(b, color)
	for _, k in ipairs({ "lll", "rll" }) do
		local l = b[k]
		if l then
			local s = l.Size
			add(l, Vector3.new(s.X * 1.08, s.Y * 0.12, s.Z * 1.08), CFrame.new(0, -s.Y * 0.44, 0), color, M.fabric)
		end
	end
end

local function belt(b, color, buckle)
	local t = b.lt
	if not t then
		return
	end
	local s = t.Size
	add(t, Vector3.new(s.X * 1.03, s.Y * 0.45, s.Z * 1.05), CFrame.new(0, s.Y * 0.25, 0), color or c("#2A2018"), M.leather)
	add(t, Vector3.new(0.22, s.Y * 0.4, 0.04), CFrame.new(0, s.Y * 0.25, -s.Z * 0.54), buckle or P.metal, M.metal, nc({ reflectance = 0.3 }))
end

-- shoes: "sneaker" | "dress" | "sandal" | "boot" | "geta"
local function shoes(b, kind, color)
	for _, k in ipairs({ "lf", "rf" }) do
		local f = b[k]
		if f then
			local s = f.Size
			if kind == "geta" then
				add(f, Vector3.new(s.X * 0.95, 0.08, s.Z * 1.15), CFrame.new(0, -s.Y * 0.5 - 0.1, -0.05), P.hinoki, M.wood)
				for _, z in ipairs({ -s.Z * 0.3, s.Z * 0.3 }) do
					add(f, Vector3.new(s.X * 0.9, 0.12, 0.08), CFrame.new(0, -s.Y * 0.5 - 0.2, z), P.hinoki, M.wood)
				end
				add(f, Vector3.new(s.X * 0.7, 0.05, 0.05), CFrame.new(0, 0, -s.Z * 0.2), P.lacquer, M.fabric)
			else
				local sole = kind == "sneaker" and P.white or (kind == "sandal" and P.wood or P.black)
				local up = color or (kind == "dress" and c("#1A1414") or P.white)
				add(f, Vector3.new(s.X * 1.08, s.Y * 1.05, s.Z * 1.18), CFrame.new(0, 0.02, -s.Z * 0.06), up, kind == "dress" and M.leather or M.fabric, nc({ reflectance = kind == "dress" and 0.2 or 0 }))
				add(f, Vector3.new(s.X * 1.12, 0.08, s.Z * 1.22), CFrame.new(0, -s.Y * 0.5, -s.Z * 0.06), sole, M.smooth)
				if kind == "sneaker" then
					add(f, Vector3.new(s.X * 0.6, 0.03, s.Z * 0.35), CFrame.new(0, s.Y * 0.55, -s.Z * 0.2), P.white, M.fabric)
				elseif kind == "boot" then
					local l = k == "lf" and b.lll or b.rll
					if l then
						add(l, Vector3.new(l.Size.X * 1.1, l.Size.Y * 0.4, l.Size.Z * 1.1), CFrame.new(0, -l.Size.Y * 0.3, 0), up, M.leather)
					end
				end
			end
		end
	end
end

-- Collar ring at the neck
local function collar(b, color, white)
	local t = b.ut
	if not t then
		return
	end
	local s = t.Size
	add(t, Vector3.new(s.X * 0.42, 0.14, s.Z * 0.85), CFrame.new(0, s.Y * 0.5, 0), color, M.fabric)
	if white then
		for _, side in ipairs({ -1, 1 }) do
			add(t, Vector3.new(0.3, 0.22, 0.04), CFrame.new(side * 0.17, s.Y * 0.42, -s.Z * 0.51) * CFrame.Angles(0, 0, math.rad(side * 30)), P.white, M.fabric)
		end
	end
end

-- Logo / print on the chest
local function chestPrint(b, color, shape)
	local t = b.ut
	if not t then
		return
	end
	local s = t.Size
	if shape == "circle" then
		cyl(t, s.X * 0.32, 0.02, CFrame.new(0, s.Y * 0.1, -s.Z * 0.51) * CFrame.Angles(math.rad(90), 0, 0), color, M.fabric)
	elseif shape == "stripe" then
		add(t, Vector3.new(s.X * 1.01, s.Y * 0.16, s.Z * 1.01), CFrame.new(0, s.Y * 0.05, 0), color, M.fabric)
	else
		add(t, Vector3.new(s.X * 0.4, s.Y * 0.28, 0.02), CFrame.new(0, s.Y * 0.08, -s.Z * 0.51), color, M.fabric)
	end
end

local function hoodie(b, color)
	local t = b.ut
	local s = t.Size
	-- hood behind the neck, drawstrings, front pocket, ribbed cuffs
	blob(t, Vector3.new(s.X * 0.75, s.Y * 0.4, s.Z * 0.6), CFrame.new(0, s.Y * 0.45, s.Z * 0.32), color, M.fabric)
	for _, side in ipairs({ -1, 1 }) do
		add(t, Vector3.new(0.04, s.Y * 0.35, 0.04), CFrame.new(side * 0.15, s.Y * 0.22, -s.Z * 0.52), P.white, M.fabric)
	end
	add(t, Vector3.new(s.X * 0.6, s.Y * 0.3, 0.05), CFrame.new(0, -s.Y * 0.3, -s.Z * 0.52), color:Lerp(P.black, 0.12), M.fabric)
	cuffs(b, color:Lerp(P.black, 0.2))
end

-- Suit jacket: lapels, tie, white shirt strip, buttons and pocket square
local function suit(b, jacket, tie, square)
	local t = b.ut
	local s = t.Size
	add(t, Vector3.new(s.X * 0.26, s.Y * 0.95, 0.02), CFrame.new(0, s.Y * 0.02, -s.Z * 0.505), P.white, M.fabric)
	add(t, Vector3.new(0.16, s.Y * 0.62, 0.03), CFrame.new(0, s.Y * 0.08, -s.Z * 0.52), tie, M.fabric)
	add(t, Vector3.new(0.18, 0.14, 0.04), CFrame.new(0, s.Y * 0.42, -s.Z * 0.53), tie:Lerp(P.black, 0.2), M.fabric)
	for _, side in ipairs({ -1, 1 }) do
		add(t, Vector3.new(0.26, s.Y * 0.62, 0.04), CFrame.new(side * s.X * 0.17, s.Y * 0.2, -s.Z * 0.53) * CFrame.Angles(0, 0, math.rad(-side * 14)), jacket:Lerp(P.black, 0.15), M.fabric)
	end
	for k = 0, 1 do
		ball(t, 0.09, CFrame.new(s.X * 0.08, -s.Y * 0.18 - k * 0.22, -s.Z * 0.53), c("#2A2420"), M.smooth)
	end
	if square then
		add(t, Vector3.new(0.2, 0.08, 0.03), CFrame.new(-s.X * 0.3, s.Y * 0.22, -s.Z * 0.52), square, M.fabric)
	end
	cuffs(b, P.white)
end

-- Kimono-style wrap (happi / kappogi): crossed collar band, obi or belt
local function wrapCollar(b, band)
	local t = b.ut
	local s = t.Size
	for _, side in ipairs({ -1, 1 }) do
		add(t, Vector3.new(0.18, s.Y * 1.05, 0.04), CFrame.new(side * 0.12, s.Y * 0.02, -s.Z * 0.52) * CFrame.Angles(0, 0, math.rad(side * 22)), band, M.fabric)
	end
end

-- long = down to the shins; bib = also covers the chest (rubber / work aprons)
local function apron(b, color, long, tie, bib)
	local lt, ut = b.lt, b.ut
	if not lt then
		return
	end
	local s = lt.Size
	local len = long and 2.4 or 1.3
	add(lt, Vector3.new(s.X * 0.95, len, 0.06), CFrame.new(0, -len / 2 + s.Y * 0.4, -s.Z * 0.56), color, M.fabric)
	add(lt, Vector3.new(s.X * 1.04, 0.12, s.Z * 1.06), CFrame.new(0, s.Y * 0.4, 0), tie or color:Lerp(P.black, 0.2), M.fabric)
	if bib and ut then
		add(ut, Vector3.new(ut.Size.X * 0.55, ut.Size.Y * 0.7, 0.06), CFrame.new(0, -ut.Size.Y * 0.1, -ut.Size.Z * 0.54), color, M.fabric)
		for _, side in ipairs({ -1, 1 }) do
			add(ut, Vector3.new(0.08, ut.Size.Y * 0.5, 0.05), CFrame.new(side * ut.Size.X * 0.25, ut.Size.Y * 0.32, -ut.Size.Z * 0.5) * CFrame.Angles(0, 0, math.rad(-side * 15)), color, M.fabric)
		end
	end
end

local function skirt(b, color)
	local lt = b.lt
	if not lt then
		return
	end
	local s = lt.Size
	blob(lt, Vector3.new(s.X * 1.25, 1.1, s.Z * 1.35), CFrame.new(0, -0.45, 0), color, M.fabric)
	add(lt, Vector3.new(s.X * 1.08, 0.12, s.Z * 1.08), CFrame.new(0, s.Y * 0.3, 0), color:Lerp(P.black, 0.25), M.fabric)
end

local function shorts(b, color)
	for _, k in ipairs({ "lul", "rul" }) do
		local l = b[k]
		if l then
			local s = l.Size
			add(l, Vector3.new(s.X * 1.08, s.Y * 0.7, s.Z * 1.08), CFrame.new(0, s.Y * 0.16, 0), color, M.fabric)
		end
	end
end

-- Backpack with straps; randoseru = Japanese school bag
local function backpack(b, color, randoseru)
	local t = b.ut
	local s = t.Size
	local depth = randoseru and 0.55 or 0.5
	add(t, Vector3.new(s.X * (randoseru and 0.7 or 0.65), s.Y * (randoseru and 0.85 or 0.9), depth), CFrame.new(0, -s.Y * 0.02, s.Z * 0.5 + depth / 2), color, randoseru and M.leather or M.fabric, nc({ reflectance = randoseru and 0.15 or 0 }))
	if randoseru then
		add(t, Vector3.new(s.X * 0.72, s.Y * 0.5, 0.06), CFrame.new(0, s.Y * 0.18, s.Z * 0.5 + depth + 0.02), color:Lerp(P.black, 0.2), M.leather)
		ball(t, 0.12, CFrame.new(0, -s.Y * 0.05, s.Z * 0.5 + depth + 0.05), P.gold, M.metal)
	else
		add(t, Vector3.new(s.X * 0.45, s.Y * 0.3, 0.12), CFrame.new(0, -s.Y * 0.2, s.Z * 0.5 + depth + 0.05), color:Lerp(P.black, 0.15), M.fabric)
	end
	for _, side in ipairs({ -1, 1 }) do
		add(t, Vector3.new(0.14, s.Y * 0.95, 0.05), CFrame.new(side * s.X * 0.22, 0, -s.Z * 0.52), color:Lerp(P.black, 0.3), M.fabric)
		add(t, Vector3.new(0.14, 0.06, s.Z * 1.05), CFrame.new(side * s.X * 0.22, s.Y * 0.48, 0), color:Lerp(P.black, 0.3), M.fabric)
	end
end

local function holdInRight(b, size, color, mat, offset, props)
	local h = b.rh
	if not h then
		return nil
	end
	return add(h, size, CFrame.new(0, -h.Size.Y * 0.5 - size.Y * 0.35, 0) * (offset or CFrame.new()), color, mat, props)
end

local function watch(b, gold)
	local a = b.lla
	if a then
		add(a, Vector3.new(a.Size.X * 1.08, 0.12, a.Size.Z * 1.08), CFrame.new(0, -a.Size.Y * 0.36, 0), gold and P.gold or P.black, M.metal, nc({ reflectance = 0.3 }))
		add(a, Vector3.new(0.2, 0.14, 0.04), CFrame.new(0, -a.Size.Y * 0.36, -a.Size.Z * 0.55), gold and P.gold or P.steel, M.metal, nc({ reflectance = 0.4 }))
	end
end

---------------------------------------------------------------------------------------------------
-- Looks
---------------------------------------------------------------------------------------------------

local HAIR_STYLES = { "short", "bob", "long", "ponytail", "bun", "spiky" }

-- Applies a randomized look for a customer type. opts.child = smaller kid outfit
function People.dress(character, look, looks, r, opts)
	opts = opts or {}
	local b = body(character)
	if not (b.head and b.ut) then
		return
	end
	local function pick(list)
		return list[r:NextInteger(1, #list)]
	end
	local skin = c(pick(looks.skin))
	local hair = c(pick(looks.hair))
	local shirts = looks.shirts[look] or looks.shirts.casual
	local top = c(pick(shirts))
	local pants = c(pick(looks.pants))
	local style = pick(HAIR_STYLES)
	local skirtOn = (style == "long" or style == "bob" or style == "ponytail" or style == "bun") and r:NextNumber() < 0.45

	if opts.child then
		local kidTop = c(pick(looks.shirts.casual))
		paint(b, skin, kidTop, skin, skin, P.white)
		sleeves(b, kidTop)
		collar(b, kidTop:Lerp(P.white, 0.4))
		chestPrint(b, P.white, r:NextNumber() < 0.5 and "circle" or "stripe")
		if r:NextNumber() < 0.5 then
			skirt(b, c(pick(looks.pants)))
			style = r:NextNumber() < 0.5 and "twin" or "bob"
		else
			shorts(b, c(pick(looks.pants)))
			style = "short"
		end
		shoes(b, "sneaker", c(pick(looks.shirts.casual)))
		People.hair(character, hair, style)
		People.face(character, r, { skin = skin, brows = hair })
		if r:NextNumber() < 0.6 then
			backpack(b, r:NextNumber() < 0.5 and c("#B3262E") or c("#1A1A1A"), true)
		end
		if r:NextNumber() < 0.4 then
			People.hat(character, "school")
		end
		return
	end

	if look == "suit" then
		local jacket = top
		paint(b, skin, jacket, jacket, jacket:Lerp(P.black, 0.1), c("#1A1414"))
		suit(b, jacket, c(pick({ "#B3262E", "#2E5A8C", "#D4A23C", "#3E6A3A" })), r:NextNumber() < 0.3 and P.white or nil)
		belt(b, c("#1A1414"))
		shoes(b, "dress")
		style = r:NextNumber() < 0.75 and "short" or (r:NextNumber() < 0.5 and "bald" or "bob")
		People.hair(character, hair, style)
		People.face(character, r, { skin = skin, brows = hair })
		if r:NextNumber() < 0.4 then
			People.glasses(character, P.black)
		end
		holdInRight(b, Vector3.new(0.25, 1.0, 1.4), c("#3A2418"), M.leather, CFrame.new(0, -0.2, 0))
		watch(b, false)
	elseif look == "tourist" then
		-- aloha shirt with flowers, shorts, sneakers, camera and sun hat
		paint(b, skin, top, skin, skin, P.white)
		sleeves(b, top)
		collar(b, top:Lerp(P.white, 0.3))
		local t = b.ut
		for k = 0, 7 do
			local side = k < 4 and -1 or 1
			ball(t, 0.22, CFrame.new(-t.Size.X * 0.35 + (k % 4) * t.Size.X * 0.24, t.Size.Y * (0.3 - (k % 3) * 0.28), side * t.Size.Z * 0.5), k % 2 == 0 and P.white or c("#F25A9A"), M.fabric)
		end
		shorts(b, c(pick({ "#C8B898", "#6A8AB0", "#5A6A3A" })))
		shoes(b, r:NextNumber() < 0.5 and "sneaker" or "sandal", c("#3A6EB3"))
		People.hair(character, hair, style)
		People.face(character, r, { skin = skin, brows = hair })
		People.hat(character, r:NextNumber() < 0.5 and "sunhat" or "bucket", c(pick(looks.shirts.tourist)))
		-- camera hanging on a strap
		add(t, Vector3.new(0.08, t.Size.Y * 1.1, 0.04), CFrame.new(0, t.Size.Y * 0.1, -t.Size.Z * 0.52) * CFrame.Angles(0, 0, math.rad(35)), P.black, M.fabric)
		add(t, Vector3.new(0.55, 0.38, 0.3), CFrame.new(t.Size.X * 0.2, -t.Size.Y * 0.25, -t.Size.Z * 0.66), P.black, M.smooth)
		cyl(t, 0.24, 0.22, CFrame.new(t.Size.X * 0.2, -t.Size.Y * 0.25, -t.Size.Z * 0.88) * CFrame.Angles(math.rad(90), 0, 0), P.steel_dark, M.glass, nc({ reflectance = 0.3 }))
		if r:NextNumber() < 0.5 then
			People.glasses(character, P.black, true)
		end
	elseif look == "elder" then
		-- cardigan with buttons over a shirt, flat cap, cane
		paint(b, skin, top, top, pants, c("#5A3A24"))
		local t = b.ut
		add(t, Vector3.new(t.Size.X * 0.3, t.Size.Y * 0.98, 0.02), CFrame.new(0, 0, -t.Size.Z * 0.505), c("#E8E0D0"), M.fabric)
		for k = 0, 4 do
			ball(t, 0.08, CFrame.new(-t.Size.X * 0.17, t.Size.Y * 0.35 - k * t.Size.Y * 0.18, -t.Size.Z * 0.53), c("#5A3A24"), M.smooth)
		end
		collar(b, c("#E8E0D0"), true)
		cuffs(b, top:Lerp(P.black, 0.2))
		belt(b, c("#3A2A1A"))
		shoes(b, "dress", c("#5A3A24"))
		People.hair(character, c(pick({ "#B8B0A8", "#D8D2CA", "#8A847C" })), r:NextNumber() < 0.5 and "bald" or "short")
		People.face(character, r, { skin = skin, brows = c("#B8B0A8") })
		People.glasses(character, P.gold)
		if r:NextNumber() < 0.6 then
			People.hat(character, "flatcap", c(pick(looks.shirts.elder)))
		end
		local cane = holdInRight(b, Vector3.new(0.1, 2.6, 0.1), P.wood_dark, M.wood, CFrame.new(0, -0.7, -0.1))
		if cane and b.rh then
			add(b.rh, Vector3.new(0.4, 0.1, 0.1), CFrame.new(0.1, 0, -0.1), P.wood_dark, M.wood)
		end
	elseif look == "trendy" then
		-- open jacket over a tee, sunglasses, phone, earrings, chunky sneakers, crossbody bag
		local jacket = c(pick({ "#1E1E22", "#F4F1EA", "#7F3AB3", "#2EA3B3" }))
		paint(b, skin, top, jacket, pants, P.white)
		local t = b.ut
		for _, side in ipairs({ -1, 1 }) do
			add(t, Vector3.new(t.Size.X * 0.32, t.Size.Y * 1.02, t.Size.Z * 1.08), CFrame.new(side * t.Size.X * 0.36, 0, 0), jacket, M.fabric)
		end
		chestPrint(b, c("#FFD23B"), "square")
		cuffs(b, jacket:Lerp(P.black, 0.25))
		if skirtOn then
			skirt(b, pants)
			setColor(b.lll, skin)
			setColor(b.rll, skin)
		end
		shoes(b, "sneaker", c(pick({ "#F25A9A", "#F4F1EA", "#3BC8FF" })))
		People.hair(character, c(pick({ "#F25A9A", "#3BC8FF", "#E8D8B0", "#1A1412", "#B3262E" })), style)
		People.face(character, r, { skin = skin, brows = hair })
		People.glasses(character, P.black, true)
		if b.head then
			local hs = headSize(b.head)
			for _, s in ipairs({ -1, 1 }) do
				ball(b.head, 0.1, CFrame.new(s * hs.X * 0.52, -hs.Y * 0.18, 0), P.gold, M.metal, nc({ reflectance = 0.4 }))
			end
		end
		local phone = holdInRight(b, Vector3.new(0.3, 0.55, 0.06), P.black, M.smooth, CFrame.new(0, 0.1, -0.2))
		if phone then
			add(b.rh, Vector3.new(0.26, 0.48, 0.02), CFrame.new(0, -b.rh.Size.Y * 0.5 - 0.09, -0.24), c("#7FC8E8"), M.neon)
		end
		add(t, Vector3.new(0.08, t.Size.Y * 1.1, 0.04), CFrame.new(0, 0, -t.Size.Z * 0.52) * CFrame.Angles(0, 0, math.rad(-38)), P.black, M.leather)
		add(t, Vector3.new(0.6, 0.45, 0.2), CFrame.new(t.Size.X * 0.42, -t.Size.Y * 0.45, -t.Size.Z * 0.2), c(pick({ "#F25A9A", "#1E1E22", "#D4A23C" })), M.leather)
	elseif look == "vip" then
		-- long black coat with gold buttons, gold scarf and watch, sunglasses, fedora
		local coat = top
		paint(b, skin, coat, coat, coat:Lerp(P.black, 0.3), c("#141414"))
		suit(b, coat, P.gold, P.gold)
		local lt = b.lt
		if lt then
			add(lt, Vector3.new(lt.Size.X * 1.05, 1.6, lt.Size.Z * 1.1), CFrame.new(0, -0.7, 0), coat, M.fabric)
		end
		local t = b.ut
		add(t, Vector3.new(t.Size.X * 0.5, 0.25, t.Size.Z * 1.1), CFrame.new(0, t.Size.Y * 0.45, 0), P.gold, M.fabric)
		add(t, Vector3.new(0.25, t.Size.Y * 0.6, 0.05), CFrame.new(t.Size.X * 0.12, t.Size.Y * 0.15, -t.Size.Z * 0.56), P.gold, M.fabric)
		shoes(b, "dress")
		People.hair(character, hair, r:NextNumber() < 0.5 and "short" or "long")
		People.face(character, r, { skin = skin, brows = hair })
		People.glasses(character, P.gold, true)
		watch(b, true)
		if r:NextNumber() < 0.5 then
			People.hat(character, "fedora", c("#1A1414"))
		end
	else
		-- casual: T-shirt or hoodie, jeans or skirt, sneakers, cap or backpack
		if r:NextNumber() < 0.45 then
			paint(b, skin, top, top, pants, P.white)
			hoodie(b, top)
		else
			paint(b, skin, top, skin, pants, P.white)
			sleeves(b, top)
			collar(b, top:Lerp(P.black, 0.2))
			chestPrint(b, top:Lerp(P.white, 0.6), r:NextNumber() < 0.5 and "circle" or "square")
		end
		if skirtOn then
			skirt(b, pants)
			setColor(b.lul, skin)
			setColor(b.rul, skin)
			setColor(b.lll, P.white)
			setColor(b.rll, P.white)
		else
			belt(b)
			hems(b, pants:Lerp(P.black, 0.25))
		end
		shoes(b, "sneaker", c(pick({ "#F4F1EA", "#D9363E", "#1E1E22", "#3A6EB3" })))
		People.hair(character, hair, style)
		People.face(character, r, { skin = skin, brows = hair })
		local roll = r:NextNumber()
		if roll < 0.3 then
			People.hat(character, "cap", c(pick(looks.shirts.casual)))
		elseif roll < 0.6 then
			backpack(b, c(pick(looks.shirts.casual)))
		end
		if r:NextNumber() < 0.25 then
			People.glasses(character, c("#3A2A20"))
		end
	end
end

-- Staff uniforms by role
function People.staff(character, role, looks, r)
	local b = body(character)
	if not (b.head and b.ut) then
		return
	end
	local function pick(list)
		return list[r:NextInteger(1, #list)]
	end
	local skin = c(pick(looks.skin))
	local hair = c(pick(looks.hair))
	local style = pick({ "short", "short", "ponytail", "bun", "spiky" })
	local t = b.ut
	if role == "staff_sushi_chef" or role == "staff_ramen_chef" or role == "staff_line_cook" then
		-- white kappogi jacket, long dark apron, tenugui at the waist, chef hat or hachimaki
		paint(b, skin, P.white, P.white, c("#1E1E22"), P.black)
		wrapCollar(b, c("#E8E0D0"))
		for k = 0, 2 do
			ball(t, 0.08, CFrame.new(t.Size.X * 0.2, t.Size.Y * 0.2 - k * 0.3, -t.Size.Z * 0.53), c("#D8D0C0"), M.smooth)
		end
		apron(b, role == "staff_sushi_chef" and c("#1E2A44") or c("#3A2A20"), true, P.white, false)
		if b.lt then
			add(b.lt, Vector3.new(0.3, 0.7, 0.05), CFrame.new(b.lt.Size.X * 0.35, -0.4, -b.lt.Size.Z * 0.62), P.white, M.fabric)
			add(b.lt, Vector3.new(0.3, 0.08, 0.051), CFrame.new(b.lt.Size.X * 0.35, -0.6, -b.lt.Size.Z * 0.625), P.indigo, M.fabric)
		end
		shoes(b, role == "staff_sushi_chef" and "geta" or "boot", P.black)
		People.hair(character, hair, style == "spiky" and "short" or style)
		People.face(character, r, { skin = skin, brows = hair })
		People.hat(character, role == "staff_sushi_chef" and "hachimaki" or "chef")
	elseif role == "staff_waiter" then
		-- indigo happi coat with white collar band, short maekake apron, bandana, order pad
		local happi = c("#1E2A44")
		paint(b, skin, happi, happi, c("#1A1A1A"), P.black)
		wrapCollar(b, P.white)
		cuffs(b, P.white)
		local back = add(t, Vector3.new(t.Size.X * 0.5, t.Size.Y * 0.5, 0.02), CFrame.new(0, 0, t.Size.Z * 0.51), happi, M.fabric)
		Kit.text(back, Enum.NormalId.Back, "麺", { color = "#FFFFFF" })
		apron(b, c("#2E3A5C"), false, P.white)
		shoes(b, "sneaker", P.black)
		People.hair(character, hair, style)
		People.face(character, r, { skin = skin, brows = hair })
		People.hat(character, "bandana", c("#B3262E"))
		holdInRight(b, Vector3.new(0.5, 0.65, 0.06), P.paper, M.smooth, CFrame.new(0, 0.1, -0.15))
	elseif role == "staff_dishwasher" then
		-- t-shirt, long rubber apron, yellow gloves, rubber boots
		local tee = c(pick({ "#F4F1EA", "#6A8AB0", "#C8B898" }))
		paint(b, skin, tee, skin, c("#2A2A30"), P.white)
		sleeves(b, tee)
		apron(b, c("#3E8A4A"), true, c("#2A5A30"), true)
		for _, k in ipairs({ "lla", "rla" }) do
			local a = b[k]
			if a then
				add(a, Vector3.new(a.Size.X * 1.1, a.Size.Y * 0.7, a.Size.Z * 1.1), CFrame.new(0, -a.Size.Y * 0.15, 0), c("#F4CF3B"), M.smooth, nc({ reflectance = 0.1 }))
			end
		end
		setColor(b.lh, c("#F4CF3B"))
		setColor(b.rh, c("#F4CF3B"))
		shoes(b, "boot", P.white)
		People.hair(character, hair, style)
		People.face(character, r, { skin = skin, brows = hair })
		People.hat(character, "bandana", c("#2E5A8C"))
	elseif role == "staff_stocker" then
		-- work jacket with reflective stripe, cap, cotton gloves, work boots
		local jacket = c("#4A5A3A")
		paint(b, skin, jacket, jacket, c("#3A3A44"), c("#5A3A24"))
		chestPrint(b, c("#D8E048"), "stripe")
		collar(b, jacket:Lerp(P.black, 0.2))
		setColor(b.lh, P.white)
		setColor(b.rh, P.white)
		belt(b)
		shoes(b, "boot", c("#5A3A24"))
		People.hair(character, hair, "short")
		People.face(character, r, { skin = skin, brows = hair })
		People.hat(character, "cap", c("#D9363E"))
	else
		-- manager: dark suit, gold tie, name badge, clipboard
		local jacket = c("#1E1E28")
		paint(b, skin, jacket, jacket, jacket, c("#141414"))
		suit(b, jacket, P.gold, P.white)
		add(t, Vector3.new(0.4, 0.18, 0.03), CFrame.new(t.Size.X * 0.27, t.Size.Y * 0.2, -t.Size.Z * 0.53), P.gold, M.metal, nc({ reflectance = 0.3 }))
		belt(b, c("#141414"), P.gold)
		shoes(b, "dress")
		People.hair(character, hair, "short")
		People.face(character, r, { skin = skin, brows = hair })
		People.glasses(character, P.black)
		holdInRight(b, Vector3.new(0.7, 0.9, 0.06), P.wood_light, M.wood, CFrame.new(0, 0.1, -0.2))
		watch(b, true)
	end
end

-- Kept for older callers
function People.apron(character, color)
	apron(body(character), color, false)
end

function People.bag(character, kind, color)
	local b = body(character)
	if kind == "backpack" and b.ut then
		backpack(b, color or P.indigo)
	end
end

return function(Registry)
	Registry.People = People
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000050"><Properties><string name="Name">RamenYa</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- "Ramen-ya" decoration pack, modelled on real ramen counters: industrial pendant lamps, a red
-- banner with white lettering, rows of menu posters, a retro ramen poster, a vertical sign, a
-- framed soup signboard, a wooden canopy over the counter, water pitchers, condiment caddies,
-- red vinyl stools and a wooden table with benches.
-- Conventions: front faces -Z; wall items have their back at +Z; ceiling items hang from y = h.
local CollectionService = game:GetService("CollectionService")

local Kit = require(script.Parent.Parent.Kit)
local P = require(script.Parent.Parent.Palette)
local Color = require(script.Parent.Parent.Parent.Util.Color)
local M = P.M

local JP_FONT = Font.new("rbxasset://fonts/families/FredokaOne.json", Enum.FontWeight.Bold)

local function size(item)
	return Vector3.new(item.size[1], item.size[2], item.size[3])
end

local function nc()
	return { collide = false, shadow = false }
end

local function point(root, name, x, y, z, yaw)
	local h = root.Size.Y
	return Kit.attach(root, name, CFrame.new(x, y - h / 2, z) * CFrame.Angles(0, math.rad(yaw or 0), 0))
end

-- Invisible panel carrying a text label. faces: nil = front (-Z), "back" = +Z, "both"
local function label(m, w, h, x, y, z, text, color, faces)
	local p = Kit.box(m, w, h, 0.02, x, y, z, P.white, M.smooth, { transparency = 1, collide = false, shadow = false })
	p.CanQuery = false
	if faces ~= "back" then
		Kit.text(p, Enum.NormalId.Front, text, { color = color, font = JP_FONT, pps = 40 })
	end
	if faces == "back" or faces == "both" then
		Kit.text(p, Enum.NormalId.Back, text, { color = color, font = JP_FONT, pps = 40 })
	end
	return p
end

-- Parts high under the ceiling hide in build view like the roof (see Camera.setRoofs)
local function high(p)
	CollectionService:AddTag(p, "Roof")
	return p
end

-- Industrial pendant: cord, black metal shade with a brass rim and a glowing glass globe
local function pendant(m, x, top, z, drop)
	high(Kit.cyl(m, 0.05, drop, x, top - drop / 2, z, P.black, M.fabric, nc()))
	local y = top - drop
	Kit.cyl(m, 0.18, 0.2, x, y - 0.05, z, P.charcoal, M.metal, nc())
	Kit.cyl(m, 0.72, 0.55, x, y - 0.4, z, P.charcoal, M.metal, { collide = false, shadow = false, reflectance = 0.1 })
	Kit.cyl(m, 0.76, 0.06, x, y - 0.68, z, P.brass, M.metal, nc())
	local bulb = Kit.ball(m, 0.62, x, y - 0.95, z, P.lamp, M.neon, { collide = false, shadow = false })
	bulb.Transparency = 0.1
	Kit.light(bulb, "Point", P.lamp_warm, 14, 1.2)
	return bulb
end

-- Hanging banner made of split cloth panels with lettering readable from both sides
local function banner(m, w, top, bottom, z, text, color)
	local n = math.max(2, math.floor(w / 1))
	local pw = w / n
	for i = 0, n - 1 do
		local x = -w / 2 + pw * (i + 0.5)
		local cloth = Kit.box(m, pw - 0.06, top - bottom, 0.04, x, (top + bottom) / 2, z, color, M.fabric, nc())
		cloth:SetAttribute("Animate", "sway")
		Kit.box(m, pw - 0.06, 0.1, 0.05, x, bottom + 0.12, z, P.lacquer_dark, M.fabric, nc())
	end
	Kit.box(m, w, 0.06, 0.05, 0, top - 0.12, z, P.white, M.fabric, nc())
	label(m, w - 0.4, (top - bottom) * 0.62, 0, (top + bottom) / 2 + 0.02, z - 0.04, text, "#FFFFFF", "both")
end

-- Bowl drawn flat (ellipses facing -Z): navy bowl, broth, noodles, egg, naruto and nori
local function bowlArt(m, x, y, z, s, broth)
	Kit.blob(m, 1.6 * s, 1.0 * s, 0.04, x, y, z, P.navy, M.smooth, nc())
	Kit.blob(m, 1.5 * s, 0.42 * s, 0.04, x, y + 0.27 * s, z - 0.02, broth or Color.hex("#D9A55A"), M.smooth, nc())
	for k = -2, 2 do
		Kit.box(m, 0.05 * s, 0.22 * s, 0.03, x + k * 0.12 * s, y + 0.3 * s, z - 0.04, P.neon_yellow, M.smooth, nc())
	end
	Kit.blob(m, 0.32 * s, 0.24 * s, 0.03, x - 0.4 * s, y + 0.3 * s, z - 0.05, P.white, M.smooth, nc())
	Kit.blob(m, 0.16 * s, 0.12 * s, 0.03, x - 0.4 * s, y + 0.3 * s, z - 0.06, P.koi_orange, M.smooth, nc())
	Kit.blob(m, 0.24 * s, 0.18 * s, 0.03, x + 0.42 * s, y + 0.3 * s, z - 0.05, P.white, M.smooth, nc())
	Kit.blob(m, 0.1 * s, 0.08 * s, 0.03, x + 0.42 * s, y + 0.3 * s, z - 0.06, P.sakura_dark, M.smooth, nc())
	Kit.box(m, 0.3 * s, 0.4 * s, 0.03, x + 0.62 * s, y + 0.5 * s, z - 0.03, P.nori, M.smooth, nc())
	-- chopsticks lifting noodles
	for k = 0, 1 do
		local cf = CFrame.new(x + (0.2 + k * 0.1) * s, y + 0.75 * s, z - 0.07) * CFrame.Angles(0, 0, math.rad(-28 - k * 6))
		Kit.part(m, Vector3.new(0.05 * s, 0.9 * s, 0.03), cf, P.wood_light, M.wood, nc())
	end
end

-- Row of colourful menu posters on a plane facing -Z (front face at z)
local POSTERS = {
	{ bg = "#FFD23B", text = "醤油", price = "¥780", broth = "#8A5A2E" },
	{ bg = "#F27A2E", text = "味噌", price = "¥850", broth = "#C88A3A" },
	{ bg = "#F7F5F0", text = "豚骨", price = "¥900", broth = "#EDE0C8" },
	{ bg = "#C0261E", text = "餃子", price = "¥450", broth = "#E3B070" },
	{ bg = "#FFD23B", text = "塩", price = "¥750", broth = "#EBD49A" },
	{ bg = "#F7F5F0", text = "炒飯", price = "¥600", broth = "#E8C25A" },
}

local function posterRow(m, x0, x1, y0, y1, z, count)
	local n = count or 5
	local pw = (x1 - x0) / n
	local ph = y1 - y0
	for i = 0, n - 1 do
		local info = POSTERS[i % #POSTERS + 1]
		local x = x0 + pw * (i + 0.5)
		local cy = (y0 + y1) / 2
		local bg = Color.hex(info.bg)
		Kit.box(m, pw - 0.08, ph, 0.03, x, cy, z + 0.015, bg, M.smooth, nc())
		-- photo of the dish
		Kit.box(m, pw - 0.3, ph * 0.42, 0.02, x, cy - ph * 0.02, z - 0.005, P.charcoal, M.smooth, nc())
		bowlArt(m, x, cy - ph * 0.06, z - 0.02, math.min(pw - 0.3, ph * 0.42) * 0.42, Color.hex(info.broth))
		local dark = info.bg == "#C0261E" or info.bg == "#F27A2E"
		label(m, pw - 0.2, ph * 0.26, x, y1 - ph * 0.16, z - 0.02, info.text, dark and "#FFFFFF" or "#C0261E")
		local tag = Kit.box(m, (pw - 0.08) * 0.62, ph * 0.16, 0.02, x, y0 + ph * 0.12, z - 0.01, dark and P.white or P.lacquer, M.smooth, nc())
		Kit.text(tag, Enum.NormalId.Front, info.price, { color = dark and "#C0261E" or "#FFFFFF", font = JP_FONT, pps = 40 })
		-- bits of tape on the top corners
		for _, sx in ipairs({ -1, 1 }) do
			Kit.box(m, 0.22, 0.08, 0.01, x + sx * (pw / 2 - 0.12), y1 - 0.04, z - 0.01, P.paper_warm, M.smooth, { collide = false, shadow = false, rot = CFrame.Angles(0, 0, math.rad(sx * 35)), transparency = 0.2 })
		end
	end
end

-- Small stainless water pitcher with a lid and a handle; bottom center at (x, y0, z)
local function pitcher(m, x, y0, z, s)
	s = s or 1
	Kit.cyl(m, 0.58 * s, 0.95 * s, x, y0 + 0.5 * s, z, P.metal, M.metal, { collide = false, reflectance = 0.25 })
	Kit.cyl(m, 0.62 * s, 0.06 * s, x, y0 + 0.04 * s, z, P.steel, M.metal, nc())
	Kit.cyl(m, 0.6 * s, 0.1 * s, x, y0 + 1.02 * s, z, P.steel, M.metal, nc())
	Kit.ball(m, 0.14 * s, x, y0 + 1.12 * s, z, P.charcoal, M.smooth, nc())
	Kit.wedge(m, 0.16 * s, 0.22 * s, 0.24 * s, CFrame.new(x, y0 + 0.92 * s, z - 0.36 * s), P.metal, M.metal, nc())
	for _, hy in ipairs({ 0.85, 0.3 }) do
		Kit.box(m, 0.08 * s, 0.07 * s, 0.26 * s, x, y0 + hy * s, z + 0.4 * s, P.metal, M.metal, nc())
	end
	Kit.box(m, 0.08 * s, 0.62 * s, 0.07 * s, x, y0 + 0.575 * s, z + 0.5 * s, P.metal, M.metal, nc())
end

return function(Registry)
	-- Lighting ------------------------------------------------------------------------------------
	Registry.register("pendant_lamp", function(m, item)
		Kit.finish(m, size(item))
		local h = item.size[2]
		pendant(m, 0, h, 0, h - 1.7)
		high(Kit.cyl(m, 0.4, 0.08, 0, h - 0.04, 0, P.charcoal, M.metal, nc()))
	end)

	Registry.register("chochin_orange", function(m, item)
		Kit.finish(m, size(item))
		local h = item.size[2]
		local bodyH, bodyD = 1.5, 1.15
		local cy = h - 0.6 - bodyH / 2
		high(Kit.cyl(m, 0.05, 0.6, 0, h - 0.3, 0, P.black, M.fabric, nc()))
		Kit.cyl(m, 0.7, 0.18, 0, cy + bodyH / 2 + 0.05, 0, P.black, M.smooth, nc())
		Kit.cyl(m, 0.7, 0.18, 0, cy - bodyH / 2 - 0.05, 0, P.black, M.smooth, nc())
		local body = Kit.blob(m, bodyD, bodyH, bodyD, 0, cy, 0, P.koi_orange, M.smooth, nc())
		for i = -2, 2 do
			local ring = 1 - (i * 0.18) ^ 2 * 1.2
			Kit.cyl(m, bodyD * ring + 0.02, 0.03, 0, cy + i * bodyH * 0.18, 0, P.vermilion, M.smooth, nc())
		end
		label(m, bodyD * 0.55, bodyH * 0.8, 0, cy, -bodyD / 2 - 0.01, "ラーメン", "#141414")
		label(m, bodyD * 0.55, bodyH * 0.8, 0, cy, bodyD / 2 + 0.01, "らーめん", "#141414", "back")
		Kit.light(body, "Point", P.lamp_warm, 12, 1.2)
		body:SetAttribute("Animate", "sway")
	end)

	-- Wooden canopy over the counter: hanging rods, frame, ribbed metal roof, red banner and
	-- three pendant lamps (the centrepiece of the ramen-ya look)
	Registry.register("ramenya_canopy", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		local frameY = h - 2.0
		for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }) do
			high(Kit.box(m, 0.1, 2.0, 0.1, c[1] * (w / 2 - 0.3), h - 1.0, c[2] * (d / 2 - 0.3), P.black, M.metal, nc()))
		end
		-- ribbed roof sheet sloping towards the customers
		local roof = Kit.box(m, w, 0.08, d, 0, frameY + 0.32, 0, P.steel, M.metal, { collide = false, rot = CFrame.Angles(math.rad(-6), 0, 0) })
		high(roof)
		for x = -w / 2 + 0.25, w / 2 - 0.2, 0.5 do
			high(Kit.box(m, 0.1, 0.08, d, x, frameY + 0.38, 0, P.metal, M.metal, { collide = false, shadow = false, rot = CFrame.Angles(math.rad(-6), 0, 0) }))
		end
		-- timber frame
		for _, z in ipairs({ -d / 2 + 0.15, d / 2 - 0.15 }) do
			high(Kit.box(m, w, 0.4, 0.3, 0, frameY, z, P.wood_dark, M.wood, nc()))
		end
		for _, x in ipairs({ -w / 2 + 0.15, 0, w / 2 - 0.15 }) do
			high(Kit.box(m, 0.25, 0.3, d - 0.3, x, frameY + 0.05, 0, P.wood_dark, M.wood, nc()))
		end
		Kit.box(m, w + 0.1, 0.12, 0.08, 0, frameY - 0.25, -d / 2 + 0.02, P.wood_black, M.wood, nc())
		-- red banner along the customer side and three pendant lamps
		banner(m, w - 0.2, frameY - 0.3, frameY - 1.3, -d / 2 + 0.1, "ラーメン ・ 餃子 ・ 炒飯", P.lacquer)
		for _, x in ipairs({ -w / 3, 0, w / 3 }) do
			pendant(m, x, frameY - 0.2, 0.35, 0.7)
		end
	end)

	-- Art & walls ---------------------------------------------------------------------------------
	Registry.register("noren_banner", function(m, item)
		Kit.finish(m, size(item))
		local w, h = item.size[1], item.size[2]
		high(Kit.cylH(m, 0.12, w + 0.2, 0, h - 0.12, 0, P.wood_dark, M.wood, nc()))
		for _, x in ipairs({ -w / 2 + 0.4, w / 2 - 0.4 }) do
			high(Kit.box(m, 0.06, 0.12, 0.06, x, h - 0.03, 0, P.black, M.metal, nc()))
		end
		banner(m, w, h - 0.18, 0.05, 0, "ラーメン ・ 餃子 ・ 炒飯", P.lacquer)
		-- round shop crest in the middle
		Kit.cylH(m, 0.9, 0.06, 0, h * 0.5, -0.06, P.white, M.fabric, nc(), "z")
		label(m, 0.7, 0.7, 0, h * 0.5, -0.1, "麺", "#B3262E")
	end)

	Registry.register("menu_posters", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		posterRow(m, -w / 2 + 0.1, w / 2 - 0.1, 0.1, h - 0.1, d / 2 - 0.06, 5)
	end)

	Registry.register("ramen_poster", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		local z = d / 2 - 0.04
		Kit.box(m, w, h, 0.05, 0, h / 2, z, P.cream, M.smooth, nc())
		Kit.box(m, w - 0.3, h - 0.3, 0.03, 0, h / 2, z - 0.04, P.lacquer, M.smooth, nc())
		label(m, w - 0.5, 0.7, 0, h - 0.6, z - 0.07, "ラーメン", "#FFF3E0")
		bowlArt(m, 0, h * 0.42, z - 0.07, 0.85)
		-- steam
		for k = -1, 1 do
			for j = 0, 2 do
				Kit.box(m, 0.05, 0.22, 0.02, k * 0.3 + (j % 2) * 0.06, h * 0.42 + 0.75 + j * 0.2, z - 0.07, P.white, M.smooth, { collide = false, shadow = false, rot = CFrame.Angles(0, 0, math.rad((j % 2 == 0) and 20 or -20)), transparency = 0.2 })
			end
		end
		Kit.cylH(m, 0.7, 0.03, w / 2 - 0.55, 0.6, z - 0.07, P.white, M.smooth, nc(), "z")
		label(m, 0.5, 0.5, w / 2 - 0.55, 0.6, z - 0.1, "開店", "#C0261E")
		label(m, w - 1.4, 0.35, -0.35, 0.55, z - 0.07, "since 1987", "#FFF3E0")
	end)

	Registry.register("ramen_sign_vertical", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		local z = d / 2 - 0.08
		Kit.box(m, w, h - 0.5, 0.15, 0, (h - 0.5) / 2, z, P.lacquer, M.smooth, nc())
		for _, x in ipairs({ -w / 2 + 0.12, w / 2 - 0.12 }) do
			Kit.box(m, 0.06, h - 0.8, 0.02, x, (h - 0.5) / 2, z - 0.085, P.cream, M.smooth, nc())
		end
		label(m, w - 0.4, h - 1.2, 0, (h - 0.5) / 2, z - 0.09, "ラ\nー\nメ\nン", "#FFFFFF")
		-- little tiled cap and a lamp arm lighting the sign
		Kit.wedge(m, w + 0.3, 0.35, 0.4, CFrame.new(0, h - 0.33, z - 0.05), P.tile, M.roof, nc())
		Kit.box(m, 0.08, 0.08, 0.6, 0, h - 0.1, z - 0.35, P.black, M.metal, nc())
		local head = Kit.box(m, 0.4, 0.2, 0.25, 0, h - 0.18, z - 0.65, P.charcoal, M.metal, nc())
		Kit.light(head, "Spot", P.lamp_warm, 8, 1.4, { face = Enum.NormalId.Bottom, angle = 70 })
	end)

	Registry.register("soup_sign", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		local z = d / 2 - 0.1
		Kit.box(m, w, h, 0.2, 0, h / 2, z, P.wood_dark, M.wood, nc())
		Kit.box(m, w - 0.4, h - 0.4, 0.04, 0, h / 2, z - 0.12, P.paper_warm, M.smooth, nc())
		label(m, w * 0.55, h * 0.55, w * 0.12, h * 0.48, z - 0.15, "秘伝スープ", "#C0261E")
		label(m, w * 0.22, h * 0.7, -w / 2 + w * 0.15, h / 2, z - 0.15, "当店\n自慢", "#2B2320")
		Kit.cylH(m, 0.8, 0.03, w / 2 - 0.65, h - 0.6, z - 0.15, P.lacquer, M.smooth, nc(), "z")
		label(m, 0.6, 0.6, w / 2 - 0.65, h - 0.6, z - 0.18, "極", "#FFFFFF")
		label(m, w * 0.5, h * 0.18, w * 0.12, 0.45, z - 0.15, "豚骨 ・ 鶏ガラ ・ 魚介", "#2B2320")
		-- two small spotlights above
		for _, x in ipairs({ -w / 4, w / 4 }) do
			Kit.box(m, 0.08, 0.08, 0.5, x, h - 0.05, z - 0.3, P.black, M.metal, nc())
			local head = Kit.cyl(m, 0.3, 0.3, x, h - 0.1, z - 0.55, P.charcoal, M.metal, nc())
			Kit.light(head, "Spot", P.lamp_warm, 8, 1.2, { face = Enum.NormalId.Bottom, angle = 80 })
		end
	end)

	-- On the table (top items) ------------------------------------------------------------------------
	Registry.register("water_pitcher", function(m, item)
		Kit.finish(m, size(item))
		pitcher(m, 0, 0, 0, 1)
		-- two stacked glasses beside it
		for k = 0, 1 do
			Kit.cyl(m, 0.26, 0.3, 0.3, 0.15 + k * 0.08, -0.25, P.glass, M.glass, { collide = false, shadow = false, transparency = 0.35 })
		end
	end)

	-- Tip jar: tips pile up inside (the "Coins" part grows, set by EconomyService); click to collect
	Registry.register("tip_jar", function(m, item)
		Kit.finish(m, size(item))
		Kit.cyl(m, 0.8, 0.06, 0, 0.03, 0, P.wood_dark, M.wood, nc())
		Kit.cyl(m, 0.72, 1.0, 0, 0.56, 0, P.glass, M.glass, { collide = false, shadow = false, transparency = 0.6, reflectance = 0.2 })
		Kit.cyl(m, 0.76, 0.08, 0, 1.08, 0, P.brass, M.metal, nc())
		local coins = Kit.cyl(m, 0.66, 0.05, 0, 0.09, 0, P.gold, M.metal, { collide = false, name = "Coins", reflectance = 0.25 })
		coins:SetAttribute("Base", 0.09)
		label(m, 0.5, 0.26, 0, 0.62, -0.37, "チップ", "#B3262E")
	end)

	Registry.register("condiment_caddy", function(m, item)
		Kit.finish(m, size(item))
		Kit.box(m, 1.5, 0.08, 0.6, 0, 0.04, 0, P.steel, M.metal, { reflectance = 0.1 })
		-- chopstick holder with a bundle of waribashi
		Kit.cyl(m, 0.36, 0.6, -0.5, 0.38, 0, P.koi_orange, M.smooth, nc())
		for k = 0, 5 do
			local a = k * math.pi / 3
			Kit.box(m, 0.04, 0.9, 0.04, -0.5 + math.cos(a) * 0.08, 0.6, math.sin(a) * 0.08, P.hinoki, M.wood, { collide = false, shadow = false, rot = CFrame.Angles(math.sin(a) * 0.06, 0, -math.cos(a) * 0.06) })
		end
		-- jars with red lids: garlic, chili oil
		for i, c in ipairs({ P.cream, P.vermilion }) do
			local x = -0.1 + (i - 1) * 0.32
			Kit.cyl(m, 0.28, 0.32, x, 0.24, 0.08, P.glass, M.glass, { collide = false, shadow = false, transparency = 0.3 })
			Kit.cyl(m, 0.24, 0.2, x, 0.19, 0.08, c, M.sand, nc())
			Kit.cyl(m, 0.3, 0.08, x, 0.44, 0.08, P.red, M.smooth, nc())
		end
		-- pepper can and tissue box
		Kit.cyl(m, 0.22, 0.45, 0.58, 0.31, 0.12, P.navy, M.metal, nc())
		Kit.cyl(m, 0.23, 0.05, 0.58, 0.55, 0.12, P.metal, M.metal, nc())
		Kit.box(m, 0.36, 0.28, 0.26, 0.5, 0.22, -0.16, P.white, M.smooth, nc())
		Kit.box(m, 0.14, 0.1, 0.12, 0.5, 0.4, -0.16, P.white, M.fabric, nc())
	end)

	Registry.register("counter_posters", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		-- stainless pass shelf: front panel with menu posters, top shelf with pitchers
		Kit.box(m, w, h - 0.1, 0.06, 0, (h - 0.1) / 2, -d / 2 + 0.03, P.steel_dark, M.metal)
		Kit.box(m, w, 0.08, d, 0, h - 0.04, 0, P.metal, M.metal, { reflectance = 0.2 })
		for _, x in ipairs({ -w / 2 + 0.05, w / 2 - 0.05 }) do
			Kit.box(m, 0.08, h - 0.1, d - 0.06, x, (h - 0.1) / 2, 0.03, P.steel, M.metal, nc())
		end
		posterRow(m, -w / 2 + 0.1, w / 2 - 0.1, 0.12, h - 0.18, -d / 2 - 0.01, 5)
		pitcher(m, -w / 2 + 0.6, h, 0, 0.7)
		pitcher(m, w / 2 - 0.6, h, 0, 0.7)
	end)

	-- Seating -------------------------------------------------------------------------------------
	Registry.register("stool_red", function(m, item)
		local root = Kit.finish(m, size(item))
		local h = item.size[2]
		Kit.cyl(m, 1.3, 0.1, 0, 0.05, 0, P.black, M.metal)
		Kit.cyl(m, 0.24, h - 0.5, 0, (h - 0.5) / 2 + 0.05, 0, P.black, M.metal, { reflectance = 0.1 })
		Kit.cyl(m, 1.0, 0.06, 0, 0.95, 0, P.black, M.metal, nc())
		Kit.cyl(m, 1.1, 0.1, 0, h - 0.5, 0, P.charcoal, M.metal, nc())
		Kit.cyl(m, 1.55, 0.4, 0, h - 0.22, 0, P.lacquer, M.smooth, { reflectance = 0.08 })
		Kit.blob(m, 1.5, 0.22, 1.5, 0, h - 0.02, 0, P.lacquer, M.smooth, { collide = false, reflectance = 0.08 })
		Kit.cyl(m, 1.58, 0.05, 0, h - 0.4, 0, P.lacquer_dark, M.smooth, nc())
		point(root, "SitPoint", 0, h, 0, 0)
	end)

	-- Wooden table with two benches (works like a booth: four seats with their own dish spots)
	Registry.register("bench_table", function(m, item)
		local root = Kit.finish(m, size(item))
		local w = item.size[1]
		-- trestle table
		Kit.box(m, w - 0.6, 0.2, 2, 0, 2.6, 0, P.wood, M.wood)
		Kit.box(m, w - 0.5, 0.06, 2.1, 0, 2.48, 0, P.wood_dark, M.wood, nc())
		for _, x in ipairs({ -w / 2 + 0.9, w / 2 - 0.9 }) do
			Kit.box(m, 0.3, 2.4, 0.3, x, 1.3, 0, P.wood_dark, M.wood)
			Kit.box(m, 0.3, 0.2, 1.6, x, 0.1, 0, P.wood_dark, M.wood)
			Kit.box(m, 0.25, 0.2, 1.6, x, 2.38, 0, P.wood_dark, M.wood, nc())
		end
		Kit.box(m, w - 1.8, 0.2, 0.2, 0, 0.9, 0, P.wood_dark, M.wood, nc())
		-- benches
		local df = Kit.detail(m, "furnish")
		for side = -1, 1, 2 do
			local z = side * 1.85
			Kit.box(m, w - 0.4, 0.2, 1.0, 0, 1.8, z, P.wood, M.wood)
			for _, x in ipairs({ -w / 2 + 0.6, w / 2 - 0.6 }) do
				Kit.box(m, 0.25, 1.7, 0.8, x, 0.85, z, P.wood_dark, M.wood)
			end
			Kit.box(m, w - 1.4, 0.15, 0.15, 0, 0.6, z, P.wood_dark, M.wood, nc())
			for _, x in ipairs({ -1.2, 1.2 }) do
				Kit.box(df, 1.3, 0.12, 0.85, x, 1.96, z, side < 0 and P.indigo or P.lacquer, M.fabric, nc())
			end
		end
		local dt = Kit.detail(m, "tableware")
		pitcher(dt, -0.4, 2.7, 0, 0.6)
		Kit.box(dt, 0.8, 0.06, 0.4, 0.4, 2.73, 0, P.steel, M.metal, nc())
		Kit.cyl(dt, 0.24, 0.45, 0.2, 2.95, 0, P.koi_orange, M.smooth, nc())
		Kit.cyl(dt, 0.2, 0.3, 0.55, 2.9, 0, P.red, M.smooth, nc())
		local i = 0
		for side = -1, 1, 2 do
			for _, x in ipairs({ -1.2, 1.2 }) do
				i += 1
				point(root, "Seat" .. i, x, 1.9, side * 1.85, side < 0 and 180 or 0)
				point(root, "Dish" .. i, x, 2.7, side * 0.55, 0)
			end
		end
		root:SetAttribute("TopY", 2.7)
	end)
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000051"><Properties><string name="Name">Street</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Street scenery: road, sidewalks, neighbour buildings, lamps, poles, trees, viaduct, truck, train.
local Kit = require(script.Parent.Parent.Kit)
local P = require(script.Parent.Parent.Palette)
local Color = require(script.Parent.Parent.Parent.Util.Color)
local M = P.M

local JP_FONT = Font.new("rbxasset://fonts/families/FredokaOne.json", Enum.FontWeight.Bold)
local S = {}

local SIGNS = { "居酒屋", "本屋", "薬局", "喫茶", "花屋", "銭湯", "焼鳥", "古着", "時計", "果物", "団子", "書道" }

local function rng(seed)
	return Random.new(seed or 7)
end

local function NC()
	return { collide = false, shadow = false }
end

-- Outdoor AC unit with a round fan grille, mounted on the wall
local function acUnit(parent, x, y, face, facing)
	local z = face - facing * 0.4
	Kit.box(parent, 1.6, 1.1, 0.7, x, y, z, P.stone_light, M.smooth, NC())
	Kit.cylH(parent, 0.8, 0.04, x - 0.25, y, z - facing * 0.36, P.steel_dark, M.metal, NC(), "z")
	Kit.cylH(parent, 0.2, 0.05, x - 0.25, y, z - facing * 0.38, P.metal, M.metal, NC(), "z")
	Kit.box(parent, 1.4, 0.08, 0.6, x, y - 0.6, z + facing * 0.05, P.steel_dark, M.metal, NC())
	Kit.cyl(parent, 0.12, 1.2, x + 0.6, y + 0.9, face - facing * 0.15, P.white, M.smooth, NC())
end

-- Apartment balcony: slab, frosted panel railing and (sometimes) laundry on a pole
local function balcony(parent, x, y, face, facing, r)
	local z = face - facing * 0.7
	Kit.box(parent, 3.6, 0.2, 1.4, x, y - 1.55, z, P.stone_light, M.concrete, NC())
	local panel = Kit.box(parent, 3.6, 1.2, 0.08, x, y - 0.85, face - facing * 1.38, P.metal, M.glass, NC())
	panel.Transparency = 0.35
	Kit.box(parent, 3.7, 0.1, 0.14, x, y - 0.22, face - facing * 1.38, P.steel_dark, M.metal, NC())
	if r:NextNumber() < 0.6 then
		Kit.cylH(parent, 0.08, 3.2, x, y + 0.9, face - facing * 0.9, P.metal, M.metal, NC())
		local colors = { P.white, P.sakura, P.navy, P.leaf_light, P.neon_yellow, P.indigo }
		for k = 0, r:NextInteger(1, 3) do
			local c = colors[r:NextInteger(1, #colors)]
			local cw = 0.6 + r:NextNumber() * 0.5
			Kit.box(parent, cw, 0.8 + r:NextNumber() * 0.4, 0.05, x - 1.2 + k * 0.85, y + 0.45, face - facing * 0.9, c, M.fabric, NC())
		end
	end
end

-- Chalkboard A-frame sign on the sidewalk
local function aframe(parent, x, z, facing)
	Kit.box(parent, 1.1, 1.6, 0.08, x, 0.4, z - facing * 0.25, P.wood_dark, M.wood, { collide = false, shadow = false, rot = CFrame.Angles(math.rad(12), 0, 0) })
	Kit.box(parent, 0.9, 1.2, 0.04, x, 0.45, z - facing * 0.32, P.charcoal, M.slate, { collide = false, shadow = false, rot = CFrame.Angles(math.rad(12), 0, 0) })
	Kit.box(parent, 1.1, 1.6, 0.08, x, 0.4, z + facing * 0.25, P.wood_dark, M.wood, { collide = false, shadow = false, rot = CFrame.Angles(math.rad(-12), 0, 0) })
end

-- Part placed in the local frame of `base`
local function lp(parent, base, sx, sy, sz, lx, ly, lz, rot, color, mat, props)
	local cf = base * CFrame.new(lx, ly, lz)
	if rot then
		cf = cf * rot
	end
	return Kit.part(parent, Vector3.new(sx, sy, sz), cf, color, mat, props)
end

-- Japanese city bicycle (mamachari) with a front basket; yaw in degrees, ground at -0.4
function S.bicycle(parent, x, z, yaw, color)
	local base = CFrame.new(x, -0.4, z) * CFrame.Angles(0, math.rad(yaw or 0), 0)
	local wheel = CFrame.Angles(0, math.rad(90), 0)
	for _, wx in ipairs({ -1.1, 1.1 }) do
		lp(parent, base, 0.12, 1.7, 1.7, wx, 0.85, 0, wheel, P.charcoal, M.smooth, { collide = false, shadow = false, shape = Enum.PartType.Cylinder })
		lp(parent, base, 0.13, 1.3, 1.3, wx, 0.85, 0, wheel, P.metal, M.metal, { collide = false, shadow = false, shape = Enum.PartType.Cylinder })
	end
	lp(parent, base, 1.4, 0.12, 0.12, -0.35, 1.25, 0, CFrame.Angles(0, 0, math.rad(-35)), color, M.metal, NC())
	lp(parent, base, 1.3, 0.12, 0.12, 0.3, 1.1, 0, CFrame.Angles(0, 0, math.rad(20)), color, M.metal, NC())
	lp(parent, base, 0.12, 1.2, 0.12, -0.45, 1.4, 0, CFrame.Angles(0, 0, math.rad(-15)), color, M.metal, NC())
	lp(parent, base, 0.7, 0.18, 0.35, -0.6, 2.05, 0, nil, P.charcoal, M.leather, NC())
	lp(parent, base, 0.12, 1.1, 0.12, 0.95, 1.5, 0, CFrame.Angles(0, 0, math.rad(15)), color, M.metal, NC())
	lp(parent, base, 0.1, 0.1, 1.2, 0.85, 2.05, 0, nil, P.metal, M.metal, NC())
	lp(parent, base, 0.7, 0.5, 0.8, 1.4, 1.75, 0, nil, P.metal, M.metal, { collide = false, shadow = false, transparency = 0.3 })
	lp(parent, base, 0.9, 0.06, 0.6, -1.1, 1.75, 0, nil, P.metal, M.metal, NC())
	lp(parent, base, 0.6, 0.6, 0.06, -0.9, 0.5, 0.2, nil, color, M.metal, NC())
end

-- Round-topped red post box
function S.postBox(parent, x, z)
	Kit.box(parent, 0.5, 1.6, 0.5, x, 0.4, z, P.charcoal, M.metal)
	Kit.box(parent, 1.4, 2.0, 1.1, x, 2.2, z, P.red, M.metal)
	Kit.cylH(parent, 1.1, 1.4, x, 3.2, z, P.red, M.metal, NC(), "z")
	Kit.box(parent, 1.0, 0.12, 0.06, x, 2.8, z - 0.56, P.charcoal, M.metal, NC())
	local plate = Kit.box(parent, 0.6, 0.5, 0.04, x, 2.1, z - 0.57, P.white, M.smooth, NC())
	Kit.text(plate, Enum.NormalId.Front, "〒", { color = "#C0261E", font = JP_FONT })
end

-- Pair of recycling bins next to a vending machine
function S.bins(parent, x, z)
	for k, c in ipairs({ P.indigo, P.matcha }) do
		local bx = x + (k - 1.5) * 1.1
		Kit.box(parent, 1, 1.8, 1, bx, 0.5, z, c, M.plastic, NC())
		Kit.box(parent, 1.05, 0.15, 1.05, bx, 1.45, z, P.white, M.plastic, NC())
		Kit.cyl(parent, 0.4, 0.05, bx, 1.53, z, P.charcoal, M.smooth, NC())
	end
end

-- Round traffic sign on a pole (kind = "walk" blue, "stop" red triangle)
function S.trafficSign(parent, x, z, kind)
	Kit.cyl(parent, 0.18, 7, x, 3.1, z, P.metal, M.metal)
	if kind == "stop" then
		local tri = Kit.wedge(parent, 0.08, 1.6, 0.9, CFrame.new(x, 6.2, z - 0.45) * CFrame.Angles(0, math.rad(90), 0), P.red, M.smooth, NC())
		local _ = tri
		Kit.wedge(parent, 0.08, 1.6, 0.9, CFrame.new(x, 6.2, z + 0.45) * CFrame.Angles(0, math.rad(-90), 0), P.red, M.smooth, NC())
		local plate = Kit.box(parent, 1.4, 0.5, 0.06, x, 5.1, z, P.white, M.smooth, NC())
		Kit.text(plate, Enum.NormalId.Back, "止まれ", { color = "#C0261E", font = JP_FONT })
	else
		Kit.box(parent, 1.4, 1.4, 0.08, x, 6, z, P.navy, M.smooth, NC())
		Kit.wedge(parent, 0.04, 0.9, 0.5, CFrame.new(x - 0.25, 6, z - 0.06) * CFrame.Angles(0, math.rad(90), 0), P.white, M.smooth, NC())
		Kit.wedge(parent, 0.04, 0.9, 0.5, CFrame.new(x + 0.25, 6, z - 0.06) * CFrame.Angles(0, math.rad(-90), 0), P.white, M.smooth, NC())
	end
end

-- Manhole cover, optionally steaming
function S.manhole(parent, x, y, z, steam)
	local m = Kit.cyl(parent, 2, 0.06, x, y, z, P.stone_dark, M.metal, NC())
	Kit.cyl(parent, 1.6, 0.07, x, y, z, P.steel_dark, M.metal, NC())
	Kit.cyl(parent, 0.7, 0.08, x, y, z, P.stone_dark, M.metal, NC())
	if steam then
		Kit.particles(m, "steam", { rate = 3 })
	end
end

-- Zebra crossing across the road (road along X, centered on z), with stop lines
function S.crosswalk(parent, x, y, z, roadWidth, barLength)
	local bl = barLength or 4
	local n = math.floor(roadWidth / 1.6)
	for i = 0, n - 1 do
		Kit.box(parent, bl, 0.04, 0.8, x, y, z - roadWidth / 2 + 0.8 + i * 1.6, P.road_line, M.smooth, NC())
	end
	Kit.box(parent, 0.4, 0.04, roadWidth / 2 - 0.4, x - bl / 2 - 2, y, z + roadWidth / 4, P.road_line, M.smooth, NC())
	Kit.box(parent, 0.4, 0.04, roadWidth / 2 - 0.4, x + bl / 2 + 2, y, z - roadWidth / 4, P.road_line, M.smooth, NC())
	local word = Kit.box(parent, 3.2, 0.04, 1.6, x - bl / 2 - 4.5, y, z + roadWidth / 4, P.road, M.asphalt, NC())
	word.Transparency = 1
	Kit.text(word, Enum.NormalId.Top, "止まれ", { color = "#E8E4D8", font = JP_FONT, rotation = 90 })
end

-- Facade block with windows and an optional shop front. k scales every detail (doors, windows,
-- floors) so big buildings keep human-sized openings; detail = balconies, AC units, signs (off
-- for buildings far from the restaurant to keep the part count low).
function S.building(parent, x0, x1, zFront, depth, height, facing, color, r, k, detail)
	k = k or 1
	if detail == nil then
		detail = true
	end
	local w = x1 - x0
	local cx = (x0 + x1) / 2
	local cz = zFront + facing * depth / 2
	local body = Kit.box(parent, w, height, depth, cx, -0.4 + height / 2, cz, color, M.plaster, { collide = true })
	body.CastShadow = true
	local face = zFront - facing * 0.05
	-- shop front at street level (one or two shops)
	local awning = ({ P.lacquer, P.indigo, P.matcha, P.wood_dark, P.navy })[r:NextInteger(1, 5)]
	local shops = w > 30 and 2 or 1
	for si = 0, shops - 1 do
		local sw = w / shops
		local scx = x0 + sw * (si + 0.5)
		Kit.box(parent, sw - 1, 4.2 * k, 0.2, scx, 2.1 * k - 0.4, face, P.wood_dark, M.wood, { collide = false })
		local glass = Kit.box(parent, sw - 2, 3.4 * k, 0.1, scx, 2.0 * k - 0.4, face - facing * 0.12, P.paper_warm, M.neon, { collide = false })
		glass.Transparency = 0.3
		local panes = math.max(2, math.floor((sw - 2) / (2.2 * k)))
		for i = 1, panes - 1 do
			Kit.box(parent, 0.12 * k, 3.4 * k, 0.14, scx - sw / 2 + 1 + (sw - 2) * i / panes, 1.6 * k, face - facing * 0.16, P.wood_dark, M.wood, NC())
		end
		Kit.box(parent, sw - 2, 0.12 * k, 0.14, scx, 2.4 * k, face - facing * 0.16, P.wood_dark, M.wood, NC())
		for kk = -1, 1 do
			Kit.box(parent, 0.95 * k, 1.3 * k, 0.05, scx + kk * k, 2.75 * k, face - facing * 0.3, awning, M.fabric, NC())
		end
		Kit.wedge(parent, sw - 0.5, 0.8 * k, 1.6 * k, CFrame.new(scx, 4.8 * k - 0.4, face - facing * 0.8 * k) * CFrame.Angles(0, math.rad(facing < 0 and 180 or 0), 0), awning, M.fabric, { collide = false })
		local shopSign = Kit.box(parent, math.min(sw - 2, 6 * k), 1.1 * k, 0.15, scx, 5.8 * k - 0.4, face - facing * 0.15, P.paper, M.smooth, { collide = false })
		Kit.text(shopSign, facing < 0 and Enum.NormalId.Back or Enum.NormalId.Front, SIGNS[r:NextInteger(1, #SIGNS)], { color = "#2B2320", font = JP_FONT })
		if detail then
			local extra = r:NextNumber()
			if extra < 0.3 then
				aframe(parent, scx + sw / 2 - 1.6, face - facing * 1.6, facing)
			elseif extra < 0.55 then
				Kit.cyl(parent, 1.2, 1.1, scx - sw / 2 + 1.4, 0.15, face - facing * 0.9, P.stone_dark, M.concrete, NC())
				Kit.ball(parent, 1.6, scx - sw / 2 + 1.4, 1.3, face - facing * 0.9, P.leaf, M.leafy, NC())
			elseif extra < 0.75 then
				S.bicycle(parent, scx - sw / 2 + 2.2, face - facing * 1.3, facing < 0 and 0 or 180, ({ P.white, P.navy, P.lacquer, P.matcha })[r:NextInteger(1, 4)])
			end
		end
	end
	-- upper floor windows (lit at night)
	local floorH = 5 * k
	local first = 9 * k
	local floors = math.floor((height - first + 1) / floorH)
	for f = 0, floors - 1 do
		local y = first + f * floorH - 0.4
		local n = math.max(1, math.floor(w / (5 * k)))
		for i = 0, n - 1 do
			local x = x0 + w / n * (i + 0.5)
			local lit = r:NextNumber() < 0.55
			Kit.box(parent, 2.7 * k, 2.9 * k, 0.08, x, y, face - facing * 0.03, P.charcoal, M.metal, NC())
			local win = Kit.box(parent, 2.4 * k, 2.6 * k, 0.1, x, y, face - facing * 0.06, lit and P.lamp or P.steel_dark, lit and M.neon or M.glass, { collide = false, shadow = false })
			if lit then
				win.Transparency = 0.25
			end
			if detail then
				Kit.box(parent, 0.08, 2.6 * k, 0.12, x, y, face - facing * 0.1, P.charcoal, M.metal, NC())
				Kit.box(parent, 2.8 * k, 0.25, 0.4, x, y - 1.45 * k, face - facing * 0.2, P.wood_dark, M.wood, { collide = false })
				local roll = r:NextNumber()
				if roll < 0.25 then
					balcony(parent, x, y, face, facing, r)
				elseif roll < 0.42 then
					acUnit(parent, x + 2 * k, y - 0.9 * k, face, facing)
				elseif roll < 0.52 then
					for kk = -1, 1 do
						Kit.box(parent, 0.4, 0.35, 0.3, x + kk * 0.7, y - 1.15 * k, face - facing * 0.25, P.vermilion, M.smooth, NC())
						Kit.ball(parent, 0.5, x + kk * 0.7, y - 1.15 * k + 0.3, face - facing * 0.25, kk == 0 and P.sakura or P.leaf, M.leafy, NC())
					end
				end
			end
		end
	end
	-- floor bands between storeys
	for f = 1, floors do
		Kit.box(parent, w + 0.1, 0.3, 0.3, cx, first + (f - 0.5) * floorH - 0.4 - 0.3, face - facing * 0.1, color:Lerp(P.black, 0.18), M.concrete, NC())
	end
	-- drain pipe and roof furniture
	Kit.cyl(parent, 0.3 * k, height - 0.5, x1 - 0.35 * k, height / 2 - 0.4, face - facing * 0.2, P.stone_dark, M.metal, NC())
	local roofY = height - 0.4 + 0.6
	local roof = r:NextNumber()
	if roof < 0.35 then
		local tx, tz = cx - w / 4, cz
		for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }) do
			Kit.box(parent, 0.3, 2.2, 0.3, tx + c[1] * 1.3 * k, roofY + 1.1, tz + c[2] * 1.3 * k, P.steel_dark, M.metal, NC())
		end
		Kit.cyl(parent, 4 * k, 4 * k, tx, roofY + 2.2 + 2 * k, tz, P.stone_light, M.concrete, NC())
		Kit.cyl(parent, 4.1 * k, 0.3, tx, roofY + 2.2 + 4 * k, tz, P.steel, M.metal, NC())
	elseif roof < 0.6 then
		Kit.cyl(parent, 0.2, 7 * k, cx + w / 4, roofY + 3.5 * k, cz, P.metal, M.metal, NC())
		for kk = 0, 2 do
			Kit.cylH(parent, 0.12, (1.6 - kk * 0.4) * 2 * k, cx + w / 4, roofY + 4 * k + kk * k, cz, P.metal, M.metal, NC())
		end
		for kk = 0, 2 do
			Kit.box(parent, 2.6 * k, 1.8 * k, 1.2 * k, cx - w / 4 + kk * 3 * k, roofY + 0.9 * k, cz, P.stone_light, M.smooth, NC())
		end
	elseif roof < 0.8 then
		local bw = math.min(w - 2, 16 * k)
		local bb = Kit.box(parent, bw, 5 * k, 0.4, cx, roofY + 4.5 * k, zFront + facing * 4, P.white, M.smooth, NC())
		Kit.text(bb, facing < 0 and Enum.NormalId.Back or Enum.NormalId.Front, ({ "ラーメン", "寿司", "カメラ", "牛乳", "ビール", "茶", "本屋", "薬局" })[r:NextInteger(1, 8)], { color = ({ "#C0261E", "#1E2A44", "#2F5A2A" })[r:NextInteger(1, 3)], font = JP_FONT })
		for _, bx in ipairs({ -bw / 3, bw / 3 }) do
			Kit.box(parent, 0.4, 2 * k, 0.4, cx + bx, roofY + k, zFront + facing * 4, P.steel_dark, M.metal, NC())
		end
	end
	-- vertical neon sign
	if detail and r:NextNumber() < 0.6 then
		local vs = Kit.box(parent, 1.2 * k, 5 * k, 0.3, x0 + 1 * k, math.min(height * 0.5, 18 * k), face - facing * 0.9 * k, P.charcoal, M.smooth, { collide = false })
		local word = SIGNS[r:NextInteger(1, #SIGNS)]
		local vertical = ""
		for _, c in utf8.codes(word) do
			vertical ..= utf8.char(c) .. "\n"
		end
		Kit.text(vs, facing < 0 and Enum.NormalId.Back or Enum.NormalId.Front, vertical, { color = ({ "#FF3B4A", "#3BC8FF", "#FFD23B", "#FF5AC8" })[r:NextInteger(1, 4)], glow = true, font = JP_FONT })
	end
	-- roof edge
	Kit.box(parent, w + 0.4, 0.6 * k, depth + 0.4, cx, height - 0.4 + 0.3 * k, cz, P.charcoal, M.roof, { collide = false })
	return body
end

function S.lamp(parent, x, z, facing, k)
	k = k or 1
	Kit.cyl(parent, 0.35 * k, 9 * k, x, -0.4 + 4.5 * k, z, P.charcoal, M.metal)
	Kit.cylH(parent, 0.2 * k, 2.4 * k, x, 8.4 * k, z + facing * 1.2 * k, P.charcoal, M.metal, { collide = false }, "z")
	local head = Kit.box(parent, 0.9 * k, 0.4 * k, 1.2 * k, x, 8.2 * k, z + facing * 2.2 * k, P.lamp, M.neon, { collide = false })
	Kit.light(head, "Spot", P.lamp_warm, 26 * k, 2, { face = Enum.NormalId.Bottom, angle = 100 })
end

function S.pole(parent, x, z, k)
	k = k or 1
	Kit.cyl(parent, 0.6 * k, 16 * k, x, -0.4 + 8 * k, z, P.stone_light, M.concrete)
	-- yellow and black guard sleeve, step bolts and an address plate
	for k = 0, 3 do
		Kit.cyl(parent, 0.66, 0.45, x, 0.05 + k * 0.45, z, k % 2 == 0 and P.neon_yellow or P.black, M.smooth, NC())
	end
	for k = 0, 4 do
		Kit.cylH(parent, 0.08, 0.9, x, 6 + k * 1.2, z, P.steel_dark, M.metal, NC(), k % 2 == 0 and "z" or nil)
	end
	Kit.box(parent, 0.5, 1.6, 0.66, x, 4, z, P.navy, M.smooth, NC())
	Kit.cylH(parent, 0.25 * k, 3 * k, x, 14.5 * k, z, P.wood_dark, M.wood, { collide = false })
	Kit.cylH(parent, 0.25 * k, 2.4 * k, x, 13.2 * k, z, P.wood_dark, M.wood, { collide = false })
	Kit.cyl(parent, 0.8 * k, 1.2 * k, x + 0.6 * k, 12 * k, z + 0.5 * k, P.metal, M.metal, { collide = false })
end

function S.wire(parent, a, b, sag)
	local n = 6
	for i = 0, n - 1 do
		local t1, t2 = i / n, (i + 1) / n
		local p1 = a:Lerp(b, t1) - Vector3.new(0, sag * math.sin(math.pi * t1), 0)
		local p2 = a:Lerp(b, t2) - Vector3.new(0, sag * math.sin(math.pi * t2), 0)
		Kit.part(parent, Vector3.new(0.06, 0.06, (p2 - p1).Magnitude), CFrame.lookAt((p1 + p2) / 2, p2), P.black, M.smooth, { collide = false, shadow = false })
	end
end

function S.planterTree(parent, x, z, color, k)
	k = k or 1
	Kit.box(parent, 3 * k, 0.8, 3 * k, x, 0, z, P.stone, M.concrete)
	Kit.box(parent, 2.6 * k, 0.1, 2.6 * k, x, 0.4, z, P.wood_dark, M.sand, { collide = false })
	Kit.cyl(parent, 0.6 * k, 6 * k, x, 0.4 + 3 * k, z, P.wood_dark, M.wood)
	for _, b in ipairs({ { 0, 7.5, 0, 5 }, { -1.4, 6.6, 0.6, 3.4 }, { 1.4, 6.8, -0.5, 3.6 }, { 0.4, 8.6, 0.4, 3 } }) do
		Kit.blob(parent, b[4] * k, b[4] * 0.7 * k, b[4] * k, x + b[1] * k, b[2] * k, z + b[3] * k, color, M.leafy, { collide = false })
	end
end

function S.viaduct(parent, z, y, x0, x1)
	Kit.box(parent, x1 - x0, 1.6, 8, (x0 + x1) / 2, y, z, P.concrete, M.concrete)
	Kit.box(parent, x1 - x0, 1.2, 0.4, (x0 + x1) / 2, y + 1.4, z - 3.8, P.stone_light, M.concrete, { collide = false })
	Kit.box(parent, x1 - x0, 1.2, 0.4, (x0 + x1) / 2, y + 1.4, z + 3.8, P.stone_light, M.concrete, { collide = false })
	for x = x0 + 10, x1 - 10, 30 do
		Kit.box(parent, 3, y, 4, x, y / 2 - 0.4, z, P.concrete, M.concrete)
	end
	for _, dz in ipairs({ -1.5, 1.5 }) do
		Kit.box(parent, x1 - x0, 0.2, 0.25, (x0 + x1) / 2, y + 0.9, z + dz, P.steel, M.metal, { collide = false })
	end
end

-- Train (built at the origin, moved by the client)
function S.train(cars)
	local m = Kit.model("Train")
	for i = 0, (cars or 4) - 1 do
		local x = i * 13.2
		Kit.box(m, 13, 4, 4, x, 2.3, 0, P.white, M.smooth)
		Kit.box(m, 13, 0.6, 4.05, x, 1.0, 0, P.matcha, M.smooth)
		for k = 0, 4 do
			local win = Kit.box(m, 1.6, 1.2, 4.1, x - 5 + k * 2.5, 3, 0, P.lamp, M.neon, { collide = false, shadow = false })
			win.Transparency = 0.2
		end
		Kit.box(m, 12.6, 0.3, 3.6, x, 4.4, 0, P.stone_light, M.metal)
	end
	Kit.box(m, 0.3, 1, 1, -6.6, 3, 1.2, P.lamp, M.neon, { collide = false })
	Kit.box(m, 0.3, 1, 1, -6.6, 3, -1.2, P.lamp, M.neon, { collide = false })
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
		end
	end
	Kit.finish(m, Vector3.new(cars * 13.2, 5, 4))
	return m
end

-- Delivery kei truck (front faces -X)
function S.truck()
	local m = Kit.model("Truck")
	Kit.box(m, 3.2, 3.4, 4.2, -3.2, 2.3, 0, P.white, M.smooth)
	Kit.box(m, 0.1, 1.4, 3.6, -4.82, 3, 0, P.glass, M.glass, { transparency = 0.3 })
	Kit.box(m, 6.6, 0.5, 4.2, 1.6, 1.0, 0, P.steel_dark, M.metal)
	local cargo = Kit.box(m, 6.2, 3.6, 4.2, 1.8, 3.05, 0, P.paper, M.smooth, { name = "Cargo" })
	Kit.text(cargo, Enum.NormalId.Back, "🐟 魚市場 🍚", { color = "#2E3A5C" })
	Kit.text(cargo, Enum.NormalId.Front, "🐟 魚市場 🍚", { color = "#2E3A5C" })
	for _, x in ipairs({ -3.2, 3 }) do
		for _, z in ipairs({ -2, 2 }) do
			Kit.cylH(m, 1.5, 0.6, x, 0.75, z, P.charcoal, M.rubber or M.smooth, nil, "z")
		end
	end
	local light = Kit.box(m, 0.15, 0.4, 0.8, -4.85, 1.6, 1.4, P.lamp, M.neon, { collide = false })
	Kit.light(light, "Spot", P.lamp, 20, 1.5, { face = Enum.NormalId.Left, angle = 60 })
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanCollide = false
		end
	end
	Kit.finish(m, Vector3.new(10, 5, 4.2))
	return m
end

function S.menuBoard(parent, x, z)
	local m = Kit.model("MenuBoard")
	Kit.box(m, 0.15, 4.2, 0.15, -1, 2.1, 0.6, P.wood_dark, M.wood)
	Kit.box(m, 0.15, 4.2, 0.15, 1, 2.1, 0.6, P.wood_dark, M.wood)
	local board = Kit.box(m, 2.4, 3.2, 0.2, 0, 2.4, 0, P.charcoal, M.slate, { name = "Board" })
	Kit.box(m, 2.6, 0.2, 0.3, 0, 4.1, 0, P.wood_dark, M.wood, { collide = false })
	Kit.text(board, Enum.NormalId.Front, "お品書き\n🍣 🍜 🍵", { color = "#F4EBDD", pps = 40 })
	Kit.finish(m, Vector3.new(2.6, 4.3, 1.4))
	m:PivotTo(CFrame.new(x, -0.4 + 2.15, z))
	m.Parent = parent
	return m
end

function S.supplierTablet(parent, x, y, z, yaw)
	local m = Kit.model("SupplierTablet")
	local frame = Kit.box(m, 0.15, 1.6, 2.4, 0, 0, 0, P.charcoal, M.smooth, { name = "Body" })
	local screen = Kit.box(m, 0.05, 1.3, 2.1, -0.09, 0, 0, P.white, M.neon, { collide = false })
	Kit.text(screen, Enum.NormalId.Left, "📦 発注", { color = "#2E3A5C", glow = true })
	local _ = frame
	Kit.finish(m, Vector3.new(0.3, 1.6, 2.4))
	m:PivotTo(CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(yaw or 0), 0))
	m.Parent = parent
	return m
end

function S.rng(seed)
	return rng(seed)
end

return function(Registry)
	Registry.Street = S
	local _ = Color
end
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX000053"><Properties><string name="Name">Kit</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Primitive helpers for procedural models. Coordinates are relative to the model's bottom center.
local Color = require(script.Parent.Parent.Util.Color)

local Kit = {}

local function apply(p, color, material, props)
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Color = Color.of(color or "#FFFFFF")
	p.Material = material or Enum.Material.SmoothPlastic
	p.CanTouch = false
	p.CastShadow = true
	if props then
		if props.collide ~= nil then
			p.CanCollide = props.collide
		end
		if props.query ~= nil then
			p.CanQuery = props.query
		end
		if props.transparency then
			p.Transparency = props.transparency
		end
		if props.reflectance then
			p.Reflectance = props.reflectance
		end
		if props.shadow == false then
			p.CastShadow = false
		end
		if props.name then
			p.Name = props.name
		end
	end
	return p
end

function Kit.model(name)
	local m = Instance.new("Model")
	m.Name = name or "Model"
	return m
end

-- Generic part with explicit size and local CFrame
function Kit.part(parent, size, cf, color, material, props)
	local p = Instance.new("Part")
	if props and props.shape then
		p.Shape = props.shape
	end
	p.Size = size
	p.CFrame = cf
	apply(p, color, material, props)
	if props and props.collide == nil and (size.X < 0.6 or size.Y < 0.6 or size.Z < 0.6) and size.Magnitude < 3 then
		p.CanCollide = false
	end
	p.Parent = parent
	return p
end

function Kit.box(parent, sx, sy, sz, x, y, z, color, material, props)
	local cf = CFrame.new(x, y, z)
	if props and props.rot then
		cf = cf * props.rot
	end
	return Kit.part(parent, Vector3.new(sx, sy, sz), cf, color, material, props)
end

-- Box defined by its bottom center (handy for stacking)
function Kit.slab(parent, sx, sy, sz, x, y0, z, color, material, props)
	return Kit.box(parent, sx, sy, sz, x, y0 + sy / 2, z, color, material, props)
end

-- Vertical cylinder: diameter d, height h, centered at x, y, z
function Kit.cyl(parent, d, h, x, y, z, color, material, props)
	props = props or {}
	props.shape = Enum.PartType.Cylinder
	local cf = CFrame.new(x, y, z) * CFrame.Angles(0, 0, math.rad(90))
	if props.rot then
		cf = CFrame.new(x, y, z) * props.rot * CFrame.Angles(0, 0, math.rad(90))
	end
	return Kit.part(parent, Vector3.new(h, d, d), cf, color, material, props)
end

-- Horizontal cylinder along X (length l) or along Z (axis = "z")
function Kit.cylH(parent, d, l, x, y, z, color, material, props, axis)
	props = props or {}
	props.shape = Enum.PartType.Cylinder
	local cf = CFrame.new(x, y, z)
	if axis == "z" then
		cf = cf * CFrame.Angles(0, math.rad(90), 0)
	end
	if props.rot then
		cf = cf * props.rot
	end
	return Kit.part(parent, Vector3.new(l, d, d), cf, color, material, props)
end

function Kit.ball(parent, d, x, y, z, color, material, props)
	props = props or {}
	props.shape = Enum.PartType.Ball
	return Kit.part(parent, Vector3.new(d, d, d), CFrame.new(x, y, z), color, material, props)
end

-- Ellipsoid-ish ball (non-uniform sizes are not allowed on Ball parts, so use a sphere mesh)
function Kit.blob(parent, sx, sy, sz, x, y, z, color, material, props)
	local p = Kit.box(parent, 1, 1, 1, x, y, z, color, material, props)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = Vector3.new(sx, sy, sz)
	mesh.Parent = p
	p.Size = Vector3.new(math.max(sx, 0.05), math.max(sy, 0.05), math.max(sz, 0.05))
	mesh.Scale = Vector3.new(1, 1, 1)
	return p
end

function Kit.wedge(parent, sx, sy, sz, cf, color, material, props)
	local p = Instance.new("WedgePart")
	p.Size = Vector3.new(sx, sy, sz)
	p.CFrame = cf
	apply(p, color, material, props)
	p.Parent = parent
	return p
end

-- Text on a part face
function Kit.text(part, face, text, opts)
	opts = opts or {}
	local gui = Instance.new("SurfaceGui")
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = opts.pps or 50
	gui.LightInfluence = opts.glow and 0 or 1
	gui.Brightness = opts.glow and 2 or 1
	gui.AlwaysOnTop = false
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = opts.bg and 0 or 1
	if opts.bg then
		label.BackgroundColor3 = Color.of(opts.bg)
	end
	label.Text = text
	label.TextScaled = true
	label.TextColor3 = Color.of(opts.color or "#2B2320")
	label.FontFace = opts.font or Font.new("rbxasset://fonts/families/FredokaOne.json")
	label.TextWrapped = true
	label.AutoLocalize = false
	if opts.rotation then
		label.Rotation = opts.rotation
	end
	label.Parent = gui
	return gui, label
end

-- Lights carry the attribute NightLight so the client can switch them by time of day.
function Kit.light(part, kind, color, range, brightness, opts)
	opts = opts or {}
	local l
	if kind == "Surface" then
		l = Instance.new("SurfaceLight")
		l.Face = opts.face or Enum.NormalId.Bottom
		l.Angle = opts.angle or 90
	elseif kind == "Spot" then
		l = Instance.new("SpotLight")
		l.Face = opts.face or Enum.NormalId.Bottom
		l.Angle = opts.angle or 60
	else
		l = Instance.new("PointLight")
	end
	l.Color = Color.of(color or "#FFD9A0")
	l.Range = range or 10
	l.Brightness = brightness or 1
	l.Shadows = opts.shadows or false
	l:SetAttribute("NightLight", opts.night ~= false)
	l:SetAttribute("BaseBrightness", l.Brightness)
	l.Parent = part
	return l
end

local PARTICLES = {
	steam = { tex = "rbxasset://textures/particles/smoke_main.dds", color = "#FFFFFF", rate = 6, life = { 1.2, 2 }, speed = { 1, 2 }, size = { 0.4, 1.4 }, transp = { 0.6, 1 }, spread = 10, accel = Vector3.new(0, 1, 0) },
	smoke = { tex = "rbxasset://textures/particles/smoke_main.dds", color = "#D8D8D8", rate = 3, life = { 2, 4 }, speed = { 0.5, 1 }, size = { 1, 3 }, transp = { 0.7, 1 }, spread = 20, accel = Vector3.new(0, 0.5, 0) },
	sparkle = { tex = "rbxasset://textures/particles/sparkles_main.dds", color = "#FFE08A", rate = 0, life = { 0.6, 1 }, speed = { 2, 5 }, size = { 0.3, 0 }, transp = { 0, 1 }, spread = 180, accel = Vector3.new(0, -2, 0) },
	petals = { tex = "rbxasset://textures/particles/sparkles_main.dds", color = "#F7B7C9", rate = 2, life = { 4, 6 }, speed = { 0.5, 1 }, size = { 0.25, 0.2 }, transp = { 0.1, 0.4 }, spread = 60, accel = Vector3.new(0.3, -0.6, 0.2) },
	bubbles = { tex = "rbxasset://textures/particles/sparkles_main.dds", color = "#FFF4D6", rate = 5, life = { 0.4, 0.8 }, speed = { 0.5, 1 }, size = { 0.15, 0.05 }, transp = { 0.3, 1 }, spread = 30, accel = Vector3.new(0, 1, 0) },
	water = { tex = "rbxasset://textures/particles/smoke_main.dds", color = "#CFE8F5", rate = 12, life = { 0.6, 1 }, speed = { 3, 5 }, size = { 0.3, 0.8 }, transp = { 0.5, 1 }, spread = 8, accel = Vector3.new(0, -10, 0) },
	snow = { tex = "rbxasset://textures/particles/sparkles_main.dds", color = "#FFFFFF", rate = 20, life = { 6, 9 }, speed = { 1, 2 }, size = { 0.25, 0.2 }, transp = { 0, 0.3 }, spread = 40, accel = Vector3.new(0.2, -1, 0) },
}

function Kit.particles(part, preset, overrides)
	local p = PARTICLES[preset] or PARTICLES.steam
	overrides = overrides or {}
	local e = Instance.new("ParticleEmitter")
	e.Texture = p.tex
	e.Color = ColorSequence.new(Color.of(overrides.color or p.color))
	e.Rate = overrides.rate or p.rate
	e.Lifetime = NumberRange.new(p.life[1], p.life[2])
	e.Speed = NumberRange.new(p.speed[1], p.speed[2])
	e.Size = NumberSequence.new(p.size[1], p.size[2])
	e.Transparency = NumberSequence.new(p.transp[1], p.transp[2])
	e.SpreadAngle = Vector2.new(p.spread, p.spread)
	e.Acceleration = p.accel
	e.LightEmission = overrides.glow or 0
	e.LightInfluence = 1
	e.Enabled = overrides.enabled ~= false
	e.Parent = part
	return e
end

function Kit.attach(part, name, cf)
	local a = Instance.new("Attachment")
	a.Name = name
	a.CFrame = cf or CFrame.new()
	a.Parent = part
	return a
end

-- Adds the invisible Root (footprint box) and sets PrimaryPart. size = Vector3 (w, h, d)
-- Optional detail group of a placeable model. Registry.build keeps it only when the matching
-- renovation style is owned, so the same builder makes the plain and the detailed look.
function Kit.detail(model, key)
	local name = "Detail_" .. key
	local d = model:FindFirstChild(name)
	if not d then
		d = Instance.new("Model")
		d.Name = name
		d.Parent = model
	end
	return d
end

function Kit.finish(model, size)
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = size
	root.CFrame = CFrame.new(0, size.Y / 2, 0)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.CastShadow = false
	root.Parent = model
	model.PrimaryPart = root
	return root
end

-- Rows of small boxes (e.g. tiles, slats) along X
function Kit.slats(parent, count, sx, sy, sz, x0, x1, y, z, color, material, props)
	local out = {}
	if count <= 1 then
		table.insert(out, Kit.box(parent, sx, sy, sz, (x0 + x1) / 2, y, z, color, material, props))
		return out
	end
	for i = 0, count - 1 do
		local x = x0 + (x1 - x0) * i / (count - 1)
		table.insert(out, Kit.box(parent, sx, sy, sz, x, y, z, color, material, props))
	end
	return out
end

return Kit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000054"><Properties><string name="Name">Palette</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Theme colors and materials used by every procedural model.
local Color = require(script.Parent.Parent.Util.Color)

local hex = {
	wood_light = "#C89F6E", wood = "#9A6B43", wood_dark = "#5B3A24", wood_black = "#2B1D14",
	hinoki = "#E3C79A", bamboo = "#B8A15A", bamboo_green = "#7A9A3A",
	lacquer = "#B3262E", lacquer_dark = "#7A1A1F", vermilion = "#D9442E",
	paper = "#F4EBDD", paper_warm = "#F7E3C0", ink = "#2B2320", charcoal = "#1E1E22",
	gold = "#D4A23C", brass = "#B8913A", matcha = "#7A9A4A", indigo = "#2E3A5C", navy = "#1E2A44",
	stone = "#8C8C88", stone_dark = "#5E5E5A", stone_light = "#B5B1A8", moss = "#5E7A3A",
	metal = "#A8ACB0", steel = "#6E7478", steel_dark = "#3E4246", copper = "#B87333",
	white = "#F7F5F0", porcelain = "#F2EFE8", rice = "#F7F4EC", nori = "#1E2B1E",
	leaf = "#4F7A3A", leaf_dark = "#2F5A2A", leaf_light = "#7FA34A", maple = "#C8361E",
	sakura = "#F7B7C9", sakura_dark = "#E88AA8", water = "#4F98B8", water_dark = "#2E6A88",
	sand = "#E3D6B8", tile = "#3A3D44", road = "#2A2A2E", road_line = "#E8E4D8", concrete = "#9A9A96",
	sidewalk = "#B5B0A6", brick = "#7A4A3A", glass = "#A8D0E0", cardboard = "#B98B57",
	neon_red = "#FF3B4A", neon_blue = "#3BC8FF", neon_pink = "#FF5AC8", neon_yellow = "#FFD23B",
	lamp = "#FFD9A0", lamp_warm = "#FFB866", koi_orange = "#F27A2E", black = "#141414",
	cream = "#EFE3CC", red = "#C0261E",
}

local Palette = {}
for name, value in pairs(hex) do
	Palette[name] = Color.hex(value)
end

Palette.M = {
	wood = Enum.Material.Wood,
	planks = Enum.Material.WoodPlanks,
	fabric = Enum.Material.Fabric,
	smooth = Enum.Material.SmoothPlastic,
	plastic = Enum.Material.Plastic,
	metal = Enum.Material.Metal,
	slate = Enum.Material.Slate,
	concrete = Enum.Material.Concrete,
	brick = Enum.Material.Brick,
	neon = Enum.Material.Neon,
	glass = Enum.Material.Glass,
	marble = Enum.Material.Marble,
	granite = Enum.Material.Granite,
	pebble = Enum.Material.Pebble,
	sand = Enum.Material.Sand,
	grass = Enum.Material.Grass,
	leafy = Enum.Material.LeafyGrass,
	cobble = Enum.Material.Cobblestone,
	foil = Enum.Material.Foil,
	plaster = Enum.Material.Plaster,
	cardboard = Enum.Material.Cardboard,
	tiles = Enum.Material.CeramicTiles,
	roof = Enum.Material.ClayRoofTiles,
	asphalt = Enum.Material.Asphalt,
	pavement = Enum.Material.Pavement,
	rock = Enum.Material.Rock,
	snow = Enum.Material.Snow,
	leather = Enum.Material.Leather,
	carpet = Enum.Material.Carpet,
}

function Palette.material(name)
	local ok, m = pcall(function()
		return Enum.Material[name]
	end)
	if ok and m then
		return m
	end
	return Enum.Material.SmoothPlastic
end

Palette.hex = Color.hex

return Palette
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000055"><Properties><string name="Name">Registry</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Model registry: id -> builder. Models in ReplicatedStorage.AssetOverrides with the same name
-- replace the procedural version (they are scaled to fit the configured size).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Kit = require(script.Parent.Kit)
local Items = require(script.Parent.Parent.Config.Items)

local Registry = {}
local builders = {}
local foodBuilders = {}
Registry.Food = {}

function Registry.register(id, fn)
	builders[id] = fn
end

function Registry.has(id)
	return builders[id] ~= nil
end

local function override(id)
	local folder = ReplicatedStorage:FindFirstChild("AssetOverrides")
	local m = folder and folder:FindFirstChild(id)
	if m and m:IsA("Model") then
		return m:Clone()
	end
	return nil
end

local function fitOverride(model, size)
	local cf, bbox = model:GetBoundingBox()
	local scale = math.min(size.X / math.max(bbox.X, 0.01), size.Y / math.max(bbox.Y, 0.01), size.Z / math.max(bbox.Z, 0.01))
	if scale > 0 and math.abs(scale - 1) > 0.02 then
		model:ScaleTo(model:GetScale() * scale)
		cf, bbox = model:GetBoundingBox()
	end
	-- move so the bottom center sits at the origin
	local offset = CFrame.new(0, bbox.Y / 2, 0) * cf:Inverse()
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CFrame = offset * d.CFrame
		end
	end
	local old = model:FindFirstChild("Root")
	if old then
		old:Destroy()
	end
	Kit.finish(model, size)
	return model
end

-- Builds the model of a placeable item; returns a Model whose Root is the footprint box,
-- bottom center at the origin, front facing -Z. opts.styles: owned renovation styles.
function Registry.build(id, opts)
	local item = Items.byId[id]
	local size = item and Vector3.new(item.size[1], item.size[2], item.size[3]) or Vector3.new(2, 2, 2)
	local m = override(id)
	if m then
		m.Name = id
		return fitOverride(m, size)
	end
	m = Kit.model(id)
	local fn = builders[id]
	if fn then
		local ok, err = pcall(fn, m, item, opts or {})
		if not ok then
			warn("[Models] builder failed for " .. id .. ": " .. tostring(err))
			m:ClearAllChildren()
			Kit.box(m, size.X, size.Y, size.Z, 0, size.Y / 2, 0, "#C89F6E", Enum.Material.Wood)
		end
	else
		Kit.box(m, size.X, size.Y, size.Z, 0, size.Y / 2, 0, "#C89F6E", Enum.Material.Wood)
	end
	if not m:FindFirstChild("Root") then
		Kit.finish(m, size)
	end
	-- opts.styles = set of owned renovation styles; without it every detail is kept
	local styles = opts and opts.styles
	if styles then
		for _, child in ipairs(m:GetChildren()) do
			local key = string.match(child.Name, "^Detail_(.+)$")
			if key and not styles[key] then
				child:Destroy()
			end
		end
	end
	return m
end

-- Food: Registry.dish(recipeId, opts), Registry.ingredient(id), Registry.box(id, count)
function Registry.registerFood(name, fn)
	foodBuilders[name] = fn
end

function Registry.food(name, ...)
	local fn = foodBuilders[name]
	if fn then
		return fn(...)
	end
	local m = Kit.model(name)
	Kit.box(m, 0.8, 0.4, 0.8, 0, 0.2, 0, "#F7F5F0")
	Kit.finish(m, Vector3.new(0.8, 0.4, 0.8))
	return m
end

-- Loads every builder module once.
local loaded = false
function Registry.load()
	if loaded then
		return
	end
	loaded = true
	for _, mod in ipairs(script.Parent.Builders:GetChildren()) do
		if mod:IsA("ModuleScript") then
			local ok, fn = pcall(require, mod)
			if ok and type(fn) == "function" then
				fn(Registry)
			else
				warn("[Models] could not load " .. mod.Name .. ": " .. tostring(fn))
			end
		end
	end
end

-- Moves a model so its Root sits at (x, y floor level, z) with rotation r (degrees)
function Registry.place(model, x, y, z, r)
	local root = model.PrimaryPart
	local h = root and root.Size.Y or 0
	model:PivotTo(CFrame.new(x, y + h / 2, z) * CFrame.Angles(0, math.rad(r or 0), 0))
end

return Registry
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000056"><Properties><string name="Name">Scene</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Builds the restaurant shell (floors, walls, roof, facade, stairs) and the street scenery.
-- Shared so the server world builder and the preview renderer use the same code.
local CollectionService = game:GetService("CollectionService")

local Config = script.Parent.Parent.Config
local GameConfig = require(Config.GameConfig)
local Expansions = require(Config.Expansions)
local Surfaces = require(Config.Surfaces)
local Franchise = require(Config.Franchise)
local Footprint = require(script.Parent.Parent.Logic.Footprint)
local Registry = require(script.Parent.Registry)
local Kit = require(script.Parent.Kit)
local P = require(script.Parent.Palette)
local Color = require(script.Parent.Parent.Util.Color)

local Scene = {}

local function floorY(f)
	return (f or 0) * GameConfig.FloorHeight
end
Scene.floorY = floorY

local function zoneAt(geo, x, z, f)
	for _, zone in ipairs(geo.zones) do
		if zone.floor == (f or 0) and Footprint.pointInRect(x, z, zone.rect) then
			return zone
		end
	end
	return nil
end
Scene.zoneAt = zoneAt

local function style(id, kind)
	local s = Surfaces.byId[id]
	if not s or s.kind ~= kind then
		s = Surfaces.byId[kind == "floor" and Surfaces.DefaultFloor or Surfaces.DefaultWall]
	end
	return { color = Color.hex(s.color), material = P.material(s.material), lattice = s.lattice, stripes = s.stripes }
end

function Scene.surfaceOf(data, zone, kind)
	local s = data.surfaces[zone.id]
	local id = s and s[kind]
	if not id then
		id = kind == "floor" and (zone.floorStyle or Surfaces.DefaultFloor) or (zone.wallStyle or Surfaces.DefaultWall)
	end
	return id
end

local function holesFor(geo, floor)
	local holes = {}
	for _, s in ipairs(geo.stairs) do
		if s.floor == floor - 1 then
			table.insert(holes, s.hole or s.rect)
		end
	end
	return holes
end

local function subtractAll(rect, holes)
	local rects = { rect }
	for _, h in ipairs(holes) do
		local next = {}
		for _, r in ipairs(rects) do
			for _, piece in ipairs(Footprint.subtractRect(r, h)) do
				table.insert(next, piece)
			end
		end
		rects = next
	end
	return rects
end

local function indoorAt(geo, x, z, floor)
	local zone = zoneAt(geo, x, z, floor)
	return zone and not zone.outdoor and zone or nil
end

function Scene.shell(shell, geo, data)
	shell:ClearAllChildren()
	local B = Registry.Building
	local floors = {}
	for _, z in ipairs(geo.zones) do
		floors[z.floor] = true
	end
	local topFloor = 0
	for f in pairs(floors) do
		topFloor = math.max(topFloor, f)
	end
	local deluxe = data.zones.facade_deluxe
	-- renovations bought so far (the starting restaurant is plain)
	local owned = data.zones
	local trim = { wainscot = owned.reno_wainscot, beams = owned.reno_beams, tiles = owned.reno_kitchen_tiles, storage = owned.reno_storage }
	local exterior = { color = deluxe and P.charcoal or P.cream, material = deluxe and P.M.wood or P.M.plaster }

	for _, zone in ipairs(geo.zones) do
		local fy = floorY(zone.floor)
		local attrs = { Zone = zone.id, FloorIndex = zone.floor, Area = zone.area }
		local floorStyle
		if zone.outdoor then
			if zone.area == "garden" then
				floorStyle = { color = P.moss, material = P.M.leafy }
			else
				floorStyle = { color = P.wood, material = P.M.planks }
			end
		else
			floorStyle = style(Scene.surfaceOf(data, zone, "floor"), "floor")
		end
		for _, r in ipairs(subtractAll(zone.rect, holesFor(geo, zone.floor))) do
			B.floorSkin(shell, r, fy, floorStyle, attrs)
			if zone.floor == 0 then
				B.slab(shell, r, zone.outdoor and -0.7 or -1.2, zone.outdoor and 0.5 or 1.0, P.stone_dark, P.M.concrete, "Foundation")
			end
		end
		if not zone.outdoor then
			-- ceiling / roof slab with holes where stairs go up
			local holes = {}
			for _, s in ipairs(geo.stairs) do
				if s.floor == zone.floor then
					table.insert(holes, s.hole or s.rect)
				end
			end
			local covered = false
			for _, other in ipairs(geo.zones) do
				if other.floor == zone.floor + 1 and Footprint.pointInRect((zone.rect[1] + zone.rect[3]) / 2, (zone.rect[2] + zone.rect[4]) / 2, other.rect) then
					covered = true
				end
			end
			for _, r in ipairs(subtractAll(zone.rect, holes)) do
				-- under another floor the slab stops just below that floor's boards (no z-fighting)
				local thick = covered and (GameConfig.FloorHeight - GameConfig.WallHeight - 0.2) or 1
				local c = B.slab(shell, r, fy + GameConfig.WallHeight, thick, P.wood_dark, P.M.wood, "Ceiling")
				B.tag(c, "Ceiling", { FloorIndex = zone.floor })
				B.tag(c, "Roof")
				if not covered then
					-- flat roof finish with gravel and a few rooftop details
					local cover = B.slab(shell, r, fy + GameConfig.WallHeight + 1, 0.15, P.stone_dark, P.M.pebble, "RoofCover")
					B.tag(cover, "Roof")
				end
			end
			if not covered then
				local rr = zone.rect
				local cx, cz = (rr[1] + rr[3]) / 2, (rr[2] + rr[4]) / 2
				local top = fy + GameConfig.WallHeight + 1.15
				local unit = Kit.box(shell, 2.6, 1.6, 1.4, cx + 4, top + 0.8, cz + 3, P.white, P.M.metal, { collide = false })
				B.tag(unit, "Roof")
				local fan = Kit.cylH(shell, 1.1, 0.08, cx + 4, top + 0.8, cz + 2.27, P.steel_dark, P.M.metal, { collide = false, shadow = false }, "z")
				B.tag(fan, "Roof")
				local tank = Kit.cyl(shell, 2.2, 2.4, cx - 6, top + 1.6, cz + 5, P.metal, P.M.metal, { collide = false })
				B.tag(tank, "Roof")
				for _, dx in ipairs({ -0.7, 0.7 }) do
					local leg = Kit.box(shell, 0.2, 0.6, 0.2, cx - 6 + dx, top + 0.3, cz + 5, P.steel_dark, P.M.metal, { collide = false, shadow = false })
					B.tag(leg, "Roof")
				end
			end
			-- exposed beams (renovation) and soft ceiling lights
			local r = zone.rect
			if trim.beams then
				for x = r[1] + 4, r[3] - 2, 8 do
					local beam = Kit.box(shell, 0.6, 0.7, r[4] - r[2], x, fy + GameConfig.WallHeight - 0.35, (r[2] + r[4]) / 2, P.wood_black, P.M.wood, { collide = false })
					B.tag(beam, "Roof")
				end
			end
			for x = r[1] + 7, r[3] - 3, 14 do
				for z = r[2] + 7, r[4] - 3, 14 do
					local fixture = Kit.box(shell, 1.2, 0.2, 1.2, x, fy + GameConfig.WallHeight - 0.8, z, P.paper_warm, P.M.neon, { collide = false, shadow = false })
					fixture.CanQuery = false
					Kit.light(fixture, "Point", P.lamp, 22, 0.55, { night = false })
					B.tag(fixture, "Roof")
				end
			end
			if zone.area == "kitchen" or zone.area == "storage" then
				local vol = Kit.box(shell, r[3] - r[1], 6, r[4] - r[2], (r[1] + r[3]) / 2, fy + 3, (r[2] + r[4]) / 2, P.white, P.M.smooth, { collide = false, transparency = 1, shadow = false })
				vol.CanQuery = false
				vol.Name = "StaffOnly"
				local mod = Instance.new("PathfindingModifier")
				mod.Label = "StaffOnly"
				mod.Parent = vol
			end
		end
	end

	for floor in pairs(floors) do
		local fy = floorY(floor)
		local fw = geo.walls[floor] or { walls = {}, rails = {} }
		for _, seg in ipairs(fw.walls) do
			local mid = (seg.a + seg.b) / 2
			local sideA, sideB
			if seg.axis == "z" then
				sideA, sideB = indoorAt(geo, mid, seg.line - 0.6, floor), indoorAt(geo, mid, seg.line + 0.6, floor)
			else
				sideA, sideB = indoorAt(geo, seg.line - 0.6, mid, floor), indoorAt(geo, seg.line + 0.6, mid, floor)
			end
			local zone = sideA or sideB
			local wallStyle = style(zone and Scene.surfaceOf(data, zone, "wall") or Surfaces.DefaultWall, "wall")
			local outsideSign = nil
			if not sideA then
				outsideSign = -1
			elseif not sideB then
				outsideSign = 1
			end
			-- walls under another floor go up to it, so there is no gap between the storeys
			local above = false
			for _, z in ipairs(geo.zones) do
				if z.floor == floor + 1 and Footprint.pointInRect(seg.axis == "z" and mid or seg.line, seg.axis == "z" and seg.line or mid, z.rect, 0.5) then
					above = true
				end
			end
			B.wall(shell, seg, fy, above and GameConfig.FloorHeight or GameConfig.WallHeight, 0.8, wallStyle, outsideSign, exterior)
			-- interior finishes on each indoor side
			if sideA then
				B.wallTrim(shell, seg, fy, -1, sideA.area, GameConfig.WallHeight, trim)
			end
			if sideB then
				B.wallTrim(shell, seg, fy, 1, sideB.area, GameConfig.WallHeight, trim)
			end
			if outsideSign then
				if seg.axis == "z" and outsideSign == -1 then
					B.eave(shell, seg, fy + GameConfig.WallHeight - 1.2, -1, 3, owned.reno_eaves)
					if zone and zone.area ~= "storage" and (owned.reno_facade or owned.reno_bamboo) then
						local avoid = {}
						for _, o in ipairs(geo.openings) do
							if o.axis == "z" and o.at == seg.line and o.floor == floor then
								table.insert(avoid, { o.from - 4.4, o.to + 4.4 })
							end
						end
						B.facadeDetail(shell, seg, fy, -1, avoid, { koshi = owned.reno_facade, bamboo = owned.reno_bamboo })
					end
					-- lattice windows facing the street (not over doors)
					local len = seg.b - seg.a
					local n = math.floor(len / 9)
					for i = 0, n - 1 do
						local along = seg.a + len / n * (i + 0.5)
						if math.abs(along) > 6 then
							B.window(shell, along, fy + 6.6, seg, -1, 4, 3.4, owned.reno_windows)
						end
					end
				end
				if not above then
					B.parapet(shell, seg, fy + GameConfig.WallHeight + 1)
				end
			end
		end
		for _, seg in ipairs(fw.rails) do
			B.railing(shell, seg, fy, P.wood_dark)
		end
	end
	for _, o in ipairs(geo.openings) do
		local fy = floorY(o.floor)
		B.doorFrame(shell, o, fy, o.kind == "loading" and 10 or 9)
		if o.kind == "entrance" then
			B.entranceNoren(shell, o, fy)
			if owned.reno_entrance then
				B.entranceDetail(shell, o, fy)
			end
		elseif o.kind == "loading" then
			B.shutter(shell, o, fy, 10, owned.reno_storage)
		end
	end
	for _, s in ipairs(geo.stairs) do
		B.stairs(shell, s, floorY(s.floor), GameConfig.FloorHeight)
	end

	-- Facade: big sign, entrance lanterns, open plate
	local signText = "らーめん ・ 寿司"
	local face = B.sign(shell, 0, 11.6, -0.9, 18, signText, deluxe)
	B.tag(face, "Roof")
	for _, x in ipairs({ -6.4, 6.4 }) do
		local l = Kit.blob(shell, 1.3, 1.8, 1.3, x, 8.2, -1.6, P.lacquer, P.M.smooth, { collide = false })
		Kit.cyl(shell, 0.8, 0.2, x, 9.2, -1.6, P.black, P.M.smooth, { collide = false })
		Kit.cyl(shell, 0.8, 0.2, x, 7.2, -1.6, P.black, P.M.smooth, { collide = false })
		Kit.light(l, "Point", P.lamp_warm, 16, 1.4)
		l:SetAttribute("Animate", "sway")
		l.CanQuery = false
	end
	local label = B.openSign(shell, 6.4, 5.2, -0.55)
	if data.zones.sign_rooftop then
		local topY = floorY(topFloor) + GameConfig.WallHeight + 2
		local board = Kit.box(shell, 20, 5, 0.6, 0, topY + 3.5, 2, P.black, P.M.smooth, { collide = false })
		Kit.text(board, Enum.NormalId.Front, "ラーメン 寿司", { color = "#FF3B4A", glow = true })
		Kit.light(board, "Surface", P.neon_red, 30, 3, { face = Enum.NormalId.Front })
		for _, x in ipairs({ -8, 8 }) do
			Kit.box(shell, 0.4, 3.5, 0.4, x, topY + 1, 2.4, P.steel_dark, P.M.metal, { collide = false })
		end
		B.tag(board, "Roof")
	end
	if deluxe then
		for _, x in ipairs({ -36.2, 36.2 }) do
			local post = Kit.box(shell, 0.4, 13, 0.4, x, 6.5, -0.6, P.gold, P.M.foil, { collide = false })
			B.tag(post, "Roof")
		end
		local glow = Kit.box(shell, 72.4, 0.2, 0.2, 0, 13.6, -0.7, P.neon_yellow, P.M.neon, { collide = false })
		B.tag(glow, "Roof")
	end
	-- Fixed interactables: supplier tablet and menu board
	local S = Registry.Street
	local tabletCfg = Expansions.Supplier
	local tablet = S.supplierTablet(shell, tabletCfg.x, tabletCfg.y, tabletCfg.z, 0)
	tablet:SetAttribute("Uid", "fixed_supplier")
	tablet:SetAttribute("Kind", "supplier")
	CollectionService:AddTag(tablet, "Interactable")
	local mb = Expansions.MenuBoard
	local board = S.menuBoard(shell, mb.x, mb.z)
	board:SetAttribute("Uid", "fixed_menu")
	board:SetAttribute("Kind", "menuboard")
	CollectionService:AddTag(board, "Interactable")

	for _, d in ipairs(shell:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CollisionGroup = "Shell"
		end
	end
	return { openLabel = label }
end

-- A plot nobody owns yet: a low construction fence along the street and a lantern sign
-- ("a new ramen shop opens here"), built in local coordinates like the shell
function Scene.emptyLot(shell)
	local pb = Expansions.PlotBounds
	local M = P.M
	for x = pb[1] + 4, pb[3] - 4, 6 do
		Kit.box(shell, 0.3, 3.2, 0.3, x, 1.6, -1, P.wood_dark, M.wood)
	end
	Kit.box(shell, pb[3] - pb[1] - 8, 0.3, 0.2, (pb[1] + pb[3]) / 2, 2.9, -1, P.vermilion, M.smooth, { collide = false })
	Kit.box(shell, pb[3] - pb[1] - 8, 0.3, 0.2, (pb[1] + pb[3]) / 2, 1.4, -1, P.vermilion, M.smooth, { collide = false })
	local sign = Kit.box(shell, 16, 4, 0.4, 0, 6, 2, P.paper, M.wood, { collide = false })
	Kit.text(sign, Enum.NormalId.Front, "空き地 · 近日オープン", { color = "#2B2320" })
	Kit.text(sign, Enum.NormalId.Back, "空き地", { color = "#2B2320" })
	for _, x in ipairs({ -7, 7 }) do
		Kit.box(shell, 0.4, 6, 0.4, x, 3, 2, P.wood_dark, M.wood, { collide = false })
	end
	local lamp = Kit.ball(shell, 1.2, 9, 8.6, 2, P.lacquer, M.fabric, { collide = false })
	Kit.light(lamp, "Point", P.lamp_warm, 14, 1.5)
	for _, d in ipairs(shell:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CollisionGroup = "Shell"
		end
	end
end

-- A "for sale" sign standing where a room can be built, like the buy pads of a tycoon: posts, a
-- board with a little roof and a lantern. The board's text (icon, name, price or lock) is written
-- by every client in its own language (Controllers/WorldUI); using the sign buys the room
-- (Controllers/Interaction -> BuyExpansion, checked by the server).
function Scene.forSale(shell, e, plotId)
	local rect = e.zones[1].rect
	local x, z = (rect[1] + rect[3]) / 2, (rect[2] + rect[4]) / 2
	-- an outdoor area in front of the door (the terrace): the sign stands at its side, not in the way
	if e.zones[1].outdoor and rect[3] - rect[1] > 30 then
		x = rect[1] + 6
	end
	local M = P.M
	local m = Kit.model("ForSale_" .. e.id)
	local board = Kit.box(m, 7, 3.6, 0.35, x, 4.2, z, P.paper, M.wood, { collide = false })
	board.Name = "Board"
	for _, dx in ipairs({ -3.2, 3.2 }) do
		Kit.box(m, 0.35, 6, 0.35, x + dx, 3, z, P.wood_dark, M.wood, { collide = false })
	end
	Kit.box(m, 7.8, 0.3, 1.2, x, 6.25, z, P.wood_dark, M.wood, { collide = false })
	local lamp = Kit.ball(m, 0.8, x + 3.2, 6.9, z, P.lacquer, M.fabric, { collide = false })
	Kit.light(lamp, "Point", P.lamp_warm, 12, 1.2)
	local front = Kit.text(board, Enum.NormalId.Front, "🏗️", { color = "#2B2320", pps = 40 })
	front.Name = "Front"
	local back = Kit.text(board, Enum.NormalId.Back, "🏗️", { color = "#2B2320", pps = 40 })
	back.Name = "Back"
	m.PrimaryPart = board
	m:SetAttribute("Kind", "forsale")
	m:SetAttribute("Uid", "forsale_" .. e.id .. "_" .. tostring(plotId))
	m:SetAttribute("Expansion", e.id)
	m:SetAttribute("Price", e.cost)
	m:SetAttribute("Level", e.lv)
	m:SetAttribute("PlotId", plotId)
	game:GetService("CollectionService"):AddTag(m, "Interactable")
	game:GetService("CollectionService"):AddTag(m, "ForSale")
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CollisionGroup = "Shell"
		end
	end
	m.Parent = shell
	return m
end

-- Neighbour facade colour: the city tone mixed with plaster, tile or concrete shades
local FACADE_MIX = { "#EFE3CC", "#B5B1A8", "#C9B8A0", "#9AA3A8", "#D8CFC0", "#A0705A" }
local function facadeColor(pal, r)
	local mix = Color.hex(FACADE_MIX[r:NextInteger(1, #FACADE_MIX)])
	return Color.hex(pal.building):Lerp(mix, 0.35 + r:NextNumber() * 0.5)
end

-- lots = the X of every restaurant plot along the street; reach = how far the street runs each way
function Scene.street(street, cityId, lots, reachOverride)
	street:ClearAllChildren()
	lots = lots or { 0 }
	local city = Franchise.byId[cityId] or Franchise.byId.tokyo
	local pal = city.palette
	local S = Registry.Street
	local r = S.rng(42)
	local M = P.M
	local L = Expansions.Street
	local reach = reachOverride or L.reach
	local curb, roadFar, farFront = L.curb, L.roadFar, L.farFront
	local roadW = curb - roadFar
	local roadZ = (curb + roadFar) / 2
	local farW = roadFar - farFront
	local farZ = (roadFar + farFront) / 2
	local len = reach * 2 + 200
	-- ground
	Kit.box(street, len + 400, 1, 900, 0, -1.9, 80, city.snow and P.white or Color.hex("#4A5A3A"), city.snow and M.snow or M.grass)
	-- four-lane road: double centre line, dashed lane lines, solid edge lines
	Kit.box(street, len, 0.6, roadW, 0, -1.1, roadZ, Color.hex(pal.road), M.asphalt)
	for _, dz in ipairs({ -0.35, 0.35 }) do
		Kit.box(street, len, 0.05, 0.3, 0, -0.78, roadZ + dz, P.neon_yellow, M.smooth, { collide = false, shadow = false })
	end
	for _, lz in ipairs({ curb - L.lane, roadFar + L.lane }) do
		for x = -reach - 80, reach + 80, 14 do
			Kit.box(street, 6, 0.05, 0.35, x, -0.78, lz, P.road_line, M.smooth, { collide = false, shadow = false })
		end
	end
	for _, ez in ipairs({ curb - 0.7, roadFar + 0.7 }) do
		Kit.box(street, len, 0.05, 0.3, 0, -0.78, ez, P.road_line, M.smooth, { collide = false, shadow = false })
	end
	S.crosswalk(street, -26, -0.77, roadZ, roadW, 7)
	for i, mx in ipairs({ -70, 30, 96, -130, 160 }) do
		S.manhole(street, mx, -0.77, curb - L.lane * (0.5 + (i % 4)), mx == 30)
	end
	for gx = -reach, reach, 24 do
		Kit.box(street, 1.6, 0.05, 0.6, gx + 7, -0.77, curb - 0.7, P.steel_dark, M.metal, { collide = false, shadow = false })
		Kit.box(street, 1.6, 0.05, 0.6, gx + 19, -0.77, roadFar + 0.7, P.steel_dark, M.metal, { collide = false, shadow = false })
	end
	-- wide sidewalks with yellow tactile paving and kerbs
	Kit.box(street, len, 1, -curb, 0, -0.9, curb / 2, P.sidewalk, M.pavement)
	Kit.box(street, len, 0.5, 0.6, 0, -0.65, curb, P.stone_light, M.concrete)
	Kit.box(street, len, 1, farW, 0, -0.9, farZ, P.sidewalk, M.pavement)
	Kit.box(street, len, 0.5, 0.6, 0, -0.65, roadFar, P.stone_light, M.concrete)
	local tactile = Color.hex("#E2B93B")
	Kit.box(street, len, 0.06, 1, 0, -0.38, -7, tactile, M.pavement, { collide = false, shadow = false })
	Kit.box(street, len, 0.06, 1, 0, -0.38, roadFar - 4, tactile, M.pavement, { collide = false, shadow = false })
	Kit.box(street, 1, 0.06, -curb - 8, -26, -0.38, (curb - 7.5) / 2 - 0.5, tactile, M.pavement, { collide = false, shadow = false })
	Kit.box(street, 4, 0.06, 1, -26, -0.38, curb + 0.8, tactile, M.cobble, { collide = false, shadow = false })
	Kit.box(street, 4, 0.06, 1, -26, -0.38, roadFar - 0.8, tactile, M.cobble, { collide = false, shadow = false })
	S.manhole(street, -80, -0.37, -6.5, false)
	-- street furniture near the crossing: signs, post box, bus stop
	S.trafficSign(street, -31, curb + 0.6, "walk")
	S.trafficSign(street, -21, roadFar - 0.6, "walk")
	S.trafficSign(street, -92, curb + 0.6, "stop")
	S.postBox(street, -36, curb + 0.8)
	Kit.cyl(street, 0.2, 7, 64, 3.1, curb + 0.6, P.metal, M.metal)
	local bus = Kit.cylH(street, 1.6, 0.1, 64, 6.4, curb + 0.6, P.white, M.smooth, { collide = false, shadow = false }, "z")
	Kit.text(bus, Enum.NormalId.Left, "バス", { color = "#1E2A44" })
	Kit.text(bus, Enum.NormalId.Right, "バス", { color = "#1E2A44" })
	Kit.box(street, 0.9, 1.4, 0.12, 64, 4.6, curb + 0.6, P.paper, M.smooth, { collide = false, shadow = false })
	-- bus shelter with a bench
	Kit.box(street, 8, 0.3, 3, 69, 7.6, curb + 2.2, P.steel_dark, M.metal, { collide = false })
	for _, bx in ipairs({ 65.2, 72.8 }) do
		Kit.box(street, 0.3, 7.6, 0.3, bx, 3.4, curb + 3.4, P.steel_dark, M.metal)
	end
	local glassBack = Kit.box(street, 7.6, 5, 0.1, 69, 3.4, curb + 3.6, P.glass, M.glass, { collide = false })
	glassBack.Transparency = 0.6
	Kit.box(street, 5, 0.3, 1.2, 69, 1.4, curb + 2.8, P.wood_light, M.wood)
	-- bicycles parked on the far sidewalk
	for _, bx in ipairs({ -44, -42.8, -41.6, 34, 35.2, 118, 119.2, -150 }) do
		S.bicycle(street, bx, farFront + 2.2, 90, ({ P.white, P.navy, P.lacquer, P.matcha, P.sakura_dark })[r:NextInteger(1, 5)])
	end
	-- every plot: its lot and loading bay, a bamboo fence and trees along the back
	local pb = Expansions.PlotBounds
	local bay = Expansions.LoadingBay
	for _, ox in ipairs(lots) do
		Kit.box(street, pb[3] - pb[1], 1, pb[4], ox + (pb[1] + pb[3]) / 2, -0.9, pb[4] / 2, P.stone_dark, M.pavement)
		Kit.box(street, 12, 0.1, 18, ox + bay.x, -0.38, bay.z, P.concrete, M.concrete, { collide = false })
		for _, x in ipairs({ bay.x - 5.7, bay.x + 5.7 }) do
			Kit.box(street, 0.25, 0.05, 18, ox + x, -0.33, bay.z, P.neon_yellow, M.smooth, { collide = false, shadow = false })
		end
		for fx = pb[1], pb[3] - 2, 3 do
			Kit.box(street, 0.3, 5, 0.3, ox + fx, 2.1, pb[4], P.bamboo, M.wood)
		end
		Kit.box(street, pb[3] - pb[1], 0.3, 0.3, ox + (pb[1] + pb[3]) / 2, 4.2, pb[4], P.bamboo, M.wood, { collide = false })
		Kit.box(street, pb[3] - pb[1], 0.3, 0.3, ox + (pb[1] + pb[3]) / 2, 1.5, pb[4], P.bamboo, M.wood, { collide = false })
		for _, tx in ipairs({ -100, -60, -20, 20, 60 }) do
			S.planterTree(street, ox + tx, pb[4] + 8, (tx % 40 == 0) and P.sakura or P.leaf, 1.6)
		end
	end
	-- big buildings: the opposite row and the neighbours on our side (between the plots and past
	-- the outer ones), in scale with the restaurants
	local K = 1.6
	local x = -reach
	while x < reach do
		local w = r:NextInteger(34, 62)
		local cx = x + w / 2
		S.building(street, x, x + w - 1, farFront, r:NextInteger(36, 48), r:NextInteger(32, 70), -1, facadeColor(pal, r), r, K, math.abs(cx) < reach - 150)
		x += w
	end
	local gaps = {}
	local sorted = table.clone(lots)
	table.sort(sorted)
	local from = -reach
	for _, ox in ipairs(sorted) do
		table.insert(gaps, { from, ox + pb[1] - 4 })
		from = ox + pb[3] + 4
	end
	table.insert(gaps, { from, reach })
	for _, gap in ipairs(gaps) do
		x = gap[1]
		while x < gap[2] - 16 do
			local w = math.min(r:NextInteger(26, 54), gap[2] - x)
			if w >= 16 then
				S.building(street, x, x + w - 1, 0, 70, r:NextInteger(28, 52), 1, facadeColor(pal, r), r, K, true)
			end
			x += math.max(w, 16)
		end
	end
	-- tall lamps on both kerbs, utility poles with wires on the far side
	for lx = -reach + 10, reach - 10, 36 do
		if math.abs(lx + 26) > 8 then
			S.lamp(street, lx, curb + 1, -1, 1.5)
			S.lamp(street, lx + 18, roadFar - 1, 1, 1.5)
		end
	end
	local prev = nil
	local poleZ = farFront + 6
	for px = -reach, reach, 48 do
		S.pole(street, px, poleZ, 1.5)
		local top = Vector3.new(px, 14.5 * 1.5, poleZ)
		if prev then
			S.wire(street, prev, top, 1.8)
			S.wire(street, prev + Vector3.new(0, -1.9, 0), top + Vector3.new(0, -1.9, 0), 1.8)
		end
		prev = top
	end
	for tx = -reach + 40, reach - 40, 70 do
		S.planterTree(street, tx, curb + 3, (math.floor(tx / 70) % 2 == 0) and P.sakura or P.leaf_light, 1.5)
		S.planterTree(street, tx + 35, roadFar - 5, P.sakura, 1.5)
	end
	-- a street vending machine next to every restaurant
	for _, ox in ipairs(lots) do
		local vx = ox + pb[3] + 7
		local vm = Registry.build("vending_machine")
		Registry.place(vm, vx, -0.4, -1.4, 180)
		vm.Parent = street
		S.bins(street, vx + 2.6, -1.3)
	end
	S.viaduct(street, L.railZ, L.railY, -reach - 300, reach + 300)
	if city.snow then
		local snow = Kit.box(street, reach * 2, 1, 360, 0, 90, -20, P.white, M.smooth, { transparency = 1, collide = false, shadow = false })
		snow.CanQuery = false
		Kit.particles(snow, "snow", { rate = 60 })
	end
	for _, d in ipairs(street:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CollisionGroup = "Shell"
			d.CanTouch = false
		end
	end
	return { sky = pal.sky }
end


return Scene
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX000058"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Remote definitions shared by server and client.
-- The server creates the instances; the client waits for them.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

Net.Events = {
	-- client -> server
	"Interact", -- (uid, extra)
	"DropHands",
	"OrderSupplies", -- (cart {[ingredientId] = {small = n, big = n}})
	"BuyDishes",
	"PlaceItem", -- (request)
	"MoveItem", -- (uid, request)
	"RemoveItem", -- (uid, mode "sell"|"store")
	"PaintSurface", -- (zoneId, kind "floor"|"wall", styleId)
	"BuyLicense",
	"BuyUpgrade",
	"BuyExpansion",
	"BuyAd",
	"HireStaff",
	"TrainStaff",
	"FireStaff",
	"SetMenu", -- (recipeId, on, priceMult)
	"ClaimQuest",
	"ClaimAchievement",
	"ClaimDaily",
	"ClaimOffline",
	"Wash", -- (sinkUid, holding) hold to wash dishes at the sink
	"TimingHit", -- (stationUid, k) noodle timing bar stopped at k (0..1)
	"Like", -- like the restaurant you are visiting
	"ClaimGift", -- (index) free gift for minutes played
	"RedeemCode", -- (code)
	"SetSetting", -- (key, value)
	"SetPermission", -- (userId, level "helper"|"comanager"|"none") in your restaurant
	"GoHome", -- back to the door of your restaurant
	"Franchise", -- (cityId)
	"BuyWithRobux", -- (kind "gamepass"|"product", id)
	"TutorialStep", -- (step)
	"TutorialReward", -- (kind "serve"|"done") the tutorial's gifts, checked by the server
	"HintSeen", -- (id) a one-time tip was shown
	"Dev", -- (command, arg)
	-- server -> client
	"DataChanged", -- (scope "me"|"world", key, value)
	"WorldSnapshot", -- (world) the restaurant you now work in (nil = your own)
	"Notify", -- (key, params, kind)
	"Tickets", -- (list)
	"Fx", -- (kind, data)
	"DayState", -- (state table)
	"Session", -- (info)
}

Net.Functions = {
	"GetSnapshot",
	"GetLeaderboard",
}

local folder

local function getFolder()
	if folder then
		return folder
	end
	if RunService:IsServer() then
		folder = ReplicatedStorage:FindFirstChild("Remotes")
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = "Remotes"
			for _, name in ipairs(Net.Events) do
				local ev = Instance.new("RemoteEvent")
				ev.Name = name
				ev.Parent = folder
			end
			for _, name in ipairs(Net.Functions) do
				local fn = Instance.new("RemoteFunction")
				fn.Name = name
				fn.Parent = folder
			end
			folder.Parent = ReplicatedStorage
		end
	else
		folder = ReplicatedStorage:WaitForChild("Remotes")
	end
	return folder
end

function Net.event(name)
	local f = getFolder()
	if RunService:IsServer() then
		return f[name]
	end
	return f:WaitForChild(name)
end

function Net.func(name)
	return Net.event(name)
end

return Net
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX000065"><Properties><string name="Name">Util</string></Properties><Item class="ModuleScript" referent="RBX000059"><Properties><string name="Name">Color</string><ProtectedString name="Source"><![CDATA[--!nonstrict
local Color = {}

local cache = {}

-- "#RRGGBB" -> Color3 (cached)
function Color.hex(hex)
	local c = cache[hex]
	if c then
		return c
	end
	local h = hex:gsub("#", "")
	local r = tonumber(h:sub(1, 2), 16) or 255
	local g = tonumber(h:sub(3, 4), 16) or 255
	local b = tonumber(h:sub(5, 6), 16) or 255
	c = Color3.fromRGB(r, g, b)
	cache[hex] = c
	return c
end

function Color.of(value)
	if typeof(value) == "Color3" then
		return value
	elseif type(value) == "string" then
		return Color.hex(value)
	end
	return Color3.new(1, 1, 1)
end

function Color.darken(c, amount)
	local h, s, v = c:ToHSV()
	return Color3.fromHSV(h, s, math.clamp(v * (1 - amount), 0, 1))
end

function Color.lighten(c, amount)
	return c:Lerp(Color3.new(1, 1, 1), amount)
end

return Color
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000060"><Properties><string name="Name">Format</string><ProtectedString name="Source"><![CDATA[--!nonstrict
local Format = {}

local function group(n, sep)
	local s = tostring(math.floor(math.abs(n) + 0.5))
	local out = s:reverse():gsub("(%d%d%d)", "%1" .. sep):reverse()
	if out:sub(1, 1) == sep then
		out = out:sub(2)
	end
	return out
end

-- Formats an integer with thousands separators for the given language.
function Format.number(n, lang)
	n = tonumber(n) or 0
	local sign = n < 0 and "-" or ""
	local sep = lang == "it" and "." or ","
	local abs = math.abs(n)
	if abs >= 1e9 then
		local v = string.format("%.2f", abs / 1e9)
		if lang == "it" then
			v = v:gsub("%.", ",")
		end
		return sign .. v .. (lang == "it" and " Mld" or "B")
	elseif abs >= 1e7 then
		local v = string.format("%.1f", abs / 1e6)
		if lang == "it" then
			v = v:gsub("%.", ",")
		end
		return sign .. v .. (lang == "it" and " Mln" or "M")
	end
	return sign .. group(abs, sep)
end

function Format.yen(n, lang)
	return "¥" .. Format.number(n, lang)
end

function Format.sakura(n, lang)
	return "🌸" .. Format.number(n, lang)
end

function Format.decimal(n, digits, lang)
	local s = string.format("%." .. (digits or 1) .. "f", n)
	if lang == "it" then
		s = s:gsub("%.", ",")
	end
	return s
end

function Format.clock(hours)
	local h = math.floor(hours) % 24
	local m = math.floor((hours - math.floor(hours)) * 60)
	return string.format("%02d:%02d", h, m)
end

function Format.duration(seconds)
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%dh %02dm", h, m)
	elseif m > 0 then
		return string.format("%dm %02ds", m, s)
	end
	return string.format("%ds", s)
end

return Format
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000061"><Properties><string name="Name">RateLimit</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Token bucket rate limiter keyed by any value (player, player..remote, ...).
local RateLimit = {}
RateLimit.__index = RateLimit

function RateLimit.new(perSecond, burst)
	return setmetatable({ rate = perSecond, burst = burst or perSecond, buckets = {} }, RateLimit)
end

function RateLimit:check(key)
	local now = os.clock()
	local b = self.buckets[key]
	if not b then
		b = { tokens = self.burst, t = now }
		self.buckets[key] = b
	end
	b.tokens = math.min(self.burst, b.tokens + (now - b.t) * self.rate)
	b.t = now
	if b.tokens >= 1 then
		b.tokens -= 1
		return true
	end
	return false
end

function RateLimit:clear(key)
	self.buckets[key] = nil
end

return RateLimit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000062"><Properties><string name="Name">Signal</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Minimal signal implementation (connect / once / fire / wait).
local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(fn)
	local handler = { fn = fn, connected = true }
	table.insert(self._handlers, handler)
	local signal = self
	return {
		Disconnect = function()
			handler.connected = false
			local idx = table.find(signal._handlers, handler)
			if idx then
				table.remove(signal._handlers, idx)
			end
		end,
	}
end

function Signal:Once(fn)
	local conn
	conn = self:Connect(function(...)
		conn.Disconnect()
		fn(...)
	end)
	return conn
end

function Signal:Fire(...)
	for _, handler in ipairs(table.clone(self._handlers)) do
		if handler.connected then
			task.spawn(handler.fn, ...)
		end
	end
end

function Signal:Wait()
	local thread = coroutine.running()
	self:Once(function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal:DisconnectAll()
	table.clear(self._handlers)
end

return Signal
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000063"><Properties><string name="Name">TableUtil</string><ProtectedString name="Source"><![CDATA[--!nonstrict
local TableUtil = {}

function TableUtil.deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in pairs(value) do
		copy[TableUtil.deepCopy(k)] = TableUtil.deepCopy(v)
	end
	return copy
end

-- Fills missing keys of `target` from `defaults` (recursively for tables).
function TableUtil.reconcile(target, defaults)
	for k, v in pairs(defaults) do
		if target[k] == nil then
			target[k] = TableUtil.deepCopy(v)
		elseif type(v) == "table" and type(target[k]) == "table" and next(v) ~= nil and #v == 0 then
			TableUtil.reconcile(target[k], v)
		end
	end
	return target
end

function TableUtil.count(t)
	local n = 0
	for _ in pairs(t) do
		n += 1
	end
	return n
end

function TableUtil.keys(t)
	local out = {}
	for k in pairs(t) do
		table.insert(out, k)
	end
	return out
end

function TableUtil.map(list, fn)
	local out = {}
	for i, v in ipairs(list) do
		out[i] = fn(v, i)
	end
	return out
end

function TableUtil.filter(list, fn)
	local out = {}
	for _, v in ipairs(list) do
		if fn(v) then
			table.insert(out, v)
		end
	end
	return out
end

function TableUtil.indexBy(list, key)
	local out = {}
	for _, v in ipairs(list) do
		out[v[key]] = v
	end
	return out
end

function TableUtil.shuffle(list, rng)
	rng = rng or Random.new()
	for i = #list, 2, -1 do
		local j = rng:NextInteger(1, i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

function TableUtil.weightedPick(list, weightFn, rng)
	rng = rng or Random.new()
	local total = 0
	for _, v in ipairs(list) do
		total += math.max(0, weightFn(v))
	end
	if total <= 0 then
		return nil
	end
	local roll = rng:NextNumber() * total
	for _, v in ipairs(list) do
		roll -= math.max(0, weightFn(v))
		if roll <= 0 then
			return v
		end
	end
	return list[#list]
end

return TableUtil
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000064"><Properties><string name="Name">Uid</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Short unique ids for placed items, boxes, entities.
local Uid = {}

local counter = 0
local rng = Random.new()
local ALPHABET = "abcdefghijklmnopqrstuvwxyz0123456789"

function Uid.new(prefix)
	counter += 1
	local chars = {}
	for i = 1, 5 do
		local idx = rng:NextInteger(1, #ALPHABET)
		chars[i] = string.sub(ALPHABET, idx, idx)
	end
	return (prefix or "") .. string.format("%x", counter) .. table.concat(chars)
end

return Uid
]]></ProtectedString></Properties></Item></Item></Item><Item class="Folder" referent="RBX000067"><Properties><string name="Name">AssetOverrides</string></Properties></Item></Item><Item class="ServerScriptService" referent="RBX000100"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX000099"><Properties><string name="Name">Server</string></Properties><Item class="ModuleScript" referent="RBX000069"><Properties><string name="Name">Core</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Shared registry of server services (avoids circular requires).
local Core = {
	S = {},
	Started = false,
}
return Core
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX000070"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Server entry point: loads every service, then calls Init() and Start() in order.
local Core = require(script.Parent.Core)
local Services = script.Parent.Services

local ORDER = {
	"Net", "Data", "Analytics", "Plots", "Economy", "Progression", "World", "Entities", "Placement", "Hands",
	"Supply", "Appliance", "Seating", "Cooking", "Npc", "Customers", "Tasks", "Staff", "Day",
	"Meta", "Rewards", "Franchise", "Monetization", "Leaderboard", "Interaction", "SelfTest", "Dev",
}

for _, name in ipairs(ORDER) do
	local module = Services:FindFirstChild(name)
	if module then
		local ok, svc = pcall(require, module)
		if ok then
			Core.S[name] = svc
		else
			warn("[Server] failed to load service " .. name .. ": " .. tostring(svc))
		end
	else
		warn("[Server] missing service " .. name)
	end
end

for _, name in ipairs(ORDER) do
	local svc = Core.S[name]
	if svc and svc.Init then
		local ok, err = pcall(svc.Init)
		if not ok then
			warn("[Server] " .. name .. ".Init failed: " .. tostring(err))
		end
	end
end

for _, name in ipairs(ORDER) do
	local svc = Core.S[name]
	if svc and svc.Start then
		task.spawn(function()
			local ok, err = pcall(svc.Start)
			if not ok then
				warn("[Server] " .. name .. ".Start failed: " .. tostring(err))
			end
		end)
	end
end

Core.Started = true
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX000098"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX000071"><Properties><string name="Name">Analytics</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Roblox Analytics: where new players stop in their first minutes (onboarding funnel), what they
-- earn and spend (economy) and how they level up (progression). Every call is protected: analytics
-- can never break the game. Sales and tips are summed and reported every few minutes.
local AnalyticsService = game:GetService("AnalyticsService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.Analytics)
local Core = require(script.Parent.Parent.Core)

local Analytics = {}
local pending = {} -- [player] = { [reason] = yen } sales and tips not reported yet

local function isPlayer(p)
	return typeof(p) == "Instance" and p:IsA("Player") and p.Parent ~= nil
end

-- logs an onboarding step once per new player (players from before this update are not counted)
function Analytics.step(player, name)
	if not isPlayer(player) then
		return
	end
	local d = Core.S.Data.get(player)
	local idx = Config.FunnelIndex[name]
	if not d or not idx or not d.meta.onboarding then
		return
	end
	d.meta.funnel = d.meta.funnel or {}
	if d.meta.funnel[name] then
		return
	end
	d.meta.funnel[name] = true
	pcall(function()
		AnalyticsService:LogOnboardingFunnelStepEvent(player, idx, name)
	end)
end

local function logEconomy(player, flow, currency, amount, balance, txType, sku)
	if not isPlayer(player) or amount <= 0 then
		return
	end
	pcall(function()
		AnalyticsService:LogEconomyEvent(player, flow, currency, amount, balance, txType, sku or "")
	end)
end

-- yen earned (reason = Economy reason); sales and tips are summed up
function Analytics.source(player, amount, reason, balance)
	if reason == "sale" or reason == "tip" or reason == "helper" then
		pending[player] = pending[player] or {}
		pending[player][reason] = (pending[player][reason] or 0) + amount
		return
	end
	local tx = Config.SourceType[reason]
	if tx then
		logEconomy(player, Enum.AnalyticsEconomyFlowType.Source, "Yen", amount, balance, tx, reason)
	end
end

-- yen spent; sku names what was bought (e.g. "upgrade:up_tray")
function Analytics.sink(player, amount, reason, balance, sku)
	logEconomy(player, Enum.AnalyticsEconomyFlowType.Sink, "Yen", amount, balance, Config.SinkType[reason] or "Shop", sku or reason)
	if reason == "build" then
		Analytics.step(player, "first_purchase")
	end
end

function Analytics.sakura(player, amount, balance, spent, sku)
	local flow = spent and Enum.AnalyticsEconomyFlowType.Sink or Enum.AnalyticsEconomyFlowType.Source
	logEconomy(player, flow, "Sakura", amount, balance, spent and "Shop" or "Gameplay", sku)
end

function Analytics.levelUp(player, level)
	if not isPlayer(player) then
		return
	end
	pcall(function()
		AnalyticsService:LogProgressionCompleteEvent(player, "Level", level - 1)
	end)
	if level >= 3 then
		Analytics.step(player, "level_3")
	end
	if level >= 5 then
		Analytics.step(player, "level_5")
	end
end

local function flush(player)
	local p = pending[player]
	pending[player] = nil
	if not p then
		return
	end
	local d = Core.S.Data.get(player)
	local balance = d and d.yen or 0
	for reason, amount in pairs(p) do
		logEconomy(player, Enum.AnalyticsEconomyFlowType.Source, "Yen", amount, balance, Config.SourceType[reason] or "Gameplay", reason)
	end
end

function Analytics.Start()
	Core.S.Data.Loaded:Connect(function(player)
		Analytics.step(player, "joined")
	end)
	Players.PlayerRemoving:Connect(function(player)
		flush(player)
	end)
	while true do
		task.wait(Config.SourceFlush)
		for player in pairs(pending) do
			flush(player)
		end
	end
end

return Analytics
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000072"><Properties><string name="Name">Appliance</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Rice cookers, broth pots, sink, dishwasher, fridges and the clean/dirty dish pool.
-- Sink: dirty dishes brought here pile up in the soaking basin; a player holds the click / E on
-- the sink to wash them one by one (hold sessions below), staff wash them on their own. The sink
-- model carries Washing / WashStart / WashTime / Washer so every client animates the plate and the
-- sponge (Controllers/Sink).
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Ingredients = require(Shared.Config.Ingredients)
local GameConfig = require(Shared.Config.GameConfig)
local Color = require(Shared.Util.Color)
local Registry = require(Shared.Models.Registry)
local Core = require(script.Parent.Parent.Core)

local Appliance = {}
local washerQueue = {} -- [uid] = count waiting
local sessions = {} -- [sink uid] = { actor, e, start, dur, staff }
local WASH = GameConfig.Washing

-- dirty plates waiting in the sink of each restaurant: plot.sinkPile
local function pile(plot)
	return plot and plot.sinkPile or 0
end

local function setPile(plot, n)
	plot.sinkPile = math.max(0, n)
	plot.folder:SetAttribute("SinkPile", plot.sinkPile)
end

-- saved state of a cooker / pot entity: { g, n, c, t }
local function state(e)
	local d = Core.S.Plots.data(e.plot)
	if not d then
		return { g = nil, n = 0, c = 0, t = 0 }
	end
	d.appliances[e.uid] = d.appliances[e.uid] or { g = nil, n = 0, c = 0, t = 0 }
	return d.appliances[e.uid]
end

local function refresh(e)
	if not e or not e.model then
		return
	end
	local st = state(e)
	local m = e.model
	m:SetAttribute("G", st.g or "")
	m:SetAttribute("N", st.n)
	m:SetAttribute("C", st.c)
	m:SetAttribute("T", st.t)
	m:SetAttribute("Batch", e.item.fn.batch or 0)
	m:SetAttribute("Time", e.item.fn.time or 0)
	local steam = m:FindFirstChild("Steam")
	local emitter = steam and steam:FindFirstChildOfClass("ParticleEmitter")
	if emitter then
		emitter.Enabled = st.c > 0 or (e.kind == "pot" and st.n > 0)
	end
	local led = m:FindFirstChild("Led")
	if led then
		led.Color = st.c > 0 and Color.hex("#FF3B4A") or (st.n > 0 and Color.hex("#6DDC5A") or Color.hex("#3A3A3A"))
	end
	local broth = m:FindFirstChild("Broth")
	if broth then
		local ing = st.g and Ingredients.byId[st.g]
		broth.Transparency = (st.n + st.c > 0) and 0 or 1
		if ing then
			broth.Color = Color.hex(ing.color)
		end
		local bubbles = broth:FindFirstChildOfClass("ParticleEmitter")
		if bubbles then
			bubbles.Enabled = st.c > 0
		end
	end
	local flame = m:FindFirstChild("Flame")
	if flame then
		flame.Transparency = st.c > 0 and 0 or 0.85
	end
end
Appliance.refresh = refresh

-- Loads a rice/broth box into a cooker or pot
function Appliance.load(actor, e)
	local Hands = Core.S.Hands
	local hands = Hands.get(actor)
	local st = state(e)
	if hands.kind and hands.plot and hands.plot ~= e.plot then
		return false, "msg.other_restaurant"
	end
	if hands.kind ~= "box" then
		if st.c > 0 then
			return false, "msg.cooking_wait"
		end
		return false, e.kind == "ricecooker" and "msg.need_rice_box" or "msg.need_broth_box"
	end
	-- with a cart you may hold several boxes: use the first one that fits this appliance
	local index = nil
	for i, it in ipairs(hands.items) do
		local ig = Ingredients.byId[it.g]
		if not index and ig and ((e.kind == "ricecooker" and ig.storage == "rice") or (e.kind == "pot" and ig.storage == "broth")) then
			index = i
		end
	end
	if not index then
		return false, e.kind == "ricecooker" and "msg.need_rice_box" or "msg.need_broth_box"
	end
	local entry = hands.items[index]
	if (st.n > 0 or st.c > 0) and st.g ~= entry.g then
		return false, "msg.pot_other_broth"
	end
	local batch = e.item.fn.batch
	local amount = math.min(entry.n, batch - st.n - st.c)
	if amount <= 0 then
		return false, "msg.appliance_full"
	end
	st.g = entry.g
	if st.c > 0 then
		-- topping up while it cooks: joins the batch on the fire (same timer)
		st.c += amount
	else
		st.c = amount
		st.t = workspace:GetServerTimeNow() + e.item.fn.time
	end
	entry.n -= amount
	if entry.n <= 0 then
		Core.S.Supply.removeBox(e.plot, entry)
		Hands.removeAt(actor, index)
	else
		Hands.refresh(actor)
	end
	refresh(e)
	Core.S.Net.fx("sfx", { name = e.kind == "ricecooker" and "rice" or "pour", pos = e.model.PrimaryPart.Position })
	Core.S.Data.changed(e.plot.owner, "appliances")
	return true
end

local function takeFrom(plot, kind, g)
	for _, e in ipairs(Core.S.Entities.ofKind(kind, plot)) do
		local st = state(e)
		if st.n > 0 and (g == nil or st.g == g) then
			st.n -= 1
			if st.n <= 0 and st.c <= 0 then
				st.g = (kind == "ricecooker") and "rice" or nil
			end
			refresh(e)
			return true
		end
	end
	return false
end

function Appliance.hasRice(plot)
	for _, e in ipairs(Core.S.Entities.ofKind("ricecooker", plot)) do
		if state(e).n > 0 then
			return true
		end
	end
	return false
end

function Appliance.hasBroth(plot, g)
	for _, e in ipairs(Core.S.Entities.ofKind("pot", plot)) do
		local st = state(e)
		if st.n > 0 and st.g == g then
			return true
		end
	end
	return false
end

-- pending portions (cooking) count as "coming soon" for customer menus
function Appliance.willHave(plot, kind, g)
	for _, e in ipairs(Core.S.Entities.ofKind(kind, plot)) do
		local st = state(e)
		if (st.n + st.c) > 0 and (g == nil or st.g == g) then
			return true
		end
	end
	return false
end

function Appliance.takeRice(plot)
	return takeFrom(plot, "ricecooker", nil)
end

function Appliance.takeBroth(plot, g)
	return takeFrom(plot, "pot", g)
end

-- Appliances of a restaurant that need refilling (for staff)
function Appliance.needsRefill(plot)
	local out = {}
	for _, kind in ipairs({ "ricecooker", "pot" }) do
		for _, e in ipairs(Core.S.Entities.ofKind(kind, plot)) do
			local st = state(e)
			if st.c == 0 and st.n <= math.floor((e.item.fn.batch or 8) * 0.3) then
				table.insert(out, { entity = e, g = st.n > 0 and st.g or nil })
			end
		end
	end
	return out
end

------------------------------------------------------------------ dishes

function Appliance.takeCleanDish(plot)
	local d = Core.S.Plots.data(plot)
	if d and d.dishes.clean > 0 then
		d.dishes.clean -= 1
		Core.S.Data.changed(plot.owner, "dishes")
		return true
	end
	return false
end

function Appliance.addDirtyToSink(plot, n)
	if plot then
		setPile(plot, pile(plot) + n)
	end
end

local function sinkLocal(e, x, y, z)
	-- builder coordinates (floor at y = 0) to a world CFrame on the sink
	local h = e.item.size[2]
	return e.model.PrimaryPart.CFrame * CFrame.new(x, y - h / 2, z)
end

-- the sink that shows the pile (the first one placed)
local function mainSink(plot)
	local list = Core.S.Entities.ofKind("sink", plot)
	table.sort(list, function(a, b)
		return a.uid < b.uid
	end)
	return list[1]
end

-- dirty plates stacked in the soaking basin of the main sink
local function refreshPiles(plot)
	Registry.load()
	local main = mainSink(plot)
	for _, e in ipairs(Core.S.Entities.ofKind("sink", plot)) do
		if e.model and e.model.PrimaryPart then
			local want = (e == main) and math.min(pile(plot), WASH.MaxPile) or 0
			local stack = e.model:FindFirstChild("DirtyPile")
			if (stack and stack:GetAttribute("N") or 0) ~= want then
				if stack then
					stack:Destroy()
				end
				if want > 0 then
					stack = Instance.new("Model")
					stack.Name = "DirtyPile"
					stack:SetAttribute("N", want)
					for i = 1, want do
						local m = Registry.food("dirty", "plate")
						for _, d in ipairs(m:GetDescendants()) do
							if d:IsA("BasePart") then
								d.Anchored = true
								d.CanCollide = false
							end
						end
						-- a slightly messy stack: aiming at it aims at the sink
						local yaw = (i * 47) % 360
						m:PivotTo(sinkLocal(e, -1.1 + ((i % 3) - 1) * 0.05, 2.95 + (i - 1) * 0.13, -0.05) * CFrame.Angles(0, math.rad(yaw), 0))
						m.Parent = stack
					end
					stack.Parent = e.model
				end
			end
		end
	end
end

local function spoutEmitter(e)
	local spout = e.model and e.model:FindFirstChild("Spout")
	return spout and spout:FindFirstChildOfClass("ParticleEmitter")
end

local function setWashing(e, on, dur, actor)
	local m = e.model
	if not m then
		return
	end
	m:SetAttribute("Washing", on)
	m:SetAttribute("Busy", on)
	if on then
		m:SetAttribute("WashStart", workspace:GetServerTimeNow())
		m:SetAttribute("WashTime", dur)
		m:SetAttribute("Washer", typeof(actor) == "Instance" and actor.UserId or 0)
		Core.S.Net.fx("sfx", { name = "wash", pos = m.PrimaryPart.Position })
	else
		m:SetAttribute("Washer", 0)
	end
	local emitter = spoutEmitter(e)
	if emitter then
		emitter.Enabled = on
	end
end

function Appliance.sinkPile(plot)
	return pile(plot)
end

local function finishWash(plot, count)
	local d = Core.S.Plots.data(plot)
	if not d then
		return
	end
	d.dishes.clean = math.min(d.dishes.total, d.dishes.clean + count)
	d.stats.washed = (d.stats.washed or 0) + count
	Core.S.Data.changed(plot.owner, "dishes")
	Core.S.Data.changed(plot.owner, "stats")
	Core.S.Meta.event(plot.owner, "wash", count)
end

-- one plate from the pile is clean: it slides to the drying rack on every client
local function washOne(e, actor)
	setPile(e.plot, pile(e.plot) - 1)
	finishWash(e.plot, 1)
	Core.S.Net.fx("washed", { uid = e.uid })
	Core.S.Net.fx("sfx", { name = "plate", pos = e.model.PrimaryPart.Position })
	if typeof(actor) == "Instance" then
		Core.S.Net.fxTo(actor, "action", { kind = "wash" })
	end
	refreshPiles(e.plot)
end

-- Sink: dirty dishes in hand go on the pile. Players then hold to wash (Appliance.hold); staff (and
-- the self test) wash the pile right away, dish by dish, with the same animation.
function Appliance.useSink(actor, e, speed)
	local Hands = Core.S.Hands
	local hands = Hands.get(actor)
	local isPlayer = typeof(actor) == "Instance"
	local plot = e.plot
	if hands.kind and hands.plot and hands.plot ~= plot then
		return false, "msg.other_restaurant"
	end
	if hands.kind == "dirty" then
		local n = #hands.items
		Hands.clear(actor)
		Appliance.addDirtyToSink(plot, n)
		refreshPiles(plot)
		Core.S.Net.fx("sfx", { name = "plate", pos = e.model.PrimaryPart.Position })
		if isPlayer then
			return true
		end
	elseif hands.kind ~= nil then
		return false, pile(plot) > 0 and "msg.hands_busy" or "msg.sink_hint"
	end
	if isPlayer then
		return false, pile(plot) > 0 and "msg.wash_hold" or "msg.sink_hint"
	end
	if sessions[e.uid] then
		return false, "msg.busy"
	end
	local dur = WASH.Time / (speed or 1)
	sessions[e.uid] = { actor = actor, e = e, staff = true }
	local count = 0
	while pile(plot) > 0 and count < WASH.StaffBatch and e.model and e.model.Parent do
		setWashing(e, true, dur, actor)
		task.wait(dur)
		washOne(e, actor)
		count += 1
	end
	sessions[e.uid] = nil
	setWashing(e, false)
	return count > 0
end

local function near(player, e)
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not hrp or not e.model or not e.model.PrimaryPart then
		return false
	end
	local p = e.model.PrimaryPart.Position
	local flat = (Vector3.new(p.X, 0, p.Z) - Vector3.new(hrp.Position.X, 0, hrp.Position.Z)).Magnitude
	return flat <= GameConfig.InteractRange + 3 and math.abs(p.Y - hrp.Position.Y) < 12
end

-- Hold to wash (remote "Wash"): on = true starts washing at this sink, false stops
function Appliance.hold(player, uid, on)
	if type(uid) ~= "string" then
		return
	end
	local e = Core.S.Entities.get(uid)
	if not e or e.kind ~= "sink" or not e.model or not e.model.PrimaryPart then
		return
	end
	local s = sessions[uid]
	if not on then
		if s and s.actor == player then
			sessions[uid] = nil
			setWashing(e, false)
		end
		return
	end
	if not Core.S.Plots.canWork(player, e.plot) then
		return
	end
	if s then
		if s.actor ~= player then
			Core.S.Net.notify(player, "msg.busy", nil, "info")
		end
		return
	end
	if not Core.S.Hands.isEmpty(player) then
		return Core.S.Net.notify(player, "msg.hands_busy", nil, "info")
	end
	if pile(e.plot) <= 0 then
		return Core.S.Net.notify(player, "msg.sink_hint", nil, "info")
	end
	if not near(player, e) then
		return Core.S.Net.notify(player, "msg.too_far", nil, "info")
	end
	sessions[uid] = { actor = player, e = e, start = os.clock(), dur = WASH.Time }
	setWashing(e, true, WASH.Time, player)
end

-- advances the players' hold sessions: one plate every WASH.Time while they keep holding
local function washLoop()
	while true do
		task.wait(0.1)
		for uid, s in pairs(sessions) do
			if not s.staff then
				local e = s.e
				local valid = e.model ~= nil and e.model.Parent ~= nil and Core.S.Entities.get(uid) ~= nil
				valid = valid and s.actor.Parent ~= nil and Core.S.Hands.isEmpty(s.actor) and near(s.actor, e)
				if not valid or pile(e.plot) <= 0 then
					sessions[uid] = nil
					setWashing(e, false)
				elseif os.clock() - s.start >= s.dur then
					washOne(e, s.actor)
					if pile(e.plot) > 0 then
						s.start = os.clock()
						setWashing(e, true, s.dur, s.actor)
					else
						sessions[uid] = nil
						setWashing(e, false)
					end
				end
			end
		end
	end
end

function Appliance.useDishwasher(actor, e)
	local Hands = Core.S.Hands
	local hands = Hands.get(actor)
	if hands.kind ~= "dirty" then
		return false, "msg.sink_hint"
	end
	if hands.plot and hands.plot ~= e.plot then
		return false, "msg.other_restaurant"
	end
	washerQueue[e.uid] = (washerQueue[e.uid] or 0) + #hands.items
	Hands.clear(actor)
	e.model:SetAttribute("Queue", washerQueue[e.uid])
	return true
end

local function dishwasherLoop()
	while true do
		task.wait(1)
		local now = os.clock()
		for _, e in ipairs(Core.S.Entities.ofKind("dishwasher")) do
			-- pull dirty dishes from the sink pile automatically
			local plot = e.plot
			if plot and pile(plot) > 0 and (washerQueue[e.uid] or 0) < e.item.fn.cap then
				local take = math.min(pile(plot), e.item.fn.cap - (washerQueue[e.uid] or 0))
				setPile(plot, pile(plot) - take)
				washerQueue[e.uid] = (washerQueue[e.uid] or 0) + take
			end
			e.nextWash = e.nextWash or (now + e.item.fn.interval)
			local q = washerQueue[e.uid] or 0
			local steam = e.model:FindFirstChild("Steam")
			local emitter = steam and steam:FindFirstChildOfClass("ParticleEmitter")
			if emitter then
				emitter.Enabled = q > 0
			end
			if q > 0 and now >= e.nextWash then
				local n = math.min(q, e.item.fn.cap)
				washerQueue[e.uid] = q - n
				finishWash(plot, n)
				e.nextWash = now + e.item.fn.interval
			elseif q == 0 then
				e.nextWash = now + e.item.fn.interval
			end
			e.model:SetAttribute("Queue", washerQueue[e.uid] or 0)
		end
	end
end

local function cookLoop()
	while true do
		task.wait(0.5)
		local now = workspace:GetServerTimeNow()
		for _, kind in ipairs({ "ricecooker", "pot" }) do
			for _, e in ipairs(Core.S.Entities.ofKind(kind)) do
				local d = Core.S.Plots.data(e.plot)
				local st = d and d.appliances[e.uid]
				if st and st.c > 0 and now >= st.t then
					st.n += st.c
					st.c = 0
					refresh(e)
					Core.S.Net.fx("ready", { pos = e.model.PrimaryPart.Position })
					Core.S.Data.changed(e.plot.owner, "appliances")
				end
			end
		end
	end
end

function Appliance.fridgeNear(plot, pos)
	for _, e in ipairs(Core.S.Entities.ofKind("fridge", plot)) do
		local p = e.model.PrimaryPart.Position
		if (p - pos).Magnitude <= e.item.fn.radius then
			return true
		end
	end
	return false
end

function Appliance.Init()
	Core.S.Net.on("Wash", Appliance.hold, 10)
	local Placement = Core.S.Placement
	Placement.ItemAdded:Connect(function(e)
		if e.kind == "ricecooker" or e.kind == "pot" then
			local st = state(e)
			if e.kind == "ricecooker" then
				st.g = st.g or "rice"
			end
			-- anything that was cooking when the game was saved is ready now
			if st.c > 0 then
				st.n += st.c
				st.c = 0
			end
			refresh(e)
		end
	end)
	Placement.addVeto(function(e)
		if e.kind == "ricecooker" or e.kind == "pot" then
			local st = state(e)
			if st.c > 0 then
				return false, "msg.cooking_wait"
			end
		elseif e.kind == "sink" and sessions[e.uid] then
			return false, "msg.busy"
		end
		return true
	end)
end

function Appliance.Start()
	local Plots = Core.S.Plots
	Plots.Claimed:Connect(function(plot, _, d)
		d.dishes.clean = d.dishes.total -- everything was washed overnight
		setPile(plot, 0)
	end)
	Plots.Released:Connect(function(plot)
		setPile(plot, 0)
	end)
	task.spawn(cookLoop)
	task.spawn(dishwasherLoop)
	task.spawn(washLoop)
	-- keep the pile visible after the sink is moved or rebuilt
	task.spawn(function()
		while true do
			task.wait(1)
			for _, plot in ipairs(Plots.list) do
				if plot.owner then
					refreshPiles(plot)
				end
			end
		end
	end)
end

return Appliance
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000073"><Properties><string name="Name">Cooking</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Stations: ingredients go on the board, each press runs the next step (cut, combine, roll,
-- boil, pour, top, fry...), then the dish waits on the plate. Also the order tickets of every
-- restaurant (plot.tickets).
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Recipes = require(Shared.Config.Recipes)
local Ingredients = require(Shared.Config.Ingredients)
local Upgrades = require(Shared.Config.Upgrades)
local Formulas = require(Shared.Logic.Formulas)
local Registry = require(Shared.Models.Registry)
local Uid = require(Shared.Util.Uid)
local Core = require(script.Parent.Parent.Core)

local Cooking = {}

local TOOL_FOR_STEP = {
	cut = "knife", combine = "knife", roll = "mat", mold = "mat", boil = "strainer", pour = "ladle",
	top = "ladle", batter = "ladle", fry = "strainer", flip = "spatula",
}

-- the owner's data of the restaurant an entity belongs to
local function dataOf(e)
	return Core.S.Plots.data(e and e.plot)
end

-- the order tickets of a restaurant
function Cooking.ticketsOf(plot)
	if not plot then
		return {}
	end
	plot.tickets = plot.tickets or {}
	return plot.tickets
end

local function station(e)
	if not e.station then
		e.station = { board = {}, step = 0, busy = false, ready = nil, boardModels = {}, dish = nil }
	end
	return e.station
end

local function stationType(e)
	return e.item.fn.station
end

local function unlockedRecipes(e)
	local d = dataOf(e)
	local out = {}
	if not d then
		return out
	end
	for _, r in ipairs(Recipes.byStation[stationType(e)] or {}) do
		if Core.S.Progression.isRecipeUnlocked(d, r) then
			table.insert(out, r)
		end
	end
	return out
end

local function boardKey(board)
	local ids = {}
	for _, b in ipairs(board) do
		table.insert(ids, b.g)
	end
	table.sort(ids)
	return table.concat(ids, "+")
end

-- true if `ids` (multiset) is contained in some unlocked recipe of this station
local function fits(e, ids)
	for _, r in ipairs(unlockedRecipes(e)) do
		local need = {}
		for _, g in ipairs(r.ing) do
			need[g] = (need[g] or 0) + 1
		end
		local ok = true
		for _, g in ipairs(ids) do
			if not need[g] or need[g] == 0 then
				ok = false
				break
			end
			need[g] -= 1
		end
		if ok then
			return true
		end
	end
	return false
end

function Cooking.match(e)
	local key = boardKey(station(e).board)
	for _, r in ipairs(unlockedRecipes(e)) do
		if r.key == key then
			return r
		end
	end
	return nil
end

local function attachment(e, name)
	local root = e.model and e.model.PrimaryPart
	return root and root:FindFirstChild(name)
end

local function publish(e)
	local st = station(e)
	local m = e.model
	if not m then
		return
	end
	local ids = {}
	for _, b in ipairs(st.board) do
		table.insert(ids, b.g)
	end
	local recipe = Cooking.match(e)
	m:SetAttribute("Board", table.concat(ids, ","))
	m:SetAttribute("Recipe", recipe and recipe.id or "")
	m:SetAttribute("Step", st.step)
	m:SetAttribute("Steps", recipe and table.concat(recipe.steps, ",") or "")
	m:SetAttribute("Busy", st.busy)
	m:SetAttribute("Ready", st.ready and st.ready.recipe or "")
	-- what the next press does: start the oldest order for this station, or tell what is missing
	local nextId, missing = "", ""
	if not st.busy and #st.board == 0 and not st.ready then
		local _, r = Cooking.nextOrder(e)
		if r then
			nextId = r.id
			missing = table.concat(Cooking.missing(e.plot, r), ",")
		end
	end
	if m:GetAttribute("Next") ~= nextId then
		m:SetAttribute("Next", nextId)
	end
	if m:GetAttribute("Missing") ~= missing then
		m:SetAttribute("Missing", missing)
	end
end

local function clearBoardModels(st)
	for _, mdl in ipairs(st.boardModels) do
		mdl:Destroy()
	end
	st.boardModels = {}
	for _, mdl in ipairs(st.ghostModels or {}) do
		mdl:Destroy()
	end
	st.ghostModels = {}
end

local BOARD_SCALE = 0.8
local BOARD_GAP = 0.6

-- multiset helpers
local function counts(list)
	local out = {}
	for _, g in ipairs(list) do
		out[g] = (out[g] or 0) + 1
	end
	return out
end

local function contains(recipe, ids)
	local need = counts(recipe.ing)
	for _, g in ipairs(ids) do
		if not need[g] or need[g] == 0 then
			return false
		end
		need[g] -= 1
	end
	return true
end

-- dishes already on their way, by recipe: cooking on a station, waiting on its plate, or in
-- someone's hands
local function coverage(plot)
	local cov = {}
	for _, e in ipairs(Core.S.Entities.ofKind("station", plot)) do
		local st = station(e)
		local r = st.recipe
		if not r and #st.board > 0 then
			local m = Cooking.match(e)
			r = m and m.id or nil
		end
		if r then
			cov[r] = (cov[r] or 0) + 1
		end
		if st.ready then
			cov[st.ready.recipe] = (cov[st.ready.recipe] or 0) + 1
		end
	end
	for id, n in pairs(Core.S.Hands.dishCounts(plot)) do
		cov[id] = (cov[id] or 0) + n
	end
	return cov
end

-- The oldest order this station can make that nobody is making yet: ticket, recipe
function Cooking.nextOrder(e)
	if not dataOf(e) then
		return nil
	end
	local unlocked = {}
	for _, r in ipairs(unlockedRecipes(e)) do
		unlocked[r.id] = r
	end
	local cov = coverage(e.plot)
	local seen = {}
	for _, t in ipairs(Cooking.ticketsOf(e.plot)) do
		seen[t.recipe] = (seen[t.recipe] or 0) + 1
		local r = unlocked[t.recipe]
		if r and seen[t.recipe] > (cov[t.recipe] or 0) then
			return t, r
		end
	end
	return nil
end

-- What is missing to start recipe r: ingredient ids not on the shelves (rice and broths included)
-- and "dishes" when every plate is dirty
function Cooking.missing(plot, r)
	local Supply, Appliance = Core.S.Supply, Core.S.Appliance
	local out = {}
	for g, n in pairs(counts(r.ing)) do
		if Supply.shelfStock(plot, g) < n then
			table.insert(out, g)
		end
	end
	table.sort(out)
	if r.rice and not Appliance.hasRice(plot) then
		table.insert(out, "rice")
	end
	if r.broth and not Appliance.hasBroth(plot, r.broth) then
		table.insert(out, r.broth)
	end
	local d = Core.S.Plots.data(plot)
	if d and d.dishes.clean <= 0 then
		table.insert(out, "dishes")
	end
	return out
end

-- The recipe the board is heading for: the board itself if complete, else the next order of this
-- station when it still fits what is on the board, else any recipe that fits it
local function targetRecipe(e)
	local st = station(e)
	local ids = {}
	for _, b in ipairs(st.board) do
		table.insert(ids, b.g)
	end
	local exact = Cooking.match(e)
	if exact then
		return exact
	end
	local _, nextRecipe = Cooking.nextOrder(e)
	if nextRecipe and contains(nextRecipe, ids) then
		return nextRecipe
	end
	if #ids > 0 then
		for _, r in ipairs(unlockedRecipes(e)) do
			if contains(r, ids) then
				return r
			end
		end
	end
	return nil
end

-- Spots on the board: one per ingredient of the target recipe (or one per item without a target)
-- returns { { g, item?, cf } } where item is the board entry standing there (nil = still missing)
local function boardSpots(e)
	local st = station(e)
	local att = attachment(e, "Board")
	if not att then
		return {}
	end
	local recipe = targetRecipe(e)
	local spots = {}
	if recipe then
		local used = {}
		for _, g in ipairs(recipe.ing) do
			local found = nil
			for i, b in ipairs(st.board) do
				if not used[i] and b.g == g then
					used[i] = true
					found = b
					break
				end
			end
			table.insert(spots, { g = g, item = found })
		end
	else
		for _, b in ipairs(st.board) do
			table.insert(spots, { g = b.g, item = b })
		end
	end
	local n = #spots
	for i, sp in ipairs(spots) do
		sp.cf = att.WorldCFrame * CFrame.new((i - (n + 1) / 2) * BOARD_GAP, 0, 0)
	end
	return spots
end

-- Board: the ingredients put on it, and a see-through outline of each one still missing for the
-- order you are making, so you know what to bring and how many
local function layoutBoard(e)
	local st = station(e)
	clearBoardModels(st)
	if not e.model then
		return
	end
	local need = {}
	for _, sp in ipairs(boardSpots(e)) do
		if not sp.item then
			table.insert(need, sp.g)
		end
		local mdl = Core.S.Supply.standProduct(sp.g, sp.cf, BOARD_SCALE, true)
		if sp.item then
			mdl.Parent = e.model
			table.insert(st.boardModels, mdl)
		else
			for _, d in ipairs(mdl:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Material = Enum.Material.ForceField
					d.Transparency = math.max(d.Transparency, 0.35)
					d.CastShadow = false
				end
			end
			mdl.Name = "Ghost"
			mdl.Parent = e.model
			table.insert(st.ghostModels, mdl)
		end
	end
	-- the hint on the station lists what is still missing
	e.model:SetAttribute("Need", table.concat(need, ","))
end

-- new orders change what the idle boards ask for
local function relayoutIdleBoards(plot)
	for _, e in ipairs(Core.S.Entities.ofKind("station", plot)) do
		local st = station(e)
		if not st.busy and st.step == 0 and not st.ready then
			layoutBoard(e)
		end
	end
end

local function stepDuration(e, stepName, recipe, speed)
	local d = dataOf(e)
	local cfg = GameConfig.Steps[stepName] or { time = 1, tool = "up_knife" }
	local t = cfg.time * Upgrades.value(d.upgrades, cfg.tool)
	local mastery = Formulas.masteryLevel(d.mastery[recipe.id] or 0)
	t = t * (1 - 0.05 * mastery)
	return math.max(0.25, t / (speed or 1))
end

local function animateStep(e, stepName, duration)
	local st = station(e)
	local toolAtt = attachment(e, "Tool")
	local boardAtt = attachment(e, "Board")
	if not toolAtt or not boardAtt then
		task.wait(duration)
		return
	end
	local tool = Registry.food("tool", TOOL_FOR_STEP[stepName] or "knife")
	for _, d in ipairs(tool:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanQuery = false
		end
	end
	tool.Parent = e.model
	local top = toolAtt.WorldCFrame
	local low = boardAtt.WorldCFrame * CFrame.new(0, 0.45, 0)
	local steps = math.max(8, math.floor(duration / 0.04))
	local pos = boardAtt.WorldPosition
	Core.S.Net.fx("step", { name = stepName, dur = duration, pos = pos })
	local startScales = {}
	for i, mdl in ipairs(st.boardModels) do
		startScales[i] = mdl:GetPivot()
	end
	for k = 1, steps do
		local t = k / steps
		if stepName == "cut" then
			local chop = math.abs(math.sin(t * math.pi * 3))
			tool:PivotTo(low:Lerp(top, chop * 0.6) * CFrame.new(0.2 * math.sin(t * math.pi * 6), 0, 0))
		elseif stepName == "roll" or stepName == "mold" then
			tool:PivotTo(low * CFrame.Angles(t * math.pi * 2, 0, 0))
		elseif stepName == "combine" then
			tool:PivotTo(top:Lerp(low, math.sin(t * math.pi) * 0.8))
			for i, mdl in ipairs(st.boardModels) do
				local from = startScales[i]
				mdl:PivotTo(from:Lerp(boardAtt.WorldCFrame * CFrame.new(0, 0.3, 0), t))
			end
		else
			tool:PivotTo(top:Lerp(low, math.abs(math.sin(t * math.pi * 2)) * 0.8) * CFrame.Angles(0, 0, math.sin(t * math.pi * 4) * 0.3))
		end
		task.wait(duration / steps)
	end
	tool:Destroy()
end

local function showDish(e, recipeId)
	local st = station(e)
	if st.dish then
		st.dish:Destroy()
	end
	local att = attachment(e, "Plate")
	if not att then
		return
	end
	local d = dataOf(e)
	local gold = d ~= nil and Formulas.masteryLevel(d.mastery[recipeId] or 0) >= #Formulas.MasteryThresholds
	local mdl = Registry.food("dish", recipeId, gold)
	mdl:PivotTo(att.WorldCFrame * CFrame.new(0, 0.5, 0))
	for _, d in ipairs(mdl:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanQuery = false
		end
	end
	mdl.Parent = e.model
	st.dish = mdl
end

local function isFresh(e, st)
	for _, b in ipairs(st.board) do
		if b.fresh then
			return true
		end
	end
	return Core.S.Appliance.fridgeNear(e.plot, e.model.PrimaryPart.Position)
end

-- Runs the next step. Returns ok, messageKey, params
function Cooking.step(e, speed, actor)
	local st = station(e)
	local recipe = Cooking.match(e)
	if not recipe then
		return false, "msg.no_recipe_fits"
	end
	local Appliance = Core.S.Appliance
	if #st.boardModels ~= #st.board then
		-- clicked before the last ingredients finished flying in: draw them now
		layoutBoard(e)
	end
	if st.step == 0 then
		local d = dataOf(e)
		if not d then
			return false
		end
		if recipe.rice and not Appliance.hasRice(e.plot) then
			return false, "msg.need_rice"
		end
		if recipe.broth and not Appliance.hasBroth(e.plot, recipe.broth) then
			return false, "msg.need_broth", { name = "ing." .. recipe.broth }
		end
		if d.dishes.clean <= 0 then
			return false, "msg.no_dishes"
		end
		if recipe.rice then
			Appliance.takeRice(e.plot)
		end
		if recipe.broth then
			Appliance.takeBroth(e.plot, recipe.broth)
		end
		Appliance.takeCleanDish(e.plot)
		st.recipe = recipe.id
		st.perfect = false
	end
	st.busy = true
	publish(e)
	local stepName = recipe.steps[st.step + 1]
	local duration = stepDuration(e, stepName, recipe, speed)
	-- noodles boiling: the player may stop a needle in the green part for a perfect bowl
	local NT = GameConfig.NoodleTiming
	if stepName == "boil" and NT and typeof(actor) == "Instance" then
		st.timing = { player = actor, start = os.clock(), dur = duration }
		Core.S.Net.fxTo(actor, "timing", { uid = e.uid, dur = duration, a = NT.From, b = NT.To })
	end
	animateStep(e, stepName, duration)
	st.timing = nil
	st.step += 1
	st.busy = false
	if st.step >= #recipe.steps then
		local fresh = isFresh(e, st)
		st.board = {}
		clearBoardModels(st)
		st.step = 0
		st.recipe = nil
		st.ready = { recipe = recipe.id, fresh = fresh, perfect = st.perfect == true }
		Core.S.Analytics.step(e.plot.owner, "first_cook")
		showDish(e, recipe.id)
		Core.S.Net.fx("dishReady", { pos = e.model.PrimaryPart.Position + Vector3.new(0, 4, 0), recipe = recipe.id })
	end
	publish(e)
	return true
end

-- Starts the next order of this station: its ingredients fly from the shelves onto the board and
-- the first step runs right away (so a ramen is three presses: noodles, broth, toppings)
local function start(e, speed, actor)
	local st = station(e)
	local t, r = Cooking.nextOrder(e)
	if not t then
		if #Cooking.ticketsOf(e.plot) == 0 then
			return false, "msg.no_orders"
		end
		return false, "msg.no_orders_here", { station = "station." .. stationType(e) }
	end
	local missing = Cooking.missing(e.plot, r)
	if #missing > 0 then
		local first = missing[1]
		if first == "dishes" then
			return false, "msg.no_dishes"
		elseif first == "rice" then
			return false, "msg.need_rice"
		elseif Ingredients.byId[first] and Ingredients.byId[first].storage == "broth" then
			return false, "msg.need_broth", { name = "ing." .. first }
		end
		return false, "msg.restock_needed", { name = "ing." .. first }
	end
	local Supply = Core.S.Supply
	local pos = e.model and e.model.PrimaryPart and e.model.PrimaryPart.Position
	local origins = {}
	st.board = {}
	for _, g in ipairs(r.ing) do
		local from, fresh = Supply.takeIngredient(e.plot, g, pos)
		table.insert(st.board, { g = g, fresh = fresh })
		table.insert(origins, from)
	end
	st.recipe = r.id
	st.busy = true
	publish(e)
	-- every ingredient flies from its shelf to its spot on the board
	local flights = {}
	for i, sp in ipairs(boardSpots(e)) do
		table.insert(flights, { g = sp.g, cf = sp.cf, s = BOARD_SCALE, rot = true, from = origins[i] })
	end
	local step = GameConfig.StockFlyStep or 0.06
	Core.S.Net.fx("stock", { items = flights, step = step })
	task.wait(#flights * step + 0.3)
	layoutBoard(e)
	st.busy = false
	return Cooking.step(e, speed, actor)
end

-- Click on a station (players and staff)
function Cooking.use(actor, e, speed)
	local Hands = Core.S.Hands
	local st = station(e)
	local hands = Hands.get(actor)
	if st.busy then
		return false, "msg.busy"
	end
	if hands.kind and hands.plot and hands.plot ~= e.plot then
		return false, "msg.other_restaurant"
	end
	if hands.kind == "ing" then
		local deposited = 0
		local remaining = {}
		local ids = {}
		for _, b in ipairs(st.board) do
			table.insert(ids, b.g)
		end
		for _, item in ipairs(hands.items) do
			local test = table.clone(ids)
			table.insert(test, item.g)
			if fits(e, test) then
				ids = test
				table.insert(st.board, item)
				deposited += 1
			else
				table.insert(remaining, item)
			end
		end
		if deposited == 0 then
			return false, (#st.board == 0) and "msg.no_recipe_fits" or "msg.not_for_this"
		end
		Hands.set(actor, "ing", remaining)
		publish(e)
		-- the ingredients fly from your hands onto their spots, then the board is redrawn
		local flights = {}
		local newItems = {}
		for i = #st.board - deposited + 1, #st.board do
			newItems[st.board[i]] = true
		end
		for _, sp in ipairs(boardSpots(e)) do
			if sp.item and newItems[sp.item] then
				table.insert(flights, { g = sp.g, cf = sp.cf, s = BOARD_SCALE, rot = true })
			end
		end
		local step = GameConfig.StockFlyStep or 0.06
		Core.S.Net.fx("stock", { from = Core.S.Supply.handPos(actor), items = flights, step = step * 2 })
		task.delay(#flights * step * 2 + 0.3, function()
			if not st.busy and st.step == 0 then
				layoutBoard(e)
			end
		end)
		return true
	elseif hands.kind == "dish" or hands.kind == nil then
		if st.ready then
			local ok, reason = Hands.add(actor, "dish", { recipe = st.ready.recipe, fresh = st.ready.fresh, perfect = st.ready.perfect }, e.plot)
			if not ok then
				return false, reason
			end
			st.ready = nil
			if st.dish then
				st.dish:Destroy()
				st.dish = nil
			end
			publish(e)
			return true
		end
		if hands.kind == "dish" then
			return false, "msg.hands_busy"
		end
		if #st.board > 0 then
			if Cooking.match(e) then
				return Cooking.step(e, speed, actor)
			end
			-- not a recipe (yet): put the ingredients back in hand
			if st.step == 0 then
				Hands.set(actor, "ing", st.board)
				st.board = {}
				layoutBoard(e)
				publish(e)
				return false, "msg.board_returned"
			end
		end
		-- an empty board: start the oldest order for this station
		return start(e, speed, actor)
	end
	return false, "msg.hands_busy"
end

------------------------------------------------------------------ tickets

function Cooking.maxTickets(plot)
	local d = Core.S.Plots.data(plot)
	return Upgrades.value(d and d.upgrades, "up_ticket")
end

local function ticketList(plot)
	local list = {}
	for _, t in ipairs(Cooking.ticketsOf(plot)) do
		table.insert(list, { id = t.id, recipe = t.recipe, created = t.created, customer = t.customer, claimed = t.claimed ~= nil })
	end
	return list
end

local function broadcast(plot)
	Core.S.Plots.fire(plot, "Tickets", ticketList(plot))
end

function Cooking.addTicket(plot, customerUid, recipeId)
	local tickets = Cooking.ticketsOf(plot)
	if #tickets >= Cooking.maxTickets(plot) then
		return nil
	end
	local t = { id = Uid.new("t"), recipe = recipeId, customer = customerUid, created = workspace:GetServerTimeNow() }
	table.insert(tickets, t)
	broadcast(plot)
	relayoutIdleBoards(plot)
	return t
end

function Cooking.removeTicket(plot, id)
	local tickets = Cooking.ticketsOf(plot)
	for i, t in ipairs(tickets) do
		if t.id == id then
			table.remove(tickets, i)
			broadcast(plot)
			relayoutIdleBoards(plot)
			return t
		end
	end
	return nil
end

function Cooking.ticketFor(plot, customerUid)
	for _, t in ipairs(Cooking.ticketsOf(plot)) do
		if t.customer == customerUid then
			return t
		end
	end
	return nil
end

function Cooking.clearTickets(plot)
	plot.tickets = {}
	broadcast(plot)
end

-- Dishes ready on the stations of a restaurant (for waiters)
function Cooking.readyDishes(plot)
	local out = {}
	for _, e in ipairs(Core.S.Entities.ofKind("station", plot)) do
		local st = station(e)
		if st.ready then
			table.insert(out, { entity = e, recipe = st.ready.recipe })
		end
	end
	return out
end

function Cooking.stationState(e)
	return station(e)
end

function Cooking.isRecipeInProgress(plot, recipeId)
	local n = 0
	for _, e in ipairs(Core.S.Entities.ofKind("station", plot)) do
		local st = station(e)
		if st.recipe == recipeId or (st.ready and st.ready.recipe == recipeId) then
			n += 1
		end
	end
	return n
end

-- the player stopped the needle: k = where (0..1 of the boil step) as the client saw it
local function timingHit(player, uid, k)
	if type(uid) ~= "string" or type(k) ~= "number" then
		return
	end
	local e = Core.S.Entities.get(uid)
	if not e or e.kind ~= "station" then
		return
	end
	local st = station(e)
	local tm = st.timing
	if not tm or tm.player ~= player or tm.hit then
		return
	end
	tm.hit = true
	local elapsed = (os.clock() - tm.start) / tm.dur
	local NT = GameConfig.NoodleTiming
	-- trust the client's needle (latency) as long as it is close to what the server saw
	local ok = k >= NT.From and k <= NT.To and math.abs(elapsed - k) < 0.35
	if ok then
		st.perfect = true
	end
	Core.S.Net.fxTo(player, "timingResult", { ok = ok, pos = e.model and e.model.PrimaryPart and e.model.PrimaryPart.Position })
end

function Cooking.Start()
	local Plots = Core.S.Plots
	-- a player who starts working in a restaurant gets its order tickets
	Plots.WorkChanged:Connect(function(player, plot)
		Core.S.Net.fire(player, "Tickets", ticketList(plot))
	end)
	Plots.Claimed:Connect(function(plot)
		plot.tickets = {}
	end)
	Plots.Released:Connect(function(plot)
		plot.tickets = {}
	end)
	-- stations always show what the next press does (orders, stock and dishes change all the time)
	while true do
		task.wait(0.5)
		for _, e in ipairs(Core.S.Entities.ofKind("station")) do
			local ok, err = pcall(publish, e)
			if not ok then
				warn("[Cooking] publish failed: " .. tostring(err))
			end
		end
	end
end

function Cooking.Init()
	Core.S.Net.on("TimingHit", timingHit, 6)
	local Placement = Core.S.Placement
	Placement.ItemAdded:Connect(function(e)
		if e.kind == "station" then
			publish(e)
		end
	end)
	Placement.ItemMoved:Connect(function(e)
		if e.kind == "station" then
			layoutBoard(e)
			if station(e).ready then
				showDish(e, station(e).ready.recipe)
			end
		end
	end)
	Placement.addVeto(function(e)
		if e.kind == "station" then
			local st = station(e)
			if st.busy or #st.board > 0 or st.ready then
				return false, "msg.empty_first"
			end
		end
		return true
	end)
	local _ = Ingredients
end

return Cooking
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000074"><Properties><string name="Name">Customers</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Customers of every restaurant (c.plot): arrive along the street, take a seat, order by
-- themselves, wait (patience), pay when served, eat, review, leave.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Customers = require(Shared.Config.Customers)
local Recipes = require(Shared.Config.Recipes)
local Expansions = require(Shared.Config.Expansions)
local StaffCfg = require(Shared.Config.Staff)
local Formulas = require(Shared.Logic.Formulas)
local TableUtil = require(Shared.Util.TableUtil)
local Registry = require(Shared.Models.Registry)
local Uid = require(Shared.Util.Uid)
local Core = require(script.Parent.Parent.Core)

local Service = {}
Service.active = {} -- [uid] = customer (c.plot = its restaurant)
local rng = Random.new()

local CFG = GameConfig.Customers
local RewardsCfg = require(Shared.Config.Rewards)
local MAIN = { sushi = true, ramen = true }

local function pdata(plot)
	return Core.S.Plots.data(plot)
end

------------------------------------------------------------------ menu availability

function Service.availableMenu(plot)
	if plot.menuCache and os.clock() - (plot.menuCacheTime or 0) < 2 then
		return plot.menuCache
	end
	local d = pdata(plot)
	local out = {}
	if not d then
		return out
	end
	local Supply, Appliance = Core.S.Supply, Core.S.Appliance
	local stations = {}
	for _, e in ipairs(Core.S.Entities.ofKind("station", plot)) do
		stations[e.item.fn.station] = true
	end
	for _, r in ipairs(Core.S.Progression.menuRecipes(d)) do
		local ok = stations[r.station] == true
		if ok then
			for _, g in ipairs(r.ing) do
				if Supply.shelfStock(plot, g) <= 0 and Supply.boxCount(plot, g) <= 0 then
					ok = false
					break
				end
			end
		end
		if ok and r.rice and not (Appliance.willHave(plot, "ricecooker") or Supply.boxCount(plot, "rice") > 0) then
			ok = false
		end
		if ok and r.broth and not (Appliance.willHave(plot, "pot", r.broth) or Supply.boxCount(plot, r.broth) > 0) then
			ok = false
		end
		if ok then
			table.insert(out, r)
		end
	end
	plot.menuCache, plot.menuCacheTime = out, os.clock()
	return out
end

local function chooseOrder(c, mainOnly)
	local d = pdata(c.plot)
	if not d then
		return nil
	end
	local menu = Service.availableMenu(c.plot)
	local list = {}
	for _, r in ipairs(menu) do
		local isMain = MAIN[r.cat] == true
		if (mainOnly and isMain) or (not mainOnly and not isMain) then
			table.insert(list, r)
		end
	end
	if #list == 0 then
		if mainOnly then
			list = menu
		else
			return nil
		end
	end
	local prefer = {}
	for _, p in ipairs(c.cfg.prefer) do
		prefer[p] = true
	end
	local pick = TableUtil.weightedPick(list, function(r)
		local m = d.menu[r.id]
		local w = Formulas.demandFactor(m and m.price or 1)
		if prefer[r.cat] then
			w *= 2
		end
		if prefer.cheap and r.price <= 60 then
			w *= 2
		end
		if prefer.expensive and r.price >= 150 then
			w *= 2.5
		end
		if prefer.mastery and Formulas.masteryLevel(d.mastery[r.id] or 0) >= 2 then
			w *= 3
		end
		return w
	end, rng)
	return pick
end

------------------------------------------------------------------ helpers

local placeOrder

local function setState(c, state)
	c.state = state
	if c.npc and c.npc.model then
		c.npc.model:SetAttribute("State", state)
	end
end

local function setOrder(c, recipe)
	c.order = recipe and recipe.id or nil
	if c.npc and c.npc.model then
		c.npc.model:SetAttribute("Order", c.order or "")
	end
	if recipe and c.plot then
		Core.S.Analytics.step(c.plot.owner, "first_order")
	end
end

-- puts the customer's order on the order bar; false when the bar is full
placeOrder = function(c)
	if c.state ~= "order" or not c.order then
		return false
	end
	local t = Core.S.Cooking.addTicket(c.plot, c.uid, c.order)
	if not t then
		return false
	end
	c.ticket = t
	-- a fresh, full timer for cooking it
	c.patience = c.patienceMax
	setState(c, "waiting")
	if c.npc and c.npc.root then
		Core.S.Net.fx("sfx", { name = "ticket", pos = c.npc.root.Position })
	end
	return true
end

local function patienceTick(c, dt)
	c.patience = math.max(0, c.patience - dt)
	c.minPatience = math.min(c.minPatience, c.patience / c.patienceMax)
	if c.npc and c.npc.model then
		c.npc.model:SetAttribute("Patience", c.patience / c.patienceMax)
	end
end

local function floorPos(seat)
	local p = seat.sit.Position
	local floorY = Core.S.World.floorY(seat.floor)
	local back = -seat.sit.LookVector * 1.4
	return Vector3.new(p.X + back.X, floorY + 0.5, p.Z + back.Z)
end

local function dirtyNear(plot, pos)
	for _, e in ipairs(Core.S.Entities.ofKind("dirty", plot)) do
		local p = Core.S.Entities.position(e)
		if p and (p - pos).Magnitude < 6 then
			return true
		end
	end
	return false
end

-- along the sidewalk, on one side of the restaurant's door
local function streetPoint(plot, side)
	local a, b = CFG.StreetSpawn[1], CFG.StreetSpawn[2]
	return Vector3.new(plot.origin.X + side * (a + rng:NextNumber() * (b - a)), 0, Expansions.StreetWalkZ)
end

local function entrance(plot)
	return Core.S.Plots.toWorld(plot, Expansions.Entrance.x + rng:NextNumber() * 2 - 1, 0, Expansions.Entrance.z - 1)
end

local function dishKind(recipeId)
	local r = Recipes.byId[recipeId]
	if r and (r.dish == "bowl" or r.dish == "soup" or r.dish == "tsukemen") then
		return "bowl"
	end
	return "plate"
end

------------------------------------------------------------------ lifecycle

local function release(c)
	c.gone = true
	Service.active[c.uid] = nil
	Core.S.Entities.unregister(c.uid)
	if c.ticket then
		Core.S.Cooking.removeTicket(c.plot, c.ticket.id)
		c.ticket = nil
	end
	if c.seat then
		c.seat.occupant = nil
		c.seat.reserved = nil
	end
	if c.dishModel then
		c.dishModel:Destroy()
		c.dishModel = nil
	end
	if c.bench then
		Core.S.Seating.freeBench(c.bench)
		c.bench = nil
	end
	if c.npc then
		c.npc.model:SetAttribute("State", nil)
		c.npc.model:SetAttribute("Order", nil)
		Core.S.Npc.release(c.npc)
		c.npc = nil
	end
end

local function leaveRestaurant(c)
	local Npc = Core.S.Npc
	setState(c, "leaving")
	setOrder(c, nil)
	if c.npc then
		Npc.stand(c.npc)
		Npc.walkTo(c.npc, entrance(c.plot))
		Npc.walkTo(c.npc, streetPoint(c.plot, c.side))
	end
	release(c)
end

local function review(c, walkedOut)
	local Progression, Economy = Core.S.Progression, Core.S.Economy
	local plot = c.plot
	if not pdata(plot) then
		return
	end
	local amb = Core.S.Placement.ambienceOf(plot)
	local pos = c.seat and c.seat.dish or Vector3.new()
	local stars = Formulas.review({
		left = walkedOut,
		patienceLeft = c.minPatience,
		dirtyNearby = dirtyNear(plot, pos),
		fresh = c.fresh,
		freshBonus = GameConfig.FreshReviewBonus,
		ambienceTier = amb.tier,
		comfort = c.seat and c.seat.comfort or 0,
	})
	Progression.addReview(plot, stars, c.cfg.reviewWeight or 1)
	local L = Economy.ledgerOf(plot)
	L.reviews += 1
	L.stars += stars
	if walkedOut then
		L.walkouts += 1
	else
		L.customers += 1
	end
	local owner = plot.owner
	Core.S.Net.fx("review", { stars = stars, pos = (c.npc and c.npc.root and c.npc.root.Position or pos) + Vector3.new(0, 3, 0), type = c.cfg.id })
	if not walkedOut then
		Core.S.Meta.event(owner, "customers", 1)
		if stars >= 4 then
			Core.S.Meta.event(owner, "happy", 1)
		end
		local d = pdata(plot)
		if not d then
			return
		end
		d.stats.customers += 1
		if stars >= 5 and c.cfg.reviewWeight then
			Economy.addSakura(owner, 3)
			Core.S.Plots.notify(plot, "msg.critic_happy", nil, "success")
		end
		if stars >= 5 and c.cfg.influencer then
			d.boosts.influencer = (d.stats.days or 0) + 2
			Core.S.Plots.notify(plot, "msg.influencer_happy", nil, "success")
		end
	else
		Core.S.Plots.notify(plot, "msg.customer_left", nil, "warning")
	end
end

local function pay(c, recipe)
	local plot = c.plot
	local d = pdata(plot)
	if not d then
		return
	end
	local Economy = Core.S.Economy
	local owner = plot.owner
	local amb = Core.S.Placement.ambienceOf(plot)
	local price = Core.S.Progression.priceOf(d, recipe)
	local tip = Formulas.tip(price, {
		fresh = c.fresh,
		freshBonus = GameConfig.FreshTipBonus,
		ambienceTip = amb.tip,
		comfort = c.seat and c.seat.comfort or 0,
		patienceLeft = c.patience / c.patienceMax,
		customerTip = c.cfg.tip,
		extraTip = (c.comboBonus or 0) + (c.perfect and GameConfig.NoodleTiming.TipBonus or 0),
	})
	local got = Economy.add(owner, price, "sale")
	-- with a tip jar on the counter the tip waits there until you collect it
	local gotTip = 0
	local inJar = Economy.tipToJar(plot, tip)
	if not inJar then
		gotTip = Economy.add(owner, tip, "tip")
	end
	local helper = c.servedBy
	if helper and typeof(helper) == "Instance" and helper ~= owner and helper.Parent then
		local share = math.floor((price + tip) * GameConfig.HelperRewardShare + 0.5)
		Economy.add(helper, share, "helper")
		Core.S.Progression.addXp(helper, math.floor(recipe.xp * 0.5))
	end
	Core.S.Analytics.step(owner, "first_serve")
	if (d.stats.customers or 0) >= 10 then
		Core.S.Analytics.step(owner, "served_10")
	end
	Core.S.Net.fx("money", { amount = got + gotTip, tip = gotTip, pos = (c.npc and c.npc.root and c.npc.root.Position or c.seat.dish) + Vector3.new(0, 3, 0) })
	Core.S.Net.fx("sfx", { name = "coin", pos = c.seat.dish })
	if gotTip > 0 then
		task.delay(0.35, function()
			Core.S.Net.fx("sfx", { name = "tip", pos = c.seat and c.seat.dish or Vector3.new() })
		end)
	end
end

local function eat(c, recipe)
	setState(c, "eating")
	local eatTime = CFG.EatTime[recipe.cat] or 10
	local total = eatTime * (0.85 + rng:NextNumber() * 0.3)
	if (recipe.cat == "ramen" or recipe.cat == "drink") and c.seat then
		-- noodles and soup are eaten with a proper slurp
		local where = c.seat.dish
		for _, at in ipairs({ 0.15, 0.45, 0.75 }) do
			task.delay(total * at, function()
				if c.state == "eating" then
					Core.S.Net.fx("sfx", { name = "slurp", pos = where })
				end
			end)
		end
	end
	task.wait(total)
	if c.dishModel then
		c.dishModel:Destroy()
		c.dishModel = nil
	end
	c.dishKind = dishKind(recipe.id)
	c.eaten += 1
end

local function leaveDirty(c)
	if not c.seat or c.eaten == 0 or not pdata(c.plot) then
		return
	end
	local m = Registry.food("dirty", c.dishKind or "plate")
	m:PivotTo(CFrame.new(c.seat.dish + Vector3.new(0, 0.3, 0)))
	m.Parent = Core.S.World.folders(c.plot).dynamic
	local uid = Uid.new("d")
	Core.S.Entities.register(uid, "dirty", m, { seat = c.seat, plot = c.plot })
	c.seat.dirty = uid
end

-- Main AI for one customer
local function run(c)
	local Npc = Core.S.Npc
	local Seating = Core.S.Seating
	local plot = c.plot
	-- walk in: the wind chime over the door rings
	Npc.walkTo(c.npc, entrance(plot))
	Core.S.Net.fx("sfx", { name = "chime", pos = entrance(plot) + Vector3.new(0, 7, 0) })
	-- wait in queue until a seat is free
	if not c.seat then
		setState(c, "queue")
		c.bench = Seating.benchSpot(plot, c.uid)
		if c.bench then
			Npc.walkTo(c.npc, c.bench.sit.Position)
			Npc.sit(c.npc, c.bench.sit)
		end
		local waited = 0
		while not c.seat and waited < 60 do
			task.wait(1)
			waited += 1
			if c.groupLeader == c and c.groupSeatsReady then
				break
			end
			if c.assignedSeat then
				c.seat = c.assignedSeat
			end
		end
		if c.bench then
			Npc.stand(c.npc)
			Seating.freeBench(c.bench)
			c.bench = nil
		end
		if not c.seat then
			return leaveRestaurant(c)
		end
	end
	setState(c, "walking")
	c.seat.occupant = c.uid
	Npc.walkTo(c.npc, floorPos(c.seat))
	Npc.sit(c.npc, c.seat.sit)
	setState(c, "reading")
	task.wait(rng:NextNumber() * (CFG.MenuReadTime[2] - CFG.MenuReadTime[1]) + CFG.MenuReadTime[1])
	local ordersLeft = c.cfg.ordersEach or 1
	local first = true
	while ordersLeft > 0 do
		local recipe = chooseOrder(c, first)
		if not recipe then
			break
		end
		setOrder(c, recipe)
		c.patience = c.patienceMax * (first and 1 or 0.85)
		setState(c, "order")
		-- the customer orders by themselves: the ticket goes on the order bar right away (when the
		-- bar is full they keep asking until there is room)
		placeOrder(c)
		while c.state == "order" or c.state == "waiting" do
			task.wait(0.5)
			if c.state == "order" then
				placeOrder(c)
			end
			patienceTick(c, 0.5)
			if c.patience <= 0 then
				review(c, true)
				if c.npc and c.npc.play then
					Npc.emote(c.npc, "wave")
				end
				return leaveRestaurant(c)
			end
		end
		if c.state ~= "served" then
			return leaveRestaurant(c)
		end
		eat(c, recipe)
		ordersLeft -= 1
		first = false
		if ordersLeft == 0 and c.eaten == 1 and rng:NextNumber() < CFG.ExtraOrderChance then
			ordersLeft = 1
		end
	end
	review(c, false)
	if c.npc then
		Npc.emote(c.npc, "cheer")
	end
	task.wait(0.8)
	leaveDirty(c)
	if c.seat then
		c.seat.occupant = nil
		c.seat.reserved = nil
	end
	leaveRestaurant(c)
end

local function spawnCustomer(plot, cfg, side, seat, group)
	-- in a family the third and fourth members are children
	local child = cfg.id == "cust_family" and group ~= nil and #group.members >= 2
	local npc = Core.S.Npc.acquireCustomer(cfg.look, child)
	if not npc then
		return nil
	end
	local uid = Uid.new("c")
	local amb = Core.S.Placement.ambienceOf(plot)
	local patience = cfg.patience
	local clock = Core.S.Day.clock or 12
	if cfg.lunchPatience and clock >= 12 and clock < 14 then
		patience = cfg.lunchPatience
	end
	patience = patience * (1 + amb.patience) * (CFG.PatienceMult or 1)
	local c = {
		uid = uid, cfg = cfg, npc = npc, seat = seat, side = side, state = "arriving", group = group,
		patienceMax = patience, patience = patience, minPatience = 1, eaten = 0, fresh = false, plot = plot,
	}
	Service.active[uid] = c
	Core.S.Entities.register(uid, "customer", npc.model, { customer = c, plot = plot })
	npc.model:SetAttribute("Type", cfg.id)
	npc.model:SetAttribute("Patience", 1)
	local start = streetPoint(plot, side)
	Core.S.Npc.spawn(npc, CFrame.new(start + Vector3.new(0, 3, 0)) * CFrame.Angles(0, math.rad(side > 0 and 90 or -90), 0))
	task.spawn(function()
		local ok, err = pcall(run, c)
		-- a customer removed while walking (the owner left) just stops
		if not ok and not c.gone then
			warn("[Customers] " .. tostring(err))
			release(c)
		end
	end)
	return c
end

local function pickType(plot, d)
	local list = {}
	local hasTables = false
	local hasVip = false
	for _, s in ipairs(Core.S.Seating.list(plot)) do
		if s.group and not s.vip then
			hasTables = true
		end
		if s.vip then
			hasVip = true
		end
	end
	for _, cfg in ipairs(Customers.list) do
		if d.level >= cfg.lv and (not cfg.needsTable or hasTables) and (not cfg.vip or hasVip) and (cfg.group[1] == 1 or hasTables or cfg.vip) then
			table.insert(list, cfg)
		end
	end
	local tourists = false
	for id, day in pairs(d.ads or {}) do
		if id == "ad_tv" and day == (d.stats.days or 0) + 1 then
			tourists = true
		end
	end
	return TableUtil.weightedPick(list, function(cfg)
		if tourists and cfg.id == "cust_tourist" then
			return cfg.weight * 2
		end
		return cfg.weight
	end, rng)
end

-- customers of a restaurant (alive)
local function countOf(plot)
	local n = 0
	for _, c in pairs(Service.active) do
		if c.plot == plot then
			n += 1
		end
	end
	return n
end

function Service.trySpawn(plot, forcedType)
	local d = pdata(plot)
	if not d then
		return false
	end
	if Core.S.Npc.count() >= CFG.MaxNpcs or countOf(plot) >= CFG.MaxPerRestaurant then
		return false
	end
	if #Service.availableMenu(plot) == 0 then
		if not plot.warnedMenu then
			plot.warnedMenu = true
			Core.S.Plots.notify(plot, "msg.no_menu", nil, "warning")
		end
		return false
	end
	plot.warnedMenu = false
	local cfg = forcedType and Customers.byId[forcedType] or pickType(plot, d)
	if not cfg then
		return false
	end
	local size = rng:NextInteger(cfg.group[1], cfg.group[2])
	local needsTable = cfg.needsTable or size > 1
	local seats = Core.S.Seating.find(plot, size, needsTable, cfg.vip == true)
	local side = rng:NextNumber() < 0.5 and -1 or 1
	if not seats then
		-- queue (only if there is room)
		plot.queue = plot.queue or {}
		local waiting = 0
		for _, g in ipairs(plot.queue) do
			waiting += #g.members
		end
		if waiting + size > CFG.BaseQueue + Core.S.Seating.queueCapacity(plot) then
			return false
		end
		local group = { members = {}, size = size, needsTable = needsTable, vip = cfg.vip == true }
		for _ = 1, size do
			local c = spawnCustomer(plot, cfg, side, nil, group)
			if c then
				table.insert(group.members, c)
			end
		end
		table.insert(plot.queue, group)
		return true
	end
	Core.S.Seating.reserve(seats, "pending")
	local group = { members = {} }
	for i = 1, size do
		local c = spawnCustomer(plot, cfg, side, seats[i], group)
		if c then
			seats[i].reserved = c.uid
			table.insert(group.members, c)
		else
			Core.S.Seating.release(seats[i])
		end
		task.wait(0.4)
	end
	if cfg.celebrity then
		Core.S.Plots.notify(plot, "msg.celebrity", nil, "success")
		task.spawn(function()
			for _ = 1, 4 do
				task.wait(2)
				Service.trySpawn(plot, "cust_student")
			end
		end)
	end
	return true
end

local function serveQueue(plot)
	local queue = plot.queue or {}
	for i = #queue, 1, -1 do
		local g = queue[i]
		local alive = {}
		for _, c in ipairs(g.members) do
			if Service.active[c.uid] and c.state == "queue" then
				table.insert(alive, c)
			end
		end
		if #alive == 0 then
			table.remove(queue, i)
		else
			local seats = Core.S.Seating.find(plot, #alive, g.needsTable and #alive > 1, g.vip)
			if seats then
				for k, c in ipairs(alive) do
					seats[k].reserved = c.uid
					c.assignedSeat = seats[k]
				end
				table.remove(queue, i)
			end
		end
	end
end

------------------------------------------------------------------ interaction

function Service.use(actor, e)
	local c = e.customer
	if not c then
		return false
	end
	local Hands = Core.S.Hands
	if c.state == "order" then
		if not placeOrder(c) then
			return false, "msg.tickets_full"
		end
		return true
	elseif c.state == "waiting" then
		local hands = Hands.get(actor)
		if hands.kind == "dish" and hands.plot and hands.plot ~= c.plot then
			return false, "msg.other_restaurant"
		end
		if hands.kind == "dish" then
			for i, dish in ipairs(hands.items) do
				if dish.recipe == c.order then
					Hands.removeAt(actor, i)
					Service.serve(c, dish, actor)
					return true
				end
			end
			return false, "msg.wrong_dish", { dish = "rec." .. c.order }
		end
		return false, "msg.customer_waits", { dish = "rec." .. c.order }
	elseif c.state == "reading" or c.state == "walking" then
		return false, "msg.customer_reading"
	end
	return false, "msg.customer_happy"
end

-- Serving combo: dishes served close together raise the tip (Config/Rewards.Combo), per restaurant
local function bumpCombo(c)
	local cfg = RewardsCfg.Combo
	c.plot.combo = c.plot.combo or { n = 0, last = -1e9 }
	local combo = c.plot.combo
	local now = os.clock()
	if now - combo.last <= cfg.Window then
		combo.n += 1
	else
		combo.n = 1
	end
	combo.last = now
	c.comboBonus = math.min(combo.n - 1, cfg.Max) * cfg.Step
	if combo.n >= 2 and c.seat then
		Core.S.Net.fx("combo", { n = combo.n, bonus = c.comboBonus, pos = c.seat.dish + Vector3.new(0, 4, 0) })
	end
end

function Service.serve(c, dish, actor)
	local recipe = Recipes.byId[dish.recipe]
	bumpCombo(c)
	if c.ticket then
		Core.S.Cooking.removeTicket(c.plot, c.ticket.id)
		c.ticket = nil
	end
	c.fresh = dish.fresh == true
	c.perfect = dish.perfect == true
	c.servedBy = actor
	local plot = c.plot
	local d = pdata(plot)
	if not d then
		return
	end
	local served = d.mastery[dish.recipe] or 0
	local m = Registry.food("dish", dish.recipe, Formulas.masteryLevel(served) >= #Formulas.MasteryThresholds)
	m:PivotTo(CFrame.new(c.seat.dish + Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, math.rad(rng:NextInteger(0, 359)), 0))
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanQuery = false
		end
	end
	m.Parent = Core.S.World.folders(plot).dynamic
	c.dishModel = m
	Core.S.Net.fx("sfx", { name = "plate", pos = c.seat.dish })
	setState(c, "served")
	local owner = plot.owner
	local L = Core.S.Economy.ledgerOf(plot)
	d.stats.dishes += 1
	L.served += 1
	L.bestDish[recipe.id] = (L.bestDish[recipe.id] or 0) + 1
	Core.S.Progression.addMastery(plot, recipe.id)
	Core.S.Progression.addXp(owner, recipe.xp)
	Core.S.Meta.event(owner, "serve", 1, { recipe = recipe.id })
	if recipe.cat == "sushi" then
		Core.S.Meta.event(owner, "serve_sushi", 1)
	elseif recipe.cat == "ramen" then
		Core.S.Meta.event(owner, "serve_ramen", 1)
	end
	Core.S.Data.changed(owner, "stats")
	-- paid on the spot: price and tip fly to the wallet the moment the dish lands
	pay(c, recipe)
	if c.npc and c.npc.root then
		Core.S.Net.fx("served", { pos = c.npc.root.Position + Vector3.new(0, 3.5, 0) })
	end
end

function Service.collectDirty(actor, e)
	local Hands = Core.S.Hands
	local ok, reason = Hands.add(actor, "dirty", { dish = "plate" }, e.plot)
	if not ok then
		return false, reason
	end
	if e.seat then
		e.seat.dirty = nil
	end
	Core.S.Entities.unregister(e.uid)
	if e.model then
		if e.model.PrimaryPart then
			Core.S.Net.fx("sfx", { name = "plate", pos = e.model.PrimaryPart.Position })
		end
		e.model:Destroy()
	end
	return true
end

-- customers of a restaurant in a state (for waiters)
function Service.list(plot, state)
	local out = {}
	for _, c in pairs(Service.active) do
		if c.plot == plot and c.state == state then
			table.insert(out, c)
		end
	end
	return out
end

function Service.sendAllHome(plot)
	for _, c in pairs(Service.active) do
		if c.plot == plot then
			c.state = "leaving"
		end
	end
end

-- the owner left: the customers of that restaurant vanish right away
local function removeAll(plot)
	for _, c in pairs(Service.active) do
		if c.plot == plot then
			c.state = "leaving"
			pcall(release, c)
		end
	end
	plot.queue = {}
end

------------------------------------------------------------------ loop

-- one restaurant's arrivals: an interval from its popularity, the rush hours and the night
local function tick(plot, dt)
	serveQueue(plot)
	local Day = Core.S.Day
	plot.spawnTimer = (plot.spawnTimer or 0) + dt
	if plot.firstAt and os.clock() >= plot.firstAt then
		plot.firstAt = nil
		plot.spawnTimer = math.huge
	end
	local d = pdata(plot)
	local pop = Core.S.Progression.popularity(plot)
	local days = (d and d.stats.days) or 0
	local peakFactor = days < (GameConfig.Day.EarlyDays or 0) and GameConfig.Day.EarlyPeakFactor or GameConfig.Day.PeakFactor
	local interval = Formulas.customerInterval(CFG.BaseInterval, CFG.MinInterval, pop, Day.isPeak(), peakFactor, Core.S.Economy.boostActive(plot, "rush"))
	if Core.S.Seating.freeCount(plot) == 0 then
		interval = interval * 1.5
	end
	-- a busy kitchen: with many orders still waiting, fewer people walk in, so the restaurant does
	-- not fill with customers nobody can cook for (every cook on the staff takes more)
	local cooks = 0
	for _, s in ipairs(d and d.staff or {}) do
		local cfg = StaffCfg.byId[s.role]
		if cfg and table.find(cfg.tasks, "cook") then
			cooks += 1
		end
	end
	if #Core.S.Cooking.ticketsOf(plot) >= CFG.BusyTickets + CFG.BusyTicketsPerCook * cooks then
		interval = interval * CFG.BusyFactor
	end
	if Day.isNight() then
		interval = interval * GameConfig.Day.NightFactor
	end
	if plot.spawnTimer >= interval then
		plot.spawnTimer = 0
		local ok, err = pcall(Service.trySpawn, plot)
		if not ok then
			warn("[Customers] spawn failed: " .. tostring(err))
		end
	end
end

local function spawnLoop()
	while true do
		local dt = task.wait(0.5)
		for _, plot in ipairs(Core.S.Plots.list) do
			if plot.owner and pdata(plot) then
				tick(plot, dt)
			end
		end
	end
end

function Service.Start()
	local Plots = Core.S.Plots
	Plots.Claimed:Connect(function(plot)
		plot.queue = {}
		plot.spawnTimer = 0
		plot.firstAt = os.clock() + (CFG.FirstCustomerDelay or 2)
	end)
	Plots.Released:Connect(removeAll)
	task.spawn(spawnLoop)
end

return Service
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000075"><Properties><string name="Name">Data</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Player profiles: loading, session locking, autosave, migrations and replication to clients.
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local StarterLayout = require(Shared.Config.StarterLayout)
local Surfaces = require(Shared.Config.Surfaces)
local Recipes = require(Shared.Config.Recipes)
local Ingredients = require(Shared.Config.Ingredients)
local ShelfGrid = require(Shared.Logic.ShelfGrid)
local TableUtil = require(Shared.Util.TableUtil)
local Uid = require(Shared.Util.Uid)
local Signal = require(Shared.Util.Signal)
local Locale = require(Shared.Locale)
local Core = require(script.Parent.Parent.Core)

local Data = {}
Data.Loaded = Signal.new() -- (player, data)
Data.Changed = Signal.new() -- (player, key)

local VERSION = 11
local profiles = {} -- [player] = { data, loaded, saving, released }
local releasing = {} -- [userId] = true while the final save of a player who left is running
local activeSaves = 0
local store = nil
local storeOk = false

-- Keys of the owner's profile that describe the restaurant (sent to every player in the world)
Data.WorldKeys = {
	"level", "xp", "licenses", "menu", "mastery", "upgrades", "zones", "surfaces", "placed",
	"staff", "reviews", "dishes", "franchise", "boosts", "ads", "perms", "stats", "storage",
	"shelves", "appliances", "inventory", "yen", "sakura", "settings",
}
local WORLD_KEY_SET = {}
for _, k in ipairs(Data.WorldKeys) do
	WORLD_KEY_SET[k] = true
end

function Data.newProfile()
	local d = {
		v = VERSION,
		yen = GameConfig.StartYen,
		sakura = 0,
		xp = 0,
		level = 1,
		reviews = { recent = {}, total = 0, sum = 0 },
		stats = { dishes = 0, customers = 0, earned = 0, days = 0, five_stars = 0, washed = 0, decor = 0, gold_mastery = 0, lastDayEarned = 0, dayHistory = {} },
		licenses = { lic_base = true },
		menu = {},
		mastery = {},
		upgrades = {},
		zones = { zone_base = true },
		surfaces = {},
		placed = {},
		inventory = {},
		storage = {},
		shelves = {},
		appliances = {},
		dishes = { clean = GameConfig.StartDishes, total = GameConfig.StartDishes },
		staff = {},
		tipJar = 0,
		ads = {},
		boosts = {},
		meta = { quests = {}, questDay = 0, achievements = {}, daily = { streak = 0, last = 0 }, lastSeen = 0, tutorial = 0, tutorialGifts = {}, hints = {}, offlinePending = 0, codes = {}, onboarding = true, funnel = {} },
		franchise = { stars = 0, city = "tokyo" },
		perms = {},
		settings = { lang = "auto", grid = 1, rot = 90, music = 0.5, sfx = 0.8, lowGfx = false, cam = "auto", camSpeed = 1, coop = "friends" },
		passes = {},
		receipts = {},
		created = os.time(),
	}
	for _, r in ipairs(Recipes.list) do
		if r.license == "lic_base" then
			d.menu[r.id] = { on = true, price = 1 }
		end
	end
	local uids = {}
	for idx, s in ipairs(StarterLayout.items) do
		local e = { u = Uid.new("p"), i = s.i, x = s.x, z = s.z, r = s.r or 0, f = 0, s = s.s, t = 0 }
		if s.y then
			e.y = s.y
		end
		uids[idx] = e.u
		table.insert(d.placed, e)
	end
	local ItemsCfg = require(Shared.Config.Items)
	-- the first time the broth is already in the pot and the rice in the cooker
	for idx, s in ipairs(StarterLayout.items) do
		local fn = ItemsCfg.byId[s.i].fn
		if fn and fn.type == "pot" then
			d.appliances[uids[idx]] = { g = StarterLayout.broth or "broth_shoyu", n = fn.batch, c = 0, t = 0 }
		elseif fn and fn.type == "ricecooker" then
			d.appliances[uids[idx]] = { g = "rice", n = fn.batch, c = 0, t = 0 }
		end
	end
	for idx, s in ipairs(StarterLayout.items) do
		if s.p then
			d.placed[idx].p = uids[s.p]
			local parent = StarterLayout.items[s.p]
			d.placed[idx].y = ItemsCfg.byId[parent.i].size[2]
		end
	end
	-- the shelves start stocked (StarterLayout.stock): every listed slot full
	local shelfIndex = 0
	for idx, s in ipairs(StarterLayout.items) do
		local fn = ItemsCfg.byId[s.i].fn
		if fn and fn.type == "shelf" then
			shelfIndex += 1
			local list = StarterLayout.stock and StarterLayout.stock[shelfIndex]
			if list then
				local slots = {}
				for k, g in ipairs(list) do
					local ing = Ingredients.byId[g]
					if ing and k <= fn.slots then
						local cols, rows = ShelfGrid.forIngredient(ing.units, GameConfig.BoxShelfSlots, 1)
						slots[tostring(k)] = { g = g, n = cols * rows }
					end
				end
				d.shelves[uids[idx]] = slots
			end
		end
	end
	for _, b in ipairs(StarterLayout.boxes) do
		local ing = Ingredients.byId[b.g]
		for _ = 1, b.n do
			table.insert(d.storage, { u = Uid.new("b"), g = b.g, n = ing.units })
		end
	end
	d.surfaces.base_dining = { floor = Surfaces.DefaultFloor, wall = Surfaces.DefaultWall }
	return d
end

-- Puts every bought object in the inventory, rebuilds the starter layout and moves shelf stock
-- back into boxes (used when the starter layout changes size)
local function rebuildLayout(d)
	do
		d.inventory = d.inventory or {}
		d.storage = d.storage or {}
		local starter = {}
		for _, s in ipairs(StarterLayout.items) do
			starter[s.i] = (starter[s.i] or 0) + 1
		end
		for _, e in ipairs(d.placed or {}) do
			if (starter[e.i] or 0) > 0 then
				starter[e.i] -= 1
			else
				d.inventory[e.i] = (d.inventory[e.i] or 0) + 1
			end
		end
		for _, slots in pairs(d.shelves or {}) do
			for _, slot in pairs(slots) do
				if slot.g and (slot.n or 0) > 0 then
					table.insert(d.storage, { u = Uid.new("b"), g = slot.g, n = slot.n })
				end
			end
		end
		for _, b in ipairs(d.storage) do
			b.px, b.pz, b.pf, b.pr, b.h = nil, nil, nil, nil, nil
		end
		local fresh = Data.newProfile()
		d.placed = fresh.placed
		d.shelves = {}
		d.appliances = fresh.appliances
	end
end

local function migrate(d)
	d.v = d.v or 1
	if d.v < 2 then
		-- v2: the restaurant is twice as big
		rebuildLayout(d)
		d.v = 2
	end
	if d.v < 3 then
		-- v3: longer counter with twelve stools, bigger shelves, first-person camera by default
		rebuildLayout(d)
		d.settings = d.settings or {}
		if d.settings.cam == nil or d.settings.cam == "game" then
			d.settings.cam = "first"
		end
		d.v = 3
	end
	if d.v < 4 then
		-- v4: fitted kitchen unit (rice cooker, gas range, worktops, sink) and grid shelves
		rebuildLayout(d)
		d.v = 4
	end
	if d.v < 5 then
		-- v5: basic sushi moved from the starter license to lic_sushi0: players who already had it
		-- keep it
		d.licenses = d.licenses or {}
		if d.licenses.lic_base then
			d.licenses.lic_sushi0 = true
		end
		d.v = 5
	end
	if d.v < 6 then
		-- v6: shelves next to the storage door, tip jar on the counter, salmon sashimi license
		-- (whoever had basic sushi gets it too), broth and rice ready in the new kitchen
		rebuildLayout(d)
		if d.licenses and d.licenses.lic_sushi0 then
			d.licenses.lic_sashimi = true
		end
		d.v = 6
	end
	if d.v < 7 then
		-- v7: lower, deeper counter in 3-stud modules with a place setting each, stools 3 apart
		rebuildLayout(d)
		d.v = 7
	end
	if d.v < 8 then
		-- v8: shallower kitchen (14 studs) with everything on the back wall
		rebuildLayout(d)
		d.v = 8
	end
	if d.v < 9 then
		-- v9: the onboarding funnel only counts players who start after this version
		d.meta = d.meta or {}
		d.meta.onboarding = false
		d.v = 9
	end
	if d.v < 10 then
		-- v10: the restaurant is always open; the camera picks itself (third person on phones and
		-- tablets, first person with a keyboard)
		d.settings = d.settings or {}
		if d.settings.cam == nil or d.settings.cam == "first" then
			d.settings.cam = "auto"
		end
		d.settings.autoDay = nil
		-- the tutorial changed: whoever was halfway through starts the new, shorter one
		d.meta = d.meta or {}
		if (d.meta.tutorial or 0) > 0 then
			d.meta.tutorial = 1
		end
		d.v = 10
	end
	if d.v < 11 then
		-- v11: a new, two-minute tutorial with gifts; whoever was halfway through starts it again
		d.meta = d.meta or {}
		if (d.meta.tutorial or 0) > 0 then
			d.meta.tutorial = 1
		end
		d.v = 11
	end
	TableUtil.reconcile(d, Data.newProfile())
	d.v = VERSION
	return d
end

local function key(userId)
	return "u_" .. tostring(userId)
end

local function retry(fn, attempts)
	local lastErr
	for i = 1, attempts or 4 do
		local ok, a, b = pcall(fn)
		if ok then
			return true, a, b
		end
		lastErr = a
		task.wait(1.5 * i)
	end
	return false, lastErr
end

function Data.get(player)
	local p = profiles[player]
	return p and p.loaded and p.data or nil
end

function Data.isLoaded(player)
	local p = profiles[player]
	return p ~= nil and p.loaded == true
end

function Data.waitFor(player, timeout)
	local t0 = os.clock()
	while player.Parent and not Data.isLoaded(player) do
		if timeout and os.clock() - t0 > timeout then
			return nil
		end
		task.wait(0.1)
	end
	return Data.get(player)
end

local function payload(value)
	return TableUtil.deepCopy(value)
end

-- Notify clients that `k` changed in `player`'s profile: the player gets it as "me"; the helpers
-- working in their restaurant get the restaurant keys as "world".
function Data.changed(player, k)
	local d = Data.get(player)
	if not d then
		return
	end
	local Net = Core.S.Net
	Net.fire(player, "DataChanged", "me", k, payload(d[k]))
	local Plots = Core.S.Plots
	local plot = WORLD_KEY_SET[k] and Plots and Plots.ofPlayer(player)
	if plot then
		for _, other in ipairs(Plots.workers(plot)) do
			if other ~= player then
				Net.fire(other, "DataChanged", "world", k, payload(d[k]))
			end
		end
	end
	Data.Changed:Fire(player, k)
end

-- the restaurant keys of a plot's owner (what helpers see as "world")
function Data.worldOf(plot)
	local od = plot and plot.owner and Data.get(plot.owner)
	if not od then
		return nil
	end
	local world = {}
	for _, k in ipairs(Data.WorldKeys) do
		world[k] = TableUtil.deepCopy(od[k])
	end
	return world
end

function Data.snapshot(player)
	local d = Data.get(player)
	if not d then
		return nil
	end
	local me = TableUtil.deepCopy(d)
	me.receipts = nil
	local Plots = Core.S.Plots
	local plot = Plots and Plots.of(player)
	-- in your own restaurant "world" is your own data (the client uses "me")
	local world = (plot and plot.owner ~= player) and Data.worldOf(plot) or nil
	return { me = me, world = world, session = Plots and Plots.info(player) or nil }
end

-- Takes the session lock of a profile. Returns ok (the call worked), the saved data (nil for a new
-- player), and locked = true when another server still holds the profile (it is finishing the
-- player's last save there). force takes the lock anyway: a player can only be in one server, so a
-- lock that is not released in time belongs to a server that will never save this profile again.
local function acquire(userId, force)
	local locked = false
	local ok, result = pcall(function()
		return store:UpdateAsync(key(userId), function(old)
			locked = false
			old = old or {}
			local lock = old.lock
			if not force and lock and lock.job ~= game.JobId and os.time() - (lock.time or 0) < GameConfig.SessionLockSeconds then
				locked = true
				return nil
			end
			old.lock = { job = game.JobId, time = os.time() }
			return old
		end)
	end)
	if not ok then
		return false, nil, false, result
	end
	if locked then
		return true, nil, true
	end
	return true, result and result.data, false
end

local function releaseLock(userId)
	pcall(function()
		store:UpdateAsync(key(userId), function(old)
			if not old or not old.lock or old.lock.job ~= game.JobId then
				return nil
			end
			old.lock = nil
			return old
		end)
	end)
end

local function kick(player, msgKey)
	if player.Parent then
		player:Kick(Locale.tFor(player.LocaleId, msgKey))
	end
end

local function load(player)
	-- the same player may still be saving here from a moment ago (left and came back): wait for it
	local t0 = os.clock()
	while releasing[player.UserId] and os.clock() - t0 < 30 do
		task.wait(0.2)
	end
	local p = { data = nil, loaded = false }
	profiles[player] = p
	local data = nil
	if storeOk then
		local acquired, attempt, errors, told = false, 0, 0, false
		local started = os.clock()
		while player.Parent do
			attempt += 1
			local force = os.clock() - started >= GameConfig.LockWaitSeconds
			local ok, d, locked, err = acquire(player.UserId, force)
			if ok and not locked then
				data = d
				acquired = true
				break
			elseif ok then
				-- another server still holds the profile: it releases it as soon as its save is done
				if not told then
					told = true
					Core.S.Net.notify(player, "msg.loading_wait", nil, "info")
				end
				task.wait(5)
			else
				errors += 1
				warn("[Data] load attempt " .. errors .. " failed for " .. player.Name .. ": " .. tostring(err))
				if errors >= 5 then
					break
				end
				task.wait(2 * errors)
			end
		end
		if not acquired then
			-- never play on an empty profile: the real one could be overwritten later
			profiles[player] = nil
			kick(player, "msg.load_failed")
			return
		end
		if not player.Parent then
			profiles[player] = nil
			releaseLock(player.UserId)
			return
		end
	end
	if not player.Parent then
		profiles[player] = nil
		return
	end
	if type(data) == "table" then
		data = migrate(data)
	else
		data = Data.newProfile()
	end
	p.data = data
	p.loaded = true
	Data.Loaded:Fire(player, data)
end

-- Saves a profile. One save at a time per player: a save asked while another is running waits for
-- it and then saves again, so the last changes (and the lock release on leaving) are never skipped.
function Data.save(player, release)
	local p = profiles[player]
	if not p or not p.loaded or p.noSave or not storeOk then
		return false
	end
	local t0 = os.clock()
	while p.saving and os.clock() - t0 < 60 do
		task.wait(0.1)
	end
	if p.released then
		return true
	end
	p.saving = true
	activeSaves += 1
	p.data.meta.lastSeen = os.time()
	local snapshot = TableUtil.deepCopy(p.data)
	local lost = false
	local ok, err = retry(function()
		return store:UpdateAsync(key(player.UserId), function(old)
			lost = false
			old = old or {}
			if old.lock and old.lock.job ~= game.JobId then
				lost = true -- another server took the profile over: never write over its data
				return nil
			end
			old.data = snapshot
			old.lock = (not release) and { job = game.JobId, time = os.time() } or nil
			return old
		end)
	end, 3)
	activeSaves -= 1
	p.saving = false
	if not ok then
		warn("[Data] save failed for " .. player.Name .. ": " .. tostring(err))
	elseif lost then
		warn("[Data] save skipped for " .. player.Name .. ": the profile is open on another server")
	elseif release then
		p.released = true
	end
	return ok and not lost
end

function Data.storeAvailable()
	return storeOk
end

-- Saves immediately (used after Robux purchases).
function Data.saveNow(player)
	return Data.save(player, false)
end

function Data.reset(player)
	local p = profiles[player]
	if p and p.loaded then
		p.data = Data.newProfile()
		Data.Loaded:Fire(player, p.data)
	end
end

-- Final save of a player who leaves (or of everyone when the server closes)
local function releaseProfile(player)
	local p = profiles[player]
	if not p then
		return
	end
	releasing[player.UserId] = true
	Data.save(player, true)
	releasing[player.UserId] = nil
	if profiles[player] == p then
		profiles[player] = nil
	end
end

function Data.Init()
	local ok, s = pcall(function()
		return DataStoreService:GetDataStore(GameConfig.DataStoreName)
	end)
	if ok and s then
		store = s
		-- in Studio without API access every call errors: probe once
		local probeOk = pcall(function()
			s:GetAsync("probe")
		end)
		storeOk = probeOk
		if not probeOk then
			warn("[Data] DataStore not available (enable Studio Access to API Services to save in Studio). Playing without saving.")
		end
	end
	Core.S.Net.invoke("GetSnapshot", function(player)
		Data.waitFor(player, 30)
		return Data.snapshot(player)
	end, 1)
end

function Data.Start()
	-- a player who starts working in another restaurant gets its data
	Core.S.Plots.WorkChanged:Connect(function(player, plot)
		local world = (plot and plot.owner ~= player) and Data.worldOf(plot) or nil
		Core.S.Net.fire(player, "WorldSnapshot", world)
	end)
	Players.PlayerAdded:Connect(function(player)
		load(player)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(load, player)
	end
	Players.PlayerRemoving:Connect(releaseProfile)
	game:BindToClose(function()
		-- release every profile still open, then wait for every save in flight (including the
		-- ones started by players leaving at the same moment)
		for player in pairs(profiles) do
			task.spawn(releaseProfile, player)
		end
		local t0 = os.clock()
		while os.clock() - t0 < 25 do
			local busy = activeSaves > 0 or next(releasing) ~= nil
			for _, p in pairs(profiles) do
				if p.loaded and not p.released and not p.noSave and storeOk then
					busy = true
				end
			end
			if not busy then
				break
			end
			task.wait(0.2)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(GameConfig.AutosaveSeconds)
			for player, p in pairs(profiles) do
				if p.loaded and not p.saving and not p.released then
					task.spawn(Data.save, player, false)
				end
			end
		end
	end)
end

local _ = { RunService, HttpService }
return Data
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000076"><Properties><string name="Name">Day</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Time of day, the same for the whole street. The restaurants are always open: the clock turns
-- continuously for the light (day, sunset, lantern-lit evening, a quick night) and the lunch and
-- dinner rush. Every day at Day.DayStartHour each restaurant closes its accounts: salaries, stats,
-- daily quests and a short summary for its owner (never a screen that stops the game).
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Staff = require(Shared.Config.Staff)
local Core = require(script.Parent.Parent.Core)

local Day = {}
local DAY = GameConfig.Day
Day.phase = "open" -- kept for older checks: the restaurant never closes
Day.clock = DAY.StartClock
local hours = DAY.StartClock -- game hours since the server started (never wraps)

function Day.isPeak()
	for _, p in ipairs(DAY.Peaks) do
		if Day.clock >= p[1] and Day.clock < p[2] then
			return true
		end
	end
	return false
end

function Day.isNight()
	return Day.clock >= DAY.NightFrom or Day.clock < DAY.NightTo
end

-- what a player sees: the clock, their own day number and the last summary of their restaurant
local function payload(player)
	local d = Core.S.Data.get(player)
	local plot = Core.S.Plots.ofPlayer(player)
	return {
		phase = Day.phase,
		clock = Day.clock,
		day = d and (d.stats.days or 0) + 1 or 1,
		night = Day.isNight(),
		report = plot and plot.report or nil,
	}
end

function Day.broadcast()
	for _, p in ipairs(Players:GetPlayers()) do
		Core.S.Net.fire(p, "DayState", payload(p))
	end
	workspace:SetAttribute("DayPhase", Day.phase)
end

-- closes the day's accounts of one restaurant
local function finishPlot(plot)
	local d = Core.S.Plots.data(plot)
	local owner = plot.owner
	if not d or not owner then
		return
	end
	-- tips left in the jar go to the wallet before the summary
	pcall(Core.S.Economy.collectTips, owner, plot)
	local L = Core.S.Economy.ledgerOf(plot)
	local salaries = 0
	for _, s in ipairs(d.staff) do
		local cfg = Staff.byId[s.role]
		if cfg then
			salaries += cfg.salary
		end
	end
	local paid = Core.S.Economy.charge(owner, salaries, "salary")
	local best, bestN = nil, 0
	for id, n in pairs(L.bestDish) do
		if n > bestN then
			best, bestN = id, n
		end
	end
	local income = L.sales + L.tips
	local costs = L.supplies + paid + L.build + L.other
	plot.report = {
		day = (d.stats.days or 0) + 1,
		sales = L.sales, tips = L.tips, supplies = L.supplies, salaries = paid, build = L.build, other = L.other,
		profit = income - costs, customers = L.customers, served = L.served, walkouts = L.walkouts,
		rating = L.reviews > 0 and (L.stars / L.reviews) or 0, best = best, bestCount = bestN,
	}
	d.stats.days = (d.stats.days or 0) + 1
	d.stats.lastDayEarned = income
	table.insert(d.stats.dayHistory, income)
	while #d.stats.dayHistory > 10 do
		table.remove(d.stats.dayHistory, 1)
	end
	Core.S.Data.changed(owner, "stats")
	Core.S.Meta.event(owner, "days", 1)
	Core.S.Meta.dayEnded(owner)
	Core.S.Economy.resetLedger(plot)
	Core.S.Net.notify(owner, "msg.day_summary", { day = plot.report.day, yen = income, served = L.served }, "success")
	task.spawn(Core.S.Data.save, owner, false)
end

-- a new day for the whole street
local function finish()
	for _, plot in ipairs(Core.S.Plots.list) do
		local ok, err = pcall(finishPlot, plot)
		if not ok then
			warn("[Day] closing the day failed: " .. tostring(err))
		end
	end
	Day.broadcast()
end

Day.finish = finish
Day.finishPlot = finishPlot

-- compatibility: the restaurant does not open or close any more
function Day.open() end
function Day.closeEarly() end
function Day.next() end

function Day.Init()
	Lighting.ClockTime = Day.clock
	Lighting.GeographicLatitude = 35
end

function Day.Start()
	Players.PlayerAdded:Connect(function(p)
		task.wait(2)
		Core.S.Net.fire(p, "DayState", payload(p))
	end)
	Core.S.Plots.Claimed:Connect(function(plot)
		plot.report = nil
		Day.broadcast()
	end)
	local last = os.clock()
	local lastBroadcast = 0
	local dayIndex = math.floor((hours - DAY.DayStartHour) / 24)
	while true do
		task.wait(0.25)
		local now = os.clock()
		local dt = now - last
		last = now
		local perHour = Day.isNight() and DAY.NightSecondsPerHour or DAY.SecondsPerHour
		hours += dt / perHour
		Day.clock = hours % 24
		Lighting.ClockTime = Day.clock
		local idx = math.floor((hours - DAY.DayStartHour) / 24)
		if idx > dayIndex then
			dayIndex = idx
			finish()
		end
		if now - lastBroadcast > 5 then
			lastBroadcast = now
			Day.broadcast()
		end
	end
end

return Day
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000077"><Properties><string name="Name">Dev</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Developer tools: available in Studio or to the experience creator.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Licenses = require(Shared.Config.Licenses)
local Expansions = require(Shared.Config.Expansions)
local Ingredients = require(Shared.Config.Ingredients)
local Formulas = require(Shared.Logic.Formulas)
local Uid = require(Shared.Util.Uid)
local Core = require(script.Parent.Parent.Core)

local Dev = {}

local function allowed(player)
	if RunService:IsStudio() then
		return true
	end
	return game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId
end

local function run(player, cmd, arg)
	local S = Core.S
	local plot = S.Plots.ofPlayer(player)
	local d = S.Plots.data(plot)
	if not d then
		return
	end
	local owner = player
	if cmd == "yen" then
		S.Economy.add(owner, tonumber(arg) or 10000, "dev", { raw = true })
	elseif cmd == "sakura" then
		S.Economy.addSakura(owner, tonumber(arg) or 50)
	elseif cmd == "level" then
		local target = math.clamp(math.floor(tonumber(arg) or (d.level + 1)), 1, Formulas.MaxLevel)
		d.level = target
		d.xp = 0
		S.Data.changed(owner, "level")
		S.Data.changed(owner, "xp")
	elseif cmd == "licenses" then
		for _, l in ipairs(Licenses.list) do
			d.licenses[l.id] = true
			for _, r in ipairs(l.recipes) do
				d.menu[r] = d.menu[r] or { on = true, price = 1 }
			end
		end
		S.Data.changed(owner, "licenses")
		S.Data.changed(owner, "menu")
	elseif cmd == "zones" then
		for _, e in ipairs(Expansions.list) do
			d.zones[e.id] = true
		end
		S.Plots.rebuild(plot)
	elseif cmd == "renos" or cmd == "plain" then
		-- all renovations on (detailed look) or off (plain starting look)
		for _, e in ipairs(Expansions.list) do
			if e.reno then
				d.zones[e.id] = cmd == "renos" or nil
			end
		end
		S.Data.changed(owner, "zones")
		S.Plots.rebuild(plot)
	elseif cmd == "spawn" then
		task.spawn(S.Customers.trySpawn, plot, type(arg) == "string" and arg or nil)
	elseif cmd == "time" then
		S.Day.finish()
	elseif cmd == "stock" then
		for _, ing in ipairs(Ingredients.list) do
			if d.licenses[ing.license] then
				for _ = 1, 2 do
					table.insert(d.storage, { u = Uid.new("b"), g = ing.id, n = ing.units })
				end
			end
		end
		S.Supply.layout(plot)
	elseif cmd == "rating" then
		for _ = 1, 20 do
			S.Progression.addReview(plot, 5, 1)
		end
	elseif cmd == "selftest" then
		task.spawn(S.SelfTest.run, player)
		return
	elseif cmd == "reset" and RunService:IsStudio() then
		S.Data.reset(owner)
		S.Plots.rebuild(plot)
		for _, k in ipairs(S.Data.WorldKeys) do
			S.Data.changed(owner, k)
		end
		S.Data.changed(owner, "meta")
	end
	S.Net.notify(player, "msg.dev_done", { cmd = cmd }, "info")
end

function Dev.Init()
	Core.S.Net.on("Dev", function(player, cmd, arg)
		if allowed(player) and type(cmd) == "string" then
			run(player, cmd, arg)
		end
	end, 5)
end

function Dev.Start()
	local function mark(p)
		if allowed(p) then
			p:SetAttribute("Dev", true)
		end
	end
	Players.PlayerAdded:Connect(mark)
	for _, p in ipairs(Players:GetPlayers()) do
		mark(p)
	end
end

return Dev
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000078"><Properties><string name="Name">Economy</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Yen and sakura tokens, income multipliers, boosts and the per-day ledger.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Franchise = require(Shared.Config.Franchise)
local Formulas = require(Shared.Logic.Formulas)
local GameConfig = require(Shared.Config.GameConfig)
local Core = require(script.Parent.Parent.Core)

local Economy = {}

local INCOME = { sale = true, tip = true, offline = true }

local function newLedger()
	return { sales = 0, tips = 0, supplies = 0, salaries = 0, build = 0, other = 0, customers = 0, served = 0, walkouts = 0, stars = 0, reviews = 0, bestDish = {} }
end

-- the day's accounts of a restaurant
function Economy.ledgerOf(plot)
	if not plot then
		return newLedger()
	end
	plot.ledger = plot.ledger or newLedger()
	return plot.ledger
end

function Economy.resetLedger(plot)
	if plot then
		plot.ledger = newLedger()
	end
end

function Economy.boostActive(plot, name)
	local data = Core.S.Plots.data(plot)
	return data and data.boosts and (data.boosts[name] or 0) > os.time() or false
end

-- income multiplier of a restaurant owner (franchise stars and passes)
function Economy.multiplier(player)
	local data = Core.S.Data.get(player)
	if not data then
		return 1
	end
	local passMult = 1
	local Monetization = Core.S.Monetization
	if Monetization then
		passMult = Monetization.yenMultiplier(player)
	end
	return Formulas.incomeMultiplier({ franchiseStars = data.franchise.stars or 0, yenPerStar = Franchise.YenPerStar, passMult = passMult })
end

-- Adds yen to `player`'s profile. opts.raw skips multipliers.
function Economy.add(player, amount, reason, opts)
	local Data = Core.S.Data
	local data = Data.get(player)
	if not data or not amount or amount <= 0 then
		return 0
	end
	local value = amount
	local own = Core.S.Plots.ofPlayer(player)
	if INCOME[reason] and not (opts and opts.raw) and own then
		value = math.floor(amount * Economy.multiplier(player) + 0.5)
		if reason == "tip" and Economy.boostActive(own, "golden") then
			value = math.floor(value * 1.5 + 0.5)
		end
	end
	data.yen += value
	if INCOME[reason] then
		data.stats.earned += value
	end
	if own then
		local L = Economy.ledgerOf(own)
		if reason == "sale" then
			L.sales += value
		elseif reason == "tip" then
			L.tips += value
		end
	end
	Data.changed(player, "yen")
	if Core.S.Analytics then
		Core.S.Analytics.source(player, value, reason, data.yen)
	end
	if INCOME[reason] then
		Data.changed(player, "stats")
		Core.S.Meta.event(player, "earn", value)
		if reason == "tip" then
			Core.S.Meta.event(player, "tips", value)
		end
	end
	return value
end

function Economy.canAfford(player, amount)
	local data = Core.S.Data.get(player)
	return data ~= nil and data.yen >= amount
end

-- sku names what is bought, for the analytics (e.g. "upgrade:up_tray")
function Economy.spend(player, amount, reason, sku)
	local Data = Core.S.Data
	local data = Data.get(player)
	if not data or amount < 0 or data.yen < amount then
		return false
	end
	data.yen -= amount
	if Core.S.Analytics and amount > 0 then
		Core.S.Analytics.sink(player, amount, reason, data.yen, sku)
	end
	local own = Core.S.Plots.ofPlayer(player)
	if own then
		local L = Economy.ledgerOf(own)
		if reason == "supplies" then
			L.supplies += amount
		elseif reason == "salary" then
			L.salaries += amount
		elseif reason == "build" then
			L.build += amount
		else
			L.other += amount
		end
	end
	Data.changed(player, "yen")
	return true
end

-- Salaries may push the balance below zero only down to 0
function Economy.charge(player, amount, reason)
	local data = Core.S.Data.get(player)
	if not data then
		return 0
	end
	local paid = math.min(amount, data.yen)
	if paid > 0 then
		Economy.spend(player, paid, reason)
	end
	return paid
end

------------------------------------------------------------------ tip jar

local function jars(plot)
	return Core.S.Entities.ofKind("tipjar", plot)
end

-- shows the coins of every jar of a restaurant (height grows with the amount, full at TipJarFull)
local function drawJars(plot, amount)
	for _, e in ipairs(jars(plot)) do
		local coins = e.model and e.model:FindFirstChild("Coins")
		if coins then
			local base = coins:GetAttribute("Base") or 0.09
			local h = 0.05 + 0.9 * math.clamp(amount / (GameConfig.TipJarFull or 600), 0, 1)
			local root = e.model.PrimaryPart
			coins.Size = Vector3.new(h, coins.Size.Y, coins.Size.Z)
			if root then
				coins.CFrame = root.CFrame * CFrame.new(0, base + h / 2 - 0.025 - root.Size.Y / 2, 0) * CFrame.Angles(0, 0, math.rad(90))
			end
			e.model:SetAttribute("Tips", amount)
		end
	end
end

-- a tip goes into the restaurant's jar when it has one; returns true if it did
function Economy.tipToJar(plot, amount)
	local d = Core.S.Plots.data(plot)
	if not d or amount <= 0 or #jars(plot) == 0 then
		return false
	end
	d.tipJar = (d.tipJar or 0) + amount
	drawJars(plot, d.tipJar)
	Core.S.Data.changed(plot.owner, "tipJar")
	return true
end

-- empties a restaurant's jar into its owner's wallet (click on the jar, or at the end of the day)
function Economy.collectTips(player, plot)
	plot = plot or Core.S.Plots.of(player)
	local d = Core.S.Plots.data(plot)
	local owner = plot and plot.owner
	if not d or not owner or (d.tipJar or 0) <= 0 then
		return false, "msg.tipjar_empty"
	end
	local amount = d.tipJar
	d.tipJar = 0
	drawJars(plot, 0)
	local got = Economy.add(owner, amount, "tip")
	local pos = nil
	local jar = jars(plot)[1]
	if jar and jar.model and jar.model.PrimaryPart then
		pos = jar.model.PrimaryPart.Position
	end
	Core.S.Net.fx("coins", { amount = got, pos = pos })
	Core.S.Net.fx("sfx", { name = "coin", pos = pos })
	local _ = player
	return true
end

function Economy.redrawJars(plot)
	local d = Core.S.Plots.data(plot)
	drawJars(plot, d and d.tipJar or 0)
end

function Economy.addSakura(player, n)
	local data = Core.S.Data.get(player)
	if not data or n <= 0 then
		return
	end
	data.sakura += n
	Core.S.Data.changed(player, "sakura")
	if Core.S.Analytics then
		Core.S.Analytics.sakura(player, n, data.sakura, false)
	end
end

function Economy.spendSakura(player, n, sku)
	local data = Core.S.Data.get(player)
	if not data or data.sakura < n then
		return false
	end
	data.sakura -= n
	Core.S.Data.changed(player, "sakura")
	if Core.S.Analytics and n > 0 then
		Core.S.Analytics.sakura(player, n, data.sakura, true, sku)
	end
	return true
end

function Economy.Init() end

function Economy.Start()
	-- a jar placed (or rebuilt after a move) shows the tips it holds
	Core.S.Placement.ItemAdded:Connect(function(e)
		if e.kind == "tipjar" then
			task.defer(Economy.redrawJars, e.plot)
		end
	end)
	Core.S.Plots.Claimed:Connect(function(plot)
		plot.ledger = nil
		task.defer(Economy.redrawJars, plot)
	end)
end

return Economy
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000079"><Properties><string name="Name">Entities</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Registry of interactable things in the world (placed items, boxes, customers, fixed props).
-- Every entity belongs to a restaurant: e.plot (also published as the PlotId attribute).
local CollectionService = game:GetService("CollectionService")

local Entities = {}
local byUid = {}

function Entities.register(uid, kind, model, data)
	local e = { uid = uid, kind = kind, model = model }
	if data then
		for k, v in pairs(data) do
			e[k] = v
		end
	end
	byUid[uid] = e
	if model then
		model:SetAttribute("Uid", uid)
		model:SetAttribute("Kind", kind)
		model:SetAttribute("PlotId", e.plot and e.plot.id or 0)
		CollectionService:AddTag(model, "Interactable")
	end
	return e
end

function Entities.unregister(uid)
	local e = byUid[uid]
	byUid[uid] = nil
	return e
end

function Entities.get(uid)
	return byUid[uid]
end

-- every entity of a kind; with a plot, only the ones of that restaurant
function Entities.ofKind(kind, plot)
	local out = {}
	for _, e in pairs(byUid) do
		if e.kind == kind and (plot == nil or e.plot == plot) then
			table.insert(out, e)
		end
	end
	return out
end

-- every entity of a restaurant
function Entities.ofPlot(plot)
	local out = {}
	for _, e in pairs(byUid) do
		if e.plot == plot then
			table.insert(out, e)
		end
	end
	return out
end

function Entities.all()
	return byUid
end

function Entities.position(e)
	if e.model and e.model.PrimaryPart then
		return e.model.PrimaryPart.Position
	elseif e.model then
		return e.model:GetPivot().Position
	end
	return nil
end

return Entities
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000080"><Properties><string name="Name">Franchise</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Franchise (prestige): open a restaurant in the next city with permanent bonuses.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Franchise = require(Shared.Config.Franchise)
local Core = require(script.Parent.Parent.Core)

local Service = {}

function Service.check(d, plot)
	local step = Franchise.nextStep(d.franchise.stars or 0)
	if not step then
		return false, "msg.franchise_done"
	end
	if d.level < step.level then
		return false, "msg.need_level", { level = step.level }
	end
	if Core.S.Progression.rating(plot) < step.rating then
		return false, "msg.need_rating", { rating = step.rating }
	end
	for _, z in ipairs(step.zones) do
		if not d.zones[z] then
			return false, "msg.need_zone", { name = "zone." .. z }
		end
	end
	local nextCity = nil
	for _, c in ipairs(Franchise.list) do
		if c.star == (d.franchise.stars or 0) + 1 then
			nextCity = c
		end
	end
	if not nextCity then
		return false, "msg.franchise_done"
	end
	return true, nil, nil, nextCity
end

local KEEP = { sakura = true, mastery = true, stats = true, meta = true, settings = true, passes = true, receipts = true, created = true, inventory = true, perms = true }

local function open(player)
	local Plots, Net = Core.S.Plots, Core.S.Net
	local plot = Plots.ofPlayer(player)
	local d = Plots.data(plot)
	if not plot or not d then
		return
	end
	local ok, reason, params, city = Service.check(d, plot)
	if not ok then
		return Net.notify(player, reason, params, "error")
	end
	-- every placed object goes to the inventory
	for _, e in ipairs(d.placed) do
		d.inventory[e.i] = (d.inventory[e.i] or 0) + 1
	end
	local fresh = Core.S.Data.newProfile()
	for k, v in pairs(fresh) do
		if not KEEP[k] then
			d[k] = v
		end
	end
	d.yen = Franchise.StartYen
	d.franchise = { stars = city.star, city = city.id, cities = {} }
	for _, c in ipairs(Franchise.list) do
		if c.star <= city.star then
			d.franchise.cities[c.id] = true
		end
	end
	-- the starter layout is already placed: remove those copies from the inventory
	for _, e in ipairs(d.placed) do
		if d.inventory[e.i] and d.inventory[e.i] > 0 then
			d.inventory[e.i] -= 1
			if d.inventory[e.i] == 0 then
				d.inventory[e.i] = nil
			end
		end
	end
	Net.fx("construction", { zone = "franchise", plotX = plot.origin.X })
	Net.notifyAll("msg.franchise_opened", { city = "city." .. city.id }, "level")
	-- the restaurant starts again in the new city: same plot, rebuilt from scratch
	Plots.rebuild(plot)
	for _, k in ipairs(Core.S.Data.WorldKeys) do
		Core.S.Data.changed(player, k)
	end
	Core.S.Data.changed(player, "meta")
	Core.S.Meta.event(player, "franchise", 1)
end

function Service.Init()
	Core.S.Net.on("Franchise", function(player)
		open(player)
	end, 1)
end

return Service
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000081"><Properties><string name="Name">Hands</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- What every actor (player or staff NPC) is carrying, with visuals welded in front of the body.
-- Everything in hand belongs to one restaurant (s.plot): boxes go back to its storage, plates to
-- its sink, and a dish can only be served to a customer of that restaurant.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Upgrades = require(Shared.Config.Upgrades)
local Registry = require(Shared.Models.Registry)
local Core = require(script.Parent.Parent.Core)

local Hands = {}
local state = {} -- [actorKey] = { kind, items = {}, visuals = {} }

local HOLD_ANIM = "rbxassetid://507768375"

local function key(actor)
	return actor
end

function Hands.get(actor)
	local s = state[key(actor)]
	if not s then
		s = { kind = nil, items = {}, visuals = {} }
		state[key(actor)] = s
	end
	return s
end

function Hands.isEmpty(actor)
	return #Hands.get(actor).items == 0
end

function Hands.count(actor)
	return #Hands.get(actor).items
end

local function character(actor)
	if typeof(actor) == "Instance" and actor:IsA("Player") then
		return actor.Character
	elseif type(actor) == "table" then
		return actor.model
	end
	return nil
end

-- Capacity for a kind of item
function Hands.capacity(actor, kind)
	-- upgrades and passes of the restaurant the actor works in
	local plot = Hands.get(actor).plot or Core.S.Plots.of(actor)
	local od = Core.S.Plots.data(plot)
	local owner = plot and plot.owner
	local Monetization = Core.S.Monetization
	if kind == "box" then
		-- the cart upgrade (and the big cart pass) lets players carry more boxes at once
		if typeof(actor) == "Instance" and actor:IsA("Player") then
			local n = od and Upgrades.value(od.upgrades, "up_cart") or 1
			if Monetization and owner and Monetization.has(owner, "gp_express") then
				n += 1
			end
			return n
		end
		return 1
	elseif kind == "ing" then
		return GameConfig.IngredientHandCapacity
	end
	local tray = od and Upgrades.value(od.upgrades, "up_tray") or 1
	if typeof(actor) == "Instance" and actor:IsA("Player") then
		if Monetization and owner and Monetization.has(owner, "gp_big_tray") then
			tray += 2
		end
	elseif type(actor) == "table" then
		tray = math.max(2, tray)
	end
	return tray
end

local function holdAnim(actor, on)
	local char = character(actor)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local animator = hum and (hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum))
	if not animator then
		return
	end
	local s = Hands.get(actor)
	if on and not s.track then
		local anim = Instance.new("Animation")
		anim.AnimationId = HOLD_ANIM
		local ok, track = pcall(function()
			return animator:LoadAnimation(anim)
		end)
		if ok and track then
			track.Priority = Enum.AnimationPriority.Action
			track.Looped = true
			track:Play(0.2)
			s.track = track
		end
	elseif not on and s.track then
		s.track:Stop(0.2)
		s.track = nil
	end
end

local function buildVisual(kind, item)
	if kind == "box" then
		-- carried boxes are open with some of the products showing
		return Registry.food("box", item.g, item.n, Core.S.Supply.boxCap(item), true)
	elseif kind == "ing" then
		return Registry.food("ingredient", item.g)
	elseif kind == "dish" then
		return Registry.food("dish", item.recipe)
	elseif kind == "dirty" then
		return Registry.food("dirty", item.dish)
	end
	return nil
end

local function refreshVisual(actor)
	local s = Hands.get(actor)
	for _, v in ipairs(s.visuals) do
		v:Destroy()
	end
	s.visuals = {}
	local char = character(actor)
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end
	local y = 0.1
	for i, item in ipairs(s.items) do
		local m = buildVisual(s.kind, item)
		if m then
			local h = m.PrimaryPart and m.PrimaryPart.Size.Y or 0.5
			local offset
			if s.kind == "ing" then
				offset = CFrame.new(((i - 1) % 3 - 1) * 0.55, 0.2 + math.floor((i - 1) / 3) * 0.5, -1.5)
			else
				offset = CFrame.new(0, y + h / 2, -1.5)
				y += h * 0.85
			end
			m:PivotTo(hrp.CFrame * offset)
			for _, d in ipairs(m:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Anchored = false
					d.CanCollide = false
					d.CanQuery = false
					d.CanTouch = false
					d.Massless = true
					local w = Instance.new("WeldConstraint")
					w.Part0 = hrp
					w.Part1 = d
					w.Parent = d
				end
			end
			-- the client shows held items in front of the camera in first person
			m:SetAttribute("Held", true)
			m.Parent = char
			table.insert(s.visuals, m)
		end
	end
	holdAnim(actor, #s.items > 0)
end

local function publish(actor)
	if typeof(actor) == "Instance" and actor:IsA("Player") then
		local s = Hands.get(actor)
		local list = {}
		for _, it in ipairs(s.items) do
			table.insert(list, it.g or it.recipe or it.dish or "?")
		end
		actor:SetAttribute("HandsKind", s.kind or "")
		actor:SetAttribute("Hands", HttpService:JSONEncode(list))
	end
end

-- plot = the restaurant the items belong to (defaults to the one the actor works in)
function Hands.set(actor, kind, items, plot)
	local s = Hands.get(actor)
	s.kind = (#items > 0) and kind or nil
	s.items = items
	if #items > 0 then
		s.plot = plot or s.plot or Core.S.Plots.of(actor)
	else
		s.plot = nil
	end
	refreshVisual(actor)
	publish(actor)
end

-- Adds an item; returns false when the hands hold something else or are full.
function Hands.add(actor, kind, item, plot)
	local s = Hands.get(actor)
	if s.kind and s.kind ~= kind then
		return false, "msg.hands_busy"
	end
	if s.kind and plot and s.plot and s.plot ~= plot then
		return false, "msg.other_restaurant"
	end
	if #s.items >= Hands.capacity(actor, kind) then
		return false, "msg.hands_full"
	end
	local items = table.clone(s.items)
	table.insert(items, item)
	Hands.set(actor, kind, items, plot)
	return true
end

function Hands.clear(actor)
	Hands.set(actor, nil, {})
end

function Hands.removeAt(actor, index)
	local s = Hands.get(actor)
	local items = table.clone(s.items)
	local it = table.remove(items, index)
	Hands.set(actor, s.kind, items, s.plot)
	return it
end

function Hands.refresh(actor)
	refreshVisual(actor)
	publish(actor)
end

-- dishes of a restaurant held by anyone, by recipe (a dish in hand is on its way to a customer)
function Hands.dishCounts(plot)
	local out = {}
	for _, s in pairs(state) do
		if s.kind == "dish" and (plot == nil or s.plot == plot) then
			for _, it in ipairs(s.items) do
				if it.recipe then
					out[it.recipe] = (out[it.recipe] or 0) + 1
				end
			end
		end
	end
	return out
end

function Hands.forget(actor)
	local s = state[key(actor)]
	if s then
		for _, v in ipairs(s.visuals) do
			v:Destroy()
		end
	end
	state[key(actor)] = nil
end

function Hands.Start()
	Players.PlayerRemoving:Connect(function(player)
		-- boxes in hand go back to storage
		local s = state[player]
		if s and s.kind == "box" and s.plot then
			local Supply = Core.S.Supply
			for _, b in ipairs(s.items) do
				Supply.returnBox(s.plot, b)
			end
		end
		Hands.forget(player)
	end)
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			task.wait(0.5)
			-- respawn: drop everything (boxes return to storage)
			local s = state[player]
			if s and s.kind == "box" and s.plot then
				for _, b in ipairs(s.items) do
					Core.S.Supply.returnBox(s.plot, b)
				end
			end
			Hands.forget(player)
			publish(player)
		end)
	end)
	-- Putting things down always says where they went: boxes stay on the floor in front of you
	-- (or go on the rack when you are next to it), ingredients go back on a shelf, plates go to
	-- the sink.
	Core.S.Net.on("DropHands", function(player)
		local s = Hands.get(player)
		local Net = Core.S.Net
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local pos = root and root.Position or Vector3.new()
		local look = root and root.CFrame.LookVector or Vector3.new(0, 0, -1)
		local floor = Core.S.World.floorOf(pos.Y)
		local plot = s.plot
		if s.kind and not plot then
			Hands.clear(player)
			return
		end
		if s.kind == "box" then
			local where = "floor"
			-- a box carried into another restaurant goes back to its own storage
			local home = Core.S.Plots.at(pos) == plot
			for _, b in ipairs(s.items) do
				if home then
					where = Core.S.Supply.dropBox(plot, b, pos, Vector3.new(look.X, 0, look.Z).Unit, floor)
				else
					Core.S.Supply.returnBox(plot, b)
					where = "rack"
				end
			end
			Hands.clear(player)
			Net.notify(player, where == "rack" and "msg.box_on_rack" or "msg.box_on_floor", nil, "info")
			return
		elseif s.kind == "ing" then
			local back, lost = 0, 0
			for _, it in ipairs(s.items) do
				if Core.S.Supply.returnIngredient(plot, it.g, pos) then
					back += 1
				else
					lost += 1
				end
			end
			Hands.clear(player)
			if lost > 0 then
				Net.notify(player, "msg.ing_discarded", { n = lost }, "error")
			else
				Net.notify(player, "msg.ing_returned", { n = back }, "info")
			end
			return
		elseif s.kind == "dish" or s.kind == "dirty" then
			-- plates are never lost: they go to the sink as dirty dishes
			Core.S.Appliance.addDirtyToSink(plot, #s.items)
			Hands.clear(player)
			Net.notify(player, "msg.dish_to_sink", nil, "info")
			return
		end
		Hands.clear(player)
		Net.notify(player, "msg.hands_dropped")
	end, 3)
end

return Hands
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000082"><Properties><string name="Name">Interaction</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Receives clicks/taps from players, checks distance and permissions, dispatches to services.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Core = require(script.Parent.Parent.Core)

local Interaction = {}

local busy = {} -- [player] = true while an action runs (steps/washing yield)

local function targetPosition(e, slot)
	if slot and e.model then
		local part = e.model:FindFirstChild("Slot" .. slot)
		if part then
			return part.Position
		end
	end
	local pos = Core.S.Entities.position(e)
	return pos
end

local function sizeMargin(e)
	if e.item then
		return math.max(e.item.size[1], e.item.size[3]) / 2
	end
	return 1.5
end

-- Dispatch shared by players (and reused by tutorial / dev tools)
function Interaction.perform(actor, e, extra)
	local S = Core.S
	local kind = e.kind
	if kind == "box" then
		return S.Supply.takeBox(actor, e)
	elseif kind == "rack" then
		local hands = S.Hands.get(actor)
		if hands.kind == "box" then
			local items = hands.items
			S.Hands.clear(actor)
			for _, entry in ipairs(items) do
				S.Supply.returnBox(e.plot, entry)
			end
			return true
		end
		return false, "msg.rack_hint"
	elseif kind == "shelf" then
		local slot = type(extra) == "table" and tonumber(extra.slot) or nil
		return S.Supply.useShelf(actor, e, slot)
	elseif kind == "ricecooker" or kind == "pot" then
		return S.Appliance.load(actor, e)
	elseif kind == "sink" then
		return S.Appliance.useSink(actor, e, 1)
	elseif kind == "dishwasher" then
		return S.Appliance.useDishwasher(actor, e)
	elseif kind == "station" then
		return S.Cooking.use(actor, e, 1)
	elseif kind == "customer" then
		return S.Customers.use(actor, e)
	elseif kind == "dirty" then
		return S.Customers.collectDirty(actor, e)
	elseif kind == "tipjar" then
		return S.Economy.collectTips(actor, e.plot)
	end
	return false, nil
end

local ACTION_FOR_KIND = {
	box = "take_box", shelf = "shelf", ricecooker = "rice", pot = "broth", sink = "sink_drop",
	dishwasher = "wash", station = "station", customer = "customer", dirty = "collect", rack = "rack",
}

function Interaction.Init()
	Core.S.Net.on("Interact", function(player, uid, extra)
		local S = Core.S
		if type(uid) ~= "string" or #uid > 40 then
			return
		end
		if busy[player] then
			return
		end
		local e = S.Entities.get(uid)
		if not e then
			return
		end
		-- only in a restaurant where the player may work (their own, or one they help in)
		if not e.plot or not e.plot.owner or not S.Plots.canWork(player, e.plot) then
			return S.Net.notify(player, "msg.not_your_restaurant", nil, "info")
		end
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not hrp then
			return
		end
		local slot = type(extra) == "table" and tonumber(extra.slot) or nil
		local pos = targetPosition(e, slot)
		if not pos then
			return
		end
		local dist = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(hrp.Position.X, 0, hrp.Position.Z)).Magnitude
		if dist > GameConfig.InteractRange + sizeMargin(e) or math.abs(pos.Y - hrp.Position.Y) > 12 then
			return S.Net.notify(player, "msg.too_far", nil, "info")
		end
		busy[player] = true
		local ok, result, reason, params = pcall(Interaction.perform, player, e, extra)
		busy[player] = nil
		if not ok then
			warn("[Interaction] " .. tostring(result))
			return
		end
		if result then
			S.Net.fxTo(player, "action", { kind = ACTION_FOR_KIND[e.kind] or e.kind, hands = S.Hands.get(player).kind })
		elseif reason then
			S.Net.notify(player, reason, params, "info")
		end
	end, 12)
	game:GetService("Players").PlayerRemoving:Connect(function(p)
		busy[p] = nil
	end)
end

return Interaction
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000083"><Properties><string name="Name">Leaderboard</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Global leaderboards (dishes served, yen earned, likes from visitors) with a small cache.
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")

local Core = require(script.Parent.Parent.Core)

local Leaderboard = {}
local stores = {}
local cache = { t = 0, data = nil }
local names = {}

local BOARDS = { dishes = "LB_Dishes_v1", earned = "LB_Earned_v1", likes = "LB_Likes_v1" }

local function nameOf(userId)
	if names[userId] then
		return names[userId]
	end
	local ok, n = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	names[userId] = ok and n or ("#" .. userId)
	return names[userId]
end

local function submit(player)
	local d = Core.S.Data.get(player)
	if not d then
		return
	end
	for stat, store in pairs(stores) do
		local value = math.floor(d.stats[stat] or 0)
		pcall(function()
			store:SetAsync(tostring(player.UserId), value)
		end)
	end
end

local function fetch()
	if cache.data and os.clock() - cache.t < 120 then
		return cache.data
	end
	local out = {}
	for stat, store in pairs(stores) do
		out[stat] = {}
		local ok, pages = pcall(function()
			return store:GetSortedAsync(false, 10)
		end)
		if ok and pages then
			for rank, entry in ipairs(pages:GetCurrentPage()) do
				table.insert(out[stat], { rank = rank, name = nameOf(tonumber(entry.key)), value = entry.value })
			end
		end
	end
	cache = { t = os.clock(), data = out }
	return out
end

function Leaderboard.Init()
	for stat, name in pairs(BOARDS) do
		local ok, s = pcall(function()
			return DataStoreService:GetOrderedDataStore(name)
		end)
		if ok then
			stores[stat] = s
		end
	end
	Core.S.Net.invoke("GetLeaderboard", function()
		return fetch()
	end)
end

function Leaderboard.Start()
	Players.PlayerRemoving:Connect(submit)
	task.spawn(function()
		while true do
			task.wait(300)
			for _, p in ipairs(Players:GetPlayers()) do
				submit(p)
			end
		end
	end)
end

return Leaderboard
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000084"><Properties><string name="Name">Meta</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Daily quests, achievements, login streak, offline earnings and tutorial progress.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Quests = require(Shared.Config.Quests)
local TutorialCfg = require(Shared.Config.Tutorial)
local Achievements = require(Shared.Config.Achievements)
local DailyRewards = require(Shared.Config.DailyRewards)
local Upgrades = require(Shared.Config.Upgrades)
local Expansions = require(Shared.Config.Expansions)
local Formulas = require(Shared.Logic.Formulas)
local TableUtil = require(Shared.Util.TableUtil)
local Core = require(script.Parent.Parent.Core)

local Meta = {}

local function dayIndex()
	return math.floor(os.time() / 86400)
end

local function ensureQuests(player, d)
	local today = dayIndex()
	if d.meta.questDay == today and #d.meta.quests > 0 then
		return
	end
	local rng = Random.new(today * 7919 + player.UserId % 1000)
	local pool = table.clone(Quests.list)
	TableUtil.shuffle(pool, rng)
	d.meta.quests = {}
	for i = 1, Quests.PerDay do
		local q = pool[i]
		table.insert(d.meta.quests, { id = q.id, target = Formulas.questTarget(q.base, q.perLevel, d.level), progress = 0, claimed = false })
	end
	d.meta.questDay = today
	d.meta.questBonus = false
end

local function statValue(d, stat)
	if stat == "staff" then
		return #d.staff
	elseif stat == "level" then
		return d.level
	elseif stat == "licenses" then
		return TableUtil.count(d.licenses)
	elseif stat == "zones" then
		local n = 0
		for id in pairs(d.zones) do
			if string.sub(id, 1, 5) == "zone_" then
				n += 1
			end
		end
		return n
	elseif stat == "renos" then
		local n = 0
		for id in pairs(d.zones) do
			local e = Expansions.byId[id]
			if e and e.reno then
				n += 1
			end
		end
		return n
	elseif stat == "franchise" then
		return d.franchise.stars or 0
	end
	return d.stats[stat] or 0
end

local function checkAchievements(player, d)
	local changed = false
	for _, a in ipairs(Achievements.list) do
		if not d.meta.achievements[a.id] and statValue(d, a.stat) >= a.target then
			d.meta.achievements[a.id] = "done"
			changed = true
			Core.S.Net.notify(player, "msg.achievement", { name = "ach." .. a.stat, n = a.target }, "level")
		end
	end
	return changed
end

-- Generic progress hook. kind matches Quests[].kind and stats.
function Meta.event(player, kind, amount, info)
	if not player then
		return
	end
	local d = Core.S.Data.get(player)
	if not d then
		return
	end
	ensureQuests(player, d)
	local questChanged = false
	for _, q in ipairs(d.meta.quests) do
		local cfg = Quests.byId[q.id]
		if cfg and cfg.kind == kind and q.progress < q.target then
			q.progress = math.min(q.target, q.progress + (amount or 1))
			questChanged = true
			if q.progress >= q.target then
				Core.S.Net.notify(player, "msg.quest_done", { name = "quest." .. q.id, n = q.target }, "success")
			end
		end
	end
	local achChanged = checkAchievements(player, d)
	if questChanged or achChanged then
		Core.S.Data.changed(player, "meta")
	end
	local _ = info
end

function Meta.dayEnded(player)
	Meta.event(player, "day_end", 1)
end

local function claimQuest(player, id)
	local d = Core.S.Data.get(player)
	if not d then
		return
	end
	ensureQuests(player, d)
	for _, q in ipairs(d.meta.quests) do
		if q.id == id and q.progress >= q.target and not q.claimed then
			q.claimed = true
			Core.S.Economy.add(player, Quests.RewardYenPerLevel * d.level, "quest")
			Core.S.Economy.addSakura(player, Quests.RewardSakura)
			local all = true
			for _, other in ipairs(d.meta.quests) do
				if not other.claimed then
					all = false
				end
			end
			if all and not d.meta.questBonus then
				d.meta.questBonus = true
				Core.S.Economy.addSakura(player, Quests.BonusSakura)
				Core.S.Net.notify(player, "msg.quest_bonus", { n = Quests.BonusSakura }, "success")
			end
			Core.S.Data.changed(player, "meta")
			return
		end
	end
end

local function claimAchievement(player, id)
	local d = Core.S.Data.get(player)
	local a = Achievements.byId[id]
	if not d or not a or d.meta.achievements[id] ~= "done" then
		return
	end
	d.meta.achievements[id] = "claimed"
	Core.S.Economy.addSakura(player, a.sakura)
	Core.S.Data.changed(player, "meta")
end

local function claimDaily(player)
	local d = Core.S.Data.get(player)
	if not d then
		return
	end
	local today = dayIndex()
	local daily = d.meta.daily
	if daily.last == today then
		return Core.S.Net.notify(player, "msg.daily_done", nil, "info")
	end
	if daily.last == today - 1 then
		daily.streak = daily.streak % #DailyRewards.days + 1
	else
		daily.streak = 1
	end
	daily.last = today
	local reward = DailyRewards.days[daily.streak]
	if reward.yen then
		Core.S.Economy.add(player, math.floor(reward.yen * (1 + d.level / 10)), "daily")
	end
	if reward.sakura then
		Core.S.Economy.addSakura(player, reward.sakura)
	end
	if reward.item then
		d.inventory[reward.item] = (d.inventory[reward.item] or 0) + 1
		Core.S.Data.changed(player, "inventory")
	end
	Core.S.Data.changed(player, "meta")
	Core.S.Net.notify(player, "msg.daily_claimed", { day = daily.streak }, "success")
end

local function computeOffline(player, d)
	local lvl = d.upgrades.up_safe or 0
	if lvl <= 0 or (d.meta.lastSeen or 0) <= 0 then
		return
	end
	local up = Upgrades.byId.up_safe
	local maxHours = up.values[lvl + 1]
	local pct = up.pct[lvl + 1]
	local hours = math.min(maxHours, (os.time() - d.meta.lastSeen) / 3600)
	if hours < 0.05 then
		return
	end
	local history = d.stats.dayHistory or {}
	if #history == 0 then
		return
	end
	local sum = 0
	for _, v in ipairs(history) do
		sum += v
	end
	local perDay = sum / #history
	local hourly = perDay * 5 -- a service day lasts 12 real minutes
	local amount = Formulas.offlineEarnings(hourly, pct, hours)
	if amount > 0 then
		d.meta.offlinePending = (d.meta.offlinePending or 0) + amount
		d.meta.offlineHours = hours
		Core.S.Data.changed(player, "meta")
	end
end

local function claimOffline(player)
	local d = Core.S.Data.get(player)
	if not d or (d.meta.offlinePending or 0) <= 0 then
		return
	end
	local amount = d.meta.offlinePending
	d.meta.offlinePending = 0
	Core.S.Economy.add(player, amount, "offline")
	Core.S.Data.changed(player, "meta")
end

function Meta.Init()
	local Net = Core.S.Net
	Net.on("ClaimQuest", function(player, id)
		if type(id) == "string" then
			claimQuest(player, id)
		end
	end, 4)
	Net.on("ClaimAchievement", function(player, id)
		if type(id) == "string" then
			claimAchievement(player, id)
		end
	end, 6)
	Net.on("ClaimDaily", claimDaily, 2)
	Net.on("ClaimOffline", claimOffline, 2)
	local SETTINGS = {
		lang = function(v)
			return v == "auto" or v == "en" or v == "it"
		end,
		grid = function(v)
			return v == 1 or v == 5 or v == 10
		end,
		rot = function(v)
			return v == 90 or v == 45 or v == 15
		end,
		music = function(v)
			return type(v) == "number" and v >= 0 and v <= 1
		end,
		sfx = function(v)
			return type(v) == "number" and v >= 0 and v <= 1
		end,
		lowGfx = function(v)
			return type(v) == "boolean"
		end,
		cam = function(v)
			return v == "auto" or v == "first" or v == "game" or v == "roblox"
		end,
		camSpeed = function(v)
			return type(v) == "number" and v >= 0.3 and v <= 2
		end,
		-- who may help in your restaurant: "friends" or "everyone"
		coop = function(v)
			return v == "friends" or v == "everyone"
		end,
	}
	Net.on("SetSetting", function(player, key, value)
		local d = Core.S.Data.get(player)
		local check = SETTINGS[key]
		if d and check and check(value) then
			d.settings[key] = value
			Core.S.Data.changed(player, "settings")
		end
	end, 6)
	Net.on("TutorialStep", function(player, step)
		local d = Core.S.Data.get(player)
		if d and type(step) == "number" and step == step and step >= -1 and step <= 50 then
			d.meta.tutorial = math.floor(step)
			Core.S.Data.changed(player, "meta")
		end
	end, 4)
	-- the tutorial's two gifts, each once, and only for what really happened: "serve" after the
	-- first dish served, "done" after the first dish washed too (Config/Tutorial)
	Net.on("TutorialReward", function(player, kind)
		local d = Core.S.Data.get(player)
		if not d or (kind ~= "serve" and kind ~= "done") then
			return
		end
		local gifts = d.meta.tutorialGifts
		if gifts[kind] then
			return
		end
		if kind == "serve" then
			if (d.stats.dishes or 0) < 1 then
				return
			end
			gifts.serve = true
			Core.S.Economy.add(player, TutorialCfg.ServeYen, "tutorial")
			Net.notify(player, "msg.tutorial_gift", { yen = TutorialCfg.ServeYen }, "success")
		else
			if not gifts.serve or (d.stats.washed or 0) < 1 then
				return
			end
			gifts.done = true
			Core.S.Economy.addSakura(player, TutorialCfg.DoneSakura)
			Net.notify(player, "msg.tutorial_done", { n = TutorialCfg.DoneSakura }, "level")
			Net.fx("sparkle", { userId = player.UserId })
			if Core.S.Analytics then
				Core.S.Analytics.step(player, "tutorial_done")
			end
		end
		Core.S.Data.changed(player, "meta")
	end, 2)
	Net.on("HintSeen", function(player, id)
		local d = Core.S.Data.get(player)
		if d and type(id) == "string" and TutorialCfg.Hints[id] then
			d.meta.hints[id] = true
			Core.S.Data.changed(player, "meta")
		end
	end, 4)
end

function Meta.Start()
	Core.S.Data.Loaded:Connect(function(player, d)
		ensureQuests(player, d)
		computeOffline(player, d)
		checkAchievements(player, d)
		d.meta.lastSeen = os.time()
		Core.S.Data.changed(player, "meta")
	end)
end

return Meta
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000085"><Properties><string name="Name">Monetization</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Game passes and developer products (IDs in Shared.Config.Monetization; 0 = disabled).
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.Monetization)
local Formulas = require(Shared.Logic.Formulas)
local Core = require(script.Parent.Parent.Core)

local Monetization = {}
local owned = {} -- [player] = { [passId] = true }
local passByAsset, productById = {}, {}

for _, gp in ipairs(Config.GamePasses) do
	if gp.assetId ~= 0 then
		passByAsset[gp.assetId] = gp
	end
end
for _, p in ipairs(Config.Products) do
	if p.productId ~= 0 then
		productById[p.productId] = p
	end
end

local function passCfg(id)
	for _, gp in ipairs(Config.GamePasses) do
		if gp.id == id then
			return gp
		end
	end
	return nil
end

function Monetization.has(player, id)
	return owned[player] ~= nil and owned[player][id] == true
end

-- yen multiplier of a player's passes (applies to the income of their own restaurant)
function Monetization.yenMultiplier(player)
	local m = 1
	for _, gp in ipairs(Config.GamePasses) do
		if gp.effect.yenMult and Monetization.has(player, gp.id) then
			m *= gp.effect.yenMult
		end
	end
	return m
end

-- one-time rewards of a pass (starter pack items, VIP statue)
local function grantPass(player, gp)
	owned[player] = owned[player] or {}
	owned[player][gp.id] = true
	if gp.id == "gp_vip" then
		player:SetAttribute("VIP", true)
	end
	local d = Core.S.Data.waitFor(player, 30)
	if not d or d.passes[gp.id] then
		return
	end
	d.passes[gp.id] = true
	local e = gp.effect
	if e.yen then
		Core.S.Economy.add(player, e.yen, "product", { raw = true })
	end
	if e.item then
		d.inventory[e.item] = (d.inventory[e.item] or 0) + 1
	end
	if e.items then
		for id, n in pairs(e.items) do
			d.inventory[id] = (d.inventory[id] or 0) + n
		end
	end
	Core.S.Data.changed(player, "inventory")
	Core.S.Data.changed(player, "passes")
end

local function applyProduct(player, d, p)
	local e = p.effect
	if e.yen then
		local amount = Formulas.yenPack(e.yen, d.level, Config.YenLevelScale)
		Core.S.Economy.add(player, amount, "product", { raw = true })
	end
	if e.sakura then
		Core.S.Economy.addSakura(player, e.sakura)
	end
	if e.boost then
		local now = os.time()
		d.boosts[e.boost] = math.max(now, d.boosts[e.boost] or 0) + e.seconds
		Core.S.Data.changed(player, "boosts")
	end
end

local function processReceipt(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local Data = Core.S.Data
	local d = Data.waitFor(player, 20)
	local p = productById[info.ProductId]
	if not d or not p then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	for _, r in ipairs(d.receipts) do
		if r == info.PurchaseId then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
	end
	applyProduct(player, d, p)
	table.insert(d.receipts, info.PurchaseId)
	while #d.receipts > 50 do
		table.remove(d.receipts, 1)
	end
	if Data.storeAvailable() and not Data.saveNow(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	Core.S.Net.notify(player, "msg.purchase_thanks", nil, "success")
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

local function checkPasses(player)
	owned[player] = owned[player] or {}
	for _, gp in ipairs(Config.GamePasses) do
		if gp.assetId ~= 0 then
			local ok, has = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, gp.assetId)
			end)
			if ok and has then
				task.spawn(grantPass, player, gp)
			end
		end
	end
end

function Monetization.Init()
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, assetId, purchased)
		local gp = passByAsset[assetId]
		if purchased and gp then
			grantPass(player, gp)
			Core.S.Net.notify(player, "msg.purchase_thanks", nil, "success")
		end
	end)
	Core.S.Net.on("BuyWithRobux", function(player, kind, id)
		if kind == "gamepass" then
			local gp = passCfg(id)
			if gp and gp.assetId ~= 0 then
				MarketplaceService:PromptGamePassPurchase(player, gp.assetId)
			end
		elseif kind == "product" then
			for _, p in ipairs(Config.Products) do
				if p.id == id and p.productId ~= 0 then
					MarketplaceService:PromptProductPurchase(player, p.productId)
				end
			end
		end
	end, 2)
end

function Monetization.Start()
	Players.PlayerAdded:Connect(checkPasses)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(checkPasses, p)
	end
	Players.PlayerRemoving:Connect(function(p)
		owned[p] = nil
	end)
end

return Monetization
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000086"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Server networking helpers: rate-limited handlers and broadcast helpers.
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local RateLimit = require(Shared.Util.RateLimit)
local Core = require(script.Parent.Parent.Core)

local Net = {}
local limiters = {}

function Net.Init()
	NetDef.event("Interact") -- creates the folder with all remotes
	-- forget the rate limit buckets of players who left
	Players.PlayerRemoving:Connect(function(player)
		for _, limiter in pairs(limiters) do
			limiter:clear(player)
		end
	end)
end

-- handler(player, ...) ; rate = calls per second allowed (burst = 2x)
function Net.on(name, handler, rate)
	local limiter = RateLimit.new(rate or 8, (rate or 8) * 2)
	limiters[name] = limiter
	NetDef.event(name).OnServerEvent:Connect(function(player, ...)
		if not limiter:check(player) then
			return
		end
		local ok, err = pcall(handler, player, ...)
		if not ok then
			warn("[Net] " .. name .. " handler error: " .. tostring(err))
		end
	end)
end

-- rate = calls per second allowed for each player (burst = 3x); extra calls get nil
function Net.invoke(name, handler, rate)
	local limiter = RateLimit.new(rate or 1, (rate or 1) * 3)
	limiters[name] = limiter
	NetDef.func(name).OnServerInvoke = function(player, ...)
		if not limiter:check(player) then
			return nil
		end
		local ok, result = pcall(handler, player, ...)
		if not ok then
			warn("[Net] " .. name .. " invoke error: " .. tostring(result))
			return nil
		end
		return result
	end
end

function Net.fire(player, name, ...)
	if player and player.Parent then
		NetDef.event(name):FireClient(player, ...)
	end
end

function Net.fireAll(name, ...)
	NetDef.event(name):FireAllClients(...)
end

function Net.notify(player, key, params, kind)
	Net.fire(player, "Notify", key, params, kind or "info")
end

function Net.notifyAll(key, params, kind)
	Net.fireAll("Notify", key, params, kind or "info")
end

function Net.fx(kind, data)
	Net.fireAll("Fx", kind, data)
end

function Net.fxTo(player, kind, data)
	Net.fire(player, "Fx", kind, data)
end

-- Argument validation helpers
function Net.str(v, maxLen)
	return type(v) == "string" and #v <= (maxLen or 64)
end

function Net.num(v, min, max)
	return type(v) == "number" and v == v and (min == nil or v >= min) and (max == nil or v <= max)
end

function Net.players()
	return Players:GetPlayers()
end

local _ = Core
return Net
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000087"><Properties><string name="Name">Npc</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- NPC characters (customers and staff): creation, pooling, animations, walking with pathfinding,
-- sitting and simple emotes.
local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local NpcLooks = require(Shared.Config.NpcLooks)
local Registry = require(Shared.Models.Registry)
local Color = require(Shared.Util.Color)
local Core = require(script.Parent.Parent.Core)

local Npc = {}

local ANIMS = {
	idle = "rbxassetid://507766666",
	walk = "rbxassetid://507777826",
	sit = "rbxassetid://2506281703",
	hold = "rbxassetid://507768375",
	wave = "rbxassetid://507770239",
	cheer = "rbxassetid://507770677",
}

local pool = {}
local rng = Random.new()
local active = 0

function Npc.count()
	return active
end

local function loadAnims(model)
	local hum = model:FindFirstChildOfClass("Humanoid")
	local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
	local tracks = {}
	for name, id in pairs(ANIMS) do
		local a = Instance.new("Animation")
		a.AnimationId = id
		local ok, track = pcall(function()
			return animator:LoadAnimation(a)
		end)
		if ok and track then
			if name == "walk" or name == "idle" or name == "sit" or name == "hold" then
				track.Looped = true
			end
			if name == "sit" then
				track.Priority = Enum.AnimationPriority.Action
			elseif name == "hold" then
				track.Priority = Enum.AnimationPriority.Action
			elseif name == "wave" or name == "cheer" then
				track.Priority = Enum.AnimationPriority.Action2
			else
				track.Priority = Enum.AnimationPriority.Core
			end
			tracks[name] = track
		end
	end
	return tracks
end

local function setupAnimator(npc)
	local hum = npc.humanoid
	npc.tracks = loadAnims(npc.model)
	local current = nil
	local function play(name)
		if current == name then
			return
		end
		if current and npc.tracks[current] then
			npc.tracks[current]:Stop(0.2)
		end
		current = name
		if npc.tracks[name] then
			npc.tracks[name]:Play(0.2)
		end
	end
	hum.Running:Connect(function(speed)
		if npc.sitting then
			return
		end
		if speed > 0.5 then
			play("walk")
		else
			play("idle")
		end
	end)
	npc.play = play
	play("idle")
end

local function describe(look, shirtColor, child)
	local desc = Instance.new("HumanoidDescription")
	-- body proportions vary a little inside the ranges Roblox allows (children are scaled after)
	if not child then
		desc.HeightScale = (look == "elder" and 0.9 or 0.93) + rng:NextNumber() * 0.12
		desc.WidthScale = 0.8 + rng:NextNumber() * 0.2
		desc.DepthScale = 0.9 + rng:NextNumber() * 0.1
		desc.HeadScale = 0.95 + rng:NextNumber() * 0.05
	end
	desc.BodyTypeScale = 0
	desc.ProportionScale = 0
	local skin = Color.hex(NpcLooks.skin[rng:NextInteger(1, #NpcLooks.skin)])
	local shirts = NpcLooks.shirts[look] or NpcLooks.shirts.casual
	local shirt = shirtColor and Color.hex(shirtColor) or Color.hex(shirts[rng:NextInteger(1, #shirts)])
	local pants = Color.hex(NpcLooks.pants[rng:NextInteger(1, #NpcLooks.pants)])
	desc.HeadColor = skin
	desc.LeftArmColor = shirt
	desc.RightArmColor = shirt
	desc.TorsoColor = shirt
	desc.LeftLegColor = pants
	desc.RightLegColor = pants
	if #NpcLooks.catalogHats > 0 and rng:NextNumber() < 0.4 then
		desc.HatAccessory = tostring(NpcLooks.catalogHats[rng:NextInteger(1, #NpcLooks.catalogHats)])
	end
	return desc
end

-- Expression from the customer's state and patience (see People.setMood)
local function moodFor(model)
	local state = model:GetAttribute("State")
	local p = model:GetAttribute("Patience") or 1
	if state == "served" or state == "eating" or state == "paying" then
		return "happy"
	elseif state == "leaving" then
		return p <= 0.01 and "angry" or nil
	elseif state == "order" or state == "waiting" or state == "queue" or state == "reading" then
		if p < 0.3 then
			return "angry"
		elseif p < 0.55 then
			return "worried"
		end
	end
	return "calm"
end

-- Creates a new NPC. opts: { look = "casual", shirt = "#hex", staff = role, child = bool }
function Npc.create(opts)
	opts = opts or {}
	local model
	local desc = describe(opts.look or "casual", opts.shirt, opts.child)
	local ok, err = pcall(function()
		model = Players:CreateHumanoidModelFromDescriptionAsync(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		-- older engine versions only have the non-Async name
		ok, err = pcall(function()
			model = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
		end)
	end
	if not ok or not model then
		warn("[Npc] could not create rig: " .. tostring(err))
		return nil
	end
	model.Name = opts.staff and "Staff" or "Customer"
	if opts.child then
		-- a child is the same rig scaled down (clothes are fitted afterwards, so they follow)
		pcall(function()
			model:ScaleTo(0.72)
		end)
	end
	local hum = model:FindFirstChildOfClass("Humanoid")
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.BreakJointsOnDeath = false
	hum.WalkSpeed = opts.speed or GameConfig.Customers.WalkSpeed
	for _, st in ipairs({ Enum.HumanoidStateType.Climbing, Enum.HumanoidStateType.Swimming, Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.Ragdoll, Enum.HumanoidStateType.Dead, Enum.HumanoidStateType.Flying }) do
		pcall(function()
			hum:SetStateEnabled(st, false)
		end)
	end
	for _, s in ipairs(model:GetChildren()) do
		if s:IsA("Script") or s:IsA("LocalScript") then
			s:Destroy()
		end
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CollisionGroup = "NPC"
			d.CanTouch = false
		end
	end
	local People = Registry.People
	if opts.staff then
		People.staff(model, opts.staff, NpcLooks, rng)
	else
		People.dress(model, opts.look or "casual", NpcLooks, rng, { child = opts.child })
		local function refresh()
			local mood = moodFor(model)
			if mood then
				People.setMood(model, mood)
			end
		end
		model:GetAttributeChangedSignal("State"):Connect(refresh)
		model:GetAttributeChangedSignal("Patience"):Connect(refresh)
	end
	local npc = { model = model, humanoid = hum, root = model:FindFirstChild("HumanoidRootPart"), sitting = false }
	return npc
end

function Npc.spawn(npc, cf)
	npc.model:PivotTo(cf)
	npc.model.Parent = Core.S.World.folders().npcs
	if npc.root then
		pcall(function()
			npc.root:SetNetworkOwner(nil)
		end)
	end
	if not npc.play then
		setupAnimator(npc)
	end
	active += 1
end

function Npc.acquireCustomer(look, child)
	-- reuse a pooled body when available (looks are re-randomized only for new ones)
	local key = child and (look .. ":child") or look
	for i, npc in ipairs(pool) do
		if npc.look == key then
			table.remove(pool, i)
			return npc
		end
	end
	local npc = Npc.create({ look = look, child = child })
	if npc then
		npc.look = key
	end
	return npc
end

function Npc.release(npc)
	if not npc or not npc.model then
		return
	end
	Npc.stand(npc)
	npc.model.Parent = nil
	npc.model:SetAttribute("Uid", nil)
	npc.model:SetAttribute("State", nil)
	npc.model:SetAttribute("Patience", 1)
	Registry.People.setMood(npc.model, "calm")
	active = math.max(0, active - 1)
	if #pool < 16 and not npc.isStaff then
		table.insert(pool, npc)
	else
		npc.model:Destroy()
	end
end

function Npc.destroy(npc)
	if npc and npc.model then
		active = math.max(0, active - 1)
		npc.model:Destroy()
	end
end

local customerPath = { AgentRadius = 1.1, AgentHeight = 5, AgentCanJump = false, WaypointSpacing = 4, Costs = { StaffOnly = math.huge } }
local staffPath = { AgentRadius = 1.1, AgentHeight = 5, AgentCanJump = false, WaypointSpacing = 4 }

local function moveTo(npc, pos, timeout)
	local hum = npc.humanoid
	hum:MoveTo(pos)
	local done = false
	local reached = false
	local conn
	conn = hum.MoveToFinished:Connect(function(r)
		done = true
		reached = r
	end)
	local t0 = os.clock()
	while not done and os.clock() - t0 < (timeout or 6) do
		task.wait(0.1)
		if not npc.model.Parent then
			break
		end
	end
	conn:Disconnect()
	return reached
end

-- Walks to a position. Returns true when arrived (teleports if stuck for too long).
function Npc.walkTo(npc, target, opts)
	opts = opts or {}
	if not npc.model.Parent or not npc.root then
		return false
	end
	Npc.stand(npc)
	local params = opts.staff and staffPath or customerPath
	local path = PathfindingService:CreatePath(params)
	local ok = pcall(function()
		path:ComputeAsync(npc.root.Position, target)
	end)
	if ok and path.Status == Enum.PathStatus.Success then
		local waypoints = path:GetWaypoints()
		for i = 2, #waypoints do
			if not npc.model.Parent or npc.cancel then
				return false
			end
			local wp = waypoints[i]
			if not moveTo(npc, wp.Position, 4) then
				-- blocked: try straight towards the target
				break
			end
		end
	end
	if npc.model.Parent and (npc.root.Position - target).Magnitude > 3 then
		moveTo(npc, target, 4)
	end
	if npc.model.Parent and (npc.root.Position - target).Magnitude > 4 then
		-- stuck (blocked path): small teleport so the game never soft-locks
		npc.model:PivotTo(CFrame.new(target + Vector3.new(0, 3, 0)))
	end
	return npc.model.Parent ~= nil
end

function Npc.face(npc, pos)
	if npc.root then
		local p = npc.root.Position
		local look = Vector3.new(pos.X, p.Y, pos.Z)
		if (look - p).Magnitude > 0.1 then
			npc.root.CFrame = CFrame.lookAt(p, look)
		end
	end
end

-- Sits at a seat CFrame (position = seat top, look = facing)
function Npc.sit(npc, sitCf)
	if not npc.root then
		return
	end
	npc.sitting = true
	npc.root.Anchored = true
	npc.model:PivotTo(sitCf * CFrame.new(0, GameConfig.Customers.SeatHeightOffset, 0))
	if npc.play then
		npc.play("sit")
	end
end

function Npc.stand(npc)
	if npc.sitting and npc.root then
		npc.sitting = false
		npc.root.Anchored = false
		npc.model:PivotTo(npc.root.CFrame * CFrame.new(0, 0.5, 1.8))
		if npc.play then
			npc.play("idle")
		end
	end
end

function Npc.emote(npc, name)
	local t = npc.tracks and npc.tracks[name]
	if t then
		t:Play(0.1)
	end
end

function Npc.Start()
	-- prewarm a few customer bodies
	task.spawn(function()
		for _ = 1, 4 do
			local npc = Npc.create({ look = "casual" })
			if npc then
				npc.look = "casual"
				table.insert(pool, npc)
			end
			task.wait(0.2)
		end
	end)
end

return Npc
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000088"><Properties><string name="Name">Placement</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Placed objects of every restaurant: spawning models from the owner's data (restaurant-local
-- coordinates moved onto the plot), building remotes, inventory, painting, ambience. Functional
-- services subscribe to ItemAdded / ItemRemoved / ItemMoved (the entity knows its plot).
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Items = require(Shared.Config.Items)
local Surfaces = require(Shared.Config.Surfaces)
local Sets = require(Shared.Config.Sets)
local Upgrades = require(Shared.Config.Upgrades)
local Events = require(Shared.Config.Events)
local Expansions = require(Shared.Config.Expansions)
local PlacementLogic = require(Shared.Logic.Placement)
local Ambience = require(Shared.Logic.Ambience)
local Footprint = require(Shared.Logic.Footprint)
local Registry = require(Shared.Models.Registry)
local Signal = require(Shared.Util.Signal)
local Uid = require(Shared.Util.Uid)
local Core = require(script.Parent.Parent.Core)

local Placement = {}
Placement.ItemAdded = Signal.new() -- (entity)
Placement.ItemRemoved = Signal.new() -- (entity)
Placement.ItemMoved = Signal.new() -- (entity)
Placement.LayoutChanged = Signal.new() -- (plot)
local NO_AMBIENCE = { points = 0, tier = 0, patience = 0, tip = 0, popularity = 0, sets = {} }

-- ambience of a restaurant: { points, tier, patience, tip, popularity, sets }
function Placement.ambienceOf(plot)
	return (plot and plot.ambience) or NO_AMBIENCE
end

local vetoes = {} -- functions(entity) -> ok, reason

local FN_KIND = {
	seat = "seat", counter = "counter", table = "table", booth = "booth", shelf = "shelf",
	ricecooker = "ricecooker", pot = "pot", station = "station", sink = "sink", dishwasher = "dishwasher",
	rack = "rack", bench = "bench", fridge = "fridge", tipjar = "tipjar",
}

function Placement.kindOf(itemId)
	local item = Items.byId[itemId]
	if item and item.fn then
		return FN_KIND[item.fn.type] or "decor"
	end
	return "decor"
end

function Placement.addVeto(fn)
	table.insert(vetoes, fn)
end

-- the restaurant a player builds in: the one they stand in when they may build there
local function buildPlot(player)
	local Plots = Core.S.Plots
	local plot = Plots.of(player)
	if plot and Plots.canBuild(player, plot) then
		return plot
	end
	return nil
end

local function findEntry(data, uid)
	for i, e in ipairs(data.placed) do
		if e.u == uid then
			return e, i
		end
	end
	return nil
end

local function worldY(entry)
	local item = Items.byId[entry.i]
	local World = Core.S.World
	if entry.s == "f" then
		return World.floorY(entry.f)
	elseif entry.s == "c" then
		return World.floorY(entry.f) + GameConfig.WallHeight - item.size[2]
	elseif entry.s == "w" then
		return (entry.y or World.floorY(entry.f) + 6) - item.size[2] / 2
	elseif entry.s == "t" then
		return entry.y or World.floorY(entry.f)
	end
	return 0
end

local function spawn(plot, entry)
	local data = Core.S.Plots.data(plot)
	local model = Registry.build(entry.i, { styles = Expansions.styles(data and data.zones) })
	Registry.place(model, entry.x + plot.origin.X, worldY(entry), entry.z + plot.origin.Z, entry.r)
	model:SetAttribute("FloorIndex", entry.f or 0)
	model.Parent = Core.S.World.folders(plot).items
	local item = Items.byId[entry.i]
	local e = Core.S.Entities.register(entry.u, Placement.kindOf(entry.i), model, { entry = entry, item = item, isItem = true, plot = plot })
	Placement.ItemAdded:Fire(e)
	return e
end

local function despawn(uid)
	local e = Core.S.Entities.unregister(uid)
	if e then
		Placement.ItemRemoved:Fire(e)
		if e.model then
			e.model:Destroy()
		end
	end
end

function Placement.recomputeAmbience(plot)
	local data = Core.S.Plots.data(plot)
	if not data then
		return
	end
	local extra = Upgrades.value(data.upgrades, "up_jukebox")
	for _, e in ipairs(Expansions.list) do
		if data.zones[e.id] and e.ambience then
			extra += e.ambience
		end
	end
	plot.ambience = Ambience.compute(data.placed, Items.byId, Surfaces.byId, data.surfaces, extra, Sets.list)
	plot.folder:SetAttribute("Ambience", plot.ambience.points)
	plot.folder:SetAttribute("AmbienceTier", plot.ambience.tier)
	local decor = 0
	for _, e in ipairs(data.placed) do
		if Placement.kindOf(e.i) == "decor" then
			decor += 1
		end
	end
	data.stats.decor = math.max(data.stats.decor or 0, decor)
end

local function changed(plot)
	Placement.recomputeAmbience(plot)
	Core.S.Data.changed(plot.owner, "placed")
	Core.S.Data.changed(plot.owner, "inventory")
	Placement.LayoutChanged:Fire(plot)
end

-- removes every placed object of a restaurant (its owner left)
function Placement.despawnAll(plot)
	for _, e in ipairs(Core.S.Entities.ofPlot(plot)) do
		if e.isItem then
			despawn(e.uid)
		end
	end
end

function Placement.spawnAll(plot, data)
	Placement.despawnAll(plot)
	-- floor items first so tops find their parents
	table.sort(data.placed, function(a, b)
		local order = { f = 1, w = 2, c = 3, t = 4 }
		return (order[a.s] or 5) < (order[b.s] or 5)
	end)
	for _, entry in ipairs(data.placed) do
		if Items.byId[entry.i] then
			local ok, err = pcall(spawn, plot, entry)
			if not ok then
				warn("[Placement] could not spawn " .. tostring(entry.i) .. ": " .. tostring(err))
			end
		end
	end
	Placement.recomputeAmbience(plot)
	Placement.LayoutChanged:Fire(plot)
end

-- Removes objects that are no longer valid (e.g. after stairs appear) into the inventory
function Placement.revalidate(plot, data)
	local ctx = Core.S.World.ctx(plot, data.placed)
	local removed = 0
	for i = #data.placed, 1, -1 do
		local e = data.placed[i]
		local others = table.clone(data.placed)
		table.remove(others, i)
		ctx.placed = others
		local ok = PlacementLogic.validate(ctx, e, true)
		if not ok then
			table.remove(data.placed, i)
			data.inventory[e.i] = (data.inventory[e.i] or 0) + 1
			removed += 1
		end
	end
	return removed
end

local function canAfford(player, data, item, fromInventory)
	if fromInventory then
		return (data.inventory[item.id] or 0) > 0
	end
	if item.sakura then
		return (data.sakura or 0) >= item.sakura
	end
	return (data.yen or 0) >= item.price
end

local function itemUnlocked(data, item)
	if data.level < (item.lv or 1) then
		return false, "msg.need_level"
	end
	if item.license and not data.licenses[item.license] then
		return false, "msg.need_license"
	end
	if item.event then
		local active = Events.active(os.time())
		if not active or active.id ~= item.event then
			return false, "msg.event_over"
		end
	end
	if item.franchise and not (data.franchise.cities and data.franchise.cities[item.franchise]) then
		return false, "msg.need_franchise"
	end
	return true
end

local function parseReq(req)
	if type(req) ~= "table" then
		return nil
	end
	local Net = Core.S.Net
	if not (Net.str(req.i, 40) and Net.num(req.x, -500, 500) and Net.num(req.z, -500, 500) and Net.num(req.r or 0, -720, 720)) then
		return nil
	end
	local out = {
		i = req.i,
		x = math.floor(req.x * 100 + 0.5) / 100,
		z = math.floor(req.z * 100 + 0.5) / 100,
		r = math.floor((req.r or 0) % 360 + 0.5),
		f = (Net.num(req.f, 0, 3) and math.floor(req.f)) or 0,
		s = req.s,
		y = Net.num(req.y, -10, 100) and req.y or nil,
		p = Net.str(req.p, 40) and req.p or nil,
	}
	return out
end

local function checkVetoes(uid)
	local e = Core.S.Entities.get(uid)
	if not e then
		return true
	end
	for _, fn in ipairs(vetoes) do
		local ok, reason = fn(e)
		if not ok then
			return false, reason
		end
	end
	return true
end

function Placement.place(player, rawReq, fromInventory)
	local Net, Economy = Core.S.Net, Core.S.Economy
	local plot = buildPlot(player)
	if not plot then
		return Net.notify(player, "msg.no_permission", nil, "error")
	end
	local owner = plot.owner
	local data = Core.S.Plots.data(plot)
	local req = parseReq(rawReq)
	if not data or not req then
		return
	end
	local item = Items.byId[req.i]
	if not item then
		return
	end
	if not fromInventory then
		local ok, reason = itemUnlocked(data, item)
		if not ok then
			return Net.notify(player, reason, { level = item.lv }, "error")
		end
	end
	if item.gamepass and not fromInventory and Core.S.Monetization.has(owner, item.gamepass) then
		fromInventory = (data.inventory[item.id] or 0) > 0
	end
	if not canAfford(player, data, item, fromInventory) then
		return Net.notify(player, "msg.not_enough", nil, "error")
	end
	local ctx = Core.S.World.ctx(plot, data.placed)
	local ok, reason, resolved = PlacementLogic.validate(ctx, req)
	if not ok then
		return Net.notify(player, reason or "msg.place_invalid", nil, "error")
	end
	if fromInventory then
		data.inventory[item.id] -= 1
		if data.inventory[item.id] <= 0 then
			data.inventory[item.id] = nil
		end
	elseif item.sakura then
		if not Economy.spendSakura(owner, item.sakura, "item:" .. item.id) then
			return
		end
	else
		if not Economy.spend(owner, item.price, "build", "item:" .. item.id) then
			return Net.notify(player, "msg.not_enough", nil, "error")
		end
	end
	local entry = { u = Uid.new("p"), i = item.id, x = resolved.x, z = resolved.z, r = resolved.r, f = resolved.f, s = resolved.s, t = os.time() }
	if resolved.s == "w" or resolved.s == "t" then
		entry.y = resolved.y
	end
	if resolved.p then
		entry.p = resolved.p
	end
	entry.paid = (not fromInventory) and (item.sakura and 0 or item.price) or 0
	table.insert(data.placed, entry)
	spawn(plot, entry)
	changed(plot)
	Net.fxTo(player, "sfx", { name = "place" })
	Core.S.Meta.event(owner, "place", 1, { item = item.id })
end

local function children(data, uid)
	local out = {}
	for _, e in ipairs(data.placed) do
		if e.p == uid then
			table.insert(out, e)
		end
	end
	return out
end

function Placement.move(player, uid, rawReq)
	local Net = Core.S.Net
	local plot = buildPlot(player)
	if not plot or type(uid) ~= "string" then
		return
	end
	local data = Core.S.Plots.data(plot)
	local entry = data and findEntry(data, uid)
	local req = parseReq(rawReq)
	if not entry or not req or req.i ~= entry.i then
		return
	end
	local okVeto, vetoReason = checkVetoes(uid)
	if not okVeto then
		return Net.notify(player, vetoReason, nil, "error")
	end
	req.u = uid
	local ctx = Core.S.World.ctx(plot, data.placed)
	local ok, reason, resolved = PlacementLogic.validate(ctx, req)
	if not ok then
		return Net.notify(player, reason or "msg.place_invalid", nil, "error")
	end
	local dx, dz = resolved.x - entry.x, resolved.z - entry.z
	local dr = resolved.r - entry.r
	local oldX, oldZ = entry.x, entry.z
	entry.x, entry.z, entry.r, entry.f, entry.s = resolved.x, resolved.z, resolved.r, resolved.f, resolved.s
	entry.y = (resolved.s == "w" or resolved.s == "t") and resolved.y or nil
	entry.p = resolved.p
	-- children on top follow (rotated around the parent's center)
	for _, child in ipairs(children(data, uid)) do
		local lx, lz = child.x - oldX, child.z - oldZ
		local a = math.rad(-dr)
		local rx = lx * math.cos(a) - lz * math.sin(a)
		local rz = lx * math.sin(a) + lz * math.cos(a)
		child.x, child.z = resolved.x + rx, resolved.z + rz
		child.r = (child.r + dr) % 360
		child.f = entry.f
		local item = Items.byId[entry.i]
		child.y = Core.S.World.floorY(entry.f) + item.size[2]
	end
	local _ = { dx, dz }
	for _, e in ipairs({ entry, table.unpack(children(data, uid)) }) do
		local ent = Core.S.Entities.get(e.u)
		if ent and ent.model then
			ent.model:SetAttribute("FloorIndex", e.f or 0)
			Registry.place(ent.model, e.x + plot.origin.X, worldY(e), e.z + plot.origin.Z, e.r)
			Placement.ItemMoved:Fire(ent)
		end
	end
	changed(plot)
	Net.fxTo(player, "sfx", { name = "place" })
end

function Placement.remove(player, uid, mode)
	local Net, Economy = Core.S.Net, Core.S.Economy
	local plot = buildPlot(player)
	if not plot or type(uid) ~= "string" then
		return
	end
	local data = Core.S.Plots.data(plot)
	local entry, index = nil, nil
	if data then
		entry, index = findEntry(data, uid)
	end
	if not entry then
		return
	end
	local okVeto, vetoReason = checkVetoes(uid)
	if not okVeto then
		return Net.notify(player, vetoReason, nil, "error")
	end
	for _, child in ipairs(children(data, uid)) do
		local _, ci = findEntry(data, child.u)
		table.remove(data.placed, ci)
		data.inventory[child.i] = (data.inventory[child.i] or 0) + 1
		despawn(child.u)
	end
	index = select(2, findEntry(data, uid))
	table.remove(data.placed, index)
	despawn(uid)
	local item = Items.byId[entry.i]
	if mode == "sell" and not item.sakura then
		local paid = entry.paid or item.price
		local refund = (os.time() - (entry.t or 0) <= GameConfig.FullRefundSeconds) and paid or math.floor(paid * GameConfig.SellRefund)
		if refund > 0 then
			Economy.add(plot.owner, refund, "refund", { raw = true })
		end
	else
		data.inventory[entry.i] = (data.inventory[entry.i] or 0) + 1
	end
	changed(plot)
end

function Placement.paint(player, zoneId, kind, styleId)
	local Net, Economy = Core.S.Net, Core.S.Economy
	local plot = buildPlot(player)
	if not plot then
		return
	end
	local data = Core.S.Plots.data(plot)
	local style = Surfaces.byId[styleId]
	if not data or not style or style.kind ~= kind then
		return
	end
	local zone = nil
	for _, z in ipairs(Core.S.World.geo(plot).zones) do
		if z.id == zoneId and not z.outdoor then
			zone = z
		end
	end
	if not zone then
		return
	end
	if data.level < style.lv then
		return Net.notify(player, "msg.need_level", { level = style.lv }, "error")
	end
	data.surfaces[zoneId] = data.surfaces[zoneId] or {}
	if data.surfaces[zoneId][kind] == styleId then
		return
	end
	if style.price > 0 and not Economy.spend(plot.owner, style.price, "build", "surface:" .. tostring(styleId)) then
		return Net.notify(player, "msg.not_enough", nil, "error")
	end
	data.surfaces[zoneId][kind] = styleId
	Core.S.World.rebuild(plot, data)
	Core.S.Data.changed(plot.owner, "surfaces")
	Placement.recomputeAmbience(plot)
	Net.fxTo(player, "sfx", { name = "place" })
end

-- Items of a restaurant whose footprint is close to a local point (used by seating / freshness)
function Placement.near(plot, x, z, f, radius, filterFn)
	local out = {}
	local data = Core.S.Plots.data(plot)
	if not data then
		return out
	end
	for _, e in ipairs(data.placed) do
		if (e.f or 0) == f and (not filterFn or filterFn(e)) then
			local item = Items.byId[e.i]
			if item then
				local fp = Footprint.new(e.x, e.z, item.size[1], item.size[3], e.r)
				local x0, z0, x1, z1 = Footprint.bounds(fp)
				local dx = math.max(x0 - x, 0, x - x1)
				local dz = math.max(z0 - z, 0, z - z1)
				if math.sqrt(dx * dx + dz * dz) <= radius then
					table.insert(out, e)
				end
			end
		end
	end
	return out
end

function Placement.Init()
	local Net = Core.S.Net
	Net.on("PlaceItem", function(player, req, fromInventory)
		Placement.place(player, req, fromInventory == true)
	end, 6)
	Net.on("MoveItem", function(player, uid, req)
		Placement.move(player, uid, req)
	end, 6)
	Net.on("RemoveItem", function(player, uid, mode)
		Placement.remove(player, uid, mode == "sell" and "sell" or "store")
	end, 6)
	Net.on("PaintSurface", function(player, zoneId, kind, styleId)
		if type(zoneId) == "string" and (kind == "floor" or kind == "wall") and type(styleId) == "string" then
			Placement.paint(player, zoneId, kind, styleId)
		end
	end, 3)
end

function Placement.Start()
	Core.S.Plots.Claimed:Connect(function(plot, _, data)
		task.defer(function()
			Placement.spawnAll(plot, data)
		end)
	end)
	Core.S.Plots.Released:Connect(function(plot)
		Placement.despawnAll(plot)
		plot.ambience = nil
	end)
end

return Placement
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000089"><Properties><string name="Name">Plots</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The street of restaurants: Config/Plots.Count plots side by side, one per player. A player who
-- joins gets the first free plot (their restaurant is built there from their save); when they leave
-- it becomes an empty lot again. Players can help in other restaurants: friends of the owner and
-- invited players (or everyone, if the owner opens the kitchen to all).
--
-- A plot: { id, origin (Vector3), cf (CFrame), owner, ownerId, folder } plus the per-restaurant
-- state that other services keep on it (tickets, ledger, geometry, seats, ...).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local PlotsCfg = require(Shared.Config.Plots)
local Signal = require(Shared.Util.Signal)
local Uid = require(Shared.Util.Uid)
local Core = require(script.Parent.Parent.Core)

local Plots = {}
Plots.list = {}
Plots.byId = {}
Plots.Claimed = Signal.new() -- (plot, player, data): a restaurant opens on this plot
Plots.Released = Signal.new() -- (plot, player): the owner left, the plot is an empty lot again
Plots.WorkChanged = Signal.new() -- (player, plot): the restaurant a player works in changed

local work = {} -- [player] = plot the player is working in (their own, or one they help in)
local root

function Plots.Init()
	root = workspace:FindFirstChild("Plots") or Instance.new("Folder")
	root.Name = "Plots"
	root.Parent = workspace
	for i, x in ipairs(PlotsCfg.OriginsX) do
		local folder = Instance.new("Folder")
		folder.Name = "Plot" .. i
		folder:SetAttribute("PlotId", i)
		folder:SetAttribute("OriginX", x)
		folder:SetAttribute("OwnerId", 0)
		folder:SetAttribute("OwnerName", "")
		folder.Parent = root
		local plot = { id = i, origin = Vector3.new(x, 0, 0), cf = CFrame.new(x, 0, 0), owner = nil, ownerId = nil, folder = folder }
		Plots.list[i] = plot
		Plots.byId[i] = plot
	end
	-- back to the door of your own restaurant (the street is long)
	Core.S.Net.on("GoHome", function(player)
		Plots.sendHome(player)
	end, 1)
	Core.S.Net.on("SetPermission", function(player, userId, level)
		local plot = Plots.ofPlayer(player)
		if not plot or type(userId) ~= "number" or (level ~= "helper" and level ~= "comanager" and level ~= "none") then
			return
		end
		local d = Plots.data(plot)
		if not d then
			return
		end
		d.perms[tostring(userId)] = level ~= "none" and level or nil
		Core.S.Data.changed(player, "perms")
		Plots.refreshInfo()
	end, 4)
end

------------------------------------------------------------------ lookups

-- the owner's profile of a plot (nil for an empty lot)
function Plots.data(plot)
	if not plot or not plot.owner then
		return nil
	end
	return Core.S.Data.get(plot.owner)
end

-- the plot a player owns
function Plots.ofPlayer(player)
	for _, plot in ipairs(Plots.list) do
		if plot.owner == player then
			return plot
		end
	end
	return nil
end

-- the plot a world position belongs to (its strip of street included)
function Plots.at(pos)
	if not pos then
		return nil
	end
	for _, plot in ipairs(Plots.list) do
		if math.abs(pos.X - plot.origin.X) < PlotsCfg.HalfWidth then
			return plot
		end
	end
	return nil
end

-- the plot of a player, a staff member or an entity
function Plots.of(x)
	if x == nil then
		return nil
	end
	if typeof(x) == "Instance" and x:IsA("Player") then
		return work[x] or Plots.ofPlayer(x)
	end
	if type(x) == "table" then
		return x.plot
	end
	return nil
end

-- restaurant-local coordinates <-> world
function Plots.toWorld(plot, x, y, z)
	return Vector3.new(x + plot.origin.X, y or 0, z + plot.origin.Z)
end

function Plots.toLocal(plot, pos)
	return pos - plot.origin
end

-- moves everything built in local coordinates inside `container` onto the plot
function Plots.shift(container, plot)
	local offset = plot.origin
	if offset.Magnitude == 0 then
		return
	end
	local list = container:GetDescendants()
	if container:IsA("BasePart") then
		table.insert(list, container)
	end
	for _, d in ipairs(list) do
		if d:IsA("BasePart") then
			d.CFrame = d.CFrame + offset
		end
	end
end

------------------------------------------------------------------ roles

local function friends(a, b)
	if RunService:IsStudio() then
		return true
	end
	local ok, yes = pcall(function()
		return a:IsFriendsWith(b.UserId)
	end)
	return ok and yes
end

-- "owner" | "comanager" | "helper" | "visitor" for `player` in `plot`
function Plots.role(player, plot)
	if not player or not plot or not plot.owner then
		return "visitor"
	end
	if plot.owner == player then
		return "owner"
	end
	local d = Plots.data(plot)
	local perm = d and d.perms and d.perms[tostring(player.UserId)]
	if perm == "comanager" then
		return "comanager"
	elseif perm == "helper" then
		return "helper"
	end
	local coop = d and d.settings and d.settings.coop or PlotsCfg.DefaultCoop
	if coop == "everyone" or friends(player, plot.owner) then
		return "helper"
	end
	return "visitor"
end

function Plots.canWork(player, plot)
	local r = Plots.role(player, plot)
	return r == "owner" or r == "comanager" or r == "helper"
end

function Plots.canBuild(player, plot)
	local r = Plots.role(player, plot)
	return r == "owner" or r == "comanager"
end

-- the people working in a plot (owner and helpers standing in it)
function Plots.workers(plot)
	local out = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if work[p] == plot or plot.owner == p then
			table.insert(out, p)
		end
	end
	return out
end

-- a message for the people of one restaurant
function Plots.notify(plot, key, params, kind)
	if not plot then
		return
	end
	for _, p in ipairs(Plots.workers(plot)) do
		Core.S.Net.notify(p, key, params, kind)
	end
end

-- a remote event for the people of one restaurant
function Plots.fire(plot, name, ...)
	if not plot then
		return
	end
	for _, p in ipairs(Plots.workers(plot)) do
		Core.S.Net.fire(p, name, ...)
	end
end

------------------------------------------------------------------ info for the client

function Plots.info(player)
	local home = Plots.ofPlayer(player)
	local plot = Plots.of(player) or home
	local list = {}
	for _, p in ipairs(Plots.list) do
		table.insert(list, { id = p.id, x = p.origin.X, ownerId = p.ownerId or 0, ownerName = p.owner and p.owner.DisplayName or "" })
	end
	return {
		plot = plot and plot.id or nil,
		home = home and home.id or nil,
		originX = plot and plot.origin.X or 0,
		homeX = home and home.origin.X or 0,
		ownerId = plot and plot.ownerId or nil,
		ownerName = plot and plot.owner and plot.owner.DisplayName or nil,
		role = Plots.role(player, plot),
		studio = RunService:IsStudio(),
		plots = list,
	}
end

function Plots.refreshInfo()
	for _, p in ipairs(Players:GetPlayers()) do
		Core.S.Net.fire(p, "Session", Plots.info(p))
	end
end

------------------------------------------------------------------ claiming and releasing

local function setWork(player, plot)
	if work[player] == plot then
		return
	end
	work[player] = plot
	Plots.WorkChanged:Fire(player, plot)
	Core.S.Net.fire(player, "Session", Plots.info(player))
end

-- Ids saved in a profile (placed objects, boxes, staff) become entity ids in the server. Two
-- profiles could, very rarely, contain the same id: the newcomer's copies get new ids.
local function dedupe(data)
	local used = {}
	for _, p in ipairs(Plots.list) do
		local od = Plots.data(p)
		if od and od ~= data then
			for _, e in ipairs(od.placed) do
				used[e.u] = true
			end
			for _, b in ipairs(od.storage) do
				used[b.u] = true
			end
			for _, s in ipairs(od.staff) do
				used[s.u] = true
			end
		end
	end
	local map = {}
	for _, e in ipairs(data.placed) do
		if used[e.u] then
			map[e.u] = Uid.new("p")
		end
	end
	for _, e in ipairs(data.placed) do
		e.u = map[e.u] or e.u
		if e.p and map[e.p] then
			e.p = map[e.p]
		end
	end
	for old, new in pairs(map) do
		if data.shelves[old] then
			data.shelves[new] = data.shelves[old]
			data.shelves[old] = nil
		end
		if data.appliances[old] then
			data.appliances[new] = data.appliances[old]
			data.appliances[old] = nil
		end
	end
	for _, b in ipairs(data.storage) do
		if used[b.u] then
			b.u = Uid.new("b")
		end
	end
	for _, s in ipairs(data.staff) do
		if used[s.u] then
			s.u = Uid.new("s")
		end
	end
	return next(map) ~= nil
end
Plots.dedupe = dedupe

local function claim(player, data)
	if Plots.ofPlayer(player) then
		return
	end
	local plot = nil
	for _, p in ipairs(Plots.list) do
		if not p.owner then
			plot = p
			break
		end
	end
	if not plot then
		Core.S.Net.notify(player, "msg.no_plot", nil, "warning")
		return
	end
	dedupe(data)
	plot.owner = player
	plot.ownerId = player.UserId
	plot.folder:SetAttribute("OwnerId", player.UserId)
	plot.folder:SetAttribute("OwnerName", player.DisplayName)
	work[player] = plot
	Plots.Claimed:Fire(plot, player, data)
	Plots.refreshInfo()
	if not Core.S.Data.storeAvailable() then
		Core.S.Net.notify(player, "msg.no_saving", nil, "warning")
	end
	-- the owner's character goes to the door of their restaurant
	local char = player.Character
	if char then
		Plots.sendHome(player)
	end
end

function Plots.sendHome(player)
	local plot = Plots.ofPlayer(player)
	local char = player.Character
	if not plot or not char then
		return
	end
	local s = PlotsCfg.Spawn
	char:PivotTo(CFrame.new(Plots.toWorld(plot, s.x, s.y, s.z)) * CFrame.Angles(0, math.rad(180), 0))
end

-- rebuilds a restaurant from its owner's data (franchise, dev tools): everything on the plot is
-- cleared and built again
function Plots.rebuild(plot)
	local d = Plots.data(plot)
	if not d then
		return
	end
	Plots.Released:Fire(plot, plot.owner)
	Plots.Claimed:Fire(plot, plot.owner, d)
end

local function release(player)
	work[player] = nil
	local plot = Plots.ofPlayer(player)
	if not plot then
		Plots.refreshInfo()
		return
	end
	Plots.Released:Fire(plot, player)
	plot.owner = nil
	plot.ownerId = nil
	plot.folder:SetAttribute("OwnerId", 0)
	plot.folder:SetAttribute("OwnerName", "")
	-- helpers working there go back to their own restaurant
	for p, wp in pairs(work) do
		if wp == plot then
			work[p] = nil
		end
	end
	Plots.refreshInfo()
end

function Plots.Start()
	Core.S.Data.Loaded:Connect(function(player, data)
		claim(player, data)
	end)
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			task.defer(function()
				Plots.sendHome(player)
			end)
		end)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		local d = Core.S.Data.get(player)
		if d then
			claim(player, d)
		end
	end
	Players.PlayerRemoving:Connect(release)
	-- the restaurant a player works in: the one they stand in when they may work there,
	-- otherwise their own
	while true do
		task.wait(0.5)
		for _, player in ipairs(Players:GetPlayers()) do
			local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			local here = hrp and Plots.at(hrp.Position) or nil
			local want = Plots.ofPlayer(player)
			if here and here ~= want and here.owner and Plots.canWork(player, here) then
				want = here
			end
			if want then
				setWork(player, want)
			end
		end
	end
end

return Plots
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000090"><Properties><string name="Name">Progression</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Restaurant level, licenses, upgrades, ads, expansions, menu, mastery, rating and popularity.
-- Purchases apply to the restaurant the player manages (their own, or one where they co-manage);
-- rating, popularity and mastery belong to a restaurant (plot).
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Licenses = require(Shared.Config.Licenses)
local Recipes = require(Shared.Config.Recipes)
local Upgrades = require(Shared.Config.Upgrades)
local Ads = require(Shared.Config.Ads)
local Expansions = require(Shared.Config.Expansions)
local Franchise = require(Shared.Config.Franchise)
local Events = require(Shared.Config.Events)
local Staff = require(Shared.Config.Staff)
local Items = require(Shared.Config.Items)
local Formulas = require(Shared.Logic.Formulas)
local ShopLogic = require(Shared.Logic.Shop)
local Core = require(script.Parent.Parent.Core)

local Progression = {}

function Progression.rating(plot)
	local d = Core.S.Plots.data(plot)
	if not d then
		return GameConfig.Customers.DefaultRating
	end
	return Formulas.rating(d.reviews.recent, GameConfig.Customers.DefaultRating)
end

function Progression.addReview(plot, stars, weight)
	local d = Core.S.Plots.data(plot)
	if not d then
		return
	end
	table.insert(d.reviews.recent, { s = stars, w = weight or 1 })
	while #d.reviews.recent > GameConfig.Customers.RecentReviews do
		table.remove(d.reviews.recent, 1)
	end
	d.reviews.total += 1
	d.reviews.sum += stars
	if stars >= 5 then
		d.stats.five_stars = (d.stats.five_stars or 0) + 1
		Core.S.Meta.event(plot.owner, "five_stars", 1)
	end
	plot.folder:SetAttribute("Rating", Progression.rating(plot))
	Core.S.Data.changed(plot.owner, "reviews")
end

function Progression.addXp(player, amount)
	local d = Core.S.Data.get(player)
	if not d or amount <= 0 then
		return
	end
	local mult = 1 + (d.franchise.stars or 0) * Franchise.XpPerStar
	local newLevel, newXp, gained = Formulas.addXp(d.level, d.xp, math.floor(amount * mult + 0.5))
	local oldLevel = d.level
	d.level, d.xp = newLevel, newXp
	Core.S.Data.changed(player, "xp")
	if gained > 0 then
		for lvl = oldLevel + 1, newLevel do
			local yen, sakura = Formulas.levelReward(lvl)
			Core.S.Economy.add(player, yen, "level")
			if sakura > 0 then
				Core.S.Economy.addSakura(player, sakura)
			end
		end
		Core.S.Data.changed(player, "level")
		Core.S.Net.notify(player, "msg.level_up", { level = newLevel }, "level")
		Core.S.Net.fx("levelup", { level = newLevel, userId = player.UserId })
		Core.S.Meta.event(player, "level", newLevel)
		Core.S.Analytics.levelUp(player, newLevel)
	end
end

function Progression.isRecipeUnlocked(d, recipe)
	if recipe.city then
		return d.franchise.city == recipe.city and d.level >= Franchise.RegionalLevel
	end
	return recipe.license ~= nil and d.licenses[recipe.license] == true
end

-- Recipes the restaurant can currently sell (unlocked + enabled in the menu)
function Progression.menuRecipes(d)
	local out = {}
	for _, r in ipairs(Recipes.list) do
		if Progression.isRecipeUnlocked(d, r) then
			local m = d.menu[r.id]
			if not m then
				m = { on = true, price = 1 }
				d.menu[r.id] = m
			end
			if m.on then
				table.insert(out, r)
			end
		end
	end
	return out
end

function Progression.priceOf(d, recipe)
	local m = d.menu[recipe.id]
	return Formulas.dishPrice(recipe.price, d.mastery[recipe.id] or 0, m and m.price or 1)
end

function Progression.addMastery(plot, recipeId)
	local d = Core.S.Plots.data(plot)
	if not d then
		return
	end
	local before = Formulas.masteryLevel(d.mastery[recipeId] or 0)
	d.mastery[recipeId] = (d.mastery[recipeId] or 0) + 1
	local after = Formulas.masteryLevel(d.mastery[recipeId])
	if after > before then
		Core.S.Plots.notify(plot, "msg.mastery_up", { dish = "rec." .. recipeId, level = after }, "level")
		if after == #Formulas.MasteryThresholds then
			d.stats.gold_mastery = (d.stats.gold_mastery or 0) + 1
		end
		Core.S.Data.changed(plot.owner, "mastery")
	end
end

function Progression.popularity(plot)
	local d = Core.S.Plots.data(plot)
	if not d then
		return 0
	end
	local ads = 0
	for id, day in pairs(d.ads or {}) do
		local ad = Ads.byId[id]
		if ad and day == (d.stats.days or 0) + 1 then
			ads += ad.popularity
		end
	end
	local extra = 0
	for _, e in ipairs(Expansions.list) do
		if d.zones[e.id] and e.popularity then
			extra += e.popularity
		end
	end
	if d.boosts.influencer and d.boosts.influencer == (d.stats.days or 0) + 1 then
		extra += 0.25
	end
	local ev = Events.active(os.time())
	local amb = Core.S.Placement.ambienceOf(plot)
	return Formulas.popularity({
		level = d.level,
		rating = Progression.rating(plot),
		ambience = amb.popularity,
		sign = Upgrades.value(d.upgrades, "up_sign"),
		ads = ads,
		event = ev and ev.popularity or 0,
		extra = extra,
	})
end

function Progression.staffSlots(d)
	return ShopLogic.staffSlots(d, Staff, GameConfig.MaxStaff)
end

-- the restaurant the player manages right now: owner (who pays), data, plot
local function payer(player)
	local Plots = Core.S.Plots
	local plot = Plots.of(player)
	if not plot or not Plots.canBuild(player, plot) then
		Core.S.Net.notify(player, "msg.no_permission", nil, "error")
		return nil
	end
	return plot.owner, Plots.data(plot), plot
end

local function buyLicense(player, id)
	local o, d, plot = payer(player)
	local lic = Licenses.byId[id]
	if not o or not d or not lic or d.licenses[id] then
		return
	end
	local Net = Core.S.Net
	if d.level < lic.level then
		return Net.notify(player, "msg.need_level", { level = lic.level }, "error")
	end
	for _, req in ipairs(lic.requires) do
		if not d.licenses[req] then
			return Net.notify(player, "msg.need_license", nil, "error")
		end
	end
	if lic.rating > 0 and Progression.rating(plot) < lic.rating then
		return Net.notify(player, "msg.need_rating", { rating = lic.rating }, "error")
	end
	if not Core.S.Economy.spend(o, lic.cost, "build", "license:" .. lic.id) then
		return Net.notify(player, "msg.not_enough", nil, "error")
	end
	d.licenses[id] = true
	for _, rid in ipairs(lic.recipes) do
		d.menu[rid] = d.menu[rid] or { on = true, price = 1 }
	end
	Core.S.Data.changed(o, "licenses")
	Core.S.Data.changed(o, "menu")
	Core.S.Plots.notify(plot, "msg.license_bought", { name = "lic." .. id }, "success")
	-- new recipes for a kind of station you do not have yet: say which one to buy
	local needed = {}
	for _, rid in ipairs(lic.recipes) do
		local r = Recipes.byId[rid]
		if r and r.station then
			needed[r.station] = true
		end
	end
	for stationType in pairs(needed) do
		local have = false
		for _, e in ipairs(Core.S.Entities.ofKind("station", plot)) do
			if e.item and e.item.fn.station == stationType then
				have = true
			end
		end
		if not have then
			local best = nil
			for _, it in ipairs(Items.list) do
				if it.fn and it.fn.type == "station" and it.fn.station == stationType and (not best or it.price < best.price) then
					best = it
				end
			end
			if best then
				Net.notify(player, "msg.buy_station", { name = "item." .. best.id }, "info")
			end
		end
	end
	Net.fx("sparkle", { userId = player.UserId })
	Core.S.Meta.event(o, "licenses", 1)
end

local function buyUpgrade(player, id)
	local o, d, plot = payer(player)
	local up = Upgrades.byId[id]
	if not o or not d or not up then
		return
	end
	local Net = Core.S.Net
	local lvl = d.upgrades[id] or 0
	if lvl >= up.max then
		return Net.notify(player, "msg.max_level", nil, "error")
	end
	local nextLvl = lvl + 1
	if d.level < up.levels[nextLvl] then
		return Net.notify(player, "msg.need_level", { level = up.levels[nextLvl] }, "error")
	end
	if up.needsStaff then
		local has = false
		for _, s in ipairs(d.staff) do
			if s.role == up.needsStaff then
				has = true
			end
		end
		if not has then
			return Net.notify(player, "msg.need_staff", { role = "staff." .. up.needsStaff }, "error")
		end
	end
	if not Core.S.Economy.spend(o, up.costs[nextLvl], "build", "upgrade:" .. up.id) then
		return Net.notify(player, "msg.not_enough", nil, "error")
	end
	d.upgrades[id] = nextLvl
	Core.S.Data.changed(o, "upgrades")
	Core.S.Plots.notify(plot, "msg.upgrade_bought", { name = "upg." .. id, level = nextLvl }, "success")
	if id == "up_jukebox" then
		Core.S.Placement.recomputeAmbience(plot)
	elseif id == "up_shoes" then
		Progression.applyWalkSpeed(o)
	end
end

local function buyAd(player, id)
	local o, d, plot = payer(player)
	local ad = Ads.byId[id]
	if not o or not d or not ad then
		return
	end
	local Net = Core.S.Net
	if d.level < ad.lv then
		return Net.notify(player, "msg.need_level", { level = ad.lv }, "error")
	end
	local day = (d.stats.days or 0) + 1
	if d.ads[id] == day then
		return Net.notify(player, "msg.ad_active", nil, "error")
	end
	if not Core.S.Economy.spend(o, ad.cost, "other", "ad:" .. ad.id) then
		return Net.notify(player, "msg.not_enough", nil, "error")
	end
	d.ads[id] = day
	Core.S.Data.changed(o, "ads")
	Core.S.Plots.notify(plot, "msg.ad_bought", { name = "ad." .. id }, "success")
end

local function buyExpansion(player, id)
	local o, d, plot = payer(player)
	local exp = Expansions.byId[id]
	if not o or not d or not exp or d.zones[id] then
		return
	end
	local Net = Core.S.Net
	if d.level < exp.lv then
		return Net.notify(player, "msg.need_level", { level = exp.lv }, "error")
	end
	for _, req in ipairs(exp.requires) do
		if not d.zones[req] then
			return Net.notify(player, "msg.need_zone", { name = "zone." .. req }, "error")
		end
	end
	if not Core.S.Economy.spend(o, exp.cost, "build", "expansion:" .. exp.id) then
		return Net.notify(player, "msg.not_enough", nil, "error")
	end
	d.zones[id] = true
	for _, z in ipairs(exp.zones or {}) do
		if z.floorStyle or z.wallStyle then
			d.surfaces[z.id] = d.surfaces[z.id] or { floor = z.floorStyle, wall = z.wallStyle }
		end
	end
	Net.fx("construction", { zone = id, plotX = plot.origin.X })
	task.wait(1.5)
	local World, Placement = Core.S.World, Core.S.Placement
	World.rebuild(plot, d)
	local moved = Placement.revalidate(plot, d)
	Placement.spawnAll(plot, d)
	Core.S.Data.changed(o, "zones")
	Core.S.Data.changed(o, "placed")
	Core.S.Data.changed(o, "inventory")
	Core.S.Plots.notify(plot, exp.reno and "msg.reno_bought" or "msg.expansion_bought", { name = "zone." .. id }, "success")
	if moved > 0 then
		Net.notify(o, "msg.items_to_inventory", { n = moved })
	end
	Core.S.Meta.event(o, exp.reno and "renos" or "zones", 1)
end

local function setMenu(player, recipeId, on, priceMult)
	local o, d = payer(player)
	local r = Recipes.byId[recipeId]
	if not o or not d or not r or not Progression.isRecipeUnlocked(d, r) then
		return
	end
	local m = d.menu[recipeId] or { on = true, price = 1 }
	if type(on) == "boolean" then
		m.on = on
	end
	if type(priceMult) == "number" then
		m.price = math.clamp(math.floor(priceMult * 10 + 0.5) / 10, 0.7, 1.3)
	end
	d.menu[recipeId] = m
	Core.S.Data.changed(o, "menu")
end

-- a player's walking speed comes from the kitchen shoes of their own restaurant
function Progression.applyWalkSpeed(p)
	local d = p and Core.S.Data.get(p)
	if not d then
		return
	end
	local speed = GameConfig.WalkSpeed * Upgrades.value(d.upgrades, "up_shoes")
	-- the client multiplies this while running (Controllers/FirstPerson)
	p:SetAttribute("WalkSpeed", speed)
	local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = speed
	end
end

function Progression.Init()
	local Net = Core.S.Net
	Net.on("BuyLicense", buyLicense, 3)
	Net.on("BuyUpgrade", buyUpgrade, 3)
	Net.on("BuyAd", buyAd, 3)
	Net.on("BuyExpansion", buyExpansion, 2)
	Net.on("SetMenu", setMenu, 8)
end

function Progression.Start()
	Core.S.Plots.Claimed:Connect(function(plot, player)
		plot.folder:SetAttribute("Rating", Progression.rating(plot))
		Progression.applyWalkSpeed(player)
	end)
	game:GetService("Players").PlayerAdded:Connect(function(p)
		p.CharacterAdded:Connect(function()
			task.wait(0.2)
			Progression.applyWalkSpeed(p)
		end)
	end)
end

return Progression
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000091"><Properties><string name="Name">Rewards</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Roblox-style rewards: free gifts for the minutes played in this session, redeemable codes and
-- the leaderstats shown in the player list (yen and level).
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local RewardsCfg = require(Shared.Config.Rewards)
local Ingredients = require(Shared.Config.Ingredients)
local Uid = require(Shared.Util.Uid)
local Core = require(script.Parent.Parent.Core)

local Rewards = {}
local claimed = {} -- [player] = { [index] = true }

local function publishClaimed(player)
	local list = {}
	for i in pairs(claimed[player] or {}) do
		table.insert(list, tostring(i))
	end
	table.sort(list)
	player:SetAttribute("GiftsClaimed", table.concat(list, ","))
end

-- Gives a reward table { yen, sakura, boxes } to a player; returns false without data
local function grant(player, reward)
	local d = Core.S.Data.get(player)
	if not d then
		return false
	end
	if reward.yen then
		local yen = math.floor(reward.yen * (1 + (d.level or 1) * (RewardsCfg.GiftYenPerLevel or 0)) + 0.5)
		Core.S.Economy.add(player, yen, "gift")
	end
	if reward.sakura then
		Core.S.Economy.addSakura(player, reward.sakura)
	end
	if reward.boxes then
		local plot = Core.S.Plots.ofPlayer(player)
		if plot then
			for g, n in pairs(reward.boxes) do
				local ing = Ingredients.byId[g]
				if ing then
					for _ = 1, n do
						table.insert(d.storage, { u = Uid.new("b"), g = g, n = ing.units })
					end
				end
			end
			Core.S.Supply.layout(plot)
			Core.S.Data.changed(player, "storage")
		else
			Core.S.Economy.add(player, RewardsCfg.GiftBoxYen or 400, "gift")
		end
	end
	return true
end

local function claimGift(player, index)
	if type(index) ~= "number" or index % 1 ~= 0 then
		return
	end
	local gift = RewardsCfg.Gifts[index]
	if not gift then
		return
	end
	claimed[player] = claimed[player] or {}
	if claimed[player][index] then
		return
	end
	local joinedAt = player:GetAttribute("JoinedAt") or workspace:GetServerTimeNow()
	if workspace:GetServerTimeNow() - joinedAt < gift.min * 60 - 1 then
		return Core.S.Net.notify(player, "msg.gift_wait", nil, "info")
	end
	if grant(player, gift) then
		claimed[player][index] = true
		publishClaimed(player)
		Core.S.Net.fxTo(player, "sfx", { name = "gift" })
		Core.S.Net.fxTo(player, "sparkle", {})
		Core.S.Net.notify(player, "msg.gift_claimed", nil, "success")
	end
end

local function redeemCode(player, code)
	if type(code) ~= "string" or #code > 40 then
		return
	end
	code = string.upper((string.gsub(code, "%s", "")))
	local reward = RewardsCfg.Codes[code]
	if not reward then
		return Core.S.Net.notify(player, "msg.code_invalid", nil, "error")
	end
	local d = Core.S.Data.get(player)
	if not d then
		return
	end
	d.meta.codes = d.meta.codes or {}
	if d.meta.codes[code] then
		return Core.S.Net.notify(player, "msg.code_used", nil, "error")
	end
	if grant(player, reward) then
		d.meta.codes[code] = true
		Core.S.Data.changed(player, "meta")
		Core.S.Net.fxTo(player, "sfx", { name = "gift" })
		Core.S.Net.notify(player, "msg.code_ok", { code = code }, "success")
	end
end

local function leaderstats(player)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	local yen = Instance.new("IntValue")
	yen.Name = "¥"
	yen.Parent = folder
	local level = Instance.new("IntValue")
	level.Name = "⭐"
	level.Parent = folder
	folder.Parent = player
end

local function onPlayer(player)
	player:SetAttribute("JoinedAt", workspace:GetServerTimeNow())
	claimed[player] = {}
	publishClaimed(player)
	leaderstats(player)
end

-- ❤️ a visitor likes the restaurant they are in: once a day per restaurant, counts for the
-- owner's likes (shown on the restaurant and on the leaderboard)
local function like(player)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local plot = root and Core.S.Plots.at(root.Position) or nil
	local owner = plot and plot.owner
	if not owner or owner == player then
		return
	end
	local od, pd = Core.S.Data.get(owner), Core.S.Data.get(player)
	if not od or not pd then
		return
	end
	pd.meta.liked = pd.meta.liked or {}
	local key = tostring(owner.UserId)
	local today = math.floor(os.time() / 86400)
	if pd.meta.liked[key] == today then
		return Core.S.Net.notify(player, "msg.like_done", nil, "info")
	end
	pd.meta.liked[key] = today
	od.stats.likes = (od.stats.likes or 0) + 1
	plot.folder:SetAttribute("Likes", od.stats.likes)
	Core.S.Data.changed(owner, "stats")
	Core.S.Data.changed(player, "meta")
	Core.S.Net.notify(owner, "msg.liked", { name = player.DisplayName }, "success")
	Core.S.Net.notify(player, "msg.like_sent", nil, "success")
	Core.S.Net.fx("sparkle", {})
end

function Rewards.Init()
	local Net = Core.S.Net
	Net.on("ClaimGift", claimGift, 4)
	Net.on("RedeemCode", redeemCode, 2)
	Net.on("Like", like, 2)
end

function Rewards.Start()
	for _, p in ipairs(Players:GetPlayers()) do
		onPlayer(p)
	end
	Players.PlayerAdded:Connect(onPlayer)
	Core.S.Plots.Claimed:Connect(function(plot, _, d)
		plot.folder:SetAttribute("Likes", d and d.stats.likes or 0)
	end)
	Players.PlayerRemoving:Connect(function(p)
		claimed[p] = nil
	end)
	-- keep the player list numbers current
	while true do
		task.wait(2)
		for _, p in ipairs(Players:GetPlayers()) do
			local d = Core.S.Data.get(p)
			local ls = p:FindFirstChild("leaderstats")
			if d and ls then
				ls["¥"].Value = math.floor(d.yen or 0)
				ls["⭐"].Value = d.level or 1
			end
		end
	end
end

return Rewards
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000092"><Properties><string name="Name">Seating</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Works out which seats of each restaurant are usable (stool in front of a counter, chair next to
-- a table, booths), where the dish goes, and keeps reservations / dirty dishes per seat.
-- Per plot: plot.seats (list), plot.seatById, plot.benches. Seat positions are in world space.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Items = require(Shared.Config.Items)
local GameConfig = require(Shared.Config.GameConfig)
local Footprint = require(Shared.Logic.Footprint)
local Core = require(script.Parent.Parent.Core)

local Seating = {}

local SURFACES = { counter = true, table = true }
local PAIR_DISTANCE = 1.6 -- max gap between seat edge and surface edge

local function topY(entry)
	local item = Items.byId[entry.i]
	return Core.S.World.floorY(entry.f) + item.size[2]
end

-- closest point of an oriented footprint to (x, z)
local function closestPoint(fp, x, z)
	local ax, az = Footprint.axes(fp)
	local dx, dz = x - fp.x, z - fp.z
	local lx = math.clamp(dx * ax.x + dz * ax.z, -fp.w / 2 + 0.6, fp.w / 2 - 0.6)
	local lz = math.clamp(dx * az.x + dz * az.z, -fp.d / 2 + 0.6, fp.d / 2 - 0.6)
	return fp.x + ax.x * lx + az.x * lz, fp.z + ax.z * lx + az.z * lz
end

local function gap(fpA, fpB)
	if Footprint.overlaps(fpA, fpB, 0) then
		return 0
	end
	local best = math.huge
	for _, c in ipairs(Footprint.corners(fpA)) do
		local px, pz = closestPoint(Footprint.inflate(fpB, 0.6), c.x, c.z)
		best = math.min(best, math.sqrt((px - c.x) ^ 2 + (pz - c.z) ^ 2))
	end
	local cx, cz = closestPoint(Footprint.inflate(fpB, 0.6), fpA.x, fpA.z)
	best = math.min(best, math.sqrt((cx - fpA.x) ^ 2 + (cz - fpA.z) ^ 2) - math.max(fpA.w, fpA.d) / 2)
	return math.max(0, best)
end

-- the seats of a restaurant
function Seating.list(plot)
	return (plot and plot.seats) or {}
end

function Seating.refresh(plot)
	local d = Core.S.Plots.data(plot)
	if not d then
		return
	end
	local o = plot.origin
	local old = plot.seatById or {}
	local seats, newById = {}, {}
	local benches = {}
	local surfaces = {}
	for _, e in ipairs(d.placed) do
		local item = Items.byId[e.i]
		if item and item.fn and SURFACES[item.fn.type] and e.s == "f" then
			table.insert(surfaces, { entry = e, item = item, fp = Footprint.new(e.x, e.z, item.size[1], item.size[3], e.r) })
		end
	end
	local function add(rec)
		-- keep the same record object so customers holding a reference stay in sync
		local prev = old[rec.id]
		if prev then
			for k, v in pairs(rec) do
				prev[k] = v
			end
			rec = prev
		end
		table.insert(seats, rec)
		newById[rec.id] = rec
	end
	for _, e in ipairs(d.placed) do
		local item = Items.byId[e.i]
		local ent = Core.S.Entities.get(e.u)
		if item and item.fn and ent and ent.model and e.s == "f" then
			local zone = Core.S.World.zoneAt(plot, e.x, e.z, e.f)
			local area = zone and zone.area or "dining"
			if item.fn.type == "seat" then
				local fp = Footprint.new(e.x, e.z, item.size[1], item.size[3], e.r)
				local best, bestGap = nil, PAIR_DISTANCE
				for _, s in ipairs(surfaces) do
					if (s.entry.f or 0) == (e.f or 0) then
						local g = gap(fp, s.fp)
						if g <= bestGap then
							best, bestGap = s, g
						end
					end
				end
				if best then
					local px, pz = closestPoint(best.fp, e.x, e.z)
					-- move the dish spot from the edge onto the top, towards the middle of the surface
					local cx, cz = best.entry.x, best.entry.z
					local dx, dz = cx - px, cz - pz
					local len = math.sqrt(dx * dx + dz * dz)
					local inset = math.min(GameConfig.DishInset or 0.8, len)
					if len > 0.001 then
						px, pz = px + dx / len * inset, pz + dz / len * inset
					end
					local dish = Vector3.new(px + o.X, topY(best.entry) + 0.05, pz + o.Z)
					local sitY = Core.S.World.floorY(e.f) + item.fn.height
					local seatPos = Vector3.new(e.x + o.X, sitY, e.z + o.Z)
					local look = Vector3.new(px + o.X, sitY, pz + o.Z)
					local sitCf
					if item.fn.symmetric then
						sitCf = CFrame.lookAt(seatPos, look)
					else
						sitCf = CFrame.new(seatPos) * CFrame.Angles(0, math.rad(e.r), 0)
					end
					add({
						id = e.u, itemUid = e.u, surface = best.entry.u, group = best.item.fn.type == "table" and best.entry.u or nil,
						sit = sitCf, dish = dish, floor = e.f or 0, area = area, comfort = item.fn.comfort or 0,
						vip = area == "tatami", counter = best.item.fn.type == "counter",
					})
				end
			elseif item.fn.type == "booth" then
				local root = ent.model.PrimaryPart
				for k = 1, item.fn.seats do
					local seatAtt = root:FindFirstChild("Seat" .. k)
					local dishAtt = root:FindFirstChild("Dish" .. k)
					if seatAtt and dishAtt then
						add({
							id = e.u .. "#" .. k, itemUid = e.u, surface = e.u, group = e.u,
							sit = seatAtt.WorldCFrame, dish = dishAtt.WorldPosition, floor = e.f or 0, area = area,
							comfort = item.fn.comfort or 0, vip = item.fn.vip == true or area == "tatami", counter = false,
						})
					end
				end
			elseif item.fn.type == "bench" then
				local root = ent.model.PrimaryPart
				for k = 1, item.fn.queue do
					local att = root:FindFirstChild("Queue" .. k)
					if att then
						table.insert(benches, { id = e.u .. "#q" .. k, sit = att.WorldCFrame, taken = nil })
					end
				end
			end
		end
	end
	plot.seats = seats
	plot.seatById = newById
	plot.benches = benches
	plot.folder:SetAttribute("Seats", #seats)
end

function Seating.get(plot, id)
	return plot.seatById and plot.seatById[id] or nil
end

local function free(s)
	return not s.occupant and not s.reserved and not s.dirty
end

function Seating.freeCount(plot)
	local n = 0
	for _, s in ipairs(Seating.list(plot)) do
		if free(s) then
			n += 1
		end
	end
	return n
end

-- Finds seats for a group. needsTable: only table/booth groups. vip: tatami seats only.
function Seating.find(plot, size, needsTable, vip)
	local candidates = {}
	for _, s in ipairs(Seating.list(plot)) do
		if free(s) and ((vip and s.vip) or (not vip and not s.vip)) then
			table.insert(candidates, s)
		end
	end
	if size == 1 and not needsTable then
		-- singles prefer the counter
		table.sort(candidates, function(a, b)
			if a.counter ~= b.counter then
				return a.counter
			end
			return a.id < b.id
		end)
		return candidates[1] and { candidates[1] } or nil
	end
	local groups = {}
	for _, s in ipairs(candidates) do
		if s.group then
			groups[s.group] = groups[s.group] or {}
			table.insert(groups[s.group], s)
		end
	end
	for _, list in pairs(groups) do
		if #list >= size then
			local out = {}
			for i = 1, size do
				out[i] = list[i]
			end
			return out
		end
	end
	return nil
end

function Seating.reserve(list, who)
	for _, s in ipairs(list) do
		s.reserved = who
	end
end

function Seating.release(s)
	if s then
		s.reserved = nil
		s.occupant = nil
	end
end

function Seating.benchSpot(plot, who)
	for _, b in ipairs(plot.benches or {}) do
		if not b.taken then
			b.taken = who
			return b
		end
	end
	return nil
end

function Seating.freeBench(b)
	if b then
		b.taken = nil
	end
end

function Seating.queueCapacity(plot)
	return #(plot.benches or {})
end

-- Veto: occupied seats and surfaces with diners cannot be moved
local function busy(plot, uid)
	for _, s in ipairs(Seating.list(plot)) do
		if (s.itemUid == uid or s.surface == uid) and (s.occupant or s.reserved or s.dirty) then
			return true
		end
	end
	return false
end

function Seating.Init()
	local Placement = Core.S.Placement
	Placement.LayoutChanged:Connect(function(plot)
		task.defer(Seating.refresh, plot)
	end)
	Placement.addVeto(function(e)
		if busy(e.plot, e.uid) then
			return false, "msg.seat_busy"
		end
		return true
	end)
end

function Seating.Start()
	Core.S.Plots.Released:Connect(function(plot)
		plot.seats, plot.seatById, plot.benches = nil, nil, nil
	end)
end

return Seating
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000093"><Properties><string name="Name">SelfTest</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- End-to-end self test of the core loop, started from the dev panel. It drives the real services
-- with an invisible worker: restock, broth, cook a shoyu ramen, serve a customer, get paid, wash.
-- Results go to the Output window and to a toast.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Ingredients = require(Shared.Config.Ingredients)
local Expansions = require(Shared.Config.Expansions)
local Registry = require(Shared.Models.Registry)
local PlacementLogic = require(Shared.Logic.Placement)
local Uid = require(Shared.Util.Uid)
local Core = require(script.Parent.Parent.Core)

local SelfTest = {}
local running = false

local function waitFor(fn, timeout)
	local t0 = os.clock()
	while os.clock() - t0 < timeout do
		local v = fn()
		if v then
			return v
		end
		task.wait(0.25)
	end
	return nil
end

function SelfTest.run(player)
	if running then
		return
	end
	running = true
	local S = Core.S
	-- the test plays in the restaurant of the player who started it
	local plot = S.Plots.ofPlayer(player)
	local d = S.Plots.data(plot)
	if not d then
		running = false
		return 0, 0
	end
	local actor = { uid = "selftest", alive = true, model = nil, plot = plot }
	local results = {}

	local function check(name, fn)
		local ok, err = pcall(fn)
		table.insert(results, { name = name, ok = ok, err = err })
		if ok then
			print("[SelfTest] PASS " .. name)
		else
			warn("[SelfTest] FAIL " .. name .. ": " .. tostring(err))
		end
		S.Hands.clear(actor)
		return ok
	end

	local function ensureBox(g)
		local entry = S.Supply.findBox(plot, g)
		if not entry then
			table.insert(d.storage, { u = Uid.new("b"), g = g, n = Ingredients.byId[g].units })
			S.Supply.layout(plot)
		end
		local e, ent = S.Supply.findBox(plot, g)
		assert(e and ent, "no box entity for " .. g)
		return e, ent
	end

	local function returnLeftover()
		local h = S.Hands.get(actor)
		if h.kind == "box" then
			for _, b in ipairs(h.items) do
				S.Supply.returnBox(plot, b)
			end
		end
		S.Hands.clear(actor)
	end

	local function firstOf(kind, filter)
		for _, e in ipairs(S.Entities.ofKind(kind, plot)) do
			if not filter or filter(e) then
				return e
			end
		end
		return nil
	end

	check("world and starter objects", function()
		assert(#S.World.geo(plot).zones > 0, "no zones")
		assert(firstOf("shelf"), "no shelf")
		assert(firstOf("station", function(e)
			return e.item.fn.station == "sushi"
		end), "no sushi station")
		assert(firstOf("ricecooker"), "no rice cooker")
		assert(firstOf("sink"), "no sink")
		assert(firstOf("rack"), "no storage rack")
	end)

	check("seats around the counter", function()
		S.Seating.refresh(plot)
		assert(#S.Seating.list(plot) >= 6, "only " .. #S.Seating.list(plot) .. " seats")
	end)

	check("restock a shelf", function()
		-- three noodles are used, then a box of noodles fills the free spots of that slot only
		local _, ent = ensureBox("noodles")
		for _ = 1, 3 do
			assert(S.Supply.takeIngredient(plot, "noodles"), "no noodles on the shelves")
		end
		local shelf = S.Supply.findShelfWith(plot, "noodles")
		assert(shelf, "no shelf with noodles")
		local before = S.Supply.shelfStock(plot, "noodles")
		assert(S.Supply.takeBox(actor, ent), "could not take the box")
		local ok, msg = S.Supply.useShelf(actor, shelf, nil)
		assert(ok, "useShelf: " .. tostring(msg))
		returnLeftover()
		local after = S.Supply.shelfStock(plot, "noodles")
		assert(after == before + 3, "the slot got " .. (after - before) .. " noodles instead of 3")
	end)

	check("pour the shoyu broth", function()
		local pot = firstOf("pot")
		assert(pot, "no broth pot")
		if not S.Appliance.hasBroth(plot, "broth_shoyu") then
			local _, ent = ensureBox("broth_shoyu")
			assert(S.Supply.takeBox(actor, ent), "could not take the broth box")
			local ok, msg = S.Appliance.load(actor, pot)
			assert(ok or msg == "msg.cooking_wait", "load: " .. tostring(msg))
			returnLeftover()
			local st = d.appliances[pot.uid]
			if st and st.c > 0 then
				st.t = workspace:GetServerTimeNow() - 1 -- fast-forward
			end
			assert(waitFor(function()
				return S.Appliance.hasBroth(plot, "broth_shoyu")
			end, 5), "the broth never got ready")
		end
	end)

	check("a customer comes in and orders by themselves", function()
		local known = {}
		for uid in pairs(S.Customers.active) do
			known[uid] = true
		end
		assert(S.Customers.trySpawn(plot, "cust_student"), "no customer could be spawned (seats? menu?)")
		local c = waitFor(function()
			for uid, cust in pairs(S.Customers.active) do
				if not known[uid] and cust.plot == plot and cust.state == "waiting" and cust.ticket then
					return cust
				end
			end
			return nil
		end, 75)
		assert(c, "the customer never ordered")
		actor.customer = c
	end)

	check("the station cooks the order, one press per step", function()
		local c = actor.customer
		assert(c, "no customer from the previous step")
		local Recipes = require(Shared.Config.Recipes)
		local recipe = Recipes.byId[c.order]
		local stationEntity = firstOf("station", function(e)
			local st = S.Cooking.stationState(e)
			if e.item.fn.station ~= recipe.station or st.busy or st.ready or #st.board > 0 then
				return false
			end
			local _, r = S.Cooking.nextOrder(e)
			return r ~= nil and r.id == recipe.id
		end)
		assert(stationEntity, "no free " .. recipe.station .. " station for " .. recipe.id)
		local presses = 0
		while not S.Cooking.stationState(stationEntity).ready and presses < 8 do
			local ok, msg = S.Cooking.use(actor, stationEntity, 4)
			assert(ok, "press " .. (presses + 1) .. ": " .. tostring(msg))
			presses += 1
		end
		assert(S.Cooking.stationState(stationEntity).ready, "dish not ready after " .. presses .. " presses")
		assert(presses == #recipe.steps, recipe.id .. " took " .. presses .. " presses, expected " .. #recipe.steps)
		assert(S.Cooking.use(actor, stationEntity, 4), "could not take the dish")
		assert(S.Hands.get(actor).kind == "dish", "no dish in hand")
		actor.keepDish = S.Hands.get(actor).items[1]
	end)

	check("the customer is served and pays", function()
		local c = actor.customer
		assert(c and actor.keepDish, "no customer or no dish from the previous steps")
		S.Hands.set(actor, "dish", { actor.keepDish }, plot)
		local before = d.yen
		local e = S.Entities.get(c.uid)
		local ok, msg = S.Customers.use(actor, e)
		assert(ok, "serve: " .. tostring(msg))
		assert(waitFor(function()
			return d.yen > before
		end, 40), "the customer did not pay")
	end)

	check("collect the dirty dish and wash it", function()
		local dirty = waitFor(function()
			return firstOf("dirty")
		end, 30)
		assert(dirty, "no dirty dish appeared")
		local ok, msg = S.Customers.collectDirty(actor, dirty)
		assert(ok, "collect: " .. tostring(msg))
		local sink = firstOf("sink")
		local okWash, washMsg = S.Appliance.useSink(actor, sink, 4)
		assert(okWash, "wash: " .. tostring(washMsg))
	end)

	check("plain and renovated models", function()
		local plain = Registry.build("counter_straight", { styles = {} })
		local full = Registry.build("counter_straight", { styles = Expansions.allStyles() })
		assert(not plain:FindFirstChild("Detail_counter"), "the plain counter has renovation details")
		assert(full:FindFirstChild("Detail_counter"), "the renovated counter misses its details")
		assert(#full:GetDescendants() > #plain:GetDescendants(), "the renovated counter is not more detailed")
		-- the condiment tray of the tableware renovation sits on the corner modules
		local corner = Registry.build("counter_corner", { styles = Expansions.allStyles() })
		assert(corner:FindFirstChild("Detail_tableware"), "the renovated corner misses its condiments")
		plain:Destroy()
		full:Destroy()
		corner:Destroy()
		for _, e in ipairs(Expansions.list) do
			if e.reno then
				assert(e.cosmetic and not e.zones, e.id .. " must be cosmetic")
			end
		end
	end)

	check("every dish and ingredient model builds", function()
		local Recipes = require(Shared.Config.Recipes)
		local bad = {}
		for _, r in ipairs(Recipes.list) do
			local ok, m = pcall(Registry.food, "dish", r.id)
			if not ok or not m or not m.PrimaryPart or #m:GetChildren() < 4 then
				table.insert(bad, r.id)
			end
			if ok and m then
				m:Destroy()
			end
		end
		for _, ing in ipairs(Ingredients.list) do
			local ok, m = pcall(Registry.food, "ingredient", ing.id)
			if not ok or not m or not m.PrimaryPart then
				table.insert(bad, ing.id)
			end
			if ok and m then
				m:Destroy()
			end
		end
		assert(#bad == 0, "broken food models: " .. table.concat(bad, ", "))
	end)

	check("detailed customers and staff", function()
		local Npc = S.Npc
		local made = {
			Npc.create({ look = "tourist" }),
			Npc.create({ look = "casual", child = true }),
			Npc.create({ look = "casual", staff = "staff_sushi_chef" }),
		}
		for i, npc in ipairs(made) do
			assert(npc and npc.model, "npc " .. i .. " was not created")
			local parts = 0
			for _, d in ipairs(npc.model:GetDescendants()) do
				if d:IsA("BasePart") then
					parts += 1
				end
			end
			assert(parts > 35, "npc " .. i .. " has only " .. parts .. " parts")
			assert(npc.model:FindFirstChild("Face"), "npc " .. i .. " has no face")
		end
		Registry.People.setMood(made[1].model, "angry")
		assert(made[1].model:GetAttribute("Mood") == "angry", "mood did not change")
		for _, npc in ipairs(made) do
			npc.model:Destroy()
		end
	end)

	check("placement rules", function()
		local ctx = S.World.ctx(plot, d.placed)
		local ok, reason = PlacementLogic.validate(ctx, { i = "bamboo_pot", x = 12, z = 4, r = 0, f = 0, s = "f" })
		assert(ok, "valid spot refused: " .. tostring(reason))
		ok = PlacementLogic.validate(ctx, { i = "stool_wood", x = 0, z = 47, r = 0, f = 0, s = "f" })
		assert(not ok, "stool in the kitchen accepted")
	end)

	S.Hands.forget(actor)
	local passed, failed = 0, {}
	for _, r in ipairs(results) do
		if r.ok then
			passed += 1
		else
			table.insert(failed, r.name)
		end
	end
	print(string.format("[SelfTest] %d/%d passed", passed, #results))
	S.Net.notify(player, "msg.selftest_result", { passed = passed, total = #results, failed = #failed > 0 and table.concat(failed, ", ") or "—" }, #failed == 0 and "success" or "error")
	running = false
	return passed, #results
end

return SelfTest
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000094"><Properties><string name="Name">Staff</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Staff: hiring, training, salaries and the AI that automates each restaurant (every actor
-- works for one plot: a.plot).
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local StaffCfg = require(Shared.Config.Staff)
local Formulas = require(Shared.Logic.Formulas)
local Uid = require(Shared.Util.Uid)
local Core = require(script.Parent.Parent.Core)

local Staff = {}
local actors = {} -- [uid] = actor

-- where idle staff wait (restaurant-local coordinates)
local HOME = { Vector3.new(10, 0.5, 21), Vector3.new(-14, 0.5, 21), Vector3.new(4, 0.5, 23), Vector3.new(-2, 0.5, 21) }

local function homeOf(a)
	local h = HOME[(a.index % #HOME) + 1]
	return Core.S.Plots.toWorld(a.plot, h.X, h.Y, h.Z)
end

local function managerBonus(plot)
	for _, a in pairs(actors) do
		if a.plot == plot and a.role == "staff_manager" then
			return GameConfig.ManagerSpeedBonus
		end
	end
	return 0
end

local function speed(a)
	return Formulas.staffSpeed(a.lvl, GameConfig.StaffSpeedPerLevel, managerBonus(a.plot))
end

local function walk(a, pos)
	if not a.alive then
		return false
	end
	a.npc.humanoid.WalkSpeed = GameConfig.StaffWalkSpeed * speed(a)
	return Core.S.Npc.walkTo(a.npc, pos, { staff = true })
end

local function idleAt(a)
	local home = homeOf(a)
	if a.npc.root and (a.npc.root.Position - home).Magnitude > 4 then
		walk(a, home)
	end
	task.wait(1)
end

local function dropHands(a)
	local Hands = Core.S.Hands
	local h = Hands.get(a)
	if h.kind == "box" then
		for _, b in ipairs(h.items) do
			Core.S.Supply.returnBox(a.plot, b)
		end
	elseif h.kind == "dish" or h.kind == "dirty" then
		Core.S.Appliance.addDirtyToSink(a.plot, #h.items)
	end
	Hands.clear(a)
end

local Tasks

local function customerEntity(c)
	return Core.S.Entities.get(c.uid)
end

------------------------------------------------------------------ jobs

local function doOrder(a)
	local c = Tasks.findOrder(a.plot)
	if not c or not Tasks.claim(c, a) then
		return false
	end
	walk(a, Tasks.nearCustomer(c))
	local e = customerEntity(c)
	if e and c.state == "order" then
		Core.S.Customers.use(a, e)
	end
	Tasks.release(c, a)
	return true
end

local function deliverDish(a, recipeId)
	-- find a waiting customer for the dish in hand
	for _, c in ipairs(Core.S.Customers.list(a.plot, "waiting")) do
		if c.order == recipeId and Tasks.claim(c, a) then
			walk(a, Tasks.nearCustomer(c))
			local e = customerEntity(c)
			local ok = false
			if e and c.state == "waiting" then
				ok = Core.S.Customers.use(a, e)
			end
			Tasks.release(c, a)
			if ok then
				return true
			end
		end
	end
	return false
end

local function doServe(a)
	local station, c = Tasks.findServe(a.plot)
	if not station then
		return false
	end
	local st = Core.S.Cooking.stationState(station)
	if not Tasks.claim(st, a) then
		return false
	end
	Tasks.claim(c, a)
	walk(a, Tasks.frontOf(station))
	local ok = Core.S.Cooking.use(a, station, speed(a))
	Tasks.release(st, a)
	Tasks.release(c, a)
	if not ok then
		return true
	end
	local h = Core.S.Hands.get(a)
	local recipe = h.items[1] and h.items[1].recipe
	if recipe and not deliverDish(a, recipe) then
		dropHands(a)
	end
	return true
end

local function nearestOf(plot, kind, pos)
	local best, bestD = nil, math.huge
	for _, e in ipairs(Core.S.Entities.ofKind(kind, plot)) do
		local p = Core.S.Entities.position(e)
		local dd = (p - pos).Magnitude
		if dd < bestD then
			best, bestD = e, dd
		end
	end
	return best
end

local function washHeld(a)
	local Appliance = Core.S.Appliance
	local pos = a.npc.root and a.npc.root.Position or Vector3.new()
	local washer = nearestOf(a.plot, "dishwasher", pos)
	if washer then
		walk(a, Tasks.frontOf(washer))
		Appliance.useDishwasher(a, washer)
		return
	end
	local hasDishwasherStaff = false
	for _, other in pairs(actors) do
		if other.plot == a.plot and other.role == "staff_dishwasher" and other ~= a then
			hasDishwasherStaff = true
		end
	end
	local sink = nearestOf(a.plot, "sink", pos)
	if not sink then
		return dropHands(a)
	end
	walk(a, Tasks.frontOf(sink))
	if hasDishwasherStaff and a.role ~= "staff_dishwasher" then
		local n = Core.S.Hands.count(a)
		Core.S.Hands.clear(a)
		Appliance.addDirtyToSink(a.plot, n)
	else
		Appliance.useSink(a, sink, speed(a))
	end
end

local function doCollect(a)
	local e = Tasks.findDirty(a.plot)
	if not e or not Tasks.claim(e, a) then
		return false
	end
	walk(a, Core.S.Entities.position(e))
	if Core.S.Entities.get(e.uid) then
		Core.S.Customers.collectDirty(a, e)
	end
	Tasks.release(e, a)
	-- grab more while there is room, then wash
	local Hands = Core.S.Hands
	while Hands.count(a) < Hands.capacity(a, "dirty") do
		local nxt = Tasks.findDirty(a.plot)
		if not nxt or not Tasks.claim(nxt, a) then
			break
		end
		walk(a, Core.S.Entities.position(nxt))
		if Core.S.Entities.get(nxt.uid) then
			Core.S.Customers.collectDirty(a, nxt)
		end
		Tasks.release(nxt, a)
	end
	if Hands.get(a).kind == "dirty" then
		washHeld(a)
	end
	return true
end

local function doWash(a)
	local Appliance = Core.S.Appliance
	if Appliance.sinkPile(a.plot) <= 0 or #Core.S.Entities.ofKind("dishwasher", a.plot) > 0 then
		return false
	end
	local sink = nearestOf(a.plot, "sink", a.npc.root.Position)
	if not sink or not Tasks.claim(sink, a) then
		return false
	end
	walk(a, Tasks.frontOf(sink))
	Appliance.useSink(a, sink, speed(a))
	Tasks.release(sink, a)
	return true
end

local function carryBoxTo(a, box, targetEntity, useFn)
	local Supply = Core.S.Supply
	if not Tasks.claim(box, a) then
		return false
	end
	local _, boxEntity = Supply.findBox(a.plot, box.g)
	local boxModel = boxEntity and boxEntity.model
	if boxModel then
		walk(a, boxModel:GetPivot().Position)
	end
	local ent = Core.S.Entities.get(box.u)
	if not ent or box.h then
		Tasks.release(box, a)
		return false
	end
	Supply.takeBox(a, ent)
	Tasks.release(box, a)
	walk(a, Tasks.frontOf(targetEntity))
	useFn()
	-- leftover portions go back to the storage room
	local h = Core.S.Hands.get(a)
	if h.kind == "box" then
		dropHands(a)
	end
	return true
end

local function doRestock(a)
	local box, g = Tasks.findRestock(a.plot)
	if not box then
		return false
	end
	local Ingredients = require(Shared.Config.Ingredients)
	local ing = Ingredients.byId[g]
	-- target shelf: neta case for fish when available
	local target = nil
	for _, e in ipairs(Core.S.Entities.ofKind("shelf", a.plot)) do
		if ing.storage == "fish" and e.item.fn.fishOnly then
			target = e
			break
		end
	end
	if not target then
		for _, e in ipairs(Core.S.Entities.ofKind("shelf", a.plot)) do
			if not e.item.fn.fishOnly then
				target = e
				break
			end
		end
	end
	if not target then
		return false
	end
	return carryBoxTo(a, box, target, function()
		-- one slot per click: keep going while the box has products and the shelf has room
		for _ = 1, 4 do
			local h = Core.S.Hands.get(a)
			if h.kind ~= "box" or not Core.S.Supply.useShelf(a, target, nil) then
				break
			end
		end
	end)
end

local function doRefill(a, kinds)
	local e, box = Tasks.findRefill(a.plot, kinds)
	if not e or not Tasks.claim(e, a) then
		return false
	end
	local ok = carryBoxTo(a, box, e, function()
		Core.S.Appliance.load(a, e)
	end)
	Tasks.release(e, a)
	return ok
end

local function doCook(a)
	local t, recipe, station = Tasks.findCook(a.plot, a.cfg.stations or {})
	if not t then
		return false
	end
	local st = Core.S.Cooking.stationState(station)
	if not Tasks.claim(st, a) then
		return false
	end
	t.claimed = a
	-- at the station: the first press fetches the ingredients from the shelves, then one press
	-- per step until the dish is on its plate
	walk(a, Tasks.frontOf(station))
	local ok = Core.S.Cooking.use(a, station, speed(a))
	local guard = 0
	while ok and not st.ready and guard < 8 do
		guard += 1
		ok = Core.S.Cooking.use(a, station, speed(a))
	end
	Tasks.release(st, a)
	local readyNow = st.ready
	if not readyNow then
		t.claimed = nil
		return ok
	end
	-- serve it ourselves when there are no waiters
	local hasWaiter = false
	for _, other in pairs(actors) do
		if other.plot == a.plot and other.role == "staff_waiter" then
			hasWaiter = true
		end
	end
	if not hasWaiter then
		Core.S.Cooking.use(a, station, speed(a))
		local h = Core.S.Hands.get(a)
		if h.kind == "dish" then
			if not deliverDish(a, h.items[1].recipe) then
				dropHands(a)
			end
		end
	end
	return true
end

local JOBS = {
	order = doOrder,
	serve = doServe,
	collect = doCollect,
	wash = doWash,
	restock = doRestock,
	cook = doCook,
}

local function think(a)
	local priorities = {
		staff_waiter = { "serve", "order", "collect", "wash" },
		staff_dishwasher = { "wash", "collect" },
		staff_stocker = { "appliance", "restock" },
		staff_sushi_chef = { "cook", "appliance_rice" },
		staff_ramen_chef = { "cook", "appliance_pot" },
		staff_line_cook = { "cook" },
		staff_manager = {},
	}
	for _, job in ipairs(priorities[a.role] or {}) do
		local done = false
		if job == "appliance" then
			done = doRefill(a, { "ricecooker", "pot" })
		elseif job == "appliance_rice" then
			done = doRefill(a, { "ricecooker" })
		elseif job == "appliance_pot" then
			done = doRefill(a, { "pot" })
		elseif JOBS[job] then
			done = JOBS[job](a)
		end
		if done then
			return true
		end
	end
	return false
end

------------------------------------------------------------------ actors

local function spawnActor(plot, record, index)
	local cfg = StaffCfg.byId[record.role]
	if not cfg then
		return
	end
	-- the uniform (chef jacket, happi coat, rubber apron...) comes from People.staff by role
	local npc = Core.S.Npc.create({ look = "casual", shirt = cfg.shirt, staff = record.role, speed = GameConfig.StaffWalkSpeed })
	if not npc then
		return
	end
	npc.isStaff = true
	local a = { uid = record.u, role = record.role, cfg = cfg, lvl = record.lvl or 1, name = record.name, npc = npc, model = npc.model, alive = true, index = index, record = record, plot = plot }
	actors[record.u] = a
	npc.model:SetAttribute("StaffName", record.name)
	npc.model:SetAttribute("StaffRole", record.role)
	npc.model:SetAttribute("StaffLevel", a.lvl)
	npc.model:SetAttribute("PlotId", plot.id)
	Core.S.Npc.spawn(npc, CFrame.new(homeOf(a) + Vector3.new(0, 3, 0)))
	task.spawn(function()
		while a.alive do
			-- the restaurant is always open: staff always work
			local ok, did = pcall(function()
				return think(a)
			end)
			if not ok then
				warn("[Staff] " .. tostring(did))
				pcall(dropHands, a)
				task.wait(2)
			elseif not did then
				idleAt(a)
			else
				task.wait(0.2)
			end
		end
	end)
	return a
end

local function despawnActor(uid)
	local a = actors[uid]
	if not a then
		return
	end
	a.alive = false
	pcall(dropHands, a)
	Core.S.Hands.forget(a)
	Core.S.Npc.destroy(a.npc)
	actors[uid] = nil
end

local function despawnPlot(plot)
	for uid, a in pairs(actors) do
		if a.plot == plot then
			despawnActor(uid)
		end
	end
end

function Staff.spawnAll(plot, d)
	despawnPlot(plot)
	for i, rec in ipairs(d.staff) do
		spawnActor(plot, rec, i)
	end
end

-- the restaurant a player manages right now (hiring, training, firing)
local function managed(player)
	local Plots = Core.S.Plots
	local plot = Plots.of(player)
	if plot and Plots.canBuild(player, plot) then
		return plot, Plots.data(plot)
	end
	return nil
end

local function hire(player, role)
	local Net, Economy = Core.S.Net, Core.S.Economy
	local plot, d = managed(player)
	if not plot then
		return Net.notify(player, "msg.no_permission", nil, "error")
	end
	local cfg = StaffCfg.byId[role]
	if not d or not cfg then
		return
	end
	if d.level < cfg.lv then
		return Net.notify(player, "msg.need_level", { level = cfg.lv }, "error")
	end
	if #d.staff >= Core.S.Progression.staffSlots(d) then
		return Net.notify(player, "msg.staff_full", nil, "error")
	end
	if cfg.manager then
		for _, s in ipairs(d.staff) do
			if s.role == role then
				return Net.notify(player, "msg.staff_one_manager", nil, "error")
			end
		end
	end
	if not Economy.spend(plot.owner, cfg.hire, "build", "staff:" .. cfg.id) then
		return Net.notify(player, "msg.not_enough", nil, "error")
	end
	local rec = { u = Uid.new("s"), role = role, lvl = 1, name = StaffCfg.Names[math.random(1, #StaffCfg.Names)] }
	table.insert(d.staff, rec)
	spawnActor(plot, rec, #d.staff)
	Core.S.Data.changed(plot.owner, "staff")
	Core.S.Plots.notify(plot, "msg.staff_hired", { name = rec.name, role = "staff." .. role }, "success")
	Core.S.Meta.event(plot.owner, "staff", 1)
end

local function train(player, uid)
	local Net, Economy = Core.S.Net, Core.S.Economy
	local plot, d = managed(player)
	if not plot then
		return
	end
	for _, rec in ipairs(d.staff) do
		if rec.u == uid then
			if rec.lvl >= StaffCfg.MaxTrainLevel then
				return Net.notify(player, "msg.max_level", nil, "error")
			end
			local cfg = StaffCfg.byId[rec.role]
			local cost = Formulas.staffTrainCost(cfg.hire, rec.lvl + 1)
			if not Economy.spend(plot.owner, cost, "build", "train") then
				return Net.notify(player, "msg.not_enough", nil, "error")
			end
			rec.lvl += 1
			local a = actors[uid]
			if a then
				a.lvl = rec.lvl
				a.model:SetAttribute("StaffLevel", rec.lvl)
			end
			Core.S.Data.changed(plot.owner, "staff")
			return Net.notify(player, "msg.staff_trained", { name = rec.name, level = rec.lvl }, "success")
		end
	end
end

local function fire(player, uid)
	local plot, d = managed(player)
	if not plot then
		return
	end
	for i, rec in ipairs(d.staff) do
		if rec.u == uid then
			table.remove(d.staff, i)
			despawnActor(uid)
			Core.S.Data.changed(plot.owner, "staff")
			return
		end
	end
end

function Staff.Init()
	Tasks = Core.S.Tasks
	local Net = Core.S.Net
	Net.on("HireStaff", function(player, role)
		if type(role) == "string" then
			hire(player, role)
		end
	end, 2)
	Net.on("TrainStaff", function(player, uid)
		if type(uid) == "string" then
			train(player, uid)
		end
	end, 3)
	Net.on("FireStaff", function(player, uid)
		if type(uid) == "string" then
			fire(player, uid)
		end
	end, 3)
end

function Staff.Start()
	local Plots = Core.S.Plots
	Plots.Claimed:Connect(function(plot, _, d)
		task.delay(2, function()
			if plot.owner and Plots.data(plot) == d then
				Staff.spawnAll(plot, d)
			end
		end)
	end)
	Plots.Released:Connect(despawnPlot)
end

return Staff
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000095"><Properties><string name="Name">Supply</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Supplier orders, the delivery truck, boxes in the storage room and shelf slots.
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Ingredients = require(Shared.Config.Ingredients)
local Recipes = require(Shared.Config.Recipes)
local Upgrades = require(Shared.Config.Upgrades)
local Items = require(Shared.Config.Items)
local Expansions = require(Shared.Config.Expansions)
local Footprint = require(Shared.Logic.Footprint)
local ShelfGrid = require(Shared.Logic.ShelfGrid)
local Registry = require(Shared.Models.Registry)
local Uid = require(Shared.Util.Uid)
local PlotsCfg = require(Shared.Config.Plots)
local Core = require(script.Parent.Parent.Core)

local Supply = {}
local boxModels = {} -- [boxUid] = entity
local slotVisuals = {} -- [shelfUid .. "#" .. slot] = { holder, g, cols, rows, cells = { [k] = { kind, inst } } }
-- per restaurant: plot.supply = { pending = { {t, boxes} }, truckBusy }
local function sup(plot)
	plot.supply = plot.supply or { pending = {}, truckBusy = false }
	return plot.supply
end

local function pdata(plot)
	return Core.S.Plots.data(plot)
end

local function ingUnlocked(d, ing)
	if d.licenses[ing.license] then
		return true
	end
	-- regional dishes may use ingredients from licenses not owned yet
	for _, r in ipairs(Recipes.list) do
		if r.city and r.city == d.franchise.city and table.find(r.ing, ing.id) then
			return true
		end
	end
	return false
end

-- Product grid of one slot for ingredient g (Logic/ShelfGrid): half a supplier box laid out like
-- a chessboard, plus rows from the shelf upgrade. A box therefore fills at most two slots.
function Supply.slotGrid(plot, g)
	local ing = Ingredients.byId[g]
	if not ing then
		return 1, 1
	end
	local d = pdata(plot)
	local mult = d and Upgrades.value(d.upgrades, "up_shelf") or 1
	return ShelfGrid.forIngredient(ing.units, GameConfig.BoxShelfSlots, mult)
end

function Supply.slotCap(entity, g)
	if not Ingredients.byId[g] then
		return 0
	end
	local cols, rows = Supply.slotGrid(entity and entity.plot, g)
	return cols * rows
end

------------------------------------------------------------------ storage layout

local chooseSlot, shelfState

local function rackSlots(plot)
	local slots = {}
	local racks = Core.S.Entities.ofKind("rack", plot)
	table.sort(racks, function(a, b)
		return a.uid < b.uid
	end)
	for _, r in ipairs(racks) do
		local root = r.model.PrimaryPart
		local i = 1
		while root and root:FindFirstChild("Box" .. i) do
			table.insert(slots, root["Box" .. i].WorldCFrame * CFrame.new(0, 0.65, 0))
			i += 1
		end
	end
	return slots
end

local function overflowSlots(plot)
	local d = pdata(plot)
	local o = plot.origin
	local slots = {}
	local World = Core.S.World
	local blocked = {}
	for _, e in ipairs(d.placed) do
		if e.s == "f" then
			local item = Items.byId[e.i]
			table.insert(blocked, Footprint.inflate(Footprint.new(e.x, e.z, item.size[1], item.size[3], e.r), 0.6))
		end
	end
	for _, fx in ipairs(World.fixedRects(plot)) do
		table.insert(blocked, Footprint.rectToFp(fx.rect))
	end
	local dz = Expansions.DropZone
	table.insert(blocked, Footprint.rectToFp({ dz.x0, dz.z0, dz.x1, dz.z1 }))
	for _, z in ipairs(World.geo(plot).zones) do
		if z.area == "storage" then
			local r = z.rect
			for x = r[1] + 1.6, r[3] - 1.6, 2.2 do
				for zz = r[2] + 1.6, r[4] - 1.6, 1.9 do
					local fp = Footprint.new(x, zz, 1.8, 1.5, 0)
					local free = true
					for _, b in ipairs(blocked) do
						if Footprint.overlaps(fp, b) then
							free = false
							break
						end
					end
					if free then
						for level = 0, 1 do
							table.insert(slots, CFrame.new(x + o.X, 0.65 + level * 1.32, zz + o.Z))
						end
					end
				end
			end
		end
	end
	return slots
end

-- spots on the ground where the truck leaves the boxes (Expansions.DropZone)
local function dropSpots()
	local zone = Expansions.DropZone
	local out = {}
	for layer = 0, zone.layers - 1 do
		for x = zone.x0 + 1, zone.x1 - 0.9, 2.05 do
			for z = zone.z0 + 0.8, zone.z1 - 0.75, 1.75 do
				table.insert(out, { x = x, z = z, l = layer })
			end
		end
	end
	return out
end

local function freeDropSpot(d)
	for _, sp in ipairs(dropSpots()) do
		local taken = false
		for _, b in ipairs(d.storage) do
			if b.px and (b.pf or 0) == 0 and (b.pl or 0) == sp.l and math.abs(b.px - sp.x) < 0.6 and math.abs(b.pz - sp.z) < 0.6 then
				taken = true
				break
			end
		end
		if not taken then
			return sp
		end
	end
	return nil
end

-- boxes the restaurant can hold: rack slots in the storage room plus the drop zone outside
function Supply.capacity(plot)
	return #rackSlots(plot) + #dropSpots()
end

local function boxModel(entry)
	local m = Registry.food("box", entry.g, entry.n, Supply.boxCap(entry))
	return m
end

-- draws the boxes of a restaurant: on the racks, on the floor where they were left (positions
-- are saved in restaurant-local coordinates), the rest in free storage spots
function Supply.layout(plot)
	local d = pdata(plot)
	if not d then
		return
	end
	local o = plot.origin
	local slots = rackSlots(plot)
	for _, s in ipairs(overflowSlots(plot)) do
		table.insert(slots, s)
	end
	local idx = 0
	local keep = {}
	-- boxes on the floor at the same spot stack up (a box taken from the bottom lets the others drop)
	local stacks, level = {}, {}
	for _, entry in ipairs(d.storage) do
		if not entry.h and entry.px then
			local key = math.floor(entry.px * 2 + 0.5) .. ":" .. math.floor(entry.pz * 2 + 0.5) .. ":" .. (entry.pf or 0)
			stacks[key] = stacks[key] or {}
			table.insert(stacks[key], entry)
		end
	end
	for _, list in pairs(stacks) do
		table.sort(list, function(a, b)
			return (a.pl or 0) < (b.pl or 0)
		end)
		for i, entry in ipairs(list) do
			level[entry] = i - 1
		end
	end
	for _, entry in ipairs(d.storage) do
		if not entry.h then
			local cf
			if entry.px then
				-- box on the floor (left by the truck or put down by a player): it stays exactly there
				local y = Core.S.World.floorY(entry.pf or 0) + 0.65 + (level[entry] or 0) * 1.32
				cf = CFrame.new(entry.px + o.X, y, entry.pz + o.Z) * CFrame.Angles(0, math.rad(entry.pr or 0), 0)
			else
				idx += 1
				cf = slots[idx] or CFrame.new(Expansions.LoadingBay.x + o.X, 0.65 + idx * 0.05, Expansions.LoadingBay.z + o.Z)
			end
			local e = boxModels[entry.u]
			if not e then
				local m = boxModel(entry)
				m.Parent = Core.S.World.folders(plot).dynamic
				e = Core.S.Entities.register(entry.u, "box", m, { box = entry, plot = plot })
				boxModels[entry.u] = e
			end
			e.model:PivotTo(cf)
			keep[entry.u] = true
		end
	end
	for uid, e in pairs(boxModels) do
		if e.plot == plot and not keep[uid] then
			Core.S.Entities.unregister(uid)
			if e.model then
				e.model:Destroy()
			end
			boxModels[uid] = nil
		end
	end
end

-- portions in a full box of this entry (big boxes hold several boxes)
function Supply.boxCap(entry)
	local ing = Ingredients.byId[entry.g]
	return math.max(entry.c or (ing and ing.units) or entry.n, entry.n)
end

local function updateBoxLabel(entry)
	local e = boxModels[entry.u]
	if e and e.model then
		local text = entry.n .. "/" .. Supply.boxCap(entry)
		for _, d in ipairs(e.model:GetDescendants()) do
			if d.Name == "Count" and d:IsA("TextLabel") then
				d.Text = text
			end
		end
	end
end

function Supply.returnBox(plot, entry)
	local d = pdata(plot)
	if not d then
		return
	end
	entry.h = nil
	if entry.n <= 0 then
		for i, b in ipairs(d.storage) do
			if b.u == entry.u then
				table.remove(d.storage, i)
				break
			end
		end
	end
	Supply.layout(plot)
	Core.S.Data.changed(plot.owner, "storage")
end

function Supply.removeBox(plot, entry)
	local d = pdata(plot)
	if not d then
		return
	end
	for i, b in ipairs(d.storage) do
		if b.u == entry.u then
			table.remove(d.storage, i)
			break
		end
	end
	Supply.layout(plot)
	Core.S.Data.changed(plot.owner, "storage")
end

function Supply.takeBox(actor, e)
	local Hands = Core.S.Hands
	local hands = Hands.get(actor)
	if hands.kind ~= nil and (hands.kind ~= "box" or #hands.items >= Hands.capacity(actor, "box")) then
		return false, "msg.hands_full"
	end
	local entry = e.box
	local pos = Core.S.Entities.position(e)
	local ok, reason = Hands.add(actor, "box", entry, e.plot)
	if not ok then
		return false, reason
	end
	entry.h = true
	entry.px, entry.pz, entry.pf, entry.pr, entry.pl = nil, nil, nil, nil, nil
	Supply.layout(e.plot)
	if pos then
		Core.S.Net.fx("sfx", { name = "box", pos = pos })
	end
	return true
end

-- Puts a held box down: on a free rack slot when a rack is close, otherwise on the floor in front
-- of the actor. Returns "rack" or "floor".
function Supply.dropBox(plot, entry, pos, look, floor)
	entry.h = nil
	Core.S.Net.fx("sfx", { name = "box", pos = pos })
	if entry.n <= 0 then
		Supply.returnBox(plot, entry)
		return "gone"
	end
	local d = pdata(plot)
	if not d then
		return "gone"
	end
	local nearRack = false
	for _, r in ipairs(Core.S.Entities.ofKind("rack", plot)) do
		if r.model and r.model.PrimaryPart and (r.model.PrimaryPart.Position - pos).Magnitude < 9 then
			nearRack = true
		end
	end
	local onRacks = 0
	for _, b in ipairs(d.storage) do
		if not b.h and not b.px and b ~= entry then
			onRacks += 1
		end
	end
	if nearRack and onRacks < #rackSlots(plot) then
		entry.px, entry.pz, entry.pf, entry.pr = nil, nil, nil, nil
		Supply.layout(plot)
		Core.S.Data.changed(plot.owner, "storage")
		return "rack"
	end
	-- saved in restaurant-local coordinates
	local o = plot.origin
	local target = pos + look * 3 - o
	local World = Core.S.World
	if not World.zoneAt(plot, target.X, target.Z, floor or 0) then
		target = pos - o
	end
	entry.px, entry.pz, entry.pf = math.floor(target.X * 10) / 10, math.floor(target.Z * 10) / 10, floor or 0
	entry.pr = math.floor(math.deg(math.atan2(-look.X, -look.Z)))
	entry.pl = 9 -- on top of anything already there
	Supply.layout(plot)
	Core.S.Data.changed(plot.owner, "storage")
	return "floor"
end

-- Puts one ingredient back on the nearest shelf that can take it. Returns the shelf or nil.
function Supply.returnIngredient(plot, g, pos)
	local ing = Ingredients.byId[g]
	if not ing then
		return nil
	end
	local best, bestSlot, bestD = nil, nil, math.huge
	for _, e in ipairs(Core.S.Entities.ofKind("shelf", plot)) do
		if not (e.item.fn.fishOnly and ing.storage ~= "fish") and e.model and e.model.PrimaryPart then
			local slot = chooseSlot(e, g, nil)
			if slot then
				local dist = (e.model.PrimaryPart.Position - pos).Magnitude
				-- prefer a slot that already holds this ingredient
				local st = shelfState(e)[tostring(slot)]
				if st and st.g == g then
					dist -= 1000
				end
				if dist < bestD then
					best, bestSlot, bestD = e, slot, dist
				end
			end
		end
	end
	if not best then
		return nil
	end
	local st = shelfState(best)
	local s = st[tostring(bestSlot)]
	if not s or s.n == 0 then
		s = { g = g, n = 0 }
		st[tostring(bestSlot)] = s
	end
	s.n += 1
	Supply.refreshShelf(best)
	Core.S.Data.changed(plot.owner, "shelves")
	return best
end

function Supply.findBox(plot, g)
	local d = pdata(plot)
	if not d then
		return nil
	end
	for _, entry in ipairs(d.storage) do
		if entry.g == g and not entry.h and entry.n > 0 then
			return entry, boxModels[entry.u]
		end
	end
	return nil
end

function Supply.boxCount(plot, g)
	local d = pdata(plot)
	local n, portions = 0, 0
	if not d then
		return 0, 0
	end
	for _, entry in ipairs(d.storage) do
		if entry.g == g then
			n += 1
			portions += entry.n
		end
	end
	return n, portions
end

------------------------------------------------------------------ shelves

-- the slots of a shelf entity: { ["slot"] = { g, n } } (saved in its restaurant's data)
function shelfState(e)
	local d = pdata(e.plot)
	if not d then
		return {}
	end
	d.shelves[e.uid] = d.shelves[e.uid] or {}
	return d.shelves[e.uid]
end

-- how big a product is drawn in a cell (fits the cell, never bigger than ShelfItemScale)
local extents = {}
local function productFit(g, cw, cd, ch)
	local ext = extents[g]
	if not ext then
		local m = Registry.food("ingredient", g)
		ext = m:GetExtentsSize()
		m:Destroy()
		extents[g] = ext
	end
	local maxScale = GameConfig.ShelfItemScale or 1.3
	local straight = math.min(0.86 * cw / ext.X, 0.86 * cd / ext.Z, 0.8 * ch / ext.Y)
	local turned = math.min(0.86 * cw / ext.Z, 0.86 * cd / ext.X, 0.8 * ch / ext.Y)
	if turned > straight then
		return math.min(turned, maxScale), true
	end
	return math.min(straight, maxScale), false
end

-- world CFrame of the floor of cell k of a slot part, and the cell size
local function cellFloor(part, k, cols, rows)
	local x, z, cw, cd = ShelfGrid.cell(k, cols, rows, part.Size.X - 0.1, part.Size.Z - 0.1)
	return part.CFrame * CFrame.new(x, -part.Size.Y / 2 + 0.02, z), cw, cd
end

-- one product standing on a floor CFrame (bottom resting on it); clients use the same rule
local function standProduct(g, floorCf, scale, turned)
	local m = Registry.food("ingredient", g)
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanQuery = false
			d.CanCollide = false
		end
	end
	pcall(function()
		m:ScaleTo(scale)
	end)
	local target = floorCf * (turned and CFrame.Angles(0, math.rad(90), 0) or CFrame.new())
	m:PivotTo(target)
	local box, size = m:GetBoundingBox()
	m:PivotTo(target + Vector3.new(0, target.Position.Y - (box.Position.Y - size.Y / 2), 0))
	return m
end

Supply.standProduct = standProduct

-- a faint square marking a free spot of the grid
local function spot(floorCf, cw, cd)
	local p = Instance.new("Part")
	p.Name = "Spot"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	p.Color = Color3.fromRGB(255, 244, 214)
	p.Transparency = 0.5
	p.Size = Vector3.new(cw * 0.8, 0.02, cd * 0.8)
	p.CFrame = floorCf * CFrame.new(0, 0.01, 0)
	return p
end

-- what fly animations need to land exactly where the product will stand
function Supply.cellTarget(e, slot, k, g)
	local part = e.model and e.model:FindFirstChild("Slot" .. slot)
	if not part then
		return nil
	end
	local cols, rows = Supply.slotGrid(e.plot, g)
	local floorCf, cw, cd = cellFloor(part, k, cols, rows)
	local scale, turned = productFit(g, cw, cd, part.Size.Y)
	return { g = g, cf = floorCf, s = scale, rot = turned }
end

local function refreshSlot(e, slot)
	local st = shelfState(e)
	local part = e.model:FindFirstChild("Slot" .. slot)
	local key = e.uid .. "#" .. slot
	local cur = slotVisuals[key]
	local s = st[tostring(slot)]
	local g = (s and s.n > 0) and s.g or nil
	if part then
		part:SetAttribute("G", g or "")
		part:SetAttribute("N", g and s.n or 0)
		part:SetAttribute("Cap", g and Supply.slotCap(e, g) or 0)
	end
	if not g or not part then
		if cur then
			cur.holder:Destroy()
			slotVisuals[key] = nil
		end
		return
	end
	local cols, rows = Supply.slotGrid(e.plot, g)
	if not cur or cur.g ~= g or cur.cols ~= cols or cur.rows ~= rows or not cur.holder.Parent then
		if cur then
			cur.holder:Destroy()
		end
		local holder = Instance.new("Model")
		holder.Name = "SlotItems"
		holder.Parent = e.model
		cur = { holder = holder, g = g, cols = cols, rows = rows, cells = {} }
		slotVisuals[key] = cur
	end
	local _, cw0, cd0 = cellFloor(part, 1, cols, rows)
	local scale, turned = productFit(g, cw0, cd0, part.Size.Y)
	for k = 1, cols * rows do
		local want = k <= s.n and "item" or "spot"
		local have = cur.cells[k]
		if not have or have.kind ~= want then
			if have then
				have.inst:Destroy()
			end
			local floorCf, cw, cd = cellFloor(part, k, cols, rows)
			local inst = want == "item" and standProduct(g, floorCf, scale, turned) or spot(floorCf, cw, cd)
			inst.Parent = cur.holder
			cur.cells[k] = { kind = want, inst = inst }
		end
	end
end

-- Draws the products of a shelf (or of one slot) as a grid with free spots marked
function Supply.refreshShelf(e, onlySlot)
	if not e or not e.model then
		return
	end
	if onlySlot then
		refreshSlot(e, onlySlot)
		return
	end
	for slot = 1, e.item.fn.slots do
		refreshSlot(e, slot)
	end
end

-- where an actor holds things (start / end of the fly animations)
local function handPos(actor)
	if typeof(actor) == "Instance" then
		local hrp = actor.Character and actor.Character:FindFirstChild("HumanoidRootPart")
		return hrp and (hrp.CFrame * CFrame.new(0, 0.6, -1.6)).Position
	end
	local root = actor.npc and actor.npc.root
	return root and (root.CFrame * CFrame.new(0, 0.6, -1.6)).Position
end
Supply.handPos = handPos

function Supply.shelfStock(plot, g)
	local total = 0
	for _, e in ipairs(Core.S.Entities.ofKind("shelf", plot)) do
		for _, s in pairs(shelfState(e)) do
			if s.g == g then
				total += s.n
			end
		end
	end
	return total
end

-- Takes one product of ingredient g from the shelf slot nearest to pos (stations fetch their
-- ingredients by themselves). Returns where the product stood (for the fly animation) and whether
-- it was fresh (neta case), or nil when there is none on the shelves.
function Supply.takeIngredient(plot, g, pos)
	local shelf, slot = Supply.findShelfWith(plot, g, pos)
	if not shelf then
		return nil
	end
	local st = shelfState(shelf)
	local s = st[tostring(slot)]
	if not s or s.n <= 0 then
		return nil
	end
	local target = Supply.cellTarget(shelf, slot, s.n, g)
	s.n -= 1
	if s.n <= 0 then
		st[tostring(slot)] = nil
	end
	Supply.refreshShelf(shelf, slot)
	Core.S.Data.changed(plot.owner, "shelves")
	local from = target and target.cf and target.cf.Position or shelf.model.PrimaryPart.Position
	return from, shelf.item.fn.fresh == true
end

-- Nearest shelf slot holding ingredient g (for staff)
function Supply.findShelfWith(plot, g, pos)
	local best, bestSlot, bestD = nil, nil, math.huge
	for _, e in ipairs(Core.S.Entities.ofKind("shelf", plot)) do
		for slot, s in pairs(shelfState(e)) do
			if s.g == g and s.n > 0 then
				local p = e.model.PrimaryPart.Position
				local dist = pos and (p - pos).Magnitude or 0
				if dist < bestD then
					best, bestSlot, bestD = e, tonumber(slot), dist
				end
			end
		end
	end
	return best, bestSlot
end

function chooseSlot(e, g, requested)
	local st = shelfState(e)
	local cap = Supply.slotCap(e, g)
	local slots = e.item.fn.slots
	if requested and requested >= 1 and requested <= slots then
		local s = st[tostring(requested)]
		if not s or s.n == 0 or (s.g == g and s.n < cap) then
			return requested
		end
	end
	for slot = 1, slots do
		local s = st[tostring(slot)]
		if s and s.g == g and s.n > 0 and s.n < cap then
			return slot
		end
	end
	for slot = 1, slots do
		local s = st[tostring(slot)]
		if not s or s.n == 0 then
			return slot
		end
	end
	return nil
end

-- Shelf interaction for players and staff
function Supply.useShelf(actor, e, slot)
	local Hands = Core.S.Hands
	local hands = Hands.get(actor)
	local st = shelfState(e)
	if hands.kind and hands.plot and hands.plot ~= e.plot then
		return false, "msg.other_restaurant"
	end
	if hands.kind == "box" then
		-- with a cart you may hold several boxes: use one that fits this shelf, preferring the
		-- ingredient of the clicked slot
		local clicked = slot and st[tostring(slot)]
		local index, firstError = nil, nil
		for i, it in ipairs(hands.items) do
			local ing = Ingredients.byId[it.g]
			local err = nil
			if ing.storage == "rice" or ing.storage == "broth" then
				err = "msg.use_appliance"
			elseif e.item.fn.fishOnly and ing.storage ~= "fish" then
				err = "msg.fish_only"
			end
			if err then
				firstError = firstError or err
			elseif clicked and clicked.g == it.g and (not index or hands.items[index].g ~= it.g) then
				index = i
			elseif not index then
				index = i
			end
		end
		if not index then
			return false, firstError
		end
		local entry = hands.items[index]
		local cap = Supply.slotCap(e, entry.g)
		local placed = 0
		local target
		if slot and slot >= 1 and slot <= e.item.fn.slots then
			-- the slot you clicked, and only that one
			local s = st[tostring(slot)]
			if s and s.n > 0 and s.g ~= entry.g then
				return false, "msg.slot_other", { name = "ing." .. s.g }
			end
			if s and s.n >= cap then
				return false, "msg.slot_full"
			end
			target = slot
		else
			-- clicked the shelf itself: the slot that already holds this product, else an empty one
			target = chooseSlot(e, entry.g, nil)
			if not target then
				-- say where it fits instead: another shelf with room, or that a new shelf is needed
				for _, other in ipairs(Core.S.Entities.ofKind("shelf", e.plot)) do
					local ing = Ingredients.byId[entry.g]
					local fishOk = not other.item.fn.fishOnly or (ing and ing.storage == "fish")
					if other ~= e and fishOk and chooseSlot(other, entry.g, nil) then
						return false, "msg.shelf_full_other"
					end
				end
				return false, "msg.shelf_full_buy"
			end
		end
		-- one slot per click: what does not fit stays in the box for the slot you click next
		local flights, touched = {}, {}
		do
			local s = st[tostring(target)]
			if not s or s.n == 0 then
				s = { g = entry.g, n = 0 }
				st[tostring(target)] = s
			end
			local amount = math.max(0, math.min(entry.n, cap - s.n))
			for k = s.n + 1, s.n + amount do
				local tgt = Supply.cellTarget(e, target, k, entry.g)
				if tgt then
					table.insert(flights, tgt)
				end
			end
			s.n += amount
			entry.n -= amount
			placed += amount
			table.insert(touched, target)
		end
		local left = entry.n
		if entry.n <= 0 then
			Supply.removeBox(e.plot, entry)
			Hands.removeAt(actor, index)
		else
			Hands.refresh(actor)
			updateBoxLabel(entry)
		end
		if typeof(actor) == "Instance" then
			Core.S.Net.notify(actor, left > 0 and "msg.restocked_left" or "msg.restocked", { n = placed, name = "ing." .. entry.g, left = left }, "success")
		end
		-- the products fly out of the box one by one (Supermarket Together style) and are drawn on
		-- the shelf when the last one lands
		local step = GameConfig.StockFlyStep or 0.06
		Core.S.Net.fx("stock", { from = handPos(actor), items = flights, step = step })
		task.delay(#flights * step + 0.3, function()
			if e.model then
				for _, slotIndex in ipairs(touched) do
					refreshSlot(e, slotIndex)
				end
			end
		end)
		for _, slotIndex in ipairs(touched) do
			local part = e.model:FindFirstChild("Slot" .. slotIndex)
			local s = st[tostring(slotIndex)]
			if part and s then
				part:SetAttribute("G", s.g)
				part:SetAttribute("N", s.n)
			end
		end
		Core.S.Data.changed(e.plot.owner, "shelves")
		Core.S.Meta.event(e.plot.owner, "restock", 1)
		Core.S.Net.fx("sfx", { name = "restock", pos = e.model.PrimaryPart.Position })
		return true
	elseif typeof(actor) == "Instance" and hands.kind == nil then
		-- players do not carry ingredients any more: the stations take them by themselves
		return false, "msg.shelf_auto"
	elseif hands.kind == nil or hands.kind == "ing" then
		local s = slot and st[tostring(slot)]
		if not s or s.n <= 0 then
			-- clicked an empty slot: take from any slot of this shelf
			for k = 1, e.item.fn.slots do
				if st[tostring(k)] and st[tostring(k)].n > 0 then
					slot, s = k, st[tostring(k)]
					break
				end
			end
		end
		if not s or s.n <= 0 then
			return false, "msg.shelf_empty"
		end
		local ok, reason = Hands.add(actor, "ing", { g = s.g, fresh = e.item.fn.fresh == true }, e.plot)
		if not ok then
			return false, reason
		end
		-- the last product of the slot flies into your hands
		local from = Supply.cellTarget(e, slot, s.n, s.g)
		if from then
			Core.S.Net.fx("take", { item = from, to = handPos(actor) })
		end
		s.n -= 1
		if s.n <= 0 then
			st[tostring(slot)] = nil
		end
		Supply.refreshShelf(e, slot)
		Core.S.Data.changed(e.plot.owner, "shelves")
		return true
	end
	return false, "msg.hands_busy"
end

------------------------------------------------------------------ orders & delivery

-- orders leave right away: only the truck's short drive is left
local function deliveryTime()
	return 0
end

-- orders boxes for the restaurant the player manages (staff restock orders pass the plot)
function Supply.order(player, cart, forPlot)
	local Plots, Net = Core.S.Plots, Core.S.Net
	local plot = forPlot or Plots.of(player)
	if not plot or not Plots.canBuild(player, plot) then
		return Net.notify(player, "msg.no_permission", nil, "error")
	end
	local d = pdata(plot)
	if not d or type(cart) ~= "table" then
		return
	end
	local discount = Upgrades.value(d.upgrades, "up_supplier")
	local total, boxes = 0, {}
	for g, q in pairs(cart) do
		local ing = Ingredients.byId[g]
		if ing and type(q) == "table" and ingUnlocked(d, ing) then
			local small = math.clamp(math.floor(tonumber(q.small) or 0), 0, 30)
			local big = (discount > 0) and math.clamp(math.floor(tonumber(q.big) or 0), 0, 30) or 0
			total += small * ing.price
			total += math.floor(big * ing.price * GameConfig.BigBoxMultiplier * (1 - discount) + 0.5)
			for _ = 1, small do
				table.insert(boxes, { u = Uid.new("b"), g = g, n = ing.units })
			end
			for _ = 1, big do
				local units = ing.units * GameConfig.BigBoxMultiplier
				table.insert(boxes, { u = Uid.new("b"), g = g, n = units, c = units })
			end
		end
	end
	if #boxes == 0 then
		return
	end
	local queued = 0
	for _, p in ipairs(sup(plot).pending) do
		queued += #p.boxes
	end
	if #d.storage + queued + #boxes > Supply.capacity(plot) then
		return Net.notify(player, "msg.storage_full", { n = Supply.capacity(plot) }, "error")
	end
	if not Core.S.Economy.spend(plot.owner, total, "supplies", "supplies") then
		return Net.notify(player, "msg.not_enough", nil, "error")
	end
	table.insert(sup(plot).pending, { t = os.clock() + deliveryTime(), boxes = boxes })
	Core.S.Plots.notify(plot, "msg.order_placed", { n = #boxes, seconds = math.floor(deliveryTime()) }, "success")
	Net.fxTo(player, "action", { kind = "order" })
	return true
end

local function animateTruck(plot, onArrive)
	local folders = Core.S.World.folders(plot)
	local truck = Registry.Street.truck()
	truck.Parent = folders.dynamic
	local o = plot.origin
	local reach = PlotsCfg.StreetReach
	local bay = { x = Expansions.LoadingBay.x + o.X, z = Expansions.LoadingBay.z + o.Z }
	local lane = Expansions.Street.truckLane
	local startCf = CFrame.new(reach, 2.1, lane) * CFrame.Angles(0, 0, 0)
	local roadCf = CFrame.new(bay.x + 2, 2.1, lane)
	-- backs into the bay: the cargo door faces the storage room
	local bayCf = CFrame.new(bay.x, 2.1, bay.z) * CFrame.Angles(0, math.rad(-90), 0)
	local value = Instance.new("CFrameValue")
	value.Value = startCf
	value.Changed:Connect(function(cf)
		if truck.Parent then
			truck:PivotTo(cf)
		end
	end)
	truck:PivotTo(startCf)
	local t1 = TweenService:Create(value, TweenInfo.new(GameConfig.TruckDrive or 4.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = roadCf })
	t1:Play()
	t1.Completed:Wait()
	local t2 = TweenService:Create(value, TweenInfo.new(1.3, Enum.EasingStyle.Sine), { Value = bayCf })
	t2:Play()
	t2.Completed:Wait()
	Core.S.Net.fx("sfx", { name = "truck", pos = bayCf.Position })
	task.delay(0.8, function()
		Core.S.Net.fx("sfx", { name = "bell", pos = bayCf.Position })
	end)
	task.wait(0.4)
	onArrive()
	task.wait(1)
	local t3 = TweenService:Create(value, TweenInfo.new(1.6, Enum.EasingStyle.Sine), { Value = CFrame.new(bay.x - 4, 2.1, lane) })
	t3:Play()
	t3.Completed:Wait()
	local t4 = TweenService:Create(value, TweenInfo.new(7, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Value = CFrame.new(-reach, 2.1, lane) })
	t4:Play()
	t4.Completed:Wait()
	truck:Destroy()
	value:Destroy()
end

------------------------------------------------------------------ rescue kit

-- ingredients of recipe r that are nowhere (shelves, boxes, hands, pot, rice cooker)
local function missingFor(plot, d, r)
	local need = table.clone(r.ing)
	if r.broth then
		table.insert(need, r.broth)
	end
	if r.rice then
		table.insert(need, "rice")
	end
	local missing = {}
	for _, g in ipairs(need) do
		local have = Supply.shelfStock(plot, g) > 0
		if not have then
			for _, b in ipairs(d.storage) do
				if b.g == g and b.n > 0 then
					have = true
					break
				end
			end
		end
		if not have and g == r.broth then
			have = Core.S.Appliance.hasBroth(plot, g) or Core.S.Appliance.willHave(plot, "pot", g)
		elseif not have and g == "rice" then
			have = Core.S.Appliance.hasRice(plot) or Core.S.Appliance.willHave(plot, "ricecooker")
		end
		if not have then
			table.insert(missing, g)
		end
	end
	return missing
end

-- Safety net: no dish of the menu can be made and there is not enough money to buy what is
-- missing (spent it all on decorations, for example): the supplier sends a free kit for the
-- cheapest dish, at most once every GameConfig.RescueCooldown seconds
local function rescueCheck(plot)
	local d = pdata(plot)
	local owner = plot.owner
	local sp = sup(plot)
	if not d or not owner or sp.truckBusy or #sp.pending > 0 then
		return
	end
	if os.time() - (d.meta.rescueAt or 0) < (GameConfig.RescueCooldown or 600) then
		return
	end
	local cheapest, cheapestCost = nil, math.huge
	for id, m in pairs(d.menu or {}) do
		local r = Recipes.byId[id]
		if r and m.on then
			local missing = missingFor(plot, d, r)
			if #missing == 0 then
				return -- something can still be cooked
			end
			local cost = 0
			for _, g in ipairs(missing) do
				cost += Ingredients.byId[g] and Ingredients.byId[g].price or 0
			end
			if cost < cheapestCost then
				cheapest, cheapestCost = missing, cost
			end
		end
	end
	if not cheapest or d.yen >= cheapestCost then
		return
	end
	local boxes = {}
	for _, g in ipairs(cheapest) do
		table.insert(boxes, { u = Uid.new("b"), g = g, n = Ingredients.byId[g].units })
	end
	d.meta.rescueAt = os.time()
	table.insert(sp.pending, { t = os.clock(), boxes = boxes })
	Core.S.Net.notify(owner, "msg.rescue_kit", nil, "success")
end

local function deliver(plot)
	local sp = sup(plot)
	if not sp.truckBusy and #sp.pending > 0 and sp.pending[1].t <= os.clock() then
		local pending = sp.pending
		local batch = {}
		while #pending > 0 and pending[1].t <= os.clock() + 2 do
			local p = table.remove(pending, 1)
			for _, b in ipairs(p.boxes) do
				table.insert(batch, b)
			end
		end
		sp.truckBusy = true
		task.spawn(function()
			local o = plot.origin
				local ok, err = pcall(animateTruck, plot, function()
					local d = pdata(plot)
					if d then
						-- the driver puts the boxes down on the ground one by one
						for _, b in ipairs(batch) do
							local sp = freeDropSpot(d)
							if sp then
								b.px, b.pz, b.pf, b.pr, b.pl = sp.x, sp.z, 0, 0, sp.l
							end
							table.insert(d.storage, b)
							Supply.layout(plot)
							Core.S.Net.fx("sfx", { name = "box", pos = Vector3.new((b.px or Expansions.LoadingBay.x) + o.X, 1, (b.pz or Expansions.LoadingBay.z) + o.Z) })
							task.wait(0.2)
						end
						Core.S.Data.changed(plot.owner, "storage")
						Core.S.Plots.notify(plot, "msg.delivery_arrived", { n = #batch }, "success")
					end
				end)
				if not ok then
					warn("[Supply] truck: " .. tostring(err))
					local d = pdata(plot)
					if d then
						for _, b in ipairs(batch) do
							table.insert(d.storage, b)
						end
						Supply.layout(plot)
					end
				end
				sp.truckBusy = false
			end)
	end
end

local function deliveryLoop()
	while true do
		task.wait(0.5)
		for _, plot in ipairs(Core.S.Plots.list) do
			if plot.owner then
				deliver(plot)
			end
		end
	end
end

-- Auto restock (upgrade + stocker): keeps at least one box of each menu ingredient
local function autoRestockPlot(plot)
	local d = pdata(plot)
	do
		if d and (d.upgrades.up_autorestock or 0) > 0 then
			local hasStocker = false
			for _, s in ipairs(d.staff) do
				if s.role == "staff_stocker" then
					hasStocker = true
				end
			end
			if hasStocker then
				local needed = {}
				for _, r in ipairs(Core.S.Progression.menuRecipes(d)) do
					for _, g in ipairs(r.ing) do
						needed[g] = true
					end
					if r.rice then
						needed.rice = true
					end
					if r.broth then
						needed[r.broth] = true
					end
				end
				local cart = {}
				for g in pairs(needed) do
					local ing = Ingredients.byId[g]
					local boxes = Supply.boxCount(plot, g)
					if ing and boxes == 0 and Supply.shelfStock(plot, g) < ing.units then
						cart[g] = { small = 2 }
					end
				end
				if next(cart) then
					Supply.order(plot.owner, cart, plot)
				end
			end
		end
	end
end

local function autoRestock()
	while true do
		task.wait(GameConfig.AutoRestockCheck)
		for _, plot in ipairs(Core.S.Plots.list) do
			if plot.owner then
				pcall(autoRestockPlot, plot)
			end
		end
	end
end

function Supply.Init()
	local Net = Core.S.Net
	Net.on("OrderSupplies", function(player, cart)
		Supply.order(player, cart)
	end, 2)
	Net.on("BuyDishes", function(player, count)
		local Plots = Core.S.Plots
		local plot = Plots.of(player)
		if not plot or not Plots.canBuild(player, plot) then
			return
		end
		local d = pdata(plot)
		local n = math.clamp(math.floor(tonumber(count) or 1), 1, 10)
		local cost = n * GameConfig.DishSetPrice
		if d and Core.S.Economy.spend(plot.owner, cost, "supplies", "dishes") then
			d.dishes.total += n * GameConfig.DishSetSize
			d.dishes.clean += n * GameConfig.DishSetSize
			Core.S.Data.changed(plot.owner, "dishes")
			Net.notify(player, "msg.dishes_bought", { n = n * GameConfig.DishSetSize }, "success")
		else
			Net.notify(player, "msg.not_enough", nil, "error")
		end
	end, 3)
	local Placement = Core.S.Placement
	Placement.ItemAdded:Connect(function(e)
		if e.kind == "shelf" then
			Supply.refreshShelf(e)
		elseif e.kind == "rack" then
			task.defer(Supply.layout, e.plot)
		end
	end)
	Placement.ItemMoved:Connect(function(e)
		if e.kind == "shelf" then
			Supply.refreshShelf(e)
		elseif e.kind == "rack" then
			task.defer(Supply.layout, e.plot)
		end
	end)
	Placement.ItemRemoved:Connect(function(e)
		if e.kind == "rack" then
			task.defer(Supply.layout, e.plot)
		elseif e.kind == "shelf" then
			-- forget the drawn products of a shelf that is gone
			for key, v in pairs(slotVisuals) do
				if string.sub(key, 1, #e.uid + 1) == e.uid .. "#" then
					v.holder:Destroy()
					slotVisuals[key] = nil
				end
			end
		end
	end)
	Placement.addVeto(function(e)
		if e.kind == "shelf" then
			for _, s in pairs(shelfState(e)) do
				if s.n > 0 then
					return false, "msg.empty_first"
				end
			end
		end
		return true
	end)
	Placement.LayoutChanged:Connect(function(plot)
		task.defer(Supply.layout, plot)
	end)
end

function Supply.Start()
	local Plots = Core.S.Plots
	Plots.Claimed:Connect(function(plot, _, d)
		for _, b in ipairs(d.storage) do
			b.h = nil
		end
		plot.supply = { pending = {}, truckBusy = false }
		task.delay(0.5, Supply.layout, plot)
	end)
	Plots.Released:Connect(function(plot)
		plot.supply = nil
		for uid, e in pairs(boxModels) do
			if e.plot == plot then
				Core.S.Entities.unregister(uid)
				if e.model then
					e.model:Destroy()
				end
				boxModels[uid] = nil
			end
		end
	end)
	task.spawn(deliveryLoop)
	task.spawn(function()
		while true do
			task.wait(15)
			for _, plot in ipairs(Plots.list) do
				if plot.owner then
					pcall(rescueCheck, plot)
				end
			end
		end
	end)
	task.spawn(autoRestock)
	local _ = updateBoxLabel
end

Supply.updateBoxLabel = updateBoxLabel
return Supply
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000096"><Properties><string name="Name">Tasks</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Task board helpers for staff: finds work in their restaurant (every finder takes the plot),
-- claims targets so two workers never do the same job.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Recipes = require(Shared.Config.Recipes)
local Ingredients = require(Shared.Config.Ingredients)
local Core = require(script.Parent.Parent.Core)

local Tasks = {}

-- Point in front of an entity (local -Z side) at floor level
function Tasks.frontOf(e, dist)
	local root = e.model and e.model.PrimaryPart
	if not root then
		return Core.S.Entities.position(e)
	end
	local cook = root:FindFirstChild("Cook")
	if cook then
		return cook.WorldPosition + Vector3.new(0, 0.5, 0)
	end
	local cf = root.CFrame * CFrame.new(0, -root.Size.Y / 2 + 0.5, -(root.Size.Z / 2 + (dist or 1.6)))
	return cf.Position
end

function Tasks.nearCustomer(c)
	if not c.seat then
		return c.npc and c.npc.root and c.npc.root.Position or Vector3.new()
	end
	local sit = c.seat.sit
	local p = sit.Position - sit.LookVector * 2.2
	return Vector3.new(p.X, Core.S.World.floorY(c.seat.floor) + 0.5, p.Z)
end

-- claims live outside the objects (box entries are saved to the DataStore)
local claims = setmetatable({}, { __mode = "k" })

local function claimed(obj)
	local a = claims[obj]
	return a ~= nil and a.alive ~= false
end

function Tasks.claim(obj, actor)
	if claimed(obj) then
		return claims[obj] == actor
	end
	claims[obj] = actor
	return true
end

function Tasks.release(obj, actor)
	if obj and claims[obj] == actor then
		claims[obj] = nil
	end
end

function Tasks.claimedBy(obj)
	return claims[obj]
end

-- Waiter: a ready dish that matches a waiting customer
function Tasks.findServe(plot)
	local Customers = Core.S.Customers
	for _, rd in ipairs(Core.S.Cooking.readyDishes(plot)) do
		local st = Core.S.Cooking.stationState(rd.entity)
		if not claimed(st) then
			for _, c in ipairs(Customers.list(plot, "waiting")) do
				if c.order == rd.recipe and not claimed(c) then
					return rd.entity, c
				end
			end
		end
	end
	return nil
end

function Tasks.findOrder(plot)
	for _, c in ipairs(Core.S.Customers.list(plot, "order")) do
		if not claimed(c) then
			return c
		end
	end
	return nil
end

function Tasks.findDirty(plot)
	for _, e in ipairs(Core.S.Entities.ofKind("dirty", plot)) do
		if not claimed(e) then
			return e
		end
	end
	return nil
end

-- Chef: a free station of the chef's kinds with an order to start and everything it needs
-- (the station fetches the ingredients from the shelves by itself)
function Tasks.findCook(plot, stations)
	local Cooking = Core.S.Cooking
	for _, e in ipairs(Core.S.Entities.ofKind("station", plot)) do
		if table.find(stations, e.item.fn.station) then
			local st = Cooking.stationState(e)
			if not st.busy and #st.board == 0 and not st.ready and not claimed(st) then
				local t, r = Cooking.nextOrder(e)
				if t and #Cooking.missing(plot, r) == 0 then
					return t, r, e
				end
			end
		end
	end
	return nil
end

-- Stocker: ingredient running low on shelves with a box available
function Tasks.findRestock(plot)
	local d = Core.S.Plots.data(plot)
	if not d then
		return nil
	end
	local Supply = Core.S.Supply
	local wanted = {}
	for _, r in ipairs(Core.S.Progression.menuRecipes(d)) do
		for _, g in ipairs(r.ing) do
			wanted[g] = true
		end
	end
	for g in pairs(wanted) do
		local ing = Ingredients.byId[g]
		if ing and (ing.storage == "shelf" or ing.storage == "fish") and Supply.shelfStock(plot, g) < 6 then
			local box = Supply.findBox(plot, g)
			if box and not claimed(box) then
				return box, g
			end
		end
	end
	return nil
end

-- Stocker / ramen chef: a rice cooker or pot that needs refilling (and a box to do it)
function Tasks.findRefill(plot, kinds)
	local d = Core.S.Plots.data(plot)
	if not d then
		return nil
	end
	local Supply = Core.S.Supply
	local broths = {}
	for _, r in ipairs(Core.S.Progression.menuRecipes(d)) do
		if r.broth then
			broths[r.broth] = (broths[r.broth] or 0) + 1
		end
	end
	for _, need in ipairs(Core.S.Appliance.needsRefill(plot)) do
		local e = need.entity
		if table.find(kinds, e.kind) and not claimed(e) then
			if e.kind == "ricecooker" then
				local box = Supply.findBox(plot, "rice")
				if box and not claimed(box) then
					return e, box
				end
			else
				local g = need.g
				if not g then
					-- empty pot: pick the broth most used by the menu that no other pot is making
					local best, bestN = nil, 0
					for b, n in pairs(broths) do
						if n > bestN and not Core.S.Appliance.willHave(plot, "pot", b) then
							best, bestN = b, n
						end
					end
					g = best
				end
				local box = g and Supply.findBox(plot, g)
				if box and not claimed(box) then
					return e, box
				end
			end
		end
	end
	return nil
end

return Tasks
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000097"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Builds the street (once, with a lot for every plot) and the shell of each restaurant from the
-- zones its owner unlocked; exposes each plot's geometry (zones, walls, stairs, openings) to
-- placement, seating and NPC services. Geometry is in restaurant-local coordinates; the shell is
-- built there and then moved onto the plot.
local PhysicsService = game:GetService("PhysicsService")
local Lighting = game:GetService("Lighting")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Expansions = require(Shared.Config.Expansions)
local Items = require(Shared.Config.Items)
local PlotsCfg = require(Shared.Config.Plots)
local Geometry = require(Shared.Logic.Geometry)
local Footprint = require(Shared.Logic.Footprint)
local Registry = require(Shared.Models.Registry)
local Scene = require(Shared.Models.Scene)
local Signal = require(Shared.Util.Signal)
local Core = require(script.Parent.Parent.Core)

local World = {}
World.Rebuilt = Signal.new() -- (plot)
World.city = "tokyo"

local street, npcFolder
local streetBuilt = false
local emptyGeo = nil

local function folder(name, parent)
	local f = parent:FindFirstChild(name)
	if not f then
		f = Instance.new("Folder")
		f.Name = name
		f.Parent = parent
	end
	return f
end

function World.floorY(f)
	return (f or 0) * GameConfig.FloorHeight
end

-- Floor index for a world height (players and NPCs standing on that floor)
function World.floorOf(y)
	return math.max(0, math.floor((y + 2) / GameConfig.FloorHeight))
end

-- the folders of a plot (and the shared ones)
function World.folders(plot)
	local f = plot and plot.folder
	return {
		root = f,
		shell = f and folder("Shell", f),
		items = f and folder("Items", f),
		dynamic = f and folder("Dynamic", f),
		npcs = npcFolder,
		street = street,
	}
end

-- geometry of a plot: { zones, openings, stairs, walls, expansions, fixed }
function World.geo(plot)
	return (plot and plot.geo) or emptyGeo
end

-- Recomputes the unlocked geometry of a plot from its owner's data
function World.recompute(plot, data)
	plot.geo = Geometry.compute(Expansions.list, data.zones, Expansions)
end

-- zone at restaurant-local x, z on floor f
function World.zoneAt(plot, x, z, f)
	for _, zone in ipairs(World.geo(plot).zones) do
		if zone.floor == (f or 0) and Footprint.pointInRect(x, z, zone.rect) then
			return zone
		end
	end
	return nil
end

-- zone at a world position (the plot is found from the position)
function World.zoneAtWorld(pos, f)
	local plot = Core.S.Plots.at(pos)
	if not plot then
		return nil
	end
	local p = Core.S.Plots.toLocal(plot, pos)
	return World.zoneAt(plot, p.X, p.Z, f), plot
end

function World.hasExpansion(plot, id)
	for _, e in ipairs(World.geo(plot).expansions or {}) do
		if e.id == id then
			return true
		end
	end
	return false
end

-- Door clearances that must stay free of objects
function World.fixedRects(plot)
	return World.geo(plot).fixed or {}
end

-- Placement validation context (see Shared.Logic.Placement), in local coordinates
function World.ctx(plot, placed)
	local g = World.geo(plot)
	return Geometry.ctx({ zones = g.zones, walls = g.walls, stairs = g.stairs, fixed = g.fixed }, Items.byId, placed, GameConfig)
end

function World.surfaceOf(data, zone, kind)
	return Scene.surfaceOf(data, zone, kind)
end

local function buildStreet(cityId)
	local lots = {}
	for _, plot in ipairs(Core.S.Plots.list) do
		table.insert(lots, plot.origin.X)
	end
	local result = Scene.street(street, cityId, lots, PlotsCfg.StreetReach)
	Lighting:SetAttribute("City", cityId)
	Lighting:SetAttribute("Sky", result.sky)
	streetBuilt = true
end

-- the shell of an empty lot: a fence and a sign while nobody owns it
local function buildEmptyLot(plot)
	local shell = World.folders(plot).shell
	shell:ClearAllChildren()
	Scene.emptyLot(shell)
	Core.S.Plots.shift(shell, plot)
end

-- (re)builds the restaurant of a plot from its owner's data
function World.rebuild(plot, data)
	World.recompute(plot, data)
	local f = World.folders(plot)
	local result = Scene.shell(f.shell, World.geo(plot), data)
	plot.openLabel = result.openLabel
	if plot.openLabel then
		plot.openLabel.Text = "営業中"
	end
	-- a "for sale" sign on every ground-floor room that can be built next (its rooms before it
	-- are owned); the sign goes when the room is bought (the shell is built again)
	for _, e in ipairs(Expansions.list) do
		local z1 = e.zones and e.zones[1]
		if not e.reno and e.id ~= "zone_base" and z1 and (z1.floor or 0) == 0 and not data.zones[e.id] then
			local ready = true
			for _, req in ipairs(e.requires or {}) do
				if not data.zones[req] then
					ready = false
				end
			end
			if ready then
				Scene.forSale(f.shell, e, plot.id)
			end
		end
	end
	-- the supplier tablet and menu board are per restaurant
	for _, d in ipairs(f.shell:GetDescendants()) do
		local uid = d:GetAttribute("Uid")
		if uid == "fixed_supplier" or uid == "fixed_menu" then
			d:SetAttribute("Uid", uid .. "_" .. plot.id)
			d:SetAttribute("PlotId", plot.id)
		end
	end
	Core.S.Plots.shift(f.shell, plot)
	plot.folder:SetAttribute("City", data.franchise and data.franchise.city or "tokyo")
	plot.folder:SetAttribute("Ready", true)
	World.Rebuilt:Fire(plot)
end

-- the owner left: back to an empty lot
function World.clear(plot)
	plot.geo = nil
	plot.openLabel = nil
	local f = World.folders(plot)
	f.items:ClearAllChildren()
	f.dynamic:ClearAllChildren()
	plot.folder:SetAttribute("Ready", false)
	buildEmptyLot(plot)
	World.Rebuilt:Fire(plot)
end

function World.Init()
	Registry.load()
	street = folder("Street", workspace)
	npcFolder = folder("NPCs", workspace)
	pcall(function()
		PhysicsService:RegisterCollisionGroup("Shell")
		PhysicsService:RegisterCollisionGroup("NPC")
		PhysicsService:RegisterCollisionGroup("Player")
		PhysicsService:CollisionGroupSetCollidable("NPC", "NPC", false)
		PhysicsService:CollisionGroupSetCollidable("NPC", "Player", false)
		PhysicsService:CollisionGroupSetCollidable("Player", "Player", false)
	end)
	-- geometry of a brand-new restaurant (used before an owner's data arrives)
	emptyGeo = Geometry.compute(Expansions.list, { zone_base = true }, Expansions)
end

function World.Start()
	local Plots = Core.S.Plots
	if not streetBuilt then
		buildStreet(World.city)
	end
	for _, plot in ipairs(Plots.list) do
		if not plot.owner then
			buildEmptyLot(plot)
		end
	end
	workspace:SetAttribute("WorldReady", true)
	Plots.Claimed:Connect(function(plot, _, data)
		World.rebuild(plot, data)
	end)
	Plots.Released:Connect(function(plot)
		World.clear(plot)
	end)
	local players = game:GetService("Players")
	local function setGroup(character)
		for _, d in ipairs(character:GetDescendants()) do
			if d:IsA("BasePart") then
				d.CollisionGroup = "Player"
			end
		end
		character.DescendantAdded:Connect(function(d)
			if d:IsA("BasePart") then
				d.CollisionGroup = "Player"
			end
		end)
	end
	local function onPlayer(p)
		p.CharacterAdded:Connect(setGroup)
		if p.Character then
			setGroup(p.Character)
		end
	end
	players.PlayerAdded:Connect(onPlayer)
	for _, p in ipairs(players:GetPlayers()) do
		onPlayer(p)
	end
end

return World
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="StarterPlayer" referent="RBX000144"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX000143"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX000142"><Properties><string name="Name">Client</string></Properties><Item class="Folder" referent="RBX000117"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX000101"><Properties><string name="Name">Ambient</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Client-only animations: swaying lanterns and noren, maneki-neko paws, koi, shishi-odoshi,
-- streamers, and the evening train on the viaduct.
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Registry = require(Shared.Models.Registry)
local Expansions = require(Shared.Config.Expansions)
local Core = require(script.Parent.Parent.Core)

local Ambient = {}
local parts = {} -- [part] = { kind, base, last, phase }
local rng = Random.new()

local function track(d)
	if d:IsA("BasePart") and d:GetAttribute("Animate") then
		parts[d] = { kind = d:GetAttribute("Animate"), base = d.CFrame, last = d.CFrame, phase = rng:NextNumber() * 10 }
	end
end

local function offset(info, part, tt)
	local k, ph = info.kind, info.phase
	local h = part.Size.Y
	if k == "sway" then
		return CFrame.new(0, h / 2, 0) * CFrame.Angles(math.sin(tt * 1.3 + ph) * 0.035, 0, math.sin(tt * 1.7 + ph) * 0.05) * CFrame.new(0, -h / 2, 0)
	elseif k == "paw" then
		return CFrame.new(0, -h / 2, 0) * CFrame.Angles(math.sin(tt * 4 + ph) * 0.45, 0, 0) * CFrame.new(0, h / 2, 0)
	elseif k == "fish" or k == "koi" then
		local r = k == "koi" and 1.4 or 0.9
		local a = tt * (k == "koi" and 0.5 or 0.8) + ph
		return CFrame.new(math.sin(a) * r, math.sin(tt * 2 + ph) * 0.05, math.cos(a) * r * 0.6) * CFrame.Angles(0, a + math.pi / 2, 0)
	elseif k == "shishi" then
		local cycle = (tt + ph) % 7
		local tilt = cycle < 5.5 and (cycle / 5.5) * 0.5 or 0.5 - (cycle - 5.5) / 1.5 * 0.5
		return CFrame.Angles(0, 0, -tilt)
	elseif k == "streamer" then
		return CFrame.Angles(0, math.sin(tt * 2 + ph) * 0.25, math.sin(tt * 3.2 + ph) * 0.12)
	end
	return CFrame.new()
end

local function runTrain()
	local S = Registry.Street
	if not S then
		return
	end
	local train = S.train(4)
	train.Parent = workspace.CurrentCamera
	local Audio = Core.C.Audio
	local sound = Audio and Audio.attachTrain(train.PrimaryPart or train:FindFirstChildWhichIsA("BasePart"))
	while true do
		local dir = rng:NextNumber() < 0.5 and 1 or -1
		local reach = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Config.Plots).StreetReach
		local x0, x1 = -(reach + 280) * dir, (reach + 280) * dir
		local t0 = os.clock()
		local duration = 22
		if sound then
			sound.TimePosition = 0
			sound.Volume = Audio.trainVolume()
			sound:Play()
		end
		while os.clock() - t0 < duration do
			local k = (os.clock() - t0) / duration
			local L = Expansions.Street
			train:PivotTo(CFrame.new(x0 + (x1 - x0) * k, L.railY + 0.8 + 2.5, L.railZ) * CFrame.Angles(0, dir > 0 and math.pi or 0, 0))
			task.wait()
		end
		train:PivotTo(CFrame.new(0, -200, 0))
		if sound then
			sound:Stop()
		end
		task.wait(rng:NextNumber() * 40 + 35)
	end
end

function Ambient.Start()
	Registry.load()
	for _, d in ipairs(workspace:GetDescendants()) do
		track(d)
	end
	workspace.DescendantAdded:Connect(track)
	workspace.DescendantRemoving:Connect(function(d)
		parts[d] = nil
	end)
	RunService.RenderStepped:Connect(function()
		local cam = workspace.CurrentCamera
		local camPos = cam and cam.CFrame.Position or Vector3.new()
		local tt = os.clock()
		for part, info in pairs(parts) do
			if part.Parent then
				-- the server moved/rebuilt the part: take the new base
				if part.CFrame ~= info.last then
					info.base = part.CFrame
				end
				if (info.base.Position - camPos).Magnitude < 110 then
					local cf = info.base * offset(info, part, tt)
					part.CFrame = cf
					info.last = cf
				end
			else
				parts[part] = nil
			end
		end
	end)
	task.spawn(runTrain)
end

return Ambient
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000102"><Properties><string name="Name">Audio</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Sound: one-shot effects (2D or positional, random take and pitch), the sound patterns of the
-- cooking steps (knife chops in rhythm, broth pouring, noodles drained...), ambience loops mixed
-- from where you are (street outside, chatter that grows with the customers, bubbling pots, the
-- train) and a day / evening music playlist.
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local ContentProvider = game:GetService("ContentProvider")
local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local AudioCfg = require(Shared.Config.Audio)
local Core = require(script.Parent.Parent.Core)

local Audio = {}
local rng = Random.new()
local loops = {} -- [name] = Sound for 2D ambience
local attached = {} -- [Model] = Sound for bubbling pots and cookers
local music, musicList, musicIndex = nil, nil, 0

local function settings()
	return Core.C.Data and Core.C.Data.m and Core.C.Data.m("settings") or {}
end

local function volume(kind)
	local s = settings() or {}
	if kind == "music" then
		return (s.music or 0.5) * AudioCfg.Volume.music
	elseif kind == "ambience" then
		return (s.sfx or 0.8) * AudioCfg.Volume.ambience
	end
	return (s.sfx or 0.8) * AudioCfg.Volume.sfx
end

local function pick(list)
	return list[rng:NextInteger(1, #list)]
end

local function fadeOut(s, after, time)
	task.delay(after, function()
		if s.Parent then
			TweenService:Create(s, TweenInfo.new(time or 0.25), { Volume = 0 }):Play()
			task.wait((time or 0.25) + 0.05)
			s:Stop()
		end
	end)
end

-- Plays effect `name`; pos (Vector3) makes it positional. opts: volume (multiplier), len, pitch
function Audio.play(name, pos, opts)
	local cfg = AudioCfg.Sfx[name]
	if not cfg or not cfg.ids or #cfg.ids == 0 then
		return
	end
	local vol = volume("sfx") * (cfg.volume or 1) * (opts and opts.volume or 1)
	if vol <= 0 then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = pick(cfg.ids)
	s.Volume = vol
	local p = cfg.pitch or { 0.96, 1.05 }
	s.PlaybackSpeed = (opts and opts.pitch) or (p[1] + (p[2] - p[1]) * rng:NextNumber())
	if cfg.start then
		s.TimePosition = cfg.start
	end
	local len = (opts and opts.len) or cfg.len
	if pos then
		local att = Instance.new("Attachment")
		att.WorldPosition = pos
		att.Parent = workspace.Terrain
		s.RollOffMode = Enum.RollOffMode.InverseTapered
		s.RollOffMinDistance = 6
		s.RollOffMaxDistance = cfg.range or 60
		s.Parent = att
		s.Ended:Connect(function()
			att:Destroy()
		end)
		task.delay(math.max(len or 0, 8), function()
			if att.Parent then
				att:Destroy()
			end
		end)
	else
		s.Parent = SoundService
		s.Ended:Connect(function()
			s:Destroy()
		end)
		task.delay(math.max(len or 0, 8), function()
			if s.Parent then
				s:Destroy()
			end
		end)
	end
	s:Play()
	if len then
		fadeOut(s, len, 0.25)
	end
	return s
end

-- Sound pattern of one cooking step lasting `dur` seconds at `pos`
function Audio.step(name, dur, pos)
	local cfg = AudioCfg.Steps[name]
	if not cfg then
		return
	end
	dur = math.max(0.3, dur or 1)
	if cfg.hit then
		-- knife: quick chops in rhythm with the animation
		local n = cfg.hits or 4
		for k = 0, n - 1 do
			task.delay(dur * (k + 0.5) / n, function()
				Audio.play(cfg.hit, pos)
			end)
		end
		return
	end
	if cfg.first then
		Audio.play(cfg.first, pos, { len = math.max(0.6, dur + 0.2) })
	end
	if cfg.last then
		task.delay(math.max(0.2, dur - 0.35), function()
			Audio.play(cfg.last, pos)
		end)
	end
end

------------------------------------------------------------------ ambience

local function loop2d(name)
	local cfg = AudioCfg.Ambience[name]
	if not cfg or not cfg.id or cfg.id == "" then
		return nil
	end
	if not loops[name] then
		local s = Instance.new("Sound")
		s.Name = "Ambience_" .. name
		s.SoundId = cfg.id
		s.Looped = true
		s.Volume = 0
		s.Parent = SoundService
		s:Play()
		loops[name] = s
	end
	return loops[name], cfg
end

local function setLoop(name, target)
	local s, cfg = loop2d(name)
	if not s then
		return
	end
	local v = target * (cfg.volume or 1) * volume("ambience")
	TweenService:Create(s, TweenInfo.new(1.2), { Volume = v }):Play()
end

local function customersInside()
	local n = 0
	for _, m in ipairs(CollectionService:GetTagged("Interactable")) do
		if m:GetAttribute("Kind") == "customer" then
			local st = m:GetAttribute("State")
			if st == "order" or st == "waiting" or st == "eating" or st == "reading" then
				n += 1
			end
		end
	end
	return n
end

-- bubbling loops on pots with broth and on cookers that are cooking
local function updateAttached()
	local seen = {}
	local base = volume("ambience")
	for _, m in ipairs(CollectionService:GetTagged("Interactable")) do
		local kind = m:GetAttribute("Kind")
		if (kind == "pot" or kind == "ricecooker") and m.PrimaryPart then
			local cooking = (m:GetAttribute("C") or 0) > 0
			local has = (m:GetAttribute("N") or 0) > 0
			local on = cooking or (kind == "pot" and has)
			if on then
				seen[m] = true
				local s = attached[m]
				local cfg = AudioCfg.Ambience[kind == "pot" and "boil" or "cooker"]
				if not s and cfg then
					s = Instance.new("Sound")
					s.SoundId = cfg.id
					s.Looped = true
					s.RollOffMode = Enum.RollOffMode.InverseTapered
					s.RollOffMinDistance = 4
					s.RollOffMaxDistance = cfg.range or 24
					s.TimePosition = rng:NextNumber() * 8
					s.Volume = 0
					s.Parent = m.PrimaryPart
					s:Play()
					attached[m] = s
				end
				if s and cfg then
					s.Volume = base * (cfg.volume or 0.3) * (cooking and 1.25 or 0.8)
				end
			end
		end
	end
	for m, s in pairs(attached) do
		if not seen[m] or not m.Parent then
			s:Destroy()
			attached[m] = nil
		end
	end
end

local function ambienceLoop()
	while true do
		local Camera = Core.C.Camera
		local inside = Camera and Camera.isIndoors and Camera.isIndoors() or false
		local day = Core.C.Data and Core.C.Data.day or {}
		setLoop("street", inside and 0.35 or 1)
		local crowd = math.clamp(customersInside() / 8, 0, 1)
		if day.phase ~= "open" then
			crowd = 0
		end
		setLoop("restaurant", crowd * (inside and 1 or 0.35))
		updateAttached()
		task.wait(0.6)
	end
end

-- the train on the viaduct carries its own sound
function Audio.attachTrain(part)
	local cfg = AudioCfg.Ambience.train
	if not cfg or not part then
		return nil
	end
	local s = Instance.new("Sound")
	s.SoundId = cfg.id
	s.Looped = true
	s.RollOffMode = Enum.RollOffMode.InverseTapered
	s.RollOffMinDistance = 30
	s.RollOffMaxDistance = cfg.range or 300
	s.Volume = 0
	s.Parent = part
	return s
end

function Audio.trainVolume()
	local cfg = AudioCfg.Ambience.train
	return volume("ambience") * (cfg and cfg.volume or 0.6)
end

------------------------------------------------------------------ music

local function nextTrack()
	local night = game:GetService("Lighting").ClockTime >= 18.5 or game:GetService("Lighting").ClockTime < 6
	local list = night and AudioCfg.Music.night or AudioCfg.Music.day
	if list ~= musicList then
		musicList = list
		musicIndex = rng:NextInteger(0, math.max(0, #list - 1))
	end
	if #list == 0 then
		return nil
	end
	musicIndex = musicIndex % #list + 1
	return list[musicIndex]
end

local function playNext()
	local id = nextTrack()
	if not id then
		return
	end
	music.SoundId = id
	music.TimePosition = 0
	music:Play()
end

local function preload()
	local list = {}
	for _, cfg in pairs(AudioCfg.Sfx) do
		for _, id in ipairs(cfg.ids or {}) do
			local s = Instance.new("Sound")
			s.SoundId = id
			table.insert(list, s)
		end
	end
	pcall(function()
		ContentProvider:PreloadAsync(list)
	end)
	for _, s in ipairs(list) do
		s:Destroy()
	end
end

function Audio.Start()
	task.spawn(preload)
	task.spawn(ambienceLoop)
	music = Instance.new("Sound")
	music.Name = "Music"
	music.Looped = false
	music.Parent = SoundService
	music.Ended:Connect(function()
		task.wait(2)
		playNext()
	end)
	playNext()
	local wasNight = nil
	while true do
		local clock = game:GetService("Lighting").ClockTime
		local night = clock >= 18.5 or clock < 6
		if wasNight ~= nil and night ~= wasNight then
			-- evening falls (or morning comes): fade into the other playlist
			TweenService:Create(music, TweenInfo.new(2), { Volume = 0 }):Play()
			task.wait(2.1)
			playNext()
		end
		wasNight = night
		music.Volume = volume("music")
		task.wait(2)
	end
end


return Audio
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000103"><Properties><string name="Name">Build</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Build mode: ghost preview on a 1/5/10 stud grid, rotation, local validation (same rules as the
-- server), placing, moving, storing and selling objects.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")
local GuiService = game:GetService("GuiService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local GameConfig = require(Shared.Config.GameConfig)
local Items = require(Shared.Config.Items)
local Expansions = require(Shared.Config.Expansions)
local Grid = require(Shared.Logic.Grid)
local Geometry = require(Shared.Logic.Geometry)
local PlacementLogic = require(Shared.Logic.Placement)
local Registry = require(Shared.Models.Registry)
local Color = require(Shared.Util.Color)
local Signal = require(Shared.Util.Signal)
local Core = require(script.Parent.Parent.Core)

local Build = {}
Build.active = false
Build.mode = nil -- "new" | "inventory" | "move"
Build.itemId = nil
Build.moveUid = nil
Build.rot = 0
Build.grid = 1
Build.selected = nil
Build.valid = false
Build.reason = nil
Build.Changed = Signal.new()

local player = Players.LocalPlayer
local ghost, highlight, hoverHighlight
local geo, geoKey = nil, nil
local lastReq, lastValidate = nil, 0
local gridParts = {}
local touchPos = nil
local worldTouch = nil
local lastResolved = nil

-- the restaurant you build in (your own, or one you co-manage): its items folder and origin.
-- Requests and validation use restaurant-local coordinates (world minus the plot origin).
local function itemsFolder()
	local r = Core.C.Data.plotFolder()
	return r and r:FindFirstChild("Items")
end

local function ox()
	return Core.C.Data.origin().X
end

local function geometry()
	local zones = Core.C.Data.w("zones") or { zone_base = true }
	local key = ""
	for id in pairs(zones) do
		key ..= id .. ";"
	end
	if key ~= geoKey then
		geo = Geometry.compute(Expansions.list, zones, Expansions)
		geoKey = key
	end
	return geo
end

function Build.geometry()
	return geometry()
end

local function ctx()
	local placed = Core.C.Data.w("placed") or {}
	return Geometry.ctx(geometry(), Items.byId, placed, GameConfig)
end

local function floorY(f)
	return (f or 0) * GameConfig.FloorHeight
end

local function worldY(entry, item)
	if entry.s == "f" then
		return floorY(entry.f)
	elseif entry.s == "c" then
		return floorY(entry.f) + GameConfig.WallHeight - item.size[2]
	elseif entry.s == "w" then
		return (entry.y or floorY(entry.f) + 6) - item.size[2] / 2
	end
	return entry.y or floorY(entry.f)
end

------------------------------------------------------------------ ghost & grid

local function clearGhost()
	if ghost then
		ghost:Destroy()
		ghost = nil
	end
	for _, p in ipairs(gridParts) do
		p.Transparency = 1
	end
end

local function makeGhost(itemId)
	clearGhost()
	Registry.load()
	local world = Core.C.Data.restaurant()
	ghost = Registry.build(itemId, { styles = Expansions.styles(world.zones) })
	for _, d in ipairs(ghost:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.CastShadow = false
			if d.Transparency < 1 then
				d.Transparency = math.max(d.Transparency, 0.35)
			end
		elseif d:IsA("Light") or d:IsA("ParticleEmitter") then
			d.Enabled = false
		end
	end
	ghost.Parent = workspace.CurrentCamera
	highlight.Adornee = ghost
	highlight.Enabled = true
end

local function gridLine(i)
	local p = gridParts[i]
	if not p then
		p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Material = Enum.Material.Neon
		p.Color = Color.hex("#FFF4D6")
		p.Transparency = 1
		p.Parent = workspace.CurrentCamera
		gridParts[i] = p
	end
	return p
end

local function drawGrid(cx, cz, y, g)
	local radius = math.clamp(g * 6, 8, 40)
	local x0 = Grid.snapValue(cx - radius, g)
	local z0 = Grid.snapValue(cz - radius, g)
	local n = math.floor(radius * 2 / g)
	local i = 0
	for k = 0, n do
		i += 1
		local p = gridLine(i)
		p.Size = Vector3.new(0.06, 0.03, radius * 2)
		p.CFrame = CFrame.new(x0 + k * g, y + 0.04, cz)
		p.Transparency = 0.55
		i += 1
		local q = gridLine(i)
		q.Size = Vector3.new(radius * 2, 0.03, 0.06)
		q.CFrame = CFrame.new(cx, y + 0.04, z0 + k * g)
		q.Transparency = 0.55
	end
	for k = i + 1, #gridParts do
		gridParts[k].Transparency = 1
	end
end

------------------------------------------------------------------ raycasting

local function cursor()
	if touchPos then
		return touchPos
	end
	return UserInputService:GetMouseLocation()
end

local function cursorRay()
	local cam = workspace.CurrentCamera
	local pos = cursor()
	return cam:ViewportPointToRay(pos.X, pos.Y)
end

-- Where the pointer meets the horizontal plane at height y (nil when looking away from it)
local function planeHit(y)
	local ray = cursorRay()
	if math.abs(ray.Direction.Y) < 1e-4 then
		return nil
	end
	local d = (y - ray.Origin.Y) / ray.Direction.Y
	if d <= 0 or d > 600 then
		return nil
	end
	return ray.Origin + ray.Direction * d
end

local function cast(includeParts)
	local cam = workspace.CurrentCamera
	local pos = cursor()
	local ray = cam:ViewportPointToRay(pos.X, pos.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = includeParts
	return workspace:Raycast(ray.Origin, ray.Direction * 400, params)
end

local function ownerModel(inst)
	local folder = itemsFolder()
	while inst and inst.Parent and inst.Parent ~= folder do
		inst = inst.Parent
	end
	if inst and inst.Parent == folder then
		return inst
	end
	return nil
end

local function onFloor(tagName)
	local floor = Core.C.Camera.floor or 0
	local plot = Core.C.Data.plotFolder()
	local out = {}
	for _, p in ipairs(CollectionService:GetTagged(tagName)) do
		local f = p:GetAttribute("FloorIndex") or 0
		if f == floor and plot and p:IsDescendantOf(plot) then
			table.insert(out, p)
		end
	end
	return out
end

local function buildRequest()
	local item = Items.byId[Build.itemId]
	if not item then
		return nil
	end
	local code = PlacementLogic.PlaceCode[item.place]
	local w, h, d = item.size[1], item.size[2], item.size[3]
	local g = Build.grid
	if code == "c" then
		-- ceiling objects hang in the air: aim at their own height, so they sit under the pointer
		local f = Core.C.Camera.floor or 0
		local p = planeHit(floorY(f) + GameConfig.WallHeight - h / 2)
		if not p then
			return nil
		end
		local x, z = Grid.snapFloor(p.X - ox(), p.Z, w, d, Build.rot, g)
		return { i = item.id, x = x, z = z, r = Build.rot, f = f, s = code }
	elseif code == "f" then
		local hit = cast(onFloor("Floor"))
		local f, px, pz
		if hit then
			f = hit.Instance:GetAttribute("FloorIndex") or 0
			px, pz = hit.Position.X, hit.Position.Z
		else
			-- pointer over a wall or the sky: use the floor plane of the current storey
			f = Core.C.Camera.floor or 0
			local p = planeHit(floorY(f))
			if not p then
				return nil
			end
			px, pz = p.X, p.Z
		end
		if f < 0 then
			return nil
		end
		local x, z = Grid.snapFloor(px - ox(), pz, w, d, Build.rot, g)
		return { i = item.id, x = x, z = z, r = Build.rot, f = f, s = code }
	elseif code == "w" then
		local hit = cast(onFloor("Wall"))
		if not hit or hit.Instance:GetAttribute("Rail") then
			return nil
		end
		local f = hit.Instance:GetAttribute("FloorIndex") or 0
		local n = hit.Normal
		local alongX = math.abs(n.Z) > math.abs(n.X)
		local hx = hit.Position.X - ox()
		local along = alongX and hx or hit.Position.Z
		local a, y = Grid.snapWall(along, hit.Position.Y, w, h, g, floorY(f))
		local off = 0.4 + d / 2 + 0.05
		local x = alongX and a or hx + n.X * off
		local z = alongX and hit.Position.Z + n.Z * off or a
		return { i = item.id, x = x, z = z, y = y, r = 0, f = f, s = code }
	elseif code == "t" then
		local folder = itemsFolder()
		if not folder then
			return nil
		end
		local hit = cast({ folder })
		local model = hit and ownerModel(hit.Instance)
		if not model then
			return nil
		end
		local kind = model:GetAttribute("Kind")
		if kind ~= "counter" and kind ~= "table" and kind ~= "booth" then
			return nil
		end
		local uid = model:GetAttribute("Uid")
		local parent = nil
		for _, e in ipairs(Core.C.Data.w("placed") or {}) do
			if e.u == uid then
				parent = e
			end
		end
		if not parent then
			return nil
		end
		local x, z = Grid.snapFloor(hit.Position.X - ox(), hit.Position.Z, w, d, Build.rot, math.min(g, 0.5))
		return { i = item.id, x = x, z = z, r = Build.rot, f = parent.f or 0, s = "t", p = uid }
	end
	return nil
end

local function sameReq(a, b)
	if not a or not b then
		return false
	end
	return a.x == b.x and a.z == b.z and a.r == b.r and a.f == b.f and a.y == b.y and a.p == b.p and a.i == b.i
end

local function step()
	if not Build.active then
		return
	end
	if not ghost then
		-- selection hover
		local folder = itemsFolder()
		if folder and not touchPos then
			local hit = cast({ folder })
			local model = hit and ownerModel(hit.Instance)
			hoverHighlight.Adornee = model
			hoverHighlight.Enabled = model ~= nil
		end
		return
	end
	local req = buildRequest()
	if not req then
		Build.valid = false
		Build.reason = "msg.place_point"
		ghost.Parent = nil
		Build.Changed:Fire()
		return
	end
	ghost.Parent = workspace.CurrentCamera
	if Build.mode == "move" then
		req.u = Build.moveUid
	end
	local item = Items.byId[req.i]
	if not sameReq(req, lastReq) or os.clock() - lastValidate > 1 then
		lastReq = req
		lastValidate = os.clock()
		local ok, reason, resolved = PlacementLogic.validate(ctx(), req)
		Build.valid = ok
		Build.reason = reason
		lastResolved = resolved
		Build.Changed:Fire()
	end
	local r = lastResolved or req
	local pos = { x = r.x, z = r.z, r = r.r or req.r, y = r.y, f = r.f or req.f, s = req.s }
	Registry.place(ghost, pos.x + ox(), worldY(pos, item), pos.z, pos.r)
	highlight.FillColor = Build.valid and Color.hex("#6DDC5A") or Color.hex("#FF3B4A")
	highlight.OutlineColor = highlight.FillColor
	drawGrid(req.x + ox(), req.z, floorY(req.f), Build.grid)
end

------------------------------------------------------------------ actions

function Build.place()
	if not ghost or not Build.valid or not lastResolved then
		if Build.reason then
			Core.C.UI.toast(Locale.t(Build.reason), "error")
		end
		return
	end
	local req = lastReq
	if Build.mode == "move" then
		NetDef.event("MoveItem"):FireServer(Build.moveUid, req)
		Build.cancel()
	else
		NetDef.event("PlaceItem"):FireServer(req, Build.mode == "inventory")
		if Build.mode == "inventory" then
			local inv = Core.C.Data.w("inventory") or {}
			if (inv[Build.itemId] or 0) <= 1 then
				Build.cancel()
			end
		end
	end
	lastReq = nil
	if Core.C.Audio then
		Core.C.Audio.play("place")
	end
end

function Build.startPlace(itemId, fromInventory)
	if not Build.active then
		Build.enter()
	end
	Build.mode = fromInventory and "inventory" or "new"
	Build.itemId = itemId
	Build.moveUid = nil
	Build.selected = nil
	lastReq, lastResolved = nil, nil
	makeGhost(itemId)
	Build.Changed:Fire()
end

function Build.startMove(uid)
	for _, e in ipairs(Core.C.Data.w("placed") or {}) do
		if e.u == uid then
			Build.mode = "move"
			Build.itemId = e.i
			Build.moveUid = uid
			Build.rot = e.r or 0
			lastReq, lastResolved = nil, nil
			makeGhost(e.i)
			Build.Changed:Fire()
			return
		end
	end
end

function Build.cancel()
	Build.mode = nil
	Build.itemId = nil
	Build.moveUid = nil
	clearGhost()
	highlight.Enabled = false
	Build.Changed:Fire()
end

function Build.rotate()
	local s = Core.C.Data.m("settings")
	local stepDeg = s and s.rot or 90
	if Build.selected and not ghost then
		-- rotate a selected object in place
		for _, e in ipairs(Core.C.Data.w("placed") or {}) do
			if e.u == Build.selected then
				local req = { i = e.i, x = e.x, z = e.z, y = e.y, f = e.f, s = e.s, p = e.p, r = Grid.nextRotation(e.r or 0, stepDeg) }
				NetDef.event("MoveItem"):FireServer(e.u, req)
			end
		end
		return
	end
	Build.rot = Grid.nextRotation(Build.rot, stepDeg)
	lastReq = nil
end

function Build.cycleGrid()
	local sizes = GameConfig.GridSizes
	local idx = table.find(sizes, Build.grid) or 1
	Build.grid = sizes[idx % #sizes + 1]
	NetDef.event("SetSetting"):FireServer("grid", Build.grid)
	lastReq = nil
	Build.Changed:Fire()
end

function Build.setGrid(g)
	Build.grid = g
	NetDef.event("SetSetting"):FireServer("grid", g)
	lastReq = nil
	Build.Changed:Fire()
end

function Build.select(uid)
	Build.selected = uid
	Build.Changed:Fire()
end

function Build.removeSelected(mode)
	if Build.selected then
		NetDef.event("RemoveItem"):FireServer(Build.selected, mode)
		Build.selected = nil
		hoverHighlight.Enabled = false
		Build.Changed:Fire()
	end
end

function Build.enter()
	if not Core.C.Data.canBuild() then
		Core.C.UI.toast(Locale.t("msg.no_permission"), "error")
		return
	end
	Build.active = true
	local s = Core.C.Data.m("settings")
	Build.grid = s and s.grid or 1
	Core.C.Camera.setBuildView(true)
	Core.C.UI.open("Build")
	Build.Changed:Fire()
end

function Build.exit()
	Build.cancel()
	Build.active = false
	Build.selected = nil
	hoverHighlight.Enabled = false
	Core.C.Camera.setBuildView(false)
	Core.C.UI.close("Build")
	Build.Changed:Fire()
end

function Build.toggle()
	if Build.active then
		Build.exit()
	else
		Build.enter()
	end
end

local function clickedGui(pos)
	local objs = player.PlayerGui:GetGuiObjectsAtPosition(pos.X, pos.Y - GuiService:GetGuiInset().Y)
	for _, o in ipairs(objs) do
		if o.Visible and o.BackgroundTransparency < 1 then
			return true
		end
	end
	return false
end

function Build.Init()
	highlight = Instance.new("Highlight")
	highlight.FillTransparency = 0.55
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Enabled = false
	highlight.Parent = player:WaitForChild("PlayerGui")
	hoverHighlight = Instance.new("Highlight")
	hoverHighlight.FillTransparency = 0.8
	hoverHighlight.FillColor = Color.hex("#FFD23B")
	hoverHighlight.OutlineColor = Color.hex("#FFD23B")
	hoverHighlight.Enabled = false
	hoverHighlight.Parent = player.PlayerGui
end

function Build.Start()
	RunService.RenderStepped:Connect(function()
		local ok, err = pcall(step)
		if not ok then
			warn("[Build] " .. tostring(err))
		end
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not Build.active then
			return
		end
		if input.UserInputType == Enum.UserInputType.Touch then
			if processed then
				-- joystick, buttons and panels never move the object being placed
				return
			end
			worldTouch = input
			touchPos = Vector2.new(input.Position.X, input.Position.Y + GuiService:GetGuiInset().Y)
		end
		if processed then
			return
		end
		local kc = input.KeyCode
		if kc == Enum.KeyCode.R then
			Build.rotate()
		elseif kc == Enum.KeyCode.G then
			Build.cycleGrid()
		elseif kc == Enum.KeyCode.Q then
			if ghost then
				Build.cancel()
			else
				Build.exit()
			end
		elseif kc == Enum.KeyCode.X or kc == Enum.KeyCode.Delete then
			Build.removeSelected("sell")
		elseif kc == Enum.KeyCode.F then
			Build.removeSelected("store")
		elseif kc == Enum.KeyCode.M and Build.selected then
			Build.startMove(Build.selected)
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
			if clickedGui(UserInputService:GetMouseLocation()) then
				return
			end
			if ghost then
				Build.place()
			else
				local folder = itemsFolder()
				local hit = folder and cast({ folder })
				local model = hit and ownerModel(hit.Instance)
				Build.select(model and model:GetAttribute("Uid") or nil)
			end
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 and ghost then
			Build.cancel()
		elseif input.UserInputType == Enum.UserInputType.Touch and not ghost then
			local folder = itemsFolder()
			local hit = folder and cast({ folder })
			local model = hit and ownerModel(hit.Instance)
			Build.select(model and model:GetAttribute("Uid") or nil)
			hoverHighlight.Adornee = model
			hoverHighlight.Enabled = model ~= nil
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			touchPos = nil
		elseif input.UserInputType == Enum.UserInputType.Touch and Build.active and input == worldTouch then
			touchPos = Vector2.new(input.Position.X, input.Position.Y + GuiService:GetGuiInset().Y)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input == worldTouch then
			worldTouch = nil
		end
	end)
	Core.C.Data.Changed:Connect(function(_, key)
		if key == "placed" or key == "zones" or key == "all" then
			lastReq = nil
		end
	end)
end

return Build
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000104"><Properties><string name="Name">Camera</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Game camera (Settings → Camera): "auto" (default) picks "game" on phones and tablets and
-- "first" with a keyboard; or one of the three modes:
--   "first"  first person: mouse look, a crosshair in the middle, click / E on what you
--            look at (see Controllers/FirstPerson); Camera speed scales the mouse sensitivity
--   "game"   a smooth orbit camera that rotates slowly (right mouse drag, one-finger drag, ← →),
--            zooms with the wheel or a pinch, never ends up behind walls and hides the roof when
--            it rises above the ceiling while you are inside
--   "roblox" the standard Roblox camera
-- Also the build-mode top view and hiding roofs/ceilings while building.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")

local Core = require(script.Parent.Parent.Core)
local Footprint = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Logic.Footprint)

local Camera = {}
Camera.top = false
Camera.build = false
Camera.floor = 0
local height = 48
local conn = nil
local player = Players.LocalPlayer

-- orbit state (degrees, studs)
local orbit = { yaw = 0, pitch = 38, dist = 22, targetDist = 22 }
local MIN_DIST, MAX_DIST = 8, 48
local BASE_SENS = 0.16 -- degrees per pixel at speed 1 (the Roblox default is much faster)
local roofsHiddenByOrbit = false
local rotating = false
local touches = {}

local FLOOR_HEIGHT = 15

function Camera.currentFloor()
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return 0
	end
	return math.max(0, math.floor((root.Position.Y + 2) / FLOOR_HEIGHT))
end

-- hides roofs, ceilings and anything on the floors above `floor` (nil = show everything)
local function setRoofs(hidden, floor)
	for _, tagName in ipairs({ "Roof", "Ceiling" }) do
		for _, p in ipairs(CollectionService:GetTagged(tagName)) do
			if p:IsA("BasePart") then
				p.LocalTransparencyModifier = hidden and 1 or 0
			end
		end
	end
	for _, tagName in ipairs({ "Floor", "Wall" }) do
		for _, p in ipairs(CollectionService:GetTagged(tagName)) do
			if p:IsA("BasePart") then
				local f = p:GetAttribute("FloorIndex") or 0
				p.LocalTransparencyModifier = (hidden and floor and f > floor) and 1 or 0
			end
		end
	end
	local plot = Core.C.Data and Core.C.Data.plotFolder and Core.C.Data.plotFolder()
	local items = plot and plot:FindFirstChild("Items")
	if items then
		for _, m in ipairs(items:GetChildren()) do
			local above = hidden and floor and (m:GetAttribute("FloorIndex") or 0) > floor
			for _, d in ipairs(m:GetDescendants()) do
				if d:IsA("BasePart") then
					-- parts tagged Roof (canopies, cords right under the ceiling) hide like the roof
					local roofLike = hidden and CollectionService:HasTag(d, "Roof")
					d.LocalTransparencyModifier = (above or roofLike) and 1 or 0
				end
			end
		end
	end
end

local function settings()
	local s = Core.C.Data and Core.C.Data.m and Core.C.Data.m("settings") or {}
	return s or {}
end

-- "auto" (the default): third person on phones and tablets, first person with a keyboard
function Camera.mode()
	local m = settings().cam
	if m == "game" or m == "roblox" or m == "first" then
		return m
	end
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		return "game"
	end
	return "first"
end

-- the orbit camera drives the view (not in first person, not while building in first person)
local function useGameCamera()
	return Camera.mode() == "game"
end

function Camera.isFirstPerson()
	return Camera.mode() == "first" and not Camera.build and not Camera.top
end

local function sensitivity()
	return BASE_SENS * (settings().camSpeed or 1)
end

-- Ray from the focus point to the wanted camera position, stopping before walls
local function clearDistance(focus, dir, dist)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = { workspace.CurrentCamera }
	if player.Character then
		table.insert(ignore, player.Character)
	end
	local plots = workspace:FindFirstChild("Plots")
	for _, rest in ipairs(plots and plots:GetChildren() or {}) do
		for _, name in ipairs({ "Dynamic", "Items" }) do
			local f = rest:FindFirstChild(name)
			if f then
				table.insert(ignore, f)
			end
		end
	end
	local npcs = workspace:FindFirstChild("NPCs")
	if npcs then
		table.insert(ignore, npcs)
	end
	for _, p in ipairs(CollectionService:GetTagged("Roof")) do
		table.insert(ignore, p)
	end
	for _, p in ipairs(CollectionService:GetTagged("Ceiling")) do
		table.insert(ignore, p)
	end
	params.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(focus, dir * dist, params)
	if hit then
		return math.max(2, (hit.Position - focus).Magnitude - 0.8)
	end
	return dist
end

-- True when the player stands inside the restaurant they work in (an indoor room of their storey)
local function indoors(pos, floor)
	local Build = Core.C.Build
	local geo = Build and Build.geometry and Build.geometry()
	if not geo then
		return false
	end
	local lx = pos.X - Core.C.Data.origin().X
	for _, z in ipairs(geo.zones) do
		if z.floor == floor and not z.outdoor and Footprint.pointInRect(lx, pos.Z, z.rect) then
			return true
		end
	end
	return false
end

function Camera.isIndoors()
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	return root ~= nil and indoors(root.Position, Camera.currentFloor())
end

-- Applies the camera mode to the player (first person lock, zoom limits, camera type)
local applied = nil
function Camera.apply()
	local mode = Camera.mode()
	local key = mode .. (Camera.build and ":build" or "") .. (Camera.top and ":top" or "")
	if key == applied then
		return
	end
	applied = key
	local cam = workspace.CurrentCamera
	if mode == "first" and not Camera.build and not Camera.top then
		player.CameraMinZoomDistance = 0.5
		player.CameraMaxZoomDistance = 0.5
		player.CameraMode = Enum.CameraMode.LockFirstPerson
		cam.CameraType = Enum.CameraType.Custom
		cam.FieldOfView = 74
	else
		player.CameraMode = Enum.CameraMode.Classic
		player.CameraMaxZoomDistance = 60
		player.CameraMinZoomDistance = 6
		cam.FieldOfView = 70
		if not Camera.top then
			cam.CameraType = useGameCamera() and Enum.CameraType.Scriptable or Enum.CameraType.Custom
		end
	end
	if roofsHiddenByOrbit and not useGameCamera() and not Camera.build then
		roofsHiddenByOrbit = false
		setRoofs(false, nil)
	end
end

local function orbitLoop(dt)
	local cam = workspace.CurrentCamera
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root or Camera.top or not useGameCamera() then
		return
	end
	if cam.CameraType ~= Enum.CameraType.Scriptable then
		cam.CameraType = Enum.CameraType.Scriptable
	end
	-- keyboard rotation, slow and steady
	local turn = 0
	if not UserInputService:GetFocusedTextBox() then
		if UserInputService:IsKeyDown(Enum.KeyCode.Left) then
			turn -= 1
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.Right) then
			turn += 1
		end
	end
	orbit.yaw += turn * 70 * dt * (settings().camSpeed or 1)
	orbit.dist += (orbit.targetDist - orbit.dist) * math.min(1, dt * 8)
	local focus = root.Position + Vector3.new(0, 2.2, 0)
	local rot = CFrame.Angles(0, math.rad(orbit.yaw), 0) * CFrame.Angles(-math.rad(orbit.pitch), 0, 0)
	local dir = -rot.LookVector
	local dist = clearDistance(focus, dir, orbit.dist)
	local pos = focus + dir * dist
	cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(pos, focus), math.min(1, dt * 14))
	cam.Focus = CFrame.new(focus)
	-- roof off only when you are inside and the camera rises above this storey's ceiling
	-- (dollhouse view of the kitchen); from outside the roof and the facade always show
	if not Camera.build then
		local f = Camera.currentFloor()
		local above = pos.Y > f * FLOOR_HEIGHT + 13 and indoors(root.Position, f)
		if above ~= roofsHiddenByOrbit then
			roofsHiddenByOrbit = above
			Camera.applyRoofs(above, f)
		end
	end
end

local function topLoop()
	local cam = workspace.CurrentCamera
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local focus = root.Position
	local pos = focus + Vector3.new(0, height, height * 0.55)
	cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(pos, focus), 0.25)
end

function Camera.applyRoofs(hidden, floor)
	setRoofs(hidden, floor)
end

function Camera.setTop(on)
	Camera.top = on
	local cam = workspace.CurrentCamera
	if on then
		cam.CameraType = Enum.CameraType.Scriptable
		if not conn then
			conn = RunService.RenderStepped:Connect(topLoop)
		end
	else
		if conn then
			conn:Disconnect()
			conn = nil
		end
		cam.CameraType = useGameCamera() and Enum.CameraType.Scriptable or Enum.CameraType.Custom
	end
	Camera.apply()
end

function Camera.toggleTop()
	Camera.setTop(not Camera.top)
end

function Camera.setBuildView(on)
	Camera.build = on
	roofsHiddenByOrbit = nil
	Camera.floor = Camera.currentFloor()
	setRoofs(on, Camera.floor)
	if on and Camera.mode() == "first" then
		-- building needs the mouse and a view from above
		Camera.setTop(true)
	elseif not on and Camera.top then
		Camera.setTop(false)
	end
	Camera.apply()
end

function Camera.Start()
	RunService:BindToRenderStep("RamenCamera", Enum.RenderPriority.Camera.Value + 1, orbitLoop)
	Camera.apply()
	player.CharacterAdded:Connect(function(char)
		local root = char:WaitForChild("HumanoidRootPart", 10)
		if root then
			local _, y = root.CFrame:ToEulerAnglesYXZ()
			orbit.yaw = math.deg(y)
		end
		applied = nil
		Camera.apply()
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not useGameCamera() then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton2 and not (Core.C.Build and Core.C.Build.itemId) then
			rotating = true
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
		elseif input.UserInputType == Enum.UserInputType.Touch then
			touches[input] = input.Position
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton2 and rotating then
			rotating = false
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		elseif input.UserInputType == Enum.UserInputType.Touch then
			touches[input] = nil
		end
	end)
	UserInputService.InputChanged:Connect(function(input, processed)
		if Camera.top and input.UserInputType == Enum.UserInputType.MouseWheel then
			height = math.clamp(height - input.Position.Z * 4, 18, 95)
			return
		end
		if not useGameCamera() then
			return
		end
		local sens = sensitivity()
		if input.UserInputType == Enum.UserInputType.MouseMovement and rotating then
			orbit.yaw -= input.Delta.X * sens
			orbit.pitch = math.clamp(orbit.pitch + input.Delta.Y * sens, 12, 78)
		elseif input.UserInputType == Enum.UserInputType.MouseWheel and not processed then
			orbit.targetDist = math.clamp(orbit.targetDist - input.Position.Z * 3, MIN_DIST, MAX_DIST)
		elseif input.UserInputType == Enum.UserInputType.Touch and touches[input] then
			local count = 0
			for _ in pairs(touches) do
				count += 1
			end
			local last = touches[input]
			local delta = input.Position - last
			touches[input] = input.Position
			if count == 1 then
				-- one finger on the world: rotate (slower than the default camera)
				orbit.yaw -= delta.X * sens * 1.4
				orbit.pitch = math.clamp(orbit.pitch + delta.Y * sens * 1.4, 12, 78)
			elseif count == 2 then
				-- pinch: zoom
				local other
				for inp, p in pairs(touches) do
					if inp ~= input then
						other = p
					end
				end
				if other then
					local before = (last - other).Magnitude
					local after = (input.Position - other).Magnitude
					orbit.targetDist = math.clamp(orbit.targetDist - (after - before) * 0.08, MIN_DIST, MAX_DIST)
				end
			end
		end
	end)
	CollectionService:GetInstanceAddedSignal("Roof"):Connect(function(p)
		if Camera.build and p:IsA("BasePart") then
			p.LocalTransparencyModifier = 1
		end
	end)
	-- follow the player up and down the stairs while building; pick up camera setting changes
	while true do
		task.wait(1)
		Camera.apply()
		-- Settings → Camera speed also scales the mouse in first person and with the Roblox
		-- camera (on top of Roblox's own sensitivity); the orbit camera applies it itself
		local want = Camera.mode() == "game" and 1 or (settings().camSpeed or 1)
		if UserInputService.MouseDeltaSensitivity ~= want then
			UserInputService.MouseDeltaSensitivity = want
		end
		if Camera.build then
			local f = Camera.currentFloor()
			if f ~= Camera.floor then
				Camera.floor = f
			end
			setRoofs(true, Camera.floor)
		end
	end
end

return Camera
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000105"><Properties><string name="Name">Data</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Local copy of the player's profile ("me"), the data of the restaurant you work in when it is
-- not yours ("world"), session info (plot, role, plot origins), day state and tickets.
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Locale = require(Shared.Locale)
local PlotsCfg = require(Shared.Config.Plots)

local Data = {}
Data.me = nil
Data.world = nil
Data.session = { role = "visitor", plot = nil, home = nil, originX = 0, homeX = 0, plots = {} }
Data.day = { phase = "prep", clock = 9.5, day = 1 }
Data.tickets = {}
Data.Changed = Signal.new() -- (scope, key)
Data.DayChanged = Signal.new()
Data.TicketsChanged = Signal.new()
Data.SessionChanged = Signal.new()
Data.Ready = Signal.new()
Data.ready = false

-- the data of the restaurant you work in: your own profile, or the owner's restaurant keys when
-- you help in someone else's (Data.world is nil while you are at home)
function Data.restaurant()
	return Data.world or Data.me or {}
end

function Data.w(key)
	local w = Data.world or Data.me
	return w and w[key]
end

function Data.m(key)
	return Data.me and Data.me[key]
end

function Data.role()
	return Data.session and Data.session.role or "visitor"
end

-- the plot you work in (your own restaurant, or the one you help in)
function Data.plotId()
	return Data.session and Data.session.plot or nil
end

function Data.plotFolder(id)
	local plots = workspace:FindFirstChild("Plots")
	local pid = id or Data.plotId()
	return plots and pid and plots:FindFirstChild("Plot" .. pid) or nil
end

-- an attribute of the restaurant you work in (Rating, AmbienceTier, SinkPile, Likes, Seats)
function Data.plotAttr(name)
	local f = Data.plotFolder()
	return f and f:GetAttribute(name) or nil
end

-- world position of the plot you work in / of your own restaurant (local coordinates + origin)
function Data.origin()
	return Vector3.new(Data.session and Data.session.originX or 0, 0, 0)
end

function Data.homeOrigin()
	return Vector3.new(Data.session and Data.session.homeX or 0, 0, 0)
end

-- the plot a world position belongs to
function Data.plotAt(pos)
	local half = PlotsCfg.HalfWidth
	for _, p in ipairs(Data.session and Data.session.plots or {}) do
		if math.abs(pos.X - p.x) < half then
			return p
		end
	end
	return nil
end

-- true when a model belongs to the restaurant you work in
function Data.isMine(model)
	local id = model and model:GetAttribute("PlotId")
	return id ~= nil and id == Data.plotId()
end

function Data.canBuild()
	local r = Data.role()
	return r == "owner" or r == "comanager"
end

-- yen shown in the HUD: the restaurant wallet for owner/co-manager, own wallet for helpers
function Data.wallet()
	if Data.canBuild() then
		return Data.w("yen") or 0
	end
	return Data.m("yen") or 0
end

function Data.applyLanguage()
	local lang = Data.me and Data.me.settings and Data.me.settings.lang or "auto"
	if lang == "auto" then
		lang = Locale.resolve(Players.LocalPlayer.LocaleId)
	end
	Locale.set(lang)
end

function Data.Init()
	NetDef.event("DataChanged").OnClientEvent:Connect(function(scope, key, value)
		if scope == "me" then
			Data.me = Data.me or {}
			Data.me[key] = value
			if key == "settings" then
				Data.applyLanguage()
			end
		else
			Data.world = Data.world or {}
			Data.world[key] = value
		end
		Data.Changed:Fire(scope, key)
	end)
	-- the restaurant you work in changed (nil = your own)
	NetDef.event("WorldSnapshot").OnClientEvent:Connect(function(world)
		Data.world = world
		Data.Changed:Fire("all", "all")
	end)
	NetDef.event("DayState").OnClientEvent:Connect(function(state)
		Data.day = state
		Data.DayChanged:Fire(state)
	end)
	NetDef.event("Tickets").OnClientEvent:Connect(function(list)
		Data.tickets = list
		Data.TicketsChanged:Fire(list)
	end)
	NetDef.event("Session").OnClientEvent:Connect(function(info)
		Data.session = info
		Data.SessionChanged:Fire(info)
	end)
end

function Data.Start()
	local snap
	for _ = 1, 20 do
		local ok, result = pcall(function()
			return NetDef.func("GetSnapshot"):InvokeServer()
		end)
		if ok and result then
			snap = result
			break
		end
		task.wait(1)
	end
	if snap then
		Data.me = snap.me
		Data.world = snap.world
		if snap.session then
			Data.session = snap.session
		end
	end
	Data.applyLanguage()
	Data.ready = true
	Data.Ready:Fire()
	Data.Changed:Fire("all", "all")
	-- the world snapshot may arrive before the owner finished loading: refresh once more
	task.delay(4, function()
		local ok, result = pcall(function()
			return NetDef.func("GetSnapshot"):InvokeServer()
		end)
		if ok and result then
			Data.world = result.world
			if result.session then
				Data.session = result.session
				Data.SessionChanged:Fire(result.session)
			end
			Data.Changed:Fire("all", "all")
		end
	end)
end

return Data
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000106"><Properties><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Visual feedback for server events: money popups, review stars, level up confetti,
-- dish ready sparkles, construction dust, sounds.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Format = require(Shared.Util.Format)
local Color = require(Shared.Util.Color)
local Kit = require(Shared.Models.Kit)
local Registry = require(Shared.Models.Registry)
local Core = require(script.Parent.Parent.Core)
local RunService = game:GetService("RunService")

local Effects = {}
local player = Players.LocalPlayer

local function popup(pos, text, color, rise)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.Transparency = 1
	p.Size = Vector3.new(0.2, 0.2, 0.2)
	p.Position = pos
	p.Parent = workspace.CurrentCamera
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(200, 50)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Adornee = p
	gui.Parent = player.PlayerGui
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextScaled = true
	l.TextColor3 = color or Color.hex("#FFD23B")
	l.TextStrokeTransparency = 0.3
	l.FontFace = Font.new("rbxasset://fonts/families/FredokaOne.json")
	l.AutoLocalize = false
	l.Parent = gui
	TweenService:Create(p, TweenInfo.new(1.6, Enum.EasingStyle.Quad), { Position = pos + Vector3.new(0, rise or 3, 0) }):Play()
	TweenService:Create(l, TweenInfo.new(1.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	task.delay(1.7, function()
		gui:Destroy()
		p:Destroy()
	end)
end

-- coins fly from a point in the world to the wallet at the top of the screen, which then bounces
local function coinsToWallet(pos, amount)
	local root = Core.C.UI and Core.C.UI.root()
	local hud = Core.C.UI and Core.C.UI.screens.HUD
	local cam = workspace.CurrentCamera
	if not root or not hud or not hud.walletPoint or not cam then
		return
	end
	local screen, onScreen = cam:WorldToViewportPoint(pos)
	local target = hud.walletPoint()
	if not onScreen or not target then
		return
	end
	local inset = game:GetService("GuiService"):GetGuiInset()
	local from = Vector2.new(screen.X, screen.Y - inset.Y)
	local scale = root:FindFirstChildOfClass("UIScale")
	local k = scale and scale.Scale or 1
	local n = math.clamp(math.floor((amount or 0) / 15) + 3, 3, 8)
	for i = 1, n do
		task.delay((i - 1) * 0.05, function()
			local coin = Instance.new("TextLabel")
			coin.BackgroundTransparency = 1
			coin.Text = "🪙"
			coin.TextScaled = true
			coin.AutoLocalize = false
			coin.AnchorPoint = Vector2.new(0.5, 0.5)
			coin.Size = UDim2.fromOffset(30, 30)
			local jitter = Vector2.new(math.random(-24, 24), math.random(-16, 16))
			coin.Position = UDim2.fromOffset((from.X + jitter.X) / k, (from.Y + jitter.Y) / k)
			coin.ZIndex = 50
			coin.Parent = root
			local tw = TweenService:Create(coin, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UDim2.fromOffset(target.X / k, target.Y / k), Size = UDim2.fromOffset(18, 18) })
			tw:Play()
			tw.Completed:Connect(function()
				coin:Destroy()
				if hud.bumpWallet then
					hud.bumpWallet()
				end
			end)
		end)
	end
end

local function burst(pos, preset, count, color)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.Transparency = 1
	p.Size = Vector3.new(1, 1, 1)
	p.Position = pos
	p.Parent = workspace.CurrentCamera
	local e = Kit.particles(p, preset, { rate = 0, color = color, glow = 0.6 })
	e:Emit(count or 20)
	task.delay(3, function()
		p:Destroy()
	end)
end

local function confetti()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	for _, c in ipairs({ "#FF3B4A", "#FFD23B", "#3BC8FF", "#6DDC5A", "#F7B7C9" }) do
		burst(root.Position + Vector3.new(0, 4, 0), "sparkle", 18, c)
	end
end

------------------------------------------------------------------ flying products

-- a product model like the ones SupplyService puts on shelves (same size and resting rule)
local function product(item)
	Registry.load()
	local m = Registry.food("ingredient", item.g)
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CastShadow = false
		end
	end
	pcall(function()
		m:ScaleTo(item.s or 1)
	end)
	local target = item.cf * (item.rot and CFrame.Angles(0, math.rad(90), 0) or CFrame.new())
	m:PivotTo(target)
	local box, size = m:GetBoundingBox()
	local landing = target + Vector3.new(0, target.Position.Y - (box.Position.Y - size.Y / 2), 0)
	return m, landing
end

-- moves a model along a small arc, then calls done
local function arc(m, fromCf, toCf, dur, height, done)
	task.spawn(function()
		local t0 = os.clock()
		while m.Parent do
			local k = math.min(1, (os.clock() - t0) / dur)
			local e = k * k * (3 - 2 * k)
			m:PivotTo(fromCf:Lerp(toCf, e) + Vector3.new(0, math.sin(k * math.pi) * height, 0))
			if k >= 1 then
				break
			end
			RunService.RenderStepped:Wait()
		end
		if done then
			done()
		end
	end)
end

-- products leave the box one after the other and land on their spot (shelf grid, board...)
local function stock(data)
	local items = data.items or {}
	local step = data.step or 0.06
	local total = #items * step + 0.3
	for i, item in ipairs(items) do
		task.delay((i - 1) * step, function()
			local m, landing = product(item)
			local src = item.from or data.from
			local from = src and (CFrame.new(src) * landing.Rotation) or (landing + Vector3.new(0, 2, 0))
			m:PivotTo(from)
			m.Parent = workspace.CurrentCamera
			arc(m, from, landing, 0.28, 1, function()
				local Audio = Core.C.Audio
				if Audio then
					Audio.play("pop", landing.Position, { pitch = 1 + math.min(i, 20) * 0.015 })
				end
				-- stay until the real product appears in the same place
				task.delay(math.max(0.1, total - ((i - 1) * step + 0.28)) + 0.35, function()
					m:Destroy()
				end)
			end)
		end)
	end
end

-- a product taken from a shelf flies into your hands
local function take(data)
	if not data.item or not data.to then
		return
	end
	local m, landing = product(data.item)
	m:PivotTo(landing)
	m.Parent = workspace.CurrentCamera
	arc(m, landing, CFrame.new(data.to) * landing.Rotation, 0.25, 0.6, function()
		m:Destroy()
	end)
end

-- Big "COMBO x3" banner in the middle of the screen
local comboLabel = nil
local function comboBanner(n, bonus)
	local root = Core.C.UI and Core.C.UI.root()
	if not root then
		return
	end
	if comboLabel then
		comboLabel:Destroy()
	end
	local l = Instance.new("TextLabel")
	l.AnchorPoint = Vector2.new(0.5, 0.5)
	l.Position = UDim2.fromScale(0.5, 0.3)
	l.Size = UDim2.fromOffset(420, 70)
	l.BackgroundTransparency = 1
	l.Text = Locale.t("ui.combo", { n = n, pct = math.floor((bonus or 0) * 100 + 0.5) })
	l.TextScaled = true
	l.TextColor3 = Color.hex(n >= 6 and "#FF5A3B" or "#FFD23B")
	l.TextStrokeTransparency = 0
	l.TextStrokeColor3 = Color.hex("#5B3A24")
	l.FontFace = Font.new("rbxasset://fonts/families/FredokaOne.json")
	l.AutoLocalize = false
	l.Rotation = -4
	l.Parent = root
	comboLabel = l
	local scale = Instance.new("UIScale")
	scale.Scale = 0.4
	scale.Parent = l
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(1.3, function()
		if l.Parent then
			TweenService:Create(l, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
			task.wait(0.45)
			l:Destroy()
		end
	end)
end

function Effects.Init()
	NetDef.event("Fx").OnClientEvent:Connect(function(kind, data)
		data = data or {}
		local Audio = Core.C.Audio
		if kind == "money" and data.pos then
			popup(data.pos, "+" .. Format.yen(data.amount or 0, Locale.get()), Color.hex("#FFD23B"))
			coinsToWallet(data.pos, data.amount)
			burst(data.pos, "sparkle", 12, "#FFD23B")
		elseif kind == "served" and data.pos then
			-- the customer is delighted: a smile and hearts
			popup(data.pos, "😋", nil, 2)
			burst(data.pos, "sparkle", 10, "#FF7A9A")
		elseif kind == "review" and data.pos then
			local stars = data.stars or 3
			popup(data.pos + Vector3.new(0, 1.2, 0), string.rep("★", math.floor(stars)) .. (stars % 1 >= 0.5 and "½" or ""), stars >= 4 and Color.hex("#FFD23B") or Color.hex("#FF8A5A"), 2)
		elseif kind == "levelup" then
			if data.userId == player.UserId or true then
				confetti()
			end
			if Audio then
				Audio.play("level")
				task.delay(0.4, function()
					Audio.play("sparkle")
				end)
			end
		elseif kind == "dishReady" and data.pos then
			burst(data.pos, "sparkle", 14)
			if Audio then
				Audio.play("bell", data.pos)
			end
		elseif kind == "ready" and data.pos then
			popup(data.pos + Vector3.new(0, 3, 0), "✅", Color.hex("#6DDC5A"), 1.5)
			if Audio then
				Audio.play("beep", data.pos)
			end
		elseif kind == "timing" and Core.C.Timing then
			Core.C.Timing.start(data)
		elseif kind == "timingResult" and Core.C.Timing then
			Core.C.Timing.result(data)
			if data.ok and data.pos then
				burst(data.pos + Vector3.new(0, 3, 0), "sparkle", 18, "#FFD23B")
			end
		elseif kind == "coins" then
			-- the tip jar is emptied: a shower of coins and the amount
			if data.pos then
				for _, c in ipairs({ "#FFD23B", "#F4C430", "#FFE08A" }) do
					burst(data.pos + Vector3.new(0, 1, 0), "sparkle", 16, c)
				end
				popup(data.pos + Vector3.new(0, 2, 0), "+" .. Format.yen(data.amount or 0, Locale.get()), Color.hex("#FFD23B"), 4)
			end
			if Audio then
				Audio.play("tip", data.pos)
				task.delay(0.25, function()
					Audio.play("tip", data.pos)
				end)
			end
		elseif kind == "stock" then
			stock(data)
		elseif kind == "take" then
			take(data)
		elseif kind == "washed" and data.uid then
			if Core.C.Sink then
				Core.C.Sink.washed(data.uid)
			end
		elseif kind == "step" and Audio then
			Audio.step(data.name, data.dur, data.pos)
		elseif kind == "combo" then
			comboBanner(data.n or 2, data.bonus)
			if data.pos then
				burst(data.pos, "sparkle", 10, "#FFD23B")
			end
			if Audio then
				Audio.play("combo", nil, { pitch = 1 + math.min(data.n or 2, 10) * 0.05 })
			end
		elseif kind == "sparkle" then
			confetti()
		elseif kind == "construction" then
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if root then
				burst(root.Position + Vector3.new(0, 6, 8), "smoke", 30, "#D8C8B0")
			end
			Core.C.UI.toast("🏗️ " .. Locale.t("msg.construction"), "info")
		elseif kind == "sfx" and Audio then
			Audio.play(data.name, data.pos)
		elseif kind == "action" then
			if Core.C.Tutorial then
				Core.C.Tutorial.onAction(data.kind, data.hands)
			end
		end
	end)
end

return Effects
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000107"><Properties><string name="Name">FirstPerson</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- First person (Settings → Camera, the default):
--   * a crosshair in the middle of the screen (the mouse arrow is hidden meanwhile); under it, what
--     clicking / E does on the object you look at (gold when close enough)
--   * what you hold is shown in front of the camera, with a light walking sway
--   * the mouse is freed while a menu is open, while building, while Alt is held or after Q
--     (Q again to look around); the first time a toast explains it
--   * keyboard shortcuts for the bottom buttons: B build, O supplier, P phone (all camera modes)
--   * the target's ProximityPrompt says what pressing does (tap it on touch screens)
--   * running: hold Shift, or the 🏃 button on touch screens (every camera mode)
--   * right mouse button puts down the box(es) you carry (in third person it turns the camera)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Locale = require(Shared.Locale)
local NetDef = require(Shared.Net)
local RewardsCfg = require(Shared.Config.Rewards)
local Kit = require(script.Parent.Parent.UI.Kit)
local Core = require(script.Parent.Parent.Core)

local FirstPerson = {}
local player = Players.LocalPlayer
local t = Locale.t
local T = Kit.Theme

local gui, dot, hintPill, hintText, modal, keysLabel, useButton, runButton
local altHeld = false
local cursorToggle = false
local toldAboutCursor = false
local shiftHeld = false
local runToggle = false
local views = {} -- [held model on the character] = { clone, rel }
local bob = 0

local function active()
	local Camera = Core.C.Camera
	return Camera ~= nil and Camera.isFirstPerson ~= nil and Camera.isFirstPerson()
end

-- true while the mouse must move freely (menus, building, Alt)
function FirstPerson.cursorFree()
	if altHeld or cursorToggle then
		return true
	end
	local UI = Core.C.UI
	if UI and UI.current then
		return true
	end
	if Core.C.Build and Core.C.Build.active then
		return true
	end
	return false
end

local function clearViews()
	for m, v in pairs(views) do
		v.clone:Destroy()
		views[m] = nil
	end
end

-- copies of the held items (the character itself is hidden in first person)
local function syncViews(char, hrp)
	for m, v in pairs(views) do
		if m.Parent ~= char then
			v.clone:Destroy()
			views[m] = nil
		end
	end
	for _, m in ipairs(char:GetChildren()) do
		if m:IsA("Model") and m:GetAttribute("Held") and not views[m] then
			local ok, clone = pcall(function()
				return m:Clone()
			end)
			if ok and clone then
				for _, d in ipairs(clone:GetDescendants()) do
					if d:IsA("JointInstance") or d:IsA("WeldConstraint") then
						d:Destroy()
					elseif d:IsA("SurfaceGui") or d:IsA("BillboardGui") then
						d.Enabled = true
					elseif d:IsA("BasePart") then
						d.Anchored = true
						d.CanCollide = false
						d.CanQuery = false
						d.CanTouch = false
						d.CastShadow = false
						d.LocalTransparencyModifier = 0
					end
				end
				clone.Parent = workspace.CurrentCamera
				-- boxes sit low (they are big); dishes and ingredients a little higher to stay in view
				local lift = m.Name == "Box" and 0 or 0.5
				views[m] = { clone = clone, rel = CFrame.new(0, lift, 0) * hrp.CFrame:ToObjectSpace(m:GetPivot()) }
			end
		end
	end
end

-- Roblox hides the character's parts in first person but not the labels drawn on them: the label
-- of the real box would float in the air, so it is switched off for you (only your copy shows it)
local function setHeldLabels(char, on)
	for _, m in ipairs(char:GetChildren()) do
		if m:IsA("Model") and m:GetAttribute("Held") then
			for _, d in ipairs(m:GetDescendants()) do
				if (d:IsA("SurfaceGui") or d:IsA("BillboardGui")) and d.Enabled ~= on then
					d.Enabled = on
				end
			end
		end
	end
end

local function updateViews(dt)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp or not active() then
		clearViews()
		if char then
			setHeldLabels(char, true)
		end
		return
	end
	syncViews(char, hrp)
	setHeldLabels(char, false)
	local cam = workspace.CurrentCamera
	local speed = Vector3.new(hrp.AssemblyLinearVelocity.X, 0, hrp.AssemblyLinearVelocity.Z).Magnitude
	local moving = speed > 1
	bob += dt * (moving and 9 or 1.6)
	local amp = moving and 0.05 or 0.015
	local base = cam.CFrame * CFrame.new(0.45 + math.cos(bob * 0.5) * amp, -2.05 + math.abs(math.sin(bob)) * amp, -0.9)
	for _, v in pairs(views) do
		v.clone:PivotTo(base * v.rel)
	end
end

local function updateCrosshair()
	local fp = active()
	if fp and not toldAboutCursor and UserInputService.KeyboardEnabled then
		toldAboutCursor = true
		task.delay(2, function()
			if Core.C.UI then
				Core.C.UI.toast("🖱️ " .. t("msg.fp_cursor"), "info")
			end
		end)
	end
	local free = FirstPerson.cursorFree()
	modal.Visible = fp and free
	local show = fp and not free
	dot.Visible = show
	-- the dot replaces the mouse arrow; the arrow comes back whenever the mouse is free
	if UserInputService.MouseIconEnabled == show then
		UserInputService.MouseIconEnabled = not show
	end
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	keysLabel.Visible = fp and not touch and not free
	local target = show and Core.C.Interaction and Core.C.Interaction.target and Core.C.Interaction.target()
	if target and target.text then
		-- close enough: the object's prompt says what E / a click / a tap does; too far: "get closer"
		hintPill.Visible = not target.near
		hintText.Text = "🚶 " .. t("hint.get_closer")
		dot.Size = UDim2.fromOffset(target.near and 14 or 10, target.near and 14 or 10)
		dot.BackgroundColor3 = target.near and T.gold or Color3.fromRGB(220, 214, 205)
	else
		hintPill.Visible = false
		dot.Size = UDim2.fromOffset(6, 6)
		dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	end
	-- the prompt is tappable: no extra use button on touch screens
	useButton.Visible = false
end

local function shortcut(key)
	local UI = Core.C.UI
	if key == Enum.KeyCode.B then
		if Core.C.Build then
			Core.C.Build.toggle()
		end
	elseif key == Enum.KeyCode.O then
		if Core.C.Build and Core.C.Build.active then
			return
		end
		UI.toggle("Supplier")
	elseif key == Enum.KeyCode.U then
		if Core.C.Build and Core.C.Build.active then
			return
		end
		UI.toggle("Shop")
	elseif key == Enum.KeyCode.P then
		if Core.C.Build and Core.C.Build.active then
			return
		end
		UI.toggle("Phone")
	elseif key == Enum.KeyCode.R then
		if Core.C.Build and Core.C.Build.active then
			return
		end
		UI.toggle("Gifts")
	elseif key == Enum.KeyCode.Q then
		-- (Q cancels in build mode)
		if Core.C.Build and Core.C.Build.active then
			return
		end
		cursorToggle = not cursorToggle
	end
end

-- walking speed from the server (shoes upgrade included) times the run multiplier
local function updateRun()
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	local base = player:GetAttribute("WalkSpeed")
	if not hum or not base then
		return
	end
	local running = shiftHeld or runToggle
	local want = running and base * (RewardsCfg.RunMultiplier or 1.4) or base
	if math.abs(hum.WalkSpeed - want) > 0.01 then
		hum.WalkSpeed = want
	end
	local touch = UserInputService.TouchEnabled
	local controls = game:GetService("GuiService").TouchControlsEnabled ~= false
	runButton.Visible = touch and controls and not (Core.C.Build and Core.C.Build.active)
	runButton.BackgroundColor3 = runToggle and T.green or T.paper
end

function FirstPerson.Init()
	gui = Kit.new("ScreenGui", { Name = "FirstPerson", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = -1, Parent = player:WaitForChild("PlayerGui") })
	dot = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(6, 6),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255), Visible = false, Parent = gui,
	}, { Kit.corner(8), Kit.stroke(Color3.fromRGB(30, 26, 24), 1.5, 0.2) })
	hintPill = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.5, 18), Size = UDim2.fromOffset(0, 32),
		AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = Color3.fromRGB(43, 35, 32), BackgroundTransparency = 0.15, Visible = false, Parent = gui,
	}, { Kit.corner(12), Kit.padding(12, 4) })
	hintText = Kit.label("", {
		Parent = hintPill, Size = UDim2.fromOffset(0, 24), AutomaticSize = Enum.AutomaticSize.X, TextSize = 17, FontFace = T.bold, TextWrapped = false,
		TextColor3 = Color3.fromRGB(244, 235, 221), TextYAlignment = Enum.TextYAlignment.Center,
	})
	keysLabel = Kit.label("", {
		Parent = gui, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -12, 1, -10), Size = UDim2.fromOffset(330, 60),
		TextSize = 13, FontFace = T.bold, TextColor3 = Color3.fromRGB(255, 255, 255), TextStrokeTransparency = 0.4, TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Right, TextYAlignment = Enum.TextYAlignment.Bottom, Visible = false,
	})
	-- a visible Modal button is what frees the mouse in first person
	modal = Kit.new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromOffset(0, 0), Modal = true, Visible = false, Parent = gui })
	useButton = Kit.new("TextButton", {
		AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -190), Size = UDim2.fromOffset(86, 86), Text = "✋",
		TextScaled = true, BackgroundColor3 = T.gold, Visible = false, Parent = gui,
	}, { Kit.corner(43), Kit.stroke(T.wood, 3, 0) })
	-- pressed = use (and start washing at a sink), released = stop washing
	useButton.MouseButton1Down:Connect(function()
		if Core.C.Interaction and Core.C.Interaction.act then
			Core.C.Interaction.act()
		end
	end)
	useButton.MouseButton1Up:Connect(function()
		if Core.C.Sink then
			Core.C.Sink.endHold()
		end
	end)
	-- run toggle: just left of Roblox's jump button (70 points at (1, -95, 1, -90) on small
	-- screens, 120 points at (1, -170, 1, -210) on bigger ones), clear of the orders above it
	runButton = Kit.new("TextButton", {
		AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -107, 1, -27), Size = UDim2.fromOffset(56, 56), Text = "🏃",
		TextScaled = true, BackgroundColor3 = T.paper, Visible = false, Parent = gui,
	}, { Kit.corner(28), Kit.stroke(T.wood, 3, 0), Kit.padding(8) })
	local function placeRun()
		local cam = workspace.CurrentCamera
		local v = cam and cam.ViewportSize or Vector2.new(844, 390)
		if math.min(v.X, v.Y) <= 500 then
			runButton.Size = UDim2.fromOffset(56, 56)
			runButton.Position = UDim2.new(1, -107, 1, -27)
		else
			runButton.Size = UDim2.fromOffset(76, 76)
			runButton.Position = UDim2.new(1, -186, 1, -96)
		end
	end
	placeRun()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(placeRun)
	end
	runButton.Activated:Connect(function()
		runToggle = not runToggle
	end)
	local function refreshKeys()
		keysLabel.Text = t("ui.fp_keys")
	end
	refreshKeys()
	Locale.Changed:Connect(refreshKeys)
end

function FirstPerson.Start()
	RunService.RenderStepped:Connect(function(dt)
		updateCrosshair()
		updateViews(dt)
		updateRun()
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if input.KeyCode == Enum.KeyCode.LeftAlt or input.KeyCode == Enum.KeyCode.RightAlt then
			altHeld = true
			return
		end
		if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
			shiftHeld = true
			return
		end
		if processed or UserInputService:GetFocusedTextBox() then
			return
		end
		-- right click puts the box down (only boxes: a dish dropped by mistake would be lost)
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			if active() and player:GetAttribute("HandsKind") == "box" then
				NetDef.event("DropHands"):FireServer()
			end
			return
		end
		shortcut(input.KeyCode)
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.LeftAlt or input.KeyCode == Enum.KeyCode.RightAlt then
			altHeld = false
		elseif input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
			shiftHeld = false
		end
	end)
	player.CharacterRemoving:Connect(clearViews)
end

return FirstPerson
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000108"><Properties><string name="Name">Hints</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- One-time tips after the tutorial, the first time something happens:
--   restock  an ingredient of the menu is running out on the shelves -> the supplier button
--   dishes   dirty dishes pile up in the sink -> the sink (done when it is empty)
--   shop     something in the shop can be bought -> the shop button
--   staff    the first member of staff can be hired -> the shop button
-- A tip is a small card above the buttons with an arrow (Pointer); it goes away after a few
-- seconds or when the thing is done, and never comes back (meta.hints, saved by the server).
-- Only one tip at a time, never during the tutorial or while a window is open.
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local TutorialCfg = require(Shared.Config.Tutorial)
local Recipes = require(Shared.Config.Recipes)
local StaffCfg = require(Shared.Config.Staff)
local Kit = require(script.Parent.Parent.UI.Kit)
local Pointer = require(script.Parent.Parent.UI.Pointer)
local Core = require(script.Parent.Parent.Core)

local Hints = {}
local player = Players.LocalPlayer
local t = Locale.t
local T = Kit.Theme
local CFG = TutorialCfg.Hints

local card, cardText, pointer
local current = nil -- { id, since }
local lastShown = -math.huge

local function dockButton(id)
	local hud = Core.C.UI.root():FindFirstChild("HUD")
	local dock = hud and hud:FindFirstChild("Dock")
	return dock and dock:FindFirstChild(id) or nil
end

local function mine(kind)
	for _, m in ipairs(CollectionService:GetTagged("Interactable")) do
		if m:GetAttribute("Kind") == kind and m:IsDescendantOf(workspace) and Core.C.Data.isMine(m) then
			return m
		end
	end
	return nil
end

-- portions on the shelves of every ingredient the dishes on the menu use
local function lowestOnMenu()
	local w = Core.C.Data.restaurant()
	local stock = {}
	for _, slots in pairs(w.shelves or {}) do
		for _, s in pairs(slots) do
			if s.g then
				stock[s.g] = (stock[s.g] or 0) + (s.n or 0)
			end
		end
	end
	local low = math.huge
	for id, m in pairs(w.menu or {}) do
		local r = Recipes.byId[id]
		if r and m.on and w.licenses and w.licenses[r.license] then
			for _, g in ipairs(r.ing) do
				low = math.min(low, stock[g] or 0)
			end
		end
	end
	return low
end

local function shopBadge()
	local b = dockButton("Shop")
	local badge = b and b:FindFirstChild("Badge")
	return badge ~= nil and badge.Visible
end

-- each tip: when it shows, where it points, when it is done
local TIPS = {
	{ id = "restock", key = "hint.first_restock", when = function()
		return lowestOnMenu() <= CFG.restock.shelfLeft
	end, gui = function()
		return dockButton("Supplier")
	end, done = function()
		return Core.C.UI.current == "Supplier"
	end },
	{ id = "dishes", key = "hint.first_dishes", when = function()
		return (Core.C.Data.plotAttr("SinkPile") or 0) >= CFG.dishes.pile
	end, world = function()
		return mine("sink")
	end, done = function()
		return (Core.C.Data.plotAttr("SinkPile") or 0) == 0
	end },
	{ id = "shop", key = "hint.first_shop", when = shopBadge, gui = function()
		return dockButton("Shop")
	end, done = function()
		return Core.C.UI.current == "Shop"
	end },
	{ id = "staff", key = "hint.first_staff", when = function()
		local w = Core.C.Data.restaurant()
		local cheapest = math.huge
		for _, s in ipairs(StaffCfg.list) do
			cheapest = math.min(cheapest, s.lv)
		end
		return (w.level or 1) >= math.max(CFG.staff.level, cheapest) and #(w.staff or {}) == 0
	end, gui = function()
		return dockButton("Shop")
	end, done = function()
		return Core.C.UI.current == "Shop"
	end },
}

local function seen(id)
	local meta = Core.C.Data.m("meta")
	return meta and meta.hints and meta.hints[id] == true
end

local function close()
	if current then
		NetDef.event("HintSeen"):FireServer(current.id)
		local meta = Core.C.Data.m("meta")
		if meta then
			meta.hints = meta.hints or {}
			meta.hints[current.id] = true
		end
	end
	current = nil
	card.Visible = false
	pointer:hide()
	lastShown = os.clock()
end

local function aim(tip)
	local g = tip.gui and tip.gui()
	local w = tip.world and tip.world()
	if g then
		pointer:gui(g)
	elseif w then
		pointer:world(w)
	else
		pointer:hide()
	end
end

local function open(tip)
	current = { id = tip.id, tip = tip, since = os.clock() }
	cardText.Text = "💡 " .. t(tip.key)
	card.Position = UDim2.new(Kit.profile == "desktop" and 0.5 or 0.57, 0, 1, -140)
	aim(tip)
	card.Visible = true
	Kit.popIn(card, 0.85)
	if Core.C.Audio then
		Core.C.Audio.play("pop")
	end
end

function Hints.Init()
	local root = Core.C.UI.root()
	-- above the dock, in the middle
	card = Kit.panel({ Name = "Hint", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -140), Size = UDim2.fromOffset(420, 0), AutomaticSize = Enum.AutomaticSize.Y, Visible = false, ZIndex = 6, Parent = root })
	local stroke = card:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = T.gold
		stroke.Thickness = 3
	end
	Kit.padding(14, 10).Parent = card
	cardText = Kit.label("", { Parent = card, Size = UDim2.new(1, -40, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 17, FontFace = T.bold })
	Kit.button("✕", { parent = card, size = UDim2.fromOffset(32, 32), position = UDim2.new(1, -30, 0, -4), style = "plain", textSize = 14, radius = 16, onClick = close })
	pointer = Pointer.new("#7FE0FF")
end

function Hints.Start()
	local Data = Core.C.Data
	if not Data.ready then
		Data.Ready:Wait()
	end
	while true do
		task.wait(0.5)
		local tut = Core.C.Tutorial
		local busy = (tut and tut.active and tut.active()) or Data.role() ~= "owner"
		if current then
			local tip = current.tip
			aim(tip)
			if tip.done() or os.clock() - current.since > TutorialCfg.HintSeconds then
				close()
			end
		elseif not busy and Core.C.UI.current == nil and os.clock() - lastShown > TutorialCfg.HintGap then
			for _, tip in ipairs(TIPS) do
				if not seen(tip.id) and tip.when() then
					open(tip)
					break
				end
			end
		end
	end
end

return Hints
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000109"><Properties><string name="Name">Interaction</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- What you can use: in first person the object under the crosshair, in third person the one under
-- the mouse or else the nearest one in front of you. It gets an outline and a ProximityPrompt
-- with what pressing does (E, ButtonX or a tap on the prompt; a click or a tap on the object works
-- too). Using sends Interact; the server checks distance, permissions and everything else.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Format = require(Shared.Util.Format)
local GameConfig = require(Shared.Config.GameConfig)
local Recipes = require(Shared.Config.Recipes)
local Ingredients = require(Shared.Config.Ingredients)
local Items = require(Shared.Config.Items)
local Licenses = require(Shared.Config.Licenses)
local Locks = require(Shared.Logic.Locks)
local Color = require(Shared.Util.Color)
local Core = require(script.Parent.Parent.Core)

local Interaction = {}
local player = Players.LocalPlayer
local t = Locale.t

local highlight, label, labelText
local current = nil -- { model, uid, kind, slot }
local prompts = setmetatable({}, { __mode = "k" }) -- [model] = ProximityPrompt (local to this client)
local shownPrompt = nil
local act
local lastCheck = 0
local recipeMarks = {}

local function hrp()
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function findTarget(inst)
	local slot = nil
	while inst and inst ~= workspace do
		if inst:GetAttribute("Slot") then
			slot = inst:GetAttribute("Slot")
		end
		if inst:IsA("Model") and inst:GetAttribute("Uid") and CollectionService:HasTag(inst, "Interactable") then
			return inst, slot
		end
		inst = inst.Parent
	end
	return nil
end

local function castAt(screenPos)
	local cam = workspace.CurrentCamera
	local ray = cam:ViewportPointToRay(screenPos.X, screenPos.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = { cam }
	if player.Character then
		table.insert(ignore, player.Character)
	end
	local street = workspace:FindFirstChild("Street")
	if street then
		table.insert(ignore, street)
	end
	params.FilterDescendantsInstances = ignore
	return workspace:Raycast(ray.Origin, ray.Direction * 200, params)
end

local function handsKind()
	local k = player:GetAttribute("HandsKind")
	return (k and k ~= "") and k or nil
end

local function stepName(name)
	return t("step." .. name)
end

-- 🔒 license still needed by a station or the rice cooker (nil when it can be used)
function Interaction.lockOf(model, kind)
	local owned = Core.C.Data and Core.C.Data.w("licenses") or {}
	if kind == "station" then
		local item = Items.byId[model.Name]
		local st = item and item.fn and item.fn.station
		return st and Locks.station(st, owned, Recipes, Licenses) or nil
	elseif kind == "ricecooker" then
		return Locks.rice(owned, Recipes, Licenses)
	end
	return nil
end

-- Text shown above the hovered object
local function actionText(model, kind, slot)
	-- only the restaurant you work in (your own, or one you help in)
	if not Core.C.Data.isMine(model) then
		return nil
	end
	local hands = handsKind()
	local lock = Interaction.lockOf(model, kind)
	if lock then
		return "🔒 " .. t("hint.locked", { name = "lic." .. lock.id, level = lock.level })
	end
	if kind == "box" then
		local g = model:GetAttribute("Ingredient")
		return hands and t("hint.hands_full") or t("hint.take_box", { name = "ing." .. (g or "rice") })
	elseif kind == "shelf" then
		if hands == "box" then
			-- what happens on this very slot (each click fills only the slot you point at)
			local part = slot and model:FindFirstChild("Slot" .. slot)
			if part then
				local g = part:GetAttribute("G") or ""
				local n, cap = part:GetAttribute("N") or 0, part:GetAttribute("Cap") or 0
				if g == "" then
					return t("hint.slot_put")
				end
				local raw = player:GetAttribute("Hands") or "[]"
				local okList, held = pcall(function()
					return game:GetService("HttpService"):JSONDecode(raw)
				end)
				if okList and type(held) == "table" and not table.find(held, g) then
					return t("hint.slot_other", { name = "ing." .. g })
				end
				if n >= cap then
					return t("hint.slot_full")
				end
				return t("hint.slot_add", { name = "ing." .. g, free = cap - n })
			end
			return t("hint.restock")
		end
		-- empty hands: nothing to do here, the stations take the ingredients by themselves
		return nil
	elseif kind == "ricecooker" or kind == "pot" then
		if hands == "box" then
			return t("hint.pour")
		end
		local n, c = model:GetAttribute("N") or 0, model:GetAttribute("C") or 0
		if c > 0 then
			return t("hint.cooking")
		end
		return kind == "ricecooker" and t("hint.rice_status", { n = n }) or t("hint.broth_status", { n = n })
	elseif kind == "station" then
		local ready = model:GetAttribute("Ready") or ""
		if ready ~= "" then
			return t("hint.take_dish", { dish = "rec." .. ready })
		end
		if hands == "ing" then
			return t("hint.put_ingredients")
		elseif hands then
			return t("hint.hands_full")
		end
		local recipe = model:GetAttribute("Recipe") or ""
		if recipe ~= "" then
			if model:GetAttribute("Busy") then
				return t("hint.cooking_now", { dish = "rec." .. recipe })
			end
			local list = string.split(model:GetAttribute("Steps") or "", ",")
			local idx = (model:GetAttribute("Step") or 0) + 1
			return t("act." .. (list[idx] or "combine"), { dish = "rec." .. recipe, i = idx, n = #list })
		end
		-- an empty board: the next press starts the oldest order for this station
		local nextId = model:GetAttribute("Next") or ""
		if nextId ~= "" then
			local missing = model:GetAttribute("Missing") or ""
			if missing ~= "" then
				local icons = {}
				for _, g in ipairs(string.split(missing, ",")) do
					local ing = Ingredients.byId[g]
					table.insert(icons, g == "dishes" and "🍽️" or (ing and ing.icon or g))
				end
				return t("hint.missing_for", { dish = "rec." .. nextId, list = table.concat(icons, " ") })
			end
			local r = Recipes.byId[nextId]
			return t("act." .. (r and r.steps[1] or "combine"), { dish = "rec." .. nextId, i = 1, n = r and #r.steps or 1 })
		end
		return t("hint.no_orders")
	elseif kind == "customer" then
		local state = model:GetAttribute("State")
		local order = model:GetAttribute("Order") or ""
		if state == "order" then
			return t("hint.take_order")
		elseif state == "waiting" then
			return hands == "dish" and t("hint.serve", { dish = "rec." .. order }) or t("hint.waiting_for", { dish = "rec." .. order })
		end
		return t("hint.customer")
	elseif kind == "dirty" then
		return t("hint.collect")
	elseif kind == "sink" then
		if hands == "dirty" then
			return t("hint.sink_drop")
		end
		if model:GetAttribute("Washing") and model:GetAttribute("Washer") == player.UserId then
			return t("hint.washing")
		end
		local pile = Core.C.Data.plotAttr("SinkPile") or 0
		return pile > 0 and t("hint.wash_hold", { n = pile }) or t("hint.sink")
	elseif kind == "dishwasher" then
		return hands == "dirty" and t("hint.load_dishwasher") or t("hint.dishwasher", { n = model:GetAttribute("Queue") or 0 })
	elseif kind == "rack" then
		return hands == "box" and t("hint.put_back") or t("hint.rack")
	elseif kind == "tipjar" then
		local tips = model:GetAttribute("Tips") or 0
		return tips > 0 and t("hint.tipjar", { yen = tips }) or t("hint.tipjar_empty")
	elseif kind == "supplier" then
		return t("hint.supplier")
	elseif kind == "menuboard" then
		return t("hint.menuboard")
	elseif kind == "forsale" then
		local id = model:GetAttribute("Expansion") or ""
		local need = model:GetAttribute("Level") or 1
		if (Core.C.Data.w("level") or 1) < need then
			return "🔒 " .. t("zone." .. id) .. " · " .. t("ui.req_level", { level = need })
		end
		return t("hint.buy_room", { name = "zone." .. id, yen = Format.yen(model:GetAttribute("Price") or 0, Locale.get()) })
	end
	return nil
end

local function inRange(model)
	local root = hrp()
	if not root then
		return false
	end
	local pos = model:GetPivot().Position
	local size = model:GetExtentsSize()
	local margin = math.max(size.X, size.Z) / 2
	local flat = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(root.Position.X, 0, root.Position.Z)).Magnitude
	return flat <= GameConfig.InteractRange + margin - 0.5 and math.abs(pos.Y - root.Position.Y) < 12
end

-- one ProximityPrompt per object, created here on the client and shown only on the target
local function promptFor(model)
	local p = prompts[model]
	if p and p.Parent then
		return p
	end
	local part = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
	if not part then
		return nil
	end
	p = Instance.new("ProximityPrompt")
	p.Name = "UsePrompt"
	p.RequiresLineOfSight = false
	p.Exclusivity = Enum.ProximityPromptExclusivity.OneGlobally
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.GamepadKeyCode = Enum.KeyCode.ButtonX
	p.HoldDuration = 0
	p.MaxActivationDistance = 40
	p.Enabled = false
	local pressedAt = 0
	p.Triggered:Connect(function()
		pressedAt = os.clock()
		if current and current.model == model then
			-- on a touch screen a tap on the prompt is a tap (it toggles washing)
			act(UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled)
		end
	end)
	-- releasing the button stops washing at the sink; a quick tap on a touch screen leaves the
	-- tap running (washing goes on by itself until the sink is empty or you tap again)
	p.TriggerEnded:Connect(function()
		local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
		if Core.C.Sink and not (touch and os.clock() - pressedAt < 0.35) then
			Core.C.Sink.endHold()
		end
	end)
	p.Parent = part
	prompts[model] = p
	return p
end

local function showPrompt(model, text, near)
	local p = (model and text and near) and promptFor(model) or nil
	if shownPrompt and shownPrompt ~= p and shownPrompt.Parent then
		shownPrompt.Enabled = false
	end
	shownPrompt = p
	if p then
		if p.ActionText ~= text then
			p.ActionText = text
		end
		p.Enabled = true
	end
end

local function setCurrent(model, slot)
	if not model then
		current = nil
		highlight.Adornee = nil
		highlight.Enabled = false
		label.Enabled = false
		showPrompt(nil)
		return
	end
	local kind = model:GetAttribute("Kind")
	local text = actionText(model, kind, slot)
	if not text then
		setCurrent(nil)
		return
	end
	local near = inRange(model)
	current = { model = model, uid = model:GetAttribute("Uid"), kind = kind, slot = slot, near = near, text = text }
	highlight.Adornee = model
	highlight.Enabled = true
	highlight.OutlineColor = near and Color.hex("#FFD23B") or Color.hex("#B8AFA2")
	-- close enough: the prompt says what pressing does; too far: a small "get closer" label
	-- (in first person it is written under the crosshair, see Controllers/FirstPerson)
	showPrompt(model, text, near)
	local fp = Core.C.Camera and Core.C.Camera.isFirstPerson and Core.C.Camera.isFirstPerson()
	label.Adornee = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
	label.Enabled = not fp and not near
	labelText.Text = "🚶 " .. t("hint.get_closer")
end

-- third person without a mouse target: the nearest usable object in front of you
local function proximityTarget()
	local root = hrp()
	if not root then
		return nil
	end
	local look = root.CFrame.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z)
	flatLook = flatLook.Magnitude > 0 and flatLook.Unit or Vector3.new(0, 0, -1)
	local best, bestScore = nil, math.huge
	for _, model in ipairs(CollectionService:GetTagged("Interactable")) do
		local pp = model.PrimaryPart
		if pp and model:IsDescendantOf(workspace) then
			local off = pp.Position - root.Position
			local flat = Vector3.new(off.X, 0, off.Z)
			local dist = flat.Magnitude
			local size = pp.Size
			if dist <= GameConfig.InteractRange + math.max(size.X, size.Z) / 2 and math.abs(off.Y) < 10 then
				local facing = dist > 0.5 and flat.Unit:Dot(flatLook) or 1
				local score = dist - facing * 5
				if score < bestScore and actionText(model, model:GetAttribute("Kind"), nil) then
					best, bestScore = model, score
				end
			end
		end
	end
	return best
end

-- What the player points at: { text, near, kind } or nil
function Interaction.target()
	if not current then
		return nil
	end
	return { text = current.text, near = current.near, kind = current.kind }
end

local function update(screenPos)
	if Core.C.Build and Core.C.Build.active then
		setCurrent(nil)
		return
	end
	local hit = castAt(screenPos)
	if not hit then
		setCurrent(nil)
		return
	end
	local model, slot = findTarget(hit.Instance)
	setCurrent(model, slot)
end

-- washing is held: true when this click starts (or a tap toggles) washing at the sink
local function washHold(tap)
	if current.kind ~= "sink" or handsKind() ~= nil or (Core.C.Data.plotAttr("SinkPile") or 0) <= 0 then
		return false
	end
	local Sink = Core.C.Sink
	if not Sink then
		return false
	end
	if tap then
		Sink.toggle(current.uid)
	else
		Sink.beginHold(current.uid)
	end
	return true
end

act = function(tap)
	-- while the noodles boil, the click stops the timing needle
	local Timing = Core.C.Timing
	if Timing and Timing.active() then
		Timing.hit()
		return
	end
	if not current then
		return
	end
	if not current.near then
		Core.C.UI.toast(t("msg.too_far"), "info")
		return
	end
	if washHold(tap) then
		return
	end
	if current.kind == "supplier" then
		Core.C.UI.open("Supplier")
		return
	elseif current.kind == "forsale" then
		-- one press buys the room (the server checks level, rooms before it and the price)
		if not Core.C.Data.canBuild() then
			Core.C.UI.toast(t("ui.only_owner"), "warning")
			return
		end
		local price = current.model:GetAttribute("Price") or 0
		if Core.C.Data.wallet() < price then
			Core.C.UI.toast(t("ui.missing", { yen = Format.yen(price - Core.C.Data.wallet(), Locale.get()) }), "warning")
			return
		end
		NetDef.event("BuyExpansion"):FireServer(current.model:GetAttribute("Expansion"))
		return
	elseif current.kind == "menuboard" then
		Core.C.UI.open("Menu")
		return
	end
	NetDef.event("Interact"):FireServer(current.uid, { slot = current.slot })
end

-- Briefly marks the shelves/station needed for a recipe (clicked ticket)
function Interaction.highlightRecipe(recipeId)
	for _, m in ipairs(recipeMarks) do
		m:Destroy()
	end
	recipeMarks = {}
	local r = Recipes.byId[recipeId]
	if not r then
		return
	end
	local need = {}
	for _, g in ipairs(r.ing) do
		need[g] = true
	end
	for _, model in ipairs(CollectionService:GetTagged("Interactable")) do
		local kind = model:GetAttribute("Kind")
		if kind == "shelf" then
			for _, part in ipairs(model:GetChildren()) do
				if part:IsA("BasePart") and part:GetAttribute("Slot") and need[part:GetAttribute("G") or ""] then
					local box = Instance.new("SelectionBox")
					box.Adornee = part
					box.Color3 = Color.hex("#FFD23B")
					box.LineThickness = 0.08
					box.Parent = player.PlayerGui
					table.insert(recipeMarks, box)
				end
			end
		elseif kind == "station" and model.PrimaryPart then
			local stationId = string.gsub(model.Name, "_station", "")
			if stationId == r.station or (model.Name == "griddle" and r.station == "griddle") or (model.Name == "fryer" and r.station == "fryer") or (model.Name == "takoyaki_stove" and r.station == "takoyaki") then
				local box = Instance.new("SelectionBox")
				box.Adornee = model.PrimaryPart
				box.Color3 = Color.hex("#6DDC5A")
				box.LineThickness = 0.1
				box.Parent = player.PlayerGui
				table.insert(recipeMarks, box)
			end
		end
	end
	local missing = {}
	for g in pairs(need) do
		local found = false
		for _, m in ipairs(recipeMarks) do
			if m.Adornee and m.Adornee:GetAttribute("G") == g then
				found = true
			end
		end
		if not found then
			table.insert(missing, (Ingredients.byId[g] and Ingredients.byId[g].icon or "") .. " " .. t("ing." .. g))
		end
	end
	local msg = t("hint.recipe_needs", { dish = "rec." .. recipeId })
	if #missing > 0 then
		msg ..= "  " .. t("hint.missing") .. ": " .. table.concat(missing, ", ")
	end
	Core.C.UI.toast(msg, #missing > 0 and "warning" or "info")
	task.delay(8, function()
		for _, m in ipairs(recipeMarks) do
			m:Destroy()
		end
		recipeMarks = {}
	end)
end

function Interaction.Init()
	highlight = Instance.new("Highlight")
	highlight.FillTransparency = 1
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Enabled = false
	highlight.Parent = player:WaitForChild("PlayerGui")
	label = Instance.new("BillboardGui")
	label.Size = UDim2.fromOffset(260, 46)
	label.StudsOffsetWorldSpace = Vector3.new(0, 3.2, 0)
	label.AlwaysOnTop = true
	label.LightInfluence = 0
	label.Enabled = false
	label.Parent = player.PlayerGui
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color.hex("#2B2320")
	bg.BackgroundTransparency = 0.15
	bg.Parent = label
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = bg
	labelText = Instance.new("TextLabel")
	labelText.Size = UDim2.new(1, -12, 1, -6)
	labelText.Position = UDim2.fromOffset(6, 3)
	labelText.BackgroundTransparency = 1
	labelText.TextColor3 = Color.hex("#F4EBDD")
	labelText.TextScaled = true
	labelText.FontFace = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold)
	labelText.AutoLocalize = false
	labelText.Parent = bg
end

Interaction.act = act

local function aimingCenter()
	local Camera = Core.C.Camera
	local fp = Core.C.FirstPerson
	return Camera and Camera.isFirstPerson and Camera.isFirstPerson() and not (fp and fp.cursorFree and fp.cursorFree())
end

function Interaction.Start()
	RunService.RenderStepped:Connect(function()
		if os.clock() - lastCheck < 0.05 then
			return
		end
		lastCheck = os.clock()
		if Core.C.Build and Core.C.Build.active then
			setCurrent(nil)
		elseif aimingCenter() then
			-- first person: whatever is under the crosshair (mouse, touch and gamepad alike)
			local cam = workspace.CurrentCamera
			update(cam.ViewportSize / 2)
		else
			-- third person: the object under the mouse, else the nearest one in front of you
			local hovered = nil
			if UserInputService.MouseEnabled then
				local hit = castAt(UserInputService:GetMouseLocation())
				hovered = hit and findTarget(hit.Instance) or nil
			end
			if hovered then
				update(UserInputService:GetMouseLocation())
			else
				setCurrent(proximityTarget(), nil)
			end
		end
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or (Core.C.Build and Core.C.Build.active) then
			return
		end
		-- E and ButtonX go through the prompt; a click works on the object you point at
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			act()
		end
	end)
	-- releasing the click stops washing (the prompt handles E)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 and Core.C.Sink then
			Core.C.Sink.endHold()
		end
	end)
	UserInputService.TouchTap:Connect(function(positions, processed)
		if processed or (Core.C.Build and Core.C.Build.active) then
			return
		end
		local p = positions[1]
		if p then
			local viewport = Vector2.new(p.X, p.Y + GuiService:GetGuiInset().Y)
			update(viewport)
			act(true)
		end
	end)
end

return Interaction
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000110"><Properties><string name="Name">Lighting</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Time-of-day look (sky colors, atmosphere, bloom, color grading) and night lights.
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Color = require(Shared.Util.Color)
local Core = require(script.Parent.Parent.Core)

local LightingC = {}
local atmosphere, bloom, grading, rays
local lights = {}

local DAY = { ambient = Color.hex("#8C8478"), outdoor = Color.hex("#9C9488"), top = Color.hex("#FFF3E0"), bright = 2.4, atm = Color.hex("#C9D9E8"), decay = Color.hex("#8FA8C0"), tint = Color.hex("#FFF6EC") }
local SUNSET = { ambient = Color.hex("#8A6A5A"), outdoor = Color.hex("#A0786A"), top = Color.hex("#FFB070"), bright = 1.6, atm = Color.hex("#F0B08A"), decay = Color.hex("#A06A6A"), tint = Color.hex("#FFE2C8") }
-- night: blue sky outside, but a warm, cosy grade so lanterns and pendants glow amber
local NIGHT = { ambient = Color.hex("#4A4050"), outdoor = Color.hex("#2E3450"), top = Color.hex("#6A78B0"), bright = 0.5, atm = Color.hex("#2A3050"), decay = Color.hex("#1A1E38"), tint = Color.hex("#FFE9D4") }

local function blend(a, b, k)
	return {
		ambient = a.ambient:Lerp(b.ambient, k), outdoor = a.outdoor:Lerp(b.outdoor, k), top = a.top:Lerp(b.top, k),
		bright = a.bright + (b.bright - a.bright) * k, atm = a.atm:Lerp(b.atm, k), decay = a.decay:Lerp(b.decay, k), tint = a.tint:Lerp(b.tint, k),
	}
end

local function look(clock)
	if clock >= 7 and clock < 16.5 then
		return DAY, 0
	elseif clock >= 16.5 and clock < 18.5 then
		return blend(DAY, SUNSET, (clock - 16.5) / 2), 0.2
	elseif clock >= 18.5 and clock < 20 then
		return blend(SUNSET, NIGHT, (clock - 18.5) / 1.5), 0.6
	elseif clock >= 5 and clock < 7 then
		return blend(NIGHT, DAY, (clock - 5) / 2), 0.4
	end
	return NIGHT, 1
end

local function track(d)
	if d:IsA("Light") and d:GetAttribute("NightLight") ~= nil then
		table.insert(lights, d)
	end
end

function LightingC.Init()
	atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Density = 0.32
	atmosphere.Offset = 0.2
	atmosphere.Glare = 0.2
	atmosphere.Haze = 1.2
	atmosphere.Parent = Lighting
	bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.55
	bloom.Size = 26
	bloom.Threshold = 1.4
	bloom.Parent = Lighting
	grading = Instance.new("ColorCorrectionEffect")
	grading.Saturation = 0.12
	grading.Contrast = 0.08
	grading.Parent = Lighting
	rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.05
	rays.Spread = 0.6
	rays.Parent = Lighting
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	for _, d in ipairs(workspace:GetDescendants()) do
		track(d)
	end
	workspace.DescendantAdded:Connect(track)
end

function LightingC.Start()
	local lastLights = 0
	RunService.Heartbeat:Connect(function()
		local clock = Lighting.ClockTime
		local l, night = look(clock)
		Lighting.Ambient = l.ambient
		Lighting.OutdoorAmbient = l.outdoor
		Lighting.ColorShift_Top = l.top
		Lighting.Brightness = l.bright
		atmosphere.Color = l.atm
		atmosphere.Decay = l.decay
		grading.TintColor = l.tint
		local s = Core.C.Data and Core.C.Data.m("settings")
		local low = s and s.lowGfx
		bloom.Enabled = not low
		rays.Enabled = not low
		Lighting.GlobalShadows = not low
		if os.clock() - lastLights > 1 then
			lastLights = os.clock()
			local on = night >= 0.2
			for i = #lights, 1, -1 do
				local light = lights[i]
				if not light.Parent then
					table.remove(lights, i)
				elseif light:GetAttribute("NightLight") then
					light.Enabled = on and not (low and light:IsA("SpotLight"))
				end
			end
		end
	end)
end

return LightingC
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000111"><Properties><string name="Name">ShelfTags</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Shelf tags (as in shop games): a small paper tag on the front edge of every shelf slot with the
-- icon and the name of the product it holds, written in your language. Empty slots get a blank
-- tag. Tags are local parts, rebuilt only when a slot changes product.
local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Locale = require(Shared.Locale)
local Ingredients = require(Shared.Config.Ingredients)

local ShelfTags = {}
local tags = {} -- [slot part] = { part, icon, name, g }
local folder
local RANGE = 70

local function makeTag()
	local p = Instance.new("Part")
	p.Name = "ShelfTag"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	p.Color = Color3.fromRGB(250, 246, 236)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 90
	gui.LightInfluence = 1
	gui.Parent = p
	-- red band on the left like a price tag, icon, then the name
	local band = Instance.new("Frame")
	band.Size = UDim2.new(0, 10, 1, 0)
	band.BackgroundColor3 = Color3.fromRGB(179, 38, 46)
	band.BorderSizePixel = 0
	band.Parent = gui
	local icon = Instance.new("TextLabel")
	icon.Position = UDim2.new(0, 14, 0, 2)
	icon.Size = UDim2.new(0.28, -14, 1, -4)
	icon.BackgroundTransparency = 1
	icon.TextScaled = true
	icon.AutoLocalize = false
	icon.Parent = gui
	local name = Instance.new("TextLabel")
	name.Position = UDim2.new(0.28, 2, 0, 2)
	name.Size = UDim2.new(0.72, -6, 1, -4)
	name.BackgroundTransparency = 1
	name.TextScaled = true
	name.TextXAlignment = Enum.TextXAlignment.Left
	name.TextColor3 = Color3.fromRGB(43, 35, 32)
	name.FontFace = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold)
	name.AutoLocalize = false
	name.Parent = gui
	return { part = p, icon = icon, name = name, g = nil }
end

local function place(tag, slot)
	-- on the front edge of the shelf board, just under the slot
	local w = math.clamp(slot.Size.X * 0.42, 1.0, 1.7)
	tag.part.Size = Vector3.new(w, 0.34, 0.04)
	tag.part.CFrame = slot.CFrame * CFrame.new(0, -slot.Size.Y / 2 - 0.03, -slot.Size.Z / 2 - 0.1)
end

local function setText(tag, g)
	tag.g = g
	local ing = Ingredients.byId[g or ""]
	if ing then
		tag.icon.Text = ing.icon
		tag.name.Text = Locale.t("ing." .. g)
	else
		tag.icon.Text = ""
		tag.name.Text = "—"
	end
end

local function update()
	local cam = workspace.CurrentCamera
	local origin = cam and cam.CFrame.Position or Vector3.new()
	local seen = {}
	for _, m in ipairs(CollectionService:GetTagged("Interactable")) do
		if m:GetAttribute("Kind") == "shelf" and m:IsDescendantOf(workspace) and m.PrimaryPart then
			if (m.PrimaryPart.Position - origin).Magnitude < RANGE then
				for _, slot in ipairs(m:GetChildren()) do
					if slot:IsA("BasePart") and slot:GetAttribute("Slot") then
						seen[slot] = true
						local tag = tags[slot]
						if not tag then
							tag = makeTag()
							tags[slot] = tag
							tag.part.Parent = folder
						end
						place(tag, slot)
						local g = slot:GetAttribute("G") or ""
						if tag.g ~= g then
							setText(tag, g)
						end
					end
				end
			end
		end
	end
	for slot, tag in pairs(tags) do
		if not seen[slot] then
			tag.part:Destroy()
			tags[slot] = nil
		end
	end
end

function ShelfTags.Init()
	folder = Instance.new("Folder")
	folder.Name = "ShelfTags"
	folder.Parent = workspace.CurrentCamera
	Locale.Changed:Connect(function()
		for _, tag in pairs(tags) do
			setText(tag, tag.g)
		end
	end)
end

function ShelfTags.Start()
	while true do
		update()
		task.wait(0.4)
	end
end


return ShelfTags
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000112"><Properties><string name="Name">Sink</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Washing the dishes at the sink. While a sink has Washing = true (set by ApplianceService) every
-- client shows a dirty plate under the running tap with a sponge scrubbing it in circles while the
-- dirt fades away; each clean plate slides to the left, towards the drying rack, fading out.
-- The player who washes also sees a thin progress bar under the middle of the screen.
-- Holding: Interaction calls Sink.beginHold on click / E down (or the ✋ button) and Sink.endHold
-- on release; a tap on a touch screen toggles instead.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Registry = require(Shared.Models.Registry)
local Kit = require(Shared.Models.Kit)
local UIKit = require(script.Parent.Parent.UI.Kit)
local Core = require(script.Parent.Parent.Core)

local Sink = {}
local player = Players.LocalPlayer
local scenes = {} -- [sink model] = { plate, dirt = { parts }, sponge }
local holding = nil -- sink uid we are holding on
local PLATE_LIFT = CFrame.new(0, 0.35, 0) -- a one-plate stack has its pivot 0.35 above its bottom
local barGui, barFill

-- where the plate is scrubbed: in the empty basin under the tap, tilted towards you
local function plateCf(m)
	local root = m.PrimaryPart
	local h = root.Size.Y
	return root.CFrame * CFrame.new(0.25, (h - 0.3) - h / 2, -0.12) * CFrame.Angles(math.rad(-22), 0, 0)
end

local function noQuery(model)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
		end
	end
end

local function makeScene(m)
	local folder = Instance.new("Model")
	folder.Name = "WashScene"
	-- a clean plate with dirt on top (sauce smears and rice) that fades while scrubbing
	local plate = Registry.food("stack", 1, "clean")
	noQuery(plate)
	plate.Parent = folder
	local dirtModel = Kit.model("Dirt")
	local dirt = {}
	for i, spot in ipairs({ { 0.18, 0.1, 0.32 }, { -0.2, -0.12, 0.26 }, { 0.05, -0.25, 0.18 } }) do
		local p = Kit.cyl(dirtModel, spot[3], 0.012, spot[1], 0.125, spot[2], i == 2 and "#C08A3E" or "#6B3E1E", Enum.Material.SmoothPlastic, { collide = false, shadow = false })
		table.insert(dirt, p)
	end
	for k = 0, 5 do
		local p = Kit.ball(dirtModel, 0.06, -0.25 + k * 0.1, 0.14, (k % 2) * 0.16 - 0.05, "#F4F1EA", Enum.Material.Sand, { collide = false, shadow = false })
		table.insert(dirt, p)
	end
	noQuery(dirtModel)
	dirtModel.WorldPivot = CFrame.new() -- built around the bottom of the plate
	dirtModel.Parent = folder
	-- the sponge: yellow foam with a green scrubbing side, and a few soap bubbles
	local spongeModel = Kit.model("Sponge")
	local foam = Kit.box(spongeModel, 0.42, 0.16, 0.28, 0, 0.08, 0, "#F2D04A", Enum.Material.Fabric, { collide = false })
	Kit.box(spongeModel, 0.42, 0.05, 0.28, 0, -0.025, 0, "#4E8A3A", Enum.Material.Fabric, { collide = false })
	Kit.particles(foam, "bubbles", { rate = 14 })
	noQuery(spongeModel)
	spongeModel.WorldPivot = CFrame.new()
	spongeModel.Parent = folder
	folder.Parent = workspace.CurrentCamera
	return { folder = folder, plate = plate, dirtModel = dirtModel, dirt = dirt, sponge = spongeModel }
end

local function progressOf(m)
	local start = m:GetAttribute("WashStart") or workspace:GetServerTimeNow()
	local dur = math.max(0.1, m:GetAttribute("WashTime") or 1)
	return math.clamp((workspace:GetServerTimeNow() - start) / dur, 0, 1)
end

local function update()
	local now = os.clock()
	local mine = nil
	for _, m in ipairs(CollectionService:GetTagged("Interactable")) do
		if m:GetAttribute("Kind") == "sink" then
			local sc = scenes[m]
			if m:GetAttribute("Washing") and m.PrimaryPart then
				if not sc then
					sc = makeScene(m)
					scenes[m] = sc
				end
				local t = progressOf(m)
				local base = plateCf(m)
				local spin = CFrame.Angles(0, now * 0.9, 0)
				sc.plate:PivotTo(base * spin * PLATE_LIFT)
				sc.dirtModel:PivotTo(base * spin)
				for _, p in ipairs(sc.dirt) do
					p.Transparency = math.min(1, t * 1.15)
				end
				-- the sponge scrubs in small circles over the plate
				local a = now * 9
				local r = 0.22 + 0.06 * math.sin(now * 3)
				sc.sponge:PivotTo(base * CFrame.new(math.cos(a) * r, 0.17, math.sin(a) * r) * CFrame.Angles(0, -a, math.sin(a * 2) * 0.12))
				if m:GetAttribute("Washer") == player.UserId then
					mine = t
				end
			elseif sc then
				sc.folder:Destroy()
				scenes[m] = nil
			end
		end
	end
	for m, sc in pairs(scenes) do
		if not m.Parent then
			sc.folder:Destroy()
			scenes[m] = nil
		end
	end
	barGui.Enabled = mine ~= nil
	if mine then
		barFill.Size = UDim2.fromScale(mine, 1)
	end
end

-- a clean plate slides to the left (towards the drying rack) and fades out
function Sink.washed(uid)
	local m = nil
	for _, inst in ipairs(CollectionService:GetTagged("Interactable")) do
		if inst:GetAttribute("Uid") == uid then
			m = inst
		end
	end
	if not m or not m.PrimaryPart then
		return
	end
	local start = plateCf(m)
	local plate = Registry.food("stack", 1, "clean")
	noQuery(plate)
	start = start * PLATE_LIFT
	plate:PivotTo(start)
	plate.Parent = workspace.CurrentCamera
	local parts = {}
	for _, d in ipairs(plate:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(parts, { part = d, base = d.Transparency })
		end
	end
	-- the sink's +X is the left of a player facing it
	local goal = start * CFrame.new(1.3, 0.3, 0) * CFrame.Angles(math.rad(22), 0, 0)
	task.spawn(function()
		local t0 = os.clock()
		local dur = 0.7
		while os.clock() - t0 < dur do
			local k = (os.clock() - t0) / dur
			local ease = 1 - (1 - k) * (1 - k)
			plate:PivotTo(start:Lerp(goal, ease))
			for _, p in ipairs(parts) do
				p.part.Transparency = p.base + (1 - p.base) * k
			end
			RunService.RenderStepped:Wait()
		end
		plate:Destroy()
	end)
end

function Sink.beginHold(uid)
	if holding == uid then
		return
	end
	if holding then
		Sink.endHold()
	end
	holding = uid
	NetDef.event("Wash"):FireServer(uid, true)
end

function Sink.endHold()
	if holding then
		NetDef.event("Wash"):FireServer(holding, false)
		holding = nil
	end
end

function Sink.toggle(uid)
	if holding == uid then
		Sink.endHold()
	else
		Sink.beginHold(uid)
	end
end

function Sink.isHolding()
	return holding ~= nil
end

function Sink.Init()
	barGui = UIKit.new("ScreenGui", { Name = "WashBar", ResetOnSpawn = false, IgnoreGuiInset = true, Enabled = false, Parent = player:WaitForChild("PlayerGui") })
	local track = UIKit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.5, 58), Size = UDim2.fromOffset(200, 7),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255), BackgroundTransparency = 0.45, Parent = barGui,
	}, { UIKit.corner(4) })
	barFill = UIKit.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = UIKit.Theme.gold, Parent = track }, { UIKit.corner(4) })
end

function Sink.Start()
	RunService.RenderStepped:Connect(update)
end

return Sink
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000113"><Properties><string name="Name">Timing</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Noodle timing (optional skill): while the noodles boil, a bar with a green part and a moving
-- needle appears under the middle of the screen. Click / E (or ✋) when the needle is in the
-- green: "Perfect!" and that bowl gets a bigger tip. Missing it costs nothing.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local UIKit = require(script.Parent.Parent.UI.Kit)
local Core = require(script.Parent.Parent.Core)

local Timing = {}
local player = Players.LocalPlayer
local t = Locale.t
local T = UIKit.Theme

local gui, bar, zone, needle, label
local session = nil -- { uid, start, dur, a, b, hit }

local function hide(after)
	task.delay(after or 0, function()
		if not session or session.hit then
			gui.Enabled = false
			session = nil
		end
	end)
end

function Timing.active()
	return session ~= nil and not session.hit
end

-- the player pressed: send where the needle is
function Timing.hit()
	if not Timing.active() then
		return
	end
	local k = math.clamp((os.clock() - session.start) / session.dur, 0, 1)
	session.hit = true
	NetDef.event("TimingHit"):FireServer(session.uid, k)
end

function Timing.start(data)
	session = { uid = data.uid, start = os.clock(), dur = math.max(0.3, data.dur or 1.5), a = data.a or 0.5, b = data.b or 0.8 }
	zone.Position = UDim2.fromScale(session.a, 0)
	zone.Size = UDim2.fromScale(session.b - session.a, 1)
	label.Text = "🍜 " .. t("ui.timing_hint")
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	gui.Enabled = true
end

function Timing.result(data)
	local Audio = Core.C.Audio
	if data.ok then
		label.Text = "✨ " .. t("ui.timing_perfect")
		label.TextColor3 = T.gold
		if Audio then
			Audio.play("combo", nil, { pitch = 1.3 })
		end
	else
		label.Text = t("ui.timing_miss")
		label.TextColor3 = Color3.fromRGB(230, 230, 230)
	end
	task.delay(0.9, function()
		gui.Enabled = false
		session = nil
	end)
end

function Timing.Init()
	gui = UIKit.new("ScreenGui", { Name = "Timing", ResetOnSpawn = false, IgnoreGuiInset = true, Enabled = false, Parent = player:WaitForChild("PlayerGui") })
	bar = UIKit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.5, 70), Size = UDim2.fromOffset(280, 16),
		BackgroundColor3 = Color3.fromRGB(43, 35, 32), BackgroundTransparency = 0.2, Parent = gui,
	}, { UIKit.corner(8), UIKit.stroke(Color3.fromRGB(255, 255, 255), 2, 0.3) })
	zone = UIKit.new("Frame", { BackgroundColor3 = T.green, BorderSizePixel = 0, Parent = bar }, { UIKit.corner(6) })
	needle = UIKit.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(0, 5, 1, 10), BackgroundColor3 = Color3.fromRGB(255, 255, 255), Parent = bar }, { UIKit.corner(3) })
	label = UIKit.label("", {
		Parent = gui, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.5, 92), Size = UDim2.fromOffset(320, 24),
		TextSize = 17, FontFace = T.bold, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.4, TextColor3 = Color3.fromRGB(255, 255, 255),
	})
end

function Timing.Start()
	RunService.RenderStepped:Connect(function()
		if session and not session.hit then
			local k = (os.clock() - session.start) / session.dur
			needle.Position = UDim2.fromScale(math.clamp(k, 0, 1), 0.5)
			if k > 1.05 then
				label.Text = t("ui.timing_miss")
				session.hit = true
				hide(0.6)
			end
		end
	end)
end

return Timing
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000114"><Properties><string name="Name">Tutorial</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The first two minutes, one short step at a time: a customer orders by themselves, the ramen
-- station makes it in three presses (noodles, broth, toppings), you serve it and get paid; a gift
-- of yen opens the shop and you buy your first upgrade; then you clear and wash the bowl, and a
-- last gift of sakura closes the tutorial. A banner at the top says what to do (with dots for the
-- steps and a skip button), a glowing beam and a bouncing arrow show where (on things in the world
-- and on buttons of the interface). Steps that ask for an action move on by themselves. It runs
-- once for the owner of a new restaurant (meta.tutorial: step, -1 when finished or skipped) and
-- can be started again from More -> How to play; the gifts are given by the server, once, and
-- only after a dish was really served / washed (Services/Meta, Config/Tutorial).
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Format = require(Shared.Util.Format)
local TutorialCfg = require(Shared.Config.Tutorial)
local Kit = require(script.Parent.Parent.UI.Kit)
local Pointer = require(script.Parent.Parent.UI.Pointer)
local Core = require(script.Parent.Parent.Core)

local Tutorial = {}
local player = Players.LocalPlayer
local t = Locale.t
local T = Kit.Theme

------------------------------------------------------------------ what the steps look at
-- the station that has the order: cooking it, ready with it, or about to start it
local function orderStation()
	local best = nil
	for _, m in ipairs(CollectionService:GetTagged("Interactable")) do
		if m:GetAttribute("Kind") == "station" and m:IsDescendantOf(workspace) and Core.C.Data.isMine(m) then
			if (m:GetAttribute("Ready") or "") ~= "" or (m:GetAttribute("Recipe") or "") ~= "" then
				return m
			end
			if (m:GetAttribute("Next") or "") ~= "" then
				best = best or m
			end
		end
	end
	return best
end

-- presses done on the order's station (99 = ready)
local function stationStep()
	local m = orderStation()
	if not m then
		return 0, false
	end
	if (m:GetAttribute("Ready") or "") ~= "" then
		return 99, true
	end
	if (m:GetAttribute("Recipe") or "") == "" then
		return 0, false
	end
	return m:GetAttribute("Step") or 0, false
end

local function holdingDish()
	return player:GetAttribute("HandsKind") == "dish"
end

local function anyTicket()
	return #(Core.C.Data.tickets or {}) > 0
end

local function stat(name)
	local s = Core.C.Data.w("stats")
	return s and s[name] or 0
end

-- everything bought so far (upgrade levels, recipes, rooms, staff)
local function purchases()
	local w = Core.C.Data.restaurant()
	local n = #(w.staff or {})
	for _, lvl in pairs(w.upgrades or {}) do
		n += lvl
	end
	for _ in pairs(w.licenses or {}) do
		n += 1
	end
	for _ in pairs(w.zones or {}) do
		n += 1
	end
	return n
end

-- the nearest thing of a kind in your restaurant (customers: only the ones waiting for food)
local function nearestOf(kind)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local best, bestD = nil, math.huge
	for _, m in ipairs(CollectionService:GetTagged("Interactable")) do
		if m:GetAttribute("Kind") == kind and m:IsDescendantOf(workspace) and Core.C.Data.isMine(m) then
			local ok = true
			if kind == "customer" then
				ok = m:GetAttribute("State") == "order" or m:GetAttribute("State") == "waiting"
			end
			if ok then
				local d = root and (m:GetPivot().Position - root.Position).Magnitude or 0
				if d < bestD then
					best, bestD = m, d
				end
			end
		end
	end
	return best
end

-- buttons of the interface the steps point at
local function dockButton(id)
	local hud = Core.C.UI.root():FindFirstChild("HUD")
	local dock = hud and hud:FindFirstChild("Dock")
	return dock and dock:FindFirstChild(id) or nil
end

local function greenCard()
	local shop = Core.C.UI.screens.Shop
	if not (shop and shop.win and shop.win.frame.Visible) then
		return nil
	end
	for _, d in ipairs(shop.win.content:GetDescendants()) do
		if d.Name == "Buy" and d:IsA("TextButton") and d.BackgroundColor3 == T.green then
			return d
		end
	end
	return nil
end

------------------------------------------------------------------ the steps
-- key: text; icon: emoji on the banner; world: what the beam points at; gui: the button the hand
-- points at; check(state): true when done (state = stats when the step started); action: done
-- when the server reports this action; timer: seconds on screen; reward: gift asked to the server
-- when the step starts; progress: text added to the banner; skippable: shows the ▶ button
local STEPS = {
	{ id = "welcome", icon = "🏮", key = "tut.welcome", timer = 4 },
	{ id = "order", icon = "🧑", key = "tut.order", world = function()
		return nearestOf("customer")
	end, check = anyTicket },
	{ id = "cook", icon = "🍜", key = "tut.cook", world = orderStation, check = function()
		local _, ready = stationStep()
		return ready or holdingDish()
	end, progress = function()
		local step = stationStep()
		return math.min(step, 3) .. "/3"
	end },
	{ id = "take", icon = "🥢", key = "tut.take_dish", world = orderStation, check = holdingDish },
	{ id = "serve", icon = "💴", key = "tut.serve", world = function()
		return nearestOf("customer")
	end, check = function(st)
		return stat("dishes") > (st.dishes or 0)
	end },
	{ id = "reward", icon = "🎁", key = "tut.reward", reward = "serve", gui = function()
		return dockButton("Shop")
	end, check = function()
		return Core.C.UI.current == "Shop"
	end },
	{ id = "buy", icon = "🛒", key = "tut.buy", gui = function()
		return greenCard() or (Core.C.UI.current ~= "Shop" and dockButton("Shop") or nil)
	end, check = function(st)
		return purchases() > (st.purchases or 0)
	end, skippable = true },
	{ id = "collect", icon = "🥣", key = "tut.collect", world = function()
		return nearestOf("dirty")
	end, action = "collect", check = function()
		return player:GetAttribute("HandsKind") == "dirty"
	end },
	{ id = "wash", icon = "🧽", key = "tut.wash", world = function()
		return nearestOf("sink")
	end, action = "wash", check = function(st)
		return stat("washed") > (st.washed or 0)
	end },
	{ id = "done", icon = "🎉", key = "tut.done", reward = "done", timer = 6 },
}
Tutorial.STEPS = STEPS

local panel, iconLabel, text, dots, skipButton, nextButton
local pointer
local index = 0
local stepState = {}
local stepStarted = 0

local function save()
	NetDef.event("TutorialStep"):FireServer(index)
end

-- id of the step on screen (nil when the tutorial is not running)
function Tutorial.currentId()
	local st = STEPS[index]
	return (st and panel and panel.Visible) and st.id or nil
end

function Tutorial.currentKey()
	local st = STEPS[index]
	return st and st.key or nil
end

-- true while a step is on screen (the HUD hides today's objective, the tips wait)
function Tutorial.active()
	return panel ~= nil and panel.Visible
end

local function stepText(st)
	local params = { yen = Format.yen(TutorialCfg.ServeYen, Locale.get()), n = TutorialCfg.DoneSakura }
	local s = t(st.key, params)
	if st.progress then
		s ..= "  (" .. st.progress() .. ")"
	end
	return s
end

local function paintDots()
	local parts = {}
	for i = 1, #STEPS do
		table.insert(parts, i < index and "●" or (i == index and "◉" or "○"))
	end
	dots.Text = table.concat(parts, " ")
end

local function hide()
	if panel then
		panel.Visible = false
	end
	if pointer then
		pointer:hide()
	end
end

local function show()
	local st = STEPS[index]
	if not st then
		hide()
		return
	end
	panel.Visible = true
	panel.Size = UDim2.fromOffset(Kit.profile == "phone" and 390 or 460, 76)
	iconLabel.Text = st.icon
	text.Text = stepText(st)
	nextButton.Visible = st.skippable == true or st.timer ~= nil
	paintDots()
	stepStarted = os.clock()
	stepState = { dishes = stat("dishes"), washed = stat("washed"), purchases = purchases() }
	if st.reward then
		NetDef.event("TutorialReward"):FireServer(st.reward)
	end
	Kit.popIn(panel, 0.9)
	if Core.C.Audio then
		Core.C.Audio.play("pop")
	end
end

local function finish(skipped)
	index = -1
	save()
	hide()
	if skipped then
		Core.C.UI.toast(t("tut.skipped"), "info")
	end
end

local function advance()
	index += 1
	if index > #STEPS then
		finish(false)
		return
	end
	save()
	show()
end

function Tutorial.onAction(kind)
	local st = STEPS[index]
	if st and st.action and st.action == kind then
		advance()
	end
end

function Tutorial.restart()
	index = 1
	save()
	show()
end

function Tutorial.Init()
	local gui = Core.C.UI.root()
	-- banner at the top in the middle, where today's objective is shown after the tutorial
	panel = Kit.panel({ Name = "Tutorial", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 50), Size = UDim2.fromOffset(460, 76), Visible = false, ZIndex = 7, Parent = gui })
	local stroke = panel:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = T.gold
		stroke.Thickness = 4
	end
	local tile = Kit.new("Frame", { Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(56, 56), BackgroundColor3 = Color3.fromRGB(255, 236, 196), Parent = panel }, { Kit.corner(28) })
	iconLabel = Kit.label("", { Parent = tile, Position = UDim2.fromOffset(8, 8), Size = UDim2.new(1, -16, 1, -16), TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center })
	text = Kit.label("", { Parent = panel, Position = UDim2.fromOffset(76, 6), Size = UDim2.new(1, -164, 0, 44), TextSize = 17, FontFace = T.bold, TextYAlignment = Enum.TextYAlignment.Center })
	dots = Kit.label("", { Parent = panel, Position = UDim2.fromOffset(76, 50), Size = UDim2.new(1, -164, 0, 18), TextSize = 12, TextColor3 = T.gold, FontFace = T.bold, TextWrapped = false })
	local buttons = Kit.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(76, 66), Parent = panel }, { Kit.list(Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center) })
	nextButton = Kit.button("▶", { parent = buttons, size = UDim2.fromOffset(76, 30), style = "gold", textSize = 15, order = 1, onClick = function()
		local st = STEPS[index]
		if st and (st.timer or st.skippable) then
			advance()
		end
	end })
	skipButton = Kit.button(t("ui.skip"), { parent = buttons, size = UDim2.fromOffset(76, 30), style = "plain", textSize = 14, order = 2, onClick = function()
		finish(true)
	end })
	skipButton.Name = "Skip"
	-- in first person the mouse is captured: Enter also moves on from a timed card
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and panel.Visible and (input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.KeypadEnter) then
			local st = STEPS[index]
			if st and (st.timer or st.skippable) then
				advance()
			end
		end
	end)
	Locale.Changed:Connect(function()
		skipButton.Text = t("ui.skip")
		local st = STEPS[index]
		if st and panel.Visible then
			text.Text = stepText(st)
		end
	end)
	pointer = Pointer.new("#FFD23B")
end

function Tutorial.Start()
	local Data = Core.C.Data
	if not Data.ready then
		Data.Ready:Wait()
	end
	local meta = Data.m("meta")
	index = meta and meta.tutorial or 0
	if index == 0 then
		index = 1
	end
	skipButton.Text = t("ui.skip")
	if index > 0 and index <= #STEPS and Data.role() == "owner" then
		show()
	else
		index = -1
	end
	-- offline earnings popup
	if meta and (meta.offlinePending or 0) > 0 then
		Core.C.UI.open("Offline")
	end
	while true do
		task.wait(0.25)
		local st = STEPS[index]
		if st and panel.Visible then
			-- the order guide has its own arrow
			local guide = Core.C.UI.screens.Guide
			local busy = guide and guide.visible and guide.visible()
			local w = (not busy and st.world) and st.world() or nil
			local g = st.gui and st.gui() or nil
			if g then
				pointer:gui(g)
			elseif w then
				pointer:world(w)
			else
				pointer:hide()
			end
			if st.progress then
				text.Text = stepText(st)
			end
			if st.check and st.check(stepState) then
				advance()
			elseif st.timer and os.clock() - stepStarted > st.timer then
				advance()
			end
		end
	end
end

return Tutorial
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000115"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Screen manager, toasts and shared UI helpers.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Signal = require(Shared.Util.Signal)
local Kit = require(script.Parent.Parent.UI.Kit)
local Core = require(script.Parent.Parent.Core)

local UI = {}
UI.screens = {}
UI.current = nil
UI.profile = "desktop" -- "phone" | "tablet" | "desktop"
UI.scale = 1
UI.ProfileChanged = Signal.new() -- (profile)
local T = Kit.Theme
local toastHolder

-- Screens are designed in "units": the UIScale turns them into points. Each kind of screen has a
-- design size (what fits at scale 1) and limits, so text stays readable on a phone (never below
-- 0.68: 16-unit text is still 11 points) and does not get huge on a big monitor.
local DESIGN = {
	phone = { w = 960, h = 400, min = 0.68, max = 1.0 },
	tablet = { w = 1180, h = 760, min = 0.8, max = 1.15 },
	desktop = { w = 1400, h = 800, min = 0.72, max = 1.3 },
}

function UI.root()
	return UI.gui
end

function UI.isTouch()
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

-- the area the HUD can use (under the Roblox top bar) and the kind of screen it is
local function measure()
	local size = UI.gui and UI.gui.AbsoluteSize or Vector2.zero
	if size.X < 10 or size.Y < 10 then
		local cam = workspace.CurrentCamera
		size = cam and cam.ViewportSize or Vector2.new(1280, 720)
	end
	local short = math.min(size.X, size.Y)
	local profile = short < 520 and "phone" or (UI.isTouch() and "tablet" or "desktop")
	local d = DESIGN[profile]
	return profile, math.clamp(math.min(size.X / d.w, size.Y / d.h), d.min, d.max)
end

function UI.rescale()
	if not UI.uiScale then
		return
	end
	local profile, scale = measure()
	UI.uiScale.Scale = scale
	UI.scale = scale
	local changed = profile ~= UI.profile
	UI.profile = profile
	Kit.profile = profile
	Kit.fitWindows()
	if changed then
		UI.ProfileChanged:Fire(profile)
	end
end

-- Roblox's thumbstick and jump button sit above our screens on touch devices: while a window or
-- the build catalog is open they are hidden, so a tap always reaches the window (reasons are
-- counted: the controls come back when the last one goes)
local touchBlocks = {}
function UI.blockTouch(reason, on)
	touchBlocks[reason] = on and true or nil
	local GuiService = game:GetService("GuiService")
	pcall(function()
		GuiService.TouchControlsEnabled = next(touchBlocks) == nil
	end)
end

function UI.register(name, screen)
	UI.screens[name] = screen
	if screen.create then
		local ok, err = pcall(screen.create, UI.gui)
		if not ok then
			warn("[UI] create " .. name .. " failed: " .. tostring(err))
		end
	end
end

function UI.open(name, arg)
	local s = UI.screens[name]
	if not s then
		return
	end
	if s.modal ~= false and UI.current and UI.current ~= name then
		UI.close(UI.current)
	end
	if s.modal ~= false then
		UI.current = name
		UI.blockTouch("window", true)
		if Core.C.Audio then
			Core.C.Audio.play("open")
		end
	end
	local ok, err = pcall(s.open, arg)
	if not ok then
		warn("[UI] open " .. name .. ": " .. tostring(err))
	end
end

function UI.close(name)
	name = name or UI.current
	local s = name and UI.screens[name]
	if s and s.close then
		pcall(s.close)
	end
	if UI.current == name then
		UI.current = nil
		UI.blockTouch("window", false)
	end
end

function UI.toggle(name, arg)
	if UI.current == name then
		UI.close(name)
	else
		UI.open(name, arg)
	end
end

function UI.refreshAll()
	for name, s in pairs(UI.screens) do
		if s.refresh and (s.visible == nil or s.visible()) then
			local ok, err = pcall(s.refresh)
			if not ok then
				warn("[UI] refresh " .. name .. ": " .. tostring(err))
			end
		end
	end
end

local KIND_COLOR = { info = T.wood, success = T.green, error = T.red, warning = T.gold, level = T.gold }

function UI.toast(text, kind)
	if not toastHolder then
		return
	end
	-- under the tutorial banner while it is on screen
	local tut = Core.C.Tutorial
	toastHolder.Position = UDim2.new(0.5, 0, 0, (tut and tut.active and tut.active()) and 134 or 92)
	local f = Kit.panel({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.paper, Parent = toastHolder })
	f:FindFirstChildOfClass("UIStroke").Color = KIND_COLOR[kind] or T.wood
	Kit.padding(12, 8).Parent = f
	Kit.label(text, { Parent = f, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 18, FontFace = T.bold, TextColor3 = kind == "error" and T.red or T.ink })
	Kit.popIn(f, 0.7)
	task.delay(kind == "level" and 5 or 3.2, function()
		if f.Parent then
			TweenService:Create(f, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
			for _, d in ipairs(f:GetDescendants()) do
				if d:IsA("TextLabel") then
					TweenService:Create(d, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
				elseif d:IsA("UIStroke") then
					TweenService:Create(d, TweenInfo.new(0.3), { Transparency = 1 }):Play()
				end
			end
			task.wait(0.35)
			f:Destroy()
		end
	end)
	local items = {}
	for _, c in ipairs(toastHolder:GetChildren()) do
		if c:IsA("Frame") then
			table.insert(items, c)
		end
	end
	if #items > 5 then
		items[1]:Destroy()
	end
end

function UI.Init()
	local pg = Players.LocalPlayer:WaitForChild("PlayerGui")
	UI.gui = Kit.new("ScreenGui", { Name = "RamenUI", ResetOnSpawn = false, IgnoreGuiInset = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = pg })
	UI.uiScale = Kit.new("UIScale", { Parent = UI.gui })
	UI.rescale()
	UI.gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(UI.rescale)
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(UI.rescale)
	end
	-- messages appear under the objective, in the middle of the screen
	toastHolder = Kit.new("Frame", { Name = "Toasts", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 92), Size = UDim2.fromOffset(460, 300), ZIndex = 20, Parent = UI.gui }, { Kit.list(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center) })
	local screens = script.Parent.Parent.UI.Screens
	for _, m in ipairs(screens:GetChildren()) do
		if m:IsA("ModuleScript") then
			local ok, s = pcall(require, m)
			if ok then
				Core.Screens[m.Name] = s
			else
				warn("[UI] screen " .. m.Name .. ": " .. tostring(s))
			end
		end
	end
	for name, s in pairs(Core.Screens) do
		UI.register(name, s)
	end
	NetDef.event("Notify").OnClientEvent:Connect(function(key, params, kind)
		UI.toast(Locale.t(key, params), kind)
		if kind == "error" and Core.C.Audio then
			Core.C.Audio.play("error")
		end
	end)
	Locale.Changed:Connect(UI.refreshAll)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
			if UI.current then
				UI.close(UI.current)
			end
		end
	end)
end

local function vipChat()
	local TextChatService = game:GetService("TextChatService")
	pcall(function()
		TextChatService.OnIncomingMessage = function(message)
			local props = Instance.new("TextChatMessageProperties")
			local source = message.TextSource
			local p = source and Players:GetPlayerByUserId(source.UserId)
			if p and p:GetAttribute("VIP") then
				props.PrefixText = "<font color=\"#D4A23C\">[VIP]</font> " .. message.PrefixText
			end
			return props
		end
	end)
end

function UI.Start()
	vipChat()
	local Data = Core.C.Data
	Data.Changed:Connect(function()
		UI.refreshAll()
	end)
	Data.SessionChanged:Connect(UI.refreshAll)
	Data.DayChanged:Connect(function(state)
		local hud = UI.screens.HUD
		if hud and hud.day then
			hud.day(state)
		end
	end)
	UI.refreshAll()
end

return UI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000116"><Properties><string name="Name">WorldUI</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Localized billboards over customers (order + patience), stations (board / next step),
-- rice cookers & pots, shelf slots, dirty dishes and staff name tags.
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Locale = require(Shared.Locale)
local Recipes = require(Shared.Config.Recipes)
local Ingredients = require(Shared.Config.Ingredients)
local Color = require(Shared.Util.Color)
local Core = require(script.Parent.Parent.Core)

local WorldUI = {}
local player = Players.LocalPlayer
local t = Locale.t
local boards = {} -- [Instance] = { gui, title, sub, bar, fill }

local RANGE = 45
local TYPE_ICON = { cust_critic = "🧐", cust_influencer = "📱", cust_vip = "💎", cust_celebrity = "⭐" }

local function make(adornee, height, width)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(width or 210, 66)
	gui.StudsOffsetWorldSpace = Vector3.new(0, height or 3, 0)
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.MaxDistance = RANGE
	gui.Adornee = adornee
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color.hex("#F4EBDD")
	bg.BackgroundTransparency = 0.05
	bg.Parent = gui
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 12)
	c.Parent = bg
	local s = Instance.new("UIStroke")
	s.Color = Color.hex("#5B3A24")
	s.Thickness = 2
	s.Parent = bg
	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Size = UDim2.new(1, -8, 0.55, 0)
	title.Position = UDim2.fromOffset(4, 2)
	title.TextScaled = true
	title.FontFace = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold)
	title.TextColor3 = Color.hex("#2B2320")
	title.AutoLocalize = false
	title.Parent = bg
	local sub = Instance.new("TextLabel")
	sub.BackgroundTransparency = 1
	sub.Size = UDim2.new(1, -8, 0.32, 0)
	sub.Position = UDim2.new(0, 4, 0.56, 0)
	sub.TextScaled = true
	sub.FontFace = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Medium)
	sub.TextColor3 = Color.hex("#7A6A5A")
	sub.AutoLocalize = false
	sub.Parent = bg
	local bar = Instance.new("Frame")
	bar.BackgroundColor3 = Color.hex("#D8C8AE")
	bar.Size = UDim2.new(1, -16, 0, 9)
	bar.Position = UDim2.new(0, 8, 1, -13)
	bar.Visible = false
	bar.Parent = bg
	local barCorner = Instance.new("UICorner")
	barCorner.CornerRadius = UDim.new(0, 4)
	barCorner.Parent = bar
	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = Color.hex("#5E8F3A")
	fill.Size = UDim2.fromScale(1, 1)
	fill.Parent = bar
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0, 4)
	fillCorner.Parent = fill
	gui.Parent = player.PlayerGui
	return { gui = gui, bg = bg, title = title, sub = sub, bar = bar, fill = fill }
end

-- Customer bubble: sized in studs (2.7 wide, narrower than the 3 studs between two stools, so
-- neighbours never overlap), always on top, a big icon (❗, the dish, 😋), the dish name, and a
-- thick patience bar that turns yellow and red
local function makeCustomer(adornee)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(2.7, 1.5)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 2.3, 0)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 40
	gui.Adornee = adornee
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color.hex("#FFFBF2")
	bg.Parent = gui
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0.22, 0)
	c.Parent = bg
	local s = Instance.new("UIStroke")
	s.Color = Color.hex("#5B3A24")
	s.Thickness = 2.5
	s.Parent = bg
	local icon = Instance.new("TextLabel")
	icon.BackgroundTransparency = 1
	icon.Position = UDim2.fromScale(0.03, 0.06)
	icon.Size = UDim2.fromScale(0.34, 0.66)
	icon.TextScaled = true
	icon.AutoLocalize = false
	icon.Parent = bg
	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromScale(0.38, 0.06)
	title.Size = UDim2.fromScale(0.6, 0.38)
	title.TextScaled = true
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.FontFace = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Heavy)
	title.TextColor3 = Color.hex("#2B2320")
	title.AutoLocalize = false
	title.Parent = bg
	local sub = Instance.new("TextLabel")
	sub.BackgroundTransparency = 1
	sub.Position = UDim2.fromScale(0.38, 0.44)
	sub.Size = UDim2.fromScale(0.6, 0.28)
	sub.TextScaled = true
	sub.TextXAlignment = Enum.TextXAlignment.Left
	sub.FontFace = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold)
	sub.TextColor3 = Color.hex("#7A5A3A")
	sub.AutoLocalize = false
	sub.Parent = bg
	local bar = Instance.new("Frame")
	bar.BackgroundColor3 = Color.hex("#D8C8AE")
	bar.Position = UDim2.fromScale(0.06, 0.78)
	bar.Size = UDim2.fromScale(0.88, 0.14)
	bar.Visible = false
	bar.Parent = bg
	local bc = Instance.new("UICorner")
	bc.CornerRadius = UDim.new(0.5, 0)
	bc.Parent = bar
	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = Color.hex("#5E8F3A")
	fill.Size = UDim2.fromScale(1, 1)
	fill.Parent = bar
	local fc = Instance.new("UICorner")
	fc.CornerRadius = UDim.new(0.5, 0)
	fc.Parent = fill
	gui.Parent = player.PlayerGui
	return { gui = gui, bg = bg, icon = icon, title = title, sub = sub, bar = bar, fill = fill, customer = true }
end

local function icons(list)
	local out = {}
	for _, g in ipairs(list) do
		local ing = Ingredients.byId[g]
		table.insert(out, ing and ing.icon or "?")
	end
	return table.concat(out, " ")
end

local function setBar(b, value, show)
	b.bar.Visible = show
	if show then
		b.fill.Size = UDim2.fromScale(math.clamp(value, 0, 1), 1)
		b.fill.BackgroundColor3 = value > 0.5 and Color.hex("#5E8F3A") or (value > 0.25 and Color.hex("#D4A23C") or Color.hex("#B3262E"))
	end
end

local function updateEntity(model, b)
	local kind = model:GetAttribute("Kind")
	local now = workspace:GetServerTimeNow()
	b.gui.Enabled = true
	if kind == "customer" then
		local state = model:GetAttribute("State") or ""
		local order = model:GetAttribute("Order") or ""
		local typeIcon = TYPE_ICON[model:GetAttribute("Type") or ""] or ""
		local r = Recipes.byId[order]
		local icon = b.icon
		if state == "order" then
			icon.Text = "❗"
			b.title.Text = typeIcon .. t("ui.wants_order")
			b.sub.Text = t("hint.take_order")
		elseif state == "waiting" then
			icon.Text = r and r.icon or "🍽️"
			b.title.Text = typeIcon .. t("rec." .. order)
			b.sub.Text = t("ui.waiting")
		elseif state == "eating" or state == "served" then
			icon.Text = "😋"
			b.title.Text = t("ui.eating")
			b.sub.Text = ""
		elseif state == "queue" then
			icon.Text = "⏳"
			b.title.Text = t("ui.queue")
			b.sub.Text = ""
		else
			b.gui.Enabled = false
		end
		setBar(b, model:GetAttribute("Patience") or 1, state == "order" or state == "waiting")
		-- a gentle pulse while the order waits to be taken
		b.bg.BackgroundColor3 = state == "order" and Color.hex(math.floor(now * 2) % 2 == 0 and "#FFF1C2" or "#FFFBF2") or Color.hex("#FFFBF2")
	elseif (kind == "station" or kind == "ricecooker") and Core.C.Interaction and Core.C.Interaction.lockOf(model, kind) then
		-- not usable yet: name the license that unlocks it
		local lock = Core.C.Interaction.lockOf(model, kind)
		b.title.Text = "🔒 " .. t("lic." .. lock.id)
		b.sub.Text = t("ui.locked_level", { level = lock.level })
		b.bar.Visible = false
	elseif kind == "station" then
		local ready = model:GetAttribute("Ready") or ""
		local board = model:GetAttribute("Board") or ""
		local recipe = model:GetAttribute("Recipe") or ""
		if ready ~= "" then
			b.title.Text = "✅ " .. t("rec." .. ready)
			b.sub.Text = t("ui.ready_to_serve")
		elseif recipe ~= "" then
			local steps = string.split(model:GetAttribute("Steps") or "", ",")
			local idx = (model:GetAttribute("Step") or 0) + 1
			b.title.Text = (Recipes.byId[recipe] and Recipes.byId[recipe].icon or "") .. " " .. t("rec." .. recipe)
			b.sub.Text = (model:GetAttribute("Busy") and "⏳ " or "👆 ") .. t("step." .. (steps[idx] or "combine")) .. " (" .. idx .. "/" .. #steps .. ")"
		elseif board ~= "" then
			b.title.Text = icons(string.split(board, ","))
			b.sub.Text = t("ui.board_incomplete")
		else
			b.gui.Enabled = false
		end
		b.bar.Visible = false
	elseif kind == "ricecooker" or kind == "pot" then
		local n, c, batch = model:GetAttribute("N") or 0, model:GetAttribute("C") or 0, model:GetAttribute("Batch") or 0
		local g = model:GetAttribute("G") or ""
		local icon = kind == "ricecooker" and "🍚" or "🥣"
		local name = g ~= "" and t("ing." .. g) or t(kind == "ricecooker" and "ui.rice_cooker" or "ui.pot")
		b.title.Text = icon .. " " .. name
		if c > 0 then
			local remaining = math.max(0, (model:GetAttribute("T") or now) - now)
			local total = model:GetAttribute("Time") or 1
			b.sub.Text = "⏳ " .. math.ceil(remaining) .. "s  (+" .. c .. ")"
			setBar(b, 1 - remaining / total, true)
			b.fill.BackgroundColor3 = Color.hex("#2E5A8C")
		else
			b.sub.Text = n .. " / " .. batch .. (n == 0 and ("  ·  " .. t("ui.empty")) or "")
			setBar(b, n / math.max(1, batch), true)
		end
	elseif kind == "tipjar" then
		local tips = model:GetAttribute("Tips") or 0
		b.gui.Enabled = tips > 0
		b.title.Text = "🫙 ¥" .. tips
		b.sub.Text = t("ui.tipjar_collect")
		b.bar.Visible = false
	elseif kind == "dirty" then
		b.title.Text = "🧽"
		b.sub.Text = t("hint.collect")
		b.bar.Visible = false
	elseif kind == "dishwasher" then
		local q = model:GetAttribute("Queue") or 0
		b.gui.Enabled = q > 0
		b.title.Text = "🫧 " .. q
		b.sub.Text = t("ui.washing")
	else
		b.gui.Enabled = false
	end
end

local staffTags = {}

local function updateStaff(char, origin)
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local b = staffTags[char]
	if not b then
		b = make(char:FindFirstChild("Head") or root, 1.8, 150)
		b.gui.Size = UDim2.fromOffset(150, 40)
		staffTags[char] = b
	end
	local near = (root.Position - origin).Magnitude < RANGE
	b.gui.Enabled = near
	if near then
		b.title.Text = char:GetAttribute("StaffName") or ""
		b.sub.Text = t("staff." .. (char:GetAttribute("StaffRole") or "staff_waiter")) .. " · Lv" .. (char:GetAttribute("StaffLevel") or 1)
	end
end

-- the "for sale" signs of rooms (Models/Scene.forSale): icon, name and price in your language,
-- or the level it needs
local function paintSigns()
	local Format = require(Shared.Util.Format)
	local level = Core.C.Data.w("level") or 1
	local yen = Core.C.Data.wallet()
	for _, m in ipairs(CollectionService:GetTagged("ForSale")) do
		local board = m.PrimaryPart
		local id = m:GetAttribute("Expansion") or ""
		local price = m:GetAttribute("Price") or 0
		local need = m:GetAttribute("Level") or 1
		local text
		if level < need then
			text = "🔒\n" .. t("zone." .. id) .. "\n" .. t("ui.req_level", { level = need })
		else
			text = "🏗️ " .. t("zone." .. id) .. "\n" .. Format.yen(price, Locale.get()) .. (yen >= price and "  ✅" or "")
		end
		for _, side in ipairs({ "Front", "Back" }) do
			local gui = board and board:FindFirstChild(side)
			local label = gui and gui:FindFirstChildOfClass("TextLabel")
			if label and label.Text ~= text then
				label.Text = text
			end
		end
	end
end

function WorldUI.Start()
	local lastSigns = 0
	while true do
		task.wait(0.2)
		if os.clock() - lastSigns > 1 then
			lastSigns = os.clock()
			pcall(paintSigns)
		end
		local cam = workspace.CurrentCamera
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local origin = root and root.Position or (cam and cam.CFrame.Position) or Vector3.new()
		local alive = {}
		for _, model in ipairs(CollectionService:GetTagged("Interactable")) do
			if model:IsDescendantOf(workspace) then
				local kind = model:GetAttribute("Kind")
				local pos = model:GetPivot().Position
				local near = (pos - origin).Magnitude < RANGE
				-- shelves need no label: their products stand in a grid with the free spots marked;
				-- customers show their bubble everywhere, the other boards only in the restaurant you
				-- work in
				local mine = kind == "customer" or Core.C.Data.isMine(model)
				if near and mine and (kind == "customer" or kind == "station" or kind == "ricecooker" or kind == "pot" or kind == "dirty" or kind == "dishwasher" or kind == "tipjar") then
					local b = boards[model]
					if not b then
						local adornee = model:FindFirstChild("Head") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
						b = kind == "customer" and makeCustomer(adornee) or make(adornee, kind == "station" and 3 or 2.5)
						boards[model] = b
					end
					alive[model] = true
					local ok = pcall(updateEntity, model, b)
					if not ok then
						b.gui.Enabled = false
					end
				end
			end
		end
		for model, b in pairs(boards) do
			if not alive[model] then
				b.gui:Destroy()
				boards[model] = nil
			end
		end
		local npcs = workspace:FindFirstChild("NPCs")
		if npcs then
			for _, m in ipairs(npcs:GetChildren()) do
				if m:GetAttribute("StaffName") then
					updateStaff(m, origin)
				end
			end
		end
		for m, b in pairs(staffTags) do
			if not m:IsDescendantOf(workspace) then
				b.gui:Destroy()
				staffTags[m] = nil
			end
		end
	end
end

return WorldUI
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX000118"><Properties><string name="Name">Core</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Shared registry of client controllers and UI screens.
return {
	C = {},
	Screens = {},
}
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX000119"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Client entry point.
if not game:IsLoaded() then
	game.Loaded:Wait()
end

local Core = require(script.Parent.Core)
local Controllers = script.Parent.Controllers

local ORDER = {
	"Data", "Audio", "UI", "Lighting", "Ambient", "WorldUI", "Camera", "Interaction", "FirstPerson", "Sink", "ShelfTags", "Timing", "Build", "Tutorial", "Hints", "Effects",
}

for _, name in ipairs(ORDER) do
	local m = Controllers:FindFirstChild(name)
	if m then
		local ok, c = pcall(require, m)
		if ok then
			Core.C[name] = c
		else
			warn("[Client] failed to load " .. name .. ": " .. tostring(c))
		end
	end
end

for _, name in ipairs(ORDER) do
	local c = Core.C[name]
	if c and c.Init then
		local ok, err = pcall(c.Init)
		if not ok then
			warn("[Client] " .. name .. ".Init failed: " .. tostring(err))
		end
	end
end

for _, name in ipairs(ORDER) do
	local c = Core.C[name]
	if c and c.Start then
		task.spawn(function()
			local ok, err = pcall(c.Start)
			if not ok then
				warn("[Client] " .. name .. ".Start failed: " .. tostring(err))
			end
		end)
	end
end
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX000141"><Properties><string name="Name">UI</string></Properties><Item class="ModuleScript" referent="RBX000120"><Properties><string name="Name">Base</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Helper to build standard modal screens: Base.make(name, titleKey, size, render)
-- render(content, screen) rebuilds the content each refresh.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Locale = require(Shared.Locale)
local Kit = require(script.Parent.Kit)

local Base = {}

function Base.make(name, titleKey, size, render)
	local s = { name = name }
	function s.create(root)
		s.win = Kit.window(root, size, Locale.t(titleKey), function()
			local Core = require(script.Parent.Parent.Core)
			Core.C.UI.close(name)
		end)
	end
	function s.visible()
		return s.win ~= nil and s.win.frame.Visible
	end
	-- The content is built again on every change; data changes come in bursts (a customer pays,
	-- a quest moves...), so a refresh waits a moment after the previous one, and the lists keep
	-- their scroll position.
	local last, pending = -1, false
	function s.refresh()
		if not s.win then
			return
		end
		local now = os.clock()
		if now - last < 0.2 then
			if not pending then
				pending = true
				task.delay(0.2, function()
					pending = false
					if s.win.frame.Visible then
						s.refresh()
					end
				end)
			end
			return
		end
		last = now
		s.win.title.Text = Locale.t(titleKey)
		local scrolls = {}
		for _, d in ipairs(s.win.content:GetDescendants()) do
			if d:IsA("ScrollingFrame") then
				scrolls[d.Name] = d.CanvasPosition
			end
		end
		Kit.clear(s.win.content)
		local ok, err = pcall(render, s.win.content, s)
		if not ok then
			warn("[UI] " .. name .. ": " .. tostring(err))
		end
		for _, d in ipairs(s.win.content:GetDescendants()) do
			if d:IsA("ScrollingFrame") and scrolls[d.Name] then
				d.CanvasPosition = scrolls[d.Name]
			end
		end
	end
	function s.open(arg)
		s.arg = arg
		local was = s.win.frame.Visible
		s.win.frame.Visible = true
		last = -1
		s.refresh()
		if not was then
			Kit.popIn(s.win.frame)
		end
	end
	function s.close()
		if s.win then
			s.win.frame.Visible = false
		end
	end
	return s
end

return Base
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000121"><Properties><string name="Name">Icons</string><ProtectedString name="Source"><![CDATA[--!nonstrict
