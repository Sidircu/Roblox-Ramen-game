	{ id = "shoyu_ramen", station = "ramen", ing = { "noodles", "scallion", "naruto" }, broth = "broth_shoyu", steps = { "boil", "pour", "top" }, price = 55, xp = 14, cat = "ramen", license = "lic_base", icon = "🍜", dish = "bowl" },
