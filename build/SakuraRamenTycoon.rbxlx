	a.order = i
	byId[a.id] = a
end
return { list = list, byId = byId }
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000005"><Properties><string name="Name">Audio</string><ProtectedString name="Source"><![CDATA[--!nonstrict
