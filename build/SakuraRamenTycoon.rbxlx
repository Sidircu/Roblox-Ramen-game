<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" version="4"><Item class="ReplicatedFirst" referent="RBX000002"><Properties><string name="Name">ReplicatedFirst</string></Properties><Item class="LocalScript" referent="RBX000001"><Properties><string name="Name">Loading</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Loading screen (shown while the world is prepared or while teleporting to the personal world).
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local isItalian = string.sub(string.lower(player.LocaleId or ""), 1, 2) == "it"

local gui = Instance.new("ScreenGui")
gui.Name = "Loading"
gui.IgnoreGuiInset = true
gui.DisplayOrder = 100
gui.ResetOnSpawn = false

local bg = Instance.new("Frame")
bg.Size = UDim2.fromScale(1, 1)
bg.BackgroundColor3 = Color3.fromRGB(244, 235, 221)
bg.Parent = gui
local grad = Instance.new("UIGradient")
grad.Color = ColorSequence.new(Color3.fromRGB(247, 227, 192), Color3.fromRGB(244, 210, 200))
grad.Rotation = 90
grad.Parent = bg

local title = Instance.new("TextLabel")
title.AnchorPoint = Vector2.new(0.5, 0.5)
title.Position = UDim2.fromScale(0.5, 0.38)
title.Size = UDim2.fromScale(0.8, 0.12)
title.BackgroundTransparency = 1
title.Text = "Sakura Ramen & Sushi Tycoon"
title.TextScaled = true
title.TextColor3 = Color3.fromRGB(179, 38, 46)
title.FontFace = Font.new("rbxasset://fonts/families/FredokaOne.json")
title.AutoLocalize = false
title.Parent = bg

local kanji = Instance.new("TextLabel")
kanji.AnchorPoint = Vector2.new(0.5, 0.5)
kanji.Position = UDim2.fromScale(0.5, 0.5)
kanji.Size = UDim2.fromScale(0.5, 0.07)
kanji.BackgroundTransparency = 1
kanji.Text = "ら ー め ん ・ 寿 司"
kanji.TextScaled = true
kanji.TextColor3 = Color3.fromRGB(43, 35, 32)
kanji.FontFace = Font.new("rbxasset://fonts/families/FredokaOne.json")
kanji.AutoLocalize = false
kanji.Parent = bg

local flower = Instance.new("TextLabel")
flower.AnchorPoint = Vector2.new(0.5, 0.5)
flower.Position = UDim2.fromScale(0.5, 0.64)
flower.Size = UDim2.fromOffset(70, 70)
flower.BackgroundTransparency = 1
flower.Text = "🌸"
flower.TextScaled = true
flower.AutoLocalize = false
flower.Parent = bg

local status = Instance.new("TextLabel")
status.AnchorPoint = Vector2.new(0.5, 0.5)
status.Position = UDim2.fromScale(0.5, 0.76)
status.Size = UDim2.fromScale(0.8, 0.045)
status.BackgroundTransparency = 1
status.Text = isItalian and "Stiamo preparando il tuo ristorante…" or "Preparing your restaurant…"
status.TextScaled = true
status.TextColor3 = Color3.fromRGB(91, 58, 36)
status.FontFace = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.SemiBold)
status.AutoLocalize = false
status.Parent = bg

gui.Parent = player:WaitForChild("PlayerGui")
pcall(function()
	ReplicatedFirst:RemoveDefaultLoadingScreen()
end)
pcall(function()
	TeleportService:SetTeleportGui(gui)
end)

local spin = RunService.RenderStepped:Connect(function(dt)
	flower.Rotation = (flower.Rotation + dt * 90) % 360
end)

if not game:IsLoaded() then
	game.Loaded:Wait()
end

local t0 = os.clock()
while os.clock() - t0 < 25 do
	if workspace:GetAttribute("WorldReady") then
		break
	end
	task.wait(0.2)
end

do
	task.wait(0.5)
	local info = TweenInfo.new(0.6)
	for _, d in ipairs(bg:GetDescendants()) do
		if d:IsA("TextLabel") then
			TweenService:Create(d, info, { TextTransparency = 1 }):Play()
		end
	end
	TweenService:Create(bg, info, { BackgroundTransparency = 1 }):Play()
	task.wait(0.7)
	spin:Disconnect()
	gui:Destroy()
end
]]></ProtectedString></Properties></Item></Item><Item class="ReplicatedStorage" referent="RBX000068"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX000066"><Properties><string name="Name">Shared</string></Properties><Item class="Folder" referent="RBX000028"><Properties><string name="Name">Config</string></Properties><Item class="ModuleScript" referent="RBX000003"><Properties><string name="Name">Achievements</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Achievements are generated from tiered templates. Name key: "ach.<stat>" with {n}.
local templates = {
	{ stat = "dishes", tiers = { 10, 100, 1000, 10000, 100000 }, sakura = { 5, 10, 20, 35, 50 } },
	{ stat = "customers", tiers = { 10, 250, 2500, 25000 }, sakura = { 5, 10, 25, 50 } },
	{ stat = "earned", tiers = { 10000, 250000, 5000000, 100000000 }, sakura = { 5, 15, 30, 50 } },
	{ stat = "decor", tiers = { 5, 25, 75, 150 }, sakura = { 5, 10, 20, 40 } },
	{ stat = "staff", tiers = { 1, 4, 8, 12 }, sakura = { 5, 10, 20, 30 } },
	{ stat = "gold_mastery", tiers = { 1, 5, 15, 30 }, sakura = { 10, 20, 35, 50 } },
	{ stat = "level", tiers = { 5, 10, 20, 30, 40, 50 }, sakura = { 5, 10, 15, 20, 30, 50 } },
	{ stat = "licenses", tiers = { 3, 8, 17 }, sakura = { 5, 15, 40 } },
	{ stat = "zones", tiers = { 2, 5, 9 }, sakura = { 5, 15, 40 } },
	{ stat = "renos", tiers = { 3, 8, 15 }, sakura = { 5, 15, 40 } },
	{ stat = "five_stars", tiers = { 10, 100, 1000, 10000 }, sakura = { 5, 10, 25, 50 } },
	{ stat = "franchise", tiers = { 1, 2, 3, 4, 5 }, sakura = { 20, 30, 40, 50, 100 } },
	{ stat = "days", tiers = { 1, 10, 50, 200 }, sakura = { 3, 10, 25, 50 } },
	{ stat = "washed", tiers = { 50, 1000, 20000 }, sakura = { 5, 15, 40 } },
}

local list = {}
local byId = {}
for _, t in ipairs(templates) do
	for i, n in ipairs(t.tiers) do
		local a = { id = "ach_" .. t.stat .. "_" .. i, stat = t.stat, target = n, sakura = t.sakura[i], tier = i }
		table.insert(list, a)
		byId[a.id] = a
	end
end

return { list = list, byId = byId }
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000004"><Properties><string name="Name">Ads</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- One-day advertising campaigns.
local list = {
	{ id = "ad_flyers", icon = "📰", cost = 500, lv = 1, popularity = 0.20 },
	{ id = "ad_radio", icon = "📻", cost = 5000, lv = 10, popularity = 0.35 },
	{ id = "ad_tv", icon = "📺", cost = 50000, lv = 25, popularity = 0.60, tourists = true },
}
local byId = {}
for i, a in ipairs(list) do
	a.order = i
	byId[a.id] = a
end
return { list = list, byId = byId }
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000005"><Properties><string name="Name">Analytics</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Roblox Analytics setup (Creator Dashboard → Analytics).
-- Funnel: the onboarding steps of a new player, in order; each one is logged once per player.
-- SourceFlush: seconds between two reports of the yen earned with sales and tips (summed up).
local Funnel = {
	"joined", -- the profile was created
	"first_order", -- the first customer ordered
	"first_cook", -- the first dish came out of a station
	"first_serve", -- the first customer was served
	"tutorial_done", -- the tutorial was finished (not skipped)
	"first_purchase", -- the first thing bought with yen
	"served_10", -- ten customers served
	"level_3",
	"level_5",
}
local FunnelIndex = {}
for i, name in ipairs(Funnel) do
	FunnelIndex[name] = i
end

return {
	Funnel = Funnel,
	FunnelIndex = FunnelIndex,
	SourceFlush = 120,
	-- what kind of transaction each yen source and sink is (Enum.AnalyticsEconomyTransactionType)
	SourceType = {
		sale = "Gameplay", tip = "Gameplay", helper = "Gameplay", level = "Gameplay", quest = "Gameplay",
		gift = "TimedReward", daily = "TimedReward", offline = "TimedReward", tutorial = "Onboarding",
		product = "IAP", refund = "Shop", code = "TimedReward",
	},
	SinkType = { build = "Shop", supplies = "Gameplay", salary = "Gameplay", other = "Shop" },
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000006"><Properties><string name="Name">Audio</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Sounds. Every id comes from the public Roblox Creator Store library (Pro Sound Effects, APM Music
-- and Roblox UI sounds), so it plays in any experience. Each effect lists one or more takes: one is
-- picked at random and slightly re-pitched so repeated actions never sound identical.
--   ids    takes to choose from
--   volume base volume (multiplied by the player's sfx setting)
--   pitch  { min, max } PlaybackSpeed range
--   len    stop after this many seconds (with a short fade) for long recordings
--   start  start this many seconds into the recording
--   range  hearing distance in studs for positional sounds
local function a(id)
	return "rbxassetid://" .. id
end

local CHOP = {}
for _, id in ipairs({
	9113800103, 9113800168, 9113800170, 9113800257, 9113800310, 9113800372, 9113800368,
	9113800380, 9113800479, 9113800491, 9113800677, 9113800686, 9113800857, 9113801019,
	9113801156, 9113801563,
}) do
	table.insert(CHOP, a(id))
end

return {
	-- background music: a calm playlist for the day and one for the evening
	Music = {
		day = { a(1846310773), a(1838606941), a(135844487150341) }, -- Minimal Koto, Asian Lounge, Under The Cherry Blossoms
		night = { a(1837510751), a(1841374108) }, -- Kyoto In The Snow, Cherry Blossom After Frost
	},
	-- loops mixed by the client from where you are and what happens around you
	Ambience = {
		street = { id = a(9112798079), volume = 0.32 }, -- Japanese traffic (louder outside)
		restaurant = { id = a(9112862817), volume = 0.3 }, -- restaurant chatter (grows with customers)
		boil = { id = a(9120500149), volume = 0.4, range = 26 }, -- bubbling broth pot
		cooker = { id = a(9120500158), volume = 0.18, range = 18 }, -- rice cooker simmering
		train = { id = a(9112798561), volume = 0.7, range = 320 }, -- train on the viaduct
	},
	Sfx = {
		-- interface
		click = { ids = { a(15675032796) }, volume = 0.45 },
		ui = { ids = { a(15675059323) }, volume = 0.45 },
		open = { ids = { a(15675037413) }, volume = 0.4 },
		error = { ids = { a(15675075163) }, volume = 0.45 },
		gift = { ids = { a(15675055424) }, volume = 0.6, len = 1.5 },
		level = { ids = { a(15675043410) }, volume = 0.7 },
		sparkle = { ids = { a(9126073001), a(9126073318) }, volume = 0.4 },
		combo = { ids = { a(9126076030) }, volume = 0.45, pitch = { 1, 1 } },
		-- money
		coin = { ids = { a(9113728042), a(9113728049) }, volume = 0.55 }, -- cash register
		tip = { ids = { a(9113848943), a(9113849011) }, volume = 0.45 }, -- coins on a wooden counter
		-- kitchen
		chop = { ids = CHOP, volume = 0.85, pitch = { 0.94, 1.1 }, len = 0.7, range = 50 }, -- knife on a cutting board
		pour = { ids = { a(9114612188), a(9114612102) }, volume = 0.75, len = 2.6, range = 50 }, -- broth poured into a bowl
		drain = { ids = { a(9120589761) }, volume = 0.75, range = 50 }, -- noodles shaken dry in the strainer
		boilstep = { ids = { a(9120500158) }, volume = 0.5, len = 1.6, start = 2, range = 40 }, -- noodles in boiling water
		sizzle = { ids = { a(9114542867) }, volume = 0.6, len = 2.4, start = 4, range = 50 }, -- frying
		spatula = { ids = { a(9125594711), a(9119452055), a(9119448503) }, volume = 0.45, range = 40 },
		utensil = { ids = { a(9120969635), a(9120969740) }, volume = 0.5, range = 40 }, -- wooden tools, rolling mat
		batter = { ids = { a(9117142914) }, volume = 0.5, len = 1.2, start = 1, range = 40 },
		plate = { ids = { a(9117654146), a(9117654198), a(9117654476), a(9117654482) }, volume = 0.5, range = 50 },
		rice = { ids = { a(9118770347) }, volume = 0.45, len = 2, range = 40 }, -- rice poured into the cooker
		wash = { ids = { a(9125619398) }, volume = 0.45, len = 3, range = 40 },
		beep = { ids = { a(9118776841) }, volume = 0.4, range = 40 }, -- appliance ready
		bell = { ids = { a(9114058445), a(9114058446) }, volume = 0.5, len = 2.5, range = 80 }, -- dish ready / day opens
		-- storage
		box = { ids = { a(9113720101) }, volume = 0.55, range = 40 }, -- cardboard box picked up / put down
		restock = { ids = { a(9113578540), a(9113579415) }, volume = 0.5, range = 40 }, -- box slid onto a shelf
		place = { ids = { a(9120880067), a(9120880071) }, volume = 0.5, range = 40 },
		pop = { ids = { a(9120880067), a(9120880071) }, volume = 0.28, pitch = { 1.15, 1.3 }, range = 30 }, -- a product lands on its spot
		truck = { ids = { a(9114075649) }, volume = 0.3, range = 200 },
		-- customers
		ticket = { ids = { a(15675037413) }, volume = 0.45, range = 50 }, -- order written on a ticket
		chime = { ids = { a(9120749869) }, volume = 0.4, len = 3, range = 70 }, -- furin wind chime at the door
		slurp = { ids = { a(9117020558), a(9117020823), a(9117021097) }, volume = 0.45, range = 35 },
	},
	-- which effects play during each cooking step (see Audio.step)
	Steps = {
		cut = { hit = "chop", hits = 5 },
		combine = { first = "utensil", last = "plate" },
		roll = { first = "utensil", last = "utensil" },
		mold = { first = "utensil", last = "plate" },
		boil = { first = "boilstep", last = "drain" },
		pour = { first = "pour" },
		top = { first = "utensil", last = "plate" },
		batter = { first = "batter" },
		fry = { first = "sizzle" },
		flip = { first = "spatula", last = "sizzle" },
	},
	Volume = { music = 0.35, sfx = 0.8, ambience = 0.7 },
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000007"><Properties><string name="Name">Customers</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Customer types. prefer: recipe categories or tags with doubled order probability.
local list = {
	{ id = "cust_student", lv = 1, weight = 30, group = { 1, 1 }, patience = 70, tip = 0.7, prefer = { "ramen", "cheap" }, look = "casual" },
	{ id = "cust_salaryman", lv = 1, weight = 30, group = { 1, 1 }, patience = 50, lunchPatience = 35, tip = 1.0, prefer = { "ramen" }, look = "suit" },
	{ id = "cust_tourist", lv = 3, weight = 15, group = { 1, 2 }, patience = 100, tip = 1.4, prefer = { "sushi" }, look = "tourist" },
	{ id = "cust_couple", lv = 3, weight = 12, group = { 2, 2 }, patience = 80, tip = 1.1, prefer = { "sushi", "dessert" }, look = "casual", needsTable = true },
	{ id = "cust_elder", lv = 5, weight = 8, group = { 1, 1 }, patience = 130, tip = 1.0, prefer = { "drink", "side", "sushi" }, look = "elder" },
	{ id = "cust_family", lv = 6, weight = 10, group = { 3, 4 }, patience = 90, tip = 1.0, prefer = {}, look = "casual", needsTable = true },
	{ id = "cust_influencer", lv = 10, weight = 2, group = { 1, 1 }, patience = 45, tip = 1.5, prefer = { "expensive" }, look = "trendy", influencer = true },
	{ id = "cust_critic", lv = 12, weight = 1.5, group = { 1, 1 }, patience = 80, tip = 1.6, prefer = { "mastery" }, look = "suit", reviewWeight = 5 },
	{ id = "cust_vip", lv = 18, weight = 3, group = { 2, 4 }, patience = 150, tip = 2.5, prefer = { "expensive" }, look = "vip", vip = true, ordersEach = 3 },
	{ id = "cust_celebrity", lv = 30, weight = 0.3, group = { 1, 1 }, patience = 90, tip = 5.0, prefer = { "expensive" }, look = "vip", celebrity = true },
}
local byId = {}
for i, c in ipairs(list) do
	c.order = i
	byId[c.id] = c
end
return { list = list, byId = byId }
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000008"><Properties><string name="Name">DailyRewards</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- 7-day login streak. yen scales with level: yen * (1 + level / 10)
return {
	days = {
		{ yen = 500 },
		{ yen = 1000 },
		{ sakura = 3 },
		{ yen = 2500 },
		{ sakura = 5 },
		{ yen = 5000 },
