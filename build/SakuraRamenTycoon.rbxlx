	{ id = "karaage", station = "fryer", ing = { "chicken", "batter" }, steps = { "batter", "fry" }, price = 80, xp = 22, cat = "side", license = "lic_fryer", icon = "🍗", dish = "fried" },
	-- Sushi IV
