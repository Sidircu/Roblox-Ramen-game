	Registry.register("tanuki", function(m, item)
		Kit.finish(m, size(item))
		Kit.blob(m, 1.5, 1.6, 1.3, 0, 0.8, 0, P.wood, M.smooth)
		Kit.blob(m, 1.0, 1.0, 0.4, 0, 0.75, -0.5, P.sand, M.smooth, { collide = false })
		Kit.ball(m, 1.1, 0, 1.95, 0, P.wood, M.smooth)
		Kit.cyl(m, 1.4, 0.12, 0, 2.5, 0, P.bamboo, M.fabric, { collide = false })
		Kit.ball(m, 0.6, 0, 2.6, 0, P.bamboo, M.fabric, { collide = false })
		Kit.blob(m, 0.7, 0.3, 0.2, 0, 1.95, -0.5, P.sand, M.smooth, { collide = false })
		for _, x in ipairs({ -0.2, 0.2 }) do
			Kit.ball(m, 0.15, x, 2.05, -0.5, P.black, M.smooth, { collide = false })
		end
		Kit.cyl(m, 0.4, 0.7, 0.7, 0.9, -0.2, P.porcelain, M.smooth, { collide = false })
	end)
	Registry.register("aquarium", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		Kit.box(m, w, 2, d, 0, 1, 0, P.wood_black, M.wood)
		Kit.box(m, w, h - 2.2, d, 0, 2 + (h - 2.2) / 2, 0, P.glass, M.glass, { transparency = 0.7 })
		Kit.box(m, w - 0.2, h - 2.6, d - 0.2, 0, 2 + (h - 2.6) / 2 + 0.1, 0, P.water, M.glass, { transparency = 0.55, collide = false })
		Kit.box(m, w - 0.2, 0.3, d - 0.2, 0, 2.15, 0, P.sand, M.pebble, { collide = false })
		Kit.box(m, w, 0.2, d, 0, h - 0.1, 0, P.wood_black, M.wood)
		for i = 0, 4 do
			local fish = Kit.blob(m, 0.4, 0.22, 0.12, -1.5 + i * 0.7, 2.8 + (i % 3) * 0.5, -0.2 + (i % 2) * 0.4, (i % 2 == 0) and P.koi_orange or P.neon_yellow, M.smooth, { collide = false })
			fish:SetAttribute("Animate", "fish")
		end
		for i = 0, 3 do
			Kit.cyl(m, 0.1, 1.2, -1.8 + i * 1.2, 2.9, 0.3, P.leaf, M.leafy, { collide = false })
		end
		local lamp = Kit.box(m, w - 0.4, 0.05, 0.4, 0, h - 0.25, 0, P.white, M.neon, { collide = false })
		Kit.light(lamp, "Surface", P.neon_blue, 8, 1, { face = Enum.NormalId.Bottom })
	end)
	Registry.register("samurai_armor", function(m, item)
		Kit.finish(m, size(item))
		local h = item.size[2]
		Kit.box(m, 2.2, 0.5, 1.8, 0, 0.25, 0, P.wood_black, M.wood)
		Kit.box(m, 0.3, 2, 0.3, 0, 1.4, 0.2, P.wood_black, M.wood)
		for i = 0, 3 do
			Kit.box(m, 1.6 - i * 0.05, 0.3, 1.0, 0, 2.2 + i * 0.32, 0, (i % 2 == 0) and P.lacquer or P.black, M.smooth)
		end
		for _, x in ipairs({ -1, 1 }) do
			for i = 0, 2 do
				Kit.box(m, 0.7, 0.25, 0.9, x * 1.05, 3.5 - i * 0.28, 0, (i % 2 == 0) and P.black or P.lacquer, M.smooth, { rot = CFrame.Angles(0, 0, math.rad(x * -15)) })
			end
		end
		for i = 0, 2 do
			Kit.box(m, 1.8, 0.3, 1.1, 0, 1.7 - i * 0.3, 0, (i % 2 == 0) and P.black or P.lacquer, M.smooth, { collide = false })
		end
		Kit.ball(m, 1, 0, h - 1.4, 0, P.black, M.smooth)
		Kit.box(m, 1.6, 0.15, 1.4, 0, h - 1.6, 0, P.black, M.smooth, { collide = false })
		Kit.box(m, 0.7, 0.4, 0.15, 0, h - 1.5, -0.5, P.lacquer_dark, M.smooth, { collide = false })
		for _, x in ipairs({ -1, 1 }) do
			Kit.wedge(m, 0.1, 1, 0.3, CFrame.new(x * 0.35, h - 0.55, -0.35) * CFrame.Angles(0, math.rad(90), math.rad(x * 15)), P.gold, M.foil, { collide = false })
		end
	end)
	Registry.register("dragon_statue", function(m, item)
		Kit.finish(m, size(item))
		local w, h = item.size[1], item.size[2]
		Kit.cyl(m, w - 0.5, 0.8, 0, 0.4, 0, P.stone_dark, M.granite)
		for i = 0, 16 do
			local t = i / 16
			local a = t * math.pi * 3
			local r = 1.6 * (1 - t * 0.5)
			Kit.ball(m, 0.9 - t * 0.35, math.cos(a) * r, 1.1 + t * (h - 2.4), math.sin(a) * r, (i % 2 == 0) and P.matcha or P.leaf_dark, M.smooth, { collide = false })
			if i % 3 == 0 then
				Kit.wedge(m, 0.08, 0.4, 0.3, CFrame.new(math.cos(a) * r, 1.5 + t * (h - 2.4), math.sin(a) * r) * CFrame.Angles(0, -a, 0), P.gold, M.foil, { collide = false })
			end
		end
		local hy = h - 1
		Kit.blob(m, 1.1, 0.8, 1.4, 0, hy, -0.4, P.matcha, M.smooth, { collide = false })
		Kit.blob(m, 0.8, 0.4, 0.6, 0, hy - 0.2, -1.1, P.leaf_dark, M.smooth, { collide = false })
		for _, x in ipairs({ -0.3, 0.3 }) do
			Kit.ball(m, 0.18, x, hy + 0.15, -0.95, P.neon_yellow, M.neon, { collide = false })
			Kit.cyl(m, 0.1, 0.9, x, hy + 0.7, 0, P.gold, M.foil, { collide = false, rot = CFrame.Angles(math.rad(-30), 0, math.rad(x * 30)) })
		end
	end)
	Registry.register("shisa_pair", function(m, item)
		Kit.finish(m, size(item))
		shisa(m, -1.6, P.copper, true)
		shisa(m, 1.6, P.copper, false)
	end)

	-- Garden & water ----------------------------------------------------------------------------
	Registry.register("stone_path", function(m, item)
		Kit.finish(m, size(item))
		Kit.cyl(m, 1.4, 0.18, -0.2, 0.09, -0.15, P.stone, M.slate, { collide = true })
		Kit.cyl(m, 0.8, 0.16, 0.55, 0.08, 0.55, P.stone_light, M.slate)
	end)
	Registry.register("moss_garden", function(m, item)
		Kit.finish(m, size(item))
		local w = item.size[1]
		Kit.box(m, w, 0.3, w, 0, 0.15, 0, P.wood_dark, M.ground or M.sand)
		foliage(m, { { -0.8, 0.4, -0.6, 1.6, 0.5 }, { 0.7, 0.4, 0.5, 1.8, 0.6 }, { 0.6, 0.35, -1, 1, 0.4 } }, P.moss)
		Kit.blob(m, 0.9, 0.7, 0.8, -0.6, 0.55, 0.9, P.stone_dark, M.rock)
		Kit.blob(m, 0.6, 0.5, 0.6, 1.2, 0.5, -0.2, P.stone, M.rock)
	end)
	Registry.register("shishi_odoshi", function(m, item)
		Kit.finish(m, size(item))
		Kit.cyl(m, 1.4, 0.8, 0.8, 0.4, 0, P.stone, M.granite)
		Kit.cyl(m, 1.1, 0.05, 0.8, 0.78, 0, P.water, M.glass, { collide = false, transparency = 0.2 })
		Kit.cyl(m, 0.18, 2.2, -1.3, 1.1, 0, P.bamboo_green, M.wood)
		Kit.cylH(m, 0.14, 1.2, -0.8, 2.1, 0, P.bamboo_green, M.wood, { collide = false })
		for _, z in ipairs({ -0.35, 0.35 }) do
			Kit.box(m, 0.12, 1.4, 0.12, 0.2, 0.7, z, P.bamboo, M.wood)
		end
		local arm = Kit.cylH(m, 0.28, 1.8, 0.4, 1.5, 0, P.bamboo_green, M.wood, { collide = false, name = "Arm" })
		arm:SetAttribute("Animate", "shishi")
		local drip = Kit.box(m, 0.1, 0.1, 0.1, -0.2, 2.0, 0, P.white, M.smooth, { transparency = 1, collide = false })
		Kit.particles(drip, "water", { rate = 4 })
	end)
	Registry.register("zen_garden", function(m, item)
		Kit.finish(m, size(item))
		local w = item.size[1]
		for _, s in ipairs({ { 0, -w / 2 + 0.15, w, 0.3 }, { 0, w / 2 - 0.15, w, 0.3 }, { -w / 2 + 0.15, 0, 0.3, w }, { w / 2 - 0.15, 0, 0.3, w } }) do
			Kit.box(m, s[3], 0.6, s[4], s[1], 0.3, s[2], P.wood_dark, M.wood)
		end
		Kit.box(m, w - 0.6, 0.4, w - 0.6, 0, 0.2, 0, P.sand, M.sand)
		for i = 0, 6 do
			Kit.box(m, w - 0.8, 0.02, 0.08, 0, 0.41, -w / 2 + 0.8 + i * (w - 1.6) / 6, P.stone_light, M.sand, { collide = false })
		end
		Kit.blob(m, 1.2, 0.8, 1, -1, 0.6, -0.8, P.stone_dark, M.rock)
		Kit.blob(m, 0.8, 0.6, 0.7, 1.2, 0.55, 0.9, P.stone, M.rock)
		Kit.blob(m, 0.5, 0.4, 0.5, 0.6, 0.5, -1.4, P.stone, M.rock)
	end)
	Registry.register("koi_pond", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		for i = 0, 13 do
			local a = i / 14 * math.pi * 2
			Kit.blob(m, 1.3, 0.8, 1, math.cos(a) * (w / 2 - 0.6), 0.4, math.sin(a) * (d / 2 - 0.6), (i % 2 == 0) and P.stone or P.stone_dark, M.rock)
		end
		Kit.box(m, w - 1.4, 0.1, d - 1.4, 0, 0.1, 0, P.stone_dark, M.pebble, { collide = false })
		Kit.box(m, w - 1.2, 0.1, d - 1.2, 0, 0.55, 0, P.water, M.glass, { collide = false, transparency = 0.35 })
		for i = 0, 3 do
			local koi = Kit.blob(m, 0.7, 0.18, 0.28, -1.5 + i, 0.45, -0.6 + (i % 2) * 1.1, (i % 2 == 0) and P.koi_orange or P.white, M.smooth, { collide = false })
			koi:SetAttribute("Animate", "koi")
		end
		for i = 0, 2 do
			Kit.cyl(m, 0.8, 0.03, 1.2 - i * 0.9, 0.62, 1 - i * 0.6, P.leaf, M.leafy, { collide = false })
		end
	end)
	Registry.register("red_bridge", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		local n = 8
		for i = 0, n - 1 do
			local t = (i + 0.5) / n
			local y = math.sin(t * math.pi) * (h - 1.2)
			local z = -d / 2 + d * t
			Kit.box(m, w, 0.25, d / n + 0.05, 0, y + 0.12, z, P.wood_light, M.planks)
			for _, x in ipairs({ -w / 2 + 0.1, w / 2 - 0.1 }) do
				Kit.box(m, 0.15, 1, 0.15, x, y + 0.6, z, P.lacquer, M.smooth, { collide = false })
			end
		end
		for _, x in ipairs({ -w / 2 + 0.1, w / 2 - 0.1 }) do
			for i = 0, n - 2 do
				local t1, t2 = (i + 0.5) / n, (i + 1.5) / n
				local y1 = math.sin(t1 * math.pi) * (h - 1.2) + 1.1
				local y2 = math.sin(t2 * math.pi) * (h - 1.2) + 1.1
				local z1, z2 = -d / 2 + d * t1, -d / 2 + d * t2
				local mid = Vector3.new(x, (y1 + y2) / 2, (z1 + z2) / 2)
				local len = math.sqrt((z2 - z1) ^ 2 + (y2 - y1) ^ 2)
				Kit.part(m, Vector3.new(0.18, 0.15, len), CFrame.lookAt(mid, Vector3.new(x, y2, z2)), P.lacquer, M.smooth, { collide = false })
			end
		end
	end)
	Registry.register("torii_small", function(m, item)
		torii(m, item, P.vermilion, P.black)
	end)
	Registry.register("torii_gold", function(m, item)
		torii(m, item, P.gold, P.black)
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("BasePart") and d.Color == P.gold then
				d.Material = M.foil
			end
		end
	end)
	Registry.register("waterfall", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		for i, b in ipairs({ { -1.8, 1.5, 0.8, 2.6, 3, 2 }, { 1.8, 1.8, 0.6, 2.4, 3.6, 2.2 }, { 0, h - 1.6, 1, 3.6, 3, 2 }, { -1.5, 4, 1, 2, 3, 1.8 }, { 1.6, 4.4, 1, 2, 3, 1.8 } }) do
			Kit.blob(m, b[4], b[5], b[6], b[1], b[2], b[3], (i % 2 == 0) and P.stone_dark or P.stone, M.rock)
		end
		local fall = Kit.box(m, 1.4, h - 2, 0.2, 0, (h - 2) / 2 + 1, 0, P.water, M.glass, { collide = false, transparency = 0.3 })
		Kit.particles(fall, "water", { rate = 25 })
		Kit.box(m, w - 0.6, 0.6, 2, 0, 0.3, -d / 2 + 1, P.water, M.glass, { collide = false, transparency = 0.35 })
		local mist = Kit.box(m, 1.6, 0.2, 1, 0, 0.8, -0.6, P.white, M.smooth, { transparency = 1, collide = false })
		Kit.particles(mist, "smoke", { rate = 5 })
	end)

	-- Festival -------------------------------------------------------------------------------------
	Registry.register("nobori", function(m, item)
		Kit.finish(m, size(item))
		local h = item.size[2]
		Kit.cyl(m, 0.8, 0.3, 0, 0.15, 0, P.charcoal, M.concrete)
		Kit.cyl(m, 0.12, h - 0.3, -0.5, h / 2, 0, P.metal, M.metal)
		Kit.cylH(m, 0.08, 1.1, 0.05, h - 0.4, 0, P.metal, M.metal, { collide = false })
		local banner = Kit.box(m, 1.0, h - 2, 0.04, 0.05, h - 0.4 - (h - 2) / 2, 0, P.lacquer, M.fabric, { collide = false })
		banner:SetAttribute("Animate", "sway")
		Kit.text(banner, Enum.NormalId.Front, "ラ\nー\nメ\nン", { color = "#FFFFFF", font = JP_FONT, pps = 30 })
		Kit.text(banner, Enum.NormalId.Back, "ラ\nー\nメ\nン", { color = "#FFFFFF", font = JP_FONT, pps = 30 })
	end)
	Registry.register("vending_machine", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		Kit.box(m, w, h, d, 0, h / 2, 0, P.lacquer, M.smooth)
		local glass = Kit.box(m, w - 0.5, h * 0.5, 0.05, -0.1, h * 0.65, -d / 2 - 0.02, P.white, M.neon, { collide = false })
		glass.Transparency = 0.3
		for r = 0, 2 do
			for c = 0, 4 do
				Kit.cyl(m, 0.3, 0.6, -w / 2 + 0.5 + c * 0.42, h * 0.45 + r * 0.95, -d / 2 + 0.15, ({ P.neon_blue, P.neon_yellow, P.matcha, P.white, P.koi_orange })[c + 1], M.smooth, { collide = false })
			end
		end
		Kit.box(m, w - 0.8, 0.5, 0.2, -0.1, 0.6, -d / 2 - 0.05, P.black, M.smooth, { collide = false })
		Kit.light(glass, "Surface", P.white, 8, 1, { face = Enum.NormalId.Front })
	end)
	Registry.register("gashapon", function(m, item)
		Kit.finish(m, size(item))
		local h = item.size[2]
		Kit.box(m, 1.6, h * 0.45, 1.4, 0, h * 0.225, 0, P.neon_pink, M.smooth)
		Kit.box(m, 0.4, 0.4, 0.1, 0, h * 0.3, -0.72, P.white, M.smooth, { collide = false })
		Kit.ball(m, 1.6, 0, h * 0.45 + 0.75, 0, P.glass, M.glass, { transparency = 0.6 })
		for i = 0, 9 do
			Kit.ball(m, 0.4, -0.4 + (i % 4) * 0.27, h * 0.45 + 0.3 + math.floor(i / 4) * 0.35, -0.2 + (i % 3) * 0.2, ({ P.neon_red, P.neon_blue, P.neon_yellow, P.matcha })[i % 4 + 1], M.smooth, { collide = false })
		end
		Kit.box(m, 1.7, 0.2, 1.5, 0, h - 0.1, 0, P.neon_pink, M.smooth)
	end)
	Registry.register("koinobori", function(m, item)
		Kit.finish(m, size(item))
		local h = item.size[2]
		Kit.cyl(m, 0.25, h, 0, h / 2, 0, P.wood_light, M.wood)
		Kit.ball(m, 0.4, 0, h, 0, P.gold, M.metal)
		for i, c in ipairs({ P.black, P.lacquer, P.navy }) do
			local fish = Kit.blob(m, 2.6 - i * 0.3, 0.7, 0.5, 1.5, h - 1 - i * 1.2, 0, c, M.fabric, { collide = false })
			fish:SetAttribute("Animate", "streamer")
			Kit.ball(m, 0.25, 0.5, h - 0.9 - i * 1.2, -0.2, P.white, M.smooth, { collide = false })
		end
	end)
	Registry.register("taiko", function(m, item)
		Kit.finish(m, size(item))
		local w, h = item.size[1], item.size[2]
		for _, x in ipairs({ -1, 1 }) do
			Kit.box(m, 0.25, h - 0.5, 0.25, x, (h - 0.5) / 2, 0.5, P.wood_black, M.wood)
			Kit.box(m, 0.25, h - 0.5, 0.25, x, (h - 0.5) / 2, -0.5, P.wood_black, M.wood)
		end
		Kit.cylH(m, 2.3, 1.6, 0, h - 1.3, 0, P.lacquer_dark, M.wood, nil, "z")
		Kit.cylH(m, 2.1, 1.7, 0, h - 1.3, 0, P.paper, M.leather, { collide = false }, "z")
		Kit.cylH(m, 2.35, 0.1, 0, h - 1.3, -0.75, P.gold, M.metal, { collide = false }, "z")
		Kit.cylH(m, 2.35, 0.1, 0, h - 1.3, 0.75, P.gold, M.metal, { collide = false }, "z")
		Kit.cyl(m, 0.12, 1.2, 0.8, h - 0.4, -0.9, P.wood_light, M.wood, { collide = false, rot = CFrame.Angles(0, 0, math.rad(40)) })
		Kit.cyl(m, 0.12, 1.2, -0.8, h - 0.4, -0.9, P.wood_light, M.wood, { collide = false, rot = CFrame.Angles(0, 0, math.rad(-40)) })
	end)
	Registry.register("yatai", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		Kit.box(m, w - 1, 2.6, d - 1.4, 0, 1.6, 0.2, P.wood, M.planks)
		Kit.box(m, w - 0.6, 0.2, d - 0.8, 0, 3, 0, P.wood_light, M.wood)
		for _, x in ipairs({ -w / 2 + 0.8, w / 2 - 0.8 }) do
			Kit.cylH(m, 1.4, 0.3, x, 0.7, -d / 2 + 0.9, P.wood_dark, M.wood, nil, "z")
			Kit.box(m, 0.2, h - 3, 0.2, x, 3 + (h - 3) / 2, -d / 2 + 0.6, P.wood_dark, M.wood)
			Kit.box(m, 0.2, h - 3, 0.2, x, 3 + (h - 3) / 2, d / 2 - 0.6, P.wood_dark, M.wood)
		end
		Kit.box(m, w, 0.3, d, 0, h - 0.15, 0, P.wood_black, M.wood)
		local cloth = Kit.box(m, w - 0.4, 1.2, 0.05, 0, h - 0.9, -d / 2 + 0.5, P.lacquer, M.fabric, { collide = false })
		cloth:SetAttribute("Animate", "sway")
		Kit.text(cloth, Enum.NormalId.Front, "おでん・ラーメン", { color = "#FFFFFF", font = JP_FONT, pps = 30 })
		for _, x in ipairs({ -w / 2 + 0.5, w / 2 - 0.5 }) do
			local l = Kit.blob(m, 0.6, 0.9, 0.6, x, h - 1.3, -d / 2 + 0.35, P.lacquer, M.smooth, { collide = false })
			Kit.light(l, "Point", P.lamp_warm, 10, 1)
			l:SetAttribute("Animate", "sway")
		end
		Kit.cyl(m, 1, 0.8, -0.8, 3.5, 0.2, P.metal, M.metal, { collide = false })
	end)

	-- Seasonal ---------------------------------------------------------------------------------------
	Registry.register("hanami_dango", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		Kit.box(m, w, 2.4, d, 0, 1.2, 0, P.wood_light, M.wood)
		local cloth = Kit.box(m, w + 0.1, 0.6, d + 0.1, 0, 2.2, 0, P.sakura, M.fabric, { collide = false })
		local _ = cloth
		for i = 0, 4 do
			local x = -1 + i * 0.5
			Kit.cyl(m, 0.05, 1.2, x, 3, -0.4, P.wood_light, M.wood, { collide = false })
			for k, c in ipairs({ P.sakura, P.white, P.matcha }) do
				Kit.ball(m, 0.3, x, 2.75 + k * 0.28, -0.4, c, M.smooth, { collide = false })
			end
		end
		Kit.cylH(m, 0.1, w, 0, h - 0.4, 0.8, P.wood_dark, M.wood, { collide = false })
		local sign = Kit.box(m, 1.6, 0.8, 0.05, 0, h - 0.9, 0.8, P.paper, M.smooth, { collide = false })
		Kit.text(sign, Enum.NormalId.Front, "団子", { color = "#B3262E", font = JP_FONT })
	end)
	Registry.register("sakura_garland", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		for i = 0, 11 do
			local x = -w / 2 + 0.3 + i * (w - 0.6) / 11
			local y = h - 0.3 - 0.4 * math.sin(math.pi * i / 11)
			Kit.ball(m, 0.4, x, y, d / 2 - 0.2, (i % 2 == 0) and P.sakura or P.white, M.fabric, { collide = false })
		end
	end)
	Registry.register("tanabata_bamboo", function(m, item)
		Kit.finish(m, size(item))
		local h = item.size[2]
		Kit.cyl(m, 1.2, 0.8, 0, 0.4, 0, P.wood_dark, M.wood)
		Kit.cyl(m, 0.25, h - 0.5, 0, h / 2, 0, P.bamboo_green, M.wood)
		for i = 0, 9 do
			local y = 2.5 + i * 0.5
			local a = math.rad(i * 70)
			Kit.part(m, Vector3.new(0.25, 0.7, 0.03), CFrame.new(math.cos(a) * 0.6, y, math.sin(a) * 0.6) * CFrame.Angles(0, a, 0), ({ P.neon_yellow, P.neon_pink, P.neon_blue, P.matcha, P.lacquer })[i % 5 + 1], M.fabric, { collide = false })
			Kit.box(m, 1.2, 0.04, 0.2, math.cos(a) * 0.5, y + 0.3, math.sin(a) * 0.5, P.leaf, M.leafy, { collide = false, rot = CFrame.Angles(0, a, math.rad(-20)) })
		end
	end)
	Registry.register("moon_rabbit", function(m, item)
		Kit.finish(m, size(item))
		Kit.blob(m, 1.1, 0.9, 1, 0, 0.45, 0.1, P.white, M.smooth)
		Kit.ball(m, 0.7, 0, 1.05, -0.2, P.white, M.smooth, { collide = false })
		for _, x in ipairs({ -0.15, 0.15 }) do
			Kit.blob(m, 0.15, 0.7, 0.1, x, 1.6, -0.15, P.white, M.smooth, { collide = false })
			Kit.ball(m, 0.08, x, 1.1, -0.53, P.lacquer, M.smooth, { collide = false })
		end
		for i = 0, 2 do
			Kit.ball(m, 0.25, 0.45 + i * 0.05, 0.12 + i * 0.2, -0.4, P.paper, M.smooth, { collide = false })
		end
	end)
	Registry.register("susuki_vase", function(m, item)
		Kit.finish(m, size(item))
		Kit.cyl(m, 0.6, 0.8, 0, 0.4, 0, P.stone_dark, M.smooth)
		for i = 0, 4 do
			local a = math.rad(-30 + i * 15)
			Kit.part(m, Vector3.new(0.05, 1.4, 0.05), CFrame.new(0, 0.8, 0) * CFrame.Angles(0, 0, a) * CFrame.new(0, 0.7, 0), P.bamboo, M.wood, { collide = false })
			Kit.blob(m, 0.12, 0.4, 0.12, math.sin(-a) * 1.3, 0.8 + math.cos(a) * 1.3, 0, P.sand, M.fabric, { collide = false })
		end
	end)
	Registry.register("kadomatsu", function(m, item)
		Kit.finish(m, size(item))
		local h = item.size[2]
		Kit.cyl(m, 1.6, 1.2, 0, 0.6, 0, P.bamboo, M.fabric)
		for i, hh in ipairs({ h - 0.2, h - 0.9, h - 1.4 }) do
			local a = math.rad(i * 120)
			local x, z = math.cos(a) * 0.3, math.sin(a) * 0.3
			Kit.cyl(m, 0.3, hh - 1, x, 1 + (hh - 1) / 2, z, P.bamboo_green, M.wood)
			Kit.wedge(m, 0.3, 0.5, 0.3, CFrame.new(x, hh + 0.2, z) * CFrame.Angles(0, a, 0), P.bamboo_green, M.wood, { collide = false })
		end
		foliage(m, { { 0, 1.4, 0.6, 1.2, 0.5 }, { -0.5, 1.5, -0.3, 0.9, 0.5 } }, P.leaf_dark)
	end)
	Registry.register("kagami_mochi", function(m, item)
		Kit.finish(m, size(item))
		Kit.box(m, 0.9, 0.3, 0.9, 0, 0.15, 0, P.wood_light, M.wood)
		Kit.blob(m, 0.85, 0.4, 0.85, 0, 0.5, 0, P.white, M.smooth)
		Kit.blob(m, 0.65, 0.32, 0.65, 0, 0.82, 0, P.white, M.smooth, { collide = false })
		Kit.ball(m, 0.35, 0, 1.12, 0, P.koi_orange, M.smooth, { collide = false })
	end)
	Registry.register("osaka_octopus_sign", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		local z = d / 2 - 0.3
		Kit.box(m, w, h * 0.35, 0.2, 0, h * 0.18, d / 2 - 0.1, P.neon_yellow, M.smooth)
		local label = Kit.box(m, w - 0.4, h * 0.3, 0.05, 0, h * 0.18, d / 2 - 0.22, P.neon_yellow, M.smooth, { collide = false })
		Kit.text(label, Enum.NormalId.Front, "たこ焼き", { color = "#B3262E", font = JP_FONT })
		Kit.blob(m, 2.4, 2, 0.6, 0, h * 0.6, z, P.neon_red, M.smooth, { collide = false })
		for _, x in ipairs({ -0.4, 0.4 }) do
			Kit.ball(m, 0.5, x, h * 0.65, z - 0.3, P.white, M.smooth, { collide = false })
			Kit.ball(m, 0.22, x, h * 0.65, z - 0.5, P.black, M.smooth, { collide = false })
		end
		for i = 0, 5 do
			local a = math.rad(-75 + i * 30)
			local tentacle = Kit.part(m, Vector3.new(0.35, 1.5, 0.3), CFrame.new(0, h * 0.42, z) * CFrame.Angles(0, 0, a) * CFrame.new(0, -0.9, 0), P.neon_red, M.smooth, { collide = false })
			tentacle:SetAttribute("Animate", "sway")
		end
	end)
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000039"><Properties><string name="Name">Food</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Food visuals: dishes (per recipe), ingredients, supplier boxes, dirty dishes, cooking tools.
local Kit = require(script.Parent.Parent.Kit)
local P = require(script.Parent.Parent.Palette)
local Color = require(script.Parent.Parent.Parent.Util.Color)
local Recipes = require(script.Parent.Parent.Parent.Config.Recipes)
local Ingredients = require(script.Parent.Parent.Parent.Config.Ingredients)
local M = P.M

local NC = { collide = false, shadow = false }
local function nc()
	return { collide = false, shadow = false }
end

local BROTH = {
	broth_shoyu = "#7A4A22",
	broth_shio = "#E9D9A8",
	broth_miso = "#C58A3E",
	broth_tonkotsu = "#F1E4C8",
}

local function ingColor(id)
	local ing = Ingredients.byId[id]
	return ing and Color.hex(ing.color) or P.white
end

local function fishSlice(m, x, y, z, color, len, yaw)
	local cf = CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(yaw or 0), 0)
	Kit.part(m, Vector3.new(len or 0.55, 0.08, 0.3), cf, color, M.smooth, nc())
	for k = -1, 1, 2 do
		Kit.part(m, Vector3.new(0.03, 0.085, 0.28), cf * CFrame.new(k * 0.12, 0.005, 0), Color3.new(1, 1, 1):Lerp(color, 0.4), M.smooth, nc())
	end
end

local function nigiri(m, x, z, fish, yaw)
	Kit.blob(m, 0.5, 0.24, 0.3, x, 0.27, z, P.rice, M.sand, nc())
	fishSlice(m, x, 0.42, z, fish, 0.6, yaw)
end

local function makiPiece(m, x, z, inner, outerColor, d)
	d = d or 0.34
	Kit.cyl(m, d, 0.3, x, 0.3, z, outerColor or P.nori, M.smooth, nc())
	Kit.cyl(m, d - 0.06, 0.31, x, 0.3, z, P.rice, M.sand, nc())
	Kit.cyl(m, d * 0.38, 0.32, x, 0.3, z, inner, M.smooth, nc())
end

local function plate(m, w, d, color, mat)
	Kit.box(m, w, 0.12, d, 0, 0.06, 0, color or P.wood_light, mat or M.wood, nc())
	Kit.box(m, 0.12, 0.06, d - 0.1, -w / 2 + 0.15, -0.0, 0, color or P.wood_light, mat or M.wood, nc())
	Kit.box(m, 0.12, 0.06, d - 0.1, w / 2 - 0.15, -0.0, 0, color or P.wood_light, mat or M.wood, nc())
end

local function roundPlate(m, d, color)
	Kit.cyl(m, d, 0.08, 0, 0.06, 0, color or P.porcelain, M.smooth, nc())
	Kit.cyl(m, d - 0.25, 0.09, 0, 0.065, 0, Color3.new(1, 1, 1):Lerp(color or P.porcelain, 0.9), M.smooth, nc())
end

local function bowl(m, d, h, outer, inner)
	Kit.cyl(m, d * 0.55, 0.1, 0, 0.05, 0, outer, M.smooth, nc())
	Kit.cyl(m, d * 0.8, h * 0.5, 0, 0.1 + h * 0.25, 0, outer, M.smooth, nc())
	Kit.cyl(m, d, h * 0.5, 0, 0.1 + h * 0.7, 0, outer, M.smooth, nc())
	Kit.cyl(m, d + 0.04, 0.05, 0, 0.1 + h * 0.95, 0, inner or P.lacquer, M.smooth, nc())
	return 0.1 + h * 0.9
end

local function toppings(m, list, y, r)
	local angle = 0
	for _, id in ipairs(list) do
		angle += 1.4
		local x, z = math.cos(angle) * r, math.sin(angle) * r
		if id == "naruto" then
			Kit.cyl(m, 0.32, 0.05, x, y + 0.03, z, P.white, M.smooth, nc())
			Kit.cyl(m, 0.18, 0.055, x, y + 0.035, z, P.sakura_dark, M.smooth, nc())
		elseif id == "egg" then
			Kit.blob(m, 0.38, 0.16, 0.28, x, y + 0.06, z, P.white, M.smooth, nc())
			Kit.blob(m, 0.2, 0.17, 0.16, x, y + 0.08, z, P.koi_orange, M.smooth, nc())
		elseif id == "chashu" then
			Kit.cyl(m, 0.5, 0.07, x, y + 0.04, z, Color.hex("#C9845A"), M.smooth, nc())
			Kit.cyl(m, 0.42, 0.075, x, y + 0.045, z, Color.hex("#E8B49A"), M.smooth, nc())
		elseif id == "scallion" then
			for k = 0, 5 do
				Kit.cyl(m, 0.06, 0.04, x + (k % 3) * 0.08 - 0.08, y + 0.03, z + math.floor(k / 3) * 0.08, P.leaf_light, M.smooth, nc())
			end
		elseif id == "corn" then
			for k = 0, 5 do
				Kit.ball(m, 0.08, x + (k % 3) * 0.07 - 0.07, y + 0.04, z + math.floor(k / 3) * 0.07, P.neon_yellow, M.smooth, nc())
			end
		elseif id == "butter" then
			Kit.box(m, 0.18, 0.1, 0.18, x, y + 0.06, z, Color.hex("#F7E39A"), M.smooth, nc())
		elseif id == "kikurage" then
			Kit.box(m, 0.35, 0.03, 0.08, x, y + 0.03, z, P.ink, M.smooth, nc())
			Kit.box(m, 0.3, 0.03, 0.08, x + 0.05, y + 0.035, z + 0.1, P.ink, M.smooth, nc())
		elseif id == "minced_pork" then
			Kit.blob(m, 0.35, 0.1, 0.35, x, y + 0.04, z, Color.hex("#8A4A3A"), M.sand, nc())
		elseif id == "chili_oil" then
			Kit.cyl(m, 0.5, 0.02, x * 0.3, y + 0.012, z * 0.3, P.red, M.glass, { collide = false, shadow = false, transparency = 0.3 })
		elseif id == "black_garlic" then
			Kit.cyl(m, 0.4, 0.02, x * 0.3, y + 0.013, z * 0.3, P.black, M.glass, { collide = false, shadow = false, transparency = 0.2 })
		elseif id == "matcha" then
			Kit.cyl(m, 0.3, 0.02, x, y + 0.012, z, P.matcha, M.smooth, nc())
		elseif id == "tofu" then
			Kit.box(m, 0.15, 0.15, 0.15, x, y + 0.05, z, P.white, M.smooth, nc())
		end
	end
end

local function noodles(m, y, r, color)
	for k = 0, 6 do
		local a = k * 0.9
		Kit.part(m, Vector3.new(r * 1.4, 0.05, 0.06), CFrame.new(math.cos(a) * r * 0.2, y + 0.02, math.sin(a) * r * 0.2) * CFrame.Angles(0, a, 0), color or Color.hex("#F2D27A"), M.smooth, nc())
	end
end

local function ramenBowl(m, recipe)
	local top = bowl(m, 1.35, 0.6, P.lacquer_dark, P.lacquer)
	local broth = Kit.cyl(m, 1.22, 0.05, 0, top, 0, Color.hex(BROTH[recipe.broth] or "#C58A3E"), M.glass, { collide = false, shadow = false, transparency = 0.05 })
	local _ = broth
	noodles(m, top, 0.5)
	local tops = {}
	for _, id in ipairs(recipe.ing) do
		if id ~= "noodles" and id ~= "tsukemen_noodles" then
			table.insert(tops, id)
		end
	end
	toppings(m, tops, top, 0.32)
	Kit.box(m, 0.4, 0.45, 0.03, -0.35, top + 0.15, 0.4, P.nori, M.smooth, { collide = false, shadow = false, rot = CFrame.Angles(math.rad(-20), 0, 0) })
	-- chopsticks and spoon
	Kit.box(m, 1.5, 0.05, 0.05, 0.1, 0.07, -0.85, P.wood_light, M.wood, nc())
	Kit.box(m, 1.5, 0.05, 0.05, 0.1, 0.07, -0.95, P.wood_light, M.wood, nc())
	local steam = Kit.box(m, 0.6, 0.05, 0.6, 0, top + 0.2, 0, P.white, M.smooth, { collide = false, shadow = false, transparency = 1 })
	Kit.particles(steam, "steam", { rate = 3 })
end

local function dish(recipeId, gold)
	local recipe = Recipes.byId[recipeId]
	local m = Kit.model("Dish")
	if gold then
		Kit.cyl(m, 1.75, 0.04, 0, 0.01, 0, P.gold, M.foil, nc())
		local shine = Kit.box(m, 0.3, 0.05, 0.3, 0, 0.6, 0, P.gold, M.smooth, { collide = false, shadow = false, transparency = 1 })
		Kit.particles(shine, "sparkle", { rate = 2, color = "#FFE08A", glow = 0.6 })
	end
	if not recipe then
		roundPlate(m, 1.2)
		Kit.finish(m, Vector3.new(1.3, 0.5, 1.3))
		return m
	end
	local kind = recipe.dish
	local fish = P.koi_orange
	for _, id in ipairs(recipe.ing) do
		local ing = Ingredients.byId[id]
		if ing and ing.storage == "fish" then
			fish = ingColor(id)
			break
		end
	end
	if kind == "nigiri" then
		plate(m, 1.5, 0.8)
		nigiri(m, -0.32, 0, fish, 10)
		nigiri(m, 0.32, 0, fish, -10)
		Kit.blob(m, 0.2, 0.1, 0.15, 0.6, 0.15, 0.25, P.leaf_light, M.smooth, nc())
	elseif kind == "maki" then
		plate(m, 1.5, 0.8)
		local inner = ingColor(recipe.ing[2] or "cucumber")
		for i = 0, 5 do
			makiPiece(m, -0.45 + (i % 3) * 0.45, -0.18 + math.floor(i / 3) * 0.36, inner)
		end
	elseif kind == "roll" then
		plate(m, 1.6, 0.8, P.black, M.smooth)
		local topping = ingColor(recipe.ing[2] or "avocado")
		for i = 0, 5 do
			local x = -0.6 + i * 0.24
			makiPiece(m, x, 0, ingColor(recipe.ing[3] or "avocado"), P.rice, 0.4)
			Kit.box(m, 0.22, 0.06, 0.36, x, 0.48, 0, topping, M.smooth, nc())
		end
		if table.find(recipe.ing, "eel_sauce") then
			Kit.box(m, 1.4, 0.02, 0.06, 0, 0.53, 0, Color.hex("#3B2414"), M.smooth, nc())
		end
	elseif kind == "temaki" then
		plate(m, 1.2, 0.8)
		Kit.wedge(m, 0.4, 0.9, 0.6, CFrame.new(0, 0.6, 0) * CFrame.Angles(math.rad(-30), 0, 0), P.nori, M.smooth, nc())
		Kit.blob(m, 0.35, 0.25, 0.35, 0, 0.95, -0.2, P.rice, M.sand, nc())
		Kit.blob(m, 0.25, 0.2, 0.2, 0.08, 1.05, -0.25, fish, M.smooth, nc())
		Kit.blob(m, 0.2, 0.18, 0.18, -0.1, 1.02, -0.22, ingColor("avocado"), M.smooth, nc())
	elseif kind == "gunkan" then
		plate(m, 1.3, 0.8)
		for _, x in ipairs({ -0.3, 0.3 }) do
			Kit.cyl(m, 0.45, 0.3, x, 0.28, 0, P.nori, M.smooth, nc())
			for k = 0, 5 do
				Kit.ball(m, 0.12, x - 0.1 + (k % 3) * 0.1, 0.46, -0.06 + math.floor(k / 3) * 0.12, P.koi_orange, M.glass, nc())
			end
		end
	elseif kind == "sashimi" then
		roundPlate(m, 1.6, P.indigo)
		Kit.blob(m, 0.5, 0.2, 0.5, 0, 0.18, 0.2, P.white, M.fabric, nc())
		local colors = { ingColor("salmon"), ingColor("tuna"), ingColor("yellowtail") }
		for i, c in ipairs(colors) do
			for k = 0, 1 do
				fishSlice(m, -0.45 + (i - 1) * 0.45, 0.17 + k * 0.05, -0.2 + k * 0.1, c, 0.5, 70)
			end
		end
		Kit.box(m, 0.4, 0.02, 0.3, 0.45, 0.13, 0.35, P.leaf, M.leafy, nc())
	elseif kind == "platter" then
		plate(m, 2.0, 1.1, P.lacquer_dark, M.smooth)
		nigiri(m, -0.6, -0.25, ingColor("otoro"), 0)
		nigiri(m, -0.1, -0.25, ingColor("yellowtail"), 0)
		nigiri(m, 0.4, -0.25, ingColor("shrimp"), 0)
		for i = 0, 2 do
			makiPiece(m, -0.5 + i * 0.4, 0.25, ingColor("ikura"))
		end
		Kit.cyl(m, 0.4, 0.25, 0.7, 0.25, 0.25, P.nori, M.smooth, nc())
		Kit.ball(m, 0.25, 0.7, 0.4, 0.25, P.koi_orange, M.glass, nc())
	elseif kind == "bowl" then
		ramenBowl(m, recipe)
	elseif kind == "tsukemen" then
		roundPlate(m, 1.3, P.black)
		noodles(m, 0.15, 0.5, Color.hex("#E8C26A"))
		Kit.blob(m, 0.9, 0.25, 0.7, -0.1, 0.22, 0, Color.hex("#E8C26A"), M.smooth, nc())
		local sub = Kit.model("dip")
		sub.Parent = m
		local top = bowl(sub, 0.7, 0.45, P.charcoal, P.lacquer)
		Kit.cyl(sub, 0.62, 0.04, 0, top, 0, Color.hex(BROTH.broth_tonkotsu), M.smooth, nc())
		for _, d in ipairs(sub:GetDescendants()) do
			if d:IsA("BasePart") then
				d.CFrame = CFrame.new(0.75, 0, 0.3) * d.CFrame
			end
		end
		toppings(m, { "chashu", "egg" }, 0.25, 0.3)
	elseif kind == "soup" then
		local top = bowl(m, 0.9, 0.45, P.lacquer, P.black)
		Kit.cyl(m, 0.82, 0.04, 0, top, 0, Color.hex(recipe.broth and BROTH[recipe.broth] or "#C58A3E"), M.smooth, nc())
		toppings(m, { "tofu", "scallion", "tofu" }, top, 0.2)
	elseif kind == "edamame" then
		roundPlate(m, 1.0, P.porcelain)
		for k = 0, 7 do
			Kit.blob(m, 0.35, 0.1, 0.14, -0.25 + (k % 4) * 0.17, 0.14, -0.15 + math.floor(k / 4) * 0.25, P.leaf_light, M.smooth, { collide = false, shadow = false, rot = CFrame.Angles(0, k, 0) })
		end
	elseif kind == "cup" then
		local liquid = recipeId == "matcha_latte" and Color.hex("#B8D08A") or Color.hex("#9DB85A")
		Kit.cyl(m, 0.5, 0.55, 0, 0.3, 0, recipeId == "matcha_latte" and P.white or P.stone_dark, M.smooth, nc())
		Kit.cyl(m, 0.44, 0.03, 0, 0.56, 0, liquid, M.smooth, nc())
		local steam = Kit.box(m, 0.3, 0.05, 0.3, 0, 0.7, 0, P.white, M.smooth, { collide = false, shadow = false, transparency = 1 })
		Kit.particles(steam, "steam", { rate = 2 })
		Kit.cyl(m, 0.8, 0.05, 0, 0.03, 0, P.wood_dark, M.wood, nc())
	elseif kind == "bottle" then
		Kit.cyl(m, 0.4, 0.8, 0, 0.4, 0, Color.hex("#7FC8E8"), M.glass, { collide = false, shadow = false, transparency = 0.3 })
		Kit.cyl(m, 0.22, 0.3, 0, 0.95, 0, Color.hex("#7FC8E8"), M.glass, { collide = false, shadow = false, transparency = 0.3 })
		Kit.ball(m, 0.15, 0, 0.85, 0, P.white, M.glass, nc())
		Kit.cyl(m, 0.24, 0.06, 0, 1.12, 0, P.neon_blue, M.smooth, nc())
	elseif kind == "gyoza" then
		roundPlate(m, 1.3, P.porcelain)
		for k = 0, 4 do
			Kit.blob(m, 0.42, 0.18, 0.24, -0.4 + k * 0.2, 0.16, 0, Color.hex("#E8C27A"), M.smooth, { collide = false, shadow = false, rot = CFrame.Angles(0, math.rad(80), 0) })
		end
		if table.find(recipe.ing, "chili_oil") then
			Kit.cyl(m, 0.3, 0.05, 0.45, 0.12, 0.35, P.red, M.glass, nc())
		end
	elseif kind == "fried" then
		roundPlate(m, 1.2, P.porcelain)
		Kit.box(m, 0.8, 0.02, 0.8, 0, 0.12, 0, P.paper, M.fabric, { collide = false, shadow = false, rot = CFrame.Angles(0, math.rad(45), 0) })
		for k = 0, 2 do
			Kit.blob(m, recipeId == "ebi_tempura" and 0.6 or 0.3, 0.25, 0.25, -0.2 + k * 0.2, 0.25, -0.1 + k * 0.1, Color.hex("#E0A64A"), M.sand, nc())
		end
		Kit.cyl(m, 0.25, 0.05, 0.4, 0.15, 0.3, P.neon_yellow, M.smooth, { collide = false, shadow = false, rot = CFrame.Angles(math.rad(90), 0, 0) })
	elseif kind == "takoyaki" then
		Kit.box(m, 1.2, 0.15, 0.7, 0, 0.08, 0, P.paper_warm, M.fabric, nc())
		for k = 0, 5 do
			local x, z = -0.36 + (k % 3) * 0.36, -0.15 + math.floor(k / 3) * 0.3
			Kit.ball(m, 0.32, x, 0.3, z, Color.hex("#B5703A"), M.sand, nc())
			Kit.box(m, 0.3, 0.02, 0.05, x, 0.47, z, P.white, M.smooth, nc())
		end
	elseif kind == "mochi" then
		roundPlate(m, 1.0, P.indigo)
		for k, c in ipairs({ P.sakura, P.white, P.matcha }) do
			Kit.blob(m, 0.34, 0.26, 0.34, -0.35 + k * 0.23, 0.2, 0, c, M.smooth, nc())
		end
	elseif kind == "okonomiyaki" then
		roundPlate(m, 1.3, P.porcelain)
		Kit.cyl(m, 1.0, 0.2, 0, 0.2, 0, Color.hex("#C98A4A"), M.sand, nc())
		Kit.cyl(m, 0.9, 0.02, 0, 0.31, 0, Color.hex("#4A2A1A"), M.smooth, nc())
		for k = -1, 1 do
			Kit.box(m, 0.8, 0.02, 0.04, 0, 0.33, k * 0.2, P.white, M.smooth, nc())
		end
	else
		roundPlate(m, 1.2)
	end
	Kit.finish(m, Vector3.new(1.6, 1, 1.2))
	m:SetAttribute("Recipe", recipeId)
	return m
end

local function ingredient(id)
	local ing = Ingredients.byId[id]
	local m = Kit.model("Ing")
	local c = ing and Color.hex(ing.color) or P.white
	local shape = ing and ing.shape or "pack"
	if shape == "fillet" then
		Kit.blob(m, 0.8, 0.25, 0.4, 0, 0.13, 0, c, M.smooth, nc())
		for k = -1, 1 do
			Kit.box(m, 0.03, 0.2, 0.32, k * 0.2, 0.15, 0, Color3.new(1, 1, 1):Lerp(c, 0.5), M.smooth, nc())
		end
	elseif shape == "veg" then
		if id == "avocado" then
			Kit.blob(m, 0.35, 0.45, 0.35, 0, 0.22, 0, Color.hex("#3E5A2A"), M.smooth, nc())
		else
			Kit.cylH(m, 0.2, 0.75, 0, 0.12, 0, c, M.smooth, nc())
		end
	elseif shape == "sack" then
		Kit.blob(m, 0.6, 0.65, 0.45, 0, 0.32, 0, P.paper_warm, M.fabric, nc())
		Kit.box(m, 0.35, 0.1, 0.02, 0, 0.35, -0.22, c, M.smooth, nc())
	elseif shape == "jar" then
		Kit.cyl(m, 0.42, 0.45, 0, 0.23, 0, P.glass, M.glass, { collide = false, shadow = false, transparency = 0.4 })
		Kit.cyl(m, 0.38, 0.32, 0, 0.18, 0, c, M.smooth, nc())
		Kit.cyl(m, 0.44, 0.1, 0, 0.5, 0, P.wood_dark, M.wood, nc())
	elseif shape == "bottle" then
		Kit.cyl(m, 0.25, 0.55, 0, 0.28, 0, c, M.glass, { collide = false, shadow = false, transparency = 0.15 })
		Kit.cyl(m, 0.12, 0.2, 0, 0.65, 0, c, M.glass, nc())
		Kit.cyl(m, 0.14, 0.06, 0, 0.77, 0, P.lacquer, M.smooth, nc())
	elseif shape == "noodle" then
		Kit.box(m, 0.7, 0.2, 0.35, 0, 0.1, 0, c, M.fabric, nc())
		for k = -2, 2 do
			Kit.box(m, 0.7, 0.03, 0.03, 0, 0.21, k * 0.06, Color3.new(1, 1, 1):Lerp(c, 0.8), M.smooth, nc())
		end
		Kit.box(m, 0.1, 0.22, 0.37, 0, 0.11, 0, P.lacquer, M.fabric, nc())
	elseif shape == "egg" then
		Kit.blob(m, 0.28, 0.36, 0.28, -0.12, 0.18, 0, Color.hex("#C9894A"), M.smooth, nc())
		Kit.blob(m, 0.28, 0.36, 0.28, 0.16, 0.18, 0.05, Color.hex("#C9894A"), M.smooth, nc())
	elseif shape == "sheet" then
		for k = 0, 3 do
			Kit.box(m, 0.6, 0.03, 0.6, 0, 0.02 + k * 0.035, 0, c, M.smooth, nc())
		end
	elseif shape == "ball" then
		for k, col in ipairs({ P.sakura, P.white, P.matcha }) do
			Kit.ball(m, 0.25, -0.3 + k * 0.15, 0.13, 0, col, M.smooth, nc())
		end
	elseif shape == "leaf" then
		for k = -1, 1 do
			Kit.cyl(m, 0.08, 0.7, k * 0.08, 0.35, 0, c, M.smooth, { collide = false, shadow = false, rot = CFrame.Angles(0, 0, math.rad(k * 8)) })
		end
		Kit.box(m, 0.25, 0.08, 0.1, 0, 0.12, 0, P.white, M.smooth, nc())
	else
		Kit.box(m, 0.5, 0.35, 0.35, 0, 0.18, 0, c, M.smooth, nc())
		Kit.box(m, 0.52, 0.12, 0.37, 0, 0.2, 0, P.white, M.smooth, nc())
	end
	Kit.finish(m, Vector3.new(0.8, 0.6, 0.6))
	m:SetAttribute("Ingredient", id)
	return m
end

-- Supplier cardboard box with an icon + portions label (language independent)
local function box(id, count)
	local ing = Ingredients.byId[id]
	local m = Kit.model("Box")
	local body = Kit.box(m, 1.8, 1.3, 1.5, 0, 0.65, 0, P.cardboard, M.cardboard, { name = "Body" })
	Kit.box(m, 1.82, 0.12, 0.3, 0, 1.25, 0, Color.hex("#D8C49A"), M.smooth, nc())
	Kit.box(m, 0.3, 0.12, 1.52, 0, 1.25, 0, Color.hex("#D8C49A"), M.smooth, nc())
	local _, label = Kit.text(body, Enum.NormalId.Front, (ing and ing.icon or "📦") .. " " .. tostring(count or (ing and ing.units) or 0), { color = "#2B2320", bg = "#F4EBDD", pps = 40 })
	label.Name = "Count"
	local _, label2 = Kit.text(body, Enum.NormalId.Top, ing and ing.icon or "📦", { color = "#2B2320", pps = 30 })
	local _l = label2
	Kit.finish(m, Vector3.new(1.8, 1.3, 1.5))
	m:SetAttribute("Ingredient", id)
	return m
end

local function dirty(kind)
	local m = Kit.model("Dirty")
	if kind == "bowl" then
		bowl(m, 1.2, 0.55, P.lacquer_dark, P.lacquer)
		Kit.cyl(m, 1.0, 0.03, 0, 0.35, 0, Color.hex("#A8865A"), M.smooth, nc())
	else
		roundPlate(m, 1.2, P.porcelain)
		for k = 0, 3 do
			Kit.ball(m, 0.08, -0.2 + k * 0.13, 0.13, (k % 2) * 0.15, P.rice, M.sand, nc())
		end
	end
	Kit.box(m, 1.2, 0.04, 0.05, 0.1, 0.12, -0.55, P.wood_light, M.wood, nc())
	Kit.finish(m, Vector3.new(1.3, 0.6, 1.3))
	return m
end

local function dishStack(count, kind)
	local m = Kit.model("Stack")
	for k = 0, math.min(count, 5) - 1 do
		if kind == "dirty" then
			Kit.cyl(m, 1.1, 0.1, 0, 0.06 + k * 0.12, 0, Color.hex("#D8D0C0"), M.smooth, nc())
		else
			Kit.cyl(m, 1.1, 0.1, 0, 0.06 + k * 0.12, 0, P.porcelain, M.smooth, nc())
		end
	end
	Kit.finish(m, Vector3.new(1.2, 0.7, 1.2))
	return m
end

local function tool(kind)
	local m = Kit.model("Tool")
	if kind == "knife" then
		Kit.box(m, 1.3, 0.25, 0.03, 0.4, 0, 0, P.metal, M.metal, { collide = false, shadow = false, reflectance = 0.3 })
		Kit.box(m, 0.6, 0.14, 0.1, -0.55, 0, 0, P.wood_dark, M.wood, nc())
	elseif kind == "mat" then
		for k = -4, 4 do
			Kit.cylH(m, 0.06, 1.3, 0, 0, k * 0.1, P.bamboo, M.wood, nc())
		end
	elseif kind == "ladle" then
		Kit.cyl(m, 0.06, 1.4, 0, 0.5, 0, P.metal, M.metal, nc())
		Kit.blob(m, 0.4, 0.2, 0.4, 0, -0.2, 0, P.metal, M.metal, nc())
	elseif kind == "spatula" then
		Kit.box(m, 0.5, 0.03, 0.4, 0.3, 0, 0, P.metal, M.metal, nc())
		Kit.box(m, 0.8, 0.08, 0.08, -0.3, 0.05, 0, P.wood_dark, M.wood, nc())
	else
		Kit.cyl(m, 0.5, 0.4, 0, 0, 0, P.metal, M.metal, { collide = false, shadow = false, transparency = 0.3 })
		Kit.cylH(m, 0.06, 1.0, 0.7, 0.1, 0, P.wood_dark, M.wood, nc())
	end
	local _ = NC
	Kit.finish(m, Vector3.new(1.4, 0.4, 0.6))
	return m
end

return function(Registry)
	Registry.registerFood("dish", dish)
	Registry.registerFood("ingredient", ingredient)
	Registry.registerFood("box", box)
	Registry.registerFood("dirty", dirty)
	Registry.registerFood("stack", dishStack)
	Registry.registerFood("tool", tool)
	Registry.Food.BrothColors = BROTH
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000040"><Properties><string name="Name">Furniture</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Seating, counters, tables, benches and storage racks.
local Kit = require(script.Parent.Parent.Kit)
local P = require(script.Parent.Parent.Palette)
local M = P.M

local function size(item)
	return Vector3.new(item.size[1], item.size[2], item.size[3])
end

-- Attachment on Root at local bottom-relative position (x, y, z) facing `look` (+Z/-Z/...)
local function point(root, name, x, y, z, yaw)
	local h = root.Size.Y
	return Kit.attach(root, name, CFrame.new(x, y - h / 2, z) * CFrame.Angles(0, math.rad(yaw or 0), 0))
end

local function nc()
	return { collide = false, shadow = false }
end

-- Condiment set: soy dispenser, shichimi tin, chopstick box and toothpick holder
local function condiments(m, x, y, z, rotY)
	local base = CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(rotY or 0), 0)
	local function at(dx, dz)
		local p = base * CFrame.new(dx, 0, dz)
		return p.X, p.Z
	end
	local sx, sz = at(-0.45, 0)
	Kit.cyl(m, 0.24, 0.42, sx, y + 0.21, sz, P.glass, M.glass, { collide = false, shadow = false, transparency = 0.25 })
	Kit.cyl(m, 0.2, 0.26, sx, y + 0.14, sz, P.wood_black, M.smooth, nc())
	Kit.cyl(m, 0.26, 0.1, sx, y + 0.47, sz, P.lacquer, M.smooth, nc())
	local tx, tz = at(-0.12, 0.05)
	Kit.cyl(m, 0.2, 0.3, tx, y + 0.15, tz, P.vermilion, M.metal, nc())
	Kit.cyl(m, 0.21, 0.05, tx, y + 0.32, tz, P.gold, M.metal, nc())
	local bx, bz = at(0.35, 0)
	Kit.box(m, 0.6, 0.28, 0.3, bx, y + 0.14, bz, P.wood_black, M.wood, { collide = false, shadow = false, rot = CFrame.Angles(0, math.rad(rotY or 0), 0) })
	Kit.box(m, 0.56, 0.04, 0.26, bx, y + 0.29, bz, P.lacquer_dark, M.smooth, { collide = false, shadow = false, rot = CFrame.Angles(0, math.rad(rotY or 0), 0) })
	local px, pz = at(0.8, 0.02)
	Kit.cyl(m, 0.16, 0.24, px, y + 0.12, pz, P.bamboo, M.wood, nc())
	Kit.cyl(m, 0.1, 0.12, px, y + 0.3, pz, P.hinoki, M.wood, nc())
end

local function stool(m, item, seatColor, seatMat, legColor, swivel)
	local root = Kit.finish(m, size(item))
	local h = item.size[2]
	if swivel then
		Kit.cyl(m, 1.5, 0.12, 0, 0.06, 0, P.steel_dark, M.metal)
		Kit.cyl(m, 0.28, h - 0.5, 0, (h - 0.5) / 2 + 0.1, 0, P.metal, M.metal, { reflectance = 0.2 })
		Kit.cyl(m, 1.2, 0.08, 0, 0.9, 0, P.metal, M.metal, { collide = false })
		Kit.cyl(m, 1.6, 0.35, 0, h - 0.2, 0, seatColor, seatMat)
		Kit.cyl(Kit.detail(m, "furnish"), 1.66, 0.06, 0, h - 0.38, 0, P.gold, M.metal, { collide = false })
	else
		for _, c in ipairs({ { -0.5, -0.5 }, { 0.5, -0.5 }, { 0.5, 0.5 }, { -0.5, 0.5 } }) do
			Kit.box(m, 0.18, h - 0.3, 0.18, c[1], (h - 0.3) / 2, c[2], legColor, M.wood, { rot = CFrame.Angles(c[2] * 0.08, 0, -c[1] * 0.08) })
		end
		for _, r in ipairs({ { 0, -0.48, 1, 0.1 }, { 0, 0.48, 1, 0.1 }, { -0.48, 0, 0.1, 1 }, { 0.48, 0, 0.1, 1 } }) do
			Kit.box(m, r[3], 0.1, r[4], r[1], 0.8, r[2], legColor, M.wood, { collide = false })
		end
		Kit.cyl(m, 1.55, 0.28, 0, h - 0.16, 0, P.wood_light, M.wood)
		local df = Kit.detail(m, "furnish")
		Kit.cyl(df, 1.6, 0.06, 0, h - 0.29, 0, P.wood_dark, M.wood, nc())
		if seatMat == M.fabric then
			Kit.cyl(m, 1.45, 0.2, 0, h + 0.02, 0, seatColor, M.fabric, { collide = false })
			Kit.cyl(df, 1.47, 0.04, 0, h - 0.07, 0, P.gold, M.fabric, nc())
			Kit.ball(df, 0.14, 0, h + 0.13, 0, P.gold, M.fabric, nc())
		else
			-- wood grain rings on the bare seat
			Kit.cyl(df, 1.0, 0.02, 0, h, 0, P.wood, M.wood, nc())
			Kit.cyl(df, 0.5, 0.025, 0, h + 0.005, 0, P.wood_light, M.wood, nc())
		end
	end
	point(root, "SitPoint", 0, h, 0, 0)
end

-- Plain counter: cabinet, wooden top, chef ledge, kick plate and foot rail.
-- Detail_counter (renovation "hinoki counter"): slats, brass hooks and brackets, light strip,
-- hinoki top and edge band, plate niche. Detail_tableware: condiments on the ledge.
local function counter(m, item, kind)
	local root = Kit.finish(m, size(item))
	local w, h, d = item.size[1], item.size[2], item.size[3]
	local dc = Kit.detail(m, "counter")
	-- cabinet (customer side faces -Z)
	Kit.box(m, w, h - 0.25, d - 0.6, 0, (h - 0.25) / 2, 0.3, P.wood_dark, M.wood)
	-- kick plate and foot rail
	Kit.box(m, w, 0.35, 0.1, 0, 0.175, -d / 2 + 0.62, P.black, M.smooth, nc())
	Kit.cylH(m, 0.12, w, 0, 0.7, -d / 2 + 0.25, P.steel, M.metal, { collide = false, reflectance = 0.1 })
	-- top with front overhang and the raised chef ledge (tsukedai) on the kitchen side
	Kit.box(m, w, 0.22, d, 0, h - 0.11, 0, P.wood_light, M.wood)
	Kit.box(m, w, 0.35, 0.5, 0, h + 0.15, d / 2 - 0.25, P.wood, M.wood, nc())
	if kind == "corner" then
		Kit.box(m, 0.5, 0.35, d - 0.5, w / 2 - 0.25, h + 0.15, -0.25, P.wood, M.wood, nc())
	elseif kind == "end" then
		Kit.box(m, 0.15, h - 0.4, d - 0.4, w / 2 - 0.075, (h - 0.4) / 2 + 0.1, 0, P.wood_black, M.wood, nc())
	end

	-- renovated look: vertical slats on the customer side with dark rails above and below
	local n = math.max(2, math.floor(w / 0.5))
	for i = 0, n - 1 do
		local x = -w / 2 + 0.25 + (w - 0.5) * i / math.max(1, n - 1)
		Kit.box(dc, 0.12, h - 0.75, 0.08, x, (h - 0.25) / 2 + 0.1, -d / 2 + 0.58, P.wood, M.wood, nc())
	end
	Kit.box(dc, w, 0.12, 0.12, 0, h - 0.5, -d / 2 + 0.56, P.wood_black, M.wood, nc())
	Kit.box(dc, w, 0.12, 0.12, 0, 0.42, -d / 2 + 0.56, P.wood_black, M.wood, nc())
	-- brass bag hooks under the overhang, brass foot rail sleeve and brackets
	for x = -w / 2 + 0.7, w / 2 - 0.4, 1.4 do
		Kit.box(dc, 0.08, 0.2, 0.08, x, h - 0.7, -d / 2 + 0.5, P.brass, M.metal, nc())
		Kit.box(dc, 0.08, 0.06, 0.2, x, h - 0.82, -d / 2 + 0.42, P.brass, M.metal, nc())
	end
	Kit.cylH(dc, 0.13, w, 0, 0.7, -d / 2 + 0.25, P.brass, M.metal, { collide = false, shadow = false, reflectance = 0.15 })
	for x = -w / 2 + 0.5, w / 2 - 0.3, 2 do
		Kit.box(dc, 0.08, 0.08, 0.36, x, 0.7, -d / 2 + 0.43, P.brass, M.metal, nc())
	end
	-- warm light strip hidden under the overhang
	Kit.box(dc, w - 0.1, 0.05, 0.08, 0, h - 0.27, -d / 2 + 0.66, P.lamp_warm, M.neon, nc())
	-- hinoki top with a dark edge band, hinoki cap on the ledge
	Kit.box(dc, w, 0.04, d, 0, h + 0.005, 0, P.hinoki, M.wood, nc())
	Kit.box(dc, w, 0.1, 0.06, 0, h - 0.17, -d / 2 - 0.02, P.wood_dark, M.wood, nc())
	Kit.box(dc, w, 0.06, 0.56, 0, h + 0.35, d / 2 - 0.25, P.hinoki, M.wood, nc())
	-- kitchen side: open niche with stacked plates and bowls
	Kit.box(dc, w - 0.4, 1.2, 0.08, 0, h - 1.05, d / 2 + 0.01, P.wood_black, M.wood, nc())
	Kit.box(dc, w - 0.4, 0.06, 0.4, 0, h - 1.05, d / 2 - 0.2, P.wood, M.wood, nc())
	for x = -w / 2 + 0.6, w / 2 - 0.5, 1 do
		for k = 0, 2 do
			Kit.cyl(dc, 0.6, 0.07, x, h - 0.98 + k * 0.08, d / 2 - 0.2, k == 2 and P.indigo or P.porcelain, M.smooth, nc())
		end
	end
	if kind == "corner" then
		Kit.box(dc, 0.56, 0.06, d - 0.5, w / 2 - 0.25, h + 0.35, -0.25, P.hinoki, M.wood, nc())
	elseif kind == "end" then
		Kit.box(dc, 0.2, 0.12, d, w / 2 - 0.1, h - 0.06, 0, P.wood_black, M.wood, nc())
	end
	-- condiments on the ledge (one set per straight/corner segment)
	if kind ~= "end" then
		condiments(Kit.detail(m, "tableware"), kind == "corner" and -0.3 or 0, h + 0.38, d / 2 - 0.25, 0)
	end
	root:SetAttribute("TopY", h)
end

local function tableTop(m, item, topColor, legColor, low)
	local root = Kit.finish(m, size(item))
	local w, h, d = item.size[1], item.size[2], item.size[3]
	if low then
		-- round chabudai with an inlaid rim and four folding legs
		local r = math.min(w, d) - 0.2
		Kit.cyl(m, r, 0.2, 0, h - 0.1, 0, topColor, M.wood)
		local df = Kit.detail(m, "furnish")
		Kit.cyl(df, r - 0.3, 0.04, 0, h + 0.005, 0, Color3.new(1, 1, 1):Lerp(topColor, 0.85), M.wood, nc())
		Kit.cyl(df, r + 0.04, 0.06, 0, h - 0.18, 0, P.wood_black, M.wood, nc())
		for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }) do
			Kit.box(m, 0.3, h - 0.2, 0.3, c[1] * r * 0.3, (h - 0.2) / 2, c[2] * r * 0.3, legColor, M.wood)
		end
		Kit.box(m, r * 0.7, 0.1, 0.2, 0, h - 0.27, 0, legColor, M.wood, nc())
		Kit.box(m, 0.2, 0.1, r * 0.7, 0, h - 0.27, 0, legColor, M.wood, nc())
		-- tea set: kyusu teapot and cups on a small tray
		local dt = Kit.detail(m, "tableware")
		Kit.cyl(dt, 1.1, 0.05, 0.6, h + 0.03, -0.5, P.bamboo, M.wood, nc())
		Kit.blob(dt, 0.45, 0.4, 0.45, 0.45, h + 0.25, -0.5, P.matcha, M.smooth, nc())
		Kit.cylH(dt, 0.08, 0.3, 0.75, h + 0.3, -0.5, P.matcha, M.smooth, nc())
		Kit.cyl(dt, 0.12, 0.06, 0.45, h + 0.47, -0.5, P.wood_dark, M.smooth, nc())
		for _, cx in ipairs({ 0.85, 1.0 }) do
			Kit.cyl(dt, 0.2, 0.2, cx, h + 0.15, -0.25, P.porcelain, M.smooth, nc())
		end
	else
		Kit.box(m, w, 0.2, d, 0, h - 0.1, 0, topColor, M.wood)
		local df = Kit.detail(m, "furnish")
		Kit.box(df, w - 0.1, 0.06, d - 0.1, 0, h + 0.005, 0, Color3.new(1, 1, 1):Lerp(topColor, 0.85), M.wood, nc())
		Kit.box(df, w + 0.04, 0.08, d + 0.04, 0, h - 0.18, 0, legColor, M.wood, nc())
		Kit.box(m, 0.4, h - 0.5, 0.4, 0, (h - 0.5) / 2 + 0.2, 0, legColor, M.wood)
		Kit.box(m, math.min(w, 2.2), 0.2, 0.4, 0, 0.1, 0, legColor, M.wood)
		Kit.box(m, 0.4, 0.2, math.min(d, 2.2), 0, 0.1, 0, legColor, M.wood)
		Kit.box(m, w - 0.6, 0.15, 0.3, 0, h - 0.28, 0, legColor, M.wood, nc())
		-- brass caps on the cross feet
		for _, c in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
			Kit.box(df, 0.44, 0.22, 0.44, c[1] * (math.min(w, 2.2) / 2 - 0.2), 0.11, c[2] * (math.min(d, 2.2) / 2 - 0.2), P.brass, M.metal, nc())
		end
		-- condiments along the back edge and a folded menu card
		local dt = Kit.detail(m, "tableware")
		condiments(dt, 0, h, d / 2 - 0.3, 0)
		Kit.wedge(dt, 0.5, 0.4, 0.3, CFrame.new(-w / 2 + 0.45, h + 0.2, d / 2 - 0.3), P.paper_warm, M.smooth, nc())
		Kit.box(dt, 0.42, 0.12, 0.02, -w / 2 + 0.45, h + 0.21, d / 2 - 0.32, P.lacquer, M.smooth, { collide = false, shadow = false, rot = CFrame.Angles(math.rad(37), 0, 0) })
	end
	root:SetAttribute("TopY", h)
end
local function chair(m, item, color, mat)
	local root = Kit.finish(m, size(item))
	local seatH = item.fn.height
	for _, c in ipairs({ { -0.6, -0.6 }, { 0.6, -0.6 }, { 0.6, 0.6 }, { -0.6, 0.6 } }) do
		Kit.box(m, 0.18, seatH - 0.12, 0.18, c[1], (seatH - 0.12) / 2, c[2], color, mat)
	end
	Kit.box(m, 1.5, 0.15, 1.5, 0, seatH - 0.06, 0, color, mat)
	Kit.box(Kit.detail(m, "furnish"), 1.4, 0.08, 1.4, 0, seatH + 0.02, 0, P.paper_warm, M.fabric, { collide = false })
	-- backrest on +Z (the sitter faces -Z)
	Kit.box(m, 0.16, 1.6, 0.16, -0.6, seatH + 0.8, 0.66, color, mat)
	Kit.box(m, 0.16, 1.6, 0.16, 0.6, seatH + 0.8, 0.66, color, mat)
	Kit.box(m, 1.36, 0.3, 0.1, 0, seatH + 1.45, 0.66, color, mat)
	Kit.box(m, 1.2, 0.12, 0.08, 0, seatH + 0.9, 0.66, color, mat)
	point(root, "SitPoint", 0, seatH, 0, 0)
end

local function cushion(m, root, x, z, color, h)
	Kit.box(m, 1.7, h, 1.7, x, h / 2, z, color, M.fabric)
	Kit.box(m, 1.5, 0.04, 1.5, x, h + 0.01, z, Color3.new(1, 1, 1):Lerp(color, 0.7), M.fabric, { collide = false })
	for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }) do
		Kit.ball(Kit.detail(m, "furnish"), 0.16, x + c[1] * 0.85, h / 2, z + c[2] * 0.85, P.gold, M.fabric, { collide = false })
	end
end

return function(Registry)
	Registry.register("stool_wood", function(m, item)
		stool(m, item, P.wood_light, M.wood, P.wood)
	end)
	Registry.register("stool_cushion", function(m, item)
		stool(m, item, P.lacquer, M.fabric, P.wood_dark)
	end)
	Registry.register("stool_swivel", function(m, item)
		stool(m, item, P.lacquer, M.leather, P.steel, true)
	end)
	Registry.register("counter_straight", function(m, item)
		counter(m, item, "straight")
	end)
	Registry.register("counter_corner", function(m, item)
		counter(m, item, "corner")
	end)
	Registry.register("counter_end", function(m, item)
		counter(m, item, "end")
	end)
	Registry.register("table_2", function(m, item)
		tableTop(m, item, P.wood_light, P.wood_dark)
	end)
	Registry.register("table_4", function(m, item)
		tableTop(m, item, P.wood_light, P.wood_dark)
	end)
	Registry.register("chabudai", function(m, item)
		tableTop(m, item, P.wood_dark, P.wood_black, true)
	end)
	Registry.register("chair_wood", function(m, item)
		chair(m, item, P.wood, M.wood)
	end)
	Registry.register("chair_lacquer", function(m, item)
		chair(m, item, P.lacquer, M.smooth)
	end)
	Registry.register("zabuton", function(m, item)
		local root = Kit.finish(m, size(item))
		cushion(m, root, 0, 0, P.indigo, 0.35)
		point(root, "SitPoint", 0, 0.4, 0, 0)
	end)
	Registry.register("booth", function(m, item)
		local root = Kit.finish(m, size(item))
		local w, h = item.size[1], item.size[2]
		-- two benches facing each other along Z
		for side = -1, 1, 2 do
			local z = side * 1.85
			Kit.box(m, w, 1.6, 1.3, 0, 0.8, z, P.wood_dark, M.wood)
			Kit.box(m, w - 0.2, 0.3, 1.2, 0, 1.75, z, P.lacquer_dark, M.leather)
			Kit.box(m, w, h - 1.6, 0.3, 0, 1.6 + (h - 1.6) / 2, z + side * 0.5, P.wood_dark, M.wood)
			Kit.box(m, w - 0.3, h - 2.2, 0.15, 0, 1.9 + (h - 2.2) / 2, z + side * 0.33, P.lacquer_dark, M.leather, { collide = false })
		end
		Kit.box(m, w - 1.2, 0.2, 2, 0, 2.6, 0, P.wood_light, M.wood)
		Kit.box(m, 0.4, 2.4, 0.4, 0, 1.3, 0, P.wood_black, M.wood)
		local df = Kit.detail(m, "furnish")
		Kit.box(df, w - 1.25, 0.08, 2.05, 0, 2.48, 0, P.wood_dark, M.wood, nc())
		Kit.box(df, 1.6, 0.15, 0.8, 0, 0.08, 0, P.wood_black, M.wood, nc())
		condiments(Kit.detail(m, "tableware"), 0, 2.7, 0, 90)
		-- kumiko lattice panels on top of both backrests and dark cap rails
		for side = -1, 1, 2 do
			local z = side * 1.85 + side * 0.5
			Kit.box(df, w, 0.12, 0.36, 0, h + 0.06, z, P.wood_black, M.wood, nc())
			Kit.box(df, w - 0.2, 0.7, 0.06, 0, h + 0.47, z, P.paper, M.smooth, { collide = false, shadow = false, transparency = 0.1 })
			for x = -w / 2 + 0.1, w / 2 - 0.05, 0.45 do
				Kit.box(df, 0.05, 0.7, 0.1, x, h + 0.47, z, P.wood_dark, M.wood, nc())
			end
			for _, y in ipairs({ h + 0.3, h + 0.6 }) do
				Kit.box(df, w - 0.2, 0.05, 0.1, 0, y, z, P.wood_dark, M.wood, nc())
			end
			Kit.box(df, w, 0.1, 0.2, 0, h + 0.86, z, P.wood_black, M.wood, nc())
		end
		local i = 0
		for side = -1, 1, 2 do
			for _, x in ipairs({ -1.2, 1.2 }) do
				i += 1
				point(root, "Seat" .. i, x, 1.9, side * 1.85, side < 0 and 180 or 0)
				point(root, "Dish" .. i, x, 2.7, side * 0.55, 0)
			end
		end
		root:SetAttribute("TopY", 2.7)
	end)
	Registry.register("zashiki_table", function(m, item)
		local root = Kit.finish(m, size(item))
		Kit.box(m, 4, 0.2, 2.4, 0, 1.2, 0, P.wood_black, M.wood)
		Kit.box(m, 3.9, 0.04, 2.3, 0, 1.31, 0, P.lacquer_dark, M.smooth, { collide = false })
		Kit.box(Kit.detail(m, "furnish"), 4.06, 0.08, 2.46, 0, 1.08, 0, P.gold, M.metal, nc())
		-- sake set: tokkuri flask and choko cups on a lacquer tray, plus a small ikebana
		local dt = Kit.detail(m, "tableware")
		Kit.box(dt, 0.9, 0.06, 0.5, 0, 1.36, 0, P.lacquer, M.smooth, nc())
		Kit.blob(dt, 0.28, 0.42, 0.28, -0.2, 1.58, 0, P.porcelain, M.smooth, nc())
		Kit.cyl(dt, 0.12, 0.16, -0.2, 1.85, 0, P.porcelain, M.smooth, nc())
		Kit.cyl(dt, 0.14, 0.1, 0.12, 1.44, -0.08, P.indigo, M.smooth, nc())
		Kit.cyl(dt, 0.14, 0.1, 0.3, 1.44, 0.08, P.indigo, M.smooth, nc())
		Kit.cyl(dt, 0.3, 0.3, 1.5, 1.48, 0, P.wood_black, M.smooth, nc())
		Kit.box(dt, 0.04, 0.6, 0.04, 1.5, 1.85, 0, P.leaf_dark, M.wood, nc())
		Kit.ball(dt, 0.2, 1.5, 2.15, 0, P.maple, M.smooth, nc())
		Kit.ball(dt, 0.14, 1.6, 1.98, 0.06, P.sakura, M.smooth, nc())
		for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }) do
			Kit.box(m, 0.3, 1.1, 0.3, c[1] * 1.7, 0.55, c[2] * 0.95, P.wood_black, M.wood)
		end
		local i = 0
		for side = -1, 1, 2 do
			for _, x in ipairs({ -1.1, 1.1 }) do
				i += 1
				cushion(m, root, x, side * 2.2, P.lacquer, 0.3)
				point(root, "Seat" .. i, x, 0.35, side * 2.2, side < 0 and 180 or 0)
				point(root, "Dish" .. i, x, 1.32, side * 0.6, 0)
			end
		end
		root:SetAttribute("TopY", 1.32)
	end)
	Registry.register("waiting_bench", function(m, item)
		local root = Kit.finish(m, size(item))
		local w = item.size[1]
		Kit.box(m, w, 0.2, 1.2, 0, 1.5, 0, P.wood_light, M.wood)
		for _, x in ipairs({ -w / 2 + 0.4, w / 2 - 0.4 }) do
			Kit.box(m, 0.25, 1.4, 1, x, 0.7, 0, P.wood_dark, M.wood)
		end
		Kit.box(m, w, 0.5, 0.15, 0, 2.2 - 0.25, 0.6, P.wood_light, M.wood, { collide = false })
		for _, x in ipairs({ -w / 2 + 0.4, w / 2 - 0.4 }) do
			Kit.box(m, 0.15, 0.7, 0.15, x, 1.95, 0.6, P.wood_dark, M.wood, nc())
		end
		-- red felt runner (mosen) like a tea house bench
		local df = Kit.detail(m, "furnish")
		Kit.box(df, w - 0.6, 0.04, 1.1, 0, 1.62, 0, P.lacquer, M.fabric, nc())
		Kit.box(df, w - 0.6, 0.6, 0.04, 0, 1.33, -0.56, P.lacquer, M.fabric, nc())
		Kit.box(df, 0.6, 0.18, 0.5, w / 2 - 0.7, 1.73, 0.15, P.indigo, M.fabric, nc())
		for i, x in ipairs({ -1.6, 0, 1.6 }) do
			point(root, "Queue" .. i, x, 1.6, 0, 0)
		end
	end)
	-- storage racks: box slots BoxN on Root
	local function rack(m, item)
		local root = Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		local rows, cols = item.fn.rows, item.fn.cols
		for _, x in ipairs({ -w / 2 + 0.1, w / 2 - 0.1 }) do
			for _, z in ipairs({ -d / 2 + 0.1, d / 2 - 0.1 }) do
				Kit.box(m, 0.15, h, 0.15, x, h / 2, z, P.steel_dark, M.metal)
			end
		end
		local slot = 0
		for r = 0, rows - 1 do
			local y = 0.15 + r * 2.0
			Kit.box(m, w - 0.1, 0.12, d - 0.1, 0, y, 0, P.wood, M.planks)
			for c = 0, cols - 1 do
				slot += 1
				local x = -w / 2 + w / cols * (c + 0.5)
				point(root, "Box" .. slot, x, y + 0.06, 0, 0)
			end
		end
		Kit.box(m, w - 0.1, 0.12, d - 0.1, 0, h - 0.06, 0, P.steel_dark, M.metal, { collide = false })
	end
	Registry.register("storage_rack", rack)
	Registry.register("storage_rack_large", rack)
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000041"><Properties><string name="Name">Kitchen</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Kitchen equipment: shelves, neta case, rice cookers, broth pots, stations, sink, dishwasher, fridge.
-- Functional points (on Root): SlotN parts (shelves), Board/Plate/Tool attachments (stations).
local Kit = require(script.Parent.Parent.Kit)
local P = require(script.Parent.Parent.Palette)
local M = P.M

local function size(item)
	return Vector3.new(item.size[1], item.size[2], item.size[3])
end

local function point(root, name, x, y, z, yaw)
	local h = root.Size.Y
	return Kit.attach(root, name, CFrame.new(x, y - h / 2, z) * CFrame.Angles(0, math.rad(yaw or 0), 0))
end

-- Invisible clickable slot volume
local function slot(m, index, sx, sy, sz, x, y, z)
	local p = Kit.box(m, sx, sy, sz, x, y, z, P.white, M.smooth, { transparency = 1, collide = false, shadow = false, name = "Slot" .. index })
	p.CanQuery = true
	p:SetAttribute("Slot", index)
	return p
end

local NC = { collide = false, shadow = false }
local function nc()
	return { collide = false, shadow = false }
end
local JP_FONT = Font.new("rbxasset://fonts/families/FredokaOne.json", Enum.FontWeight.Bold)

-- Steel (or wooden) work cabinet: recessed kick plate, framed doors with bar handles,
-- thick top with a front lip. The cook side is -Z.
local function cabinet(m, w, h, d, top, body, wood)
	local bodyColor = body or P.metal
	local mat = wood and M.wood or M.metal
	Kit.box(m, w - 0.24, 0.35, d - 0.3, 0, 0.175, 0.05, P.charcoal, M.smooth)
	Kit.box(m, w, h - 0.55, d, 0, 0.35 + (h - 0.55) / 2, 0, bodyColor, mat)
	Kit.box(m, w + 0.08, 0.2, d + 0.1, 0, h - 0.1, 0.02, top or P.metal, wood and M.wood or M.metal, { reflectance = wood and 0 or 0.12 })
	Kit.box(m, w + 0.08, 0.08, 0.1, 0, h + 0.02, -d / 2 - 0.02, top or P.metal, M.metal, nc())
	local doors = math.max(1, math.floor(w / 1.6))
	local dw = w / doors
	for i = 0, doors - 1 do
		local x = -w / 2 + dw * (i + 0.5)
		local doorH = h - 1.1
		local cy = 0.4 + doorH / 2
		Kit.box(m, dw - 0.18, doorH, 0.05, x, cy, -d / 2 - 0.025, wood and P.wood or P.steel, mat, nc())
		Kit.box(m, dw - 0.42, doorH - 0.3, 0.03, x, cy, -d / 2 - 0.06, wood and P.wood_light or P.metal, mat, nc())
		local hx = x + (i % 2 == 0 and (dw / 2 - 0.35) or -(dw / 2 - 0.35))
		Kit.box(m, 0.07, 0.9, 0.07, hx, cy + 0.3, -d / 2 - 0.13, P.steel_dark, M.metal, nc())
	end
end

-- Small wooden name plate with kanji on the cook side of a station
local function plate(m, x, y, z, text)
	local p = Kit.box(m, 1.0, 0.45, 0.06, x, y, z, P.hinoki, M.wood, nc())
	Kit.text(p, Enum.NormalId.Front, text, { color = "#2B2320", font = JP_FONT, pps = 40 })
	return p
end

local function knobs(m, n, x0, y, z)
	for i = 0, n - 1 do
		Kit.cylH(m, 0.22, 0.12, x0 + i * 0.4, y, z, P.charcoal, M.smooth, nc(), "z")
		Kit.box(m, 0.04, 0.12, 0.04, x0 + i * 0.4, y + 0.05, z - 0.07, P.neon_red, M.smooth, nc())
	end
end

-- Extraction hood with a duct to the ceiling (over hot stations)
local function hood(m, w, h, d)
	-- high and shallow so it never hides the board from the game camera
	local y = h + 5.2
	local hd = 1.5
	local hz = d / 2 - hd / 2
	Kit.box(m, w - 0.8, 0.7, hd, 0, y, hz, P.metal, M.metal, { collide = false, reflectance = 0.15 })
	Kit.wedge(m, w - 0.8, 0.5, hd, CFrame.new(0, y + 0.6, hz) * CFrame.Angles(0, math.rad(180), 0), P.metal, M.metal, nc())
	Kit.box(m, w - 0.9, 0.06, hd - 0.1, 0, y - 0.36, hz, P.steel_dark, M.metal, nc())
	Kit.box(m, 0.8, 13.9 - (y + 0.85), 0.8, 0, (y + 0.85 + 13.9) / 2, d / 2 - 0.45, P.metal, M.metal, nc())
	local light = Kit.box(m, w - 1.6, 0.05, 0.3, 0, y - 0.38, hz - 0.4, P.lamp, M.neon, nc())
	Kit.light(light, "Surface", P.lamp, 8, 0.8, { face = Enum.NormalId.Bottom, night = false })
end

-- Backsplash with a narrow shelf (back = +Z)
local function backsplash(m, w, h, d, tiles)
	Kit.box(m, w, 1.0, 0.1, 0, h + 0.5, d / 2 - 0.05, tiles and P.white or P.metal, tiles and M.tiles or M.metal, nc())
	Kit.box(m, w, 0.08, 0.35, 0, h + 1.04, d / 2 - 0.2, P.metal, M.metal, nc())
end

-- Utensil rail with hanging tools
local function utensilRail(m, w, h, d, tools)
	local y = h + 1.6
	local z = d / 2 - 0.15
	Kit.cylH(m, 0.06, w - 0.6, 0, y, z, P.metal, M.metal, nc())
	local n = #tools
	for i, t in ipairs(tools) do
		local x = -w / 2 + 0.6 + (w - 1.2) * (i - 0.5) / n
		Kit.cyl(m, 0.04, 0.9, x, y - 0.45, z, P.metal, M.metal, nc())
		if t == "ladle" then
			Kit.blob(m, 0.35, 0.18, 0.35, x, y - 0.95, z - 0.05, P.metal, M.metal, nc())
		elseif t == "strainer" then
			Kit.cyl(m, 0.42, 0.06, x, y - 0.95, z - 0.1, P.steel, M.metal, { collide = false, shadow = false, rot = CFrame.Angles(math.rad(80), 0, 0) })
		elseif t == "spatula" then
			Kit.box(m, 0.35, 0.3, 0.03, x, y - 0.95, z - 0.03, P.metal, M.metal, nc())
		elseif t == "towel" then
			Kit.box(m, 0.5, 0.8, 0.04, x, y - 0.4, z - 0.05, P.white, M.fabric, nc())
			Kit.box(m, 0.5, 0.1, 0.045, x, y - 0.55, z - 0.05, P.indigo, M.fabric, nc())
		end
	end
end

local function bowlStack(m, x, z, y0, n, color)
	for i = 0, n - 1 do
		Kit.cyl(m, 0.7, 0.14, x, y0 + 0.07 + i * 0.15, z, color, M.smooth, nc())
		Kit.cyl(m, 0.72, 0.03, x, y0 + 0.14 + i * 0.15, z, P.lacquer, M.smooth, nc())
	end
end

local function pan(m, x, z, y0, color)
	Kit.box(m, 0.42, 0.14, 0.42, x, y0 + 0.07, z, P.metal, M.metal, nc())
	Kit.box(m, 0.36, 0.05, 0.36, x, y0 + 0.13, z, color, M.smooth, nc())
end

local function shelfUnit(m, item)
	local root = Kit.finish(m, size(item))
	local w, h, d = item.size[1], item.size[2], item.size[3]
	local slots = item.fn.slots
	local cols = slots > 4 and 2 or 1
	local rows = math.ceil(slots / cols)
	-- frame: dark posts on black feet, light hinoki back boards
	Kit.box(m, w, h, 0.12, 0, h / 2, d / 2 - 0.06, P.wood_dark, M.planks)
	local dk = Kit.detail(m, "kitchen")
	Kit.box(dk, w - 0.4, h - 0.3, 0.03, 0, h / 2, d / 2 - 0.135, P.hinoki, M.planks, nc())
	for _, x in ipairs({ -w / 2 + 0.1, w / 2 - 0.1 }) do
		Kit.box(m, 0.2, h, d, x, h / 2, 0, P.wood_dark, M.wood)
		Kit.box(dk, 0.28, 0.12, d + 0.08, x, 0.06, 0, P.wood_black, M.wood, nc())
		for _, y in ipairs({ 0.55, h - 0.55 }) do
			Kit.box(dk, 0.24, 0.3, 0.03, x, y, -d / 2 - 0.015, P.charcoal, M.metal, nc())
			Kit.ball(dk, 0.07, x, y, -d / 2 - 0.04, P.brass, M.metal, nc())
		end
	end
	if cols == 2 then
		Kit.box(m, 0.14, h, d, 0, h / 2, 0, P.wood_dark, M.wood)
	end
	local rowH = (h - 0.3) / rows
	local idx = 0
	for r = 0, rows - 1 do
		local y = 0.15 + r * rowH
		Kit.box(m, w - 0.2, 0.12, d, 0, y, 0, P.wood_light, M.wood)
		Kit.box(dk, w - 0.3, 0.16, 0.05, 0, y + 0.02, -d / 2 - 0.02, P.wood_dark, M.wood, nc())
		for c = 0, cols - 1 do
			idx += 1
			if idx <= slots then
				local cw = (w - 0.3) / cols
				local x = -w / 2 + 0.15 + cw * (c + 0.5)
				local s = slot(m, idx, cw - 0.1, rowH - 0.2, d - 0.1, x, y + 0.06 + (rowH - 0.2) / 2, 0)
				s:SetAttribute("Width", cw - 0.2)
				-- paper price tag on the shelf lip
				Kit.box(dk, 0.55, 0.13, 0.02, x, y + 0.02, -d / 2 - 0.055, P.paper, M.smooth, nc())
				Kit.box(dk, 0.12, 0.13, 0.025, x - 0.2, y + 0.02, -d / 2 - 0.058, P.lacquer, M.smooth, nc())
			end
		end
	end
	-- crown with a kanji header board ("ingredients")
	Kit.box(m, w + 0.2, 0.18, d + 0.15, 0, h - 0.06, -0.02, P.wood_black, M.wood)
	Kit.box(dk, w + 0.3, 0.06, d + 0.25, 0, h + 0.06, -0.02, P.wood_dark, M.wood, nc())
	local sign = Kit.box(dk, math.min(2.2, w - 0.8), 0.6, 0.08, 0, h + 0.4, -d / 2 + 0.2, P.hinoki, M.wood, nc())
	Kit.text(sign, Enum.NormalId.Front, "食材", { color = "#2B2320", font = JP_FONT, pps = 40 })
	Kit.box(dk, math.min(2.2, w - 0.8) + 0.12, 0.08, 0.1, 0, h + 0.74, -d / 2 + 0.2, P.wood_dark, M.wood, nc())
end

local function riceCooker(m, item, pro)
	local root = Kit.finish(m, size(item))
	local w, h = item.size[1], item.size[2]
	local standH = h - 1.4
	-- wooden stand with a drawer and kanji label
	Kit.box(m, w, standH, w, 0, standH / 2, 0, P.wood_dark, M.wood)
	local dk = Kit.detail(m, "kitchen")
	Kit.box(dk, w + 0.1, 0.1, w + 0.1, 0, standH - 0.05, 0, P.wood_black, M.wood, nc())
	Kit.box(dk, w - 0.3, standH - 0.45, 0.04, 0, standH / 2 + 0.05, -w / 2 - 0.02, P.wood, M.wood, nc())
	Kit.box(dk, 0.4, 0.06, 0.06, 0, standH - 0.35, -w / 2 - 0.06, P.brass, M.metal, nc())
	local label = Kit.box(dk, 0.8, 0.34, 0.03, 0, standH / 2 - 0.1, -w / 2 - 0.05, P.paper, M.smooth, nc())
	Kit.text(label, Enum.NormalId.Front, "炊飯", { color = "#2B2320", font = JP_FONT, pps = 40 })
	-- cooker body with side handles, lid, steam vent and control panel
	local r = w - 0.35
	local body = Kit.cyl(m, r, 1.0, 0, standH + 0.5, 0, pro and P.metal or P.white, pro and M.metal or M.smooth, { name = "Body", reflectance = pro and 0.12 or 0 })
	Kit.cyl(m, r + 0.04, 0.08, 0, standH + 0.12, 0, P.charcoal, M.smooth, nc())
	Kit.cyl(dk, r + 0.04, 0.05, 0, standH + 0.98, 0, pro and P.steel or P.sakura_dark, M.smooth, nc())
	for _, sx in ipairs({ -1, 1 }) do
		Kit.box(dk, 0.12, 0.1, 0.5, sx * (r / 2 + 0.04), standH + 0.85, 0, P.charcoal, M.smooth, nc())
	end
	Kit.blob(m, r - 0.05, 0.35, r - 0.05, 0, standH + 1.05, 0, pro and P.steel or P.porcelain, M.smooth, nc())
	Kit.box(m, 0.5, 0.12, 0.1, 0, standH + 1.25, -0.25, P.charcoal, M.smooth, nc())
	Kit.cyl(m, 0.16, 0.08, 0, standH + 1.24, 0.15, P.steel_dark, M.metal, nc())
	local panel = Kit.box(m, 0.6, 0.3, 0.06, 0, standH + 0.55, -r / 2 - 0.02, P.charcoal, M.smooth, nc())
	Kit.box(m, 0.42, 0.08, 0.03, -0.05, standH + 0.6, -r / 2 - 0.06, P.neon_blue, M.neon, nc())
	local led = Kit.box(m, 0.12, 0.12, 0.04, 0.15, standH + 0.48, -r / 2 - 0.06, P.neon_red, M.neon, { collide = false, name = "Led" })
	local _ = panel
	local _2 = led
	-- rice paddle (shamoji) in its holder
	Kit.cyl(dk, 0.16, 0.4, r / 2 + 0.12, standH + 0.55, -0.2, P.white, M.smooth, nc())
	Kit.box(dk, 0.08, 0.6, 0.04, r / 2 + 0.12, standH + 0.8, -0.2, P.hinoki, M.wood, nc())
	Kit.blob(dk, 0.24, 0.3, 0.06, r / 2 + 0.12, standH + 1.15, -0.2, P.hinoki, M.wood, nc())
	local vent = Kit.box(m, 0.2, 0.1, 0.2, 0, standH + 1.3, 0.15, P.white, M.smooth, { transparency = 1, collide = false, name = "Steam" })
	Kit.particles(vent, "steam", { enabled = false })
	local _3 = body
	point(root, "Content", 0, standH + 1.1, 0)
end

local function brothPot(m, item, large)
	local root = Kit.finish(m, size(item))
	local w, h = item.size[1], item.size[2]
	local stoveH = 1.5
	cabinet(m, w, stoveH, w, P.steel_dark, P.steel)
	local dk = Kit.detail(m, "kitchen")
	plate(dk, w / 2 - 0.75, stoveH - 0.45, -w / 2 - 0.12, "出汁")
	knobs(m, 2, -w / 2 + 0.45, stoveH - 0.45, -w / 2 - 0.08)
	-- burner ring and cast iron grate
	Kit.cyl(m, w * 0.6, 0.06, 0, stoveH + 0.03, 0, P.neon_blue, M.neon, { collide = false, name = "Flame" })
	Kit.cyl(m, w * 0.35, 0.08, 0, stoveH + 0.05, 0, P.charcoal, M.metal, nc())
	for i = 0, 3 do
		Kit.box(m, w * 0.85, 0.08, 0.1, 0, stoveH + 0.1, 0, P.charcoal, M.metal, { collide = false, shadow = false, rot = CFrame.Angles(0, math.rad(i * 45), 0) })
	end
	local potH = h - stoveH - 0.2
	local d = w - 0.4
	Kit.cyl(m, d, potH, 0, stoveH + potH / 2 + 0.15, 0, P.metal, M.metal, { reflectance = 0.15, name = "Body" })
	for _, y in ipairs({ 0.35, potH - 0.45 }) do
		Kit.cyl(dk, d + 0.05, 0.06, 0, stoveH + 0.15 + y, 0, P.steel, M.metal, nc())
	end
	Kit.cyl(m, d + 0.1, 0.12, 0, stoveH + potH + 0.1, 0, P.steel, M.metal, { collide = false })
	local broth = Kit.cyl(m, d - 0.15, 0.06, 0, stoveH + potH - 0.02, 0, P.wood, M.smooth, { collide = false, name = "Broth", transparency = 1 })
	broth:SetAttribute("Fill", true)
	for _, x in ipairs({ -d / 2 - 0.15, d / 2 + 0.15 }) do
		Kit.box(m, 0.3, 0.12, 0.6, x, stoveH + potH - 0.25, 0, P.steel_dark, M.metal, { collide = false })
		Kit.box(m, 0.12, 0.3, 0.12, x - (x > 0 and 0.08 or -0.08), stoveH + potH - 0.12, 0.22, P.steel_dark, M.metal, nc())
		Kit.box(m, 0.12, 0.3, 0.12, x - (x > 0 and 0.08 or -0.08), stoveH + potH - 0.12, -0.22, P.steel_dark, M.metal, nc())
	end
	-- lid leaning against the back of the pot
	Kit.cyl(dk, d * 0.9, 0.08, 0, stoveH + potH / 2 + 0.3, d / 2 + 0.25, P.metal, M.metal, { collide = false, shadow = false, rot = CFrame.Angles(math.rad(80), 0, 0) })
	Kit.box(dk, 0.4, 0.1, 0.12, 0, stoveH + potH / 2 + 0.3, d / 2 + 0.2, P.wood_dark, M.wood, nc())
	-- long ladle (handle + bowl) resting in the pot
	Kit.cyl(m, 0.08, 2.2, d / 4, stoveH + potH + 0.45, 0, P.metal, M.metal, { collide = false, rot = CFrame.Angles(0, 0, math.rad(25)) })
	Kit.cyl(m, 0.1, 0.4, d / 4 - 0.5, stoveH + potH + 1.4, 0, P.wood_dark, M.wood, { collide = false, rot = CFrame.Angles(0, 0, math.rad(25)) })
	local vent = Kit.box(m, d - 0.4, 0.1, d - 0.4, 0, stoveH + potH + 0.2, 0, P.white, M.smooth, { transparency = 1, collide = false, name = "Steam" })
	Kit.particles(vent, "steam", { enabled = false, rate = large and 10 or 6 })
	Kit.particles(broth, "bubbles", { enabled = false })
	point(root, "Content", 0, stoveH + potH, 0)
end

-- Work station: cabinet with the board area (-x), the plate spot (+x) and a tool hovering point.
-- opts: { wood = bool, hood = bool, plate = "寿司", tools = {...}, tiles = bool, knobs = n }
local function station(m, item, deco, opts)
	opts = opts or {}
	local root = Kit.finish(m, size(item))
	local w, h, d = item.size[1], item.size[2], item.size[3]
	-- plain steel cabinet; the "chef gear" renovation (Detail_kitchen) adds the wooden sushi
	-- counter front, backsplash, utensil rail, kanji plate and the small props of each station
	local dk = Kit.detail(m, "kitchen")
	cabinet(m, w, h, d, P.metal, P.metal, false)
	if opts.wood then
		Kit.box(dk, w + 0.1, h - 0.6, 0.06, 0, 0.35 + (h - 0.55) / 2, -d / 2 - 0.16, P.wood_dark, M.wood, nc())
		for i = 0, math.floor(w / 0.45) do
			Kit.box(dk, 0.1, h - 0.8, 0.06, -w / 2 + 0.2 + i * 0.45, 0.35 + (h - 0.55) / 2, -d / 2 - 0.21, P.wood, M.wood, nc())
		end
		Kit.box(dk, w + 0.1, 0.06, d + 0.12, 0, h + 0.03, 0.02, P.hinoki, M.wood, nc())
	end
	backsplash(dk, w, h, d, opts.tiles)
	if opts.tools then
		utensilRail(dk, w, h, d, opts.tools)
	end
	if opts.hood then
		hood(m, w, h, d)
	end
	if opts.knobs then
		knobs(m, opts.knobs, -0.4 * (opts.knobs - 1) / 2, h - 0.45, -d / 2 - 0.08)
	end
	if opts.plate then
		plate(dk, w / 2 - 0.8, h - 0.75, -d / 2 - 0.12, opts.plate)
	end
	local boardX = -w / 2 + 1.4
	local plateX = w / 2 - 0.9
	deco(m, w, h, d, boardX, plateX, dk)
	point(root, "Board", boardX, h + 0.1, 0.05)
	point(root, "Plate", plateX, h + 0.05, 0.1)
	point(root, "Tool", boardX, h + 1.2, -0.1)
	point(root, "Cook", 0, 0, -d / 2 - 1.3, 0)
end

return function(Registry)
	Registry.register("shelf_small", shelfUnit)
	Registry.register("shelf_large", shelfUnit)

	Registry.register("neta_case", function(m, item)
		local root = Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		local baseH = 2.1
		Kit.box(m, w, baseH, d, 0, baseH / 2, 0, P.wood_dark, M.wood)
		Kit.box(m, w + 0.05, 0.12, d + 0.05, 0, baseH + 0.06, 0, P.hinoki, M.wood)
		local caseH = h - baseH - 0.12
		Kit.box(m, w - 0.1, 0.06, d - 0.5, 0, baseH + 0.15, 0.1, P.white, M.smooth, { collide = false })
		Kit.box(m, w, caseH, 0.08, 0, baseH + 0.12 + caseH / 2, d / 2 - 0.25, P.glass, M.glass, { transparency = 0.6 })
		Kit.wedge(m, w, caseH, 1.2, CFrame.new(0, baseH + 0.12 + caseH / 2, -d / 2 + 0.85) * CFrame.Angles(0, math.rad(180), 0), P.glass, M.glass, { transparency = 0.65, collide = false })
		Kit.box(m, w, 0.08, 1.7, 0, baseH + 0.12 + caseH, 0.4, P.steel, M.metal, { collide = false })
		local lightBar = Kit.box(m, w - 0.3, 0.05, 0.2, 0, baseH + 0.08 + caseH, 0.4, P.white, M.neon, { collide = false })
		Kit.light(lightBar, "Surface", P.white, 6, 1.2, { face = Enum.NormalId.Bottom, night = false })
		for i = 1, 4 do
			local x = -w / 2 + w / 4 * (i - 0.5)
			slot(m, i, w / 4 - 0.1, caseH - 0.1, d - 0.4, x, baseH + 0.12 + caseH / 2, 0.1):SetAttribute("Width", w / 4 - 0.3)
		end
		-- ice bed
		Kit.box(m, w - 0.2, 0.1, d - 0.6, 0, baseH + 0.2, 0.1, P.glass, M.glass, { collide = false, transparency = 0.2 })
	end)

	Registry.register("rice_cooker", function(m, item)
		riceCooker(m, item, false)
