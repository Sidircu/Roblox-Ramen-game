		zabuton = "🟥", booth = "🛋️", zashiki_table = "🎎", waiting_bench = "🪵", shelf_small = "🗄️", shelf_large = "🗄️",
		neta_case = "🐟", rice_cooker = "🍚", rice_cooker_pro = "🍚", broth_pot = "🍲", broth_pot_large = "🍲",
