		zone_tatami = "🎎", zone_kitchen_pro = "👨‍🍳", zone_floor2 = "🏢", sign_rooftop = "🪧", facade_deluxe = "✨", zone_rooftop = "🌃",
		reno_storage = "🦺", reno_wainscot = "🪵", reno_kitchen_tiles = "🧱", reno_facade = "🏯", reno_entrance = "🎍",
