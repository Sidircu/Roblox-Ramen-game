	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000009"><Properties><string name="Name">Events</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Seasonal events (UTC dates). While active: themed items in the catalog and a popularity bonus.
local list = {
	{ id = "hanami", from = { 3, 20 }, to = { 4, 30 }, popularity = 0.15, color = "#F7B7C9" },
	{ id = "tanabata", from = { 7, 1 }, to = { 8, 20 }, popularity = 0.15, color = "#7FB7E8" },
	{ id = "tsukimi", from = { 9, 10 }, to = { 10, 31 }, popularity = 0.15, color = "#F2D27A" },
	{ id = "shogatsu", from = { 12, 20 }, to = { 1, 15 }, popularity = 0.20, color = "#D9363E" },
}
local byId = {}
for i, e in ipairs(list) do
	e.order = i
	byId[e.id] = e
end

local function inRange(month, day, from, to)
	local v = month * 100 + day
	local a = from[1] * 100 + from[2]
	local b = to[1] * 100 + to[2]
	if a <= b then
		return v >= a and v <= b
	end
	return v >= a or v <= b -- wraps over new year
end

-- Returns the active event (or nil) for a unix time.
local function active(now)
	local d = os.date("!*t", now)
	for _, e in ipairs(list) do
		if inRange(d.month, d.day, e.from, e.to) then
			return e
		end
	end
	return nil
end

return { list = list, byId = byId, active = active }
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000010"><Properties><string name="Name">Expansions</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Restaurant zones. Rects are { x0, z0, x1, z1 } relative to the plot origin (street side is -Z).
-- area: dining | kitchen | storage | outdoor | garden | tatami
-- room: walls are generated between different rooms and around the building.
-- openings: doors in walls ({ floor, axis = "z" (wall along X at z = at) | "x" (wall along Z at x = at), from, to }).
-- stairs: corner (L-shaped) staircases. flights = { {rect, dir, from, to} } rising in `dir`
-- ("+z", "+x", "-x") from height `from` to `to` (0..1 of the floor height); landing = flat rect;
-- rects = everything the stairs occupy on the lower floor; hole = opening in the floor above
-- (railings on every side but `exitSide`); entry/exit = where you step on / off.
-- The restaurant is laid out at real scale for the avatars: the base is 72 x 56 studs.
local function cornerStairs(floor, side)
	-- side = -1: along the west wall, turning towards +X; side = 1: mirrored on the east wall
	local s = side
	local x0, x1 = s < 0 and -35 or 29, s < 0 and -29 or 35
	local bx0, bx1 = s < 0 and -29 or 17, s < 0 and -17 or 29
	return {
		floor = floor,
		flights = {
			{ rect = { x0, 4, x1, 14 }, dir = "+z", from = 0, to = 0.5 },
			{ rect = { bx0, 14, bx1, 20 }, dir = s < 0 and "+x" or "-x", from = 0.5, to = 1 },
		},
		landing = { x0, 14, x1, 20 },
		rects = { { x0, 4, x1, 14 }, { x0, 14, x1, 20 }, { bx0, 14, bx1, 20 } },
		hole = { math.min(x0, bx0), 14, math.max(x1, bx1), 20 },
		rect = { math.min(x0, bx0), 4, math.max(x1, bx1), 20 },
		entry = { x = (x0 + x1) / 2, z = 2.5 },
		exit = { x = s < 0 and -15.5 or 15.5, z = 17 },
		exitSide = s < 0 and "x+" or "x-",
		-- handrails: flight 1 on the room side, flight 2 on both sides, landing along the back
		railSides = { { s < 0 and 1 or -1 }, { -1, 1 } },
		landingPosts = { { s < 0 and x1 - 0.3 or x0 + 0.3, 19.7 } },
		landingRails = { { x0 + 0.2, 19.8, x1 - 0.2, 19.8 } },
		-- kept clear so the stairs can be reached (lower floor) and left (upper floor)
		entryRect = { x0, 1.5, x1, 4 },
		exitRect = s < 0 and { -17, 14, -14.5, 20 } or { 14.5, 14, 17, 20 },
	}
end

local list = {
	{
		id = "zone_base", lv = 1, cost = 0, requires = {},
		zones = {
			{ id = "base_dining", rect = { -36, 0, 36, 32 }, floor = 0, area = "dining", room = "main" },
			-- 14 deep: stations behind the counter, a 9-stud aisle, the kitchen line on the back wall
			{ id = "base_kitchen", rect = { -36, 32, 36, 46 }, floor = 0, area = "kitchen", room = "main" },
			{ id = "base_storage", rect = { 36, 24, 60, 56 }, floor = 0, area = "storage", room = "storage" },
		},
		openings = {
			{ floor = 0, axis = "z", at = 0, from = -4, to = 4, kind = "entrance" },
			{ floor = 0, axis = "x", at = 36, from = 38, to = 45, kind = "door" },
			{ floor = 0, axis = "z", at = 24, from = 45, to = 55, kind = "loading" },
		},
	},
	{ id = "zone_east", lv = 3, cost = 3000, requires = { "zone_base" }, zones = { { id = "east_dining", rect = { -68, 0, -36, 32 }, floor = 0, area = "dining", room = "main" } } },
	{ id = "zone_storage2", lv = 5, cost = 6000, requires = { "zone_base" }, zones = { { id = "storage2", rect = { 60, 24, 84, 56 }, floor = 0, area = "storage", room = "storage" } } },
	{ id = "zone_west", lv = 8, cost = 18000, requires = { "zone_east" }, zones = { { id = "west_dining", rect = { -100, 0, -68, 56 }, floor = 0, area = "dining", room = "main" } } },
	{ id = "zone_terrace", lv = 12, cost = 60000, requires = { "zone_base" }, zones = { { id = "terrace", rect = { -36, -10, 36, 0 }, floor = 0, area = "outdoor", outdoor = true, gaps = { { axis = "z", at = -10, from = -4, to = 4 } } } } },
	{
		id = "zone_garden", lv = 15, cost = 100000, requires = { "zone_base" },
		zones = { { id = "garden", rect = { -36, 46, 12, 82 }, floor = 0, area = "garden", outdoor = true } },
		openings = { { floor = 0, axis = "z", at = 46, from = -17, to = -10, kind = "door" } },
	},
	{
		id = "zone_tatami", lv = 18, cost = 180000, requires = { "zone_west" },
		zones = { { id = "tatami", rect = { -100, 56, -68, 88 }, floor = 0, area = "tatami", room = "tatami", floorStyle = "floor_tatami", wallStyle = "wall_shoji" } },
		openings = { { floor = 0, axis = "z", at = 56, from = -88, to = -81, kind = "door" } },
	},
	{ id = "zone_kitchen_pro", lv = 20, cost = 250000, requires = { "zone_east" }, zones = { { id = "kitchen_pro", rect = { -68, 32, -36, 46 }, floor = 0, area = "kitchen", room = "main" } } },
	{
		id = "zone_floor2", lv = 25, cost = 600000, requires = { "zone_base" },
		zones = { { id = "floor2", rect = { -36, 0, 36, 46 }, floor = 1, area = "dining", room = "f2" } },
		stairs = { cornerStairs(0, -1) },
	},
	{ id = "sign_rooftop", lv = 28, cost = 500000, requires = { "zone_base" }, popularity = 0.3, cosmetic = true, reno = "exterior" },
	{ id = "facade_deluxe", lv = 30, cost = 1000000, requires = { "zone_base" }, ambience = 60, cosmetic = true, reno = "exterior" },
	{
		id = "zone_rooftop", lv = 35, cost = 2000000, requires = { "zone_floor2" },
		zones = { { id = "rooftop", rect = { -36, 0, 36, 46 }, floor = 2, area = "outdoor", outdoor = true } },
		stairs = { cornerStairs(1, 1) },
	},
	-- Renovations: the starting restaurant is plain; these add the detailed look piece by piece.
	-- reno = tab group; the shell builder reads the owned ids, `style` keeps the matching
	-- Detail_<style> group inside placeable models (see Registry.build).
	{ id = "reno_storage", lv = 2, cost = 800, requires = { "zone_base" }, cosmetic = true, reno = "interior", ambience = 2 },
	{ id = "reno_wainscot", lv = 3, cost = 2500, requires = { "zone_base" }, cosmetic = true, reno = "interior", ambience = 5 },
	{ id = "reno_kitchen_tiles", lv = 4, cost = 3000, requires = { "zone_base" }, cosmetic = true, reno = "interior", ambience = 3 },
	{ id = "reno_facade", lv = 4, cost = 4500, requires = { "zone_base" }, cosmetic = true, reno = "exterior", ambience = 6, popularity = 0.03 },
	{ id = "reno_entrance", lv = 5, cost = 8000, requires = { "zone_base" }, cosmetic = true, reno = "exterior", ambience = 8, popularity = 0.04 },
	{ id = "reno_counter", lv = 6, cost = 10000, requires = { "zone_base" }, cosmetic = true, reno = "furniture", style = "counter", ambience = 10 },
	{ id = "reno_eaves", lv = 7, cost = 14000, requires = { "zone_base" }, cosmetic = true, reno = "exterior", ambience = 10, popularity = 0.04 },
	{ id = "reno_kitchen_gear", lv = 8, cost = 16000, requires = { "zone_base" }, cosmetic = true, reno = "furniture", style = "kitchen", ambience = 6 },
	{ id = "reno_windows", lv = 9, cost = 18000, requires = { "zone_base" }, cosmetic = true, reno = "exterior", ambience = 10 },
	{ id = "reno_beams", lv = 10, cost = 22000, requires = { "reno_wainscot" }, cosmetic = true, reno = "interior", ambience = 14 },
	{ id = "reno_tableware", lv = 11, cost = 28000, requires = { "zone_base" }, cosmetic = true, reno = "furniture", style = "tableware", ambience = 16 },
	{ id = "reno_bamboo", lv = 13, cost = 40000, requires = { "reno_facade" }, cosmetic = true, reno = "exterior", ambience = 18 },
	{ id = "reno_furnish", lv = 15, cost = 60000, requires = { "zone_base" }, cosmetic = true, reno = "furniture", style = "furnish", ambience = 24 },
}

local byId = {}
for i, e in ipairs(list) do
	e.order = i
	byId[e.id] = e
end

-- Set of detail styles owned with these zones/renovations ({ counter = true, ... })
local function styles(zones)
	local out = {}
	for _, e in ipairs(list) do
		if e.style and zones and zones[e.id] then
			out[e.style] = true
		end
	end
	return out
end

-- Every style (used by previews and thumbnails that show the finished look)
local function allStyles()
	local out = {}
	for _, e in ipairs(list) do
		if e.style then
			out[e.style] = true
		end
	end
	return out
end

return {
	list = list,
	byId = byId,
	styles = styles,
	allStyles = allStyles,
	-- Fixed points of the plot (relative to origin)
	Entrance = { x = 0, z = -1.5 },
	StreetWalkZ = -14,
	StreetEnds = { -150, 150 },
	-- The town around the restaurant, at the same scale: a 20-stud sidewalk in front of the
	-- restaurant (front wall at z = 0), a four-lane road (9 studs per lane), a wide far sidewalk
	-- and big neighbour buildings, a raised railway behind them.
	Street = {
		curb = -20,
		roadFar = -56,
		farFront = -72,
		lane = 9,
		truckLane = -24.5,
		railZ = -175,
		railY = 46,
		reach = 380,
	},
	LoadingBay = { x = 50, z = 12 },
	-- the delivery driver leaves the boxes on the floor here: inside the storage room, between the
	-- loading door and the kitchen door (a grid of spots, two boxes high), short way to the shelves
	DropZone = { x0 = 37, x1 = 44.5, z0 = 25, z1 = 33.5, layers = 2 },
	Supplier = { x = 35.7, y = 5, z = 35 },
	MenuBoard = { x = -12, z = -2.6 },
	PlotBounds = { -110, -14, 96, 100 },
	-- strip in front of the street wall kept free for the facade details
	FacadeBand = { -110, -1.6, 96, 0 },
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000011"><Properties><string name="Name">Franchise</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Franchise cities (prestige). Each star: +25% yen, +10% XP permanently.
local list = {
	{ id = "tokyo", star = 0, palette = { road = "#2A2A2E", building = "#6B5A4E", accent = "#B3262E", sky = "#9EC3E6" } },
	{ id = "kyoto", star = 1, palette = { road = "#4A4038", building = "#7A5A3A", accent = "#C8462E", sky = "#E6C9A0" } },
	{ id = "osaka", star = 2, palette = { road = "#26262C", building = "#4A4A5A", accent = "#E8B83A", sky = "#8FB0E0" } },
	{ id = "sapporo", star = 3, palette = { road = "#E8ECF0", building = "#5A6A7A", accent = "#3A6EB3", sky = "#C9D9E8" }, snow = true },
	{ id = "fukuoka", star = 4, palette = { road = "#2E2A2A", building = "#6A4A4A", accent = "#D9363E", sky = "#F0B07A" } },
	{ id = "okinawa", star = 5, palette = { road = "#B8A88A", building = "#E8DCC8", accent = "#2EA3B3", sky = "#7FD0F0" } },
}
local byId = {}
for i, c in ipairs(list) do
	c.order = i
	byId[c.id] = c
end
-- What the next city asks for (index = the star it gives): the first franchise comes after a
-- few hours of play (level 12, the first three rooms), every next one asks for more.
local Steps = {
	{ level = 12, rating = 4.0, zones = { "zone_east", "zone_storage2", "zone_west" } },
	{ level = 16, rating = 4.1, zones = { "zone_east", "zone_storage2", "zone_west", "zone_terrace", "zone_garden" } },
	{ level = 20, rating = 4.2, zones = { "zone_east", "zone_storage2", "zone_west", "zone_terrace", "zone_garden", "zone_tatami", "zone_kitchen_pro" } },
	{ level = 25, rating = 4.3, zones = { "zone_east", "zone_storage2", "zone_west", "zone_terrace", "zone_garden", "zone_tatami", "zone_kitchen_pro", "zone_floor2" } },
	{ level = 30, rating = 4.4, zones = { "zone_east", "zone_storage2", "zone_west", "zone_terrace", "zone_garden", "zone_tatami", "zone_kitchen_pro", "zone_floor2" } },
}

return {
	list = list,
	byId = byId,
	Steps = Steps,
	-- the requirements of the next franchise for a restaurant with `stars` stars (nil: all done)
	nextStep = function(stars)
		return Steps[(stars or 0) + 1]
	end,
	YenPerStar = 0.25,
	XpPerStar = 0.10,
	StartYen = 2000,
	RegionalLevel = 5,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000012"><Properties><string name="Name">GameConfig</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- General tuning constants. Balance tables live in the sibling Config modules.
return {
	PlaceName = "Sakura Ramen & Sushi Tycoon",

	-- Interaction
	InteractRange = 11, -- studs between character and object
	IngredientHandCapacity = 6,

	-- Building
	FloorHeight = 15, -- floor-to-floor distance
	WallHeight = 14,
	CellSize = 2, -- wall generation grid
	PathCell = 1, -- walkability grid for placement validation
	PathClearance = 0.9, -- obstacles are inflated by this (corridors >= 2 studs)
	GridSizes = { 1, 5, 10 },
	RotationSteps = { 90, 45, 15 },
	SellRefund = 0.75,
	FullRefundSeconds = 30,

	-- Time of day: the restaurant is always open and the clock never stops. A game hour lasts
	-- SecondsPerHour real seconds (NightSecondsPerHour between NightFrom and NightTo, so the quiet
	-- night passes quickly); a full day is about 14 minutes. Every day at DayStartHour the day's
	-- accounts are closed (salaries, stats, daily quests, a short summary).
	Day = {
		StartClock = 10,
		DayStartHour = 6,
		SecondsPerHour = 45,
		NightSecondsPerHour = 15,
		NightFrom = 23,
		NightTo = 6,
		NightFactor = 1.6, -- customers come this much less often at night
		Peaks = { { 12, 14 }, { 19, 21 } },
		PeakFactor = 0.6,
		EarlyPeakFactor = 0.85, -- peaks are lighter for the first EarlyDays days
		EarlyDays = 2,
	},

	-- Customers
	Customers = {
		-- easy mode: every customer type waits this many times its base patience, and the timer
		-- starts again from full when you take the order (full time to cook it)
		PatienceMult = 1.8,
		MaxNpcs = 60, -- customers and staff of the whole street
		MaxPerRestaurant = 14, -- customers of one restaurant at the same time
		BaseInterval = 18,
		MinInterval = 2.5,
		-- with this many orders waiting (+ BusyTicketsPerCook for every cook on the staff) new
		-- customers come BusyFactor times less often
		BusyTickets = 3,
		BusyTicketsPerCook = 3,
		BusyFactor = 2.5,
		MenuReadTime = { 1.5, 3 },
		FirstCustomerDelay = 2, -- the first customer walks in this soon after the restaurant opens
		StreetSpawn = { 70, 95 }, -- customers appear this far along the street (studs from the door)
		EatTime = { sushi = 12, ramen = 18, side = 8, drink = 6, dessert = 8 },
		ExtraOrderChance = 0.4,
		SecondOrderChance = 0.15,
		QueuePerBench = 3,
		BaseQueue = 2,
		StuckTeleportSeconds = 8,
		SeatHeightOffset = 1.05,
		WalkSpeed = 11,
		DefaultRating = 3.0,
		RecentReviews = 50,
	},

	-- Cooking step durations (seconds) and which upgrade speeds them up
	Steps = {
		combine = { time = 0.9, tool = "up_knife" },
		cut = { time = 1.0, tool = "up_knife" },
		roll = { time = 1.1, tool = "up_mat" },
		mold = { time = 1.0, tool = "up_mat" },
		boil = { time = 1.8, tool = "up_strainer" },
		pour = { time = 0.9, tool = "up_strainer" },
		top = { time = 0.9, tool = "up_strainer" },
		batter = { time = 0.8, tool = "up_strainer" },
		fry = { time = 1.4, tool = "up_strainer" },
		flip = { time = 1.1, tool = "up_strainer" },
	},

	-- Supply
	DeliveryOverflowBoxes = 30,
	TruckDrive = 4.5, -- seconds the delivery truck drives in (about 6 s from order to boxes)
	-- optional noodle timing: stop the needle inside the green part of the bar while the noodles
	-- boil (From..To of the step) for a perfect bowl and a bigger tip
	NoodleTiming = { From = 0.5, To = 0.8, TipBonus = 0.2 },
	DishInset = 0.85, -- studs from the edge of a counter / table to where a customer's dish goes
	TipJarFull = 600, -- yen that fill the tip jar to the top (only the look: it never overflows)
	RescueCooldown = 600, -- free kit when broke and out of ingredients, at most every 10 minutes
	BigBoxMultiplier = 3,
	-- A box fills at most this many shelf slots: a base slot holds 1/BoxShelfSlots of a box
	-- (bigger shelves and the shelf upgrade make slots roomier); big boxes fill this many per use
	BoxShelfSlots = 2,
	ShelfItemScale = 1.3, -- largest size of the products shown in the shelf grids
	StockFlyStep = 0.06, -- seconds between two products flying from the box to the shelf

	-- Sink: hold to wash one plate every Time seconds; at most MaxPile dirty plates are drawn in the
	-- soaking basin; staff wash up to StaffBatch plates per trip
	Washing = { Time = 1.6, MaxPile = 12, StaffBatch = 8 },

	-- Dishes (plates and bowls)
	StartDishes = 20,
	DishSetSize = 6,
	DishSetPrice = 300,

	-- Freshness bonus (neta case fish or professional fridge nearby)
	FreshTipBonus = 0.10,
	FreshReviewBonus = 0.3,

	-- Economy
	StartYen = 500,
	HelperRewardShare = 0.2,

	-- Player
	WalkSpeed = 16,

	-- Saving
	AutosaveSeconds = 120,
	SessionLockSeconds = 600, -- a lock older than this belongs to a crashed server
	LockWaitSeconds = 40, -- a joining server waits this long for the old one to release a profile

	DataStoreName = "Profiles_v1",

	-- Staff
	StaffWalkSpeed = 13,
	StaffSpeedPerLevel = 0.15,
	ManagerSpeedBonus = 0.10,
	MaxStaff = 12,
	AutoRestockCheck = 30,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000013"><Properties><string name="Name">Ingredients</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Ingredients sold by the supplier in boxes.
-- storage: "shelf" (shelves), "fish" (shelves or neta case, freshness bonus in the case),
--          "rice" (poured into a rice cooker), "broth" (poured into a broth pot)
-- shape: visual used on shelves/boards: fillet, veg, pack, sack, jar, bottle, noodle, egg, sheet, ball, leaf
local list = {
	{ id = "rice", units = 20, price = 60, storage = "rice", license = "lic_sushi0", icon = "🍚", color = "#F4F1EA", shape = "sack" },
	{ id = "nori", units = 30, price = 45, storage = "shelf", license = "lic_sushi0", icon = "🟩", color = "#1E2B1E", shape = "sheet" },
	{ id = "cucumber", units = 16, price = 32, storage = "shelf", license = "lic_sushi0", icon = "🥒", color = "#4E8A3A", shape = "veg" },
	{ id = "salmon", units = 12, price = 120, storage = "fish", license = "lic_sashimi", icon = "🐟", color = "#F28C5A", shape = "fillet" },
	{ id = "noodles", units = 20, price = 80, storage = "shelf", license = "lic_base", icon = "🍜", color = "#F2D27A", shape = "noodle" },
	{ id = "broth_shoyu", units = 16, price = 96, storage = "broth", license = "lic_base", icon = "🥣", color = "#7A4A22", shape = "jar" },
	{ id = "scallion", units = 30, price = 45, storage = "shelf", license = "lic_base", icon = "🌱", color = "#6DB33F", shape = "leaf" },
	{ id = "naruto", units = 20, price = 60, storage = "shelf", license = "lic_base", icon = "🍥", color = "#F7F3F3", shape = "pack" },
	{ id = "tuna", units = 12, price = 168, storage = "fish", license = "lic_sushi1", icon = "🐟", color = "#B8293A", shape = "fillet" },
	{ id = "egg", units = 12, price = 72, storage = "shelf", license = "lic_ramen1", icon = "🥚", color = "#F3C24A", shape = "egg" },
	{ id = "broth_shio", units = 16, price = 96, storage = "broth", license = "lic_ramen1", icon = "🥣", color = "#E9D9A8", shape = "jar" },
	{ id = "edamame", units = 20, price = 60, storage = "shelf", license = "lic_sides", icon = "🫛", color = "#7DBA4A", shape = "pack" },
	{ id = "green_tea", units = 30, price = 60, storage = "shelf", license = "lic_sides", icon = "🍵", color = "#8DB55A", shape = "jar" },
	{ id = "miso_paste", units = 16, price = 96, storage = "shelf", license = "lic_sides", icon = "🟫", color = "#B5803A", shape = "jar" },
	{ id = "tofu", units = 20, price = 50, storage = "shelf", license = "lic_sides", icon = "⬜", color = "#F6F2E6", shape = "pack" },
	{ id = "avocado", units = 12, price = 72, storage = "shelf", license = "lic_sushi2", icon = "🥑", color = "#7FA33A", shape = "veg" },
	{ id = "surimi", units = 16, price = 80, storage = "shelf", license = "lic_sushi2", icon = "🦀", color = "#E8544A", shape = "pack" },
	{ id = "sesame", units = 40, price = 40, storage = "shelf", license = "lic_sushi2", icon = "⚪", color = "#E9DCC0", shape = "jar" },
	{ id = "shrimp", units = 12, price = 144, storage = "fish", license = "lic_sushi2", icon = "🦐", color = "#F48A6A", shape = "fillet" },
	{ id = "broth_miso", units = 16, price = 128, storage = "broth", license = "lic_ramen2", icon = "🥣", color = "#C58A3E", shape = "jar" },
	{ id = "corn", units = 20, price = 40, storage = "shelf", license = "lic_ramen2", icon = "🌽", color = "#F4CF3B", shape = "pack" },
	{ id = "butter", units = 20, price = 60, storage = "shelf", license = "lic_ramen2", icon = "🧈", color = "#F7E39A", shape = "pack" },
	{ id = "gyoza_raw", units = 24, price = 120, storage = "shelf", license = "lic_griddle", icon = "🥟", color = "#F1E6CC", shape = "pack" },
	{ id = "eel", units = 10, price = 220, storage = "fish", license = "lic_sushi3", icon = "🐍", color = "#6B4325", shape = "fillet" },
	{ id = "eel_sauce", units = 30, price = 60, storage = "shelf", license = "lic_sushi3", icon = "🫙", color = "#3B2414", shape = "bottle" },
	{ id = "broth_tonkotsu", units = 16, price = 192, storage = "broth", license = "lic_ramen3", icon = "🥣", color = "#F1E4C8", shape = "jar" },
