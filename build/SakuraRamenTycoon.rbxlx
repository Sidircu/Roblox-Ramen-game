for i, ing in ipairs(list) do
	ing.order = i
	byId[ing.id] = ing
end

return {
	list = list,
	byId = byId,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000013"><Properties><string name="Name">Items</string><ProtectedString name="Source"><![CDATA[--!nonstrict
