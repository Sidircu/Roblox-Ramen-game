-- License tree. Buying a license unlocks its recipes and station items.
local list = {
	-- you start with shoyu ramen only; a very easy second dish (salmon sashimi: one cut) comes
	-- cheap at level 2, then basic sushi with rice
	{ id = "lic_base", branch = "base", level = 1, cost = 0, rating = 0, requires = {}, recipes = { "shoyu_ramen" } },
	{ id = "lic_sashimi", branch = "sushi", level = 2, cost = 300, rating = 0, requires = { "lic_base" }, recipes = { "sake_sashimi" } },
	{ id = "lic_sushi0", branch = "sushi", level = 3, cost = 800, rating = 0, requires = { "lic_sashimi" }, recipes = { "kappa_maki", "sake_nigiri" } },
	{ id = "lic_sushi1", branch = "sushi", level = 4, cost = 1800, rating = 0, requires = { "lic_sushi0" }, recipes = { "tekka_maki", "maguro_nigiri" } },
	{ id = "lic_ramen1", branch = "ramen", level = 4, cost = 2200, rating = 0, requires = { "lic_base" }, recipes = { "shio_ramen" } },
	{ id = "lic_sides", branch = "extra", level = 5, cost = 4000, rating = 0, requires = { "lic_base" }, recipes = { "edamame", "green_tea", "miso_soup" } },
	{ id = "lic_sushi2", branch = "sushi", level = 8, cost = 12000, rating = 0, requires = { "lic_sushi1" }, recipes = { "california_roll", "ebi_nigiri" } },
	{ id = "lic_ramen2", branch = "ramen", level = 9, cost = 15000, rating = 0, requires = { "lic_ramen1" }, recipes = { "miso_ramen" } },
	{ id = "lic_griddle", branch = "extra", level = 12, cost = 30000, rating = 0, requires = { "lic_sides" }, recipes = { "gyoza" } },
	{ id = "lic_sushi3", branch = "sushi", level = 14, cost = 45000, rating = 3.5, requires = { "lic_sushi2" }, recipes = { "temaki_salmon", "dragon_roll" } },
	{ id = "lic_ramen3", branch = "ramen", level = 16, cost = 60000, rating = 3.5, requires = { "lic_ramen2" }, recipes = { "tonkotsu_ramen", "tantanmen" } },
	{ id = "lic_fryer", branch = "extra", level = 18, cost = 80000, rating = 0, requires = { "lic_griddle" }, recipes = { "ebi_tempura", "karaage" } },
	{ id = "lic_sushi4", branch = "sushi", level = 22, cost = 150000, rating = 4.0, requires = { "lic_sushi3" }, recipes = { "sashimi_moriawase", "ikura_gunkan" } },
	{ id = "lic_street", branch = "extra", level = 24, cost = 180000, rating = 0, requires = { "lic_fryer" }, recipes = { "takoyaki" } },
	{ id = "lic_ramen4", branch = "ramen", level = 25, cost = 220000, rating = 4.0, requires = { "lic_ramen3" }, recipes = { "tsukemen" } },
	{ id = "lic_dessert", branch = "extra", level = 28, cost = 300000, rating = 0, requires = { "lic_sides" }, recipes = { "mochi", "matcha_latte", "ramune" } },
	{ id = "lic_sushi_master", branch = "sushi", level = 35, cost = 900000, rating = 4.5, requires = { "lic_sushi4" }, recipes = { "otoro_nigiri", "omakase" } },
	{ id = "lic_ramen_master", branch = "ramen", level = 38, cost = 1200000, rating = 4.5, requires = { "lic_ramen4" }, recipes = { "mayu_ramen" } },
	{ id = "lic_grandmaster", branch = "master", level = 45, cost = 3000000, rating = 4.7, requires = { "lic_sushi_master", "lic_ramen_master" }, recipes = { "kaiseki" } },
}

local byId = {}
for i, l in ipairs(list) do
	l.order = i
	byId[l.id] = l
end

return {
	list = list,
	byId = byId,
	Branches = { "base", "sushi", "ramen", "extra", "master" },
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000016"><Properties><string name="Name">Monetization</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Robux products. Put the real IDs from the Creator Dashboard here; 0 = disabled (hidden).
return {
	GamePasses = {
		{ id = "gp_vip", assetId = 0, effect = { yenMult = 1.25, item = "maneki_gold" } },
		{ id = "gp_double_yen", assetId = 0, effect = { yenMult = 2 } },
		{ id = "gp_big_tray", assetId = 0, effect = { tray = 2 } },
		{ id = "gp_express", assetId = 0, effect = { cart = 1 } }, -- big cart: one more box at a time
		{ id = "gp_starter", assetId = 0, effect = { yen = 10000, items = { stool_cushion = 6, neon_ramen = 1, maneki_neko = 1, sakura_tree = 1 } } },
	},
	Products = {
		{ id = "dp_yen_s", productId = 0, effect = { yen = 1000 } },
		{ id = "dp_yen_m", productId = 0, effect = { yen = 5000 } },
		{ id = "dp_yen_l", productId = 0, effect = { yen = 15000 } },
		{ id = "dp_yen_xl", productId = 0, effect = { yen = 50000 } },
		{ id = "dp_sakura_s", productId = 0, effect = { sakura = 20 } },
		{ id = "dp_sakura_m", productId = 0, effect = { sakura = 120 } },
		{ id = "dp_sakura_l", productId = 0, effect = { sakura = 300 } },
		{ id = "dp_rush_hour", productId = 0, effect = { boost = "rush", seconds = 1800 } },
		{ id = "dp_golden_sign", productId = 0, effect = { boost = "golden", seconds = 1800 } },
	},
	-- yen packs scale with the restaurant level: yen * (1 + level / 5)
	YenLevelScale = 0.2,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000017"><Properties><string name="Name">NpcLooks</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Colors and procedural accessories for NPCs. Optional catalog accessory ids can be added
-- to `catalogHats` (numbers); they are applied through HumanoidDescription.
return {
	skin = { "#F5D6BA", "#E8B996", "#D19A6E", "#A8714A", "#7A4E30", "#FBE3CC" },
	hair = { "#1A1412", "#2E2018", "#4A3020", "#6A4A2A", "#B8B0A8", "#E8D8B0", "#3A2A4A" },
	shirts = {
		casual = { "#D9363E", "#3A6EB3", "#F2D27A", "#6DB33F", "#F4F1EA", "#8A5AB3", "#2EA3B3" },
		suit = { "#2A2A30", "#3A3A44", "#24283A" },
		tourist = { "#F2A03A", "#7FC8E8", "#F7D9E3", "#C9E87F" },
		elder = { "#8A7A6A", "#5A4A3A", "#6A6A5A" },
		trendy = { "#F25A9A", "#1E1E22", "#F4F1EA", "#7F3AB3" },
		vip = { "#14141A", "#4A1420", "#1E2A4A" },
	},
	pants = { "#2A2A30", "#3A4A6A", "#5A4A3A", "#1E1E22", "#6A6A6A" },
	catalogHats = {},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000018"><Properties><string name="Name">Plots</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The street holds Count restaurants side by side, one per player (Game Settings → Max Players
-- should be Count). Every restaurant uses the same local layout (Config/Expansions, StarterLayout)
-- moved along X to its plot origin. A plot owns the strip of street origin ± HalfWidth.
local Count = 4
local Spacing = 240
local origins = {}
for i = 1, Count do
	origins[i] = (i - (Count + 1) / 2) * Spacing
end

return {
	Count = Count,
	Spacing = Spacing,
	OriginsX = origins,
	HalfWidth = Spacing / 2,
	-- the street runs this far each way from the middle (past the outer restaurants)
	StreetReach = origins[Count] + Spacing / 2 + 140,
	-- who may help in a restaurant: "friends" (default: Roblox friends and invited players) or
	-- "everyone"; the owner changes it in the Invite app
	DefaultCoop = "friends",
	-- spawn point in front of each restaurant (local coordinates)
	Spawn = { x = 0, y = 3, z = -8 },
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000019"><Properties><string name="Name">Quests</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Daily quest templates. target = base + perLevel * level (rounded).
-- kind matches the events sent to MetaService.event(owner, kind, amount, info).
local list = {
	{ id = "q_serve", kind = "serve", base = 15, perLevel = 1.2 },
	{ id = "q_serve_sushi", kind = "serve_sushi", base = 8, perLevel = 0.8 },
	{ id = "q_serve_ramen", kind = "serve_ramen", base = 8, perLevel = 0.8 },
	{ id = "q_tips", kind = "tips", base = 150, perLevel = 60 },
	{ id = "q_earn", kind = "earn", base = 800, perLevel = 400 },
	{ id = "q_happy", kind = "happy", base = 10, perLevel = 0.6 },
	{ id = "q_customers", kind = "customers", base = 12, perLevel = 1 },
	{ id = "q_restock", kind = "restock", base = 6, perLevel = 0.3 },
	{ id = "q_wash", kind = "wash", base = 12, perLevel = 0.6 },
	{ id = "q_five_stars", kind = "five_stars", base = 5, perLevel = 0.3 },
}
local byId = {}
for i, q in ipairs(list) do
	q.order = i
	byId[q.id] = q
end
return {
	list = list,
	byId = byId,
	PerDay = 3,
	RewardYenPerLevel = 200,
	RewardSakura = 2,
	BonusSakura = 5,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000020"><Properties><string name="Name">Recipes</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Recipes. `ing` are the ingredients the cook brings to the station by hand;
-- `rice` = takes one cooked rice portion from a rice cooker; `broth` = takes one portion
-- of that broth from a pot. Every station must have unique ingredient sets.
-- steps: combine, cut, roll, mold, boil, pour, top, batter, fry, flip (one click each)
-- cat: eating category (sushi, ramen, side, drink, dessert)
-- dish: visual model used by Models/Builders/Food
local list = {
	-- Base
	{ id = "kappa_maki", station = "sushi", ing = { "nori", "cucumber" }, rice = true, steps = { "combine", "roll", "cut" }, price = 25, xp = 8, cat = "sushi", license = "lic_sushi0", icon = "🍣", dish = "maki" },
	{ id = "sake_nigiri", station = "sushi", ing = { "salmon" }, rice = true, steps = { "cut", "combine" }, price = 40, xp = 10, cat = "sushi", license = "lic_sushi0", icon = "🍣", dish = "nigiri" },
