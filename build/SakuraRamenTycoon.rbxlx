	{ id = "staff_manager", icon = "🎩", lv = 26, hire = 150000, salary = 3000, tasks = {}, manager = true, shirt = "#1E1E22" },
}

local byId = {}
for i, s in ipairs(list) do
	s.order = i
	byId[s.id] = s
end

local NAMES = {
	"Kenji", "Yuki", "Haruto", "Sakura", "Ren", "Aoi", "Sota", "Hina", "Daiki", "Mei",
	"Takumi", "Yui", "Riku", "Nanami", "Kaito", "Rin", "Hiro", "Emi", "Shun", "Koharu",
}

return {
	list = list,
	byId = byId,
	Names = NAMES,
	MaxTrainLevel = 5,
	-- base slots and extra slots granted by expansions
	BaseSlots = 2,
	SlotsByZone = { zone_east = 1, zone_west = 1, zone_terrace = 1, zone_kitchen_pro = 3, zone_floor2 = 3 },
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000021"><Properties><string name="Name">StarterLayout</string><ProtectedString name="Source"><![CDATA[--!nonstrict
