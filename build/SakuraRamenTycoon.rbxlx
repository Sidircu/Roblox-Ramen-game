	Registry.register("sink", function(m, item)
		local root = Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		cabinet(m, w, h, d, P.metal, P.steel)
		local dk = Kit.detail(m, "kitchen")
		backsplash(dk, w, h, d, true)
		plate(dk, w / 2 - 0.8, h - 0.75, -d / 2 - 0.12, "洗い場")
		-- double basin (built from walls so it looks hollow), soapy water in the left one
		local bw, bd = 1.25, d - 0.75
		for i, bx in ipairs({ -1.1, 0.25 }) do
			Kit.box(m, bw, 0.08, bd, bx, h - 0.7, 0, P.steel_dark, M.metal, nc())
			for _, s in ipairs({ { 0, -bd / 2, bw, 0.08 }, { 0, bd / 2, bw, 0.08 }, { -bw / 2, 0, 0.08, bd }, { bw / 2, 0, 0.08, bd } }) do
				Kit.box(m, s[3], 0.7, s[4], bx + s[1], h - 0.35, s[2], P.metal, M.metal, { collide = false, reflectance = 0.1 })
			end
			Kit.cyl(m, 0.2, 0.02, bx, h - 0.65, 0, P.charcoal, M.metal, nc())
			if i == 1 then
				Kit.box(m, bw - 0.1, 0.05, bd - 0.1, bx, h - 0.45, 0, P.water, M.glass, { transparency = 0.35, collide = false, name = "Water" })
				for k = 0, 4 do
					Kit.ball(dk, 0.18 + (k % 2) * 0.08, bx - 0.4 + k * 0.2, h - 0.4, -0.2 + (k % 3) * 0.15, P.white, M.smooth, { collide = false, shadow = false, transparency = 0.15 })
				end
			end
		end
		-- gooseneck faucet between the basins with a pre-rinse sprayer
		local fx, fz = -0.42, bd / 2 + 0.12
		Kit.cyl(m, 0.2, 0.12, fx, h + 0.06, fz, P.metal, M.metal, nc())
		Kit.cyl(m, 0.1, 1.4, fx, h + 0.8, fz, P.metal, M.metal, { collide = false, reflectance = 0.2 })
		Kit.cylH(m, 0.1, 0.6, fx, h + 1.5, fz - 0.27, P.metal, M.metal, { collide = false, shadow = false, reflectance = 0.2 }, "z")
		local spout = Kit.cyl(m, 0.1, 0.3, fx, h + 1.36, fz - 0.55, P.metal, M.metal, { collide = false, name = "Spout" })
		Kit.particles(spout, "water", { enabled = false })
		for _, sx in ipairs({ -0.3, 0.3 }) do
			Kit.cylH(dk, 0.12, 0.25, fx + sx, h + 0.35, fz, P.metal, M.metal, nc(), "x")
			Kit.box(dk, 0.05, 0.05, 0.25, fx + sx * 1.3, h + 0.35, fz - 0.1, sx < 0 and P.neon_red or P.neon_blue, M.smooth, nc())
		end
		-- sponge, dish soap and a tenugui towel over the cabinet lip
		Kit.box(dk, 0.35, 0.14, 0.22, -1.75, h + 0.07, bd / 2, P.leaf_light, M.fabric, nc())
		Kit.box(dk, 0.35, 0.05, 0.22, -1.75, h + 0.165, bd / 2, P.neon_yellow, M.fabric, nc())
		Kit.cyl(dk, 0.24, 0.5, -1.75, h + 0.25, bd / 2 - 0.4, P.leaf, M.plastic, { collide = false, shadow = false, transparency = 0.2 })
		Kit.cyl(dk, 0.08, 0.12, -1.75, h + 0.56, bd / 2 - 0.4, P.white, M.plastic, nc())
		Kit.box(dk, 0.6, 0.9, 0.03, 0.3, h - 0.4, -d / 2 - 0.16, P.white, M.fabric, nc())
		Kit.box(dk, 0.6, 0.12, 0.035, 0.3, h - 0.6, -d / 2 - 0.165, P.indigo, M.fabric, nc())
		-- wire drying rack with clean plates
		local rx = w / 2 - 0.55
		Kit.box(dk, 0.9, 0.05, d - 0.5, rx, h + 0.05, 0, P.metal, M.metal, nc())
		for _, sx in ipairs({ -0.42, 0.42 }) do
			for k = 0, 5 do
				Kit.box(dk, 0.03, 0.4, 0.03, rx + sx, h + 0.25, -0.75 + k * 0.3, P.metal, M.metal, nc())
			end
		end
		for i = 0, 3 do
			Kit.cyl(dk, 0.7, 0.06, rx, h + 0.42, -0.45 + i * 0.3, P.porcelain, M.smooth, { collide = false, rot = CFrame.Angles(math.rad(90), 0, 0) })
			Kit.cyl(dk, 0.74, 0.03, rx, h + 0.42, -0.45 + i * 0.3, P.indigo, M.smooth, { collide = false, shadow = false, rot = CFrame.Angles(math.rad(90), 0, 0) })
		end
		point(root, "Basin", -0.4, h, 0)
		point(root, "Dirty", w / 2 - 0.55, h + 0.1, 0.45)
	end)

	Registry.register("dishwasher", function(m, item)
		local root = Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		Kit.box(m, w, h, d, 0, h / 2, 0, P.metal, M.metal, { reflectance = 0.1 })
		Kit.box(m, w - 0.3, h - 1, 0.06, 0, h / 2 - 0.2, -d / 2 - 0.02, P.steel, M.metal, { collide = false })
		Kit.box(m, w - 0.8, 0.8, 0.04, 0, h / 2 + 0.2, -d / 2 - 0.05, P.glass, M.glass, { collide = false, transparency = 0.3 })
		Kit.box(m, w - 0.6, 0.12, 0.12, 0, h - 0.55, -d / 2 - 0.1, P.steel_dark, M.metal, { collide = false })
		Kit.box(m, 0.18, 0.18, 0.05, w / 2 - 0.35, h - 0.25, -d / 2 - 0.03, P.neon_blue, M.neon, { collide = false, name = "Led" })
		local steam = Kit.box(m, 0.4, 0.1, 0.4, 0, h + 0.05, 0, P.white, M.smooth, { transparency = 1, collide = false, name = "Steam" })
		Kit.particles(steam, "steam", { enabled = false })
		point(root, "Content", 0, h, 0)
	end)

	Registry.register("fridge", function(m, item)
		local root = Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		Kit.box(m, w, h, d, 0, h / 2, 0, P.metal, M.metal, { reflectance = 0.15 })
		for _, x in ipairs({ -w / 4, w / 4 }) do
			Kit.box(m, w / 2 - 0.08, h - 0.6, 0.06, x, h / 2, -d / 2 - 0.03, P.steel, M.metal, { collide = false, reflectance = 0.2 })
			Kit.box(m, 0.08, 1.6, 0.12, x + (x < 0 and w / 4 - 0.2 or -w / 4 + 0.2), h / 2 + 0.5, -d / 2 - 0.1, P.steel_dark, M.metal, { collide = false })
		end
		local display = Kit.box(m, 0.8, 0.3, 0.04, 0, h - 0.25, -d / 2 - 0.04, P.charcoal, M.smooth, { collide = false })
		Kit.text(display, Enum.NormalId.Front, "2°C", { color = "#3BC8FF", glow = true })
		local _ = root
	end)
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000042"><Properties><string name="Name">People</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Procedural accessories for NPC characters (hair, hats, glasses, bags, aprons).
local Kit = require(script.Parent.Parent.Kit)
local P = require(script.Parent.Parent.Palette)
local Color = require(script.Parent.Parent.Parent.Util.Color)
local M = P.M

local People = {}

local function weld(part, to)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	local w = Instance.new("WeldConstraint")
	w.Part0 = to
	w.Part1 = part
	w.Parent = part
	part.Parent = to.Parent
	return part
end

local function at(base, cf)
	return base.CFrame * cf
end

function People.hair(character, color, style)
	local head = character:FindFirstChild("Head")
	if not head then
		return
	end
	local p = Kit.part(nil, Vector3.new(1.3, 0.45, 1.25), at(head, CFrame.new(0, 0.42, 0.05)), color, M.smooth, { collide = false })
	weld(p, head)
	if style == 2 then
		local back = Kit.part(nil, Vector3.new(1.25, 0.9, 0.3), at(head, CFrame.new(0, 0.05, 0.55)), color, M.smooth, { collide = false })
		weld(back, head)
	elseif style == 3 then
		local bun = Kit.part(nil, Vector3.new(0.55, 0.55, 0.55), at(head, CFrame.new(0, 0.75, 0.3)), color, M.smooth, { shape = Enum.PartType.Ball, collide = false })
		weld(bun, head)
	elseif style == 4 then
		local long = Kit.part(nil, Vector3.new(1.3, 1.4, 0.35), at(head, CFrame.new(0, -0.3, 0.55)), color, M.smooth, { collide = false })
		weld(long, head)
	end
end

function People.hat(character, kind, color)
	local head = character:FindFirstChild("Head")
	if not head then
		return
	end
	if kind == "cap" then
		weld(Kit.part(nil, Vector3.new(1.35, 0.4, 1.3), at(head, CFrame.new(0, 0.6, 0)), color, M.fabric, { collide = false }), head)
		weld(Kit.part(nil, Vector3.new(1.0, 0.08, 0.7), at(head, CFrame.new(0, 0.45, -0.85)), color, M.fabric, { collide = false }), head)
	elseif kind == "bucket" then
		weld(Kit.part(nil, Vector3.new(0.5, 1.6, 1.6), at(head, CFrame.new(0, 0.55, 0) * CFrame.Angles(0, 0, math.rad(90))), color, M.fabric, { shape = Enum.PartType.Cylinder, collide = false }), head)
	elseif kind == "chef" then
		weld(Kit.part(nil, Vector3.new(0.9, 1.3, 1.3), at(head, CFrame.new(0, 0.95, 0) * CFrame.Angles(0, 0, math.rad(90))), P.white, M.fabric, { shape = Enum.PartType.Cylinder, collide = false }), head)
	elseif kind == "hachimaki" then
		weld(Kit.part(nil, Vector3.new(1.32, 0.22, 1.28), at(head, CFrame.new(0, 0.3, 0)), P.white, M.fabric, { collide = false }), head)
		weld(Kit.part(nil, Vector3.new(0.5, 0.5, 0.06), at(head, CFrame.new(0, 0.32, -0.66)), P.lacquer, M.fabric, { shape = Enum.PartType.Cylinder, collide = false }), head)
	elseif kind == "sunhat" then
		weld(Kit.part(nil, Vector3.new(0.15, 2.4, 2.4), at(head, CFrame.new(0, 0.55, 0) * CFrame.Angles(0, 0, math.rad(90))), color, M.fabric, { shape = Enum.PartType.Cylinder, collide = false }), head)
		weld(Kit.part(nil, Vector3.new(0.5, 1.3, 1.3), at(head, CFrame.new(0, 0.75, 0) * CFrame.Angles(0, 0, math.rad(90))), color, M.fabric, { shape = Enum.PartType.Cylinder, collide = false }), head)
	end
end

function People.glasses(character, color)
	local head = character:FindFirstChild("Head")
	if not head then
		return
	end
	for _, x in ipairs({ -0.25, 0.25 }) do
		weld(Kit.part(nil, Vector3.new(0.35, 0.25, 0.05), at(head, CFrame.new(x, 0.1, -0.62)), color or P.black, M.glass, { collide = false, transparency = 0.3 }), head)
	end
	weld(Kit.part(nil, Vector3.new(0.9, 0.05, 0.05), at(head, CFrame.new(0, 0.18, -0.63)), color or P.black, M.smooth, { collide = false }), head)
end

function People.bag(character, kind, color)
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	if not torso then
		return
	end
	if kind == "backpack" then
		weld(Kit.part(nil, Vector3.new(1.4, 1.5, 0.6), at(torso, CFrame.new(0, 0, 0.75)), color, M.fabric, { collide = false }), torso)
	elseif kind == "camera" then
		weld(Kit.part(nil, Vector3.new(0.6, 0.4, 0.35), at(torso, CFrame.new(0, -0.3, -0.7)), P.black, M.smooth, { collide = false }), torso)
		weld(Kit.part(nil, Vector3.new(0.25, 0.25, 0.3), at(torso, CFrame.new(0, -0.3, -0.95) * CFrame.Angles(math.rad(90), 0, 0)), P.steel_dark, M.glass, { shape = Enum.PartType.Cylinder, collide = false }), torso)
	elseif kind == "briefcase" then
		local hand = character:FindFirstChild("LeftHand")
		if hand then
			weld(Kit.part(nil, Vector3.new(0.3, 1.0, 1.4), at(hand, CFrame.new(0, -0.6, 0)), P.wood_dark, M.leather, { collide = false }), hand)
		end
	elseif kind == "scarf" then
		weld(Kit.part(nil, Vector3.new(1.5, 0.35, 1.1), at(torso, CFrame.new(0, 0.75, 0)), color, M.fabric, { collide = false }), torso)
	end
end

function People.apron(character, color)
	local torso = character:FindFirstChild("LowerTorso") or character:FindFirstChild("Torso")
	if not torso then
		return
	end
	weld(Kit.part(nil, Vector3.new(1.5, 1.6, 0.1), at(torso, CFrame.new(0, -0.6, -0.55)), color, M.fabric, { collide = false }), torso)
end

-- Applies a randomized look for a customer type
function People.dress(character, look, looks, r)
	local function pick(list)
		return list[r:NextInteger(1, #list)]
	end
	local hairColor = Color.hex(pick(looks.hair))
	People.hair(character, hairColor, r:NextInteger(1, 4))
	if look == "suit" then
		People.bag(character, "briefcase")
		if r:NextNumber() < 0.4 then
			People.glasses(character)
		end
	elseif look == "tourist" then
		People.hat(character, r:NextNumber() < 0.5 and "sunhat" or "bucket", Color.hex(pick(looks.shirts.tourist)))
		People.bag(character, r:NextNumber() < 0.6 and "camera" or "backpack", Color.hex(pick(looks.shirts.casual)))
	elseif look == "elder" then
		if r:NextNumber() < 0.6 then
			People.glasses(character, P.gold)
		end
		People.hat(character, "bucket", Color.hex(pick(looks.shirts.elder)))
	elseif look == "trendy" then
		People.glasses(character, P.black)
		People.bag(character, "scarf", Color.hex(pick(looks.shirts.trendy)))
	elseif look == "vip" then
		People.glasses(character, P.black)
		People.bag(character, "scarf", P.gold)
	else
		local roll = r:NextNumber()
		if roll < 0.3 then
			People.hat(character, "cap", Color.hex(pick(looks.shirts.casual)))
		elseif roll < 0.55 then
			People.bag(character, "backpack", Color.hex(pick(looks.shirts.casual)))
		end
	end
end

return function(Registry)
	Registry.People = People
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000043"><Properties><string name="Name">RamenYa</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- "Ramen-ya" decoration pack, modelled on real ramen counters: industrial pendant lamps, a red
-- banner with white lettering, rows of menu posters, a retro ramen poster, a vertical sign, a
-- framed soup signboard, a wooden canopy over the counter, water pitchers, condiment caddies,
-- red vinyl stools and a wooden table with benches.
-- Conventions: front faces -Z; wall items have their back at +Z; ceiling items hang from y = h.
local CollectionService = game:GetService("CollectionService")

local Kit = require(script.Parent.Parent.Kit)
local P = require(script.Parent.Parent.Palette)
local Color = require(script.Parent.Parent.Parent.Util.Color)
local M = P.M

local JP_FONT = Font.new("rbxasset://fonts/families/FredokaOne.json", Enum.FontWeight.Bold)

local function size(item)
	return Vector3.new(item.size[1], item.size[2], item.size[3])
end

local function nc()
	return { collide = false, shadow = false }
end

local function point(root, name, x, y, z, yaw)
	local h = root.Size.Y
	return Kit.attach(root, name, CFrame.new(x, y - h / 2, z) * CFrame.Angles(0, math.rad(yaw or 0), 0))
end

-- Invisible panel carrying a text label. faces: nil = front (-Z), "back" = +Z, "both"
local function label(m, w, h, x, y, z, text, color, faces)
	local p = Kit.box(m, w, h, 0.02, x, y, z, P.white, M.smooth, { transparency = 1, collide = false, shadow = false })
	p.CanQuery = false
	if faces ~= "back" then
		Kit.text(p, Enum.NormalId.Front, text, { color = color, font = JP_FONT, pps = 40 })
	end
	if faces == "back" or faces == "both" then
		Kit.text(p, Enum.NormalId.Back, text, { color = color, font = JP_FONT, pps = 40 })
	end
	return p
end

-- Parts high under the ceiling hide in build view like the roof (see Camera.setRoofs)
local function high(p)
	CollectionService:AddTag(p, "Roof")
	return p
end

-- Industrial pendant: cord, black metal shade with a brass rim and a glowing glass globe
local function pendant(m, x, top, z, drop)
	high(Kit.cyl(m, 0.05, drop, x, top - drop / 2, z, P.black, M.fabric, nc()))
	local y = top - drop
	Kit.cyl(m, 0.18, 0.2, x, y - 0.05, z, P.charcoal, M.metal, nc())
	Kit.cyl(m, 0.72, 0.55, x, y - 0.4, z, P.charcoal, M.metal, { collide = false, shadow = false, reflectance = 0.1 })
	Kit.cyl(m, 0.76, 0.06, x, y - 0.68, z, P.brass, M.metal, nc())
	local bulb = Kit.ball(m, 0.62, x, y - 0.95, z, P.lamp, M.neon, { collide = false, shadow = false })
	bulb.Transparency = 0.1
	Kit.light(bulb, "Point", P.lamp_warm, 14, 1.2)
	return bulb
end

-- Hanging banner made of split cloth panels with lettering readable from both sides
local function banner(m, w, top, bottom, z, text, color)
	local n = math.max(2, math.floor(w / 1))
	local pw = w / n
	for i = 0, n - 1 do
		local x = -w / 2 + pw * (i + 0.5)
		local cloth = Kit.box(m, pw - 0.06, top - bottom, 0.04, x, (top + bottom) / 2, z, color, M.fabric, nc())
		cloth:SetAttribute("Animate", "sway")
		Kit.box(m, pw - 0.06, 0.1, 0.05, x, bottom + 0.12, z, P.lacquer_dark, M.fabric, nc())
	end
	Kit.box(m, w, 0.06, 0.05, 0, top - 0.12, z, P.white, M.fabric, nc())
	label(m, w - 0.4, (top - bottom) * 0.62, 0, (top + bottom) / 2 + 0.02, z - 0.04, text, "#FFFFFF", "both")
end

-- Bowl drawn flat (ellipses facing -Z): navy bowl, broth, noodles, egg, naruto and nori
local function bowlArt(m, x, y, z, s, broth)
	Kit.blob(m, 1.6 * s, 1.0 * s, 0.04, x, y, z, P.navy, M.smooth, nc())
	Kit.blob(m, 1.5 * s, 0.42 * s, 0.04, x, y + 0.27 * s, z - 0.02, broth or Color.hex("#D9A55A"), M.smooth, nc())
	for k = -2, 2 do
		Kit.box(m, 0.05 * s, 0.22 * s, 0.03, x + k * 0.12 * s, y + 0.3 * s, z - 0.04, P.neon_yellow, M.smooth, nc())
	end
	Kit.blob(m, 0.32 * s, 0.24 * s, 0.03, x - 0.4 * s, y + 0.3 * s, z - 0.05, P.white, M.smooth, nc())
	Kit.blob(m, 0.16 * s, 0.12 * s, 0.03, x - 0.4 * s, y + 0.3 * s, z - 0.06, P.koi_orange, M.smooth, nc())
	Kit.blob(m, 0.24 * s, 0.18 * s, 0.03, x + 0.42 * s, y + 0.3 * s, z - 0.05, P.white, M.smooth, nc())
	Kit.blob(m, 0.1 * s, 0.08 * s, 0.03, x + 0.42 * s, y + 0.3 * s, z - 0.06, P.sakura_dark, M.smooth, nc())
	Kit.box(m, 0.3 * s, 0.4 * s, 0.03, x + 0.62 * s, y + 0.5 * s, z - 0.03, P.nori, M.smooth, nc())
	-- chopsticks lifting noodles
	for k = 0, 1 do
		local cf = CFrame.new(x + (0.2 + k * 0.1) * s, y + 0.75 * s, z - 0.07) * CFrame.Angles(0, 0, math.rad(-28 - k * 6))
		Kit.part(m, Vector3.new(0.05 * s, 0.9 * s, 0.03), cf, P.wood_light, M.wood, nc())
	end
end

-- Row of colourful menu posters on a plane facing -Z (front face at z)
local POSTERS = {
	{ bg = "#FFD23B", text = "醤油", price = "¥780", broth = "#8A5A2E" },
	{ bg = "#F27A2E", text = "味噌", price = "¥850", broth = "#C88A3A" },
	{ bg = "#F7F5F0", text = "豚骨", price = "¥900", broth = "#EDE0C8" },
	{ bg = "#C0261E", text = "餃子", price = "¥450", broth = "#E3B070" },
	{ bg = "#FFD23B", text = "塩", price = "¥750", broth = "#EBD49A" },
	{ bg = "#F7F5F0", text = "炒飯", price = "¥600", broth = "#E8C25A" },
}

local function posterRow(m, x0, x1, y0, y1, z, count)
	local n = count or 5
	local pw = (x1 - x0) / n
	local ph = y1 - y0
	for i = 0, n - 1 do
		local info = POSTERS[i % #POSTERS + 1]
		local x = x0 + pw * (i + 0.5)
		local cy = (y0 + y1) / 2
		local bg = Color.hex(info.bg)
		Kit.box(m, pw - 0.08, ph, 0.03, x, cy, z + 0.015, bg, M.smooth, nc())
		-- photo of the dish
		Kit.box(m, pw - 0.3, ph * 0.42, 0.02, x, cy - ph * 0.02, z - 0.005, P.charcoal, M.smooth, nc())
		bowlArt(m, x, cy - ph * 0.06, z - 0.02, math.min(pw - 0.3, ph * 0.42) * 0.42, Color.hex(info.broth))
		local dark = info.bg == "#C0261E" or info.bg == "#F27A2E"
		label(m, pw - 0.2, ph * 0.26, x, y1 - ph * 0.16, z - 0.02, info.text, dark and "#FFFFFF" or "#C0261E")
		local tag = Kit.box(m, (pw - 0.08) * 0.62, ph * 0.16, 0.02, x, y0 + ph * 0.12, z - 0.01, dark and P.white or P.lacquer, M.smooth, nc())
		Kit.text(tag, Enum.NormalId.Front, info.price, { color = dark and "#C0261E" or "#FFFFFF", font = JP_FONT, pps = 40 })
		-- bits of tape on the top corners
		for _, sx in ipairs({ -1, 1 }) do
			Kit.box(m, 0.22, 0.08, 0.01, x + sx * (pw / 2 - 0.12), y1 - 0.04, z - 0.01, P.paper_warm, M.smooth, { collide = false, shadow = false, rot = CFrame.Angles(0, 0, math.rad(sx * 35)), transparency = 0.2 })
		end
	end
end

-- Small stainless water pitcher with a lid and a handle; bottom center at (x, y0, z)
local function pitcher(m, x, y0, z, s)
	s = s or 1
	Kit.cyl(m, 0.58 * s, 0.95 * s, x, y0 + 0.5 * s, z, P.metal, M.metal, { collide = false, reflectance = 0.25 })
	Kit.cyl(m, 0.62 * s, 0.06 * s, x, y0 + 0.04 * s, z, P.steel, M.metal, nc())
	Kit.cyl(m, 0.6 * s, 0.1 * s, x, y0 + 1.02 * s, z, P.steel, M.metal, nc())
	Kit.ball(m, 0.14 * s, x, y0 + 1.12 * s, z, P.charcoal, M.smooth, nc())
	Kit.wedge(m, 0.16 * s, 0.22 * s, 0.24 * s, CFrame.new(x, y0 + 0.92 * s, z - 0.36 * s), P.metal, M.metal, nc())
	for _, hy in ipairs({ 0.85, 0.3 }) do
		Kit.box(m, 0.08 * s, 0.07 * s, 0.26 * s, x, y0 + hy * s, z + 0.4 * s, P.metal, M.metal, nc())
	end
	Kit.box(m, 0.08 * s, 0.62 * s, 0.07 * s, x, y0 + 0.575 * s, z + 0.5 * s, P.metal, M.metal, nc())
end

return function(Registry)
	-- Lighting ------------------------------------------------------------------------------------
	Registry.register("pendant_lamp", function(m, item)
		Kit.finish(m, size(item))
		local h = item.size[2]
		pendant(m, 0, h, 0, h - 1.7)
		high(Kit.cyl(m, 0.4, 0.08, 0, h - 0.04, 0, P.charcoal, M.metal, nc()))
	end)

	Registry.register("chochin_orange", function(m, item)
		Kit.finish(m, size(item))
		local h = item.size[2]
		local bodyH, bodyD = 1.5, 1.15
		local cy = h - 0.6 - bodyH / 2
		high(Kit.cyl(m, 0.05, 0.6, 0, h - 0.3, 0, P.black, M.fabric, nc()))
		Kit.cyl(m, 0.7, 0.18, 0, cy + bodyH / 2 + 0.05, 0, P.black, M.smooth, nc())
		Kit.cyl(m, 0.7, 0.18, 0, cy - bodyH / 2 - 0.05, 0, P.black, M.smooth, nc())
		local body = Kit.blob(m, bodyD, bodyH, bodyD, 0, cy, 0, P.koi_orange, M.smooth, nc())
		for i = -2, 2 do
			local ring = 1 - (i * 0.18) ^ 2 * 1.2
			Kit.cyl(m, bodyD * ring + 0.02, 0.03, 0, cy + i * bodyH * 0.18, 0, P.vermilion, M.smooth, nc())
		end
		label(m, bodyD * 0.55, bodyH * 0.8, 0, cy, -bodyD / 2 - 0.01, "ラーメン", "#141414")
		label(m, bodyD * 0.55, bodyH * 0.8, 0, cy, bodyD / 2 + 0.01, "らーめん", "#141414", "back")
		Kit.light(body, "Point", P.lamp_warm, 12, 1.2)
		body:SetAttribute("Animate", "sway")
	end)

	-- Wooden canopy over the counter: hanging rods, frame, ribbed metal roof, red banner and
	-- three pendant lamps (the centrepiece of the ramen-ya look)
	Registry.register("ramenya_canopy", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		local frameY = h - 2.0
		for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }) do
			high(Kit.box(m, 0.1, 2.0, 0.1, c[1] * (w / 2 - 0.3), h - 1.0, c[2] * (d / 2 - 0.3), P.black, M.metal, nc()))
		end
		-- ribbed roof sheet sloping towards the customers
		local roof = Kit.box(m, w, 0.08, d, 0, frameY + 0.32, 0, P.steel, M.metal, { collide = false, rot = CFrame.Angles(math.rad(-6), 0, 0) })
		high(roof)
		for x = -w / 2 + 0.25, w / 2 - 0.2, 0.5 do
			high(Kit.box(m, 0.1, 0.08, d, x, frameY + 0.38, 0, P.metal, M.metal, { collide = false, shadow = false, rot = CFrame.Angles(math.rad(-6), 0, 0) }))
		end
		-- timber frame
		for _, z in ipairs({ -d / 2 + 0.15, d / 2 - 0.15 }) do
			high(Kit.box(m, w, 0.4, 0.3, 0, frameY, z, P.wood_dark, M.wood, nc()))
		end
		for _, x in ipairs({ -w / 2 + 0.15, 0, w / 2 - 0.15 }) do
			high(Kit.box(m, 0.25, 0.3, d - 0.3, x, frameY + 0.05, 0, P.wood_dark, M.wood, nc()))
		end
		Kit.box(m, w + 0.1, 0.12, 0.08, 0, frameY - 0.25, -d / 2 + 0.02, P.wood_black, M.wood, nc())
		-- red banner along the customer side and three pendant lamps
		banner(m, w - 0.2, frameY - 0.3, frameY - 1.3, -d / 2 + 0.1, "ラーメン ・ 餃子 ・ 炒飯", P.lacquer)
		for _, x in ipairs({ -w / 3, 0, w / 3 }) do
			pendant(m, x, frameY - 0.2, 0.35, 0.7)
		end
	end)

	-- Art & walls ---------------------------------------------------------------------------------
	Registry.register("noren_banner", function(m, item)
		Kit.finish(m, size(item))
		local w, h = item.size[1], item.size[2]
		high(Kit.cylH(m, 0.12, w + 0.2, 0, h - 0.12, 0, P.wood_dark, M.wood, nc()))
		for _, x in ipairs({ -w / 2 + 0.4, w / 2 - 0.4 }) do
			high(Kit.box(m, 0.06, 0.12, 0.06, x, h - 0.03, 0, P.black, M.metal, nc()))
		end
		banner(m, w, h - 0.18, 0.05, 0, "ラーメン ・ 餃子 ・ 炒飯", P.lacquer)
		-- round shop crest in the middle
		Kit.cylH(m, 0.9, 0.06, 0, h * 0.5, -0.06, P.white, M.fabric, nc(), "z")
		label(m, 0.7, 0.7, 0, h * 0.5, -0.1, "麺", "#B3262E")
	end)

	Registry.register("menu_posters", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		posterRow(m, -w / 2 + 0.1, w / 2 - 0.1, 0.1, h - 0.1, d / 2 - 0.06, 5)
	end)

	Registry.register("ramen_poster", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		local z = d / 2 - 0.04
		Kit.box(m, w, h, 0.05, 0, h / 2, z, P.cream, M.smooth, nc())
		Kit.box(m, w - 0.3, h - 0.3, 0.03, 0, h / 2, z - 0.04, P.lacquer, M.smooth, nc())
		label(m, w - 0.5, 0.7, 0, h - 0.6, z - 0.07, "ラーメン", "#FFF3E0")
		bowlArt(m, 0, h * 0.42, z - 0.07, 0.85)
		-- steam
		for k = -1, 1 do
			for j = 0, 2 do
				Kit.box(m, 0.05, 0.22, 0.02, k * 0.3 + (j % 2) * 0.06, h * 0.42 + 0.75 + j * 0.2, z - 0.07, P.white, M.smooth, { collide = false, shadow = false, rot = CFrame.Angles(0, 0, math.rad((j % 2 == 0) and 20 or -20)), transparency = 0.2 })
			end
		end
		Kit.cylH(m, 0.7, 0.03, w / 2 - 0.55, 0.6, z - 0.07, P.white, M.smooth, nc(), "z")
		label(m, 0.5, 0.5, w / 2 - 0.55, 0.6, z - 0.1, "開店", "#C0261E")
		label(m, w - 1.4, 0.35, -0.35, 0.55, z - 0.07, "since 1987", "#FFF3E0")
	end)

	Registry.register("ramen_sign_vertical", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		local z = d / 2 - 0.08
		Kit.box(m, w, h - 0.5, 0.15, 0, (h - 0.5) / 2, z, P.lacquer, M.smooth, nc())
		for _, x in ipairs({ -w / 2 + 0.12, w / 2 - 0.12 }) do
			Kit.box(m, 0.06, h - 0.8, 0.02, x, (h - 0.5) / 2, z - 0.085, P.cream, M.smooth, nc())
		end
		label(m, w - 0.4, h - 1.2, 0, (h - 0.5) / 2, z - 0.09, "ラ\nー\nメ\nン", "#FFFFFF")
		-- little tiled cap and a lamp arm lighting the sign
		Kit.wedge(m, w + 0.3, 0.35, 0.4, CFrame.new(0, h - 0.33, z - 0.05), P.tile, M.roof, nc())
		Kit.box(m, 0.08, 0.08, 0.6, 0, h - 0.1, z - 0.35, P.black, M.metal, nc())
		local head = Kit.box(m, 0.4, 0.2, 0.25, 0, h - 0.18, z - 0.65, P.charcoal, M.metal, nc())
		Kit.light(head, "Spot", P.lamp_warm, 8, 1.4, { face = Enum.NormalId.Bottom, angle = 70 })
	end)

	Registry.register("soup_sign", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		local z = d / 2 - 0.1
		Kit.box(m, w, h, 0.2, 0, h / 2, z, P.wood_dark, M.wood, nc())
		Kit.box(m, w - 0.4, h - 0.4, 0.04, 0, h / 2, z - 0.12, P.paper_warm, M.smooth, nc())
		label(m, w * 0.55, h * 0.55, w * 0.12, h * 0.48, z - 0.15, "秘伝スープ", "#C0261E")
		label(m, w * 0.22, h * 0.7, -w / 2 + w * 0.15, h / 2, z - 0.15, "当店\n自慢", "#2B2320")
		Kit.cylH(m, 0.8, 0.03, w / 2 - 0.65, h - 0.6, z - 0.15, P.lacquer, M.smooth, nc(), "z")
		label(m, 0.6, 0.6, w / 2 - 0.65, h - 0.6, z - 0.18, "極", "#FFFFFF")
		label(m, w * 0.5, h * 0.18, w * 0.12, 0.45, z - 0.15, "豚骨 ・ 鶏ガラ ・ 魚介", "#2B2320")
		-- two small spotlights above
		for _, x in ipairs({ -w / 4, w / 4 }) do
			Kit.box(m, 0.08, 0.08, 0.5, x, h - 0.05, z - 0.3, P.black, M.metal, nc())
			local head = Kit.cyl(m, 0.3, 0.3, x, h - 0.1, z - 0.55, P.charcoal, M.metal, nc())
			Kit.light(head, "Spot", P.lamp_warm, 8, 1.2, { face = Enum.NormalId.Bottom, angle = 80 })
		end
	end)

	-- On the table (top items) ------------------------------------------------------------------------
	Registry.register("water_pitcher", function(m, item)
		Kit.finish(m, size(item))
		pitcher(m, 0, 0, 0, 1)
		-- two stacked glasses beside it
		for k = 0, 1 do
			Kit.cyl(m, 0.26, 0.3, 0.3, 0.15 + k * 0.08, -0.25, P.glass, M.glass, { collide = false, shadow = false, transparency = 0.35 })
		end
	end)

	Registry.register("condiment_caddy", function(m, item)
		Kit.finish(m, size(item))
		Kit.box(m, 1.5, 0.08, 0.6, 0, 0.04, 0, P.steel, M.metal, { reflectance = 0.1 })
		-- chopstick holder with a bundle of waribashi
		Kit.cyl(m, 0.36, 0.6, -0.5, 0.38, 0, P.koi_orange, M.smooth, nc())
		for k = 0, 5 do
			local a = k * math.pi / 3
			Kit.box(m, 0.04, 0.9, 0.04, -0.5 + math.cos(a) * 0.08, 0.6, math.sin(a) * 0.08, P.hinoki, M.wood, { collide = false, shadow = false, rot = CFrame.Angles(math.sin(a) * 0.06, 0, -math.cos(a) * 0.06) })
		end
		-- jars with red lids: garlic, chili oil
		for i, c in ipairs({ P.cream, P.vermilion }) do
			local x = -0.1 + (i - 1) * 0.32
			Kit.cyl(m, 0.28, 0.32, x, 0.24, 0.08, P.glass, M.glass, { collide = false, shadow = false, transparency = 0.3 })
			Kit.cyl(m, 0.24, 0.2, x, 0.19, 0.08, c, M.sand, nc())
			Kit.cyl(m, 0.3, 0.08, x, 0.44, 0.08, P.red, M.smooth, nc())
		end
		-- pepper can and tissue box
		Kit.cyl(m, 0.22, 0.45, 0.58, 0.31, 0.12, P.navy, M.metal, nc())
		Kit.cyl(m, 0.23, 0.05, 0.58, 0.55, 0.12, P.metal, M.metal, nc())
		Kit.box(m, 0.36, 0.28, 0.26, 0.5, 0.22, -0.16, P.white, M.smooth, nc())
		Kit.box(m, 0.14, 0.1, 0.12, 0.5, 0.4, -0.16, P.white, M.fabric, nc())
	end)

	Registry.register("counter_posters", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		-- stainless pass shelf: front panel with menu posters, top shelf with pitchers
		Kit.box(m, w, h - 0.1, 0.06, 0, (h - 0.1) / 2, -d / 2 + 0.03, P.steel_dark, M.metal)
		Kit.box(m, w, 0.08, d, 0, h - 0.04, 0, P.metal, M.metal, { reflectance = 0.2 })
		for _, x in ipairs({ -w / 2 + 0.05, w / 2 - 0.05 }) do
			Kit.box(m, 0.08, h - 0.1, d - 0.06, x, (h - 0.1) / 2, 0.03, P.steel, M.metal, nc())
		end
		posterRow(m, -w / 2 + 0.1, w / 2 - 0.1, 0.12, h - 0.18, -d / 2 - 0.01, 5)
		pitcher(m, -w / 2 + 0.6, h, 0, 0.7)
		pitcher(m, w / 2 - 0.6, h, 0, 0.7)
	end)

	-- Seating -------------------------------------------------------------------------------------
	Registry.register("stool_red", function(m, item)
		local root = Kit.finish(m, size(item))
		local h = item.size[2]
		Kit.cyl(m, 1.3, 0.1, 0, 0.05, 0, P.black, M.metal)
		Kit.cyl(m, 0.24, h - 0.5, 0, (h - 0.5) / 2 + 0.05, 0, P.black, M.metal, { reflectance = 0.1 })
		Kit.cyl(m, 1.0, 0.06, 0, 0.95, 0, P.black, M.metal, nc())
		Kit.cyl(m, 1.1, 0.1, 0, h - 0.5, 0, P.charcoal, M.metal, nc())
		Kit.cyl(m, 1.55, 0.4, 0, h - 0.22, 0, P.lacquer, M.smooth, { reflectance = 0.08 })
		Kit.blob(m, 1.5, 0.22, 1.5, 0, h - 0.02, 0, P.lacquer, M.smooth, { collide = false, reflectance = 0.08 })
		Kit.cyl(m, 1.58, 0.05, 0, h - 0.4, 0, P.lacquer_dark, M.smooth, nc())
		point(root, "SitPoint", 0, h, 0, 0)
	end)

	-- Wooden table with two benches (works like a booth: four seats with their own dish spots)
	Registry.register("bench_table", function(m, item)
		local root = Kit.finish(m, size(item))
		local w = item.size[1]
		-- trestle table
		Kit.box(m, w - 0.6, 0.2, 2, 0, 2.6, 0, P.wood, M.wood)
		Kit.box(m, w - 0.5, 0.06, 2.1, 0, 2.48, 0, P.wood_dark, M.wood, nc())
		for _, x in ipairs({ -w / 2 + 0.9, w / 2 - 0.9 }) do
			Kit.box(m, 0.3, 2.4, 0.3, x, 1.3, 0, P.wood_dark, M.wood)
			Kit.box(m, 0.3, 0.2, 1.6, x, 0.1, 0, P.wood_dark, M.wood)
			Kit.box(m, 0.25, 0.2, 1.6, x, 2.38, 0, P.wood_dark, M.wood, nc())
		end
		Kit.box(m, w - 1.8, 0.2, 0.2, 0, 0.9, 0, P.wood_dark, M.wood, nc())
		-- benches
		local df = Kit.detail(m, "furnish")
		for side = -1, 1, 2 do
			local z = side * 1.85
			Kit.box(m, w - 0.4, 0.2, 1.0, 0, 1.8, z, P.wood, M.wood)
			for _, x in ipairs({ -w / 2 + 0.6, w / 2 - 0.6 }) do
				Kit.box(m, 0.25, 1.7, 0.8, x, 0.85, z, P.wood_dark, M.wood)
			end
			Kit.box(m, w - 1.4, 0.15, 0.15, 0, 0.6, z, P.wood_dark, M.wood, nc())
			for _, x in ipairs({ -1.2, 1.2 }) do
				Kit.box(df, 1.3, 0.12, 0.85, x, 1.96, z, side < 0 and P.indigo or P.lacquer, M.fabric, nc())
			end
		end
		local dt = Kit.detail(m, "tableware")
		pitcher(dt, -0.4, 2.7, 0, 0.6)
		Kit.box(dt, 0.8, 0.06, 0.4, 0.4, 2.73, 0, P.steel, M.metal, nc())
		Kit.cyl(dt, 0.24, 0.45, 0.2, 2.95, 0, P.koi_orange, M.smooth, nc())
		Kit.cyl(dt, 0.2, 0.3, 0.55, 2.9, 0, P.red, M.smooth, nc())
		local i = 0
		for side = -1, 1, 2 do
			for _, x in ipairs({ -1.2, 1.2 }) do
				i += 1
				point(root, "Seat" .. i, x, 1.9, side * 1.85, side < 0 and 180 or 0)
				point(root, "Dish" .. i, x, 2.7, side * 0.55, 0)
			end
		end
		root:SetAttribute("TopY", 2.7)
	end)
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000044"><Properties><string name="Name">Street</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Street scenery: road, sidewalks, neighbour buildings, lamps, poles, trees, viaduct, truck, train.
local Kit = require(script.Parent.Parent.Kit)
local P = require(script.Parent.Parent.Palette)
local Color = require(script.Parent.Parent.Parent.Util.Color)
local M = P.M

local JP_FONT = Font.new("rbxasset://fonts/families/FredokaOne.json", Enum.FontWeight.Bold)
local S = {}

local SIGNS = { "居酒屋", "本屋", "薬局", "喫茶", "花屋", "銭湯", "焼鳥", "古着", "時計", "果物", "団子", "書道" }

local function rng(seed)
	return Random.new(seed or 7)
end

local function NC()
	return { collide = false, shadow = false }
end

-- Outdoor AC unit with a round fan grille, mounted on the wall
local function acUnit(parent, x, y, face, facing)
	local z = face - facing * 0.4
	Kit.box(parent, 1.6, 1.1, 0.7, x, y, z, P.stone_light, M.smooth, NC())
	Kit.cylH(parent, 0.8, 0.04, x - 0.25, y, z - facing * 0.36, P.steel_dark, M.metal, NC(), "z")
	Kit.cylH(parent, 0.2, 0.05, x - 0.25, y, z - facing * 0.38, P.metal, M.metal, NC(), "z")
	Kit.box(parent, 1.4, 0.08, 0.6, x, y - 0.6, z + facing * 0.05, P.steel_dark, M.metal, NC())
	Kit.cyl(parent, 0.12, 1.2, x + 0.6, y + 0.9, face - facing * 0.15, P.white, M.smooth, NC())
end

-- Apartment balcony: slab, frosted panel railing and (sometimes) laundry on a pole
local function balcony(parent, x, y, face, facing, r)
	local z = face - facing * 0.7
	Kit.box(parent, 3.6, 0.2, 1.4, x, y - 1.55, z, P.stone_light, M.concrete, NC())
	local panel = Kit.box(parent, 3.6, 1.2, 0.08, x, y - 0.85, face - facing * 1.38, P.metal, M.glass, NC())
	panel.Transparency = 0.35
	Kit.box(parent, 3.7, 0.1, 0.14, x, y - 0.22, face - facing * 1.38, P.steel_dark, M.metal, NC())
	if r:NextNumber() < 0.6 then
		Kit.cylH(parent, 0.08, 3.2, x, y + 0.9, face - facing * 0.9, P.metal, M.metal, NC())
		local colors = { P.white, P.sakura, P.navy, P.leaf_light, P.neon_yellow, P.indigo }
		for k = 0, r:NextInteger(1, 3) do
			local c = colors[r:NextInteger(1, #colors)]
			local cw = 0.6 + r:NextNumber() * 0.5
			Kit.box(parent, cw, 0.8 + r:NextNumber() * 0.4, 0.05, x - 1.2 + k * 0.85, y + 0.45, face - facing * 0.9, c, M.fabric, NC())
		end
	end
end

-- Chalkboard A-frame sign on the sidewalk
local function aframe(parent, x, z, facing)
	Kit.box(parent, 1.1, 1.6, 0.08, x, 0.4, z - facing * 0.25, P.wood_dark, M.wood, { collide = false, shadow = false, rot = CFrame.Angles(math.rad(12), 0, 0) })
	Kit.box(parent, 0.9, 1.2, 0.04, x, 0.45, z - facing * 0.32, P.charcoal, M.slate, { collide = false, shadow = false, rot = CFrame.Angles(math.rad(12), 0, 0) })
	Kit.box(parent, 1.1, 1.6, 0.08, x, 0.4, z + facing * 0.25, P.wood_dark, M.wood, { collide = false, shadow = false, rot = CFrame.Angles(math.rad(-12), 0, 0) })
end

-- Part placed in the local frame of `base`
local function lp(parent, base, sx, sy, sz, lx, ly, lz, rot, color, mat, props)
	local cf = base * CFrame.new(lx, ly, lz)
	if rot then
		cf = cf * rot
	end
	return Kit.part(parent, Vector3.new(sx, sy, sz), cf, color, mat, props)
end

-- Japanese city bicycle (mamachari) with a front basket; yaw in degrees, ground at -0.4
function S.bicycle(parent, x, z, yaw, color)
	local base = CFrame.new(x, -0.4, z) * CFrame.Angles(0, math.rad(yaw or 0), 0)
	local wheel = CFrame.Angles(0, math.rad(90), 0)
	for _, wx in ipairs({ -1.1, 1.1 }) do
		lp(parent, base, 0.12, 1.7, 1.7, wx, 0.85, 0, wheel, P.charcoal, M.smooth, { collide = false, shadow = false, shape = Enum.PartType.Cylinder })
		lp(parent, base, 0.13, 1.3, 1.3, wx, 0.85, 0, wheel, P.metal, M.metal, { collide = false, shadow = false, shape = Enum.PartType.Cylinder })
	end
	lp(parent, base, 1.4, 0.12, 0.12, -0.35, 1.25, 0, CFrame.Angles(0, 0, math.rad(-35)), color, M.metal, NC())
	lp(parent, base, 1.3, 0.12, 0.12, 0.3, 1.1, 0, CFrame.Angles(0, 0, math.rad(20)), color, M.metal, NC())
	lp(parent, base, 0.12, 1.2, 0.12, -0.45, 1.4, 0, CFrame.Angles(0, 0, math.rad(-15)), color, M.metal, NC())
	lp(parent, base, 0.7, 0.18, 0.35, -0.6, 2.05, 0, nil, P.charcoal, M.leather, NC())
	lp(parent, base, 0.12, 1.1, 0.12, 0.95, 1.5, 0, CFrame.Angles(0, 0, math.rad(15)), color, M.metal, NC())
	lp(parent, base, 0.1, 0.1, 1.2, 0.85, 2.05, 0, nil, P.metal, M.metal, NC())
	lp(parent, base, 0.7, 0.5, 0.8, 1.4, 1.75, 0, nil, P.metal, M.metal, { collide = false, shadow = false, transparency = 0.3 })
	lp(parent, base, 0.9, 0.06, 0.6, -1.1, 1.75, 0, nil, P.metal, M.metal, NC())
	lp(parent, base, 0.6, 0.6, 0.06, -0.9, 0.5, 0.2, nil, color, M.metal, NC())
end

-- Round-topped red post box
function S.postBox(parent, x, z)
	Kit.box(parent, 0.5, 1.6, 0.5, x, 0.4, z, P.charcoal, M.metal)
	Kit.box(parent, 1.4, 2.0, 1.1, x, 2.2, z, P.red, M.metal)
	Kit.cylH(parent, 1.1, 1.4, x, 3.2, z, P.red, M.metal, NC(), "z")
	Kit.box(parent, 1.0, 0.12, 0.06, x, 2.8, z - 0.56, P.charcoal, M.metal, NC())
	local plate = Kit.box(parent, 0.6, 0.5, 0.04, x, 2.1, z - 0.57, P.white, M.smooth, NC())
	Kit.text(plate, Enum.NormalId.Front, "〒", { color = "#C0261E", font = JP_FONT })
end

-- Pair of recycling bins next to a vending machine
function S.bins(parent, x, z)
	for k, c in ipairs({ P.indigo, P.matcha }) do
		local bx = x + (k - 1.5) * 1.1
		Kit.box(parent, 1, 1.8, 1, bx, 0.5, z, c, M.plastic, NC())
		Kit.box(parent, 1.05, 0.15, 1.05, bx, 1.45, z, P.white, M.plastic, NC())
		Kit.cyl(parent, 0.4, 0.05, bx, 1.53, z, P.charcoal, M.smooth, NC())
	end
end

-- Round traffic sign on a pole (kind = "walk" blue, "stop" red triangle)
function S.trafficSign(parent, x, z, kind)
	Kit.cyl(parent, 0.18, 7, x, 3.1, z, P.metal, M.metal)
	if kind == "stop" then
		local tri = Kit.wedge(parent, 0.08, 1.6, 0.9, CFrame.new(x, 6.2, z - 0.45) * CFrame.Angles(0, math.rad(90), 0), P.red, M.smooth, NC())
		local _ = tri
		Kit.wedge(parent, 0.08, 1.6, 0.9, CFrame.new(x, 6.2, z + 0.45) * CFrame.Angles(0, math.rad(-90), 0), P.red, M.smooth, NC())
		local plate = Kit.box(parent, 1.4, 0.5, 0.06, x, 5.1, z, P.white, M.smooth, NC())
		Kit.text(plate, Enum.NormalId.Back, "止まれ", { color = "#C0261E", font = JP_FONT })
	else
		Kit.box(parent, 1.4, 1.4, 0.08, x, 6, z, P.navy, M.smooth, NC())
		Kit.wedge(parent, 0.04, 0.9, 0.5, CFrame.new(x - 0.25, 6, z - 0.06) * CFrame.Angles(0, math.rad(90), 0), P.white, M.smooth, NC())
		Kit.wedge(parent, 0.04, 0.9, 0.5, CFrame.new(x + 0.25, 6, z - 0.06) * CFrame.Angles(0, math.rad(-90), 0), P.white, M.smooth, NC())
	end
end

-- Manhole cover, optionally steaming
function S.manhole(parent, x, y, z, steam)
	local m = Kit.cyl(parent, 2, 0.06, x, y, z, P.stone_dark, M.metal, NC())
	Kit.cyl(parent, 1.6, 0.07, x, y, z, P.steel_dark, M.metal, NC())
	Kit.cyl(parent, 0.7, 0.08, x, y, z, P.stone_dark, M.metal, NC())
	if steam then
		Kit.particles(m, "steam", { rate = 3 })
	end
end

-- Zebra crossing across the road (road along X, centered on z), with stop lines
function S.crosswalk(parent, x, y, z, roadWidth)
	local n = math.floor(roadWidth / 1.6)
	for i = 0, n - 1 do
		Kit.box(parent, 4, 0.04, 0.8, x, y, z - roadWidth / 2 + 0.8 + i * 1.6, P.road_line, M.smooth, NC())
	end
	Kit.box(parent, 0.4, 0.04, roadWidth / 2 - 0.4, x - 4, y, z + roadWidth / 4, P.road_line, M.smooth, NC())
	Kit.box(parent, 0.4, 0.04, roadWidth / 2 - 0.4, x + 4, y, z - roadWidth / 4, P.road_line, M.smooth, NC())
	local word = Kit.box(parent, 3.2, 0.04, 1.6, x - 6.5, y, z + roadWidth / 4, P.road, M.asphalt, NC())
	word.Transparency = 1
	Kit.text(word, Enum.NormalId.Top, "止まれ", { color = "#E8E4D8", font = JP_FONT, rotation = 90 })
end

-- Facade block with windows and an optional shop front
function S.building(parent, x0, x1, zFront, depth, height, facing, color, r)
	local w = x1 - x0
	local cx = (x0 + x1) / 2
	local cz = zFront + facing * depth / 2
	local body = Kit.box(parent, w, height, depth, cx, -0.4 + height / 2, cz, color, M.plaster, { collide = true })
	body.CastShadow = true
	local face = zFront - facing * 0.05
	-- shop front at street level
	local awning = ({ P.lacquer, P.indigo, P.matcha, P.wood_dark, P.navy })[r:NextInteger(1, 5)]
	Kit.box(parent, w - 1, 4.2, 0.2, cx, 2.1 - 0.4, face, P.wood_dark, M.wood, { collide = false })
	local glass = Kit.box(parent, w - 2, 3.4, 0.1, cx, 2.0 - 0.4, face - facing * 0.12, P.paper_warm, M.neon, { collide = false })
	glass.Transparency = 0.3
	-- sash mullions, a short noren over the door and something on the sidewalk
	local panes = math.max(2, math.floor((w - 2) / 2.2))
	for i = 1, panes - 1 do
		Kit.box(parent, 0.12, 3.4, 0.14, x0 + 1 + (w - 2) * i / panes, 1.6, face - facing * 0.16, P.wood_dark, M.wood, NC())
	end
	Kit.box(parent, w - 2, 0.12, 0.14, cx, 2.4, face - facing * 0.16, P.wood_dark, M.wood, NC())
	for k = -1, 1 do
		Kit.box(parent, 0.95, 1.3, 0.05, cx + k * 1.0, 2.75, face - facing * 0.3, awning, M.fabric, NC())
	end
	Kit.cylH(parent, 0.1, 3.4, cx, 3.45, face - facing * 0.3, P.wood_dark, M.wood, NC())
	local extra = r:NextNumber()
	if extra < 0.3 then
		aframe(parent, cx + w / 2 - 1.6, face - facing * 1.6, facing)
	elseif extra < 0.55 then
		Kit.cyl(parent, 1.2, 1.1, cx - w / 2 + 1.4, 0.15, face - facing * 0.9, P.stone_dark, M.concrete, NC())
		Kit.ball(parent, 1.6, cx - w / 2 + 1.4, 1.3, face - facing * 0.9, P.leaf, M.leafy, NC())
	elseif extra < 0.75 then
		S.bicycle(parent, cx - w / 2 + 2.2, face - facing * 1.3, facing < 0 and 0 or 180, ({ P.white, P.navy, P.lacquer, P.matcha })[r:NextInteger(1, 4)])
	end
	Kit.wedge(parent, w - 0.5, 0.8, 1.6, CFrame.new(cx, 4.8 - 0.4, face - facing * 0.8) * CFrame.Angles(0, math.rad(facing < 0 and 180 or 0), 0), awning, M.fabric, { collide = false })
	local shopSign = Kit.box(parent, math.min(w - 2, 6), 1.1, 0.15, cx, 5.8 - 0.4, face - facing * 0.15, P.paper, M.smooth, { collide = false })
	Kit.text(shopSign, facing < 0 and Enum.NormalId.Back or Enum.NormalId.Front, SIGNS[r:NextInteger(1, #SIGNS)], { color = "#2B2320", font = JP_FONT })
	-- upper floor windows (lit at night)
	local floors = math.floor((height - 7) / 5)
	for f = 0, floors - 1 do
		local y = 9 + f * 5 - 0.4
		local n = math.max(1, math.floor(w / 5))
		for i = 0, n - 1 do
			local x = x0 + w / n * (i + 0.5)
			local lit = r:NextNumber() < 0.55
			Kit.box(parent, 2.7, 2.9, 0.08, x, y, face - facing * 0.03, P.charcoal, M.metal, NC())
			local win = Kit.box(parent, 2.4, 2.6, 0.1, x, y, face - facing * 0.06, lit and P.lamp or P.steel_dark, lit and M.neon or M.glass, { collide = false, shadow = false })
			if lit then
				win.Transparency = 0.25
			end
			Kit.box(parent, 0.08, 2.6, 0.12, x, y, face - facing * 0.1, P.charcoal, M.metal, NC())
			Kit.box(parent, 2.8, 0.25, 0.4, x, y - 1.45, face - facing * 0.2, P.wood_dark, M.wood, { collide = false })
			local roll = r:NextNumber()
			if roll < 0.3 then
				balcony(parent, x, y, face, facing, r)
			elseif roll < 0.5 then
				acUnit(parent, x + 2, y - 0.9, face, facing)
			elseif roll < 0.62 then
				-- flower pots on the sill
				for k = -1, 1 do
					Kit.box(parent, 0.4, 0.35, 0.3, x + k * 0.7, y - 1.15, face - facing * 0.25, P.vermilion, M.smooth, NC())
					Kit.ball(parent, 0.5, x + k * 0.7, y - 0.85, face - facing * 0.25, k == 0 and P.sakura or P.leaf, M.leafy, NC())
				end
			end
		end
	end
	-- drain pipe and roof furniture
	Kit.cyl(parent, 0.3, height - 0.5, x1 - 0.35, height / 2 - 0.4, face - facing * 0.2, P.stone_dark, M.metal, NC())
	local roofY = height - 0.4 + 0.6
	local roof = r:NextNumber()
	if roof < 0.35 then
		-- water tank on legs
		local tx, tz = cx - w / 4, cz
		for _, c in ipairs({ { -0.8, -0.8 }, { 0.8, -0.8 }, { 0.8, 0.8 }, { -0.8, 0.8 } }) do
			Kit.box(parent, 0.2, 1.4, 0.2, tx + c[1], roofY + 0.7, tz + c[2], P.steel_dark, M.metal, NC())
		end
		Kit.cyl(parent, 2.4, 2.4, tx, roofY + 2.6, tz, P.stone_light, M.concrete, NC())
		Kit.cyl(parent, 2.5, 0.2, tx, roofY + 3.9, tz, P.steel, M.metal, NC())
	elseif roof < 0.6 then
		-- antenna and a couple of AC units
		Kit.cyl(parent, 0.12, 4, cx + w / 4, roofY + 2, cz, P.metal, M.metal, NC())
		for k = 0, 2 do
			Kit.cylH(parent, 0.08, 1.6 - k * 0.4, cx + w / 4, roofY + 2.5 + k * 0.6, cz, P.metal, M.metal, NC())
		end
		for k = 0, 1 do
			Kit.box(parent, 1.6, 1.1, 0.7, cx - w / 4 + k * 1.9, roofY + 0.55, cz, P.stone_light, M.smooth, NC())
		end
	elseif roof < 0.75 then
		-- rooftop billboard
		local bb = Kit.box(parent, math.min(w - 1, 9), 3, 0.3, cx, roofY + 2.6, zFront + facing * 3, P.white, M.smooth, NC())
		Kit.text(bb, facing < 0 and Enum.NormalId.Back or Enum.NormalId.Front, ({ "ラーメン", "寿司", "カメラ", "牛乳", "ビール", "茶" })[r:NextInteger(1, 6)], { color = ({ "#C0261E", "#1E2A44", "#2F5A2A" })[r:NextInteger(1, 3)], font = JP_FONT })
		for _, bx in ipairs({ -2, 2 }) do
			Kit.box(parent, 0.25, 1.4, 0.25, cx + bx, roofY + 0.7, zFront + facing * 3, P.steel_dark, M.metal, NC())
		end
	end
	-- vertical sign
	if r:NextNumber() < 0.6 then
		local vs = Kit.box(parent, 1.2, 5, 0.3, x0 + 1, height * 0.6, face - facing * 0.9, P.charcoal, M.smooth, { collide = false })
		local word = SIGNS[r:NextInteger(1, #SIGNS)]
		local vertical = ""
		for _, c in utf8.codes(word) do
			vertical ..= utf8.char(c) .. "\n"
		end
		Kit.text(vs, facing < 0 and Enum.NormalId.Back or Enum.NormalId.Front, vertical, { color = ({ "#FF3B4A", "#3BC8FF", "#FFD23B", "#FF5AC8" })[r:NextInteger(1, 4)], glow = true, font = JP_FONT })
	end
	-- roof edge
	Kit.box(parent, w + 0.4, 0.6, depth + 0.4, cx, height - 0.4 + 0.3, cz, P.charcoal, M.roof, { collide = false })
	return body
end

function S.lamp(parent, x, z, facing)
	Kit.cyl(parent, 0.35, 9, x, -0.4 + 4.5, z, P.charcoal, M.metal)
	Kit.cylH(parent, 0.2, 2, x, 8.4, z + facing * 1, P.charcoal, M.metal, { collide = false }, "z")
	local head = Kit.box(parent, 0.9, 0.4, 1.2, x, 8.2, z + facing * 1.8, P.lamp, M.neon, { collide = false })
	Kit.light(head, "Spot", P.lamp_warm, 26, 2, { face = Enum.NormalId.Bottom, angle = 100 })
end

function S.pole(parent, x, z)
	Kit.cyl(parent, 0.6, 16, x, -0.4 + 8, z, P.stone_light, M.concrete)
	-- yellow and black guard sleeve, step bolts and an address plate
	for k = 0, 3 do
		Kit.cyl(parent, 0.66, 0.45, x, 0.05 + k * 0.45, z, k % 2 == 0 and P.neon_yellow or P.black, M.smooth, NC())
	end
	for k = 0, 4 do
		Kit.cylH(parent, 0.08, 0.9, x, 6 + k * 1.2, z, P.steel_dark, M.metal, NC(), k % 2 == 0 and "z" or nil)
	end
	Kit.box(parent, 0.5, 1.6, 0.66, x, 4, z, P.navy, M.smooth, NC())
	Kit.cylH(parent, 0.25, 3, x, 14.5, z, P.wood_dark, M.wood, { collide = false })
	Kit.cylH(parent, 0.25, 2.4, x, 13.2, z, P.wood_dark, M.wood, { collide = false })
	Kit.cyl(parent, 0.8, 1.2, x + 0.6, 12, z + 0.5, P.metal, M.metal, { collide = false })
end

function S.wire(parent, a, b, sag)
	local n = 6
	for i = 0, n - 1 do
		local t1, t2 = i / n, (i + 1) / n
		local p1 = a:Lerp(b, t1) - Vector3.new(0, sag * math.sin(math.pi * t1), 0)
		local p2 = a:Lerp(b, t2) - Vector3.new(0, sag * math.sin(math.pi * t2), 0)
		Kit.part(parent, Vector3.new(0.06, 0.06, (p2 - p1).Magnitude), CFrame.lookAt((p1 + p2) / 2, p2), P.black, M.smooth, { collide = false, shadow = false })
	end
end

function S.planterTree(parent, x, z, color)
	Kit.box(parent, 3, 0.8, 3, x, 0, z, P.stone, M.concrete)
	Kit.box(parent, 2.6, 0.1, 2.6, x, 0.4, z, P.wood_dark, M.sand, { collide = false })
	Kit.cyl(parent, 0.6, 6, x, 3.4, z, P.wood_dark, M.wood)
	for _, b in ipairs({ { 0, 7.5, 0, 5 }, { -1.4, 6.6, 0.6, 3.4 }, { 1.4, 6.8, -0.5, 3.6 }, { 0.4, 8.6, 0.4, 3 } }) do
		Kit.blob(parent, b[4], b[4] * 0.7, b[4], x + b[1], b[2], z + b[3], color, M.leafy, { collide = false })
	end
end

function S.viaduct(parent, z, y, x0, x1)
	Kit.box(parent, x1 - x0, 1.6, 8, (x0 + x1) / 2, y, z, P.concrete, M.concrete)
	Kit.box(parent, x1 - x0, 1.2, 0.4, (x0 + x1) / 2, y + 1.4, z - 3.8, P.stone_light, M.concrete, { collide = false })
	Kit.box(parent, x1 - x0, 1.2, 0.4, (x0 + x1) / 2, y + 1.4, z + 3.8, P.stone_light, M.concrete, { collide = false })
	for x = x0 + 10, x1 - 10, 30 do
		Kit.box(parent, 3, y, 4, x, y / 2 - 0.4, z, P.concrete, M.concrete)
	end
	for _, dz in ipairs({ -1.5, 1.5 }) do
		Kit.box(parent, x1 - x0, 0.2, 0.25, (x0 + x1) / 2, y + 0.9, z + dz, P.steel, M.metal, { collide = false })
	end
end

-- Train (built at the origin, moved by the client)
function S.train(cars)
	local m = Kit.model("Train")
	for i = 0, (cars or 4) - 1 do
		local x = i * 13.2
		Kit.box(m, 13, 4, 4, x, 2.3, 0, P.white, M.smooth)
		Kit.box(m, 13, 0.6, 4.05, x, 1.0, 0, P.matcha, M.smooth)
		for k = 0, 4 do
			local win = Kit.box(m, 1.6, 1.2, 4.1, x - 5 + k * 2.5, 3, 0, P.lamp, M.neon, { collide = false, shadow = false })
			win.Transparency = 0.2
		end
		Kit.box(m, 12.6, 0.3, 3.6, x, 4.4, 0, P.stone_light, M.metal)
	end
	Kit.box(m, 0.3, 1, 1, -6.6, 3, 1.2, P.lamp, M.neon, { collide = false })
	Kit.box(m, 0.3, 1, 1, -6.6, 3, -1.2, P.lamp, M.neon, { collide = false })
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
		end
	end
	Kit.finish(m, Vector3.new(cars * 13.2, 5, 4))
	return m
end

-- Delivery kei truck (front faces -X)
function S.truck()
	local m = Kit.model("Truck")
	Kit.box(m, 3.2, 3.4, 4.2, -3.2, 2.3, 0, P.white, M.smooth)
	Kit.box(m, 0.1, 1.4, 3.6, -4.82, 3, 0, P.glass, M.glass, { transparency = 0.3 })
	Kit.box(m, 6.6, 0.5, 4.2, 1.6, 1.0, 0, P.steel_dark, M.metal)
	local cargo = Kit.box(m, 6.2, 3.6, 4.2, 1.8, 3.05, 0, P.paper, M.smooth, { name = "Cargo" })
	Kit.text(cargo, Enum.NormalId.Back, "🐟 魚市場 🍚", { color = "#2E3A5C" })
	Kit.text(cargo, Enum.NormalId.Front, "🐟 魚市場 🍚", { color = "#2E3A5C" })
	for _, x in ipairs({ -3.2, 3 }) do
		for _, z in ipairs({ -2, 2 }) do
			Kit.cylH(m, 1.5, 0.6, x, 0.75, z, P.charcoal, M.rubber or M.smooth, nil, "z")
		end
	end
	local light = Kit.box(m, 0.15, 0.4, 0.8, -4.85, 1.6, 1.4, P.lamp, M.neon, { collide = false })
	Kit.light(light, "Spot", P.lamp, 20, 1.5, { face = Enum.NormalId.Left, angle = 60 })
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanCollide = false
		end
	end
	Kit.finish(m, Vector3.new(10, 5, 4.2))
	return m
end

function S.menuBoard(parent, x, z)
	local m = Kit.model("MenuBoard")
	Kit.box(m, 0.15, 4.2, 0.15, -1, 2.1, 0.6, P.wood_dark, M.wood)
	Kit.box(m, 0.15, 4.2, 0.15, 1, 2.1, 0.6, P.wood_dark, M.wood)
	local board = Kit.box(m, 2.4, 3.2, 0.2, 0, 2.4, 0, P.charcoal, M.slate, { name = "Board" })
	Kit.box(m, 2.6, 0.2, 0.3, 0, 4.1, 0, P.wood_dark, M.wood, { collide = false })
	Kit.text(board, Enum.NormalId.Front, "お品書き\n🍣 🍜 🍵", { color = "#F4EBDD", pps = 40 })
	Kit.finish(m, Vector3.new(2.6, 4.3, 1.4))
	m:PivotTo(CFrame.new(x, -0.4 + 2.15, z))
	m.Parent = parent
	return m
end

function S.supplierTablet(parent, x, y, z, yaw)
	local m = Kit.model("SupplierTablet")
	local frame = Kit.box(m, 0.15, 1.6, 2.4, 0, 0, 0, P.charcoal, M.smooth, { name = "Body" })
	local screen = Kit.box(m, 0.05, 1.3, 2.1, -0.09, 0, 0, P.white, M.neon, { collide = false })
	Kit.text(screen, Enum.NormalId.Left, "📦 発注", { color = "#2E3A5C", glow = true })
	local _ = frame
	Kit.finish(m, Vector3.new(0.3, 1.6, 2.4))
	m:PivotTo(CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(yaw or 0), 0))
	m.Parent = parent
	return m
end

function S.rng(seed)
	return rng(seed)
end

return function(Registry)
	Registry.Street = S
	local _ = Color
end
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX000046"><Properties><string name="Name">Kit</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Primitive helpers for procedural models. Coordinates are relative to the model's bottom center.
local Color = require(script.Parent.Parent.Util.Color)

local Kit = {}

local function apply(p, color, material, props)
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Color = Color.of(color or "#FFFFFF")
	p.Material = material or Enum.Material.SmoothPlastic
	p.CanTouch = false
	p.CastShadow = true
	if props then
		if props.collide ~= nil then
			p.CanCollide = props.collide
		end
		if props.query ~= nil then
			p.CanQuery = props.query
		end
		if props.transparency then
			p.Transparency = props.transparency
		end
		if props.reflectance then
			p.Reflectance = props.reflectance
		end
		if props.shadow == false then
			p.CastShadow = false
		end
		if props.name then
			p.Name = props.name
		end
	end
	return p
end

function Kit.model(name)
	local m = Instance.new("Model")
	m.Name = name or "Model"
	return m
end

-- Generic part with explicit size and local CFrame
function Kit.part(parent, size, cf, color, material, props)
	local p = Instance.new("Part")
	if props and props.shape then
		p.Shape = props.shape
	end
	p.Size = size
	p.CFrame = cf
	apply(p, color, material, props)
	if props and props.collide == nil and (size.X < 0.6 or size.Y < 0.6 or size.Z < 0.6) and size.Magnitude < 3 then
		p.CanCollide = false
	end
	p.Parent = parent
	return p
end

function Kit.box(parent, sx, sy, sz, x, y, z, color, material, props)
	local cf = CFrame.new(x, y, z)
	if props and props.rot then
		cf = cf * props.rot
	end
	return Kit.part(parent, Vector3.new(sx, sy, sz), cf, color, material, props)
end

-- Box defined by its bottom center (handy for stacking)
function Kit.slab(parent, sx, sy, sz, x, y0, z, color, material, props)
	return Kit.box(parent, sx, sy, sz, x, y0 + sy / 2, z, color, material, props)
end

-- Vertical cylinder: diameter d, height h, centered at x, y, z
function Kit.cyl(parent, d, h, x, y, z, color, material, props)
	props = props or {}
	props.shape = Enum.PartType.Cylinder
	local cf = CFrame.new(x, y, z) * CFrame.Angles(0, 0, math.rad(90))
	if props.rot then
		cf = CFrame.new(x, y, z) * props.rot * CFrame.Angles(0, 0, math.rad(90))
	end
	return Kit.part(parent, Vector3.new(h, d, d), cf, color, material, props)
end

-- Horizontal cylinder along X (length l) or along Z (axis = "z")
function Kit.cylH(parent, d, l, x, y, z, color, material, props, axis)
	props = props or {}
	props.shape = Enum.PartType.Cylinder
	local cf = CFrame.new(x, y, z)
	if axis == "z" then
		cf = cf * CFrame.Angles(0, math.rad(90), 0)
	end
	if props.rot then
		cf = cf * props.rot
	end
	return Kit.part(parent, Vector3.new(l, d, d), cf, color, material, props)
end

function Kit.ball(parent, d, x, y, z, color, material, props)
	props = props or {}
	props.shape = Enum.PartType.Ball
	return Kit.part(parent, Vector3.new(d, d, d), CFrame.new(x, y, z), color, material, props)
end

-- Ellipsoid-ish ball (non-uniform sizes are not allowed on Ball parts, so use a sphere mesh)
function Kit.blob(parent, sx, sy, sz, x, y, z, color, material, props)
	local p = Kit.box(parent, 1, 1, 1, x, y, z, color, material, props)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = Vector3.new(sx, sy, sz)
	mesh.Parent = p
	p.Size = Vector3.new(math.max(sx, 0.05), math.max(sy, 0.05), math.max(sz, 0.05))
	mesh.Scale = Vector3.new(1, 1, 1)
	return p
end

function Kit.wedge(parent, sx, sy, sz, cf, color, material, props)
	local p = Instance.new("WedgePart")
	p.Size = Vector3.new(sx, sy, sz)
	p.CFrame = cf
	apply(p, color, material, props)
	p.Parent = parent
	return p
end

-- Text on a part face
function Kit.text(part, face, text, opts)
	opts = opts or {}
	local gui = Instance.new("SurfaceGui")
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = opts.pps or 50
	gui.LightInfluence = opts.glow and 0 or 1
	gui.Brightness = opts.glow and 2 or 1
	gui.AlwaysOnTop = false
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = opts.bg and 0 or 1
	if opts.bg then
		label.BackgroundColor3 = Color.of(opts.bg)
	end
	label.Text = text
	label.TextScaled = true
	label.TextColor3 = Color.of(opts.color or "#2B2320")
	label.FontFace = opts.font or Font.new("rbxasset://fonts/families/FredokaOne.json")
	label.TextWrapped = true
	label.AutoLocalize = false
	if opts.rotation then
		label.Rotation = opts.rotation
	end
	label.Parent = gui
	return gui, label
end

-- Lights carry the attribute NightLight so the client can switch them by time of day.
function Kit.light(part, kind, color, range, brightness, opts)
	opts = opts or {}
	local l
	if kind == "Surface" then
		l = Instance.new("SurfaceLight")
		l.Face = opts.face or Enum.NormalId.Bottom
		l.Angle = opts.angle or 90
	elseif kind == "Spot" then
		l = Instance.new("SpotLight")
		l.Face = opts.face or Enum.NormalId.Bottom
		l.Angle = opts.angle or 60
	else
		l = Instance.new("PointLight")
	end
	l.Color = Color.of(color or "#FFD9A0")
	l.Range = range or 10
	l.Brightness = brightness or 1
	l.Shadows = opts.shadows or false
	l:SetAttribute("NightLight", opts.night ~= false)
	l:SetAttribute("BaseBrightness", l.Brightness)
	l.Parent = part
	return l
end

local PARTICLES = {
	steam = { tex = "rbxasset://textures/particles/smoke_main.dds", color = "#FFFFFF", rate = 6, life = { 1.2, 2 }, speed = { 1, 2 }, size = { 0.4, 1.4 }, transp = { 0.6, 1 }, spread = 10, accel = Vector3.new(0, 1, 0) },
	smoke = { tex = "rbxasset://textures/particles/smoke_main.dds", color = "#D8D8D8", rate = 3, life = { 2, 4 }, speed = { 0.5, 1 }, size = { 1, 3 }, transp = { 0.7, 1 }, spread = 20, accel = Vector3.new(0, 0.5, 0) },
	sparkle = { tex = "rbxasset://textures/particles/sparkles_main.dds", color = "#FFE08A", rate = 0, life = { 0.6, 1 }, speed = { 2, 5 }, size = { 0.3, 0 }, transp = { 0, 1 }, spread = 180, accel = Vector3.new(0, -2, 0) },
	petals = { tex = "rbxasset://textures/particles/sparkles_main.dds", color = "#F7B7C9", rate = 2, life = { 4, 6 }, speed = { 0.5, 1 }, size = { 0.25, 0.2 }, transp = { 0.1, 0.4 }, spread = 60, accel = Vector3.new(0.3, -0.6, 0.2) },
	bubbles = { tex = "rbxasset://textures/particles/sparkles_main.dds", color = "#FFF4D6", rate = 5, life = { 0.4, 0.8 }, speed = { 0.5, 1 }, size = { 0.15, 0.05 }, transp = { 0.3, 1 }, spread = 30, accel = Vector3.new(0, 1, 0) },
	water = { tex = "rbxasset://textures/particles/smoke_main.dds", color = "#CFE8F5", rate = 12, life = { 0.6, 1 }, speed = { 3, 5 }, size = { 0.3, 0.8 }, transp = { 0.5, 1 }, spread = 8, accel = Vector3.new(0, -10, 0) },
	snow = { tex = "rbxasset://textures/particles/sparkles_main.dds", color = "#FFFFFF", rate = 20, life = { 6, 9 }, speed = { 1, 2 }, size = { 0.25, 0.2 }, transp = { 0, 0.3 }, spread = 40, accel = Vector3.new(0.2, -1, 0) },
}

function Kit.particles(part, preset, overrides)
	local p = PARTICLES[preset] or PARTICLES.steam
	overrides = overrides or {}
	local e = Instance.new("ParticleEmitter")
	e.Texture = p.tex
	e.Color = ColorSequence.new(Color.of(overrides.color or p.color))
	e.Rate = overrides.rate or p.rate
	e.Lifetime = NumberRange.new(p.life[1], p.life[2])
	e.Speed = NumberRange.new(p.speed[1], p.speed[2])
	e.Size = NumberSequence.new(p.size[1], p.size[2])
	e.Transparency = NumberSequence.new(p.transp[1], p.transp[2])
	e.SpreadAngle = Vector2.new(p.spread, p.spread)
	e.Acceleration = p.accel
	e.LightEmission = overrides.glow or 0
	e.LightInfluence = 1
	e.Enabled = overrides.enabled ~= false
	e.Parent = part
	return e
end

function Kit.attach(part, name, cf)
	local a = Instance.new("Attachment")
	a.Name = name
	a.CFrame = cf or CFrame.new()
	a.Parent = part
	return a
end

-- Adds the invisible Root (footprint box) and sets PrimaryPart. size = Vector3 (w, h, d)
-- Optional detail group of a placeable model. Registry.build keeps it only when the matching
-- renovation style is owned, so the same builder makes the plain and the detailed look.
function Kit.detail(model, key)
	local name = "Detail_" .. key
	local d = model:FindFirstChild(name)
	if not d then
		d = Instance.new("Model")
		d.Name = name
		d.Parent = model
	end
	return d
end

function Kit.finish(model, size)
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = size
	root.CFrame = CFrame.new(0, size.Y / 2, 0)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.CastShadow = false
	root.Parent = model
	model.PrimaryPart = root
	return root
end

-- Rows of small boxes (e.g. tiles, slats) along X
function Kit.slats(parent, count, sx, sy, sz, x0, x1, y, z, color, material, props)
	local out = {}
	if count <= 1 then
		table.insert(out, Kit.box(parent, sx, sy, sz, (x0 + x1) / 2, y, z, color, material, props))
		return out
	end
	for i = 0, count - 1 do
		local x = x0 + (x1 - x0) * i / (count - 1)
		table.insert(out, Kit.box(parent, sx, sy, sz, x, y, z, color, material, props))
	end
	return out
end

return Kit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000047"><Properties><string name="Name">Palette</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Theme colors and materials used by every procedural model.
local Color = require(script.Parent.Parent.Util.Color)

local hex = {
	wood_light = "#C89F6E", wood = "#9A6B43", wood_dark = "#5B3A24", wood_black = "#2B1D14",
	hinoki = "#E3C79A", bamboo = "#B8A15A", bamboo_green = "#7A9A3A",
	lacquer = "#B3262E", lacquer_dark = "#7A1A1F", vermilion = "#D9442E",
	paper = "#F4EBDD", paper_warm = "#F7E3C0", ink = "#2B2320", charcoal = "#1E1E22",
	gold = "#D4A23C", brass = "#B8913A", matcha = "#7A9A4A", indigo = "#2E3A5C", navy = "#1E2A44",
	stone = "#8C8C88", stone_dark = "#5E5E5A", stone_light = "#B5B1A8", moss = "#5E7A3A",
	metal = "#A8ACB0", steel = "#6E7478", steel_dark = "#3E4246", copper = "#B87333",
	white = "#F7F5F0", porcelain = "#F2EFE8", rice = "#F7F4EC", nori = "#1E2B1E",
	leaf = "#4F7A3A", leaf_dark = "#2F5A2A", leaf_light = "#7FA34A", maple = "#C8361E",
	sakura = "#F7B7C9", sakura_dark = "#E88AA8", water = "#4F98B8", water_dark = "#2E6A88",
	sand = "#E3D6B8", tile = "#3A3D44", road = "#2A2A2E", road_line = "#E8E4D8", concrete = "#9A9A96",
	sidewalk = "#B5B0A6", brick = "#7A4A3A", glass = "#A8D0E0", cardboard = "#B98B57",
	neon_red = "#FF3B4A", neon_blue = "#3BC8FF", neon_pink = "#FF5AC8", neon_yellow = "#FFD23B",
	lamp = "#FFD9A0", lamp_warm = "#FFB866", koi_orange = "#F27A2E", black = "#141414",
	cream = "#EFE3CC", red = "#C0261E",
}

local Palette = {}
for name, value in pairs(hex) do
	Palette[name] = Color.hex(value)
end

Palette.M = {
	wood = Enum.Material.Wood,
	planks = Enum.Material.WoodPlanks,
	fabric = Enum.Material.Fabric,
	smooth = Enum.Material.SmoothPlastic,
	plastic = Enum.Material.Plastic,
	metal = Enum.Material.Metal,
	slate = Enum.Material.Slate,
	concrete = Enum.Material.Concrete,
	brick = Enum.Material.Brick,
	neon = Enum.Material.Neon,
	glass = Enum.Material.Glass,
	marble = Enum.Material.Marble,
	granite = Enum.Material.Granite,
	pebble = Enum.Material.Pebble,
	sand = Enum.Material.Sand,
	grass = Enum.Material.Grass,
	leafy = Enum.Material.LeafyGrass,
	cobble = Enum.Material.Cobblestone,
	foil = Enum.Material.Foil,
	plaster = Enum.Material.Plaster,
	cardboard = Enum.Material.Cardboard,
	tiles = Enum.Material.CeramicTiles,
	roof = Enum.Material.ClayRoofTiles,
	asphalt = Enum.Material.Asphalt,
	pavement = Enum.Material.Pavement,
	rock = Enum.Material.Rock,
	snow = Enum.Material.Snow,
	leather = Enum.Material.Leather,
	carpet = Enum.Material.Carpet,
}

function Palette.material(name)
	local ok, m = pcall(function()
		return Enum.Material[name]
	end)
	if ok and m then
		return m
	end
	return Enum.Material.SmoothPlastic
end

Palette.hex = Color.hex

return Palette
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000048"><Properties><string name="Name">Registry</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Model registry: id -> builder. Models in ReplicatedStorage.AssetOverrides with the same name
-- replace the procedural version (they are scaled to fit the configured size).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Kit = require(script.Parent.Kit)
local Items = require(script.Parent.Parent.Config.Items)

local Registry = {}
local builders = {}
local foodBuilders = {}
Registry.Food = {}

function Registry.register(id, fn)
	builders[id] = fn
end

function Registry.has(id)
	return builders[id] ~= nil
end

local function override(id)
	local folder = ReplicatedStorage:FindFirstChild("AssetOverrides")
	local m = folder and folder:FindFirstChild(id)
	if m and m:IsA("Model") then
		return m:Clone()
	end
	return nil
end

local function fitOverride(model, size)
	local cf, bbox = model:GetBoundingBox()
	local scale = math.min(size.X / math.max(bbox.X, 0.01), size.Y / math.max(bbox.Y, 0.01), size.Z / math.max(bbox.Z, 0.01))
	if scale > 0 and math.abs(scale - 1) > 0.02 then
		model:ScaleTo(model:GetScale() * scale)
		cf, bbox = model:GetBoundingBox()
	end
	-- move so the bottom center sits at the origin
	local offset = CFrame.new(0, bbox.Y / 2, 0) * cf:Inverse()
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CFrame = offset * d.CFrame
		end
	end
	local old = model:FindFirstChild("Root")
	if old then
		old:Destroy()
	end
	Kit.finish(model, size)
	return model
end

-- Builds the model of a placeable item; returns a Model whose Root is the footprint box,
-- bottom center at the origin, front facing -Z. opts.styles: owned renovation styles.
function Registry.build(id, opts)
	local item = Items.byId[id]
	local size = item and Vector3.new(item.size[1], item.size[2], item.size[3]) or Vector3.new(2, 2, 2)
	local m = override(id)
	if m then
		m.Name = id
		return fitOverride(m, size)
	end
	m = Kit.model(id)
	local fn = builders[id]
	if fn then
		local ok, err = pcall(fn, m, item, opts or {})
		if not ok then
			warn("[Models] builder failed for " .. id .. ": " .. tostring(err))
			m:ClearAllChildren()
			Kit.box(m, size.X, size.Y, size.Z, 0, size.Y / 2, 0, "#C89F6E", Enum.Material.Wood)
		end
	else
		Kit.box(m, size.X, size.Y, size.Z, 0, size.Y / 2, 0, "#C89F6E", Enum.Material.Wood)
	end
	if not m:FindFirstChild("Root") then
		Kit.finish(m, size)
	end
	-- opts.styles = set of owned renovation styles; without it every detail is kept
	local styles = opts and opts.styles
	if styles then
		for _, child in ipairs(m:GetChildren()) do
			local key = string.match(child.Name, "^Detail_(.+)$")
			if key and not styles[key] then
				child:Destroy()
			end
		end
	end
	return m
end

-- Food: Registry.dish(recipeId, opts), Registry.ingredient(id), Registry.box(id, count)
function Registry.registerFood(name, fn)
	foodBuilders[name] = fn
end

function Registry.food(name, ...)
	local fn = foodBuilders[name]
	if fn then
		return fn(...)
	end
	local m = Kit.model(name)
	Kit.box(m, 0.8, 0.4, 0.8, 0, 0.2, 0, "#F7F5F0")
	Kit.finish(m, Vector3.new(0.8, 0.4, 0.8))
	return m
end

-- Loads every builder module once.
local loaded = false
function Registry.load()
	if loaded then
		return
	end
	loaded = true
	for _, mod in ipairs(script.Parent.Builders:GetChildren()) do
		if mod:IsA("ModuleScript") then
			local ok, fn = pcall(require, mod)
			if ok and type(fn) == "function" then
				fn(Registry)
			else
				warn("[Models] could not load " .. mod.Name .. ": " .. tostring(fn))
			end
		end
	end
end

-- Moves a model so its Root sits at (x, y floor level, z) with rotation r (degrees)
function Registry.place(model, x, y, z, r)
	local root = model.PrimaryPart
	local h = root and root.Size.Y or 0
	model:PivotTo(CFrame.new(x, y + h / 2, z) * CFrame.Angles(0, math.rad(r or 0), 0))
end

return Registry
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000049"><Properties><string name="Name">Scene</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Builds the restaurant shell (floors, walls, roof, facade, stairs) and the street scenery.
-- Shared so the server world builder and the preview renderer use the same code.
local CollectionService = game:GetService("CollectionService")

local Config = script.Parent.Parent.Config
local GameConfig = require(Config.GameConfig)
local Expansions = require(Config.Expansions)
local Surfaces = require(Config.Surfaces)
local Franchise = require(Config.Franchise)
local Footprint = require(script.Parent.Parent.Logic.Footprint)
local Registry = require(script.Parent.Registry)
local Kit = require(script.Parent.Kit)
local P = require(script.Parent.Palette)
local Color = require(script.Parent.Parent.Util.Color)

local Scene = {}

local function floorY(f)
	return (f or 0) * GameConfig.FloorHeight
end
Scene.floorY = floorY

local function zoneAt(geo, x, z, f)
	for _, zone in ipairs(geo.zones) do
		if zone.floor == (f or 0) and Footprint.pointInRect(x, z, zone.rect) then
			return zone
		end
	end
	return nil
end
Scene.zoneAt = zoneAt

local function style(id, kind)
	local s = Surfaces.byId[id]
	if not s or s.kind ~= kind then
		s = Surfaces.byId[kind == "floor" and Surfaces.DefaultFloor or Surfaces.DefaultWall]
	end
	return { color = Color.hex(s.color), material = P.material(s.material), lattice = s.lattice, stripes = s.stripes }
end

function Scene.surfaceOf(data, zone, kind)
	local s = data.surfaces[zone.id]
	local id = s and s[kind]
	if not id then
		id = kind == "floor" and (zone.floorStyle or Surfaces.DefaultFloor) or (zone.wallStyle or Surfaces.DefaultWall)
	end
	return id
end

local function holesFor(geo, floor)
	local holes = {}
	for _, s in ipairs(geo.stairs) do
		if s.floor == floor - 1 then
			table.insert(holes, s.rect)
		end
	end
	return holes
end

local function subtractAll(rect, holes)
	local rects = { rect }
	for _, h in ipairs(holes) do
		local next = {}
		for _, r in ipairs(rects) do
			for _, piece in ipairs(Footprint.subtractRect(r, h)) do
				table.insert(next, piece)
			end
		end
		rects = next
	end
	return rects
end

local function indoorAt(geo, x, z, floor)
	local zone = zoneAt(geo, x, z, floor)
	return zone and not zone.outdoor and zone or nil
end

function Scene.shell(shell, geo, data)
	shell:ClearAllChildren()
	local B = Registry.Building
	local floors = {}
	for _, z in ipairs(geo.zones) do
		floors[z.floor] = true
	end
	local topFloor = 0
	for f in pairs(floors) do
		topFloor = math.max(topFloor, f)
	end
	local deluxe = data.zones.facade_deluxe
	-- renovations bought so far (the starting restaurant is plain)
	local owned = data.zones
	local trim = { wainscot = owned.reno_wainscot, beams = owned.reno_beams, tiles = owned.reno_kitchen_tiles, storage = owned.reno_storage }
	local exterior = { color = deluxe and P.charcoal or P.cream, material = deluxe and P.M.wood or P.M.plaster }

	for _, zone in ipairs(geo.zones) do
		local fy = floorY(zone.floor)
		local attrs = { Zone = zone.id, FloorIndex = zone.floor, Area = zone.area }
		local floorStyle
		if zone.outdoor then
			if zone.area == "garden" then
				floorStyle = { color = P.moss, material = P.M.leafy }
			else
				floorStyle = { color = P.wood, material = P.M.planks }
			end
		else
			floorStyle = style(Scene.surfaceOf(data, zone, "floor"), "floor")
		end
		for _, r in ipairs(subtractAll(zone.rect, holesFor(geo, zone.floor))) do
			B.floorSkin(shell, r, fy, floorStyle, attrs)
			if zone.floor == 0 then
				B.slab(shell, r, zone.outdoor and -0.7 or -1.2, zone.outdoor and 0.5 or 1.0, P.stone_dark, P.M.concrete, "Foundation")
			end
		end
		if not zone.outdoor then
			-- ceiling / roof slab with holes where stairs go up
			local holes = {}
			for _, s in ipairs(geo.stairs) do
				if s.floor == zone.floor then
					table.insert(holes, s.rect)
				end
			end
			local covered = false
			for _, other in ipairs(geo.zones) do
				if other.floor == zone.floor + 1 and Footprint.pointInRect((zone.rect[1] + zone.rect[3]) / 2, (zone.rect[2] + zone.rect[4]) / 2, other.rect) then
					covered = true
				end
			end
			for _, r in ipairs(subtractAll(zone.rect, holes)) do
				local c = B.slab(shell, r, fy + GameConfig.WallHeight, 1, P.wood_dark, P.M.wood, "Ceiling")
				B.tag(c, "Ceiling", { FloorIndex = zone.floor })
				B.tag(c, "Roof")
				if not covered then
					-- flat roof finish with gravel and a few rooftop details
					local cover = B.slab(shell, r, fy + GameConfig.WallHeight + 1, 0.15, P.stone_dark, P.M.pebble, "RoofCover")
					B.tag(cover, "Roof")
				end
			end
			if not covered then
				local rr = zone.rect
				local cx, cz = (rr[1] + rr[3]) / 2, (rr[2] + rr[4]) / 2
				local top = fy + GameConfig.WallHeight + 1.15
				local unit = Kit.box(shell, 2.6, 1.6, 1.4, cx + 4, top + 0.8, cz + 3, P.white, P.M.metal, { collide = false })
				B.tag(unit, "Roof")
				local fan = Kit.cylH(shell, 1.1, 0.08, cx + 4, top + 0.8, cz + 2.27, P.steel_dark, P.M.metal, { collide = false, shadow = false }, "z")
				B.tag(fan, "Roof")
				local tank = Kit.cyl(shell, 2.2, 2.4, cx - 6, top + 1.6, cz + 5, P.metal, P.M.metal, { collide = false })
				B.tag(tank, "Roof")
				for _, dx in ipairs({ -0.7, 0.7 }) do
					local leg = Kit.box(shell, 0.2, 0.6, 0.2, cx - 6 + dx, top + 0.3, cz + 5, P.steel_dark, P.M.metal, { collide = false, shadow = false })
					B.tag(leg, "Roof")
				end
			end
			-- exposed beams (renovation) and soft ceiling lights
			local r = zone.rect
			if trim.beams then
				for x = r[1] + 3, r[3] - 2, 6 do
					local beam = Kit.box(shell, 0.6, 0.7, r[4] - r[2], x, fy + GameConfig.WallHeight - 0.35, (r[2] + r[4]) / 2, P.wood_black, P.M.wood, { collide = false })
					B.tag(beam, "Roof")
				end
			end
			for x = r[1] + 5, r[3] - 3, 10 do
				for z = r[2] + 5, r[4] - 3, 10 do
					local fixture = Kit.box(shell, 1.2, 0.2, 1.2, x, fy + GameConfig.WallHeight - 0.8, z, P.paper_warm, P.M.neon, { collide = false, shadow = false })
					fixture.CanQuery = false
					Kit.light(fixture, "Point", P.lamp, 22, 0.55, { night = false })
					B.tag(fixture, "Roof")
				end
			end
			if zone.area == "kitchen" or zone.area == "storage" then
				local vol = Kit.box(shell, r[3] - r[1], 6, r[4] - r[2], (r[1] + r[3]) / 2, fy + 3, (r[2] + r[4]) / 2, P.white, P.M.smooth, { collide = false, transparency = 1, shadow = false })
				vol.CanQuery = false
				vol.Name = "StaffOnly"
				local mod = Instance.new("PathfindingModifier")
				mod.Label = "StaffOnly"
				mod.Parent = vol
			end
		end
	end

	for floor in pairs(floors) do
		local fy = floorY(floor)
		local fw = geo.walls[floor] or { walls = {}, rails = {} }
		for _, seg in ipairs(fw.walls) do
			local mid = (seg.a + seg.b) / 2
			local sideA, sideB
			if seg.axis == "z" then
				sideA, sideB = indoorAt(geo, mid, seg.line - 0.6, floor), indoorAt(geo, mid, seg.line + 0.6, floor)
			else
				sideA, sideB = indoorAt(geo, seg.line - 0.6, mid, floor), indoorAt(geo, seg.line + 0.6, mid, floor)
			end
			local zone = sideA or sideB
			local wallStyle = style(zone and Scene.surfaceOf(data, zone, "wall") or Surfaces.DefaultWall, "wall")
			local outsideSign = nil
			if not sideA then
				outsideSign = -1
			elseif not sideB then
				outsideSign = 1
			end
			B.wall(shell, seg, fy, GameConfig.WallHeight, 0.8, wallStyle, outsideSign, exterior)
			-- interior finishes on each indoor side
			if sideA then
				B.wallTrim(shell, seg, fy, -1, sideA.area, GameConfig.WallHeight, trim)
			end
			if sideB then
				B.wallTrim(shell, seg, fy, 1, sideB.area, GameConfig.WallHeight, trim)
			end
			if outsideSign then
				if seg.axis == "z" and outsideSign == -1 then
					B.eave(shell, seg, fy + GameConfig.WallHeight - 1.2, -1, 3, owned.reno_eaves)
					if zone and zone.area ~= "storage" and (owned.reno_facade or owned.reno_bamboo) then
						local avoid = {}
						for _, o in ipairs(geo.openings) do
							if o.axis == "z" and o.at == seg.line and o.floor == floor then
								table.insert(avoid, { o.from - 4.4, o.to + 4.4 })
							end
						end
						B.facadeDetail(shell, seg, fy, -1, avoid, { koshi = owned.reno_facade, bamboo = owned.reno_bamboo })
					end
					-- lattice windows facing the street (not over doors)
					local len = seg.b - seg.a
					local n = math.floor(len / 9)
					for i = 0, n - 1 do
						local along = seg.a + len / n * (i + 0.5)
						if math.abs(along) > 6 then
							B.window(shell, along, fy + 6.6, seg, -1, 4, 3.4, owned.reno_windows)
						end
					end
				end
				local above = false
				for _, z in ipairs(geo.zones) do
					if z.floor == floor + 1 and Footprint.pointInRect(seg.axis == "z" and mid or seg.line, seg.axis == "z" and seg.line or mid, z.rect, 0.5) then
						above = true
					end
				end
				if not above then
					B.parapet(shell, seg, fy + GameConfig.WallHeight + 1)
				end
			end
		end
		for _, seg in ipairs(fw.rails) do
			B.railing(shell, seg, fy, floor == 0 and P.wood_dark or P.lacquer)
		end
	end
	for _, o in ipairs(geo.openings) do
		local fy = floorY(o.floor)
		B.doorFrame(shell, o, fy, o.kind == "loading" and 10 or 9)
		if o.kind == "entrance" then
			B.entranceNoren(shell, o, fy)
			if owned.reno_entrance then
				B.entranceDetail(shell, o, fy)
			end
		elseif o.kind == "loading" then
			B.shutter(shell, o, fy, 10, owned.reno_storage)
		end
	end
	for _, s in ipairs(geo.stairs) do
		B.stairs(shell, s.rect, floorY(s.floor), GameConfig.FloorHeight)
	end

	-- Facade: big sign, entrance lanterns, open plate
	local signText = "らーめん ・ 寿司"
	local face = B.sign(shell, 0, 11.6, -0.9, 14, signText, deluxe)
	B.tag(face, "Roof")
	for _, x in ipairs({ -4.4, 4.4 }) do
		local l = Kit.blob(shell, 1.3, 1.8, 1.3, x, 8.2, -1.6, P.lacquer, P.M.smooth, { collide = false })
		Kit.cyl(shell, 0.8, 0.2, x, 9.2, -1.6, P.black, P.M.smooth, { collide = false })
		Kit.cyl(shell, 0.8, 0.2, x, 7.2, -1.6, P.black, P.M.smooth, { collide = false })
		Kit.light(l, "Point", P.lamp_warm, 16, 1.4)
		l:SetAttribute("Animate", "sway")
		l.CanQuery = false
	end
	local label = B.openSign(shell, 4.6, 5.2, -0.55)
	if data.zones.sign_rooftop then
		local topY = floorY(topFloor) + GameConfig.WallHeight + 2
		local board = Kit.box(shell, 20, 5, 0.6, 0, topY + 3.5, 2, P.black, P.M.smooth, { collide = false })
		Kit.text(board, Enum.NormalId.Front, "ラーメン 寿司", { color = "#FF3B4A", glow = true })
		Kit.light(board, "Surface", P.neon_red, 30, 3, { face = Enum.NormalId.Front })
		for _, x in ipairs({ -8, 8 }) do
			Kit.box(shell, 0.4, 3.5, 0.4, x, topY + 1, 2.4, P.steel_dark, P.M.metal, { collide = false })
		end
		B.tag(board, "Roof")
	end
	if deluxe then
		for _, x in ipairs({ -18.2, 18.2 }) do
			local post = Kit.box(shell, 0.4, 13, 0.4, x, 6.5, -0.6, P.gold, P.M.foil, { collide = false })
			B.tag(post, "Roof")
		end
		local glow = Kit.box(shell, 36.4, 0.2, 0.2, 0, 13.6, -0.7, P.neon_yellow, P.M.neon, { collide = false })
		B.tag(glow, "Roof")
	end
	-- Fixed interactables: supplier tablet and menu board
	local S = Registry.Street
	local tabletCfg = Expansions.Supplier
	local tablet = S.supplierTablet(shell, tabletCfg.x, tabletCfg.y, tabletCfg.z, 0)
	tablet:SetAttribute("Uid", "fixed_supplier")
	tablet:SetAttribute("Kind", "supplier")
	CollectionService:AddTag(tablet, "Interactable")
	local mb = Expansions.MenuBoard
	local board = S.menuBoard(shell, mb.x, mb.z)
	board:SetAttribute("Uid", "fixed_menu")
	board:SetAttribute("Kind", "menuboard")
	CollectionService:AddTag(board, "Interactable")

	for _, d in ipairs(shell:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CollisionGroup = "Shell"
		end
	end
	return { openLabel = label }
end

-- Neighbour facade colour: the city tone mixed with plaster, tile or concrete shades
local FACADE_MIX = { "#EFE3CC", "#B5B1A8", "#C9B8A0", "#9AA3A8", "#D8CFC0", "#A0705A" }
local function facadeColor(pal, r)
	local mix = Color.hex(FACADE_MIX[r:NextInteger(1, #FACADE_MIX)])
	return Color.hex(pal.building):Lerp(mix, 0.35 + r:NextNumber() * 0.5)
end

function Scene.street(street, cityId)
	street:ClearAllChildren()
	local city = Franchise.byId[cityId] or Franchise.byId.tokyo
	local pal = city.palette
	local S = Registry.Street
	local r = S.rng(42)
	local M = P.M
	-- ground
	Kit.box(street, 900, 1, 600, 0, -1.9, 40, city.snow and P.white or Color.hex("#4A5A3A"), city.snow and M.snow or M.grass)
	-- road
	Kit.box(street, 900, 0.6, 16, 0, -1.1, -22, Color.hex(pal.road), M.asphalt)
	for x = -440, 440, 12 do
		Kit.box(street, 5, 0.05, 0.4, x, -0.78, -22, P.road_line, M.smooth, { collide = false, shadow = false })
	end
	-- solid edge lines, crossing, manholes (one steaming) and drain grates
	for _, ez in ipairs({ -15, -29 }) do
		Kit.box(street, 900, 0.05, 0.3, 0, -0.78, ez, P.road_line, M.smooth, { collide = false, shadow = false })
	end
	S.crosswalk(street, -26, -0.77, -22, 16)
	for i, mx in ipairs({ -70, 30, 96, -130 }) do
		S.manhole(street, mx, -0.77, i % 2 == 0 and -19 or -25, mx == 30)
	end
	for gx = -170, 170, 20 do
		Kit.box(street, 1.6, 0.05, 0.6, gx + 7, -0.77, -14.7, P.steel_dark, M.metal, { collide = false, shadow = false })
	end
	-- sidewalks with yellow tactile paving
	Kit.box(street, 900, 1, 14, 0, -0.9, -7, P.sidewalk, M.pavement)
	Kit.box(street, 900, 0.5, 0.5, 0, -0.65, -14, P.stone_light, M.concrete)
	Kit.box(street, 900, 1, 6, 0, -0.9, -33, P.sidewalk, M.pavement)
	Kit.box(street, 900, 0.5, 0.5, 0, -0.65, -30, P.stone_light, M.concrete)
	local tactile = Color.hex("#E2B93B")
	Kit.box(street, 900, 0.06, 1, 0, -0.38, -5.5, tactile, M.pavement, { collide = false, shadow = false })
	Kit.box(street, 900, 0.06, 1, 0, -0.38, -32.2, tactile, M.pavement, { collide = false, shadow = false })
	Kit.box(street, 1, 0.06, 7.2, -26, -0.38, -9.6, tactile, M.pavement, { collide = false, shadow = false })
	Kit.box(street, 3, 0.06, 1, -26, -0.38, -13.2, tactile, M.cobble, { collide = false, shadow = false })
	Kit.box(street, 3, 0.06, 1, -26, -0.38, -30.8, tactile, M.cobble, { collide = false, shadow = false })
	S.manhole(street, -80, -0.37, -6.5, false)
	-- street furniture near the crossing: signs, post box, bus stop
	S.trafficSign(street, -29.5, -13.4, "walk")
	S.trafficSign(street, -22.5, -30.6, "walk")
	S.trafficSign(street, -92, -13.4, "stop")
	S.postBox(street, -36, -13.2)
	Kit.cyl(street, 0.2, 7, 64, 3.1, -13.4, P.metal, M.metal)
	local bus = Kit.cylH(street, 1.6, 0.1, 64, 6.4, -13.4, P.white, M.smooth, { collide = false, shadow = false }, "z")
	Kit.text(bus, Enum.NormalId.Left, "バス", { color = "#1E2A44" })
	Kit.text(bus, Enum.NormalId.Right, "バス", { color = "#1E2A44" })
	Kit.box(street, 0.9, 1.4, 0.12, 64, 4.6, -13.4, P.paper, M.smooth, { collide = false, shadow = false })
	Kit.box(street, 4, 0.2, 1.2, 68, 1.3, -13.2, P.wood_light, M.wood)
	for _, bx in ipairs({ 66.4, 69.6 }) do
		Kit.box(street, 0.2, 1.2, 1, bx, 0.6, -13.2, P.steel_dark, M.metal)
	end
	-- bicycles parked on the far sidewalk
	for _, bx in ipairs({ -44, -42.8, -41.6, 34, 35.2, 118, 119.2, -150 }) do
		S.bicycle(street, bx, -34, 90, ({ P.white, P.navy, P.lacquer, P.matcha, P.sakura_dark })[r:NextInteger(1, 5)])
	end
	-- plot lot and loading bay
	local pb = Expansions.PlotBounds
	Kit.box(street, pb[3] - pb[1], 1, 52 - 0, (pb[1] + pb[3]) / 2, -0.9, 26, P.stone_dark, M.pavement)
	Kit.box(street, 12, 0.1, 12, 24, -0.38, 6, P.concrete, M.concrete, { collide = false })
	for _, x in ipairs({ 18.3, 29.7 }) do
		Kit.box(street, 0.25, 0.05, 12, x, -0.33, 6, P.neon_yellow, M.smooth, { collide = false, shadow = false })
	end
	-- opposite row
	local x = -180
	while x < 180 do
		local w = r:NextInteger(10, 18)
		S.building(street, x, x + w - 0.5, -36, 18, r:NextInteger(16, 34), -1, facadeColor(pal, r), r)
		x += w
	end
	-- neighbours on our side
	x = -180
	while x < pb[1] - 2 do
		local w = math.min(r:NextInteger(10, 16), pb[1] - 2 - x)
		if w >= 6 then
			S.building(street, x, x + w - 0.5, 0, 30, r:NextInteger(16, 30), 1, facadeColor(pal, r), r)
		end
		x += math.max(w, 6)
	end
	x = pb[3] + 2
	while x < 180 do
		local w = r:NextInteger(10, 16)
		S.building(street, x, x + w - 0.5, 0, 30, r:NextInteger(16, 30), 1, facadeColor(pal, r), r)
		x += w
	end
	-- back fence and trees
	for fx = pb[1], pb[3] - 2, 2 do
		Kit.box(street, 0.3, 5, 0.3, fx, 2.1, 52, P.bamboo, M.wood)
	end
	Kit.box(street, pb[3] - pb[1], 0.3, 0.3, (pb[1] + pb[3]) / 2, 4.2, 52, P.bamboo, M.wood, { collide = false })
	Kit.box(street, pb[3] - pb[1], 0.3, 0.3, (pb[1] + pb[3]) / 2, 1.5, 52, P.bamboo, M.wood, { collide = false })
	for _, tx in ipairs({ -50, -30, -5, 20, 40 }) do
		S.planterTree(street, tx, 58, (tx % 20 == 0) and P.sakura or P.leaf)
	end
	-- sidewalk lamps, poles, trees
	for lx = -170, 170, 30 do
		if math.abs(lx) > 8 then
			S.lamp(street, lx, -13, -1)
		end
	end
	local prev = nil
	for px = -180, 180, 40 do
		S.pole(street, px, -34.5)
		local top = Vector3.new(px, 14.5, -34.5)
		if prev then
			S.wire(street, prev, top, 1.2)
			S.wire(street, prev + Vector3.new(0, -1.3, 0), top + Vector3.new(0, -1.3, 0), 1.2)
		end
		prev = top
	end
	for _, tx in ipairs({ -150, -110, -80, 70, 100, 140 }) do
		S.planterTree(street, tx, -10, (tx % 20 == 0) and P.sakura or P.leaf_light)
	end
	for _, tx in ipairs({ -130, -60, 10, 80, 150 }) do
		S.planterTree(street, tx, -33, P.sakura)
	end
	-- a few street vending machines
	for _, vx in ipairs({ -60, 52, -100 }) do
		local vm = Registry.build("vending_machine")
		Registry.place(vm, vx, -0.4, -1.4, 180)
		vm.Parent = street
		S.bins(street, vx + (vx < 0 and -2.6 or 2.6), -1.3)
	end
	S.viaduct(street, -95, 22, -450, 450)
	if city.snow then
		local snow = Kit.box(street, 300, 1, 200, 0, 60, 0, P.white, M.smooth, { transparency = 1, collide = false, shadow = false })
		snow.CanQuery = false
		Kit.particles(snow, "snow", { rate = 60 })
	end
	for _, d in ipairs(street:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CollisionGroup = "Shell"
			d.CanTouch = false
		end
	end
	return { sky = pal.sky }
end


return Scene
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX000051"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Remote definitions shared by server and client.
-- The server creates the instances; the client waits for them.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

Net.Events = {
	-- client -> server
	"Interact", -- (uid, extra)
	"DropHands",
	"OrderSupplies", -- (cart {[ingredientId] = {small = n, big = n}})
	"BuyDishes",
	"PlaceItem", -- (request)
	"MoveItem", -- (uid, request)
	"RemoveItem", -- (uid, mode "sell"|"store")
	"PaintSurface", -- (zoneId, kind "floor"|"wall", styleId)
	"BuyLicense",
	"BuyUpgrade",
	"BuyExpansion",
	"BuyAd",
	"HireStaff",
	"TrainStaff",
	"FireStaff",
	"SetMenu", -- (recipeId, on, priceMult)
	"SetDayState", -- ("open" | "close" | "next")
	"ClaimQuest",
	"ClaimAchievement",
	"ClaimDaily",
	"ClaimOffline",
	"SetSetting", -- (key, value)
	"SetPermission", -- (userId, level)
	"Franchise", -- (cityId)
	"BuyWithRobux", -- (kind "gamepass"|"product", id)
	"TutorialStep", -- (step)
	"Dev", -- (command, arg)
	-- server -> client
	"DataChanged", -- (scope "me"|"world", key, value)
	"Notify", -- (key, params, kind)
	"Tickets", -- (list)
	"Fx", -- (kind, data)
	"DayState", -- (state table)
	"Session", -- (info)
}

Net.Functions = {
	"GetSnapshot",
	"GetLeaderboard",
}

local folder

local function getFolder()
	if folder then
		return folder
	end
	if RunService:IsServer() then
		folder = ReplicatedStorage:FindFirstChild("Remotes")
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = "Remotes"
			for _, name in ipairs(Net.Events) do
				local ev = Instance.new("RemoteEvent")
				ev.Name = name
				ev.Parent = folder
			end
			for _, name in ipairs(Net.Functions) do
				local fn = Instance.new("RemoteFunction")
				fn.Name = name
				fn.Parent = folder
			end
			folder.Parent = ReplicatedStorage
		end
	else
		folder = ReplicatedStorage:WaitForChild("Remotes")
	end
	return folder
end

function Net.event(name)
	local f = getFolder()
	if RunService:IsServer() then
		return f[name]
	end
	return f:WaitForChild(name)
end

function Net.func(name)
	return Net.event(name)
end

return Net
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX000058"><Properties><string name="Name">Util</string></Properties><Item class="ModuleScript" referent="RBX000052"><Properties><string name="Name">Color</string><ProtectedString name="Source"><![CDATA[--!nonstrict
local Color = {}

local cache = {}

-- "#RRGGBB" -> Color3 (cached)
function Color.hex(hex)
	local c = cache[hex]
	if c then
		return c
	end
	local h = hex:gsub("#", "")
	local r = tonumber(h:sub(1, 2), 16) or 255
	local g = tonumber(h:sub(3, 4), 16) or 255
	local b = tonumber(h:sub(5, 6), 16) or 255
	c = Color3.fromRGB(r, g, b)
	cache[hex] = c
	return c
end

function Color.of(value)
	if typeof(value) == "Color3" then
		return value
	elseif type(value) == "string" then
		return Color.hex(value)
	end
	return Color3.new(1, 1, 1)
end

function Color.darken(c, amount)
	local h, s, v = c:ToHSV()
	return Color3.fromHSV(h, s, math.clamp(v * (1 - amount), 0, 1))
end

function Color.lighten(c, amount)
	return c:Lerp(Color3.new(1, 1, 1), amount)
end

return Color
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000053"><Properties><string name="Name">Format</string><ProtectedString name="Source"><![CDATA[--!nonstrict
local Format = {}

local function group(n, sep)
	local s = tostring(math.floor(math.abs(n) + 0.5))
	local out = s:reverse():gsub("(%d%d%d)", "%1" .. sep):reverse()
	if out:sub(1, 1) == sep then
		out = out:sub(2)
	end
	return out
end

-- Formats an integer with thousands separators for the given language.
function Format.number(n, lang)
	n = tonumber(n) or 0
	local sign = n < 0 and "-" or ""
	local sep = lang == "it" and "." or ","
	local abs = math.abs(n)
	if abs >= 1e9 then
		local v = string.format("%.2f", abs / 1e9)
		if lang == "it" then
			v = v:gsub("%.", ",")
		end
		return sign .. v .. (lang == "it" and " Mld" or "B")
	elseif abs >= 1e7 then
		local v = string.format("%.1f", abs / 1e6)
		if lang == "it" then
			v = v:gsub("%.", ",")
		end
		return sign .. v .. (lang == "it" and " Mln" or "M")
	end
	return sign .. group(abs, sep)
end

function Format.yen(n, lang)
	return "¥" .. Format.number(n, lang)
end

function Format.sakura(n, lang)
	return "🌸" .. Format.number(n, lang)
end

function Format.decimal(n, digits, lang)
	local s = string.format("%." .. (digits or 1) .. "f", n)
	if lang == "it" then
		s = s:gsub("%.", ",")
	end
	return s
end

function Format.clock(hours)
	local h = math.floor(hours) % 24
	local m = math.floor((hours - math.floor(hours)) * 60)
	return string.format("%02d:%02d", h, m)
end

function Format.duration(seconds)
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%dh %02dm", h, m)
	elseif m > 0 then
		return string.format("%dm %02ds", m, s)
	end
	return string.format("%ds", s)
end

return Format
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000054"><Properties><string name="Name">RateLimit</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Token bucket rate limiter keyed by any value (player, player..remote, ...).
local RateLimit = {}
RateLimit.__index = RateLimit

function RateLimit.new(perSecond, burst)
	return setmetatable({ rate = perSecond, burst = burst or perSecond, buckets = {} }, RateLimit)
end

function RateLimit:check(key)
	local now = os.clock()
	local b = self.buckets[key]
	if not b then
		b = { tokens = self.burst, t = now }
		self.buckets[key] = b
	end
	b.tokens = math.min(self.burst, b.tokens + (now - b.t) * self.rate)
	b.t = now
	if b.tokens >= 1 then
		b.tokens -= 1
		return true
	end
	return false
end

function RateLimit:clear(key)
	self.buckets[key] = nil
end

return RateLimit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000055"><Properties><string name="Name">Signal</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Minimal signal implementation (connect / once / fire / wait).
local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(fn)
	local handler = { fn = fn, connected = true }
	table.insert(self._handlers, handler)
	local signal = self
	return {
		Disconnect = function()
			handler.connected = false
			local idx = table.find(signal._handlers, handler)
			if idx then
				table.remove(signal._handlers, idx)
			end
		end,
	}
end

function Signal:Once(fn)
	local conn
	conn = self:Connect(function(...)
		conn.Disconnect()
		fn(...)
	end)
	return conn
end

function Signal:Fire(...)
	for _, handler in ipairs(table.clone(self._handlers)) do
		if handler.connected then
			task.spawn(handler.fn, ...)
		end
	end
end

function Signal:Wait()
	local thread = coroutine.running()
	self:Once(function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal:DisconnectAll()
	table.clear(self._handlers)
end

return Signal
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000056"><Properties><string name="Name">TableUtil</string><ProtectedString name="Source"><![CDATA[--!nonstrict
local TableUtil = {}

function TableUtil.deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in pairs(value) do
		copy[TableUtil.deepCopy(k)] = TableUtil.deepCopy(v)
	end
	return copy
end

-- Fills missing keys of `target` from `defaults` (recursively for tables).
function TableUtil.reconcile(target, defaults)
	for k, v in pairs(defaults) do
		if target[k] == nil then
			target[k] = TableUtil.deepCopy(v)
		elseif type(v) == "table" and type(target[k]) == "table" and next(v) ~= nil and #v == 0 then
			TableUtil.reconcile(target[k], v)
		end
	end
	return target
end

function TableUtil.count(t)
	local n = 0
	for _ in pairs(t) do
		n += 1
	end
	return n
end

function TableUtil.keys(t)
	local out = {}
	for k in pairs(t) do
		table.insert(out, k)
	end
	return out
end

function TableUtil.map(list, fn)
	local out = {}
	for i, v in ipairs(list) do
		out[i] = fn(v, i)
	end
	return out
end

function TableUtil.filter(list, fn)
	local out = {}
	for _, v in ipairs(list) do
		if fn(v) then
			table.insert(out, v)
		end
	end
	return out
end

function TableUtil.indexBy(list, key)
	local out = {}
	for _, v in ipairs(list) do
		out[v[key]] = v
	end
	return out
end

function TableUtil.shuffle(list, rng)
	rng = rng or Random.new()
	for i = #list, 2, -1 do
		local j = rng:NextInteger(1, i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

function TableUtil.weightedPick(list, weightFn, rng)
	rng = rng or Random.new()
	local total = 0
	for _, v in ipairs(list) do
		total += math.max(0, weightFn(v))
	end
	if total <= 0 then
		return nil
	end
	local roll = rng:NextNumber() * total
	for _, v in ipairs(list) do
		roll -= math.max(0, weightFn(v))
		if roll <= 0 then
			return v
		end
	end
	return list[#list]
end

return TableUtil
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000057"><Properties><string name="Name">Uid</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Short unique ids for placed items, boxes, entities.
local Uid = {}

local counter = 0
local rng = Random.new()
local ALPHABET = "abcdefghijklmnopqrstuvwxyz0123456789"

function Uid.new(prefix)
	counter += 1
	local chars = {}
	for i = 1, 5 do
		local idx = rng:NextInteger(1, #ALPHABET)
		chars[i] = string.sub(ALPHABET, idx, idx)
	end
	return (prefix or "") .. string.format("%x", counter) .. table.concat(chars)
end

return Uid
]]></ProtectedString></Properties></Item></Item></Item><Item class="Folder" referent="RBX000060"><Properties><string name="Name">AssetOverrides</string></Properties></Item></Item><Item class="ServerScriptService" referent="RBX000091"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX000090"><Properties><string name="Name">Server</string></Properties><Item class="ModuleScript" referent="RBX000062"><Properties><string name="Name">Core</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Shared registry of server services (avoids circular requires).
local Core = {
	S = {},
	Started = false,
}
return Core
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX000063"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Server entry point: loads every service, then calls Init() and Start() in order.
local Core = require(script.Parent.Core)
local Services = script.Parent.Services

local ORDER = {
	"Net", "Data", "Session", "Economy", "Progression", "World", "Entities", "Placement", "Hands",
	"Supply", "Appliance", "Seating", "Cooking", "Npc", "Customers", "Tasks", "Staff", "Day",
	"Meta", "Franchise", "Monetization", "Leaderboard", "Interaction", "SelfTest", "Dev",
}

for _, name in ipairs(ORDER) do
	local module = Services:FindFirstChild(name)
	if module then
		local ok, svc = pcall(require, module)
		if ok then
			Core.S[name] = svc
		else
			warn("[Server] failed to load service " .. name .. ": " .. tostring(svc))
		end
	else
		warn("[Server] missing service " .. name)
	end
end

for _, name in ipairs(ORDER) do
	local svc = Core.S[name]
	if svc and svc.Init then
		local ok, err = pcall(svc.Init)
		if not ok then
			warn("[Server] " .. name .. ".Init failed: " .. tostring(err))
		end
	end
end

for _, name in ipairs(ORDER) do
	local svc = Core.S[name]
	if svc and svc.Start then
		task.spawn(function()
			local ok, err = pcall(svc.Start)
			if not ok then
				warn("[Server] " .. name .. ".Start failed: " .. tostring(err))
			end
		end)
	end
end

Core.Started = true
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX000089"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX000064"><Properties><string name="Name">Appliance</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Rice cookers, broth pots, sink, dishwasher, fridges and the clean/dirty dish pool.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Ingredients = require(Shared.Config.Ingredients)
local Color = require(Shared.Util.Color)
local Core = require(script.Parent.Parent.Core)

local Appliance = {}
local sinkPile = 0
local washerQueue = {} -- [uid] = count waiting
local washing = {} -- [uid] = true while animating

local function data()
	return Core.S.Session.ownerData()
end

local function state(uid)
	local d = data()
	d.appliances[uid] = d.appliances[uid] or { g = nil, n = 0, c = 0, t = 0 }
	return d.appliances[uid]
end

local function refresh(e)
	if not e or not e.model then
		return
	end
	local st = state(e.uid)
	local m = e.model
	m:SetAttribute("G", st.g or "")
	m:SetAttribute("N", st.n)
	m:SetAttribute("C", st.c)
	m:SetAttribute("T", st.t)
	m:SetAttribute("Batch", e.item.fn.batch or 0)
	m:SetAttribute("Time", e.item.fn.time or 0)
	local steam = m:FindFirstChild("Steam")
	local emitter = steam and steam:FindFirstChildOfClass("ParticleEmitter")
	if emitter then
		emitter.Enabled = st.c > 0 or (e.kind == "pot" and st.n > 0)
	end
	local led = m:FindFirstChild("Led")
	if led then
		led.Color = st.c > 0 and Color.hex("#FF3B4A") or (st.n > 0 and Color.hex("#6DDC5A") or Color.hex("#3A3A3A"))
	end
	local broth = m:FindFirstChild("Broth")
	if broth then
		local ing = st.g and Ingredients.byId[st.g]
		broth.Transparency = (st.n + st.c > 0) and 0 or 1
		if ing then
			broth.Color = Color.hex(ing.color)
		end
		local bubbles = broth:FindFirstChildOfClass("ParticleEmitter")
		if bubbles then
			bubbles.Enabled = st.c > 0
		end
	end
	local flame = m:FindFirstChild("Flame")
	if flame then
		flame.Transparency = st.c > 0 and 0 or 0.85
	end
end
Appliance.refresh = refresh

-- Loads a rice/broth box into a cooker or pot
function Appliance.load(actor, e)
	local Hands = Core.S.Hands
	local hands = Hands.get(actor)
	local st = state(e.uid)
	if hands.kind ~= "box" then
		if st.c > 0 then
			return false, "msg.cooking_wait"
		end
		return false, e.kind == "ricecooker" and "msg.need_rice_box" or "msg.need_broth_box"
	end
	local entry = hands.items[1]
	local ing = Ingredients.byId[entry.g]
	if e.kind == "ricecooker" and ing.storage ~= "rice" then
		return false, "msg.need_rice_box"
	elseif e.kind == "pot" and ing.storage ~= "broth" then
		return false, "msg.need_broth_box"
	end
	if st.c > 0 then
		return false, "msg.cooking_wait"
	end
	if st.n > 0 and st.g ~= entry.g then
		return false, "msg.pot_other_broth"
	end
	local batch = e.item.fn.batch
	local amount = math.min(entry.n, batch - st.n)
	if amount <= 0 then
		return false, "msg.appliance_full"
	end
	st.g = entry.g
	st.c = amount
	st.t = workspace:GetServerTimeNow() + e.item.fn.time
	entry.n -= amount
	if entry.n <= 0 then
		Core.S.Supply.removeBox(entry)
		Hands.clear(actor)
	else
		Hands.refresh(actor)
	end
	refresh(e)
	Core.S.Net.fx("sfx", { name = "pour", pos = e.model.PrimaryPart.Position })
	Core.S.Data.changed(Core.S.Session.owner, "appliances")
	return true
end

local function takeFrom(kind, g)
	for _, e in ipairs(Core.S.Entities.ofKind(kind)) do
		local st = state(e.uid)
		if st.n > 0 and (g == nil or st.g == g) then
			st.n -= 1
			if st.n <= 0 and st.c <= 0 then
				st.g = (kind == "ricecooker") and "rice" or nil
			end
			refresh(e)
			return true
		end
	end
	return false
end

function Appliance.hasRice()
	for _, e in ipairs(Core.S.Entities.ofKind("ricecooker")) do
		if state(e.uid).n > 0 then
			return true
		end
	end
	return false
end

function Appliance.hasBroth(g)
	for _, e in ipairs(Core.S.Entities.ofKind("pot")) do
		local st = state(e.uid)
		if st.n > 0 and st.g == g then
			return true
		end
	end
	return false
end

-- pending portions (cooking) count as "coming soon" for customer menus
function Appliance.willHave(kind, g)
	for _, e in ipairs(Core.S.Entities.ofKind(kind)) do
		local st = state(e.uid)
		if (st.n + st.c) > 0 and (g == nil or st.g == g) then
			return true
		end
	end
	return false
end

function Appliance.takeRice()
	return takeFrom("ricecooker", nil)
end

function Appliance.takeBroth(g)
	return takeFrom("pot", g)
end

-- Appliances that need refilling (for staff)
function Appliance.needsRefill()
	local out = {}
	for _, kind in ipairs({ "ricecooker", "pot" }) do
		for _, e in ipairs(Core.S.Entities.ofKind(kind)) do
			local st = state(e.uid)
			if st.c == 0 and st.n <= math.floor((e.item.fn.batch or 8) * 0.3) then
				table.insert(out, { entity = e, g = st.n > 0 and st.g or nil })
			end
		end
	end
	return out
end

------------------------------------------------------------------ dishes

function Appliance.takeCleanDish()
	local d = data()
	if d.dishes.clean > 0 then
		d.dishes.clean -= 1
		Core.S.Data.changed(Core.S.Session.owner, "dishes")
		return true
	end
	return false
end

function Appliance.addDirtyToSink(n)
	sinkPile += n
	workspace:SetAttribute("SinkPile", sinkPile)
end

function Appliance.sinkPile()
	return sinkPile
end

local function finishWash(count)
	local d = data()
	d.dishes.clean = math.min(d.dishes.total, d.dishes.clean + count)
	d.stats.washed = (d.stats.washed or 0) + count
	Core.S.Data.changed(Core.S.Session.owner, "dishes")
	Core.S.Meta.event(Core.S.Session.owner, "wash", count)
end

-- Sink: wash the dirty dishes in hands (or from the pile); duration scales with count
function Appliance.useSink(actor, e, speed)
	local Hands = Core.S.Hands
	if washing[e.uid] then
		return false, "msg.busy"
	end
	local hands = Hands.get(actor)
	local count = 0
	if hands.kind == "dirty" then
		count = #hands.items
		Hands.clear(actor)
	elseif hands.kind == nil and sinkPile > 0 then
		count = math.min(6, sinkPile)
		sinkPile -= count
		workspace:SetAttribute("SinkPile", sinkPile)
	else
		return false, sinkPile > 0 and "msg.hands_busy" or "msg.sink_hint"
	end
	washing[e.uid] = true
	local spout = e.model:FindFirstChild("Spout")
	local emitter = spout and spout:FindFirstChildOfClass("ParticleEmitter")
	if emitter then
		emitter.Enabled = true
	end
	e.model:SetAttribute("Busy", true)
	task.wait(math.max(0.6, 0.35 * count) / (speed or 1))
	if emitter then
		emitter.Enabled = false
	end
	e.model:SetAttribute("Busy", false)
	washing[e.uid] = nil
	finishWash(count)
	return true
end

function Appliance.useDishwasher(actor, e)
	local Hands = Core.S.Hands
	local hands = Hands.get(actor)
	if hands.kind ~= "dirty" then
		return false, "msg.sink_hint"
	end
	washerQueue[e.uid] = (washerQueue[e.uid] or 0) + #hands.items
	Hands.clear(actor)
	e.model:SetAttribute("Queue", washerQueue[e.uid])
	return true
end

local function dishwasherLoop()
	while true do
		task.wait(1)
		local now = os.clock()
		for _, e in ipairs(Core.S.Entities.ofKind("dishwasher")) do
			-- pull dirty dishes from the sink pile automatically
			if sinkPile > 0 and (washerQueue[e.uid] or 0) < e.item.fn.cap then
				local take = math.min(sinkPile, e.item.fn.cap - (washerQueue[e.uid] or 0))
				sinkPile -= take
				workspace:SetAttribute("SinkPile", sinkPile)
				washerQueue[e.uid] = (washerQueue[e.uid] or 0) + take
			end
			e.nextWash = e.nextWash or (now + e.item.fn.interval)
			local q = washerQueue[e.uid] or 0
			local steam = e.model:FindFirstChild("Steam")
			local emitter = steam and steam:FindFirstChildOfClass("ParticleEmitter")
			if emitter then
				emitter.Enabled = q > 0
			end
			if q > 0 and now >= e.nextWash then
				local n = math.min(q, e.item.fn.cap)
				washerQueue[e.uid] = q - n
				finishWash(n)
				e.nextWash = now + e.item.fn.interval
			elseif q == 0 then
				e.nextWash = now + e.item.fn.interval
			end
			e.model:SetAttribute("Queue", washerQueue[e.uid] or 0)
		end
	end
end

local function cookLoop()
	while true do
		task.wait(0.5)
		local now = workspace:GetServerTimeNow()
		for _, kind in ipairs({ "ricecooker", "pot" }) do
			for _, e in ipairs(Core.S.Entities.ofKind(kind)) do
				local d = data()
				local st = d and d.appliances[e.uid]
				if st and st.c > 0 and now >= st.t then
					st.n += st.c
					st.c = 0
					refresh(e)
					Core.S.Net.fx("ready", { pos = e.model.PrimaryPart.Position })
					Core.S.Data.changed(Core.S.Session.owner, "appliances")
				end
			end
		end
	end
end

function Appliance.fridgeNear(pos)
	for _, e in ipairs(Core.S.Entities.ofKind("fridge")) do
		local p = e.model.PrimaryPart.Position
		if (p - pos).Magnitude <= e.item.fn.radius then
			return true
		end
	end
	return false
end

function Appliance.Init()
	local Placement = Core.S.Placement
	Placement.ItemAdded:Connect(function(e)
		if e.kind == "ricecooker" or e.kind == "pot" then
			local st = state(e.uid)
			if e.kind == "ricecooker" then
				st.g = st.g or "rice"
			end
			-- anything that was cooking when the game was saved is ready now
			if st.c > 0 then
				st.n += st.c
				st.c = 0
			end
			refresh(e)
		end
	end)
	Placement.addVeto(function(e)
		if e.kind == "ricecooker" or e.kind == "pot" then
			local st = state(e.uid)
			if st.c > 0 then
				return false, "msg.cooking_wait"
			end
		elseif e.kind == "sink" and washing[e.uid] then
			return false, "msg.busy"
		end
		return true
	end)
end

function Appliance.Start()
	Core.S.Session.OwnerReady:Connect(function(_, d)
		d.dishes.clean = d.dishes.total -- everything was washed overnight
		sinkPile = 0
	end)
	task.spawn(cookLoop)
	task.spawn(dishwasherLoop)
end

return Appliance
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000065"><Properties><string name="Name">Cooking</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Stations: ingredients go on the board, each click runs the next step (cut, combine, roll,
-- boil, pour, top, fry...), then the dish waits on the plate. Also the order tickets.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Recipes = require(Shared.Config.Recipes)
local Ingredients = require(Shared.Config.Ingredients)
local Upgrades = require(Shared.Config.Upgrades)
local Formulas = require(Shared.Logic.Formulas)
local Registry = require(Shared.Models.Registry)
local Uid = require(Shared.Util.Uid)
local Core = require(script.Parent.Parent.Core)

local Cooking = {}
Cooking.tickets = {}

local TOOL_FOR_STEP = {
	cut = "knife", combine = "knife", roll = "mat", mold = "mat", boil = "strainer", pour = "ladle",
	top = "ladle", batter = "ladle", fry = "strainer", flip = "spatula",
}

local function data()
	return Core.S.Session.ownerData()
end

local function station(e)
	if not e.station then
		e.station = { board = {}, step = 0, busy = false, ready = nil, boardModels = {}, dish = nil }
	end
	return e.station
end

local function stationType(e)
	return e.item.fn.station
end

local function unlockedRecipes(e)
	local d = data()
	local out = {}
	for _, r in ipairs(Recipes.byStation[stationType(e)] or {}) do
		if Core.S.Progression.isRecipeUnlocked(d, r) then
			table.insert(out, r)
		end
	end
	return out
end

local function boardKey(board)
	local ids = {}
	for _, b in ipairs(board) do
		table.insert(ids, b.g)
	end
	table.sort(ids)
	return table.concat(ids, "+")
end

-- true if `ids` (multiset) is contained in some unlocked recipe of this station
local function fits(e, ids)
	for _, r in ipairs(unlockedRecipes(e)) do
		local need = {}
		for _, g in ipairs(r.ing) do
			need[g] = (need[g] or 0) + 1
		end
		local ok = true
		for _, g in ipairs(ids) do
			if not need[g] or need[g] == 0 then
				ok = false
				break
			end
			need[g] -= 1
		end
		if ok then
			return true
		end
	end
	return false
end

function Cooking.match(e)
	local key = boardKey(station(e).board)
	for _, r in ipairs(unlockedRecipes(e)) do
		if r.key == key then
			return r
		end
	end
	return nil
end

local function attachment(e, name)
	local root = e.model and e.model.PrimaryPart
	return root and root:FindFirstChild(name)
end

local function publish(e)
	local st = station(e)
	local m = e.model
	if not m then
		return
	end
	local ids = {}
	for _, b in ipairs(st.board) do
		table.insert(ids, b.g)
	end
	local recipe = Cooking.match(e)
	m:SetAttribute("Board", table.concat(ids, ","))
	m:SetAttribute("Recipe", recipe and recipe.id or "")
	m:SetAttribute("Step", st.step)
	m:SetAttribute("Steps", recipe and table.concat(recipe.steps, ",") or "")
	m:SetAttribute("Busy", st.busy)
	m:SetAttribute("Ready", st.ready and st.ready.recipe or "")
end

local function clearBoardModels(st)
	for _, mdl in ipairs(st.boardModels) do
		mdl:Destroy()
	end
	st.boardModels = {}
end

local function layoutBoard(e)
	local st = station(e)
	clearBoardModels(st)
	local att = attachment(e, "Board")
	if not att then
		return
	end
	local n = #st.board
	for i, b in ipairs(st.board) do
		local mdl = Registry.food("ingredient", b.g)
		local x = (i - (n + 1) / 2) * 0.55
		mdl:PivotTo(att.WorldCFrame * CFrame.new(x, 0.3, 0) * CFrame.Angles(0, math.rad(90), 0))
		mdl:ScaleTo(0.8)
		for _, d in ipairs(mdl:GetDescendants()) do
			if d:IsA("BasePart") then
				d.CanQuery = false
			end
		end
		mdl.Parent = e.model
		table.insert(st.boardModels, mdl)
	end
end

local function stepDuration(e, stepName, recipe, speed)
	local d = data()
	local cfg = GameConfig.Steps[stepName] or { time = 1, tool = "up_knife" }
	local t = cfg.time * Upgrades.value(d.upgrades, cfg.tool)
	local mastery = Formulas.masteryLevel(d.mastery[recipe.id] or 0)
	t = t * (1 - 0.05 * mastery)
	return math.max(0.25, t / (speed or 1))
end

local function animateStep(e, stepName, duration)
	local st = station(e)
	local toolAtt = attachment(e, "Tool")
	local boardAtt = attachment(e, "Board")
	if not toolAtt or not boardAtt then
		task.wait(duration)
		return
	end
	local tool = Registry.food("tool", TOOL_FOR_STEP[stepName] or "knife")
	for _, d in ipairs(tool:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanQuery = false
		end
	end
	tool.Parent = e.model
	local top = toolAtt.WorldCFrame
	local low = boardAtt.WorldCFrame * CFrame.new(0, 0.45, 0)
	local steps = math.max(8, math.floor(duration / 0.04))
	local pos = boardAtt.WorldPosition
	if stepName == "cut" then
		Core.S.Net.fx("sfx", { name = "cut", pos = pos })
	elseif stepName == "boil" or stepName == "fry" then
		Core.S.Net.fx("sfx", { name = "sizzle", pos = pos })
	elseif stepName == "pour" then
		Core.S.Net.fx("sfx", { name = "pour", pos = pos })
	end
	local startScales = {}
	for i, mdl in ipairs(st.boardModels) do
		startScales[i] = mdl:GetPivot()
	end
	for k = 1, steps do
		local t = k / steps
		if stepName == "cut" then
			local chop = math.abs(math.sin(t * math.pi * 3))
			tool:PivotTo(low:Lerp(top, chop * 0.6) * CFrame.new(0.2 * math.sin(t * math.pi * 6), 0, 0))
		elseif stepName == "roll" or stepName == "mold" then
			tool:PivotTo(low * CFrame.Angles(t * math.pi * 2, 0, 0))
		elseif stepName == "combine" then
			tool:PivotTo(top:Lerp(low, math.sin(t * math.pi) * 0.8))
			for i, mdl in ipairs(st.boardModels) do
				local from = startScales[i]
				mdl:PivotTo(from:Lerp(boardAtt.WorldCFrame * CFrame.new(0, 0.3, 0), t))
			end
		else
			tool:PivotTo(top:Lerp(low, math.abs(math.sin(t * math.pi * 2)) * 0.8) * CFrame.Angles(0, 0, math.sin(t * math.pi * 4) * 0.3))
		end
		task.wait(duration / steps)
	end
	tool:Destroy()
end

local function showDish(e, recipeId)
	local st = station(e)
	if st.dish then
		st.dish:Destroy()
	end
	local att = attachment(e, "Plate")
	if not att then
		return
	end
	local d = data()
	local gold = Formulas.masteryLevel(d.mastery[recipeId] or 0) >= #Formulas.MasteryThresholds
	local mdl = Registry.food("dish", recipeId, gold)
	mdl:PivotTo(att.WorldCFrame * CFrame.new(0, 0.5, 0))
	for _, d in ipairs(mdl:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanQuery = false
		end
	end
	mdl.Parent = e.model
	st.dish = mdl
end

local function isFresh(e, st)
	for _, b in ipairs(st.board) do
		if b.fresh then
			return true
		end
	end
	return Core.S.Appliance.fridgeNear(e.model.PrimaryPart.Position)
end

-- Runs the next step. Returns ok, messageKey, params
function Cooking.step(e, speed)
	local st = station(e)
	local recipe = Cooking.match(e)
	if not recipe then
		return false, "msg.no_recipe_fits"
	end
	local Appliance = Core.S.Appliance
	if st.step == 0 then
		if recipe.rice and not Appliance.hasRice() then
			return false, "msg.need_rice"
		end
		if recipe.broth and not Appliance.hasBroth(recipe.broth) then
			return false, "msg.need_broth", { name = "ing." .. recipe.broth }
		end
		if data().dishes.clean <= 0 then
			return false, "msg.no_dishes"
		end
		if recipe.rice then
			Appliance.takeRice()
		end
		if recipe.broth then
			Appliance.takeBroth(recipe.broth)
		end
		Appliance.takeCleanDish()
		st.recipe = recipe.id
	end
	st.busy = true
	publish(e)
	local stepName = recipe.steps[st.step + 1]
	animateStep(e, stepName, stepDuration(e, stepName, recipe, speed))
	st.step += 1
	st.busy = false
	if st.step >= #recipe.steps then
		local fresh = isFresh(e, st)
		st.board = {}
		clearBoardModels(st)
		st.step = 0
		st.recipe = nil
		st.ready = { recipe = recipe.id, fresh = fresh }
		showDish(e, recipe.id)
		Core.S.Net.fx("dishReady", { pos = e.model.PrimaryPart.Position + Vector3.new(0, 4, 0), recipe = recipe.id })
	end
	publish(e)
	return true
end

-- Click on a station (players and staff)
function Cooking.use(actor, e, speed)
	local Hands = Core.S.Hands
	local st = station(e)
	local hands = Hands.get(actor)
	if st.busy then
		return false, "msg.busy"
	end
	if hands.kind == "ing" then
		local deposited = 0
		local remaining = {}
		local ids = {}
		for _, b in ipairs(st.board) do
			table.insert(ids, b.g)
		end
		for _, item in ipairs(hands.items) do
			local test = table.clone(ids)
			table.insert(test, item.g)
			if fits(e, test) then
				ids = test
				table.insert(st.board, item)
				deposited += 1
			else
				table.insert(remaining, item)
			end
		end
		if deposited == 0 then
			return false, (#st.board == 0) and "msg.no_recipe_fits" or "msg.not_for_this"
		end
		Hands.set(actor, "ing", remaining)
		layoutBoard(e)
		publish(e)
		return true
	elseif hands.kind == "dish" or hands.kind == nil then
		if st.ready then
			local ok, reason = Hands.add(actor, "dish", { recipe = st.ready.recipe, fresh = st.ready.fresh })
			if not ok then
				return false, reason
			end
			st.ready = nil
			if st.dish then
				st.dish:Destroy()
				st.dish = nil
			end
			publish(e)
			return true
		end
		if hands.kind == "dish" then
			return false, "msg.hands_busy"
		end
		if #st.board > 0 then
			if Cooking.match(e) then
				return Cooking.step(e, speed)
			end
			-- not a recipe (yet): put the ingredients back in hand
			if st.step == 0 then
				Hands.set(actor, "ing", st.board)
				st.board = {}
				layoutBoard(e)
				publish(e)
				return false, "msg.board_returned"
			end
		end
		return false, "msg.station_hint", { station = "station." .. stationType(e) }
	end
	return false, "msg.hands_busy"
end

------------------------------------------------------------------ tickets

function Cooking.maxTickets()
	return Upgrades.value(data().upgrades, "up_ticket")
end

local function broadcast()
	local list = {}
	for _, t in ipairs(Cooking.tickets) do
		table.insert(list, { id = t.id, recipe = t.recipe, created = t.created, customer = t.customer, claimed = t.claimed ~= nil })
	end
	Core.S.Net.fireAll("Tickets", list)
end

function Cooking.addTicket(customerUid, recipeId)
	if #Cooking.tickets >= Cooking.maxTickets() then
		return nil
	end
	local t = { id = Uid.new("t"), recipe = recipeId, customer = customerUid, created = workspace:GetServerTimeNow() }
	table.insert(Cooking.tickets, t)
	broadcast()
	return t
end

function Cooking.removeTicket(id)
	for i, t in ipairs(Cooking.tickets) do
		if t.id == id then
			table.remove(Cooking.tickets, i)
			broadcast()
			return t
		end
	end
	return nil
end

function Cooking.ticketFor(customerUid)
	for _, t in ipairs(Cooking.tickets) do
		if t.customer == customerUid then
			return t
		end
	end
	return nil
end

function Cooking.clearTickets()
	Cooking.tickets = {}
	broadcast()
end

-- Dishes ready on stations (for waiters)
function Cooking.readyDishes()
	local out = {}
	for _, e in ipairs(Core.S.Entities.ofKind("station")) do
		local st = station(e)
		if st.ready then
			table.insert(out, { entity = e, recipe = st.ready.recipe })
		end
	end
	return out
end

function Cooking.stationState(e)
	return station(e)
end

function Cooking.isRecipeInProgress(recipeId)
	local n = 0
	for _, e in ipairs(Core.S.Entities.ofKind("station")) do
		local st = station(e)
		if st.recipe == recipeId or (st.ready and st.ready.recipe == recipeId) then
			n += 1
		end
	end
	return n
end

function Cooking.Init()
	local Placement = Core.S.Placement
	Placement.ItemAdded:Connect(function(e)
		if e.kind == "station" then
			publish(e)
		end
	end)
	Placement.ItemMoved:Connect(function(e)
		if e.kind == "station" then
			layoutBoard(e)
			if station(e).ready then
				showDish(e, station(e).ready.recipe)
			end
		end
	end)
	Placement.addVeto(function(e)
		if e.kind == "station" then
			local st = station(e)
			if st.busy or #st.board > 0 or st.ready then
				return false, "msg.empty_first"
			end
		end
		return true
	end)
	local _ = Ingredients
end

return Cooking
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000066"><Properties><string name="Name">Customers</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Customers: arrive from the street, take a seat, order, wait (patience), eat, pay, review, leave.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Customers = require(Shared.Config.Customers)
local Recipes = require(Shared.Config.Recipes)
local Expansions = require(Shared.Config.Expansions)
local Formulas = require(Shared.Logic.Formulas)
local TableUtil = require(Shared.Util.TableUtil)
local Registry = require(Shared.Models.Registry)
local Uid = require(Shared.Util.Uid)
local Core = require(script.Parent.Parent.Core)

local Service = {}
Service.active = {} -- [uid] = customer
local queue = {} -- waiting groups
local rng = Random.new()
local menuCache, menuCacheTime = nil, 0

local CFG = GameConfig.Customers
local MAIN = { sushi = true, ramen = true }

local function data()
	return Core.S.Session.ownerData()
end

------------------------------------------------------------------ menu availability

function Service.availableMenu()
	if menuCache and os.clock() - menuCacheTime < 2 then
		return menuCache
	end
	local d = data()
	local out = {}
	if not d then
		return out
	end
	local Supply, Appliance = Core.S.Supply, Core.S.Appliance
	local stations = {}
	for _, e in ipairs(Core.S.Entities.ofKind("station")) do
		stations[e.item.fn.station] = true
	end
	for _, r in ipairs(Core.S.Progression.menuRecipes(d)) do
		local ok = stations[r.station] == true
		if ok then
			for _, g in ipairs(r.ing) do
				if Supply.shelfStock(g) <= 0 and Supply.boxCount(g) <= 0 then
					ok = false
					break
				end
			end
		end
		if ok and r.rice and not (Appliance.willHave("ricecooker") or Supply.boxCount("rice") > 0) then
			ok = false
		end
		if ok and r.broth and not (Appliance.willHave("pot", r.broth) or Supply.boxCount(r.broth) > 0) then
			ok = false
		end
		if ok then
			table.insert(out, r)
		end
	end
	menuCache, menuCacheTime = out, os.clock()
	return out
end

local function chooseOrder(c, mainOnly)
	local d = data()
	local menu = Service.availableMenu()
	local list = {}
	for _, r in ipairs(menu) do
		local isMain = MAIN[r.cat] == true
		if (mainOnly and isMain) or (not mainOnly and not isMain) then
			table.insert(list, r)
		end
	end
	if #list == 0 then
		if mainOnly then
			list = menu
		else
			return nil
		end
	end
	local prefer = {}
	for _, p in ipairs(c.cfg.prefer) do
		prefer[p] = true
	end
	local pick = TableUtil.weightedPick(list, function(r)
		local m = d.menu[r.id]
		local w = Formulas.demandFactor(m and m.price or 1)
		if prefer[r.cat] then
			w *= 2
		end
		if prefer.cheap and r.price <= 60 then
			w *= 2
		end
		if prefer.expensive and r.price >= 150 then
			w *= 2.5
		end
		if prefer.mastery and Formulas.masteryLevel(d.mastery[r.id] or 0) >= 2 then
			w *= 3
		end
		return w
	end, rng)
	return pick
end

------------------------------------------------------------------ helpers

local function setState(c, state)
	c.state = state
	if c.npc and c.npc.model then
		c.npc.model:SetAttribute("State", state)
	end
end

local function setOrder(c, recipe)
	c.order = recipe and recipe.id or nil
	if c.npc and c.npc.model then
		c.npc.model:SetAttribute("Order", c.order or "")
	end
end

local function patienceTick(c, dt)
	c.patience = math.max(0, c.patience - dt)
	c.minPatience = math.min(c.minPatience, c.patience / c.patienceMax)
	if c.npc and c.npc.model then
		c.npc.model:SetAttribute("Patience", c.patience / c.patienceMax)
	end
end

local function floorPos(seat)
	local p = seat.sit.Position
	local floorY = Core.S.World.floorY(seat.floor)
	local back = -seat.sit.LookVector * 1.4
	return Vector3.new(p.X + back.X, floorY + 0.5, p.Z + back.Z)
end

local function dirtyNear(pos)
	for _, e in ipairs(Core.S.Entities.ofKind("dirty")) do
		local p = Core.S.Entities.position(e)
		if p and (p - pos).Magnitude < 6 then
			return true
		end
	end
	return false
end

local function streetPoint(side)
	return Vector3.new(side * (70 + rng:NextNumber() * 20), 0, Expansions.StreetWalkZ)
end

local function entrance()
	return Vector3.new(Expansions.Entrance.x + rng:NextNumber() * 2 - 1, 0, Expansions.Entrance.z - 1)
end

local function dishKind(recipeId)
	local r = Recipes.byId[recipeId]
	if r and (r.dish == "bowl" or r.dish == "soup" or r.dish == "tsukemen") then
		return "bowl"
	end
	return "plate"
end

------------------------------------------------------------------ lifecycle

local function release(c)
	Service.active[c.uid] = nil
	Core.S.Entities.unregister(c.uid)
	if c.ticket then
		Core.S.Cooking.removeTicket(c.ticket.id)
		c.ticket = nil
	end
	if c.seat then
		c.seat.occupant = nil
		c.seat.reserved = nil
	end
	if c.dishModel then
		c.dishModel:Destroy()
		c.dishModel = nil
	end
	if c.bench then
		Core.S.Seating.freeBench(c.bench)
		c.bench = nil
	end
	if c.npc then
		c.npc.model:SetAttribute("State", nil)
		c.npc.model:SetAttribute("Order", nil)
		Core.S.Npc.release(c.npc)
		c.npc = nil
	end
end

local function leaveRestaurant(c)
	local Npc = Core.S.Npc
	setState(c, "leaving")
	setOrder(c, nil)
	if c.npc then
		Npc.stand(c.npc)
		Npc.walkTo(c.npc, entrance())
		Npc.walkTo(c.npc, streetPoint(c.side))
	end
	release(c)
end

local function review(c, walkedOut)
	local Progression, Economy = Core.S.Progression, Core.S.Economy
	local amb = Core.S.Placement.ambience
	local pos = c.seat and c.seat.dish or Vector3.new()
	local stars = Formulas.review({
		left = walkedOut,
		patienceLeft = c.minPatience,
		dirtyNearby = dirtyNear(pos),
		fresh = c.fresh,
		freshBonus = GameConfig.FreshReviewBonus,
		ambienceTier = amb.tier,
		comfort = c.seat and c.seat.comfort or 0,
	})
	Progression.addReview(stars, c.cfg.reviewWeight or 1)
	local L = Economy.ledger
	L.reviews += 1
	L.stars += stars
	if walkedOut then
		L.walkouts += 1
	else
		L.customers += 1
	end
	local owner = Core.S.Session.owner
	Core.S.Net.fx("review", { stars = stars, pos = (c.npc and c.npc.root and c.npc.root.Position or pos) + Vector3.new(0, 3, 0), type = c.cfg.id })
	if not walkedOut then
		Core.S.Meta.event(owner, "customers", 1)
		if stars >= 4 then
			Core.S.Meta.event(owner, "happy", 1)
		end
		local d = data()
		d.stats.customers += 1
		if stars >= 5 and c.cfg.reviewWeight then
			Economy.addSakura(owner, 3)
			Core.S.Net.notifyAll("msg.critic_happy", nil, "success")
		end
		if stars >= 5 and c.cfg.influencer then
			d.boosts.influencer = (d.stats.days or 0) + 2
			Core.S.Net.notifyAll("msg.influencer_happy", nil, "success")
		end
	else
		Core.S.Net.notifyAll("msg.customer_left", nil, "warning")
	end
end

local function pay(c, recipe)
	local d = data()
	local Economy = Core.S.Economy
	local owner = Core.S.Session.owner
	local amb = Core.S.Placement.ambience
	local price = Core.S.Progression.priceOf(d, recipe)
	local tip = Formulas.tip(price, {
		fresh = c.fresh,
		freshBonus = GameConfig.FreshTipBonus,
		ambienceTip = amb.tip,
		comfort = c.seat and c.seat.comfort or 0,
		patienceLeft = c.patience / c.patienceMax,
		customerTip = c.cfg.tip,
	})
	local got = Economy.add(owner, price, "sale")
	local gotTip = Economy.add(owner, tip, "tip")
	local helper = c.servedBy
	if helper and typeof(helper) == "Instance" and helper ~= owner and helper.Parent then
		local share = math.floor((price + tip) * GameConfig.HelperRewardShare + 0.5)
		Economy.add(helper, share, "helper")
		Core.S.Progression.addXp(helper, math.floor(recipe.xp * 0.5))
	end
	Core.S.Net.fx("money", { amount = got + gotTip, tip = gotTip, pos = (c.npc and c.npc.root and c.npc.root.Position or c.seat.dish) + Vector3.new(0, 3, 0) })
	Core.S.Net.fx("sfx", { name = "coin", pos = c.seat.dish })
end

local function eat(c, recipe)
	setState(c, "eating")
	local eatTime = CFG.EatTime[recipe.cat] or 10
	task.wait(eatTime * (0.85 + rng:NextNumber() * 0.3))
	if c.dishModel then
		c.dishModel:Destroy()
		c.dishModel = nil
	end
	pay(c, recipe)
	c.dishKind = dishKind(recipe.id)
	c.eaten += 1
end

local function leaveDirty(c)
	if not c.seat or c.eaten == 0 then
		return
	end
	local m = Registry.food("dirty", c.dishKind or "plate")
	m:PivotTo(CFrame.new(c.seat.dish + Vector3.new(0, 0.3, 0)))
	m.Parent = Core.S.World.folders().dynamic
	local uid = Uid.new("d")
	Core.S.Entities.register(uid, "dirty", m, { seat = c.seat })
	c.seat.dirty = uid
end

-- Main AI for one customer
local function run(c)
	local Npc = Core.S.Npc
	local Seating = Core.S.Seating
	-- walk in
	Npc.walkTo(c.npc, entrance())
	-- wait in queue until a seat is free
	if not c.seat then
		setState(c, "queue")
		c.bench = Seating.benchSpot(c.uid)
		if c.bench then
			Npc.walkTo(c.npc, c.bench.sit.Position)
			Npc.sit(c.npc, c.bench.sit)
		end
		local waited = 0
		while not c.seat and waited < 60 do
			task.wait(1)
			waited += 1
			if c.groupLeader == c and c.groupSeatsReady then
				break
			end
			if c.assignedSeat then
				c.seat = c.assignedSeat
			end
		end
		if c.bench then
			Npc.stand(c.npc)
			Seating.freeBench(c.bench)
			c.bench = nil
		end
		if not c.seat then
			return leaveRestaurant(c)
		end
	end
	setState(c, "walking")
	c.seat.occupant = c.uid
	Npc.walkTo(c.npc, floorPos(c.seat))
	Npc.sit(c.npc, c.seat.sit)
	setState(c, "reading")
	task.wait(rng:NextNumber() * (CFG.MenuReadTime[2] - CFG.MenuReadTime[1]) + CFG.MenuReadTime[1])
	local ordersLeft = c.cfg.ordersEach or 1
	local first = true
	while ordersLeft > 0 do
		local recipe = chooseOrder(c, first)
		if not recipe then
			break
		end
		setOrder(c, recipe)
		c.patience = c.patienceMax * (first and 1 or 0.85)
		setState(c, "order")
		-- wait to be noticed / served
		while c.state == "order" or c.state == "waiting" do
			task.wait(0.5)
			patienceTick(c, 0.5)
			if c.patience <= 0 then
				review(c, true)
				if c.npc and c.npc.play then
					Npc.emote(c.npc, "wave")
				end
				return leaveRestaurant(c)
			end
			local phase = Core.S.Day.phase
			if phase == "report" or phase == "prep" then
				return leaveRestaurant(c)
			end
		end
		if c.state ~= "served" then
			return leaveRestaurant(c)
		end
		eat(c, recipe)
		ordersLeft -= 1
		first = false
		if ordersLeft == 0 and c.eaten == 1 and rng:NextNumber() < CFG.ExtraOrderChance then
			ordersLeft = 1
		end
	end
	review(c, false)
	if c.npc then
		Npc.emote(c.npc, "cheer")
	end
	task.wait(0.8)
	leaveDirty(c)
	if c.seat then
		c.seat.occupant = nil
		c.seat.reserved = nil
	end
	leaveRestaurant(c)
end

local function spawnCustomer(cfg, side, seat, group)
	local npc = Core.S.Npc.acquireCustomer(cfg.look)
	if not npc then
		return nil
	end
	local uid = Uid.new("c")
	local d = data()
	local amb = Core.S.Placement.ambience
	local patience = cfg.patience
	local clock = Core.S.Day.clock or 12
	if cfg.lunchPatience and clock >= 12 and clock < 14 then
		patience = cfg.lunchPatience
	end
	patience = patience * (1 + amb.patience)
	local c = {
		uid = uid, cfg = cfg, npc = npc, seat = seat, side = side, state = "arriving", group = group,
		patienceMax = patience, patience = patience, minPatience = 1, eaten = 0, fresh = false,
	}
	local _ = d
	Service.active[uid] = c
	Core.S.Entities.register(uid, "customer", npc.model, { customer = c })
	npc.model:SetAttribute("Type", cfg.id)
	npc.model:SetAttribute("Patience", 1)
	local start = streetPoint(side)
	Core.S.Npc.spawn(npc, CFrame.new(start + Vector3.new(0, 3, 0)) * CFrame.Angles(0, math.rad(side > 0 and 90 or -90), 0))
	task.spawn(function()
		local ok, err = pcall(run, c)
		if not ok then
			warn("[Customers] " .. tostring(err))
			release(c)
		end
	end)
	return c
end

local function pickType(d)
	local list = {}
	local hasTables = false
	local hasVip = false
	for _, s in ipairs(Core.S.Seating.seats) do
		if s.group and not s.vip then
			hasTables = true
		end
		if s.vip then
			hasVip = true
		end
	end
	for _, cfg in ipairs(Customers.list) do
		if d.level >= cfg.lv and (not cfg.needsTable or hasTables) and (not cfg.vip or hasVip) and (cfg.group[1] == 1 or hasTables or cfg.vip) then
			table.insert(list, cfg)
		end
	end
	local tourists = false
	for id, day in pairs(d.ads or {}) do
		if id == "ad_tv" and day == (d.stats.days or 0) + 1 then
			tourists = true
		end
	end
	return TableUtil.weightedPick(list, function(cfg)
		if tourists and cfg.id == "cust_tourist" then
			return cfg.weight * 2
		end
		return cfg.weight
	end, rng)
end

function Service.trySpawn(forcedType)
	local d = data()
	if not d then
		return false
	end
	if Core.S.Npc.count() >= CFG.MaxNpcs then
		return false
	end
	if #Service.availableMenu() == 0 then
		if not Service.warnedMenu then
			Service.warnedMenu = true
			Core.S.Net.notifyAll("msg.no_menu", nil, "warning")
		end
		return false
	end
	Service.warnedMenu = false
	local cfg = forcedType and Customers.byId[forcedType] or pickType(d)
	if not cfg then
		return false
	end
	local size = rng:NextInteger(cfg.group[1], cfg.group[2])
	local needsTable = cfg.needsTable or size > 1
	local seats = Core.S.Seating.find(size, needsTable, cfg.vip == true)
	local side = rng:NextNumber() < 0.5 and -1 or 1
	if not seats then
		-- queue (only if there is room)
		local waiting = 0
		for _, g in ipairs(queue) do
			waiting += #g.members
		end
		if waiting + size > CFG.BaseQueue + Core.S.Seating.queueCapacity() then
			return false
		end
		local group = { members = {}, size = size, needsTable = needsTable, vip = cfg.vip == true }
		for _ = 1, size do
			local c = spawnCustomer(cfg, side, nil, group)
			if c then
				table.insert(group.members, c)
			end
		end
		table.insert(queue, group)
		return true
	end
	Core.S.Seating.reserve(seats, "pending")
	local group = { members = {} }
	for i = 1, size do
		local c = spawnCustomer(cfg, side, seats[i], group)
		if c then
			seats[i].reserved = c.uid
			table.insert(group.members, c)
		else
			Core.S.Seating.release(seats[i])
		end
		task.wait(0.4)
	end
	if cfg.celebrity then
		Core.S.Net.notifyAll("msg.celebrity", nil, "success")
		task.spawn(function()
			for _ = 1, 4 do
				task.wait(2)
				Service.trySpawn("cust_student")
			end
		end)
	end
	return true
end

local function serveQueue()
	for i = #queue, 1, -1 do
		local g = queue[i]
		local alive = {}
		for _, c in ipairs(g.members) do
			if Service.active[c.uid] and c.state == "queue" then
				table.insert(alive, c)
			end
		end
		if #alive == 0 then
			table.remove(queue, i)
		else
			local seats = Core.S.Seating.find(#alive, g.needsTable and #alive > 1, g.vip)
			if seats then
				for k, c in ipairs(alive) do
					seats[k].reserved = c.uid
					c.assignedSeat = seats[k]
				end
				table.remove(queue, i)
			end
		end
	end
end

------------------------------------------------------------------ interaction

function Service.use(actor, e)
	local c = e.customer
	if not c then
		return false
	end
	local Hands = Core.S.Hands
	if c.state == "order" then
		local t = Core.S.Cooking.addTicket(c.uid, c.order)
		if not t then
			return false, "msg.tickets_full"
		end
		c.ticket = t
		setState(c, "waiting")
		Core.S.Net.fx("sfx", { name = "click", pos = Core.S.Entities.position(e) })
		return true
	elseif c.state == "waiting" then
		local hands = Hands.get(actor)
		if hands.kind == "dish" then
			for i, dish in ipairs(hands.items) do
				if dish.recipe == c.order then
					Hands.removeAt(actor, i)
					Service.serve(c, dish, actor)
					return true
				end
			end
			return false, "msg.wrong_dish", { dish = "rec." .. c.order }
		end
		return false, "msg.customer_waits", { dish = "rec." .. c.order }
	elseif c.state == "reading" or c.state == "walking" then
		return false, "msg.customer_reading"
	end
	return false, "msg.customer_happy"
end

function Service.serve(c, dish, actor)
	local recipe = Recipes.byId[dish.recipe]
	if c.ticket then
		Core.S.Cooking.removeTicket(c.ticket.id)
		c.ticket = nil
	end
	c.fresh = dish.fresh == true
	c.servedBy = actor
	local served = data().mastery[dish.recipe] or 0
	local m = Registry.food("dish", dish.recipe, Formulas.masteryLevel(served) >= #Formulas.MasteryThresholds)
	m:PivotTo(CFrame.new(c.seat.dish + Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, math.rad(rng:NextInteger(0, 359)), 0))
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanQuery = false
		end
	end
	m.Parent = Core.S.World.folders().dynamic
	c.dishModel = m
	setState(c, "served")
	local d = data()
	local owner = Core.S.Session.owner
	d.stats.dishes += 1
	Core.S.Economy.ledger.served += 1
	Core.S.Economy.ledger.bestDish[recipe.id] = (Core.S.Economy.ledger.bestDish[recipe.id] or 0) + 1
	Core.S.Progression.addMastery(recipe.id)
	Core.S.Progression.addXp(owner, recipe.xp)
	Core.S.Meta.event(owner, "serve", 1, { recipe = recipe.id })
	if recipe.cat == "sushi" then
		Core.S.Meta.event(owner, "serve_sushi", 1)
	elseif recipe.cat == "ramen" then
		Core.S.Meta.event(owner, "serve_ramen", 1)
	end
	Core.S.Data.changed(owner, "stats")
end

function Service.collectDirty(actor, e)
	local Hands = Core.S.Hands
	local ok, reason = Hands.add(actor, "dirty", { dish = "plate" })
	if not ok then
		return false, reason
	end
	if e.seat then
		e.seat.dirty = nil
	end
	Core.S.Entities.unregister(e.uid)
	if e.model then
		e.model:Destroy()
	end
	return true
end

-- customers waiting to order (for waiters) and waiting food
function Service.list(state)
	local out = {}
	for _, c in pairs(Service.active) do
		if c.state == state then
			table.insert(out, c)
		end
	end
	return out
end

function Service.sendAllHome()
	for _, c in pairs(Service.active) do
		c.state = "leaving"
	end
end

------------------------------------------------------------------ loop

local function spawnLoop()
	local timer = 0
	while true do
		local dt = task.wait(0.5)
		serveQueue()
		local Day = Core.S.Day
		if Day and Day.phase == "open" and Core.S.Session.owner then
			timer += dt
			local pop = Core.S.Progression.popularity()
			local interval = Formulas.customerInterval(CFG.BaseInterval, CFG.MinInterval, pop, Day.isPeak(), GameConfig.Day.PeakFactor, Core.S.Economy.boostActive("rush"))
			if Core.S.Seating.freeCount() == 0 then
				interval = interval * 1.5
			end
			if timer >= interval then
				timer = 0
				pcall(Service.trySpawn)
			end
		else
			timer = 0
		end
	end
end

function Service.Start()
	task.spawn(spawnLoop)
end

return Service
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000067"><Properties><string name="Name">Data</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Player profiles: loading, session locking, autosave, migrations and replication to clients.
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local StarterLayout = require(Shared.Config.StarterLayout)
local Surfaces = require(Shared.Config.Surfaces)
local Recipes = require(Shared.Config.Recipes)
local TableUtil = require(Shared.Util.TableUtil)
local Uid = require(Shared.Util.Uid)
local Signal = require(Shared.Util.Signal)
local Core = require(script.Parent.Parent.Core)

local Data = {}
Data.Loaded = Signal.new() -- (player, data)
Data.Changed = Signal.new() -- (player, key)

local VERSION = 1
local profiles = {} -- [player] = { data, key, loaded, saving }
local store = nil
local storeOk = false

-- Keys of the owner's profile that describe the restaurant (sent to every player in the world)
Data.WorldKeys = {
	"level", "xp", "licenses", "menu", "mastery", "upgrades", "zones", "surfaces", "placed",
	"staff", "reviews", "dishes", "franchise", "boosts", "ads", "perms", "stats", "storage",
	"shelves", "appliances", "inventory", "yen", "sakura", "settings",
}
local WORLD_KEY_SET = {}
for _, k in ipairs(Data.WorldKeys) do
	WORLD_KEY_SET[k] = true
end

function Data.newProfile()
	local d = {
		v = VERSION,
		yen = GameConfig.StartYen,
		sakura = 0,
		xp = 0,
		level = 1,
		reviews = { recent = {}, total = 0, sum = 0 },
		stats = { dishes = 0, customers = 0, earned = 0, days = 0, five_stars = 0, washed = 0, decor = 0, gold_mastery = 0, lastDayEarned = 0, dayHistory = {} },
		licenses = { lic_base = true },
		menu = {},
		mastery = {},
		upgrades = {},
		zones = { zone_base = true },
		surfaces = {},
		placed = {},
		inventory = {},
		storage = {},
		shelves = {},
		appliances = {},
		dishes = { clean = GameConfig.StartDishes, total = GameConfig.StartDishes },
		staff = {},
		ads = {},
		boosts = {},
		meta = { quests = {}, questDay = 0, achievements = {}, daily = { streak = 0, last = 0 }, lastSeen = 0, tutorial = 0, offlinePending = 0 },
		franchise = { stars = 0, city = "tokyo" },
		perms = {},
		settings = { lang = "auto", grid = 1, rot = 90, music = 0.5, sfx = 0.8, lowGfx = false, autoDay = false },
		passes = {},
		receipts = {},
		created = os.time(),
	}
	for _, r in ipairs(Recipes.list) do
		if r.license == "lic_base" then
			d.menu[r.id] = { on = true, price = 1 }
		end
	end
	local uids = {}
	for idx, s in ipairs(StarterLayout.items) do
		local e = { u = Uid.new("p"), i = s.i, x = s.x, z = s.z, r = s.r or 0, f = 0, s = s.s, t = 0 }
		if s.y then
			e.y = s.y
		end
		uids[idx] = e.u
		table.insert(d.placed, e)
	end
	local ItemsCfg = require(Shared.Config.Items)
	for idx, s in ipairs(StarterLayout.items) do
		if s.p then
			d.placed[idx].p = uids[s.p]
			local parent = StarterLayout.items[s.p]
			d.placed[idx].y = ItemsCfg.byId[parent.i].size[2]
		end
	end
	for _, b in ipairs(StarterLayout.boxes) do
		local ing = require(Shared.Config.Ingredients).byId[b.g]
		for _ = 1, b.n do
			table.insert(d.storage, { u = Uid.new("b"), g = b.g, n = ing.units })
		end
	end
	d.surfaces.base_dining = { floor = Surfaces.DefaultFloor, wall = Surfaces.DefaultWall }
	return d
end

local function migrate(d)
	d.v = d.v or 1
	-- future migrations: if d.v < 2 then ... d.v = 2 end
	TableUtil.reconcile(d, Data.newProfile())
	d.v = VERSION
	return d
end

local function key(userId)
	return "u_" .. tostring(userId)
end

local function retry(fn, attempts)
	local lastErr
	for i = 1, attempts or 4 do
		local ok, a, b = pcall(fn)
		if ok then
			return true, a, b
		end
		lastErr = a
		task.wait(1.5 * i)
	end
	return false, lastErr
end

function Data.get(player)
	local p = profiles[player]
	return p and p.loaded and p.data or nil
end

function Data.isLoaded(player)
	local p = profiles[player]
	return p ~= nil and p.loaded == true
end

function Data.waitFor(player, timeout)
	local t0 = os.clock()
	while player.Parent and not Data.isLoaded(player) do
		if timeout and os.clock() - t0 > timeout then
			return nil
		end
		task.wait(0.1)
	end
	return Data.get(player)
end

local function payload(value)
	return TableUtil.deepCopy(value)
end

-- Notify clients that `k` changed in `player`'s profile.
function Data.changed(player, k)
	local d = Data.get(player)
	if not d then
		return
	end
	local Net = Core.S.Net
	Net.fire(player, "DataChanged", "me", k, payload(d[k]))
	local Session = Core.S.Session
	if WORLD_KEY_SET[k] and Session and Session.owner == player then
		for _, other in ipairs(Players:GetPlayers()) do
			Net.fire(other, "DataChanged", "world", k, payload(d[k]))
		end
	end
	Data.Changed:Fire(player, k)
end

function Data.snapshot(player)
	local d = Data.get(player)
	if not d then
		return nil
	end
	local me = TableUtil.deepCopy(d)
	me.receipts = nil
	local Session = Core.S.Session
	local world = nil
	if Session and Session.owner then
		local od = Data.get(Session.owner)
		if od then
			world = {}
			for _, k in ipairs(Data.WorldKeys) do
				world[k] = TableUtil.deepCopy(od[k])
			end
		end
	end
	return { me = me, world = world, session = Session and Session.info(player) or nil }
end

local function load(player)
	local p = { data = nil, loaded = false }
	profiles[player] = p
	local data = nil
	if storeOk then
		local ok, result = retry(function()
			return store:UpdateAsync(key(player.UserId), function(old)
				old = old or { data = nil, lock = nil }
				if old.lock and old.lock.job ~= game.JobId and os.time() - (old.lock.time or 0) < GameConfig.SessionLockSeconds then
					return nil -- locked by another server: do not write, retry later
				end
				old.lock = { job = game.JobId, time = os.time() }
				return old
			end)
		end, 3)
		if ok and result then
			data = result.data
		elseif ok and not result then
			-- still locked: wait for the lock to expire (another server is saving)
			for _ = 1, 6 do
				task.wait(5)
				local ok2, r2 = pcall(function()
					return store:UpdateAsync(key(player.UserId), function(old)
						old = old or {}
						if old.lock and old.lock.job ~= game.JobId and os.time() - (old.lock.time or 0) < 30 then
							return nil
						end
						old.lock = { job = game.JobId, time = os.time() }
						return old
					end)
				end)
				if ok2 and r2 then
					data = r2.data
					break
				end
			end
		else
			warn("[Data] load failed for " .. player.Name .. ": " .. tostring(result))
			p.noSave = true -- do not overwrite a profile we could not read
		end
	end
	if not player.Parent then
		profiles[player] = nil
		return
	end
	if type(data) == "table" then
		data = migrate(data)
	else
		data = Data.newProfile()
	end
	p.data = data
	p.loaded = true
	Data.Loaded:Fire(player, data)
end

function Data.save(player, release)
	local p = profiles[player]
	if not p or not p.loaded or p.noSave or not storeOk then
		return false
	end
	if p.saving then
		return false
	end
	p.saving = true
	p.data.meta.lastSeen = os.time()
	local snapshot = TableUtil.deepCopy(p.data)
	local ok, err = retry(function()
		return store:UpdateAsync(key(player.UserId), function(old)
			old = old or {}
			if old.lock and old.lock.job ~= game.JobId and os.time() - (old.lock.time or 0) < GameConfig.SessionLockSeconds then
				return nil -- another server owns the profile
			end
			old.data = snapshot
			old.lock = (not release) and { job = game.JobId, time = os.time() } or nil
			return old
		end)
	end, 3)
	p.saving = false
	if not ok then
		warn("[Data] save failed for " .. player.Name .. ": " .. tostring(err))
	end
	return ok
end

function Data.storeAvailable()
	return storeOk
end

-- Saves immediately (used after Robux purchases).
function Data.saveNow(player)
	local p = profiles[player]
	if p then
		p.saving = false
	end
	return Data.save(player, false)
end

function Data.reset(player)
	local p = profiles[player]
	if p and p.loaded then
		p.data = Data.newProfile()
		Data.Loaded:Fire(player, p.data)
	end
end

function Data.Init()
	local ok, s = pcall(function()
		return DataStoreService:GetDataStore(GameConfig.DataStoreName)
	end)
	if ok and s then
		store = s
		-- in Studio without API access every call errors: probe once
		local probeOk = pcall(function()
			s:GetAsync("probe")
		end)
		storeOk = probeOk
		if not probeOk then
			warn("[Data] DataStore not available (enable Studio Access to API Services to save in Studio). Playing without saving.")
		end
	end
	Core.S.Net.invoke("GetSnapshot", function(player)
		Data.waitFor(player, 30)
		return Data.snapshot(player)
	end)
end

function Data.Start()
	Players.PlayerAdded:Connect(function(player)
		load(player)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(load, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		Data.save(player, true)
		profiles[player] = nil
	end)
	game:BindToClose(function()
		local pending = 0
		for player in pairs(profiles) do
			pending += 1
			task.spawn(function()
				Data.save(player, true)
				pending -= 1
			end)
		end
		local t0 = os.clock()
		while pending > 0 and os.clock() - t0 < 25 do
			task.wait(0.2)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(GameConfig.AutosaveSeconds)
			for player in pairs(profiles) do
				task.spawn(Data.save, player, false)
			end
		end
	end)
end

local _ = { RunService, HttpService }
return Data
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000068"><Properties><string name="Name">Day</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Day cycle: prep -> open (11:00-23:00, 1 game hour = 1 minute) -> closing -> report -> prep.
local Lighting = game:GetService("Lighting")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Staff = require(Shared.Config.Staff)
local Core = require(script.Parent.Parent.Core)

local Day = {}
Day.phase = "prep"
Day.clock = GameConfig.Day.PrepClock
Day.report = nil
local phaseStarted = os.clock()
local DAY = GameConfig.Day

local function data()
	return Core.S.Session.ownerData()
end

function Day.isPeak()
	for _, p in ipairs(DAY.Peaks) do
		if Day.clock >= p[1] and Day.clock < p[2] then
			return true
		end
	end
	return false
end

local function payload()
	local d = data()
	return {
		phase = Day.phase,
		clock = Day.clock,
		day = d and (d.stats.days or 0) + 1 or 1,
		report = Day.phase == "report" and Day.report or nil,
	}
end

function Day.broadcast()
	Core.S.Net.fireAll("DayState", payload())
	workspace:SetAttribute("DayPhase", Day.phase)
end

local function setPhase(p)
	Day.phase = p
	phaseStarted = os.clock()
	Day.broadcast()
end

function Day.open()
	if Day.phase ~= "prep" then
		return
	end
	Core.S.Economy.resetLedger()
	Day.clock = DAY.OpenHour
	Lighting.ClockTime = Day.clock
	Core.S.World.setOpenSign(true)
	setPhase("open")
	Core.S.Net.notifyAll("msg.day_open", nil, "success")
	Core.S.Net.fx("sfx", { name = "bell" })
	Core.S.Meta.event(Core.S.Session.owner, "open", 1)
end

local function finish()
	local d = data()
	if not d then
		return
	end
	local owner = Core.S.Session.owner
	local L = Core.S.Economy.ledger
	-- salaries
	local salaries = 0
	for _, s in ipairs(d.staff) do
		local cfg = Staff.byId[s.role]
		if cfg then
			salaries += cfg.salary
		end
	end
	local paid = Core.S.Economy.charge(owner, salaries, "salary")
	local best, bestN = nil, 0
	for id, n in pairs(L.bestDish) do
		if n > bestN then
			best, bestN = id, n
		end
	end
	local income = L.sales + L.tips
	local costs = L.supplies + paid + L.build + L.other
	Day.report = {
		day = (d.stats.days or 0) + 1,
		sales = L.sales, tips = L.tips, supplies = L.supplies, salaries = paid, build = L.build, other = L.other,
		profit = income - costs, customers = L.customers, served = L.served, walkouts = L.walkouts,
		rating = L.reviews > 0 and (L.stars / L.reviews) or 0, best = best, bestCount = bestN,
	}
	d.stats.days = (d.stats.days or 0) + 1
	d.stats.lastDayEarned = income
	table.insert(d.stats.dayHistory, income)
	while #d.stats.dayHistory > 10 do
		table.remove(d.stats.dayHistory, 1)
	end
	Core.S.Data.changed(owner, "stats")
	Core.S.Meta.event(owner, "days", 1)
	Core.S.Meta.dayEnded(owner)
	setPhase("report")
	task.spawn(Core.S.Data.save, owner, false)
end

function Day.next()
	if Day.phase ~= "report" then
		return
	end
	Day.clock = DAY.PrepClock
	Lighting.ClockTime = Day.clock
	Core.S.Cooking.clearTickets()
	setPhase("prep")
end

function Day.closeEarly()
	if Day.phase == "open" then
		Day.clock = DAY.CloseHour
	end
end

local function hasManager()
	local d = data()
	if not d then
		return false
	end
	for _, s in ipairs(d.staff) do
		if s.role == "staff_manager" then
			return true
		end
	end
	return false
end

function Day.Init()
	Core.S.Net.on("SetDayState", function(player, action)
		local Session = Core.S.Session
		if not Session.canBuild(player) and action ~= "next" then
			return Core.S.Net.notify(player, "msg.no_permission", nil, "error")
		end
		if action == "open" then
			Day.open()
		elseif action == "close" then
			Day.closeEarly()
		elseif action == "next" then
			Day.next()
		end
	end, 2)
	Lighting.ClockTime = Day.clock
	Lighting.GeographicLatitude = 35
end

function Day.Start()
	game:GetService("Players").PlayerAdded:Connect(function(p)
		task.wait(2)
		Core.S.Net.fire(p, "DayState", payload())
	end)
	Core.S.Session.OwnerReady:Connect(function()
		Day.broadcast()
	end)
	local last = os.clock()
	local lastBroadcast = 0
	while true do
		task.wait(0.25)
		local now = os.clock()
		local dt = now - last
		last = now
		local d = data()
		if Day.phase == "open" then
			Day.clock += dt / DAY.SecondsPerHour
			if Day.clock >= DAY.CloseHour then
				Day.clock = DAY.CloseHour
				Core.S.World.setOpenSign(false)
				setPhase("closing")
				Core.S.Net.notifyAll("msg.day_closing", nil, "info")
			end
			Lighting.ClockTime = Day.clock
		elseif Day.phase == "closing" then
			local anyone = next(Core.S.Customers.active) ~= nil
			if not anyone or os.clock() - phaseStarted > 90 then
				Core.S.Customers.sendAllHome()
				finish()
			end
			Day.clock = math.min(Day.clock + dt / DAY.SecondsPerHour, 24)
			Lighting.ClockTime = Day.clock
		elseif Day.phase == "report" then
			if d and d.settings.autoDay and hasManager() and os.clock() - phaseStarted > DAY.ReportAutoClose then
				Day.next()
			end
		elseif Day.phase == "prep" then
			if d and d.settings.autoDay and hasManager() and os.clock() - phaseStarted > DAY.ManagerAutoOpenDelay then
				Day.open()
			end
		end
		if now - lastBroadcast > 5 then
			lastBroadcast = now
			Day.broadcast()
		end
	end
end

return Day
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000069"><Properties><string name="Name">Dev</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Developer tools: available in Studio or to the experience creator.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Licenses = require(Shared.Config.Licenses)
local Expansions = require(Shared.Config.Expansions)
local Ingredients = require(Shared.Config.Ingredients)
local Formulas = require(Shared.Logic.Formulas)
local Uid = require(Shared.Util.Uid)
local Core = require(script.Parent.Parent.Core)

local Dev = {}

local function allowed(player)
	if RunService:IsStudio() then
		return true
	end
	return game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId
end

local function run(player, cmd, arg)
	local S = Core.S
	local d = S.Session.ownerData()
	if not d then
		return
	end
	local owner = S.Session.owner
	if cmd == "yen" then
		S.Economy.add(owner, tonumber(arg) or 10000, "dev", { raw = true })
	elseif cmd == "sakura" then
		S.Economy.addSakura(owner, tonumber(arg) or 50)
	elseif cmd == "level" then
		local target = math.clamp(math.floor(tonumber(arg) or (d.level + 1)), 1, Formulas.MaxLevel)
		d.level = target
		d.xp = 0
		S.Data.changed(owner, "level")
		S.Data.changed(owner, "xp")
	elseif cmd == "licenses" then
		for _, l in ipairs(Licenses.list) do
			d.licenses[l.id] = true
			for _, r in ipairs(l.recipes) do
				d.menu[r] = d.menu[r] or { on = true, price = 1 }
			end
		end
		S.Data.changed(owner, "licenses")
		S.Data.changed(owner, "menu")
	elseif cmd == "zones" then
		for _, e in ipairs(Expansions.list) do
			d.zones[e.id] = true
		end
		S.Session.OwnerReady:Fire(owner, d)
	elseif cmd == "renos" or cmd == "plain" then
		-- all renovations on (detailed look) or off (plain starting look)
		for _, e in ipairs(Expansions.list) do
			if e.reno then
				d.zones[e.id] = cmd == "renos" or nil
			end
		end
		S.Data.changed(owner, "zones")
		S.Session.OwnerReady:Fire(owner, d)
	elseif cmd == "spawn" then
		task.spawn(S.Customers.trySpawn, type(arg) == "string" and arg or nil)
	elseif cmd == "time" then
		S.Day.closeEarly()
	elseif cmd == "stock" then
		for _, ing in ipairs(Ingredients.list) do
			if d.licenses[ing.license] then
				for _ = 1, 2 do
					table.insert(d.storage, { u = Uid.new("b"), g = ing.id, n = ing.units })
				end
			end
		end
		S.Supply.layout()
	elseif cmd == "rating" then
		for _ = 1, 20 do
			S.Progression.addReview(5, 1)
		end
	elseif cmd == "selftest" then
		task.spawn(S.SelfTest.run, player)
		return
	elseif cmd == "reset" and RunService:IsStudio() then
		S.Data.reset(owner)
		S.Session.OwnerReady:Fire(owner, S.Data.get(owner))
		for _, k in ipairs(S.Data.WorldKeys) do
			S.Data.changed(owner, k)
		end
		S.Data.changed(owner, "meta")
	end
	S.Net.notify(player, "msg.dev_done", { cmd = cmd }, "info")
end

function Dev.Init()
	Core.S.Net.on("Dev", function(player, cmd, arg)
		if allowed(player) and type(cmd) == "string" then
			run(player, cmd, arg)
		end
	end, 5)
end

function Dev.Start()
	local function mark(p)
		if allowed(p) then
			p:SetAttribute("Dev", true)
		end
	end
	Players.PlayerAdded:Connect(mark)
	for _, p in ipairs(Players:GetPlayers()) do
		mark(p)
	end
end

return Dev
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000070"><Properties><string name="Name">Economy</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Yen and sakura tokens, income multipliers, boosts and the per-day ledger.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Franchise = require(Shared.Config.Franchise)
local Formulas = require(Shared.Logic.Formulas)
local Core = require(script.Parent.Parent.Core)

local Economy = {}
Economy.ledger = nil

local INCOME = { sale = true, tip = true, offline = true }

function Economy.resetLedger()
	Economy.ledger = { sales = 0, tips = 0, supplies = 0, salaries = 0, build = 0, other = 0, customers = 0, served = 0, walkouts = 0, stars = 0, reviews = 0, bestDish = {} }
end

function Economy.boostActive(name)
	local data = Core.S.Session.ownerData()
	return data and data.boosts and (data.boosts[name] or 0) > os.time() or false
end

function Economy.multiplier()
	local data = Core.S.Session.ownerData()
	if not data then
		return 1
	end
	local passMult = 1
	local Monetization = Core.S.Monetization
	if Monetization then
		passMult = Monetization.ownerYenMultiplier()
	end
	return Formulas.incomeMultiplier({ franchiseStars = data.franchise.stars or 0, yenPerStar = Franchise.YenPerStar, passMult = passMult })
end

-- Adds yen to `player`'s profile. opts.raw skips multipliers.
function Economy.add(player, amount, reason, opts)
	local Data = Core.S.Data
	local data = Data.get(player)
	if not data or not amount or amount <= 0 then
		return 0
	end
	local value = amount
	if INCOME[reason] and not (opts and opts.raw) and player == Core.S.Session.owner then
		value = math.floor(amount * Economy.multiplier() + 0.5)
		if reason == "tip" and Economy.boostActive("golden") then
			value = math.floor(value * 1.5 + 0.5)
		end
	end
	data.yen += value
	if INCOME[reason] then
		data.stats.earned += value
	end
	if Economy.ledger and player == Core.S.Session.owner then
		if reason == "sale" then
			Economy.ledger.sales += value
		elseif reason == "tip" then
			Economy.ledger.tips += value
		end
	end
	Data.changed(player, "yen")
	if INCOME[reason] then
		Data.changed(player, "stats")
		Core.S.Meta.event(player, "earn", value)
		if reason == "tip" then
			Core.S.Meta.event(player, "tips", value)
		end
	end
	return value
end

function Economy.canAfford(player, amount)
	local data = Core.S.Data.get(player)
	return data ~= nil and data.yen >= amount
end

function Economy.spend(player, amount, reason)
	local Data = Core.S.Data
	local data = Data.get(player)
	if not data or amount < 0 or data.yen < amount then
		return false
	end
	data.yen -= amount
	if Economy.ledger and player == Core.S.Session.owner then
		if reason == "supplies" then
			Economy.ledger.supplies += amount
		elseif reason == "salary" then
			Economy.ledger.salaries += amount
		elseif reason == "build" then
			Economy.ledger.build += amount
		else
			Economy.ledger.other += amount
		end
	end
	Data.changed(player, "yen")
	return true
end

-- Salaries may push the balance below zero only down to 0
function Economy.charge(player, amount, reason)
	local data = Core.S.Data.get(player)
	if not data then
		return 0
	end
	local paid = math.min(amount, data.yen)
	if paid > 0 then
		Economy.spend(player, paid, reason)
	end
	return paid
end

function Economy.addSakura(player, n)
	local data = Core.S.Data.get(player)
	if not data or n <= 0 then
		return
	end
	data.sakura += n
	Core.S.Data.changed(player, "sakura")
end

function Economy.spendSakura(player, n)
	local data = Core.S.Data.get(player)
	if not data or data.sakura < n then
		return false
	end
	data.sakura -= n
	Core.S.Data.changed(player, "sakura")
	return true
end

function Economy.Init()
	Economy.resetLedger()
end

return Economy
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000071"><Properties><string name="Name">Entities</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Registry of interactable things in the world (placed items, boxes, customers, fixed props).
local CollectionService = game:GetService("CollectionService")

local Entities = {}
local byUid = {}

function Entities.register(uid, kind, model, data)
	local e = { uid = uid, kind = kind, model = model }
	if data then
		for k, v in pairs(data) do
			e[k] = v
		end
	end
	byUid[uid] = e
	if model then
		model:SetAttribute("Uid", uid)
		model:SetAttribute("Kind", kind)
		CollectionService:AddTag(model, "Interactable")
	end
	return e
end

function Entities.unregister(uid)
	local e = byUid[uid]
	byUid[uid] = nil
	return e
end

function Entities.get(uid)
	return byUid[uid]
end

function Entities.ofKind(kind)
	local out = {}
	for _, e in pairs(byUid) do
		if e.kind == kind then
			table.insert(out, e)
		end
	end
	return out
end

function Entities.all()
	return byUid
end

function Entities.position(e)
	if e.model and e.model.PrimaryPart then
		return e.model.PrimaryPart.Position
	elseif e.model then
		return e.model:GetPivot().Position
	end
	return nil
end

return Entities
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000072"><Properties><string name="Name">Franchise</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Franchise (prestige): open a restaurant in the next city with permanent bonuses.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Franchise = require(Shared.Config.Franchise)
local Core = require(script.Parent.Parent.Core)

local Service = {}

function Service.check(d)
	if d.level < Franchise.RequiredLevel then
		return false, "msg.need_level", { level = Franchise.RequiredLevel }
	end
	if Core.S.Progression.rating() < Franchise.RequiredRating then
		return false, "msg.need_rating", { rating = Franchise.RequiredRating }
	end
	for _, z in ipairs(Franchise.RequiredZones) do
		if not d.zones[z] then
			return false, "msg.need_zone", { name = "zone." .. z }
		end
	end
	local nextCity = nil
	for _, c in ipairs(Franchise.list) do
		if c.star == (d.franchise.stars or 0) + 1 then
			nextCity = c
		end
	end
	if not nextCity then
		return false, "msg.franchise_done"
	end
	return true, nil, nil, nextCity
end

local KEEP = { sakura = true, mastery = true, stats = true, meta = true, settings = true, passes = true, receipts = true, created = true, inventory = true, perms = true }

local function open(player)
	local Session, Net = Core.S.Session, Core.S.Net
	if player ~= Session.owner then
		return
	end
	local d = Session.ownerData()
	local ok, reason, params, city = Service.check(d)
	if not ok then
		return Net.notify(player, reason, params, "error")
	end
	-- every placed object goes to the inventory
	for _, e in ipairs(d.placed) do
		d.inventory[e.i] = (d.inventory[e.i] or 0) + 1
	end
	local fresh = Core.S.Data.newProfile()
	for k, v in pairs(fresh) do
		if not KEEP[k] then
			d[k] = v
		end
	end
	d.yen = Franchise.StartYen
	d.franchise = { stars = city.star, city = city.id, cities = {} }
	for _, c in ipairs(Franchise.list) do
		if c.star <= city.star then
			d.franchise.cities[c.id] = true
		end
	end
	-- the starter layout is already placed: remove those copies from the inventory
	for _, e in ipairs(d.placed) do
		if d.inventory[e.i] and d.inventory[e.i] > 0 then
			d.inventory[e.i] -= 1
			if d.inventory[e.i] == 0 then
				d.inventory[e.i] = nil
			end
		end
	end
	Net.fx("construction", { zone = "franchise" })
	Net.notifyAll("msg.franchise_opened", { city = "city." .. city.id }, "level")
	Core.S.Customers.sendAllHome()
	Core.S.Cooking.clearTickets()
	Session.OwnerReady:Fire(player, d)
	for _, k in ipairs(Core.S.Data.WorldKeys) do
		Core.S.Data.changed(player, k)
	end
	Core.S.Data.changed(player, "meta")
	Core.S.Meta.event(player, "franchise", 1)
end

function Service.Init()
	Core.S.Net.on("Franchise", function(player)
		open(player)
	end, 1)
end

return Service
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000073"><Properties><string name="Name">Hands</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- What every actor (player or staff NPC) is carrying, with visuals welded in front of the body.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Upgrades = require(Shared.Config.Upgrades)
local Registry = require(Shared.Models.Registry)
local Core = require(script.Parent.Parent.Core)

local Hands = {}
local state = {} -- [actorKey] = { kind, items = {}, visuals = {} }

local HOLD_ANIM = "rbxassetid://507768375"

local function key(actor)
	return actor
end

function Hands.get(actor)
	local s = state[key(actor)]
	if not s then
		s = { kind = nil, items = {}, visuals = {} }
		state[key(actor)] = s
	end
	return s
end

function Hands.isEmpty(actor)
	return #Hands.get(actor).items == 0
end

function Hands.count(actor)
	return #Hands.get(actor).items
end

local function character(actor)
	if typeof(actor) == "Instance" and actor:IsA("Player") then
		return actor.Character
	elseif type(actor) == "table" then
		return actor.model
	end
	return nil
end

-- Capacity for a kind of item
function Hands.capacity(actor, kind)
	if kind == "box" then
		return 1
	elseif kind == "ing" then
		return GameConfig.IngredientHandCapacity
	end
	local Session = Core.S.Session
	local od = Session.ownerData()
	local tray = od and Upgrades.value(od.upgrades, "up_tray") or 1
	if typeof(actor) == "Instance" and actor:IsA("Player") then
		local Monetization = Core.S.Monetization
		if Monetization and Monetization.ownerHas("gp_big_tray") then
			tray += 2
		end
	elseif type(actor) == "table" then
		tray = math.max(2, tray)
	end
	return tray
end

local function holdAnim(actor, on)
	local char = character(actor)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local animator = hum and (hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum))
	if not animator then
		return
	end
	local s = Hands.get(actor)
	if on and not s.track then
		local anim = Instance.new("Animation")
		anim.AnimationId = HOLD_ANIM
		local ok, track = pcall(function()
			return animator:LoadAnimation(anim)
		end)
		if ok and track then
			track.Priority = Enum.AnimationPriority.Action
			track.Looped = true
			track:Play(0.2)
			s.track = track
		end
	elseif not on and s.track then
		s.track:Stop(0.2)
		s.track = nil
	end
end

local function buildVisual(kind, item)
	if kind == "box" then
		return Registry.food("box", item.g, item.n)
	elseif kind == "ing" then
		return Registry.food("ingredient", item.g)
	elseif kind == "dish" then
		return Registry.food("dish", item.recipe)
	elseif kind == "dirty" then
		return Registry.food("dirty", item.dish)
	end
	return nil
end

local function refreshVisual(actor)
	local s = Hands.get(actor)
	for _, v in ipairs(s.visuals) do
		v:Destroy()
	end
	s.visuals = {}
	local char = character(actor)
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end
	local y = 0.1
	for i, item in ipairs(s.items) do
		local m = buildVisual(s.kind, item)
		if m then
			local h = m.PrimaryPart and m.PrimaryPart.Size.Y or 0.5
			local offset
			if s.kind == "ing" then
				offset = CFrame.new(((i - 1) % 3 - 1) * 0.55, 0.2 + math.floor((i - 1) / 3) * 0.5, -1.5)
			else
				offset = CFrame.new(0, y + h / 2, -1.5)
				y += h * 0.85
			end
			m:PivotTo(hrp.CFrame * offset)
			for _, d in ipairs(m:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Anchored = false
					d.CanCollide = false
					d.CanQuery = false
					d.CanTouch = false
					d.Massless = true
					local w = Instance.new("WeldConstraint")
					w.Part0 = hrp
					w.Part1 = d
					w.Parent = d
				end
			end
			m.Parent = char
			table.insert(s.visuals, m)
		end
	end
	holdAnim(actor, #s.items > 0)
end

local function publish(actor)
	if typeof(actor) == "Instance" and actor:IsA("Player") then
		local s = Hands.get(actor)
		local list = {}
		for _, it in ipairs(s.items) do
			table.insert(list, it.g or it.recipe or it.dish or "?")
		end
		actor:SetAttribute("HandsKind", s.kind or "")
		actor:SetAttribute("Hands", HttpService:JSONEncode(list))
	end
end

function Hands.set(actor, kind, items)
	local s = Hands.get(actor)
	s.kind = (#items > 0) and kind or nil
	s.items = items
	refreshVisual(actor)
	publish(actor)
end

-- Adds an item; returns false when the hands hold something else or are full.
function Hands.add(actor, kind, item)
	local s = Hands.get(actor)
	if s.kind and s.kind ~= kind then
		return false, "msg.hands_busy"
	end
	if #s.items >= Hands.capacity(actor, kind) then
		return false, "msg.hands_full"
	end
	local items = table.clone(s.items)
	table.insert(items, item)
	Hands.set(actor, kind, items)
	return true
end

function Hands.clear(actor)
	Hands.set(actor, nil, {})
end

function Hands.removeAt(actor, index)
	local s = Hands.get(actor)
	local items = table.clone(s.items)
	local it = table.remove(items, index)
	Hands.set(actor, s.kind, items)
	return it
end

function Hands.refresh(actor)
	refreshVisual(actor)
	publish(actor)
end

function Hands.forget(actor)
	local s = state[key(actor)]
	if s then
		for _, v in ipairs(s.visuals) do
			v:Destroy()
		end
	end
	state[key(actor)] = nil
end

function Hands.Start()
	Players.PlayerRemoving:Connect(function(player)
		-- boxes in hand go back to storage
		local s = state[player]
		if s and s.kind == "box" then
			local Supply = Core.S.Supply
			for _, b in ipairs(s.items) do
				Supply.returnBox(b)
			end
		end
		Hands.forget(player)
	end)
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			task.wait(0.5)
			-- respawn: drop everything (boxes return to storage)
			local s = state[player]
			if s and s.kind == "box" then
				for _, b in ipairs(s.items) do
					Core.S.Supply.returnBox(b)
				end
			end
			Hands.forget(player)
			publish(player)
		end)
	end)
	Core.S.Net.on("DropHands", function(player)
		local s = Hands.get(player)
		if s.kind == "box" then
			for _, b in ipairs(s.items) do
				Core.S.Supply.returnBox(b)
			end
		elseif s.kind == "dish" or s.kind == "dirty" then
			-- plates are never lost: they go to the sink as dirty dishes
			Core.S.Appliance.addDirtyToSink(#s.items)
		end
		Hands.clear(player)
		Core.S.Net.notify(player, "msg.hands_dropped")
	end, 3)
end

return Hands
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000074"><Properties><string name="Name">Interaction</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Receives clicks/taps from players, checks distance and permissions, dispatches to services.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Core = require(script.Parent.Parent.Core)

local Interaction = {}

local busy = {} -- [player] = true while an action runs (steps/washing yield)

local function targetPosition(e, slot)
	if slot and e.model then
		local part = e.model:FindFirstChild("Slot" .. slot)
		if part then
			return part.Position
		end
	end
	local pos = Core.S.Entities.position(e)
	return pos
end

local function sizeMargin(e)
	if e.item then
		return math.max(e.item.size[1], e.item.size[3]) / 2
	end
	return 1.5
end

-- Dispatch shared by players (and reused by tutorial / dev tools)
function Interaction.perform(actor, e, extra)
	local S = Core.S
	local kind = e.kind
	if kind == "box" then
		return S.Supply.takeBox(actor, e)
	elseif kind == "rack" then
		local hands = S.Hands.get(actor)
		if hands.kind == "box" then
			local entry = hands.items[1]
			S.Hands.clear(actor)
			S.Supply.returnBox(entry)
			return true
		end
		return false, "msg.rack_hint"
	elseif kind == "shelf" then
		local slot = type(extra) == "table" and tonumber(extra.slot) or nil
		return S.Supply.useShelf(actor, e, slot)
	elseif kind == "ricecooker" or kind == "pot" then
		return S.Appliance.load(actor, e)
	elseif kind == "sink" then
		return S.Appliance.useSink(actor, e, 1)
	elseif kind == "dishwasher" then
		return S.Appliance.useDishwasher(actor, e)
	elseif kind == "station" then
		return S.Cooking.use(actor, e, 1)
	elseif kind == "customer" then
		return S.Customers.use(actor, e)
	elseif kind == "dirty" then
		return S.Customers.collectDirty(actor, e)
	end
	return false, nil
end

local ACTION_FOR_KIND = {
	box = "take_box", shelf = "shelf", ricecooker = "rice", pot = "broth", sink = "wash",
	dishwasher = "wash", station = "station", customer = "customer", dirty = "collect", rack = "rack",
}

function Interaction.Init()
	Core.S.Net.on("Interact", function(player, uid, extra)
		local S = Core.S
		if type(uid) ~= "string" or #uid > 40 then
			return
		end
		if not S.Session.canWork(player) or not S.Session.owner then
			return
		end
		if busy[player] then
			return
		end
		local e = S.Entities.get(uid)
		if not e then
			return
		end
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not hrp then
			return
		end
		local slot = type(extra) == "table" and tonumber(extra.slot) or nil
		local pos = targetPosition(e, slot)
		if not pos then
			return
		end
		local dist = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(hrp.Position.X, 0, hrp.Position.Z)).Magnitude
		if dist > GameConfig.InteractRange + sizeMargin(e) or math.abs(pos.Y - hrp.Position.Y) > 12 then
			return S.Net.notify(player, "msg.too_far", nil, "info")
		end
		busy[player] = true
		local ok, result, reason, params = pcall(Interaction.perform, player, e, extra)
		busy[player] = nil
		if not ok then
			warn("[Interaction] " .. tostring(result))
			return
		end
		if result then
			S.Net.fxTo(player, "action", { kind = ACTION_FOR_KIND[e.kind] or e.kind, hands = S.Hands.get(player).kind })
		elseif reason then
			S.Net.notify(player, reason, params, "info")
		end
	end, 12)
	game:GetService("Players").PlayerRemoving:Connect(function(p)
		busy[p] = nil
	end)
end

return Interaction
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000075"><Properties><string name="Name">Leaderboard</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Global leaderboards (dishes served, yen earned) with a small cache.
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")

local Core = require(script.Parent.Parent.Core)

local Leaderboard = {}
local stores = {}
local cache = { t = 0, data = nil }
local names = {}

local BOARDS = { dishes = "LB_Dishes_v1", earned = "LB_Earned_v1" }

local function nameOf(userId)
	if names[userId] then
		return names[userId]
	end
	local ok, n = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	names[userId] = ok and n or ("#" .. userId)
	return names[userId]
end

local function submit(player)
	local d = Core.S.Data.get(player)
	if not d then
		return
	end
	for stat, store in pairs(stores) do
		local value = math.floor(d.stats[stat] or 0)
		pcall(function()
			store:SetAsync(tostring(player.UserId), value)
		end)
	end
end

local function fetch()
	if cache.data and os.clock() - cache.t < 120 then
		return cache.data
	end
	local out = {}
	for stat, store in pairs(stores) do
		out[stat] = {}
		local ok, pages = pcall(function()
			return store:GetSortedAsync(false, 10)
		end)
		if ok and pages then
			for rank, entry in ipairs(pages:GetCurrentPage()) do
				table.insert(out[stat], { rank = rank, name = nameOf(tonumber(entry.key)), value = entry.value })
			end
		end
	end
	cache = { t = os.clock(), data = out }
	return out
end

function Leaderboard.Init()
	for stat, name in pairs(BOARDS) do
		local ok, s = pcall(function()
			return DataStoreService:GetOrderedDataStore(name)
		end)
		if ok then
			stores[stat] = s
		end
	end
	Core.S.Net.invoke("GetLeaderboard", function()
		return fetch()
	end)
end

function Leaderboard.Start()
	Players.PlayerRemoving:Connect(submit)
	task.spawn(function()
		while true do
			task.wait(300)
			for _, p in ipairs(Players:GetPlayers()) do
				submit(p)
			end
		end
	end)
end

return Leaderboard
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000076"><Properties><string name="Name">Meta</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Daily quests, achievements, login streak, offline earnings and tutorial progress.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Quests = require(Shared.Config.Quests)
local Achievements = require(Shared.Config.Achievements)
local DailyRewards = require(Shared.Config.DailyRewards)
local Upgrades = require(Shared.Config.Upgrades)
local Expansions = require(Shared.Config.Expansions)
local Formulas = require(Shared.Logic.Formulas)
local TableUtil = require(Shared.Util.TableUtil)
local Core = require(script.Parent.Parent.Core)

local Meta = {}

local function dayIndex()
	return math.floor(os.time() / 86400)
end

local function ensureQuests(player, d)
	local today = dayIndex()
	if d.meta.questDay == today and #d.meta.quests > 0 then
		return
	end
	local rng = Random.new(today * 7919 + player.UserId % 1000)
	local pool = table.clone(Quests.list)
	TableUtil.shuffle(pool, rng)
	d.meta.quests = {}
	for i = 1, Quests.PerDay do
		local q = pool[i]
		table.insert(d.meta.quests, { id = q.id, target = Formulas.questTarget(q.base, q.perLevel, d.level), progress = 0, claimed = false })
	end
	d.meta.questDay = today
	d.meta.questBonus = false
end

local function statValue(d, stat)
	if stat == "staff" then
		return #d.staff
	elseif stat == "level" then
		return d.level
	elseif stat == "licenses" then
		return TableUtil.count(d.licenses)
	elseif stat == "zones" then
		local n = 0
		for id in pairs(d.zones) do
			if string.sub(id, 1, 5) == "zone_" then
				n += 1
			end
		end
		return n
	elseif stat == "renos" then
		local n = 0
		for id in pairs(d.zones) do
			local e = Expansions.byId[id]
			if e and e.reno then
				n += 1
			end
		end
		return n
	elseif stat == "franchise" then
		return d.franchise.stars or 0
	end
	return d.stats[stat] or 0
end

local function checkAchievements(player, d)
	local changed = false
	for _, a in ipairs(Achievements.list) do
		if not d.meta.achievements[a.id] and statValue(d, a.stat) >= a.target then
			d.meta.achievements[a.id] = "done"
			changed = true
			Core.S.Net.notify(player, "msg.achievement", { name = "ach." .. a.stat, n = a.target }, "level")
		end
	end
	return changed
end

-- Generic progress hook. kind matches Quests[].kind and stats.
function Meta.event(player, kind, amount, info)
	if not player then
		return
	end
	local d = Core.S.Data.get(player)
	if not d then
		return
	end
	ensureQuests(player, d)
	local questChanged = false
	for _, q in ipairs(d.meta.quests) do
		local cfg = Quests.byId[q.id]
		if cfg and cfg.kind == kind and q.progress < q.target then
			q.progress = math.min(q.target, q.progress + (amount or 1))
			questChanged = true
			if q.progress >= q.target then
				Core.S.Net.notify(player, "msg.quest_done", { name = "quest." .. q.id, n = q.target }, "success")
			end
		end
	end
	local achChanged = checkAchievements(player, d)
	if questChanged or achChanged then
		Core.S.Data.changed(player, "meta")
	end
	local _ = info
end

function Meta.dayEnded(player)
	Meta.event(player, "day_end", 1)
end

local function claimQuest(player, id)
	local d = Core.S.Data.get(player)
	if not d then
		return
	end
	ensureQuests(player, d)
	for _, q in ipairs(d.meta.quests) do
		if q.id == id and q.progress >= q.target and not q.claimed then
			q.claimed = true
			Core.S.Economy.add(player, Quests.RewardYenPerLevel * d.level, "quest")
			Core.S.Economy.addSakura(player, Quests.RewardSakura)
			local all = true
			for _, other in ipairs(d.meta.quests) do
				if not other.claimed then
					all = false
				end
			end
			if all and not d.meta.questBonus then
				d.meta.questBonus = true
				Core.S.Economy.addSakura(player, Quests.BonusSakura)
				Core.S.Net.notify(player, "msg.quest_bonus", { n = Quests.BonusSakura }, "success")
			end
			Core.S.Data.changed(player, "meta")
			return
		end
	end
end

local function claimAchievement(player, id)
	local d = Core.S.Data.get(player)
	local a = Achievements.byId[id]
	if not d or not a or d.meta.achievements[id] ~= "done" then
		return
	end
	d.meta.achievements[id] = "claimed"
	Core.S.Economy.addSakura(player, a.sakura)
	Core.S.Data.changed(player, "meta")
end

local function claimDaily(player)
	local d = Core.S.Data.get(player)
	if not d then
		return
	end
	local today = dayIndex()
	local daily = d.meta.daily
	if daily.last == today then
		return Core.S.Net.notify(player, "msg.daily_done", nil, "info")
	end
	if daily.last == today - 1 then
		daily.streak = daily.streak % #DailyRewards.days + 1
	else
		daily.streak = 1
	end
	daily.last = today
	local reward = DailyRewards.days[daily.streak]
	if reward.yen then
		Core.S.Economy.add(player, math.floor(reward.yen * (1 + d.level / 10)), "daily")
	end
	if reward.sakura then
		Core.S.Economy.addSakura(player, reward.sakura)
	end
	if reward.item then
		d.inventory[reward.item] = (d.inventory[reward.item] or 0) + 1
		Core.S.Data.changed(player, "inventory")
	end
	Core.S.Data.changed(player, "meta")
	Core.S.Net.notify(player, "msg.daily_claimed", { day = daily.streak }, "success")
end

local function computeOffline(player, d)
	local lvl = d.upgrades.up_safe or 0
	if lvl <= 0 or (d.meta.lastSeen or 0) <= 0 then
		return
	end
	local up = Upgrades.byId.up_safe
	local maxHours = up.values[lvl + 1]
	local pct = up.pct[lvl + 1]
	local hours = math.min(maxHours, (os.time() - d.meta.lastSeen) / 3600)
	if hours < 0.05 then
		return
	end
	local history = d.stats.dayHistory or {}
	if #history == 0 then
		return
	end
	local sum = 0
	for _, v in ipairs(history) do
		sum += v
	end
	local perDay = sum / #history
	local hourly = perDay * 5 -- a service day lasts 12 real minutes
	local amount = Formulas.offlineEarnings(hourly, pct, hours)
	if amount > 0 then
		d.meta.offlinePending = (d.meta.offlinePending or 0) + amount
		d.meta.offlineHours = hours
		Core.S.Data.changed(player, "meta")
	end
end

local function claimOffline(player)
	local d = Core.S.Data.get(player)
	if not d or (d.meta.offlinePending or 0) <= 0 then
		return
	end
	local amount = d.meta.offlinePending
	d.meta.offlinePending = 0
	Core.S.Economy.add(player, amount, "offline")
	Core.S.Data.changed(player, "meta")
end

function Meta.Init()
	local Net = Core.S.Net
	Net.on("ClaimQuest", function(player, id)
		if type(id) == "string" then
			claimQuest(player, id)
		end
	end, 4)
	Net.on("ClaimAchievement", function(player, id)
		if type(id) == "string" then
			claimAchievement(player, id)
		end
	end, 6)
	Net.on("ClaimDaily", claimDaily, 2)
	Net.on("ClaimOffline", claimOffline, 2)
	local SETTINGS = {
		lang = function(v)
			return v == "auto" or v == "en" or v == "it"
		end,
		grid = function(v)
			return v == 1 or v == 5 or v == 10
		end,
		rot = function(v)
			return v == 90 or v == 45 or v == 15
		end,
		music = function(v)
			return type(v) == "number" and v >= 0 and v <= 1
		end,
		sfx = function(v)
			return type(v) == "number" and v >= 0 and v <= 1
		end,
		lowGfx = function(v)
			return type(v) == "boolean"
		end,
		autoDay = function(v)
			return type(v) == "boolean"
		end,
	}
	Net.on("SetSetting", function(player, key, value)
		local d = Core.S.Data.get(player)
		local check = SETTINGS[key]
		if d and check and check(value) then
			d.settings[key] = value
			Core.S.Data.changed(player, "settings")
		end
	end, 6)
	Net.on("TutorialStep", function(player, step)
		local d = Core.S.Data.get(player)
		if d and type(step) == "number" then
			d.meta.tutorial = math.floor(step)
			Core.S.Data.changed(player, "meta")
		end
	end, 4)
end

function Meta.Start()
	Core.S.Data.Loaded:Connect(function(player, d)
		ensureQuests(player, d)
		computeOffline(player, d)
		checkAchievements(player, d)
		d.meta.lastSeen = os.time()
		Core.S.Data.changed(player, "meta")
	end)
end

return Meta
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000077"><Properties><string name="Name">Monetization</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Game passes and developer products (IDs in Shared.Config.Monetization; 0 = disabled).
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.Monetization)
local Formulas = require(Shared.Logic.Formulas)
local Core = require(script.Parent.Parent.Core)

local Monetization = {}
local owned = {} -- [player] = { [passId] = true }
local passByAsset, productById = {}, {}

for _, gp in ipairs(Config.GamePasses) do
	if gp.assetId ~= 0 then
		passByAsset[gp.assetId] = gp
	end
end
for _, p in ipairs(Config.Products) do
	if p.productId ~= 0 then
		productById[p.productId] = p
	end
end

local function passCfg(id)
	for _, gp in ipairs(Config.GamePasses) do
		if gp.id == id then
			return gp
		end
	end
	return nil
end

function Monetization.has(player, id)
	return owned[player] ~= nil and owned[player][id] == true
end

function Monetization.ownerHas(id)
	local owner = Core.S.Session.owner
	return owner ~= nil and Monetization.has(owner, id)
end

function Monetization.ownerYenMultiplier()
	local m = 1
	for _, gp in ipairs(Config.GamePasses) do
		if gp.effect.yenMult and Monetization.ownerHas(gp.id) then
			m *= gp.effect.yenMult
		end
	end
	return m
end

-- one-time rewards of a pass (starter pack items, VIP statue)
local function grantPass(player, gp)
	owned[player] = owned[player] or {}
	owned[player][gp.id] = true
	if gp.id == "gp_vip" then
		player:SetAttribute("VIP", true)
	end
	local d = Core.S.Data.waitFor(player, 30)
	if not d or d.passes[gp.id] then
		return
	end
	d.passes[gp.id] = true
	local e = gp.effect
	if e.yen then
		Core.S.Economy.add(player, e.yen, "product", { raw = true })
	end
	if e.item then
		d.inventory[e.item] = (d.inventory[e.item] or 0) + 1
	end
	if e.items then
		for id, n in pairs(e.items) do
			d.inventory[id] = (d.inventory[id] or 0) + n
		end
	end
	Core.S.Data.changed(player, "inventory")
	Core.S.Data.changed(player, "passes")
end

local function applyProduct(player, d, p)
	local e = p.effect
	if e.yen then
		local amount = Formulas.yenPack(e.yen, d.level, Config.YenLevelScale)
		Core.S.Economy.add(player, amount, "product", { raw = true })
	end
	if e.sakura then
		Core.S.Economy.addSakura(player, e.sakura)
	end
	if e.boost then
		local now = os.time()
		d.boosts[e.boost] = math.max(now, d.boosts[e.boost] or 0) + e.seconds
		Core.S.Data.changed(player, "boosts")
	end
end

local function processReceipt(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local Data = Core.S.Data
	local d = Data.waitFor(player, 20)
	local p = productById[info.ProductId]
	if not d or not p then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	for _, r in ipairs(d.receipts) do
		if r == info.PurchaseId then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
	end
	applyProduct(player, d, p)
	table.insert(d.receipts, info.PurchaseId)
	while #d.receipts > 50 do
		table.remove(d.receipts, 1)
	end
	if Data.storeAvailable() and not Data.saveNow(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	Core.S.Net.notify(player, "msg.purchase_thanks", nil, "success")
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

local function checkPasses(player)
	owned[player] = owned[player] or {}
	for _, gp in ipairs(Config.GamePasses) do
		if gp.assetId ~= 0 then
			local ok, has = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, gp.assetId)
			end)
			if ok and has then
				task.spawn(grantPass, player, gp)
			end
		end
	end
end

function Monetization.Init()
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, assetId, purchased)
		local gp = passByAsset[assetId]
		if purchased and gp then
			grantPass(player, gp)
			Core.S.Net.notify(player, "msg.purchase_thanks", nil, "success")
		end
	end)
	Core.S.Net.on("BuyWithRobux", function(player, kind, id)
		if kind == "gamepass" then
			local gp = passCfg(id)
			if gp and gp.assetId ~= 0 then
				MarketplaceService:PromptGamePassPurchase(player, gp.assetId)
			end
		elseif kind == "product" then
			for _, p in ipairs(Config.Products) do
				if p.id == id and p.productId ~= 0 then
					MarketplaceService:PromptProductPurchase(player, p.productId)
				end
			end
		end
	end, 2)
end

function Monetization.Start()
	Players.PlayerAdded:Connect(checkPasses)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(checkPasses, p)
	end
	Players.PlayerRemoving:Connect(function(p)
		owned[p] = nil
	end)
end

return Monetization
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000078"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Server networking helpers: rate-limited handlers and broadcast helpers.
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local RateLimit = require(Shared.Util.RateLimit)
local Core = require(script.Parent.Parent.Core)

local Net = {}
local limiters = {}

function Net.Init()
	NetDef.event("Interact") -- creates the folder with all remotes
end

-- handler(player, ...) ; rate = calls per second allowed (burst = 2x)
function Net.on(name, handler, rate)
	local limiter = RateLimit.new(rate or 8, (rate or 8) * 2)
	limiters[name] = limiter
	NetDef.event(name).OnServerEvent:Connect(function(player, ...)
		if not limiter:check(player) then
			return
		end
		local ok, err = pcall(handler, player, ...)
		if not ok then
			warn("[Net] " .. name .. " handler error: " .. tostring(err))
		end
	end)
end

function Net.invoke(name, handler)
	NetDef.func(name).OnServerInvoke = function(player, ...)
		local ok, result = pcall(handler, player, ...)
		if not ok then
			warn("[Net] " .. name .. " invoke error: " .. tostring(result))
			return nil
		end
		return result
	end
end

function Net.fire(player, name, ...)
	if player and player.Parent then
		NetDef.event(name):FireClient(player, ...)
	end
end

function Net.fireAll(name, ...)
	NetDef.event(name):FireAllClients(...)
end

function Net.notify(player, key, params, kind)
	Net.fire(player, "Notify", key, params, kind or "info")
end

function Net.notifyAll(key, params, kind)
	Net.fireAll("Notify", key, params, kind or "info")
end

function Net.fx(kind, data)
	Net.fireAll("Fx", kind, data)
end

function Net.fxTo(player, kind, data)
	Net.fire(player, "Fx", kind, data)
end

-- Argument validation helpers
function Net.str(v, maxLen)
	return type(v) == "string" and #v <= (maxLen or 64)
end

function Net.num(v, min, max)
	return type(v) == "number" and v == v and (min == nil or v >= min) and (max == nil or v <= max)
end

function Net.players()
	return Players:GetPlayers()
end

local _ = Core
return Net
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000079"><Properties><string name="Name">Npc</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- NPC characters (customers and staff): creation, pooling, animations, walking with pathfinding,
-- sitting and simple emotes.
local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local NpcLooks = require(Shared.Config.NpcLooks)
local Registry = require(Shared.Models.Registry)
local Color = require(Shared.Util.Color)
local Core = require(script.Parent.Parent.Core)

local Npc = {}

local ANIMS = {
	idle = "rbxassetid://507766666",
	walk = "rbxassetid://507777826",
	sit = "rbxassetid://2506281703",
	hold = "rbxassetid://507768375",
	wave = "rbxassetid://507770239",
	cheer = "rbxassetid://507770677",
}

local pool = {}
local rng = Random.new()
local active = 0

function Npc.count()
	return active
end

local function loadAnims(model)
	local hum = model:FindFirstChildOfClass("Humanoid")
	local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
	local tracks = {}
	for name, id in pairs(ANIMS) do
		local a = Instance.new("Animation")
		a.AnimationId = id
		local ok, track = pcall(function()
			return animator:LoadAnimation(a)
		end)
		if ok and track then
			if name == "walk" or name == "idle" or name == "sit" or name == "hold" then
				track.Looped = true
			end
			if name == "sit" then
				track.Priority = Enum.AnimationPriority.Action
			elseif name == "hold" then
				track.Priority = Enum.AnimationPriority.Action
			elseif name == "wave" or name == "cheer" then
				track.Priority = Enum.AnimationPriority.Action2
			else
				track.Priority = Enum.AnimationPriority.Core
			end
			tracks[name] = track
		end
	end
	return tracks
end

local function setupAnimator(npc)
	local hum = npc.humanoid
	npc.tracks = loadAnims(npc.model)
	local current = nil
	local function play(name)
		if current == name then
			return
		end
		if current and npc.tracks[current] then
			npc.tracks[current]:Stop(0.2)
		end
		current = name
		if npc.tracks[name] then
			npc.tracks[name]:Play(0.2)
		end
	end
	hum.Running:Connect(function(speed)
		if npc.sitting then
			return
		end
		if speed > 0.5 then
			play("walk")
		else
			play("idle")
		end
	end)
	npc.play = play
	play("idle")
end

local function describe(look, shirtColor)
	local desc = Instance.new("HumanoidDescription")
	local skin = Color.hex(NpcLooks.skin[rng:NextInteger(1, #NpcLooks.skin)])
	local shirts = NpcLooks.shirts[look] or NpcLooks.shirts.casual
	local shirt = shirtColor and Color.hex(shirtColor) or Color.hex(shirts[rng:NextInteger(1, #shirts)])
	local pants = Color.hex(NpcLooks.pants[rng:NextInteger(1, #NpcLooks.pants)])
	desc.HeadColor = skin
	desc.LeftArmColor = shirt
	desc.RightArmColor = shirt
	desc.TorsoColor = shirt
	desc.LeftLegColor = pants
	desc.RightLegColor = pants
	if #NpcLooks.catalogHats > 0 and rng:NextNumber() < 0.4 then
		desc.HatAccessory = tostring(NpcLooks.catalogHats[rng:NextInteger(1, #NpcLooks.catalogHats)])
	end
	return desc
end

-- Creates a new NPC. opts: { look = "casual", shirt = "#hex", staff = role }
function Npc.create(opts)
	opts = opts or {}
	local model
	local desc = describe(opts.look or "casual", opts.shirt)
	local ok, err = pcall(function()
		model = Players:CreateHumanoidModelFromDescriptionAsync(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		-- older engine versions only have the non-Async name
		ok, err = pcall(function()
			model = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
		end)
	end
	if not ok or not model then
		warn("[Npc] could not create rig: " .. tostring(err))
		return nil
	end
	model.Name = opts.staff and "Staff" or "Customer"
	local hum = model:FindFirstChildOfClass("Humanoid")
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.BreakJointsOnDeath = false
	hum.WalkSpeed = opts.speed or GameConfig.Customers.WalkSpeed
	for _, st in ipairs({ Enum.HumanoidStateType.Climbing, Enum.HumanoidStateType.Swimming, Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.Ragdoll, Enum.HumanoidStateType.Dead, Enum.HumanoidStateType.Flying }) do
		pcall(function()
			hum:SetStateEnabled(st, false)
		end)
	end
	for _, s in ipairs(model:GetChildren()) do
		if s:IsA("Script") or s:IsA("LocalScript") then
			s:Destroy()
		end
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CollisionGroup = "NPC"
			d.CanTouch = false
		end
	end
	local People = Registry.People
	if opts.staff then
		People.hair(model, Color.hex(NpcLooks.hair[rng:NextInteger(1, #NpcLooks.hair)]), rng:NextInteger(1, 3))
		People.hat(model, opts.hat or "hachimaki")
		People.apron(model, Color.hex(opts.apron or "#2E3A5C"))
	else
		People.dress(model, opts.look or "casual", NpcLooks, rng)
	end
	local npc = { model = model, humanoid = hum, root = model:FindFirstChild("HumanoidRootPart"), sitting = false }
	return npc
end

function Npc.spawn(npc, cf)
	npc.model:PivotTo(cf)
	npc.model.Parent = Core.S.World.folders().npcs
	if npc.root then
		pcall(function()
			npc.root:SetNetworkOwner(nil)
		end)
	end
	if not npc.play then
		setupAnimator(npc)
	end
	active += 1
end

function Npc.acquireCustomer(look)
	-- reuse a pooled body when available (looks are re-randomized only for new ones)
	for i, npc in ipairs(pool) do
		if npc.look == look then
			table.remove(pool, i)
			return npc
		end
	end
	local npc = Npc.create({ look = look })
	if npc then
		npc.look = look
	end
	return npc
end

function Npc.release(npc)
	if not npc or not npc.model then
		return
	end
	Npc.stand(npc)
	npc.model.Parent = nil
	npc.model:SetAttribute("Uid", nil)
	active = math.max(0, active - 1)
	if #pool < 16 and not npc.isStaff then
		table.insert(pool, npc)
	else
		npc.model:Destroy()
	end
end

function Npc.destroy(npc)
	if npc and npc.model then
		active = math.max(0, active - 1)
		npc.model:Destroy()
	end
end

local customerPath = { AgentRadius = 1.1, AgentHeight = 5, AgentCanJump = false, WaypointSpacing = 4, Costs = { StaffOnly = math.huge } }
local staffPath = { AgentRadius = 1.1, AgentHeight = 5, AgentCanJump = false, WaypointSpacing = 4 }

local function moveTo(npc, pos, timeout)
	local hum = npc.humanoid
	hum:MoveTo(pos)
	local done = false
	local reached = false
	local conn
	conn = hum.MoveToFinished:Connect(function(r)
		done = true
		reached = r
	end)
	local t0 = os.clock()
	while not done and os.clock() - t0 < (timeout or 6) do
		task.wait(0.1)
		if not npc.model.Parent then
			break
		end
	end
	conn:Disconnect()
	return reached
end

-- Walks to a position. Returns true when arrived (teleports if stuck for too long).
function Npc.walkTo(npc, target, opts)
	opts = opts or {}
	if not npc.model.Parent or not npc.root then
		return false
	end
	Npc.stand(npc)
	local params = opts.staff and staffPath or customerPath
	local path = PathfindingService:CreatePath(params)
	local ok = pcall(function()
		path:ComputeAsync(npc.root.Position, target)
	end)
	if ok and path.Status == Enum.PathStatus.Success then
		local waypoints = path:GetWaypoints()
		for i = 2, #waypoints do
			if not npc.model.Parent or npc.cancel then
				return false
			end
			local wp = waypoints[i]
			if not moveTo(npc, wp.Position, 4) then
				-- blocked: try straight towards the target
				break
			end
		end
	end
	if npc.model.Parent and (npc.root.Position - target).Magnitude > 3 then
		moveTo(npc, target, 4)
	end
	if npc.model.Parent and (npc.root.Position - target).Magnitude > 4 then
		-- stuck (blocked path): small teleport so the game never soft-locks
		npc.model:PivotTo(CFrame.new(target + Vector3.new(0, 3, 0)))
	end
	return npc.model.Parent ~= nil
end

function Npc.face(npc, pos)
	if npc.root then
		local p = npc.root.Position
		local look = Vector3.new(pos.X, p.Y, pos.Z)
		if (look - p).Magnitude > 0.1 then
			npc.root.CFrame = CFrame.lookAt(p, look)
		end
	end
end

-- Sits at a seat CFrame (position = seat top, look = facing)
function Npc.sit(npc, sitCf)
	if not npc.root then
		return
	end
	npc.sitting = true
	npc.root.Anchored = true
	npc.model:PivotTo(sitCf * CFrame.new(0, GameConfig.Customers.SeatHeightOffset, 0))
	if npc.play then
		npc.play("sit")
	end
end

function Npc.stand(npc)
	if npc.sitting and npc.root then
		npc.sitting = false
		npc.root.Anchored = false
		npc.model:PivotTo(npc.root.CFrame * CFrame.new(0, 0.5, 1.8))
		if npc.play then
			npc.play("idle")
		end
	end
end

function Npc.emote(npc, name)
	local t = npc.tracks and npc.tracks[name]
	if t then
		t:Play(0.1)
	end
end

function Npc.Start()
	-- prewarm a few customer bodies
	task.spawn(function()
		for _ = 1, 4 do
			local npc = Npc.create({ look = "casual" })
			if npc then
				npc.look = "casual"
				table.insert(pool, npc)
			end
			task.wait(0.2)
		end
	end)
end

return Npc
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000080"><Properties><string name="Name">Placement</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Placed objects: spawning models from the owner's data, building remotes, inventory, painting,
-- ambience. Functional services subscribe to ItemAdded / ItemRemoved / ItemMoved.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Items = require(Shared.Config.Items)
local Surfaces = require(Shared.Config.Surfaces)
local Sets = require(Shared.Config.Sets)
local Upgrades = require(Shared.Config.Upgrades)
local Events = require(Shared.Config.Events)
local Expansions = require(Shared.Config.Expansions)
local PlacementLogic = require(Shared.Logic.Placement)
local Ambience = require(Shared.Logic.Ambience)
local Footprint = require(Shared.Logic.Footprint)
local Registry = require(Shared.Models.Registry)
local Signal = require(Shared.Util.Signal)
local Uid = require(Shared.Util.Uid)
local Core = require(script.Parent.Parent.Core)

local Placement = {}
Placement.ItemAdded = Signal.new() -- (entity)
Placement.ItemRemoved = Signal.new() -- (entity)
Placement.ItemMoved = Signal.new() -- (entity)
Placement.LayoutChanged = Signal.new()
Placement.ambience = { points = 0, tier = 0, patience = 0, tip = 0, popularity = 0, sets = {} }

local vetoes = {} -- functions(entity) -> ok, reason

local FN_KIND = {
	seat = "seat", counter = "counter", table = "table", booth = "booth", shelf = "shelf",
	ricecooker = "ricecooker", pot = "pot", station = "station", sink = "sink", dishwasher = "dishwasher",
	rack = "rack", bench = "bench", fridge = "fridge",
}

function Placement.kindOf(itemId)
	local item = Items.byId[itemId]
	if item and item.fn then
		return FN_KIND[item.fn.type] or "decor"
	end
	return "decor"
end

function Placement.addVeto(fn)
	table.insert(vetoes, fn)
end

local function ownerData()
	return Core.S.Session.ownerData()
end

local function findEntry(data, uid)
	for i, e in ipairs(data.placed) do
		if e.u == uid then
			return e, i
		end
	end
	return nil
end

local function worldY(entry)
	local item = Items.byId[entry.i]
	local World = Core.S.World
	if entry.s == "f" then
		return World.floorY(entry.f)
	elseif entry.s == "c" then
		return World.floorY(entry.f) + GameConfig.WallHeight - item.size[2]
	elseif entry.s == "w" then
		return (entry.y or World.floorY(entry.f) + 6) - item.size[2] / 2
	elseif entry.s == "t" then
		return entry.y or World.floorY(entry.f)
	end
	return 0
end

local function spawn(entry)
	local data = ownerData()
	local model = Registry.build(entry.i, { styles = Expansions.styles(data and data.zones) })
	Registry.place(model, entry.x, worldY(entry), entry.z, entry.r)
	model:SetAttribute("FloorIndex", entry.f or 0)
	model.Parent = Core.S.World.folders().items
	local item = Items.byId[entry.i]
	local e = Core.S.Entities.register(entry.u, Placement.kindOf(entry.i), model, { entry = entry, item = item, isItem = true })
	Placement.ItemAdded:Fire(e)
	return e
end

local function despawn(uid)
	local e = Core.S.Entities.unregister(uid)
	if e then
		Placement.ItemRemoved:Fire(e)
		if e.model then
			e.model:Destroy()
		end
	end
end

function Placement.recomputeAmbience()
	local data = ownerData()
	if not data then
		return
	end
	local extra = Upgrades.value(data.upgrades, "up_jukebox")
	for _, e in ipairs(Expansions.list) do
		if data.zones[e.id] and e.ambience then
			extra += e.ambience
		end
	end
	Placement.ambience = Ambience.compute(data.placed, Items.byId, Surfaces.byId, data.surfaces, extra, Sets.list)
	workspace:SetAttribute("Ambience", Placement.ambience.points)
	workspace:SetAttribute("AmbienceTier", Placement.ambience.tier)
	local decor = 0
	for _, e in ipairs(data.placed) do
		if Placement.kindOf(e.i) == "decor" then
			decor += 1
		end
	end
	data.stats.decor = math.max(data.stats.decor or 0, decor)
end

local function changed()
	local Session = Core.S.Session
	Placement.recomputeAmbience()
	Core.S.Data.changed(Session.owner, "placed")
	Core.S.Data.changed(Session.owner, "inventory")
	Placement.LayoutChanged:Fire()
end

function Placement.spawnAll(data)
	for _, e in pairs(Core.S.Entities.all()) do
		if e.isItem then
			despawn(e.uid)
		end
	end
	-- floor items first so tops find their parents
	table.sort(data.placed, function(a, b)
		local order = { f = 1, w = 2, c = 3, t = 4 }
		return (order[a.s] or 5) < (order[b.s] or 5)
	end)
	for _, entry in ipairs(data.placed) do
		if Items.byId[entry.i] then
			local ok, err = pcall(spawn, entry)
			if not ok then
				warn("[Placement] could not spawn " .. tostring(entry.i) .. ": " .. tostring(err))
			end
		end
	end
	Placement.recomputeAmbience()
	Placement.LayoutChanged:Fire()
end

-- Removes objects that are no longer valid (e.g. after stairs appear) into the inventory
function Placement.revalidate(data)
	local ctx = Core.S.World.ctx(data.placed)
	local removed = 0
	for i = #data.placed, 1, -1 do
		local e = data.placed[i]
		local others = table.clone(data.placed)
		table.remove(others, i)
		ctx.placed = others
		local ok = PlacementLogic.validate(ctx, e, true)
		if not ok then
			table.remove(data.placed, i)
			data.inventory[e.i] = (data.inventory[e.i] or 0) + 1
			removed += 1
		end
	end
	return removed
end

local function canAfford(player, data, item, fromInventory)
	if fromInventory then
		return (data.inventory[item.id] or 0) > 0
	end
	if item.sakura then
		return (data.sakura or 0) >= item.sakura
	end
	return (data.yen or 0) >= item.price
end

local function itemUnlocked(data, item)
	if data.level < (item.lv or 1) then
		return false, "msg.need_level"
	end
	if item.license and not data.licenses[item.license] then
		return false, "msg.need_license"
	end
	if item.event then
		local active = Events.active(os.time())
		if not active or active.id ~= item.event then
			return false, "msg.event_over"
		end
	end
	if item.franchise and not (data.franchise.cities and data.franchise.cities[item.franchise]) then
		return false, "msg.need_franchise"
	end
	return true
end

local function parseReq(req)
	if type(req) ~= "table" then
		return nil
	end
	local Net = Core.S.Net
	if not (Net.str(req.i, 40) and Net.num(req.x, -500, 500) and Net.num(req.z, -500, 500) and Net.num(req.r or 0, -720, 720)) then
		return nil
	end
	local out = {
		i = req.i,
		x = math.floor(req.x * 100 + 0.5) / 100,
		z = math.floor(req.z * 100 + 0.5) / 100,
		r = math.floor((req.r or 0) % 360 + 0.5),
		f = (Net.num(req.f, 0, 3) and math.floor(req.f)) or 0,
		s = req.s,
		y = Net.num(req.y, -10, 100) and req.y or nil,
		p = Net.str(req.p, 40) and req.p or nil,
	}
	return out
end

local function checkVetoes(uid)
	local e = Core.S.Entities.get(uid)
	if not e then
		return true
	end
	for _, fn in ipairs(vetoes) do
		local ok, reason = fn(e)
		if not ok then
			return false, reason
		end
	end
	return true
end

function Placement.place(player, rawReq, fromInventory)
	local Session, Net, Economy = Core.S.Session, Core.S.Net, Core.S.Economy
	if not Session.canBuild(player) then
		return Net.notify(player, "msg.no_permission", nil, "error")
	end
	local data = ownerData()
	local req = parseReq(rawReq)
	if not data or not req then
		return
	end
	local item = Items.byId[req.i]
	if not item then
		return
	end
	if not fromInventory then
		local ok, reason = itemUnlocked(data, item)
		if not ok then
			return Net.notify(player, reason, { level = item.lv }, "error")
		end
	end
	if item.gamepass and not fromInventory and Core.S.Monetization.ownerHas(item.gamepass) then
		fromInventory = (data.inventory[item.id] or 0) > 0
	end
	if not canAfford(player, data, item, fromInventory) then
		return Net.notify(player, "msg.not_enough", nil, "error")
	end
	local ctx = Core.S.World.ctx(data.placed)
	local ok, reason, resolved = PlacementLogic.validate(ctx, req)
	if not ok then
		return Net.notify(player, reason or "msg.place_invalid", nil, "error")
	end
	if fromInventory then
		data.inventory[item.id] -= 1
		if data.inventory[item.id] <= 0 then
			data.inventory[item.id] = nil
		end
	elseif item.sakura then
		if not Economy.spendSakura(Session.owner, item.sakura) then
			return
		end
	else
		if not Economy.spend(Session.owner, item.price, "build") then
			return Net.notify(player, "msg.not_enough", nil, "error")
		end
	end
	local entry = { u = Uid.new("p"), i = item.id, x = resolved.x, z = resolved.z, r = resolved.r, f = resolved.f, s = resolved.s, t = os.time() }
	if resolved.s == "w" or resolved.s == "t" then
		entry.y = resolved.y
	end
	if resolved.p then
		entry.p = resolved.p
	end
	entry.paid = (not fromInventory) and (item.sakura and 0 or item.price) or 0
	table.insert(data.placed, entry)
	spawn(entry)
	changed()
	Net.fxTo(player, "sfx", { name = "place" })
	Core.S.Meta.event(Session.owner, "place", 1, { item = item.id })
end

local function children(data, uid)
	local out = {}
	for _, e in ipairs(data.placed) do
		if e.p == uid then
			table.insert(out, e)
		end
	end
	return out
end

function Placement.move(player, uid, rawReq)
	local Session, Net = Core.S.Session, Core.S.Net
	if not Session.canBuild(player) or type(uid) ~= "string" then
		return
	end
	local data = ownerData()
	local entry = data and findEntry(data, uid)
	local req = parseReq(rawReq)
	if not entry or not req or req.i ~= entry.i then
		return
	end
	local okVeto, vetoReason = checkVetoes(uid)
	if not okVeto then
		return Net.notify(player, vetoReason, nil, "error")
	end
	req.u = uid
	local ctx = Core.S.World.ctx(data.placed)
	local ok, reason, resolved = PlacementLogic.validate(ctx, req)
	if not ok then
		return Net.notify(player, reason or "msg.place_invalid", nil, "error")
	end
	local dx, dz = resolved.x - entry.x, resolved.z - entry.z
	local dr = resolved.r - entry.r
	local oldX, oldZ = entry.x, entry.z
	entry.x, entry.z, entry.r, entry.f, entry.s = resolved.x, resolved.z, resolved.r, resolved.f, resolved.s
	entry.y = (resolved.s == "w" or resolved.s == "t") and resolved.y or nil
	entry.p = resolved.p
	-- children on top follow (rotated around the parent's center)
	for _, child in ipairs(children(data, uid)) do
		local lx, lz = child.x - oldX, child.z - oldZ
		local a = math.rad(-dr)
		local rx = lx * math.cos(a) - lz * math.sin(a)
		local rz = lx * math.sin(a) + lz * math.cos(a)
		child.x, child.z = resolved.x + rx, resolved.z + rz
		child.r = (child.r + dr) % 360
		child.f = entry.f
		local item = Items.byId[entry.i]
		child.y = Core.S.World.floorY(entry.f) + item.size[2]
	end
	local _ = { dx, dz }
	for _, e in ipairs({ entry, table.unpack(children(data, uid)) }) do
		local ent = Core.S.Entities.get(e.u)
		if ent and ent.model then
			ent.model:SetAttribute("FloorIndex", e.f or 0)
			Registry.place(ent.model, e.x, worldY(e), e.z, e.r)
			Placement.ItemMoved:Fire(ent)
		end
	end
	changed()
	Net.fxTo(player, "sfx", { name = "place" })
end

function Placement.remove(player, uid, mode)
	local Session, Net, Economy = Core.S.Session, Core.S.Net, Core.S.Economy
	if not Session.canBuild(player) or type(uid) ~= "string" then
		return
	end
	local data = ownerData()
	local entry, index = nil, nil
	if data then
		entry, index = findEntry(data, uid)
	end
	if not entry then
		return
	end
	local okVeto, vetoReason = checkVetoes(uid)
	if not okVeto then
		return Net.notify(player, vetoReason, nil, "error")
	end
	for _, child in ipairs(children(data, uid)) do
		local _, ci = findEntry(data, child.u)
		table.remove(data.placed, ci)
		data.inventory[child.i] = (data.inventory[child.i] or 0) + 1
		despawn(child.u)
	end
	index = select(2, findEntry(data, uid))
	table.remove(data.placed, index)
	despawn(uid)
	local item = Items.byId[entry.i]
	if mode == "sell" and not item.sakura then
		local paid = entry.paid or item.price
		local refund = (os.time() - (entry.t or 0) <= GameConfig.FullRefundSeconds) and paid or math.floor(paid * GameConfig.SellRefund)
		if refund > 0 then
			Economy.add(Session.owner, refund, "refund", { raw = true })
		end
	else
		data.inventory[entry.i] = (data.inventory[entry.i] or 0) + 1
	end
	changed()
end

function Placement.paint(player, zoneId, kind, styleId)
	local Session, Net, Economy = Core.S.Session, Core.S.Net, Core.S.Economy
	if not Session.canBuild(player) then
		return
	end
	local data = ownerData()
	local style = Surfaces.byId[styleId]
	if not data or not style or style.kind ~= kind then
		return
	end
	local zone = nil
	for _, z in ipairs(Core.S.World.zones) do
		if z.id == zoneId and not z.outdoor then
			zone = z
		end
	end
	if not zone then
		return
	end
	if data.level < style.lv then
		return Net.notify(player, "msg.need_level", { level = style.lv }, "error")
	end
	data.surfaces[zoneId] = data.surfaces[zoneId] or {}
	if data.surfaces[zoneId][kind] == styleId then
		return
	end
	if style.price > 0 and not Economy.spend(Session.owner, style.price, "build") then
		return Net.notify(player, "msg.not_enough", nil, "error")
	end
	data.surfaces[zoneId][kind] = styleId
	Core.S.World.rebuild(data)
	Core.S.Data.changed(Session.owner, "surfaces")
	Placement.recomputeAmbience()
	Net.fxTo(player, "sfx", { name = "place" })
end

-- Items whose footprint is close to a point (used by seating / freshness)
function Placement.near(x, z, f, radius, filterFn)
	local out = {}
	local data = ownerData()
	if not data then
		return out
	end
	for _, e in ipairs(data.placed) do
		if (e.f or 0) == f and (not filterFn or filterFn(e)) then
			local item = Items.byId[e.i]
			if item then
				local fp = Footprint.new(e.x, e.z, item.size[1], item.size[3], e.r)
				local x0, z0, x1, z1 = Footprint.bounds(fp)
				local dx = math.max(x0 - x, 0, x - x1)
				local dz = math.max(z0 - z, 0, z - z1)
				if math.sqrt(dx * dx + dz * dz) <= radius then
					table.insert(out, e)
				end
			end
		end
	end
	return out
end

function Placement.Init()
	local Net = Core.S.Net
	Net.on("PlaceItem", function(player, req, fromInventory)
		Placement.place(player, req, fromInventory == true)
	end, 6)
	Net.on("MoveItem", function(player, uid, req)
		Placement.move(player, uid, req)
	end, 6)
	Net.on("RemoveItem", function(player, uid, mode)
		Placement.remove(player, uid, mode == "sell" and "sell" or "store")
	end, 6)
	Net.on("PaintSurface", function(player, zoneId, kind, styleId)
		if type(zoneId) == "string" and (kind == "floor" or kind == "wall") and type(styleId) == "string" then
			Placement.paint(player, zoneId, kind, styleId)
		end
	end, 3)
end

function Placement.Start()
	Core.S.Session.OwnerReady:Connect(function(_, data)
		task.defer(function()
			Placement.spawnAll(data)
		end)
	end)
end

return Placement
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000081"><Properties><string name="Name">Progression</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Restaurant level, licenses, upgrades, ads, expansions, menu, mastery, rating and popularity.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Licenses = require(Shared.Config.Licenses)
local Recipes = require(Shared.Config.Recipes)
local Upgrades = require(Shared.Config.Upgrades)
local Ads = require(Shared.Config.Ads)
local Expansions = require(Shared.Config.Expansions)
local Franchise = require(Shared.Config.Franchise)
local Events = require(Shared.Config.Events)
local Staff = require(Shared.Config.Staff)
local Formulas = require(Shared.Logic.Formulas)
local Core = require(script.Parent.Parent.Core)

local Progression = {}

local function owner()
	return Core.S.Session.owner
end

local function data()
	return Core.S.Session.ownerData()
end

function Progression.rating()
	local d = data()
	if not d then
		return GameConfig.Customers.DefaultRating
	end
	return Formulas.rating(d.reviews.recent, GameConfig.Customers.DefaultRating)
end

function Progression.addReview(stars, weight)
	local d = data()
	if not d then
		return
	end
	table.insert(d.reviews.recent, { s = stars, w = weight or 1 })
	while #d.reviews.recent > GameConfig.Customers.RecentReviews do
		table.remove(d.reviews.recent, 1)
	end
	d.reviews.total += 1
	d.reviews.sum += stars
	if stars >= 5 then
		d.stats.five_stars = (d.stats.five_stars or 0) + 1
		Core.S.Meta.event(owner(), "five_stars", 1)
	end
	workspace:SetAttribute("Rating", Progression.rating())
	Core.S.Data.changed(owner(), "reviews")
end

function Progression.addXp(player, amount)
	local d = Core.S.Data.get(player)
	if not d or amount <= 0 then
		return
	end
	local mult = 1 + (d.franchise.stars or 0) * Franchise.XpPerStar
	local newLevel, newXp, gained = Formulas.addXp(d.level, d.xp, math.floor(amount * mult + 0.5))
	local oldLevel = d.level
	d.level, d.xp = newLevel, newXp
	Core.S.Data.changed(player, "xp")
	if gained > 0 then
		for lvl = oldLevel + 1, newLevel do
			local yen, sakura = Formulas.levelReward(lvl)
			Core.S.Economy.add(player, yen, "level")
			if sakura > 0 then
				Core.S.Economy.addSakura(player, sakura)
			end
		end
		Core.S.Data.changed(player, "level")
		Core.S.Net.notifyAll("msg.level_up", { level = newLevel }, "level")
		Core.S.Net.fx("levelup", { level = newLevel, userId = player.UserId })
		Core.S.Meta.event(player, "level", newLevel)
	end
end

function Progression.isRecipeUnlocked(d, recipe)
	if recipe.city then
		return d.franchise.city == recipe.city and d.level >= Franchise.RegionalLevel
	end
	return recipe.license ~= nil and d.licenses[recipe.license] == true
end

-- Recipes the restaurant can currently sell (unlocked + enabled in the menu)
function Progression.menuRecipes(d)
	local out = {}
	for _, r in ipairs(Recipes.list) do
		if Progression.isRecipeUnlocked(d, r) then
			local m = d.menu[r.id]
			if not m then
				m = { on = true, price = 1 }
				d.menu[r.id] = m
			end
			if m.on then
				table.insert(out, r)
			end
		end
	end
	return out
end

function Progression.priceOf(d, recipe)
	local m = d.menu[recipe.id]
	return Formulas.dishPrice(recipe.price, d.mastery[recipe.id] or 0, m and m.price or 1)
end

function Progression.addMastery(recipeId)
	local d = data()
	if not d then
		return
	end
	local before = Formulas.masteryLevel(d.mastery[recipeId] or 0)
	d.mastery[recipeId] = (d.mastery[recipeId] or 0) + 1
	local after = Formulas.masteryLevel(d.mastery[recipeId])
	if after > before then
		Core.S.Net.notifyAll("msg.mastery_up", { dish = "rec." .. recipeId, level = after }, "level")
		if after == #Formulas.MasteryThresholds then
			d.stats.gold_mastery = (d.stats.gold_mastery or 0) + 1
		end
		Core.S.Data.changed(owner(), "mastery")
	end
end

function Progression.popularity()
	local d = data()
	if not d then
		return 0
	end
	local ads = 0
	for id, day in pairs(d.ads or {}) do
		local ad = Ads.byId[id]
		if ad and day == (d.stats.days or 0) + 1 then
			ads += ad.popularity
		end
	end
	local extra = 0
	for _, e in ipairs(Expansions.list) do
		if d.zones[e.id] and e.popularity then
			extra += e.popularity
		end
	end
	if d.boosts.influencer and d.boosts.influencer == (d.stats.days or 0) + 1 then
		extra += 0.25
	end
	local ev = Events.active(os.time())
	local amb = Core.S.Placement.ambience
	return Formulas.popularity({
		level = d.level,
		rating = Progression.rating(),
		ambience = amb.popularity,
		sign = Upgrades.value(d.upgrades, "up_sign"),
		ads = ads,
		event = ev and ev.popularity or 0,
		extra = extra,
	})
end

function Progression.staffSlots(d)
	local slots = Staff.BaseSlots
	for zone, n in pairs(Staff.SlotsByZone) do
		if d.zones[zone] then
			slots += n
		end
	end
	return math.min(slots, GameConfig.MaxStaff)
end

local function payer(player)
	local Session = Core.S.Session
	if not Session.canBuild(player) then
		Core.S.Net.notify(player, "msg.no_permission", nil, "error")
		return nil
	end
	return Session.owner, Session.ownerData()
end

local function buyLicense(player, id)
	local o, d = payer(player)
	local lic = Licenses.byId[id]
	if not o or not d or not lic or d.licenses[id] then
		return
	end
	local Net = Core.S.Net
	if d.level < lic.level then
		return Net.notify(player, "msg.need_level", { level = lic.level }, "error")
	end
	for _, req in ipairs(lic.requires) do
		if not d.licenses[req] then
			return Net.notify(player, "msg.need_license", nil, "error")
		end
	end
	if lic.rating > 0 and Progression.rating() < lic.rating then
		return Net.notify(player, "msg.need_rating", { rating = lic.rating }, "error")
	end
	if not Core.S.Economy.spend(o, lic.cost, "build") then
		return Net.notify(player, "msg.not_enough", nil, "error")
	end
	d.licenses[id] = true
	for _, rid in ipairs(lic.recipes) do
		d.menu[rid] = d.menu[rid] or { on = true, price = 1 }
	end
	Core.S.Data.changed(o, "licenses")
	Core.S.Data.changed(o, "menu")
	Net.notifyAll("msg.license_bought", { name = "lic." .. id }, "success")
	Net.fx("sparkle", { userId = player.UserId })
	Core.S.Meta.event(o, "licenses", 1)
end

local function buyUpgrade(player, id)
	local o, d = payer(player)
	local up = Upgrades.byId[id]
	if not o or not d or not up then
		return
	end
	local Net = Core.S.Net
	local lvl = d.upgrades[id] or 0
	if lvl >= up.max then
		return Net.notify(player, "msg.max_level", nil, "error")
	end
	local nextLvl = lvl + 1
	if d.level < up.levels[nextLvl] then
		return Net.notify(player, "msg.need_level", { level = up.levels[nextLvl] }, "error")
	end
	if up.needsStaff then
		local has = false
		for _, s in ipairs(d.staff) do
			if s.role == up.needsStaff then
				has = true
			end
		end
		if not has then
			return Net.notify(player, "msg.need_staff", { role = "staff." .. up.needsStaff }, "error")
		end
	end
	if not Core.S.Economy.spend(o, up.costs[nextLvl], "build") then
		return Net.notify(player, "msg.not_enough", nil, "error")
	end
	d.upgrades[id] = nextLvl
	Core.S.Data.changed(o, "upgrades")
	Net.notifyAll("msg.upgrade_bought", { name = "upg." .. id, level = nextLvl }, "success")
	if id == "up_jukebox" then
		Core.S.Placement.recomputeAmbience()
	elseif id == "up_shoes" then
		Progression.applyWalkSpeed()
	end
end

local function buyAd(player, id)
	local o, d = payer(player)
	local ad = Ads.byId[id]
	if not o or not d or not ad then
		return
	end
	local Net = Core.S.Net
	if d.level < ad.lv then
		return Net.notify(player, "msg.need_level", { level = ad.lv }, "error")
	end
	local day = (d.stats.days or 0) + 1
	if d.ads[id] == day then
		return Net.notify(player, "msg.ad_active", nil, "error")
	end
	if not Core.S.Economy.spend(o, ad.cost, "other") then
		return Net.notify(player, "msg.not_enough", nil, "error")
	end
	d.ads[id] = day
	Core.S.Data.changed(o, "ads")
	Net.notifyAll("msg.ad_bought", { name = "ad." .. id }, "success")
end

local function buyExpansion(player, id)
	local o, d = payer(player)
	local exp = Expansions.byId[id]
	if not o or not d or not exp or d.zones[id] then
		return
	end
	local Net = Core.S.Net
	if d.level < exp.lv then
		return Net.notify(player, "msg.need_level", { level = exp.lv }, "error")
	end
	for _, req in ipairs(exp.requires) do
		if not d.zones[req] then
			return Net.notify(player, "msg.need_zone", { name = "zone." .. req }, "error")
		end
	end
	if not Core.S.Economy.spend(o, exp.cost, "build") then
		return Net.notify(player, "msg.not_enough", nil, "error")
	end
	d.zones[id] = true
	for _, z in ipairs(exp.zones or {}) do
		if z.floorStyle or z.wallStyle then
			d.surfaces[z.id] = d.surfaces[z.id] or { floor = z.floorStyle, wall = z.wallStyle }
		end
	end
	Net.fx("construction", { zone = id })
	task.wait(1.5)
	local World, Placement = Core.S.World, Core.S.Placement
	World.rebuild(d)
	local moved = Placement.revalidate(d)
	Placement.spawnAll(d)
	Core.S.Data.changed(o, "zones")
	Core.S.Data.changed(o, "placed")
	Core.S.Data.changed(o, "inventory")
	Net.notifyAll(exp.reno and "msg.reno_bought" or "msg.expansion_bought", { name = "zone." .. id }, "success")
	if moved > 0 then
		Net.notify(o, "msg.items_to_inventory", { n = moved })
	end
	Core.S.Meta.event(o, exp.reno and "renos" or "zones", 1)
end

local function setMenu(player, recipeId, on, priceMult)
	local o, d = payer(player)
	local r = Recipes.byId[recipeId]
	if not o or not d or not r or not Progression.isRecipeUnlocked(d, r) then
		return
	end
	local m = d.menu[recipeId] or { on = true, price = 1 }
	if type(on) == "boolean" then
		m.on = on
	end
	if type(priceMult) == "number" then
		m.price = math.clamp(math.floor(priceMult * 10 + 0.5) / 10, 0.7, 1.3)
	end
	d.menu[recipeId] = m
	Core.S.Data.changed(o, "menu")
end

function Progression.applyWalkSpeed()
	local d = data()
	if not d then
		return
	end
	local speed = GameConfig.WalkSpeed * Upgrades.value(d.upgrades, "up_shoes")
	for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
		local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.WalkSpeed = speed
		end
	end
end

function Progression.Init()
	local Net = Core.S.Net
	Net.on("BuyLicense", buyLicense, 3)
	Net.on("BuyUpgrade", buyUpgrade, 3)
	Net.on("BuyAd", buyAd, 3)
	Net.on("BuyExpansion", buyExpansion, 2)
	Net.on("SetMenu", setMenu, 8)
end

function Progression.Start()
	Core.S.Session.OwnerReady:Connect(function()
		workspace:SetAttribute("Rating", Progression.rating())
		Progression.applyWalkSpeed()
	end)
	game:GetService("Players").PlayerAdded:Connect(function(p)
		p.CharacterAdded:Connect(function()
			task.wait(0.2)
			Progression.applyWalkSpeed()
		end)
	end)
end

return Progression
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000082"><Properties><string name="Name">Seating</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Works out which seats are usable (stool in front of a counter, chair next to a table,
-- booths), where the dish goes, and keeps reservations / dirty dishes per seat.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Items = require(Shared.Config.Items)
local Footprint = require(Shared.Logic.Footprint)
local Core = require(script.Parent.Parent.Core)

local Seating = {}
Seating.seats = {} -- list of seat records
local byId = {}
local benches = {}

local SURFACES = { counter = true, table = true }
local PAIR_DISTANCE = 1.6 -- max gap between seat edge and surface edge

local function topY(entry)
	local item = Items.byId[entry.i]
	return Core.S.World.floorY(entry.f) + item.size[2]
end

-- closest point of an oriented footprint to (x, z)
local function closestPoint(fp, x, z)
	local ax, az = Footprint.axes(fp)
	local dx, dz = x - fp.x, z - fp.z
	local lx = math.clamp(dx * ax.x + dz * ax.z, -fp.w / 2 + 0.6, fp.w / 2 - 0.6)
	local lz = math.clamp(dx * az.x + dz * az.z, -fp.d / 2 + 0.6, fp.d / 2 - 0.6)
	return fp.x + ax.x * lx + az.x * lz, fp.z + ax.z * lx + az.z * lz
end

local function gap(fpA, fpB)
	if Footprint.overlaps(fpA, fpB, 0) then
		return 0
	end
	local best = math.huge
	for _, c in ipairs(Footprint.corners(fpA)) do
		local px, pz = closestPoint(Footprint.inflate(fpB, 0.6), c.x, c.z)
		best = math.min(best, math.sqrt((px - c.x) ^ 2 + (pz - c.z) ^ 2))
	end
	local cx, cz = closestPoint(Footprint.inflate(fpB, 0.6), fpA.x, fpA.z)
	best = math.min(best, math.sqrt((cx - fpA.x) ^ 2 + (cz - fpA.z) ^ 2) - math.max(fpA.w, fpA.d) / 2)
	return math.max(0, best)
end

function Seating.refresh()
	local d = Core.S.Session.ownerData()
	if not d then
		return
	end
	local old = byId
	local seats, newById = {}, {}
	benches = {}
	local surfaces = {}
	for _, e in ipairs(d.placed) do
		local item = Items.byId[e.i]
		if item and item.fn and SURFACES[item.fn.type] and e.s == "f" then
			table.insert(surfaces, { entry = e, item = item, fp = Footprint.new(e.x, e.z, item.size[1], item.size[3], e.r) })
		end
	end
	local function add(rec)
		-- keep the same record object so customers holding a reference stay in sync
		local prev = old[rec.id]
		if prev then
			for k, v in pairs(rec) do
				prev[k] = v
			end
			rec = prev
		end
		table.insert(seats, rec)
		newById[rec.id] = rec
	end
	for _, e in ipairs(d.placed) do
		local item = Items.byId[e.i]
		local ent = Core.S.Entities.get(e.u)
		if item and item.fn and ent and ent.model and e.s == "f" then
			local zone = Core.S.World.zoneAt(e.x, e.z, e.f)
			local area = zone and zone.area or "dining"
			if item.fn.type == "seat" then
				local fp = Footprint.new(e.x, e.z, item.size[1], item.size[3], e.r)
				local best, bestGap = nil, PAIR_DISTANCE
				for _, s in ipairs(surfaces) do
					if (s.entry.f or 0) == (e.f or 0) then
						local g = gap(fp, s.fp)
						if g <= bestGap then
							best, bestGap = s, g
						end
					end
				end
				if best then
					local px, pz = closestPoint(best.fp, e.x, e.z)
					local dish = Vector3.new(px, topY(best.entry) + 0.05, pz)
					local sitY = Core.S.World.floorY(e.f) + item.fn.height
					local seatPos = Vector3.new(e.x, sitY, e.z)
					local look = Vector3.new(px, sitY, pz)
					local sitCf
					if item.fn.symmetric then
						sitCf = CFrame.lookAt(seatPos, look)
					else
						sitCf = CFrame.new(seatPos) * CFrame.Angles(0, math.rad(e.r), 0)
					end
					add({
						id = e.u, itemUid = e.u, surface = best.entry.u, group = best.item.fn.type == "table" and best.entry.u or nil,
						sit = sitCf, dish = dish, floor = e.f or 0, area = area, comfort = item.fn.comfort or 0,
						vip = area == "tatami", counter = best.item.fn.type == "counter",
					})
				end
			elseif item.fn.type == "booth" then
				local root = ent.model.PrimaryPart
				for k = 1, item.fn.seats do
					local seatAtt = root:FindFirstChild("Seat" .. k)
					local dishAtt = root:FindFirstChild("Dish" .. k)
					if seatAtt and dishAtt then
						add({
							id = e.u .. "#" .. k, itemUid = e.u, surface = e.u, group = e.u,
							sit = seatAtt.WorldCFrame, dish = dishAtt.WorldPosition, floor = e.f or 0, area = area,
							comfort = item.fn.comfort or 0, vip = item.fn.vip == true or area == "tatami", counter = false,
						})
					end
				end
			elseif item.fn.type == "bench" then
				local root = ent.model.PrimaryPart
				for k = 1, item.fn.queue do
					local att = root:FindFirstChild("Queue" .. k)
					if att then
						table.insert(benches, { id = e.u .. "#q" .. k, sit = att.WorldCFrame, taken = nil })
					end
				end
			end
		end
	end
	Seating.seats = seats
	byId = newById
	workspace:SetAttribute("Seats", #seats)
end

function Seating.get(id)
	return byId[id]
end

local function free(s)
	return not s.occupant and not s.reserved and not s.dirty
end

function Seating.freeCount()
	local n = 0
	for _, s in ipairs(Seating.seats) do
		if free(s) then
			n += 1
		end
	end
	return n
end

-- Finds seats for a group. needsTable: only table/booth groups. vip: tatami seats only.
function Seating.find(size, needsTable, vip)
	local candidates = {}
	for _, s in ipairs(Seating.seats) do
		if free(s) and ((vip and s.vip) or (not vip and not s.vip)) then
			table.insert(candidates, s)
		end
	end
	if size == 1 and not needsTable then
		-- singles prefer the counter
		table.sort(candidates, function(a, b)
			if a.counter ~= b.counter then
				return a.counter
			end
			return a.id < b.id
		end)
		return candidates[1] and { candidates[1] } or nil
	end
	local groups = {}
	for _, s in ipairs(candidates) do
		if s.group then
			groups[s.group] = groups[s.group] or {}
			table.insert(groups[s.group], s)
		end
	end
	for _, list in pairs(groups) do
		if #list >= size then
			local out = {}
			for i = 1, size do
				out[i] = list[i]
			end
			return out
		end
	end
	return nil
end

function Seating.reserve(list, who)
	for _, s in ipairs(list) do
		s.reserved = who
	end
end

function Seating.release(s)
	if s then
		s.reserved = nil
		s.occupant = nil
	end
end

function Seating.benchSpot(who)
	for _, b in ipairs(benches) do
		if not b.taken then
			b.taken = who
			return b
		end
	end
	return nil
end

function Seating.freeBench(b)
	if b then
		b.taken = nil
	end
end

function Seating.queueCapacity()
	return #benches
end

-- Veto: occupied seats and surfaces with diners cannot be moved
local function busy(uid)
	for _, s in ipairs(Seating.seats) do
		if (s.itemUid == uid or s.surface == uid) and (s.occupant or s.reserved or s.dirty) then
			return true
		end
	end
	return false
end

function Seating.Init()
	local Placement = Core.S.Placement
	Placement.LayoutChanged:Connect(function()
		task.defer(Seating.refresh)
	end)
	Placement.addVeto(function(e)
		if busy(e.uid) then
			return false, "msg.seat_busy"
		end
		return true
	end)
end

return Seating
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000083"><Properties><string name="Name">SelfTest</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- End-to-end self test of the core loop, started from the dev panel. It drives the real services
-- with an invisible worker: restock, rice, cook a kappa maki, serve a customer, get paid, wash.
-- Results go to the Output window and to a toast.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Ingredients = require(Shared.Config.Ingredients)
local Expansions = require(Shared.Config.Expansions)
local Registry = require(Shared.Models.Registry)
local PlacementLogic = require(Shared.Logic.Placement)
local Uid = require(Shared.Util.Uid)
local Core = require(script.Parent.Parent.Core)

local SelfTest = {}
local running = false

local function waitFor(fn, timeout)
	local t0 = os.clock()
	while os.clock() - t0 < timeout do
		local v = fn()
		if v then
			return v
		end
		task.wait(0.25)
	end
	return nil
end

function SelfTest.run(player)
	if running then
		return
	end
	running = true
	local S = Core.S
	local d = S.Session.ownerData()
	local actor = { uid = "selftest", alive = true, model = nil }
	local results = {}

	local function check(name, fn)
		local ok, err = pcall(fn)
		table.insert(results, { name = name, ok = ok, err = err })
		if ok then
			print("[SelfTest] PASS " .. name)
		else
			warn("[SelfTest] FAIL " .. name .. ": " .. tostring(err))
		end
		S.Hands.clear(actor)
		return ok
	end

	local function ensureBox(g)
		local entry = S.Supply.findBox(g)
		if not entry then
			table.insert(d.storage, { u = Uid.new("b"), g = g, n = Ingredients.byId[g].units })
			S.Supply.layout()
		end
		local e, ent = S.Supply.findBox(g)
		assert(e and ent, "no box entity for " .. g)
		return e, ent
	end

	local function returnLeftover()
		local h = S.Hands.get(actor)
		if h.kind == "box" then
			for _, b in ipairs(h.items) do
				S.Supply.returnBox(b)
			end
		end
		S.Hands.clear(actor)
	end

	local function firstOf(kind, filter)
		for _, e in ipairs(S.Entities.ofKind(kind)) do
			if not filter or filter(e) then
				return e
			end
		end
		return nil
	end

	check("world and starter objects", function()
		assert(#S.World.zones > 0, "no zones")
		assert(firstOf("shelf"), "no shelf")
		assert(firstOf("station", function(e)
			return e.item.fn.station == "sushi"
		end), "no sushi station")
		assert(firstOf("ricecooker"), "no rice cooker")
		assert(firstOf("sink"), "no sink")
		assert(firstOf("rack"), "no storage rack")
	end)

	check("seats around the counter", function()
		S.Seating.refresh()
		assert(#S.Seating.seats >= 6, "only " .. #S.Seating.seats .. " seats")
	end)

	check("restock a shelf", function()
		for _, g in ipairs({ "nori", "cucumber" }) do
			local _, ent = ensureBox(g)
			assert(S.Supply.takeBox(actor, ent), "could not take the box")
			local shelf = firstOf("shelf", function(e)
				return not e.item.fn.fishOnly
			end)
			local ok, msg = S.Supply.useShelf(actor, shelf, nil)
			assert(ok, "useShelf: " .. tostring(msg))
			returnLeftover()
			assert(S.Supply.shelfStock(g) > 0, g .. " not on the shelf")
		end
	end)

	check("cook rice", function()
		local rc = firstOf("ricecooker")
		if not S.Appliance.hasRice() then
			local _, ent = ensureBox("rice")
			assert(S.Supply.takeBox(actor, ent), "could not take the rice box")
			local ok, msg = S.Appliance.load(actor, rc)
			assert(ok or msg == "msg.cooking_wait", "load: " .. tostring(msg))
			returnLeftover()
			local st = d.appliances[rc.uid]
			if st and st.c > 0 then
				st.t = workspace:GetServerTimeNow() - 1 -- fast-forward
			end
			assert(waitFor(S.Appliance.hasRice, 5), "rice never got ready")
		end
	end)

	check("cook a kappa maki with clicks", function()
		for _, g in ipairs({ "nori", "cucumber" }) do
			local shelf, slot = S.Supply.findShelfWith(g)
			assert(shelf, "no " .. g .. " on the shelves")
			local ok, msg = S.Supply.useShelf(actor, shelf, slot)
			assert(ok, "take " .. g .. ": " .. tostring(msg))
		end
		local station = firstOf("station", function(e)
			return e.item.fn.station == "sushi" and not S.Cooking.stationState(e).busy and not S.Cooking.stationState(e).ready
		end)
		assert(station, "no free sushi station")
		local ok, msg = S.Cooking.use(actor, station, 4)
		assert(ok, "deposit: " .. tostring(msg))
		for _ = 1, 6 do
			if S.Cooking.stationState(station).ready then
				break
			end
			local stepOk, stepMsg = S.Cooking.use(actor, station, 4)
			assert(stepOk, "step: " .. tostring(stepMsg))
		end
		assert(S.Cooking.stationState(station).ready, "dish not ready")
		assert(S.Cooking.use(actor, station, 4), "could not take the dish")
		assert(S.Hands.get(actor).kind == "dish", "no dish in hand")
		actor.keepDish = S.Hands.get(actor).items[1]
	end)

	check("customer orders, is served and pays", function()
		assert(actor.keepDish, "no dish from the previous step")
		if S.Day.phase == "prep" then
			S.Day.open()
		end
		assert(S.Day.phase == "open", "the day is not open")
		local before = d.yen
		local known = {}
		for uid in pairs(S.Customers.active) do
			known[uid] = true
		end
		assert(S.Customers.trySpawn("cust_student"), "no customer could be spawned (seats? menu?)")
		local c = waitFor(function()
			for uid, cust in pairs(S.Customers.active) do
				if not known[uid] and cust.state == "order" then
					return cust
				end
			end
			return nil
		end, 75)
		assert(c, "the customer never sat down to order")
		c.order = "kappa_maki"
		c.npc.model:SetAttribute("Order", "kappa_maki")
		local e = S.Entities.get(c.uid)
		assert(S.Customers.use(actor, e), "could not take the order")
		assert(c.state == "waiting", "state after order: " .. tostring(c.state))
		S.Hands.set(actor, "dish", { actor.keepDish })
		local ok, msg = S.Customers.use(actor, e)
		assert(ok, "serve: " .. tostring(msg))
		assert(waitFor(function()
			return d.yen > before
		end, 40), "the customer did not pay")
		actor.customerSeat = c.seat
	end)

	check("collect the dirty dish and wash it", function()
		local dirty = waitFor(function()
			return firstOf("dirty")
		end, 30)
		assert(dirty, "no dirty dish appeared")
		local ok, msg = S.Customers.collectDirty(actor, dirty)
		assert(ok, "collect: " .. tostring(msg))
		local sink = firstOf("sink")
		local okWash, washMsg = S.Appliance.useSink(actor, sink, 4)
		assert(okWash, "wash: " .. tostring(washMsg))
	end)

	check("plain and renovated models", function()
		local plain = Registry.build("counter_straight", { styles = {} })
		local full = Registry.build("counter_straight", { styles = Expansions.allStyles() })
		assert(not plain:FindFirstChild("Detail_counter"), "the plain counter has renovation details")
		assert(full:FindFirstChild("Detail_counter") and full:FindFirstChild("Detail_tableware"), "the renovated counter misses its details")
		assert(#full:GetDescendants() > #plain:GetDescendants(), "the renovated counter is not more detailed")
		plain:Destroy()
		full:Destroy()
		for _, e in ipairs(Expansions.list) do
			if e.reno then
				assert(e.cosmetic and not e.zones, e.id .. " must be cosmetic")
			end
		end
	end)

	check("placement rules", function()
		local ctx = S.World.ctx(d.placed)
		local ok, reason = PlacementLogic.validate(ctx, { i = "bamboo_pot", x = 12, z = 4, r = 0, f = 0, s = "f" })
		assert(ok, "valid spot refused: " .. tostring(reason))
		ok = PlacementLogic.validate(ctx, { i = "stool_wood", x = 0, z = 22, r = 0, f = 0, s = "f" })
		assert(not ok, "stool in the kitchen accepted")
	end)

	S.Hands.forget(actor)
	local passed, failed = 0, {}
	for _, r in ipairs(results) do
		if r.ok then
			passed += 1
		else
			table.insert(failed, r.name)
		end
	end
	print(string.format("[SelfTest] %d/%d passed", passed, #results))
	S.Net.notify(player, "msg.selftest_result", { passed = passed, total = #results, failed = #failed > 0 and table.concat(failed, ", ") or "—" }, #failed == 0 and "success" or "error")
	running = false
	return passed, #results
end

return SelfTest
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000084"><Properties><string name="Name">Session</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Personal worlds: public servers act as an entrance that teleports every player to their
-- own reserved server; friends can join through invites. In Studio the server is a world directly.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")
local DataStoreService = game:GetService("DataStoreService")
local MemoryStoreService = game:GetService("MemoryStoreService")
local HttpService = game:GetService("HttpService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Signal = require(Shared.Util.Signal)
local Core = require(script.Parent.Parent.Core)

local Session = {}
Session.mode = "world"
Session.owner = nil
Session.ownerId = nil
Session.OwnerReady = Signal.new() -- (player, data)
Session.RolesChanged = Signal.new()

local codesStore, ownersStore, liveMap
local isReservedServer = game.PrivateServerId ~= "" and game.PrivateServerOwnerId == 0

local function safe(fn, ...)
	local ok, a, b = pcall(fn, ...)
	if ok then
		return a, b
	end
	warn("[Session] " .. tostring(a))
	return nil
end

function Session.role(player)
	if not player then
		return "none"
	end
	if player == Session.owner then
		return "owner"
	end
	local od = Session.ownerData()
	local perm = od and od.perms and od.perms[tostring(player.UserId)]
	if perm == "comanager" then
		return "comanager"
	end
	return "helper"
end

function Session.canBuild(player)
	local r = Session.role(player)
	return r == "owner" or r == "comanager"
end

function Session.canWork(player)
	return Session.role(player) ~= "none"
end

function Session.ownerData()
	if not Session.owner then
		return nil
	end
	return Core.S.Data.get(Session.owner)
end

function Session.info(player)
	return {
		mode = Session.mode,
		ownerId = Session.ownerId,
		ownerName = Session.owner and Session.owner.DisplayName or nil,
		role = Session.role(player),
		studio = RunService:IsStudio(),
	}
end

local function broadcastInfo()
	for _, p in ipairs(Players:GetPlayers()) do
		Core.S.Net.fire(p, "Session", Session.info(p))
	end
end

local function worldCode(userId)
	if not codesStore then
		return nil
	end
	local entry = safe(function()
		return codesStore:GetAsync(tostring(userId))
	end)
	if entry and entry.code then
		return entry.code, entry.ps
	end
	-- ReserveServerAsync is the newer name; ReserveServer is the older fallback
	local code, psId = safe(function()
		return TeleportService:ReserveServerAsync(game.PlaceId)
	end)
	if not code then
		code, psId = safe(function()
			return TeleportService:ReserveServer(game.PlaceId)
		end)
	end
	if not code then
		return nil
	end
	safe(function()
		codesStore:SetAsync(tostring(userId), { code = code, ps = psId })
	end)
	if psId then
		safe(function()
			ownersStore:SetAsync(psId, userId)
		end)
	end
	return code, psId
end

local function teleport(player, code, data, psId)
	for attempt = 1, 3 do
		local opts = Instance.new("TeleportOptions")
		-- the access code is the long-standing way; ReservedServerId is the newer property
		local set = pcall(function()
			if attempt == 2 and psId then
				opts.ReservedServerId = psId
			else
				opts.ReservedServerAccessCode = code
			end
		end)
		if not set then
			pcall(function()
				opts.ReservedServerId = psId
			end)
		end
		opts:SetTeleportData(data or {})
		local ok, err = pcall(function()
			TeleportService:TeleportAsync(game.PlaceId, { player }, opts)
		end)
		if ok then
			return true
		end
		warn("[Session] teleport failed (" .. attempt .. "): " .. tostring(err))
		task.wait(2 * attempt)
	end
	return false
end

function Session.sendToOwnWorld(player)
	local code, psId = worldCode(player.UserId)
	if code and teleport(player, code, { owner = player.UserId }, psId) then
		return true
	end
	return false
end

local function becomeOwner(player)
	Session.owner = player
	Session.ownerId = player.UserId
	task.spawn(function()
		local data = Core.S.Data.waitFor(player, 60)
		if data and Session.owner == player then
			Session.OwnerReady:Fire(player, data)
			broadcastInfo()
			if not Core.S.Data.storeAvailable() then
				Core.S.Net.notify(player, "msg.no_saving", nil, "warning")
			end
		end
	end)
end

local function allowedGuest(player)
	if RunService:IsStudio() then
		return true
	end
	local od = Session.ownerData()
	if od and od.perms and od.perms[tostring(player.UserId)] then
		return true
	end
	local ok, friends = pcall(function()
		return player:IsFriendsWith(Session.ownerId)
	end)
	return ok and friends
end

local function onWorldPlayer(player)
	if not Session.owner then
		if Session.ownerId == nil or player.UserId == Session.ownerId then
			becomeOwner(player)
			return
		end
	end
	if player == Session.owner then
		return
	end
	if Session.owner == nil and Session.ownerId ~= nil and player.UserId == Session.ownerId then
		becomeOwner(player)
		return
	end
	if not Session.owner or not allowedGuest(player) then
		Core.S.Net.notify(player, "msg.world_private")
		task.wait(2)
		if not Session.sendToOwnWorld(player) and not Session.owner then
			becomeOwner(player)
		end
		return
	end
	Core.S.Net.notify(Session.owner, "msg.helper_joined", { name = player.DisplayName })
	broadcastInfo()
end

local function onLobbyPlayer(player)
	local joinData = player:GetJoinData()
	local launch = joinData and joinData.LaunchData
	if type(launch) == "string" and launch ~= "" and liveMap then
		local ok, decoded = pcall(HttpService.JSONDecode, HttpService, launch)
		local ownerId = ok and type(decoded) == "table" and tonumber(decoded.owner) or nil
		if ownerId and ownerId ~= player.UserId then
			local live = safe(function()
				return liveMap:GetAsync(tostring(ownerId))
			end)
			local friends = false
			pcall(function()
				friends = player:IsFriendsWith(ownerId)
			end)
			if live and live.code and friends then
				if teleport(player, live.code, { owner = ownerId, guest = true }, live.ps) then
					return
				end
			else
				Core.S.Net.notify(player, "msg.friend_offline")
			end
		end
	end
	if not Session.sendToOwnWorld(player) then
		-- fallback: play right here as a world
		if not Session.owner then
			Session.mode = "world"
			becomeOwner(player)
			Core.S.Net.notify(player, "msg.teleport_failed")
		end
	end
end

function Session.Init()
	pcall(function()
		codesStore = DataStoreService:GetDataStore("WorldCodes_v1")
		ownersStore = DataStoreService:GetDataStore("WorldOwners_v1")
		liveMap = MemoryStoreService:GetSortedMap("LiveWorlds_v1")
	end)
	if RunService:IsStudio() then
		Session.mode = "world"
	elseif isReservedServer then
		Session.mode = "world"
		local ownerId = safe(function()
			return ownersStore:GetAsync(game.PrivateServerId)
		end)
		Session.ownerId = ownerId
	else
		Session.mode = "lobby"
	end
	workspace:SetAttribute("SessionMode", Session.mode)
	Core.S.Net.on("SetPermission", function(player, userId, level)
		if player ~= Session.owner then
			return
		end
		if type(userId) ~= "number" or (level ~= "helper" and level ~= "comanager") then
			return
		end
		local od = Session.ownerData()
		if not od then
			return
		end
		od.perms[tostring(userId)] = level
		Core.S.Data.changed(player, "perms")
		Session.RolesChanged:Fire()
		broadcastInfo()
	end, 4)
end

function Session.Start()
	Players.PlayerAdded:Connect(function(player)
		player.DevCameraOcclusionMode = Enum.DevCameraOcclusionMode.Invisicam
		if Session.mode == "lobby" then
			onLobbyPlayer(player)
		else
			onWorldPlayer(player)
		end
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(function()
			player.DevCameraOcclusionMode = Enum.DevCameraOcclusionMode.Invisicam
			if Session.mode == "lobby" then
				onLobbyPlayer(player)
			else
				onWorldPlayer(player)
			end
		end)
	end
	Players.PlayerRemoving:Connect(function(player)
		if player == Session.owner then
			Session.owner = nil
			if liveMap then
				safe(function()
					liveMap:RemoveAsync(tostring(player.UserId))
				end)
			end
			if RunService:IsStudio() then
				local nextOwner = nil
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= player then
						nextOwner = p
						break
					end
				end
				if nextOwner then
					Session.ownerId = nextOwner.UserId
					becomeOwner(nextOwner)
				end
				return
			end
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= player then
					Core.S.Net.notify(p, "msg.owner_left")
					task.delay(3, function()
						if p.Parent then
							Session.sendToOwnWorld(p)
						end
					end)
				end
			end
		else
			task.defer(broadcastInfo)
		end
	end)
	-- heartbeat so friends can find this world
	task.spawn(function()
		while true do
			if Session.mode == "world" and Session.owner and liveMap and isReservedServer then
				local code, psId = worldCode(Session.owner.UserId)
				if code then
					safe(function()
						liveMap:SetAsync(tostring(Session.owner.UserId), { code = code, ps = psId, t = os.time() }, 180)
					end)
				end
			end
			task.wait(60)
		end
	end)
end

return Session
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000085"><Properties><string name="Name">Staff</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Staff: hiring, training, salaries and the AI that automates the restaurant.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local StaffCfg = require(Shared.Config.Staff)
local Formulas = require(Shared.Logic.Formulas)
local Uid = require(Shared.Util.Uid)
local Core = require(script.Parent.Parent.Core)

local Staff = {}
local actors = {} -- [uid] = actor

local HOME = { Vector3.new(10, 0.5, 21), Vector3.new(-14, 0.5, 21), Vector3.new(4, 0.5, 23), Vector3.new(-2, 0.5, 21) }

local function data()
	return Core.S.Session.ownerData()
end

local function managerBonus()
	for _, a in pairs(actors) do
		if a.role == "staff_manager" then
			return GameConfig.ManagerSpeedBonus
		end
	end
	return 0
end

local function speed(a)
	return Formulas.staffSpeed(a.lvl, GameConfig.StaffSpeedPerLevel, managerBonus())
end

local function walk(a, pos)
	if not a.alive then
		return false
	end
	a.npc.humanoid.WalkSpeed = GameConfig.StaffWalkSpeed * speed(a)
	return Core.S.Npc.walkTo(a.npc, pos, { staff = true })
end

local function idleAt(a)
	local home = HOME[(a.index % #HOME) + 1]
	if a.npc.root and (a.npc.root.Position - home).Magnitude > 4 then
		walk(a, home)
	end
	task.wait(1)
end

local function dropHands(a)
	local Hands = Core.S.Hands
	local h = Hands.get(a)
	if h.kind == "box" then
		for _, b in ipairs(h.items) do
			Core.S.Supply.returnBox(b)
		end
	elseif h.kind == "dish" or h.kind == "dirty" then
		Core.S.Appliance.addDirtyToSink(#h.items)
	end
	Hands.clear(a)
end

local Tasks

local function customerEntity(c)
	return Core.S.Entities.get(c.uid)
end

------------------------------------------------------------------ jobs

local function doOrder(a)
	local c = Tasks.findOrder()
	if not c or not Tasks.claim(c, a) then
		return false
	end
	walk(a, Tasks.nearCustomer(c))
	local e = customerEntity(c)
	if e and c.state == "order" then
		Core.S.Customers.use(a, e)
	end
	Tasks.release(c, a)
	return true
end

local function deliverDish(a, recipeId)
	-- find a waiting customer for the dish in hand
	for _, c in ipairs(Core.S.Customers.list("waiting")) do
		if c.order == recipeId and Tasks.claim(c, a) then
			walk(a, Tasks.nearCustomer(c))
			local e = customerEntity(c)
			local ok = false
			if e and c.state == "waiting" then
				ok = Core.S.Customers.use(a, e)
			end
			Tasks.release(c, a)
			if ok then
				return true
			end
		end
	end
	return false
end

local function doServe(a)
	local station, c = Tasks.findServe()
	if not station then
		return false
	end
	local st = Core.S.Cooking.stationState(station)
	if not Tasks.claim(st, a) then
		return false
	end
	Tasks.claim(c, a)
	walk(a, Tasks.frontOf(station))
	local ok = Core.S.Cooking.use(a, station, speed(a))
	Tasks.release(st, a)
	Tasks.release(c, a)
	if not ok then
		return true
	end
	local h = Core.S.Hands.get(a)
	local recipe = h.items[1] and h.items[1].recipe
	if recipe and not deliverDish(a, recipe) then
		dropHands(a)
	end
	return true
end

local function nearestOf(kind, pos)
	local best, bestD = nil, math.huge
	for _, e in ipairs(Core.S.Entities.ofKind(kind)) do
		local p = Core.S.Entities.position(e)
		local dd = (p - pos).Magnitude
		if dd < bestD then
			best, bestD = e, dd
		end
	end
	return best
end

local function washHeld(a)
	local Appliance = Core.S.Appliance
	local pos = a.npc.root and a.npc.root.Position or Vector3.new()
	local washer = nearestOf("dishwasher", pos)
	if washer then
		walk(a, Tasks.frontOf(washer))
		Appliance.useDishwasher(a, washer)
		return
	end
	local hasDishwasherStaff = false
	for _, other in pairs(actors) do
		if other.role == "staff_dishwasher" and other ~= a then
			hasDishwasherStaff = true
		end
	end
	local sink = nearestOf("sink", pos)
	if not sink then
		return dropHands(a)
	end
	walk(a, Tasks.frontOf(sink))
	if hasDishwasherStaff and a.role ~= "staff_dishwasher" then
		local n = Core.S.Hands.count(a)
		Core.S.Hands.clear(a)
		Appliance.addDirtyToSink(n)
	else
		Appliance.useSink(a, sink, speed(a))
	end
end

local function doCollect(a)
	local e = Tasks.findDirty()
	if not e or not Tasks.claim(e, a) then
		return false
	end
	walk(a, Core.S.Entities.position(e))
	if Core.S.Entities.get(e.uid) then
		Core.S.Customers.collectDirty(a, e)
	end
	Tasks.release(e, a)
	-- grab more while there is room, then wash
	local Hands = Core.S.Hands
	while Hands.count(a) < Hands.capacity(a, "dirty") do
		local nxt = Tasks.findDirty()
		if not nxt or not Tasks.claim(nxt, a) then
			break
		end
		walk(a, Core.S.Entities.position(nxt))
		if Core.S.Entities.get(nxt.uid) then
			Core.S.Customers.collectDirty(a, nxt)
		end
		Tasks.release(nxt, a)
	end
	if Hands.get(a).kind == "dirty" then
		washHeld(a)
	end
	return true
end

local function doWash(a)
	local Appliance = Core.S.Appliance
	if Appliance.sinkPile() <= 0 or #Core.S.Entities.ofKind("dishwasher") > 0 then
		return false
	end
	local sink = nearestOf("sink", a.npc.root.Position)
	if not sink or not Tasks.claim(sink, a) then
		return false
	end
	walk(a, Tasks.frontOf(sink))
	Appliance.useSink(a, sink, speed(a))
	Tasks.release(sink, a)
	return true
end

local function carryBoxTo(a, box, targetEntity, useFn)
	local Supply = Core.S.Supply
	if not Tasks.claim(box, a) then
		return false
	end
	local _, boxEntity = Supply.findBox(box.g)
	local boxModel = boxEntity and boxEntity.model
	if boxModel then
		walk(a, boxModel:GetPivot().Position)
	end
	local ent = Core.S.Entities.get(box.u)
	if not ent or box.h then
		Tasks.release(box, a)
		return false
	end
	Supply.takeBox(a, ent)
	Tasks.release(box, a)
	walk(a, Tasks.frontOf(targetEntity))
	useFn()
	-- leftover portions go back to the storage room
	local h = Core.S.Hands.get(a)
	if h.kind == "box" then
		dropHands(a)
	end
	return true
end

local function doRestock(a)
	local box, g = Tasks.findRestock()
	if not box then
		return false
	end
	local Ingredients = require(Shared.Config.Ingredients)
	local ing = Ingredients.byId[g]
	-- target shelf: neta case for fish when available
	local target = nil
	for _, e in ipairs(Core.S.Entities.ofKind("shelf")) do
		if ing.storage == "fish" and e.item.fn.fishOnly then
			target = e
			break
		end
	end
	if not target then
		for _, e in ipairs(Core.S.Entities.ofKind("shelf")) do
			if not e.item.fn.fishOnly then
				target = e
				break
			end
		end
	end
	if not target then
		return false
	end
	return carryBoxTo(a, box, target, function()
		Core.S.Supply.useShelf(a, target, nil)
	end)
end

local function doRefill(a, kinds)
	local e, box = Tasks.findRefill(kinds)
	if not e or not Tasks.claim(e, a) then
		return false
	end
	local ok = carryBoxTo(a, box, e, function()
		Core.S.Appliance.load(a, e)
	end)
	Tasks.release(e, a)
	return ok
end

local function doCook(a)
	local t, recipe, station = Tasks.findCook(a.cfg.stations or {})
	if not t then
		return false
	end
	local st = Core.S.Cooking.stationState(station)
	if not Tasks.claim(st, a) then
		return false
	end
	t.claimed = a
	local Supply = Core.S.Supply
	local ok = true
	for _, g in ipairs(recipe.ing) do
		local shelf, slot = Supply.findShelfWith(g, a.npc.root.Position)
		if not shelf then
			ok = false
			break
		end
		walk(a, Tasks.frontOf(shelf))
		local took = Supply.useShelf(a, shelf, slot)
		if not took then
			ok = false
			break
		end
	end
	if ok then
		walk(a, Tasks.frontOf(station))
		Core.S.Cooking.use(a, station, speed(a))
		local guard = 0
		while not Core.S.Cooking.stationState(station).ready and guard < 8 do
			guard += 1
			local stepOk = Core.S.Cooking.use(a, station, speed(a))
			if not stepOk then
				break
			end
		end
	end
	-- put back anything left in hand
	if Core.S.Hands.get(a).kind == "ing" then
		Core.S.Hands.clear(a)
	end
	Tasks.release(st, a)
	local readyNow = Core.S.Cooking.stationState(station).ready
	if not readyNow then
		t.claimed = nil
		return ok
	end
	-- serve it ourselves when there are no waiters
	local hasWaiter = false
	for _, other in pairs(actors) do
		if other.role == "staff_waiter" then
			hasWaiter = true
		end
	end
	if not hasWaiter then
		Core.S.Cooking.use(a, station, speed(a))
		local h = Core.S.Hands.get(a)
		if h.kind == "dish" then
			if not deliverDish(a, h.items[1].recipe) then
				dropHands(a)
			end
		end
	end
	return true
end

local JOBS = {
	order = doOrder,
	serve = doServe,
	collect = doCollect,
	wash = doWash,
	restock = doRestock,
	cook = doCook,
}

local function think(a)
	local priorities = {
		staff_waiter = { "serve", "order", "collect", "wash" },
		staff_dishwasher = { "wash", "collect" },
		staff_stocker = { "appliance", "restock" },
		staff_sushi_chef = { "cook", "appliance_rice" },
		staff_ramen_chef = { "cook", "appliance_pot" },
		staff_line_cook = { "cook" },
		staff_manager = {},
	}
	for _, job in ipairs(priorities[a.role] or {}) do
		local done = false
		if job == "appliance" then
			done = doRefill(a, { "ricecooker", "pot" })
		elseif job == "appliance_rice" then
			done = doRefill(a, { "ricecooker" })
		elseif job == "appliance_pot" then
			done = doRefill(a, { "pot" })
		elseif JOBS[job] then
			done = JOBS[job](a)
		end
		if done then
			return true
		end
	end
	return false
end

------------------------------------------------------------------ actors

local function spawnActor(record, index)
	local cfg = StaffCfg.byId[record.role]
	if not cfg then
		return
	end
	local hat = (record.role == "staff_sushi_chef" or record.role == "staff_ramen_chef") and "chef" or (record.role == "staff_manager" and "cap" or "hachimaki")
	local npc = Core.S.Npc.create({ look = "casual", shirt = cfg.shirt, staff = record.role, hat = hat, apron = record.role == "staff_manager" and "#14141A" or "#2E3A5C", speed = GameConfig.StaffWalkSpeed })
	if not npc then
		return
	end
	npc.isStaff = true
	local a = { uid = record.u, role = record.role, cfg = cfg, lvl = record.lvl or 1, name = record.name, npc = npc, model = npc.model, alive = true, index = index, record = record }
	actors[record.u] = a
	npc.model:SetAttribute("StaffName", record.name)
	npc.model:SetAttribute("StaffRole", record.role)
	npc.model:SetAttribute("StaffLevel", a.lvl)
	Core.S.Npc.spawn(npc, CFrame.new(HOME[(index % #HOME) + 1] + Vector3.new(0, 3, 0)))
	task.spawn(function()
		while a.alive do
			local phase = Core.S.Day.phase
			local ok, did = pcall(function()
				if phase == "open" or phase == "closing" or a.role == "staff_stocker" or a.role == "staff_dishwasher" then
					return think(a)
				end
				return false
			end)
			if not ok then
				warn("[Staff] " .. tostring(did))
				pcall(dropHands, a)
				task.wait(2)
			elseif not did then
				idleAt(a)
			else
				task.wait(0.2)
			end
		end
	end)
	return a
end

local function despawnActor(uid)
	local a = actors[uid]
	if not a then
		return
	end
	a.alive = false
	pcall(dropHands, a)
	Core.S.Hands.forget(a)
	Core.S.Npc.destroy(a.npc)
	actors[uid] = nil
end

function Staff.spawnAll(d)
	for uid in pairs(actors) do
		despawnActor(uid)
	end
	for i, rec in ipairs(d.staff) do
		spawnActor(rec, i)
	end
end

local function hire(player, role)
	local Session, Net, Economy = Core.S.Session, Core.S.Net, Core.S.Economy
	if not Session.canBuild(player) then
		return Net.notify(player, "msg.no_permission", nil, "error")
	end
	local d = data()
	local cfg = StaffCfg.byId[role]
	if not d or not cfg then
		return
	end
	if d.level < cfg.lv then
		return Net.notify(player, "msg.need_level", { level = cfg.lv }, "error")
	end
	if #d.staff >= Core.S.Progression.staffSlots(d) then
		return Net.notify(player, "msg.staff_full", nil, "error")
	end
	if cfg.manager then
		for _, s in ipairs(d.staff) do
			if s.role == role then
				return Net.notify(player, "msg.staff_one_manager", nil, "error")
			end
		end
	end
	if not Economy.spend(Session.owner, cfg.hire, "build") then
		return Net.notify(player, "msg.not_enough", nil, "error")
	end
	local rec = { u = Uid.new("s"), role = role, lvl = 1, name = StaffCfg.Names[math.random(1, #StaffCfg.Names)] }
	table.insert(d.staff, rec)
	spawnActor(rec, #d.staff)
	Core.S.Data.changed(Session.owner, "staff")
	Net.notifyAll("msg.staff_hired", { name = rec.name, role = "staff." .. role }, "success")
	Core.S.Meta.event(Session.owner, "staff", 1)
end

local function train(player, uid)
	local Session, Net, Economy = Core.S.Session, Core.S.Net, Core.S.Economy
	if not Session.canBuild(player) then
		return
	end
	local d = data()
	for _, rec in ipairs(d.staff) do
		if rec.u == uid then
			if rec.lvl >= StaffCfg.MaxTrainLevel then
				return Net.notify(player, "msg.max_level", nil, "error")
			end
			local cfg = StaffCfg.byId[rec.role]
			local cost = Formulas.staffTrainCost(cfg.hire, rec.lvl + 1)
			if not Economy.spend(Session.owner, cost, "build") then
				return Net.notify(player, "msg.not_enough", nil, "error")
			end
			rec.lvl += 1
			local a = actors[uid]
			if a then
				a.lvl = rec.lvl
				a.model:SetAttribute("StaffLevel", rec.lvl)
			end
			Core.S.Data.changed(Session.owner, "staff")
			return Net.notify(player, "msg.staff_trained", { name = rec.name, level = rec.lvl }, "success")
		end
	end
end

local function fire(player, uid)
	local Session = Core.S.Session
	if not Session.canBuild(player) then
		return
	end
	local d = data()
	for i, rec in ipairs(d.staff) do
		if rec.u == uid then
			table.remove(d.staff, i)
			despawnActor(uid)
			Core.S.Data.changed(Session.owner, "staff")
			return
		end
	end
end

function Staff.Init()
	Tasks = Core.S.Tasks
	local Net = Core.S.Net
	Net.on("HireStaff", function(player, role)
		if type(role) == "string" then
			hire(player, role)
		end
	end, 2)
	Net.on("TrainStaff", function(player, uid)
		if type(uid) == "string" then
			train(player, uid)
		end
	end, 3)
	Net.on("FireStaff", function(player, uid)
		if type(uid) == "string" then
			fire(player, uid)
		end
	end, 3)
end

function Staff.Start()
	Core.S.Session.OwnerReady:Connect(function(_, d)
		task.delay(2, function()
			Staff.spawnAll(d)
		end)
	end)
end

return Staff
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000086"><Properties><string name="Name">Supply</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Supplier orders, the delivery truck, boxes in the storage room and shelf slots.
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Ingredients = require(Shared.Config.Ingredients)
local Recipes = require(Shared.Config.Recipes)
local Upgrades = require(Shared.Config.Upgrades)
local Items = require(Shared.Config.Items)
local Expansions = require(Shared.Config.Expansions)
local Footprint = require(Shared.Logic.Footprint)
local Registry = require(Shared.Models.Registry)
local Uid = require(Shared.Util.Uid)
local Core = require(script.Parent.Parent.Core)

local Supply = {}
local boxModels = {} -- [boxUid] = entity
local slotVisuals = {} -- [shelfUid .. "#" .. slot] = Model
local pending = {} -- deliveries { t, boxes }
local truckBusy = false

local function data()
	return Core.S.Session.ownerData()
end

local function ingUnlocked(d, ing)
	if d.licenses[ing.license] then
		return true
	end
	-- regional dishes may use ingredients from licenses not owned yet
	for _, r in ipairs(Recipes.list) do
		if r.city and r.city == d.franchise.city and table.find(r.ing, ing.id) then
			return true
		end
	end
	return false
end

function Supply.shelfCap(entity)
	local d = data()
	local mult = d and Upgrades.value(d.upgrades, "up_shelf") or 1
	return math.floor(entity.item.fn.cap * mult)
end

------------------------------------------------------------------ storage layout

local function rackSlots()
	local slots = {}
	local racks = Core.S.Entities.ofKind("rack")
	table.sort(racks, function(a, b)
		return a.uid < b.uid
	end)
	for _, r in ipairs(racks) do
		local root = r.model.PrimaryPart
		local i = 1
		while root and root:FindFirstChild("Box" .. i) do
			table.insert(slots, root["Box" .. i].WorldCFrame * CFrame.new(0, 0.65, 0))
			i += 1
		end
	end
	return slots
end

local function overflowSlots()
	local d = data()
	local slots = {}
	local World = Core.S.World
	local blocked = {}
	for _, e in ipairs(d.placed) do
		if e.s == "f" then
			local item = Items.byId[e.i]
			table.insert(blocked, Footprint.inflate(Footprint.new(e.x, e.z, item.size[1], item.size[3], e.r), 0.6))
		end
	end
	for _, fx in ipairs(World.fixedRects()) do
		table.insert(blocked, Footprint.rectToFp(fx.rect))
	end
	for _, z in ipairs(World.zones) do
		if z.area == "storage" then
			local r = z.rect
			for x = r[1] + 1.6, r[3] - 1.6, 2.2 do
				for zz = r[2] + 1.6, r[4] - 1.6, 1.9 do
					local fp = Footprint.new(x, zz, 1.8, 1.5, 0)
					local free = true
					for _, b in ipairs(blocked) do
						if Footprint.overlaps(fp, b) then
							free = false
							break
						end
					end
					if free then
						for level = 0, 1 do
							table.insert(slots, CFrame.new(x, 0.65 + level * 1.32, zz))
						end
					end
				end
			end
		end
	end
	return slots
end

function Supply.capacity()
	return #rackSlots() + math.min(#overflowSlots(), GameConfig.DeliveryOverflowBoxes)
end

local function boxModel(entry)
	local m = Registry.food("box", entry.g, entry.n)
	return m
end

function Supply.layout()
	local d = data()
	if not d then
		return
	end
	local slots = rackSlots()
	for _, s in ipairs(overflowSlots()) do
		table.insert(slots, s)
	end
	local idx = 0
	local keep = {}
	for _, entry in ipairs(d.storage) do
		if not entry.h then
			idx += 1
			local cf = slots[idx] or CFrame.new(24, 0.65 + idx * 0.05, 20)
			local e = boxModels[entry.u]
			if not e then
				local m = boxModel(entry)
				m.Parent = Core.S.World.folders().dynamic
				e = Core.S.Entities.register(entry.u, "box", m, { box = entry })
				boxModels[entry.u] = e
			end
			e.model:PivotTo(cf)
			keep[entry.u] = true
		end
	end
	for uid, e in pairs(boxModels) do
		if not keep[uid] then
			Core.S.Entities.unregister(uid)
			if e.model then
				e.model:Destroy()
			end
			boxModels[uid] = nil
		end
	end
end

local function updateBoxLabel(entry)
	local e = boxModels[entry.u]
	if e and e.model then
		local label = e.model:FindFirstChild("Count", true)
		local ing = Ingredients.byId[entry.g]
		if label then
			label.Text = (ing and ing.icon or "📦") .. " " .. entry.n
		end
	end
end

function Supply.returnBox(entry)
	local d = data()
	if not d then
		return
	end
	entry.h = nil
	if entry.n <= 0 then
		for i, b in ipairs(d.storage) do
			if b.u == entry.u then
				table.remove(d.storage, i)
				break
			end
		end
	end
	Supply.layout()
	Core.S.Data.changed(Core.S.Session.owner, "storage")
end

function Supply.removeBox(entry)
	local d = data()
	for i, b in ipairs(d.storage) do
		if b.u == entry.u then
			table.remove(d.storage, i)
			break
		end
	end
	Supply.layout()
	Core.S.Data.changed(Core.S.Session.owner, "storage")
end

function Supply.takeBox(actor, e)
	local Hands = Core.S.Hands
	if not Hands.isEmpty(actor) then
		return false, "msg.hands_full"
	end
	local entry = e.box
	entry.h = true
	Hands.set(actor, "box", { entry })
	Supply.layout()
	return true
end

function Supply.findBox(g)
	local d = data()
	for _, entry in ipairs(d.storage) do
		if entry.g == g and not entry.h and entry.n > 0 then
			return entry, boxModels[entry.u]
		end
	end
	return nil
end

function Supply.boxCount(g)
	local d = data()
	local n, portions = 0, 0
	for _, entry in ipairs(d.storage) do
		if entry.g == g then
			n += 1
			portions += entry.n
		end
	end
	return n, portions
end

------------------------------------------------------------------ shelves

local function shelfState(uid)
	local d = data()
	d.shelves[uid] = d.shelves[uid] or {}
	return d.shelves[uid]
end

function Supply.refreshShelf(e)
	if not e or not e.model then
		return
	end
	local st = shelfState(e.uid)
	local cap = Supply.shelfCap(e)
	for slot = 1, e.item.fn.slots do
		local part = e.model:FindFirstChild("Slot" .. slot)
		local key = e.uid .. "#" .. slot
		if slotVisuals[key] then
			slotVisuals[key]:Destroy()
			slotVisuals[key] = nil
		end
		local s = st[tostring(slot)]
		if part then
			part:SetAttribute("G", s and s.g or "")
			part:SetAttribute("N", s and s.n or 0)
			part:SetAttribute("Cap", cap)
		end
		if s and s.n > 0 and part then
			local holder = Instance.new("Model")
			holder.Name = "SlotItems"
			local width = part:GetAttribute("Width") or 3
			local shown = math.min(5, math.max(1, math.ceil(s.n / math.max(1, cap) * 5)))
			for k = 1, shown do
				local m = Registry.food("ingredient", s.g)
				local x = -width / 2 + width * (k - 0.5) / shown
				m:PivotTo(part.CFrame * CFrame.new(x, -part.Size.Y / 2 + 0.32, 0))
				for _, dsc in ipairs(m:GetDescendants()) do
					if dsc:IsA("BasePart") then
						dsc.CanQuery = false
					end
				end
				m.Parent = holder
			end
			holder.Parent = e.model
			slotVisuals[key] = holder
		end
	end
end

function Supply.shelfStock(g)
	local total = 0
	for _, e in ipairs(Core.S.Entities.ofKind("shelf")) do
		for _, s in pairs(shelfState(e.uid)) do
			if s.g == g then
				total += s.n
			end
		end
	end
	return total
end

-- Nearest shelf slot holding ingredient g (for staff)
function Supply.findShelfWith(g, pos)
	local best, bestSlot, bestD = nil, nil, math.huge
	for _, e in ipairs(Core.S.Entities.ofKind("shelf")) do
		for slot, s in pairs(shelfState(e.uid)) do
			if s.g == g and s.n > 0 then
				local p = e.model.PrimaryPart.Position
				local dist = pos and (p - pos).Magnitude or 0
				if dist < bestD then
					best, bestSlot, bestD = e, tonumber(slot), dist
				end
			end
		end
	end
	return best, bestSlot
end

local function chooseSlot(e, g, requested)
	local st = shelfState(e.uid)
	local cap = Supply.shelfCap(e)
	local slots = e.item.fn.slots
	if requested and requested >= 1 and requested <= slots then
		local s = st[tostring(requested)]
		if not s or s.n == 0 or (s.g == g and s.n < cap) then
			return requested
		end
	end
	for slot = 1, slots do
		local s = st[tostring(slot)]
		if s and s.g == g and s.n > 0 and s.n < cap then
			return slot
		end
	end
	for slot = 1, slots do
		local s = st[tostring(slot)]
		if not s or s.n == 0 then
			return slot
		end
	end
	return nil
end

-- Shelf interaction for players and staff
function Supply.useShelf(actor, e, slot)
	local Hands = Core.S.Hands
	local hands = Hands.get(actor)
	local st = shelfState(e.uid)
	if hands.kind == "box" then
		local entry = hands.items[1]
		local ing = Ingredients.byId[entry.g]
		if ing.storage == "rice" or ing.storage == "broth" then
			return false, "msg.use_appliance"
		end
		if e.item.fn.fishOnly and ing.storage ~= "fish" then
			return false, "msg.fish_only"
		end
		local target = chooseSlot(e, entry.g, slot)
		if not target then
			return false, "msg.shelf_full"
		end
		local cap = Supply.shelfCap(e)
		local s = st[tostring(target)]
		if not s or s.n == 0 then
			s = { g = entry.g, n = 0 }
			st[tostring(target)] = s
		end
		local amount = math.min(entry.n, cap - s.n)
		s.n += amount
		entry.n -= amount
		if entry.n <= 0 then
			Supply.removeBox(entry)
			Hands.clear(actor)
		else
			Hands.refresh(actor)
		end
		Supply.refreshShelf(e)
		Core.S.Data.changed(Core.S.Session.owner, "shelves")
		Core.S.Meta.event(Core.S.Session.owner, "restock", 1)
		Core.S.Net.fx("sfx", { name = "place", pos = e.model.PrimaryPart.Position })
		return true
	elseif hands.kind == nil or hands.kind == "ing" then
		local s = slot and st[tostring(slot)]
		if not s or s.n <= 0 then
			-- clicked an empty slot: take from any slot of this shelf
			for k = 1, e.item.fn.slots do
				if st[tostring(k)] and st[tostring(k)].n > 0 then
					slot, s = k, st[tostring(k)]
					break
				end
			end
		end
		if not s or s.n <= 0 then
			return false, "msg.shelf_empty"
		end
		local ok, reason = Hands.add(actor, "ing", { g = s.g, fresh = e.item.fn.fresh == true })
		if not ok then
			return false, reason
		end
		s.n -= 1
		if s.n <= 0 then
			st[tostring(slot)] = nil
		end
		Supply.refreshShelf(e)
		Core.S.Data.changed(Core.S.Session.owner, "shelves")
		return true
	end
	return false, "msg.hands_busy"
end

------------------------------------------------------------------ orders & delivery

local function deliveryTime()
	local d = data()
	if Core.S.Monetization.ownerHas("gp_express") then
		return 1
	end
	return Upgrades.value(d.upgrades, "up_delivery")
end

function Supply.order(player, cart)
	local Session, Net = Core.S.Session, Core.S.Net
	if not Session.canBuild(player) then
		return Net.notify(player, "msg.no_permission", nil, "error")
	end
	local d = data()
	if type(cart) ~= "table" then
		return
	end
	local discount = Upgrades.value(d.upgrades, "up_supplier")
	local total, boxes = 0, {}
	for g, q in pairs(cart) do
		local ing = Ingredients.byId[g]
		if ing and type(q) == "table" and ingUnlocked(d, ing) then
			local small = math.clamp(math.floor(tonumber(q.small) or 0), 0, 30)
			local big = (discount > 0) and math.clamp(math.floor(tonumber(q.big) or 0), 0, 30) or 0
			total += small * ing.price
			total += math.floor(big * ing.price * GameConfig.BigBoxMultiplier * (1 - discount) + 0.5)
			for _ = 1, small do
				table.insert(boxes, { u = Uid.new("b"), g = g, n = ing.units })
			end
			for _ = 1, big do
				table.insert(boxes, { u = Uid.new("b"), g = g, n = ing.units * GameConfig.BigBoxMultiplier })
			end
		end
	end
	if #boxes == 0 then
		return
	end
	local queued = 0
	for _, p in ipairs(pending) do
		queued += #p.boxes
	end
	if #d.storage + queued + #boxes > Supply.capacity() then
		return Net.notify(player, "msg.storage_full", { n = Supply.capacity() }, "error")
	end
	if not Core.S.Economy.spend(Session.owner, total, "supplies") then
		return Net.notify(player, "msg.not_enough", nil, "error")
	end
	table.insert(pending, { t = os.clock() + deliveryTime(), boxes = boxes })
	Net.notifyAll("msg.order_placed", { n = #boxes, seconds = math.floor(deliveryTime()) }, "success")
	return true
end

local function animateTruck(onArrive)
	local folders = Core.S.World.folders()
	local truck = Registry.Street.truck()
	truck.Parent = folders.dynamic
	local bay = Expansions.LoadingBay
	local startCf = CFrame.new(160, 2.1, -18) * CFrame.Angles(0, 0, 0)
	local roadCf = CFrame.new(bay.x + 2, 2.1, -18)
	local bayCf = CFrame.new(bay.x, 2.1, bay.z) * CFrame.Angles(0, math.rad(90), 0)
	local value = Instance.new("CFrameValue")
	value.Value = startCf
	value.Changed:Connect(function(cf)
		if truck.Parent then
			truck:PivotTo(cf)
		end
	end)
	truck:PivotTo(startCf)
	local t1 = TweenService:Create(value, TweenInfo.new(4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = roadCf })
	t1:Play()
	t1.Completed:Wait()
	local t2 = TweenService:Create(value, TweenInfo.new(1.6, Enum.EasingStyle.Sine), { Value = bayCf })
	t2:Play()
	t2.Completed:Wait()
	Core.S.Net.fx("sfx", { name = "bell", pos = bayCf.Position })
	task.wait(1)
	onArrive()
	task.wait(1.5)
	local t3 = TweenService:Create(value, TweenInfo.new(1.6, Enum.EasingStyle.Sine), { Value = CFrame.new(bay.x - 4, 2.1, -18) })
	t3:Play()
	t3.Completed:Wait()
	local t4 = TweenService:Create(value, TweenInfo.new(4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Value = CFrame.new(-170, 2.1, -18) })
	t4:Play()
	t4.Completed:Wait()
	truck:Destroy()
	value:Destroy()
end

local function deliveryLoop()
	while true do
		task.wait(0.5)
		if not truckBusy and #pending > 0 and pending[1].t <= os.clock() then
			local batch = {}
			while #pending > 0 and pending[1].t <= os.clock() + 2 do
				local p = table.remove(pending, 1)
				for _, b in ipairs(p.boxes) do
					table.insert(batch, b)
				end
			end
			truckBusy = true
			task.spawn(function()
				local ok, err = pcall(animateTruck, function()
					local d = data()
					if d then
						for _, b in ipairs(batch) do
							table.insert(d.storage, b)
						end
						Supply.layout()
						Core.S.Data.changed(Core.S.Session.owner, "storage")
						Core.S.Net.notifyAll("msg.delivery_arrived", { n = #batch }, "success")
					end
				end)
				if not ok then
					warn("[Supply] truck: " .. tostring(err))
					local d = data()
					if d then
						for _, b in ipairs(batch) do
							table.insert(d.storage, b)
						end
						Supply.layout()
					end
				end
				truckBusy = false
			end)
		end
	end
end

-- Auto restock (upgrade + stocker): keeps at least one box of each menu ingredient
local function autoRestock()
	while true do
		task.wait(GameConfig.AutoRestockCheck)
		local d = data()
		if d and (d.upgrades.up_autorestock or 0) > 0 then
			local hasStocker = false
			for _, s in ipairs(d.staff) do
				if s.role == "staff_stocker" then
					hasStocker = true
				end
			end
			if hasStocker then
				local needed = {}
				for _, r in ipairs(Core.S.Progression.menuRecipes(d)) do
					for _, g in ipairs(r.ing) do
						needed[g] = true
					end
					if r.rice then
						needed.rice = true
					end
					if r.broth then
						needed[r.broth] = true
					end
				end
				local cart = {}
				for g in pairs(needed) do
					local ing = Ingredients.byId[g]
					local boxes = Supply.boxCount(g)
					if ing and boxes == 0 and Supply.shelfStock(g) < ing.units then
						cart[g] = { small = 2 }
					end
				end
				if next(cart) then
					Supply.order(Core.S.Session.owner, cart)
				end
			end
		end
	end
end

function Supply.Init()
	local Net = Core.S.Net
	Net.on("OrderSupplies", function(player, cart)
		Supply.order(player, cart)
	end, 2)
	Net.on("BuyDishes", function(player, count)
		local Session = Core.S.Session
		if not Session.canBuild(player) then
			return
		end
		local d = data()
		local n = math.clamp(math.floor(tonumber(count) or 1), 1, 10)
		local cost = n * GameConfig.DishSetPrice
		if Core.S.Economy.spend(Session.owner, cost, "supplies") then
			d.dishes.total += n * GameConfig.DishSetSize
			d.dishes.clean += n * GameConfig.DishSetSize
			Core.S.Data.changed(Session.owner, "dishes")
			Net.notify(player, "msg.dishes_bought", { n = n * GameConfig.DishSetSize }, "success")
		else
			Net.notify(player, "msg.not_enough", nil, "error")
		end
	end, 3)
	local Placement = Core.S.Placement
	Placement.ItemAdded:Connect(function(e)
		if e.kind == "shelf" then
			Supply.refreshShelf(e)
		elseif e.kind == "rack" then
			task.defer(Supply.layout)
		end
	end)
	Placement.ItemMoved:Connect(function(e)
		if e.kind == "shelf" then
			Supply.refreshShelf(e)
		elseif e.kind == "rack" then
			task.defer(Supply.layout)
		end
	end)
	Placement.ItemRemoved:Connect(function(e)
		if e.kind == "rack" then
			task.defer(Supply.layout)
		end
	end)
	Placement.addVeto(function(e)
		if e.kind == "shelf" then
			for _, s in pairs(shelfState(e.uid)) do
				if s.n > 0 then
					return false, "msg.empty_first"
				end
			end
		end
		return true
	end)
	Placement.LayoutChanged:Connect(function()
		task.defer(Supply.layout)
	end)
end

function Supply.Start()
	Core.S.Session.OwnerReady:Connect(function(_, d)
		for _, b in ipairs(d.storage) do
			b.h = nil
		end
		task.delay(0.5, Supply.layout)
	end)
	task.spawn(deliveryLoop)
	task.spawn(autoRestock)
	local _ = updateBoxLabel
end

Supply.updateBoxLabel = updateBoxLabel
return Supply
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000087"><Properties><string name="Name">Tasks</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Task board helpers for staff: finds work, claims targets so two workers never do the same job.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Recipes = require(Shared.Config.Recipes)
local Ingredients = require(Shared.Config.Ingredients)
local Core = require(script.Parent.Parent.Core)

local Tasks = {}

-- Point in front of an entity (local -Z side) at floor level
function Tasks.frontOf(e, dist)
	local root = e.model and e.model.PrimaryPart
	if not root then
		return Core.S.Entities.position(e)
	end
	local cook = root:FindFirstChild("Cook")
	if cook then
		return cook.WorldPosition + Vector3.new(0, 0.5, 0)
	end
	local cf = root.CFrame * CFrame.new(0, -root.Size.Y / 2 + 0.5, -(root.Size.Z / 2 + (dist or 1.6)))
	return cf.Position
end

function Tasks.nearCustomer(c)
	if not c.seat then
		return c.npc and c.npc.root and c.npc.root.Position or Vector3.new()
	end
	local sit = c.seat.sit
	local p = sit.Position - sit.LookVector * 2.2
	return Vector3.new(p.X, Core.S.World.floorY(c.seat.floor) + 0.5, p.Z)
end

-- claims live outside the objects (box entries are saved to the DataStore)
local claims = setmetatable({}, { __mode = "k" })

local function claimed(obj)
	local a = claims[obj]
	return a ~= nil and a.alive ~= false
end

function Tasks.claim(obj, actor)
	if claimed(obj) then
		return claims[obj] == actor
	end
	claims[obj] = actor
	return true
end

function Tasks.release(obj, actor)
	if obj and claims[obj] == actor then
		claims[obj] = nil
	end
end

function Tasks.claimedBy(obj)
	return claims[obj]
end

-- Waiter: a ready dish that matches a waiting customer
function Tasks.findServe()
	local Customers = Core.S.Customers
	for _, rd in ipairs(Core.S.Cooking.readyDishes()) do
		local st = Core.S.Cooking.stationState(rd.entity)
		if not claimed(st) then
			for _, c in ipairs(Customers.list("waiting")) do
				if c.order == rd.recipe and not claimed(c) then
					return rd.entity, c
				end
			end
		end
	end
	return nil
end

function Tasks.findOrder()
	for _, c in ipairs(Core.S.Customers.list("order")) do
		if not claimed(c) then
			return c
		end
	end
	return nil
end

function Tasks.findDirty()
	for _, e in ipairs(Core.S.Entities.ofKind("dirty")) do
		if not claimed(e) then
			return e
		end
	end
	return nil
end

-- Chef: a ticket for one of the chef's stations whose ingredients are on the shelves
function Tasks.findCook(stations)
	local Supply, Appliance = Core.S.Supply, Core.S.Appliance
	for _, t in ipairs(Core.S.Cooking.tickets) do
		local r = Recipes.byId[t.recipe]
		if r and not t.claimed and table.find(stations, r.station) then
			local ok = true
			local need = {}
			for _, g in ipairs(r.ing) do
				need[g] = (need[g] or 0) + 1
			end
			for g, n in pairs(need) do
				if Supply.shelfStock(g) < n then
					ok = false
				end
			end
			if ok and r.rice and not Appliance.hasRice() then
				ok = false
			end
			if ok and r.broth and not Appliance.hasBroth(r.broth) then
				ok = false
			end
			if ok then
				-- a free station of the right type
				for _, e in ipairs(Core.S.Entities.ofKind("station")) do
					if e.item.fn.station == r.station then
						local st = Core.S.Cooking.stationState(e)
						if not st.busy and #st.board == 0 and not st.ready and not claimed(st) then
							return t, r, e
						end
					end
				end
			end
		end
	end
	return nil
end

-- Stocker: ingredient running low on shelves with a box available
function Tasks.findRestock()
	local d = Core.S.Session.ownerData()
	local Supply = Core.S.Supply
	local wanted = {}
	for _, r in ipairs(Core.S.Progression.menuRecipes(d)) do
		for _, g in ipairs(r.ing) do
			wanted[g] = true
		end
	end
	for g in pairs(wanted) do
		local ing = Ingredients.byId[g]
		if ing and (ing.storage == "shelf" or ing.storage == "fish") and Supply.shelfStock(g) < 6 then
			local box = Supply.findBox(g)
			if box and not claimed(box) then
				return box, g
			end
		end
	end
	return nil
end

-- Stocker / ramen chef: a rice cooker or pot that needs refilling (and a box to do it)
function Tasks.findRefill(kinds)
	local d = Core.S.Session.ownerData()
	local Supply = Core.S.Supply
	local broths = {}
	for _, r in ipairs(Core.S.Progression.menuRecipes(d)) do
		if r.broth then
			broths[r.broth] = (broths[r.broth] or 0) + 1
		end
	end
	for _, need in ipairs(Core.S.Appliance.needsRefill()) do
		local e = need.entity
		if table.find(kinds, e.kind) and not claimed(e) then
			if e.kind == "ricecooker" then
				local box = Supply.findBox("rice")
				if box and not claimed(box) then
					return e, box
				end
			else
				local g = need.g
				if not g then
					-- empty pot: pick the broth most used by the menu that no other pot is making
					local best, bestN = nil, 0
					for b, n in pairs(broths) do
						if n > bestN and not Core.S.Appliance.willHave("pot", b) then
							best, bestN = b, n
						end
					end
					g = best
				end
				local box = g and Supply.findBox(g)
				if box and not claimed(box) then
					return e, box
				end
			end
		end
	end
	return nil
end

return Tasks
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000088"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Builds the street and the restaurant shell from the unlocked zones; exposes the geometry
-- (zones, walls, stairs, openings) used by placement, seating and NPC services.
local CollectionService = game:GetService("CollectionService")
local PhysicsService = game:GetService("PhysicsService")
local Lighting = game:GetService("Lighting")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Expansions = require(Shared.Config.Expansions)
local Surfaces = require(Shared.Config.Surfaces)
local Franchise = require(Shared.Config.Franchise)
local Items = require(Shared.Config.Items)
local Geometry = require(Shared.Logic.Geometry)
local Footprint = require(Shared.Logic.Footprint)
local Registry = require(Shared.Models.Registry)
local Scene = require(Shared.Models.Scene)
local Kit = require(Shared.Models.Kit)
local P = require(Shared.Models.Palette)
local Color = require(Shared.Util.Color)
local Signal = require(Shared.Util.Signal)
local Core = require(script.Parent.Parent.Core)

local World = {}
World.Rebuilt = Signal.new()
World.zones = {}
World.openings = {}
World.stairs = {}
World.walls = {}
World.expansions = {}
World.city = "tokyo"

local root, shell, street, itemsFolder, dynamicFolder, npcFolder
local streetBuilt = false

local function folder(name, parent)
	local f = parent:FindFirstChild(name)
	if not f then
		f = Instance.new("Folder")
		f.Name = name
		f.Parent = parent
	end
	return f
end

function World.floorY(f)
	return (f or 0) * GameConfig.FloorHeight
end

function World.folders()
	return { root = root, shell = shell, items = itemsFolder, dynamic = dynamicFolder, npcs = npcFolder, street = street }
end

-- Recomputes the unlocked geometry from the owner's data
function World.recompute(data)
	local geo = Geometry.compute(Expansions.list, data.zones, Expansions.Supplier)
	World.zones, World.openings, World.stairs, World.expansions = geo.zones, geo.openings, geo.stairs, geo.expansions
	World.walls = geo.walls
	World.fixed = geo.fixed
end

function World.zoneAt(x, z, f)
	for _, zone in ipairs(World.zones) do
		if zone.floor == (f or 0) and Footprint.pointInRect(x, z, zone.rect) then
			return zone
		end
	end
	return nil
end

function World.hasExpansion(id)
	for _, e in ipairs(World.expansions) do
		if e.id == id then
			return true
		end
	end
	return false
end

-- Door clearances that must stay free of objects
function World.fixedRects()
	return World.fixed or {}
end

-- Placement validation context (see Shared.Logic.Placement)
function World.ctx(placed)
	return Geometry.ctx({ zones = World.zones, walls = World.walls, stairs = World.stairs, fixed = World.fixed }, Items.byId, placed, GameConfig)
end

function World.surfaceOf(data, zone, kind)
	return Scene.surfaceOf(data, zone, kind)
end

local function geo()
	return { zones = World.zones, openings = World.openings, stairs = World.stairs, walls = World.walls, fixed = World.fixed }
end

local function buildShell(data)
	local result = Scene.shell(shell, geo(), data)
	World.openLabel = result.openLabel
end

local function buildStreet(cityId)
	local result = Scene.street(street, cityId)
	Lighting:SetAttribute("City", cityId)
	Lighting:SetAttribute("Sky", result.sky)
	streetBuilt = true
end

function World.rebuild(data)
	World.recompute(data)
	if not streetBuilt or World.city ~= (data.franchise.city or "tokyo") then
		World.city = data.franchise.city or "tokyo"
		buildStreet(World.city)
	end
	buildShell(data)
	workspace:SetAttribute("WorldReady", true)
	World.Rebuilt:Fire()
end

function World.setOpenSign(open)
	if World.openLabel then
		World.openLabel.Text = open and "営業中" or "準備中"
	end
end

function World.Init()
	Registry.load()
	root = folder("Restaurant", workspace)
	shell = folder("Shell", root)
	street = folder("Street", workspace)
	itemsFolder = folder("Items", root)
	dynamicFolder = folder("Dynamic", root)
	npcFolder = folder("NPCs", workspace)
	pcall(function()
		PhysicsService:RegisterCollisionGroup("Shell")
		PhysicsService:RegisterCollisionGroup("NPC")
		PhysicsService:RegisterCollisionGroup("Player")
		PhysicsService:CollisionGroupSetCollidable("NPC", "NPC", false)
		PhysicsService:CollisionGroupSetCollidable("NPC", "Player", false)
		PhysicsService:CollisionGroupSetCollidable("Player", "Player", false)
	end)
	-- default world until the owner's data arrives
	local Data = Core.S.Data
	World.recompute(Data.newProfile())
end

function World.Start()
	local Session = Core.S.Session
	Session.OwnerReady:Connect(function(_, data)
		World.rebuild(data)
	end)
	local players = game:GetService("Players")
	local function setGroup(character)
		for _, d in ipairs(character:GetDescendants()) do
			if d:IsA("BasePart") then
				d.CollisionGroup = "Player"
			end
		end
		character.DescendantAdded:Connect(function(d)
			if d:IsA("BasePart") then
				d.CollisionGroup = "Player"
			end
		end)
	end
	local function onPlayer(p)
		p.CharacterAdded:Connect(function(character)
			setGroup(character)
			-- spawn in front of the restaurant
			task.defer(function()
				local hrp = character:WaitForChild("HumanoidRootPart", 5)
				if hrp then
					character:PivotTo(CFrame.new(0, 3, -6) * CFrame.Angles(0, math.rad(180), 0))
				end
			end)
		end)
		if p.Character then
			setGroup(p.Character)
		end
	end
	players.PlayerAdded:Connect(onPlayer)
	for _, p in ipairs(players:GetPlayers()) do
		onPlayer(p)
	end
	if not streetBuilt then
		buildStreet("tokyo")
	end
end

return World
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="StarterPlayer" referent="RBX000128"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX000127"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX000126"><Properties><string name="Name">Client</string></Properties><Item class="Folder" referent="RBX000103"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX000092"><Properties><string name="Name">Ambient</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Client-only animations: swaying lanterns and noren, maneki-neko paws, koi, shishi-odoshi,
-- streamers, and the evening train on the viaduct.
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Registry = require(Shared.Models.Registry)

local Ambient = {}
local parts = {} -- [part] = { kind, base, last, phase }
local rng = Random.new()

local function track(d)
	if d:IsA("BasePart") and d:GetAttribute("Animate") then
		parts[d] = { kind = d:GetAttribute("Animate"), base = d.CFrame, last = d.CFrame, phase = rng:NextNumber() * 10 }
	end
end

local function offset(info, part, tt)
	local k, ph = info.kind, info.phase
	local h = part.Size.Y
	if k == "sway" then
		return CFrame.new(0, h / 2, 0) * CFrame.Angles(math.sin(tt * 1.3 + ph) * 0.035, 0, math.sin(tt * 1.7 + ph) * 0.05) * CFrame.new(0, -h / 2, 0)
	elseif k == "paw" then
		return CFrame.new(0, -h / 2, 0) * CFrame.Angles(math.sin(tt * 4 + ph) * 0.45, 0, 0) * CFrame.new(0, h / 2, 0)
	elseif k == "fish" or k == "koi" then
		local r = k == "koi" and 1.4 or 0.9
		local a = tt * (k == "koi" and 0.5 or 0.8) + ph
		return CFrame.new(math.sin(a) * r, math.sin(tt * 2 + ph) * 0.05, math.cos(a) * r * 0.6) * CFrame.Angles(0, a + math.pi / 2, 0)
	elseif k == "shishi" then
		local cycle = (tt + ph) % 7
		local tilt = cycle < 5.5 and (cycle / 5.5) * 0.5 or 0.5 - (cycle - 5.5) / 1.5 * 0.5
		return CFrame.Angles(0, 0, -tilt)
	elseif k == "streamer" then
		return CFrame.Angles(0, math.sin(tt * 2 + ph) * 0.25, math.sin(tt * 3.2 + ph) * 0.12)
	end
	return CFrame.new()
end

local function runTrain()
	local S = Registry.Street
	if not S then
		return
	end
	local train = S.train(4)
	train.Parent = workspace.CurrentCamera
	while true do
		local dir = rng:NextNumber() < 0.5 and 1 or -1
		local x0, x1 = -520 * dir, 520 * dir
		local t0 = os.clock()
		local duration = 22
		while os.clock() - t0 < duration do
			local k = (os.clock() - t0) / duration
			train:PivotTo(CFrame.new(x0 + (x1 - x0) * k, 22 + 0.8 + 2.5, -95) * CFrame.Angles(0, dir > 0 and math.pi or 0, 0))
			task.wait()
		end
		train:PivotTo(CFrame.new(0, -200, 0))
		task.wait(rng:NextNumber() * 40 + 35)
	end
end

function Ambient.Start()
	Registry.load()
	for _, d in ipairs(workspace:GetDescendants()) do
		track(d)
	end
	workspace.DescendantAdded:Connect(track)
	workspace.DescendantRemoving:Connect(function(d)
		parts[d] = nil
	end)
	RunService.RenderStepped:Connect(function()
		local cam = workspace.CurrentCamera
		local camPos = cam and cam.CFrame.Position or Vector3.new()
		local tt = os.clock()
		for part, info in pairs(parts) do
			if part.Parent then
				-- the server moved/rebuilt the part: take the new base
				if part.CFrame ~= info.last then
					info.base = part.CFrame
				end
				if (info.base.Position - camPos).Magnitude < 110 then
					local cf = info.base * offset(info, part, tt)
					part.CFrame = cf
					info.last = cf
				end
			else
				parts[part] = nil
			end
		end
	end)
	task.spawn(runTrain)
end

return Ambient
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000093"><Properties><string name="Name">Audio</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Sound effects (2D or positional) and background music.
local SoundService = game:GetService("SoundService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local AudioCfg = require(Shared.Config.Audio)
local Core = require(script.Parent.Parent.Core)

local Audio = {}
local cache = {}
local music

local function volume(kind)
	local s = Core.C.Data and Core.C.Data.m("settings")
	if kind == "music" then
		return (s and s.music or 0.5) * AudioCfg.Volume.music
	end
	return (s and s.sfx or 0.8) * AudioCfg.Volume.sfx
end

function Audio.play(name, pos)
	local id = AudioCfg.Sfx[name]
	if not id or id == "" then
		return
	end
	local vol = volume("sfx")
	if vol <= 0 then
		return
	end
	if pos then
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.Transparency = 1
		p.Size = Vector3.new(0.2, 0.2, 0.2)
		p.Position = pos
		p.Parent = workspace.CurrentCamera
		local s = Instance.new("Sound")
		s.SoundId = id
		s.Volume = vol
		s.RollOffMaxDistance = 80
		s.Parent = p
		s:Play()
		task.delay(4, function()
			p:Destroy()
		end)
		return
	end
	local s = cache[name]
	if not s then
		s = Instance.new("Sound")
		s.SoundId = id
		s.Parent = SoundService
		cache[name] = s
	end
	s.Volume = vol
	s.TimePosition = 0
	s:Play()
end

function Audio.Start()
	music = Instance.new("Sound")
	music.Looped = true
	music.Parent = SoundService
	local currentId = nil
	while true do
		local night = game:GetService("Lighting").ClockTime >= 18.5 or game:GetService("Lighting").ClockTime < 6
		local id = night and AudioCfg.Music.night or AudioCfg.Music.day
		if id ~= "" and id ~= currentId then
			currentId = id
			music.SoundId = id
			music:Play()
		end
		music.Volume = volume("music")
		task.wait(2)
	end
end

return Audio
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000094"><Properties><string name="Name">Build</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Build mode: ghost preview on a 1/5/10 stud grid, rotation, local validation (same rules as the
-- server), placing, moving, storing and selling objects.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")
local GuiService = game:GetService("GuiService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local GameConfig = require(Shared.Config.GameConfig)
local Items = require(Shared.Config.Items)
local Expansions = require(Shared.Config.Expansions)
local Grid = require(Shared.Logic.Grid)
local Geometry = require(Shared.Logic.Geometry)
local PlacementLogic = require(Shared.Logic.Placement)
local Registry = require(Shared.Models.Registry)
local Color = require(Shared.Util.Color)
local Signal = require(Shared.Util.Signal)
local Core = require(script.Parent.Parent.Core)

local Build = {}
Build.active = false
Build.mode = nil -- "new" | "inventory" | "move"
Build.itemId = nil
Build.moveUid = nil
Build.rot = 0
Build.grid = 1
Build.selected = nil
Build.valid = false
Build.reason = nil
Build.Changed = Signal.new()

local player = Players.LocalPlayer
local ghost, highlight, hoverHighlight
local geo, geoKey = nil, nil
local lastReq, lastValidate = nil, 0
local gridParts = {}
local touchPos = nil
local lastResolved = nil

local function itemsFolder()
	local r = workspace:FindFirstChild("Restaurant")
	return r and r:FindFirstChild("Items")
end

local function geometry()
	local zones = Core.C.Data.w("zones") or { zone_base = true }
	local key = ""
	for id in pairs(zones) do
		key ..= id .. ";"
	end
	if key ~= geoKey then
		geo = Geometry.compute(Expansions.list, zones, Expansions.Supplier)
		geoKey = key
	end
	return geo
end

function Build.geometry()
	return geometry()
end

local function ctx()
	local placed = Core.C.Data.w("placed") or {}
	return Geometry.ctx(geometry(), Items.byId, placed, GameConfig)
end

local function floorY(f)
	return (f or 0) * GameConfig.FloorHeight
end

local function worldY(entry, item)
	if entry.s == "f" then
		return floorY(entry.f)
	elseif entry.s == "c" then
		return floorY(entry.f) + GameConfig.WallHeight - item.size[2]
	elseif entry.s == "w" then
		return (entry.y or floorY(entry.f) + 6) - item.size[2] / 2
	end
	return entry.y or floorY(entry.f)
end

------------------------------------------------------------------ ghost & grid

local function clearGhost()
	if ghost then
		ghost:Destroy()
		ghost = nil
	end
	for _, p in ipairs(gridParts) do
		p.Transparency = 1
	end
end

local function makeGhost(itemId)
	clearGhost()
	Registry.load()
	local world = Core.C.Data.world or {}
	ghost = Registry.build(itemId, { styles = Expansions.styles(world.zones) })
	for _, d in ipairs(ghost:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.CastShadow = false
			if d.Transparency < 1 then
				d.Transparency = math.max(d.Transparency, 0.35)
			end
		elseif d:IsA("Light") or d:IsA("ParticleEmitter") then
			d.Enabled = false
		end
	end
	ghost.Parent = workspace.CurrentCamera
	highlight.Adornee = ghost
	highlight.Enabled = true
end

local function gridLine(i)
	local p = gridParts[i]
	if not p then
		p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Material = Enum.Material.Neon
		p.Color = Color.hex("#FFF4D6")
		p.Transparency = 1
		p.Parent = workspace.CurrentCamera
		gridParts[i] = p
	end
	return p
end

local function drawGrid(cx, cz, y, g)
	local radius = math.clamp(g * 6, 8, 40)
	local x0 = Grid.snapValue(cx - radius, g)
	local z0 = Grid.snapValue(cz - radius, g)
	local n = math.floor(radius * 2 / g)
	local i = 0
	for k = 0, n do
		i += 1
		local p = gridLine(i)
		p.Size = Vector3.new(0.06, 0.03, radius * 2)
		p.CFrame = CFrame.new(x0 + k * g, y + 0.04, cz)
		p.Transparency = 0.55
		i += 1
		local q = gridLine(i)
		q.Size = Vector3.new(radius * 2, 0.03, 0.06)
		q.CFrame = CFrame.new(cx, y + 0.04, z0 + k * g)
		q.Transparency = 0.55
	end
	for k = i + 1, #gridParts do
		gridParts[k].Transparency = 1
	end
end

------------------------------------------------------------------ raycasting

local function cursor()
	if touchPos then
		return touchPos
	end
	return UserInputService:GetMouseLocation()
end

local function cast(includeParts)
	local cam = workspace.CurrentCamera
	local pos = cursor()
	local ray = cam:ViewportPointToRay(pos.X, pos.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = includeParts
	return workspace:Raycast(ray.Origin, ray.Direction * 400, params)
end

local function ownerModel(inst)
	local folder = itemsFolder()
	while inst and inst.Parent and inst.Parent ~= folder do
		inst = inst.Parent
	end
	if inst and inst.Parent == folder then
		return inst
	end
	return nil
end

local function onFloor(tagName)
	local floor = Core.C.Camera.floor or 0
	local out = {}
	for _, p in ipairs(CollectionService:GetTagged(tagName)) do
		local f = p:GetAttribute("FloorIndex") or 0
		if f == floor then
			table.insert(out, p)
		end
	end
	return out
end

local function buildRequest()
	local item = Items.byId[Build.itemId]
	if not item then
		return nil
	end
	local code = PlacementLogic.PlaceCode[item.place]
	local w, h, d = item.size[1], item.size[2], item.size[3]
	local g = Build.grid
	if code == "f" or code == "c" then
		local hit = cast(onFloor("Floor"))
		if not hit then
			return nil
		end
		local f = hit.Instance:GetAttribute("FloorIndex") or 0
		if f < 0 then
			return nil
		end
		local x, z = Grid.snapFloor(hit.Position.X, hit.Position.Z, w, d, Build.rot, g)
		return { i = item.id, x = x, z = z, r = Build.rot, f = f, s = code }
	elseif code == "w" then
		local hit = cast(onFloor("Wall"))
		if not hit or hit.Instance:GetAttribute("Rail") then
			return nil
		end
		local f = hit.Instance:GetAttribute("FloorIndex") or 0
		local n = hit.Normal
		local alongX = math.abs(n.Z) > math.abs(n.X)
		local along = alongX and hit.Position.X or hit.Position.Z
		local a, y = Grid.snapWall(along, hit.Position.Y, w, h, g, floorY(f))
		local off = 0.4 + d / 2 + 0.05
		local x = alongX and a or hit.Position.X + n.X * off
		local z = alongX and hit.Position.Z + n.Z * off or a
		return { i = item.id, x = x, z = z, y = y, r = 0, f = f, s = code }
	elseif code == "t" then
		local folder = itemsFolder()
		if not folder then
			return nil
		end
		local hit = cast({ folder })
		local model = hit and ownerModel(hit.Instance)
		if not model then
			return nil
		end
		local kind = model:GetAttribute("Kind")
		if kind ~= "counter" and kind ~= "table" and kind ~= "booth" then
			return nil
		end
		local uid = model:GetAttribute("Uid")
		local parent = nil
		for _, e in ipairs(Core.C.Data.w("placed") or {}) do
			if e.u == uid then
				parent = e
			end
		end
		if not parent then
			return nil
		end
		local x, z = Grid.snapFloor(hit.Position.X, hit.Position.Z, w, d, Build.rot, math.min(g, 0.5))
		return { i = item.id, x = x, z = z, r = Build.rot, f = parent.f or 0, s = "t", p = uid }
	end
	return nil
end

local function sameReq(a, b)
	if not a or not b then
		return false
	end
	return a.x == b.x and a.z == b.z and a.r == b.r and a.f == b.f and a.y == b.y and a.p == b.p and a.i == b.i
end

local function step()
	if not Build.active then
		return
	end
	if not ghost then
		-- selection hover
		local folder = itemsFolder()
		if folder and not touchPos then
			local hit = cast({ folder })
			local model = hit and ownerModel(hit.Instance)
			hoverHighlight.Adornee = model
			hoverHighlight.Enabled = model ~= nil
		end
		return
	end
	local req = buildRequest()
	if not req then
		Build.valid = false
		Build.reason = "msg.place_point"
		ghost.Parent = nil
		Build.Changed:Fire()
		return
	end
	ghost.Parent = workspace.CurrentCamera
	if Build.mode == "move" then
		req.u = Build.moveUid
	end
	local item = Items.byId[req.i]
	if not sameReq(req, lastReq) or os.clock() - lastValidate > 1 then
		lastReq = req
		lastValidate = os.clock()
		local ok, reason, resolved = PlacementLogic.validate(ctx(), req)
		Build.valid = ok
		Build.reason = reason
		lastResolved = resolved
		Build.Changed:Fire()
	end
	local r = lastResolved or req
	local pos = { x = r.x, z = r.z, r = r.r or req.r, y = r.y, f = r.f or req.f, s = req.s }
	Registry.place(ghost, pos.x, worldY(pos, item), pos.z, pos.r)
	highlight.FillColor = Build.valid and Color.hex("#6DDC5A") or Color.hex("#FF3B4A")
	highlight.OutlineColor = highlight.FillColor
	drawGrid(req.x, req.z, floorY(req.f), Build.grid)
end

------------------------------------------------------------------ actions

function Build.place()
	if not ghost or not Build.valid or not lastResolved then
		if Build.reason then
			Core.C.UI.toast(Locale.t(Build.reason), "error")
		end
		return
	end
	local req = lastReq
	if Build.mode == "move" then
		NetDef.event("MoveItem"):FireServer(Build.moveUid, req)
		Build.cancel()
	else
		NetDef.event("PlaceItem"):FireServer(req, Build.mode == "inventory")
		if Build.mode == "inventory" then
			local inv = Core.C.Data.w("inventory") or {}
			if (inv[Build.itemId] or 0) <= 1 then
				Build.cancel()
			end
		end
	end
	lastReq = nil
	if Core.C.Audio then
		Core.C.Audio.play("place")
	end
end

function Build.startPlace(itemId, fromInventory)
	if not Build.active then
		Build.enter()
	end
	Build.mode = fromInventory and "inventory" or "new"
	Build.itemId = itemId
	Build.moveUid = nil
	Build.selected = nil
	lastReq, lastResolved = nil, nil
	makeGhost(itemId)
	Build.Changed:Fire()
end

function Build.startMove(uid)
	for _, e in ipairs(Core.C.Data.w("placed") or {}) do
		if e.u == uid then
			Build.mode = "move"
			Build.itemId = e.i
			Build.moveUid = uid
			Build.rot = e.r or 0
			lastReq, lastResolved = nil, nil
			makeGhost(e.i)
			Build.Changed:Fire()
			return
		end
	end
end

function Build.cancel()
	Build.mode = nil
	Build.itemId = nil
	Build.moveUid = nil
	clearGhost()
	highlight.Enabled = false
	Build.Changed:Fire()
end

function Build.rotate()
	local s = Core.C.Data.m("settings")
	local stepDeg = s and s.rot or 90
	if Build.selected and not ghost then
		-- rotate a selected object in place
		for _, e in ipairs(Core.C.Data.w("placed") or {}) do
			if e.u == Build.selected then
				local req = { i = e.i, x = e.x, z = e.z, y = e.y, f = e.f, s = e.s, p = e.p, r = Grid.nextRotation(e.r or 0, stepDeg) }
				NetDef.event("MoveItem"):FireServer(e.u, req)
			end
		end
		return
	end
	Build.rot = Grid.nextRotation(Build.rot, stepDeg)
	lastReq = nil
end

function Build.cycleGrid()
	local sizes = GameConfig.GridSizes
	local idx = table.find(sizes, Build.grid) or 1
	Build.grid = sizes[idx % #sizes + 1]
	NetDef.event("SetSetting"):FireServer("grid", Build.grid)
	lastReq = nil
	Build.Changed:Fire()
end

function Build.setGrid(g)
	Build.grid = g
	NetDef.event("SetSetting"):FireServer("grid", g)
	lastReq = nil
	Build.Changed:Fire()
end

function Build.select(uid)
	Build.selected = uid
	Build.Changed:Fire()
end

function Build.removeSelected(mode)
	if Build.selected then
		NetDef.event("RemoveItem"):FireServer(Build.selected, mode)
		Build.selected = nil
		hoverHighlight.Enabled = false
		Build.Changed:Fire()
	end
end

function Build.enter()
	if not Core.C.Data.canBuild() then
		Core.C.UI.toast(Locale.t("msg.no_permission"), "error")
		return
	end
	Build.active = true
	local s = Core.C.Data.m("settings")
	Build.grid = s and s.grid or 1
	Core.C.Camera.setBuildView(true)
	Core.C.UI.open("Build")
	Build.Changed:Fire()
end

function Build.exit()
	Build.cancel()
	Build.active = false
	Build.selected = nil
	hoverHighlight.Enabled = false
	Core.C.Camera.setBuildView(false)
	Core.C.UI.close("Build")
	Build.Changed:Fire()
end

function Build.toggle()
	if Build.active then
		Build.exit()
	else
		Build.enter()
	end
end

local function clickedGui(pos)
	local objs = player.PlayerGui:GetGuiObjectsAtPosition(pos.X, pos.Y - GuiService:GetGuiInset().Y)
	for _, o in ipairs(objs) do
		if o.Visible and o.BackgroundTransparency < 1 then
			return true
		end
	end
	return false
end

function Build.Init()
	highlight = Instance.new("Highlight")
	highlight.FillTransparency = 0.55
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Enabled = false
	highlight.Parent = player:WaitForChild("PlayerGui")
	hoverHighlight = Instance.new("Highlight")
	hoverHighlight.FillTransparency = 0.8
	hoverHighlight.FillColor = Color.hex("#FFD23B")
	hoverHighlight.OutlineColor = Color.hex("#FFD23B")
	hoverHighlight.Enabled = false
	hoverHighlight.Parent = player.PlayerGui
end

function Build.Start()
	RunService.RenderStepped:Connect(function()
		local ok, err = pcall(step)
		if not ok then
			warn("[Build] " .. tostring(err))
		end
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not Build.active then
			return
		end
		if input.UserInputType == Enum.UserInputType.Touch then
			touchPos = Vector2.new(input.Position.X, input.Position.Y + GuiService:GetGuiInset().Y)
		end
		if processed then
			return
		end
		local kc = input.KeyCode
		if kc == Enum.KeyCode.R then
			Build.rotate()
		elseif kc == Enum.KeyCode.G then
			Build.cycleGrid()
		elseif kc == Enum.KeyCode.Q then
			if ghost then
				Build.cancel()
			else
				Build.exit()
			end
		elseif kc == Enum.KeyCode.X or kc == Enum.KeyCode.Delete then
			Build.removeSelected("sell")
		elseif kc == Enum.KeyCode.F then
			Build.removeSelected("store")
		elseif kc == Enum.KeyCode.M and Build.selected then
			Build.startMove(Build.selected)
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
			if clickedGui(UserInputService:GetMouseLocation()) then
				return
			end
			if ghost then
				Build.place()
			else
				local folder = itemsFolder()
				local hit = folder and cast({ folder })
				local model = hit and ownerModel(hit.Instance)
				Build.select(model and model:GetAttribute("Uid") or nil)
			end
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 and ghost then
			Build.cancel()
		elseif input.UserInputType == Enum.UserInputType.Touch and not ghost then
			local folder = itemsFolder()
			local hit = folder and cast({ folder })
			local model = hit and ownerModel(hit.Instance)
			Build.select(model and model:GetAttribute("Uid") or nil)
			hoverHighlight.Adornee = model
			hoverHighlight.Enabled = model ~= nil
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			touchPos = nil
		elseif input.UserInputType == Enum.UserInputType.Touch and Build.active then
			touchPos = Vector2.new(input.Position.X, input.Position.Y + GuiService:GetGuiInset().Y)
		end
	end)
	Core.C.Data.Changed:Connect(function(_, key)
		if key == "placed" or key == "zones" or key == "all" then
			lastReq = nil
		end
	end)
end

return Build
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000095"><Properties><string name="Name">Camera</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Build-mode camera (top view) and hiding roofs/ceilings while building.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")

local Camera = {}
Camera.top = false
Camera.build = false
Camera.floor = 0
local height = 48
local conn = nil
local player = Players.LocalPlayer

local FLOOR_HEIGHT = 15

function Camera.currentFloor()
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return 0
	end
	return math.max(0, math.floor((root.Position.Y + 2) / FLOOR_HEIGHT))
end

-- hides roofs, ceilings and anything on the floors above `floor` (nil = show everything)
local function setRoofs(hidden, floor)
	for _, tagName in ipairs({ "Roof", "Ceiling" }) do
		for _, p in ipairs(CollectionService:GetTagged(tagName)) do
			if p:IsA("BasePart") then
				p.LocalTransparencyModifier = hidden and 1 or 0
			end
		end
	end
	for _, tagName in ipairs({ "Floor", "Wall" }) do
		for _, p in ipairs(CollectionService:GetTagged(tagName)) do
			if p:IsA("BasePart") then
				local f = p:GetAttribute("FloorIndex") or 0
				p.LocalTransparencyModifier = (hidden and floor and f > floor) and 1 or 0
			end
		end
	end
	local items = workspace:FindFirstChild("Restaurant") and workspace.Restaurant:FindFirstChild("Items")
	if items then
		for _, m in ipairs(items:GetChildren()) do
			local above = hidden and floor and (m:GetAttribute("FloorIndex") or 0) > floor
			for _, d in ipairs(m:GetDescendants()) do
				if d:IsA("BasePart") then
					-- parts tagged Roof (canopies, cords right under the ceiling) hide like the roof
					local roofLike = hidden and CollectionService:HasTag(d, "Roof")
					d.LocalTransparencyModifier = (above or roofLike) and 1 or 0
				end
			end
		end
	end
end

local function topLoop()
	local cam = workspace.CurrentCamera
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local focus = root.Position
	local pos = focus + Vector3.new(0, height, height * 0.55)
	cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(pos, focus), 0.25)
end

function Camera.setTop(on)
	Camera.top = on
	local cam = workspace.CurrentCamera
	if on then
		cam.CameraType = Enum.CameraType.Scriptable
		if not conn then
			conn = RunService.RenderStepped:Connect(topLoop)
		end
	else
		if conn then
			conn:Disconnect()
			conn = nil
		end
		cam.CameraType = Enum.CameraType.Custom
	end
end

function Camera.toggleTop()
	Camera.setTop(not Camera.top)
end

function Camera.setBuildView(on)
	Camera.build = on
	Camera.floor = Camera.currentFloor()
	setRoofs(on, Camera.floor)
	if not on and Camera.top then
		Camera.setTop(false)
	end
end

function Camera.Start()
	UserInputService.InputChanged:Connect(function(input)
		if Camera.top and input.UserInputType == Enum.UserInputType.MouseWheel then
			height = math.clamp(height - input.Position.Z * 4, 18, 95)
		end
	end)
	CollectionService:GetInstanceAddedSignal("Roof"):Connect(function(p)
		if Camera.build and p:IsA("BasePart") then
			p.LocalTransparencyModifier = 1
		end
	end)
	-- follow the player up and down the stairs while building
	while true do
		task.wait(1)
		if Camera.build then
			local f = Camera.currentFloor()
			if f ~= Camera.floor then
				Camera.floor = f
			end
			setRoofs(true, Camera.floor)
		end
	end
end

return Camera
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000096"><Properties><string name="Name">Data</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Local copy of the player's profile ("me"), the restaurant owner's data ("world"),
-- session info, day state and tickets.
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Locale = require(Shared.Locale)

local Data = {}
Data.me = nil
Data.world = nil
Data.session = { role = "helper", mode = "world" }
Data.day = { phase = "prep", clock = 9.5, day = 1 }
Data.tickets = {}
Data.Changed = Signal.new() -- (scope, key)
Data.DayChanged = Signal.new()
Data.TicketsChanged = Signal.new()
Data.SessionChanged = Signal.new()
Data.Ready = Signal.new()
Data.ready = false

function Data.w(key)
	local w = Data.world or Data.me
	return w and w[key]
end

function Data.m(key)
	return Data.me and Data.me[key]
end

function Data.role()
	return Data.session and Data.session.role or "helper"
end

function Data.canBuild()
	local r = Data.role()
	return r == "owner" or r == "comanager"
end

-- yen shown in the HUD: the restaurant wallet for owner/co-manager, own wallet for helpers
function Data.wallet()
	if Data.canBuild() then
		return Data.w("yen") or 0
	end
	return Data.m("yen") or 0
end

function Data.applyLanguage()
	local lang = Data.me and Data.me.settings and Data.me.settings.lang or "auto"
	if lang == "auto" then
		lang = Locale.resolve(Players.LocalPlayer.LocaleId)
	end
	Locale.set(lang)
end

function Data.Init()
	NetDef.event("DataChanged").OnClientEvent:Connect(function(scope, key, value)
		if scope == "me" then
			Data.me = Data.me or {}
			Data.me[key] = value
			if key == "settings" then
				Data.applyLanguage()
			end
		else
			Data.world = Data.world or {}
			Data.world[key] = value
		end
		Data.Changed:Fire(scope, key)
	end)
	NetDef.event("DayState").OnClientEvent:Connect(function(state)
		Data.day = state
		Data.DayChanged:Fire(state)
	end)
	NetDef.event("Tickets").OnClientEvent:Connect(function(list)
		Data.tickets = list
		Data.TicketsChanged:Fire(list)
	end)
	NetDef.event("Session").OnClientEvent:Connect(function(info)
		Data.session = info
		Data.SessionChanged:Fire(info)
	end)
end

function Data.Start()
	local snap
	for _ = 1, 20 do
		local ok, result = pcall(function()
			return NetDef.func("GetSnapshot"):InvokeServer()
		end)
		if ok and result then
			snap = result
			break
		end
		task.wait(1)
	end
	if snap then
		Data.me = snap.me
		Data.world = snap.world or snap.me
		if snap.session then
			Data.session = snap.session
		end
	end
	Data.applyLanguage()
	Data.ready = true
	Data.Ready:Fire()
	Data.Changed:Fire("all", "all")
	-- the world snapshot may arrive before the owner finished loading: refresh once more
	task.delay(4, function()
		local ok, result = pcall(function()
			return NetDef.func("GetSnapshot"):InvokeServer()
		end)
		if ok and result and result.world then
			Data.world = result.world
			if result.session then
				Data.session = result.session
				Data.SessionChanged:Fire(result.session)
			end
			Data.Changed:Fire("all", "all")
		end
	end)
end

return Data
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000097"><Properties><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Visual feedback for server events: money popups, review stars, level up confetti,
-- dish ready sparkles, construction dust, sounds.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Format = require(Shared.Util.Format)
local Color = require(Shared.Util.Color)
local Kit = require(Shared.Models.Kit)
local Core = require(script.Parent.Parent.Core)

local Effects = {}
local player = Players.LocalPlayer

local function popup(pos, text, color, rise)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.Transparency = 1
	p.Size = Vector3.new(0.2, 0.2, 0.2)
	p.Position = pos
	p.Parent = workspace.CurrentCamera
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(200, 50)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Adornee = p
	gui.Parent = player.PlayerGui
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextScaled = true
	l.TextColor3 = color or Color.hex("#FFD23B")
	l.TextStrokeTransparency = 0.3
	l.FontFace = Font.new("rbxasset://fonts/families/FredokaOne.json")
	l.AutoLocalize = false
	l.Parent = gui
	TweenService:Create(p, TweenInfo.new(1.6, Enum.EasingStyle.Quad), { Position = pos + Vector3.new(0, rise or 3, 0) }):Play()
	TweenService:Create(l, TweenInfo.new(1.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	task.delay(1.7, function()
		gui:Destroy()
		p:Destroy()
	end)
end

local function burst(pos, preset, count, color)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.Transparency = 1
	p.Size = Vector3.new(1, 1, 1)
	p.Position = pos
	p.Parent = workspace.CurrentCamera
	local e = Kit.particles(p, preset, { rate = 0, color = color, glow = 0.6 })
	e:Emit(count or 20)
	task.delay(3, function()
		p:Destroy()
	end)
end

local function confetti()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	for _, c in ipairs({ "#FF3B4A", "#FFD23B", "#3BC8FF", "#6DDC5A", "#F7B7C9" }) do
		burst(root.Position + Vector3.new(0, 4, 0), "sparkle", 18, c)
	end
end

function Effects.Init()
	NetDef.event("Fx").OnClientEvent:Connect(function(kind, data)
		data = data or {}
		local Audio = Core.C.Audio
		if kind == "money" and data.pos then
			popup(data.pos, "+" .. Format.yen(data.amount or 0, Locale.get()), Color.hex("#FFD23B"))
		elseif kind == "review" and data.pos then
			local stars = data.stars or 3
			popup(data.pos + Vector3.new(0, 1.2, 0), string.rep("★", math.floor(stars)) .. (stars % 1 >= 0.5 and "½" or ""), stars >= 4 and Color.hex("#FFD23B") or Color.hex("#FF8A5A"), 2)
		elseif kind == "levelup" then
			if data.userId == player.UserId or true then
				confetti()
			end
			if Audio then
				Audio.play("level")
			end
		elseif kind == "dishReady" and data.pos then
			burst(data.pos, "sparkle", 14)
			if Audio then
				Audio.play("bell", data.pos)
			end
		elseif kind == "ready" and data.pos then
			popup(data.pos + Vector3.new(0, 3, 0), "✅", Color.hex("#6DDC5A"), 1.5)
		elseif kind == "sparkle" then
			confetti()
		elseif kind == "construction" then
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if root then
				burst(root.Position + Vector3.new(0, 6, 8), "smoke", 30, "#D8C8B0")
			end
			Core.C.UI.toast("🏗️ " .. Locale.t("msg.construction"), "info")
		elseif kind == "sfx" and Audio then
			Audio.play(data.name, data.pos)
		elseif kind == "action" then
			if Core.C.Tutorial then
				Core.C.Tutorial.onAction(data.kind, data.hands)
			end
		end
	end)
end

return Effects
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000098"><Properties><string name="Name">Interaction</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Hover highlight + action label on nearby interactables; click / tap / E sends Interact.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local GameConfig = require(Shared.Config.GameConfig)
local Recipes = require(Shared.Config.Recipes)
local Ingredients = require(Shared.Config.Ingredients)
local Color = require(Shared.Util.Color)
local Core = require(script.Parent.Parent.Core)

local Interaction = {}
local player = Players.LocalPlayer
local t = Locale.t

local highlight, label, labelText
local current = nil -- { model, uid, kind, slot }
local lastCheck = 0
local recipeMarks = {}

local function hrp()
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function findTarget(inst)
	local slot = nil
	while inst and inst ~= workspace do
		if inst:GetAttribute("Slot") then
			slot = inst:GetAttribute("Slot")
		end
		if inst:IsA("Model") and inst:GetAttribute("Uid") and CollectionService:HasTag(inst, "Interactable") then
			return inst, slot
		end
		inst = inst.Parent
	end
	return nil
end

local function castAt(screenPos)
	local cam = workspace.CurrentCamera
	local ray = cam:ViewportPointToRay(screenPos.X, screenPos.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = { cam }
	if player.Character then
		table.insert(ignore, player.Character)
	end
	local street = workspace:FindFirstChild("Street")
	if street then
		table.insert(ignore, street)
	end
	params.FilterDescendantsInstances = ignore
	return workspace:Raycast(ray.Origin, ray.Direction * 200, params)
end

local function handsKind()
	local k = player:GetAttribute("HandsKind")
	return (k and k ~= "") and k or nil
end

local function stepName(name)
	return t("step." .. name)
end

-- Text shown above the hovered object
local function actionText(model, kind, slot)
	local hands = handsKind()
	if kind == "box" then
		local g = model:GetAttribute("Ingredient")
		return hands and t("hint.hands_full") or t("hint.take_box", { name = "ing." .. (g or "rice") })
	elseif kind == "shelf" then
		if hands == "box" then
			return t("hint.restock")
		end
		local part = slot and model:FindFirstChild("Slot" .. slot)
		local g = part and part:GetAttribute("G") or ""
		if g ~= "" then
			return t("hint.take_ing", { name = "ing." .. g, n = part:GetAttribute("N") or 0 })
		end
		return t("hint.shelf_empty")
	elseif kind == "ricecooker" or kind == "pot" then
		if hands == "box" then
			return t("hint.pour")
		end
		local n, c = model:GetAttribute("N") or 0, model:GetAttribute("C") or 0
		if c > 0 then
			return t("hint.cooking")
		end
		return kind == "ricecooker" and t("hint.rice_status", { n = n }) or t("hint.broth_status", { n = n })
	elseif kind == "station" then
		local ready = model:GetAttribute("Ready") or ""
		if ready ~= "" then
			return t("hint.take_dish", { dish = "rec." .. ready })
		end
		if hands == "ing" then
			return t("hint.put_ingredients")
		end
		local recipe = model:GetAttribute("Recipe") or ""
		local steps = model:GetAttribute("Steps") or ""
		if recipe ~= "" then
			local list = string.split(steps, ",")
			local idx = (model:GetAttribute("Step") or 0) + 1
			return t("hint.do_step", { step = "step." .. (list[idx] or "combine"), dish = "rec." .. recipe, i = idx, n = #list })
		end
		if (model:GetAttribute("Board") or "") ~= "" then
			return t("hint.board_incomplete")
		end
		return t("hint.station")
	elseif kind == "customer" then
		local state = model:GetAttribute("State")
		local order = model:GetAttribute("Order") or ""
		if state == "order" then
			return t("hint.take_order")
		elseif state == "waiting" then
			return hands == "dish" and t("hint.serve", { dish = "rec." .. order }) or t("hint.waiting_for", { dish = "rec." .. order })
		end
		return t("hint.customer")
	elseif kind == "dirty" then
		return t("hint.collect")
	elseif kind == "sink" then
		if hands == "dirty" then
			return t("hint.wash")
		end
		local pile = workspace:GetAttribute("SinkPile") or 0
		return pile > 0 and t("hint.wash_pile", { n = pile }) or t("hint.sink")
	elseif kind == "dishwasher" then
		return hands == "dirty" and t("hint.load_dishwasher") or t("hint.dishwasher", { n = model:GetAttribute("Queue") or 0 })
	elseif kind == "rack" then
		return hands == "box" and t("hint.put_back") or t("hint.rack")
	elseif kind == "supplier" then
		return t("hint.supplier")
	elseif kind == "menuboard" then
		return t("hint.menuboard")
	end
	return nil
end

local function inRange(model)
	local root = hrp()
	if not root then
		return false
	end
	local pos = model:GetPivot().Position
	local size = model:GetExtentsSize()
	local margin = math.max(size.X, size.Z) / 2
	local flat = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(root.Position.X, 0, root.Position.Z)).Magnitude
	return flat <= GameConfig.InteractRange + margin - 0.5 and math.abs(pos.Y - root.Position.Y) < 12
end

local function setCurrent(model, slot)
	if not model then
		current = nil
		highlight.Adornee = nil
		highlight.Enabled = false
		label.Enabled = false
		return
	end
	local kind = model:GetAttribute("Kind")
	local text = actionText(model, kind, slot)
	if not text then
		setCurrent(nil)
		return
	end
	local near = inRange(model)
	current = { model = model, uid = model:GetAttribute("Uid"), kind = kind, slot = slot, near = near }
	highlight.Adornee = model
	highlight.Enabled = true
	highlight.OutlineColor = near and Color.hex("#FFD23B") or Color.hex("#B8AFA2")
	label.Adornee = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
	label.Enabled = true
	labelText.Text = near and text or ("🚶 " .. t("hint.get_closer"))
end

local function update(screenPos)
	if Core.C.Build and Core.C.Build.active then
		setCurrent(nil)
		return
	end
	local hit = castAt(screenPos)
	if not hit then
		setCurrent(nil)
		return
	end
	local model, slot = findTarget(hit.Instance)
	setCurrent(model, slot)
end

local function act()
	if not current then
		return
	end
	if not current.near then
		Core.C.UI.toast(t("msg.too_far"), "info")
		return
	end
	if current.kind == "supplier" then
		Core.C.UI.open("Supplier")
		return
	elseif current.kind == "menuboard" then
		Core.C.UI.open("Menu")
		return
	end
	NetDef.event("Interact"):FireServer(current.uid, { slot = current.slot })
	if Core.C.Audio then
		Core.C.Audio.play("click")
	end
end

-- Briefly marks the shelves/station needed for a recipe (clicked ticket)
function Interaction.highlightRecipe(recipeId)
	for _, m in ipairs(recipeMarks) do
		m:Destroy()
	end
	recipeMarks = {}
	local r = Recipes.byId[recipeId]
	if not r then
		return
	end
	local need = {}
	for _, g in ipairs(r.ing) do
		need[g] = true
	end
	for _, model in ipairs(CollectionService:GetTagged("Interactable")) do
		local kind = model:GetAttribute("Kind")
		if kind == "shelf" then
			for _, part in ipairs(model:GetChildren()) do
				if part:IsA("BasePart") and part:GetAttribute("Slot") and need[part:GetAttribute("G") or ""] then
					local box = Instance.new("SelectionBox")
					box.Adornee = part
					box.Color3 = Color.hex("#FFD23B")
					box.LineThickness = 0.08
					box.Parent = player.PlayerGui
					table.insert(recipeMarks, box)
				end
			end
		elseif kind == "station" and model.PrimaryPart then
			local stationId = string.gsub(model.Name, "_station", "")
			if stationId == r.station or (model.Name == "griddle" and r.station == "griddle") or (model.Name == "fryer" and r.station == "fryer") or (model.Name == "takoyaki_stove" and r.station == "takoyaki") then
				local box = Instance.new("SelectionBox")
				box.Adornee = model.PrimaryPart
				box.Color3 = Color.hex("#6DDC5A")
				box.LineThickness = 0.1
				box.Parent = player.PlayerGui
				table.insert(recipeMarks, box)
			end
		end
	end
	local missing = {}
	for g in pairs(need) do
		local found = false
		for _, m in ipairs(recipeMarks) do
			if m.Adornee and m.Adornee:GetAttribute("G") == g then
				found = true
			end
		end
		if not found then
			table.insert(missing, (Ingredients.byId[g] and Ingredients.byId[g].icon or "") .. " " .. t("ing." .. g))
		end
	end
	local msg = t("hint.recipe_needs", { dish = "rec." .. recipeId })
	if #missing > 0 then
		msg ..= "  " .. t("hint.missing") .. ": " .. table.concat(missing, ", ")
	end
	Core.C.UI.toast(msg, #missing > 0 and "warning" or "info")
	task.delay(8, function()
		for _, m in ipairs(recipeMarks) do
			m:Destroy()
		end
		recipeMarks = {}
	end)
end

function Interaction.Init()
	highlight = Instance.new("Highlight")
	highlight.FillTransparency = 1
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Enabled = false
	highlight.Parent = player:WaitForChild("PlayerGui")
	label = Instance.new("BillboardGui")
	label.Size = UDim2.fromOffset(260, 46)
	label.StudsOffsetWorldSpace = Vector3.new(0, 3.2, 0)
	label.AlwaysOnTop = true
	label.LightInfluence = 0
	label.Enabled = false
	label.Parent = player.PlayerGui
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color.hex("#2B2320")
	bg.BackgroundTransparency = 0.15
	bg.Parent = label
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = bg
	labelText = Instance.new("TextLabel")
	labelText.Size = UDim2.new(1, -12, 1, -6)
	labelText.Position = UDim2.fromOffset(6, 3)
	labelText.BackgroundTransparency = 1
	labelText.TextColor3 = Color.hex("#F4EBDD")
	labelText.TextScaled = true
	labelText.FontFace = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold)
	labelText.AutoLocalize = false
	labelText.Parent = bg
end

function Interaction.Start()
	RunService.RenderStepped:Connect(function()
		if os.clock() - lastCheck < 0.05 then
			return
		end
		lastCheck = os.clock()
		if UserInputService.MouseEnabled then
			update(UserInputService:GetMouseLocation())
		elseif current then
			setCurrent(current.model, current.slot)
		end
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or (Core.C.Build and Core.C.Build.active) then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			act()
		elseif input.KeyCode == Enum.KeyCode.E or input.KeyCode == Enum.KeyCode.ButtonX then
			act()
		end
	end)
	UserInputService.TouchTap:Connect(function(positions, processed)
		if processed or (Core.C.Build and Core.C.Build.active) then
			return
		end
		local p = positions[1]
		if p then
			local viewport = Vector2.new(p.X, p.Y + GuiService:GetGuiInset().Y)
			update(viewport)
			act()
		end
	end)
end

return Interaction
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000099"><Properties><string name="Name">Lighting</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Time-of-day look (sky colors, atmosphere, bloom, color grading) and night lights.
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Color = require(Shared.Util.Color)
local Core = require(script.Parent.Parent.Core)

local LightingC = {}
local atmosphere, bloom, grading, rays
local lights = {}

local DAY = { ambient = Color.hex("#8C8478"), outdoor = Color.hex("#9C9488"), top = Color.hex("#FFF3E0"), bright = 2.4, atm = Color.hex("#C9D9E8"), decay = Color.hex("#8FA8C0"), tint = Color.hex("#FFF6EC") }
local SUNSET = { ambient = Color.hex("#8A6A5A"), outdoor = Color.hex("#A0786A"), top = Color.hex("#FFB070"), bright = 1.6, atm = Color.hex("#F0B08A"), decay = Color.hex("#A06A6A"), tint = Color.hex("#FFE2C8") }
-- night: blue sky outside, but a warm, cosy grade so lanterns and pendants glow amber
local NIGHT = { ambient = Color.hex("#4A4050"), outdoor = Color.hex("#2E3450"), top = Color.hex("#6A78B0"), bright = 0.5, atm = Color.hex("#2A3050"), decay = Color.hex("#1A1E38"), tint = Color.hex("#FFE9D4") }

local function blend(a, b, k)
	return {
		ambient = a.ambient:Lerp(b.ambient, k), outdoor = a.outdoor:Lerp(b.outdoor, k), top = a.top:Lerp(b.top, k),
		bright = a.bright + (b.bright - a.bright) * k, atm = a.atm:Lerp(b.atm, k), decay = a.decay:Lerp(b.decay, k), tint = a.tint:Lerp(b.tint, k),
	}
end

local function look(clock)
	if clock >= 7 and clock < 16.5 then
		return DAY, 0
	elseif clock >= 16.5 and clock < 18.5 then
		return blend(DAY, SUNSET, (clock - 16.5) / 2), 0.2
	elseif clock >= 18.5 and clock < 20 then
		return blend(SUNSET, NIGHT, (clock - 18.5) / 1.5), 0.6
	elseif clock >= 5 and clock < 7 then
		return blend(NIGHT, DAY, (clock - 5) / 2), 0.4
	end
	return NIGHT, 1
end

local function track(d)
	if d:IsA("Light") and d:GetAttribute("NightLight") ~= nil then
		table.insert(lights, d)
	end
end

function LightingC.Init()
	atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Density = 0.32
	atmosphere.Offset = 0.2
	atmosphere.Glare = 0.2
	atmosphere.Haze = 1.2
	atmosphere.Parent = Lighting
	bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.55
	bloom.Size = 26
	bloom.Threshold = 1.4
	bloom.Parent = Lighting
	grading = Instance.new("ColorCorrectionEffect")
	grading.Saturation = 0.12
	grading.Contrast = 0.08
	grading.Parent = Lighting
	rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.05
	rays.Spread = 0.6
	rays.Parent = Lighting
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	for _, d in ipairs(workspace:GetDescendants()) do
		track(d)
	end
	workspace.DescendantAdded:Connect(track)
end

function LightingC.Start()
	local lastLights = 0
	RunService.Heartbeat:Connect(function()
		local clock = Lighting.ClockTime
		local l, night = look(clock)
		Lighting.Ambient = l.ambient
		Lighting.OutdoorAmbient = l.outdoor
		Lighting.ColorShift_Top = l.top
		Lighting.Brightness = l.bright
		atmosphere.Color = l.atm
		atmosphere.Decay = l.decay
		grading.TintColor = l.tint
		local s = Core.C.Data and Core.C.Data.m("settings")
		local low = s and s.lowGfx
		bloom.Enabled = not low
		rays.Enabled = not low
		Lighting.GlobalShadows = not low
		if os.clock() - lastLights > 1 then
			lastLights = os.clock()
			local on = night >= 0.2
			for i = #lights, 1, -1 do
				local light = lights[i]
				if not light.Parent then
					table.remove(lights, i)
				elseif light:GetAttribute("NightLight") then
					light.Enabled = on and not (low and light:IsA("SpotLight"))
				end
			end
		end
	end)
end

return LightingC
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000100"><Properties><string name="Name">Tutorial</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Guided first day: step panel, arrow beam to the target and a floating marker.
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Color = require(Shared.Util.Color)
local Kit = require(script.Parent.Parent.UI.Kit)
local Core = require(script.Parent.Parent.Core)

local Tutorial = {}
local player = Players.LocalPlayer
local t = Locale.t
local T = Kit.Theme

-- target(kind) finds the model to point at; done = action kind or a check function
local STEPS = {
	{ key = "tut.welcome", timer = 7 },
	{ key = "tut.take_box", target = "box", action = "take_box" },
	{ key = "tut.fill_shelf", target = "shelf", action = "shelf", hands = "box_done" },
	{ key = "tut.rice", target = "ricecooker", action = "rice", needBox = "rice" },
	{ key = "tut.broth", target = "pot", action = "broth", needBox = "broth_shoyu" },
	{ key = "tut.open", check = function()
		return Core.C.Data.day.phase ~= "prep"
	end },
	{ key = "tut.order", target = "customer", action = "customer" },
	{ key = "tut.ingredients", target = "shelf", action = "shelf", hands = "ing" },
	{ key = "tut.cook", target = "station", check = function()
		for _, m in ipairs(CollectionService:GetTagged("Interactable")) do
			if m:GetAttribute("Kind") == "station" and (m:GetAttribute("Ready") or "") ~= "" then
				return true
			end
		end
		return false
	end },
	{ key = "tut.serve", target = "customer", check = function()
		local s = Core.C.Data.w("stats")
		return s and (s.dishes or 0) > (Tutorial.dishesAtStart or 0)
	end },
	{ key = "tut.collect", target = "dirty", action = "collect" },
	{ key = "tut.wash", target = "sink", action = "wash" },
	{ key = "tut.build", check = function()
		return Core.C.Build.active
	end },
	{ key = "tut.done", timer = 10 },
}

local panel, text, stepLabel, beam, a0, a1, marker
local index = 0
local stepStarted = 0

local function save()
	NetDef.event("TutorialStep"):FireServer(index)
end

local function findTarget(kind)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local best, bestD = nil, math.huge
	for _, m in ipairs(CollectionService:GetTagged("Interactable")) do
		if m:GetAttribute("Kind") == kind and m:IsDescendantOf(workspace) then
			local st = STEPS[index]
			local ok = true
			if st and st.needBox and kind == "box" then
				ok = m:GetAttribute("Ingredient") == st.needBox
			end
			if kind == "customer" then
				ok = m:GetAttribute("State") == "order" or m:GetAttribute("State") == "waiting"
			end
			if ok then
				local d = root and (m:GetPivot().Position - root.Position).Magnitude or 0
				if d < bestD then
					best, bestD = m, d
				end
			end
		end
	end
	return best
end

local function show()
	local st = STEPS[index]
	if not st then
		panel.Visible = false
		beam.Enabled = false
		marker.Enabled = false
		return
	end
	panel.Visible = true
	stepLabel.Text = t("tut.step", { i = index, n = #STEPS })
	text.Text = t(st.key)
	stepStarted = os.clock()
end

local function advance()
	index += 1
	if index > #STEPS then
		index = -1
		save()
		panel.Visible = false
		beam.Enabled = false
		marker.Enabled = false
		return
	end
	if STEPS[index].key == "tut.serve" or STEPS[index].key == "tut.order" then
		local s = Core.C.Data.w("stats")
		Tutorial.dishesAtStart = s and s.dishes or 0
	end
	save()
	show()
end

function Tutorial.onAction(kind, hands)
	local st = STEPS[index]
	if not st or not st.action then
		return
	end
	if st.action ~= kind then
		return
	end
	if st.hands == "ing" and hands ~= "ing" then
		return
	end
	advance()
end

function Tutorial.restart()
	index = 1
	show()
end

function Tutorial.Init()
	local gui = Core.C.UI.root()
	panel = Kit.panel({ AnchorPoint = Vector2.new(0, 0), Position = UDim2.fromOffset(12, 112), Size = UDim2.fromOffset(330, 150), Visible = false, Parent = gui })
	Kit.padding(12, 10).Parent = panel
	stepLabel = Kit.label("", { Parent = panel, Size = UDim2.new(1, 0, 0, 20), TextSize = 14, TextColor3 = T.muted, FontFace = T.bold })
	text = Kit.label("", { Parent = panel, Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, 0, 1, -62), TextSize = 17, TextYAlignment = Enum.TextYAlignment.Top })
	Kit.button(t("ui.skip"), { parent = panel, size = UDim2.fromOffset(90, 30), position = UDim2.new(1, -90, 1, -32), style = "plain", textSize = 14, onClick = function()
		index = -1
		save()
		panel.Visible = false
		beam.Enabled = false
		marker.Enabled = false
	end })
	Kit.button(t("ui.next"), { parent = panel, size = UDim2.fromOffset(90, 30), position = UDim2.new(1, -186, 1, -32), style = "gold", textSize = 14, onClick = function()
		advance()
	end })
	a0 = Instance.new("Attachment")
	a1 = Instance.new("Attachment")
	beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Width0 = 0.6
	beam.Width1 = 0.6
	beam.FaceCamera = true
	beam.Color = ColorSequence.new(Color.hex("#FFD23B"))
	beam.LightEmission = 1
	beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	beam.TextureMode = Enum.TextureMode.Wrap
	beam.TextureSpeed = 2
	beam.Enabled = false
	marker = Instance.new("BillboardGui")
	marker.Size = UDim2.fromOffset(60, 60)
	marker.StudsOffsetWorldSpace = Vector3.new(0, 5, 0)
	marker.AlwaysOnTop = true
	marker.Enabled = false
	marker.Parent = player.PlayerGui
	local arrow = Instance.new("TextLabel")
	arrow.Size = UDim2.fromScale(1, 1)
	arrow.BackgroundTransparency = 1
	arrow.Text = "⬇️"
	arrow.TextScaled = true
	arrow.AutoLocalize = false
	arrow.Parent = marker
end

function Tutorial.Start()
	local Data = Core.C.Data
	if not Data.ready then
		Data.Ready:Wait()
	end
	local meta = Data.m("meta")
	index = meta and meta.tutorial or 0
	if index == 0 then
		index = 1
	end
	if index > 0 and Data.role() == "owner" then
		show()
	else
		index = -1
	end
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.Transparency = 1
	holder.Size = Vector3.new(0.2, 0.2, 0.2)
	holder.Parent = workspace.CurrentCamera
	a1.Parent = holder
	-- offline earnings popup
	if meta and (meta.offlinePending or 0) > 0 then
		Core.C.UI.open("Offline")
	end
	while true do
		task.wait(0.25)
		local st = STEPS[index]
		if st then
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if root and a0.Parent ~= root then
				a0.Parent = root
			end
			local target = st.target and findTarget(st.target)
			if target then
				holder.Position = target:GetPivot().Position + Vector3.new(0, 2, 0)
				marker.Adornee = holder
				beam.Parent = holder
				beam.Enabled = true
				marker.Enabled = true
			else
				beam.Enabled = false
				marker.Enabled = false
			end
			if st.check and st.check() then
				advance()
			elseif st.timer and os.clock() - stepStarted > st.timer then
				advance()
			end
		end
	end
end

return Tutorial
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000101"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Screen manager, toasts and shared UI helpers.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Kit = require(script.Parent.Parent.UI.Kit)
local Core = require(script.Parent.Parent.Core)

local UI = {}
UI.screens = {}
UI.current = nil
local T = Kit.Theme
local toastHolder

function UI.root()
	return UI.gui
end

function UI.isTouch()
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

function UI.register(name, screen)
	UI.screens[name] = screen
	if screen.create then
		local ok, err = pcall(screen.create, UI.gui)
		if not ok then
			warn("[UI] create " .. name .. " failed: " .. tostring(err))
		end
	end
end

function UI.open(name, arg)
	local s = UI.screens[name]
	if not s then
		return
	end
	if s.modal ~= false and UI.current and UI.current ~= name then
		UI.close(UI.current)
	end
	if s.modal ~= false then
		UI.current = name
	end
	local ok, err = pcall(s.open, arg)
	if not ok then
		warn("[UI] open " .. name .. ": " .. tostring(err))
	end
end

function UI.close(name)
	name = name or UI.current
	local s = name and UI.screens[name]
	if s and s.close then
		pcall(s.close)
	end
	if UI.current == name then
		UI.current = nil
	end
end

function UI.toggle(name, arg)
	if UI.current == name then
		UI.close(name)
	else
		UI.open(name, arg)
	end
end

function UI.refreshAll()
	for name, s in pairs(UI.screens) do
		if s.refresh and (s.visible == nil or s.visible()) then
			local ok, err = pcall(s.refresh)
			if not ok then
				warn("[UI] refresh " .. name .. ": " .. tostring(err))
			end
		end
	end
end

local KIND_COLOR = { info = T.wood, success = T.green, error = T.red, warning = T.gold, level = T.gold }

function UI.toast(text, kind)
	if not toastHolder then
		return
	end
	local f = Kit.panel({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.paper, Parent = toastHolder })
	f:FindFirstChildOfClass("UIStroke").Color = KIND_COLOR[kind] or T.wood
	Kit.padding(10, 6).Parent = f
	Kit.label(text, { Parent = f, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 18, FontFace = T.bold, TextColor3 = kind == "error" and T.red or T.ink })
	task.delay(kind == "level" and 5 or 3.2, function()
		if f.Parent then
			TweenService:Create(f, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
			for _, d in ipairs(f:GetDescendants()) do
				if d:IsA("TextLabel") then
					TweenService:Create(d, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
				elseif d:IsA("UIStroke") then
					TweenService:Create(d, TweenInfo.new(0.3), { Transparency = 1 }):Play()
				end
			end
			task.wait(0.35)
			f:Destroy()
		end
	end)
	local items = {}
	for _, c in ipairs(toastHolder:GetChildren()) do
		if c:IsA("Frame") then
			table.insert(items, c)
		end
	end
	if #items > 5 then
		items[1]:Destroy()
	end
end

function UI.Init()
	local pg = Players.LocalPlayer:WaitForChild("PlayerGui")
	UI.gui = Kit.new("ScreenGui", { Name = "RamenUI", ResetOnSpawn = false, IgnoreGuiInset = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = pg })
	local scale = Kit.new("UIScale", { Parent = UI.gui })
	local function rescale()
		local cam = workspace.CurrentCamera
		local v = cam and cam.ViewportSize or Vector2.new(1280, 720)
		scale.Scale = math.clamp(math.min(v.X / 1280, v.Y / 760) * 1.05, 0.55, 1.25)
	end
	rescale()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	end
	toastHolder = Kit.new("Frame", { Name = "Toasts", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 86), Size = UDim2.fromOffset(460, 300), Parent = UI.gui }, { Kit.list(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center) })
	local screens = script.Parent.Parent.UI.Screens
	for _, m in ipairs(screens:GetChildren()) do
		if m:IsA("ModuleScript") then
			local ok, s = pcall(require, m)
			if ok then
				Core.Screens[m.Name] = s
			else
				warn("[UI] screen " .. m.Name .. ": " .. tostring(s))
			end
		end
	end
	for name, s in pairs(Core.Screens) do
		UI.register(name, s)
	end
	NetDef.event("Notify").OnClientEvent:Connect(function(key, params, kind)
		UI.toast(Locale.t(key, params), kind)
		if kind == "error" and Core.C.Audio then
			Core.C.Audio.play("error")
		end
	end)
	Locale.Changed:Connect(UI.refreshAll)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
			if UI.current then
				UI.close(UI.current)
			end
		end
	end)
end

local function vipChat()
	local TextChatService = game:GetService("TextChatService")
	pcall(function()
		TextChatService.OnIncomingMessage = function(message)
			local props = Instance.new("TextChatMessageProperties")
			local source = message.TextSource
			local p = source and Players:GetPlayerByUserId(source.UserId)
			if p and p:GetAttribute("VIP") then
				props.PrefixText = "<font color=\"#D4A23C\">[VIP]</font> " .. message.PrefixText
			end
			return props
		end
	end)
end

function UI.Start()
	vipChat()
	local Data = Core.C.Data
	Data.Changed:Connect(function()
		UI.refreshAll()
	end)
	Data.SessionChanged:Connect(UI.refreshAll)
	Data.DayChanged:Connect(function(state)
		local hud = UI.screens.HUD
		if hud and hud.day then
			hud.day(state)
		end
		if state.phase == "report" and state.report then
			UI.open("DayReport", state.report)
		end
	end)
	UI.refreshAll()
end

return UI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000102"><Properties><string name="Name">WorldUI</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Localized billboards over customers (order + patience), stations (board / next step),
-- rice cookers & pots, shelf slots, dirty dishes and staff name tags.
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Locale = require(Shared.Locale)
local Recipes = require(Shared.Config.Recipes)
local Ingredients = require(Shared.Config.Ingredients)
local Color = require(Shared.Util.Color)
local Core = require(script.Parent.Parent.Core)

local WorldUI = {}
local player = Players.LocalPlayer
local t = Locale.t
local boards = {} -- [Instance] = { gui, title, sub, bar, fill }

local RANGE = 45
local TYPE_ICON = { cust_critic = "🧐", cust_influencer = "📱", cust_vip = "💎", cust_celebrity = "⭐" }

local function make(adornee, height, width)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(width or 170, 58)
	gui.StudsOffsetWorldSpace = Vector3.new(0, height or 3, 0)
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.MaxDistance = RANGE
	gui.Adornee = adornee
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color.hex("#F4EBDD")
	bg.BackgroundTransparency = 0.05
	bg.Parent = gui
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 12)
	c.Parent = bg
	local s = Instance.new("UIStroke")
	s.Color = Color.hex("#5B3A24")
	s.Thickness = 2
	s.Parent = bg
	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Size = UDim2.new(1, -8, 0.55, 0)
	title.Position = UDim2.fromOffset(4, 2)
	title.TextScaled = true
	title.FontFace = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold)
	title.TextColor3 = Color.hex("#2B2320")
	title.AutoLocalize = false
	title.Parent = bg
	local sub = Instance.new("TextLabel")
	sub.BackgroundTransparency = 1
	sub.Size = UDim2.new(1, -8, 0.32, 0)
	sub.Position = UDim2.new(0, 4, 0.56, 0)
	sub.TextScaled = true
	sub.FontFace = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Medium)
	sub.TextColor3 = Color.hex("#7A6A5A")
	sub.AutoLocalize = false
	sub.Parent = bg
	local bar = Instance.new("Frame")
	bar.BackgroundColor3 = Color.hex("#E6D7BF")
	bar.Size = UDim2.new(1, -16, 0, 6)
	bar.Position = UDim2.new(0, 8, 1, -9)
	bar.Visible = false
	bar.Parent = bg
	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = Color.hex("#5E8F3A")
	fill.Size = UDim2.fromScale(1, 1)
	fill.Parent = bar
	gui.Parent = player.PlayerGui
	return { gui = gui, bg = bg, title = title, sub = sub, bar = bar, fill = fill }
end

local function icons(list)
	local out = {}
	for _, g in ipairs(list) do
		local ing = Ingredients.byId[g]
		table.insert(out, ing and ing.icon or "?")
	end
	return table.concat(out, " ")
end

local function setBar(b, value, show)
	b.bar.Visible = show
	if show then
		b.fill.Size = UDim2.fromScale(math.clamp(value, 0, 1), 1)
		b.fill.BackgroundColor3 = value > 0.5 and Color.hex("#5E8F3A") or (value > 0.25 and Color.hex("#D4A23C") or Color.hex("#B3262E"))
	end
end

local function updateEntity(model, b)
	local kind = model:GetAttribute("Kind")
	local now = workspace:GetServerTimeNow()
	b.gui.Enabled = true
	if kind == "customer" then
		local state = model:GetAttribute("State") or ""
		local order = model:GetAttribute("Order") or ""
		local typeIcon = TYPE_ICON[model:GetAttribute("Type") or ""] or ""
		local r = Recipes.byId[order]
		if state == "order" then
			b.title.Text = typeIcon .. " ❗ " .. t("ui.wants_order")
			b.sub.Text = t("hint.take_order")
		elseif state == "waiting" then
			b.title.Text = typeIcon .. " " .. (r and r.icon or "🍽️") .. " " .. t("rec." .. order)
			b.sub.Text = t("ui.waiting")
		elseif state == "eating" or state == "served" then
			b.title.Text = "😋"
			b.sub.Text = ""
		elseif state == "queue" then
			b.title.Text = "⏳"
			b.sub.Text = t("ui.queue")
		else
			b.gui.Enabled = false
		end
		setBar(b, model:GetAttribute("Patience") or 1, state == "order" or state == "waiting")
		b.gui.StudsOffsetWorldSpace = Vector3.new(0, 3.6, 0)
	elseif kind == "station" then
		local ready = model:GetAttribute("Ready") or ""
		local board = model:GetAttribute("Board") or ""
		local recipe = model:GetAttribute("Recipe") or ""
		if ready ~= "" then
			b.title.Text = "✅ " .. t("rec." .. ready)
			b.sub.Text = t("ui.ready_to_serve")
		elseif recipe ~= "" then
			local steps = string.split(model:GetAttribute("Steps") or "", ",")
			local idx = (model:GetAttribute("Step") or 0) + 1
			b.title.Text = (Recipes.byId[recipe] and Recipes.byId[recipe].icon or "") .. " " .. t("rec." .. recipe)
			b.sub.Text = (model:GetAttribute("Busy") and "⏳ " or "👆 ") .. t("step." .. (steps[idx] or "combine")) .. " (" .. idx .. "/" .. #steps .. ")"
		elseif board ~= "" then
			b.title.Text = icons(string.split(board, ","))
			b.sub.Text = t("ui.board_incomplete")
		else
			b.gui.Enabled = false
		end
		b.bar.Visible = false
	elseif kind == "ricecooker" or kind == "pot" then
		local n, c, batch = model:GetAttribute("N") or 0, model:GetAttribute("C") or 0, model:GetAttribute("Batch") or 0
		local g = model:GetAttribute("G") or ""
		local icon = kind == "ricecooker" and "🍚" or "🥣"
		local name = g ~= "" and t("ing." .. g) or t(kind == "ricecooker" and "ui.rice_cooker" or "ui.pot")
		b.title.Text = icon .. " " .. name
		if c > 0 then
			local remaining = math.max(0, (model:GetAttribute("T") or now) - now)
			local total = model:GetAttribute("Time") or 1
			b.sub.Text = "⏳ " .. math.ceil(remaining) .. "s  (+" .. c .. ")"
			setBar(b, 1 - remaining / total, true)
			b.fill.BackgroundColor3 = Color.hex("#2E5A8C")
		else
			b.sub.Text = n .. " / " .. batch .. (n == 0 and ("  ·  " .. t("ui.empty")) or "")
			setBar(b, n / math.max(1, batch), true)
		end
	elseif kind == "dirty" then
		b.title.Text = "🧽"
		b.sub.Text = t("hint.collect")
		b.bar.Visible = false
	elseif kind == "dishwasher" then
		local q = model:GetAttribute("Queue") or 0
		b.gui.Enabled = q > 0
		b.title.Text = "🫧 " .. q
		b.sub.Text = t("ui.washing")
	else
		b.gui.Enabled = false
	end
end

local slotBoards = {}

local function updateShelf(model, near)
	for _, part in ipairs(model:GetChildren()) do
		if part:IsA("BasePart") and part:GetAttribute("Slot") then
			local b = slotBoards[part]
			if near then
				if not b then
					b = Instance.new("BillboardGui")
					b.Size = UDim2.fromOffset(70, 26)
					b.StudsOffsetWorldSpace = Vector3.new(0, part.Size.Y / 2 - 0.1, -0.4)
					b.LightInfluence = 0
					b.MaxDistance = 18
					b.Adornee = part
					local l = Instance.new("TextLabel")
					l.Name = "L"
					l.Size = UDim2.fromScale(1, 1)
					l.BackgroundColor3 = Color.hex("#2B2320")
					l.BackgroundTransparency = 0.25
					l.TextColor3 = Color.hex("#F4EBDD")
					l.TextScaled = true
					l.FontFace = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold)
					l.AutoLocalize = false
					l.Parent = b
					b.Parent = player.PlayerGui
					slotBoards[part] = b
				end
				local g = part:GetAttribute("G") or ""
				local ing = Ingredients.byId[g]
				b.L.Text = g ~= "" and ((ing and ing.icon or "") .. " " .. (part:GetAttribute("N") or 0) .. "/" .. (part:GetAttribute("Cap") or 0)) or "—"
				b.Enabled = true
			elseif b then
				b.Enabled = false
			end
		end
	end
end

local staffTags = {}

local function updateStaff(char, origin)
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local b = staffTags[char]
	if not b then
		b = make(char:FindFirstChild("Head") or root, 1.8, 150)
		b.gui.Size = UDim2.fromOffset(150, 40)
		staffTags[char] = b
	end
	local near = (root.Position - origin).Magnitude < RANGE
	b.gui.Enabled = near
	if near then
		b.title.Text = char:GetAttribute("StaffName") or ""
		b.sub.Text = t("staff." .. (char:GetAttribute("StaffRole") or "staff_waiter")) .. " · Lv" .. (char:GetAttribute("StaffLevel") or 1)
	end
end

function WorldUI.Start()
	while true do
		task.wait(0.2)
		local cam = workspace.CurrentCamera
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local origin = root and root.Position or (cam and cam.CFrame.Position) or Vector3.new()
		local alive = {}
		for _, model in ipairs(CollectionService:GetTagged("Interactable")) do
			if model:IsDescendantOf(workspace) then
				local kind = model:GetAttribute("Kind")
				local pos = model:GetPivot().Position
				local near = (pos - origin).Magnitude < RANGE
				if kind == "shelf" then
					updateShelf(model, (pos - origin).Magnitude < 18)
				elseif near and (kind == "customer" or kind == "station" or kind == "ricecooker" or kind == "pot" or kind == "dirty" or kind == "dishwasher") then
					local b = boards[model]
					if not b then
						local adornee = model:FindFirstChild("Head") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
						b = make(adornee, kind == "station" and 3 or 2.5)
						boards[model] = b
					end
					alive[model] = true
					local ok = pcall(updateEntity, model, b)
					if not ok then
						b.gui.Enabled = false
					end
				end
			end
		end
		for model, b in pairs(boards) do
			if not alive[model] then
				b.gui:Destroy()
				boards[model] = nil
			end
		end
		for part, b in pairs(slotBoards) do
			if not part:IsDescendantOf(workspace) then
				b:Destroy()
				slotBoards[part] = nil
			end
		end
		local npcs = workspace:FindFirstChild("NPCs")
		if npcs then
			for _, m in ipairs(npcs:GetChildren()) do
				if m:GetAttribute("StaffName") then
					updateStaff(m, origin)
				end
			end
		end
		for m, b in pairs(staffTags) do
			if not m:IsDescendantOf(workspace) then
				b.gui:Destroy()
				staffTags[m] = nil
			end
		end
	end
end

return WorldUI
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX000104"><Properties><string name="Name">Core</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Shared registry of client controllers and UI screens.
return {
	C = {},
	Screens = {},
}
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX000105"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Client entry point.
if not game:IsLoaded() then
	game.Loaded:Wait()
end

local Core = require(script.Parent.Core)
local Controllers = script.Parent.Controllers

local ORDER = {
	"Data", "Audio", "UI", "Lighting", "Ambient", "WorldUI", "Camera", "Interaction", "Build", "Tutorial", "Effects",
}

for _, name in ipairs(ORDER) do
	local m = Controllers:FindFirstChild(name)
	if m then
		local ok, c = pcall(require, m)
		if ok then
			Core.C[name] = c
		else
			warn("[Client] failed to load " .. name .. ": " .. tostring(c))
		end
	end
end

for _, name in ipairs(ORDER) do
	local c = Core.C[name]
	if c and c.Init then
		local ok, err = pcall(c.Init)
		if not ok then
			warn("[Client] " .. name .. ".Init failed: " .. tostring(err))
		end
	end
end

for _, name in ipairs(ORDER) do
	local c = Core.C[name]
	if c and c.Start then
		task.spawn(function()
			local ok, err = pcall(c.Start)
			if not ok then
				warn("[Client] " .. name .. ".Start failed: " .. tostring(err))
			end
		end)
	end
end
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX000125"><Properties><string name="Name">UI</string></Properties><Item class="ModuleScript" referent="RBX000106"><Properties><string name="Name">Base</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Helper to build standard modal screens: Base.make(name, titleKey, size, render)
-- render(content, screen) rebuilds the content each refresh.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Locale = require(Shared.Locale)
local Kit = require(script.Parent.Kit)

local Base = {}

function Base.make(name, titleKey, size, render)
	local s = { name = name }
	function s.create(root)
		s.win = Kit.window(root, size, Locale.t(titleKey), function()
			local Core = require(script.Parent.Parent.Core)
			Core.C.UI.close(name)
		end)
	end
	function s.visible()
		return s.win ~= nil and s.win.frame.Visible
	end
	function s.refresh()
		if not s.win then
			return
		end
		s.win.title.Text = Locale.t(titleKey)
		Kit.clear(s.win.content)
		local ok, err = pcall(render, s.win.content, s)
		if not ok then
			warn("[UI] " .. name .. ": " .. tostring(err))
		end
	end
	function s.open(arg)
		s.arg = arg
		s.win.frame.Visible = true
		s.refresh()
	end
	function s.close()
		if s.win then
			s.win.frame.Visible = false
		end
	end
	return s
end

return Base
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000107"><Properties><string name="Name">Icons</string><ProtectedString name="Source"><![CDATA[--!nonstrict
