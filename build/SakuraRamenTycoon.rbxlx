]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000108"><Properties><string name="Name">Kit</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Tiny declarative UI toolkit + the visual theme (washi paper, dark wood, lacquer red, gold).
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Color = require(Shared.Util.Color)
local Locale = require(Shared.Locale)

local Kit = {}

Kit.Theme = {
	paper = Color.hex("#F4EBDD"),
	paperDark = Color.hex("#E6D7BF"),
	wood = Color.hex("#5B3A24"),
	woodLight = Color.hex("#8A5A36"),
	ink = Color.hex("#2B2320"),
	muted = Color.hex("#7A6A5A"),
	red = Color.hex("#B3262E"),
	redDark = Color.hex("#7A1A1F"),
	gold = Color.hex("#D4A23C"),
	green = Color.hex("#5E8F3A"),
	blue = Color.hex("#2E5A8C"),
	white = Color.hex("#FFFFFF"),
	shadow = Color.hex("#000000"),
	locked = Color.hex("#B8AFA2"),
	title = Font.new("rbxasset://fonts/families/FredokaOne.json"),
	body = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Medium),
	bold = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold),
}
local T = Kit.Theme

function Kit.T(key, params)
	return Locale.t(key, params)
end

-- Kit.new("Frame", { props }, { children })
function Kit.new(class, props, children)
	local inst = Instance.new(class)
	local parent = nil
	for k, v in pairs(props or {}) do
		if k == "Parent" then
			parent = v
		elseif type(k) == "string" and string.sub(k, 1, 2) == "On" and type(v) == "function" then
			local event = string.sub(k, 3)
			inst[event]:Connect(v)
		else
			inst[k] = v
		end
	end
	if inst:IsA("GuiObject") and props and props.BorderSizePixel == nil then
		inst.BorderSizePixel = 0
	end
	if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
		inst.AutoLocalize = false
		if not (props and props.FontFace) then
			inst.FontFace = T.body
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Kit.corner(r)
	return Kit.new("UICorner", { CornerRadius = UDim.new(0, r or 10) })
end

function Kit.stroke(color, thickness, transparency)
	return Kit.new("UIStroke", { Color = color or T.wood, Thickness = thickness or 2, Transparency = transparency or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

function Kit.padding(px, py)
	py = py or px
	return Kit.new("UIPadding", { PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px), PaddingTop = UDim.new(0, py), PaddingBottom = UDim.new(0, py) })
end

function Kit.list(direction, pad, halign, valign)
	return Kit.new("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, pad or 6),
		HorizontalAlignment = halign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = valign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function Kit.grid(cellW, cellH, pad)
	return Kit.new("UIGridLayout", { CellSize = UDim2.fromOffset(cellW, cellH), CellPadding = UDim2.fromOffset(pad or 8, pad or 8), SortOrder = Enum.SortOrder.LayoutOrder })
end

function Kit.label(text, props)
	props = props or {}
	local base = {
		BackgroundTransparency = 1,
		Text = text or "",
		TextColor3 = T.ink,
		TextSize = 18,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 22),
	}
	for k, v in pairs(props) do
		base[k] = v
	end
	return Kit.new("TextLabel", base)
end

function Kit.title(text, props)
	props = props or {}
	props.FontFace = T.title
	props.TextSize = props.TextSize or 24
	props.TextColor3 = props.TextColor3 or T.wood
	return Kit.label(text, props)
end

-- Button styles: "primary" (red), "gold", "green", "plain", "dark"
function Kit.button(text, opts)
	opts = opts or {}
	local style = opts.style or "primary"
	local bg = ({ primary = T.red, gold = T.gold, green = T.green, plain = T.paperDark, dark = T.wood, blue = T.blue })[style] or T.red
	local fg = (style == "plain" or style == "gold") and T.ink or T.white
	local b = Kit.new("TextButton", {
		Text = text,
		Size = opts.size or UDim2.fromOffset(140, 40),
		BackgroundColor3 = bg,
		TextColor3 = fg,
		TextSize = opts.textSize or 18,
		FontFace = T.bold,
		AutoButtonColor = true,
		LayoutOrder = opts.order or 0,
		Position = opts.position,
		AnchorPoint = opts.anchor,
		TextWrapped = true,
	}, {
		Kit.corner(opts.radius or 10),
		Kit.stroke(style == "plain" and T.woodLight or Color3.new(0, 0, 0), 2, style == "plain" and 0 or 0.7),
		Kit.sheen(),
	})
	if opts.disabled then
		b.BackgroundColor3 = T.locked
		b.AutoButtonColor = false
		b.TextColor3 = T.muted
	end
	if opts.onClick then
		b.MouseButton1Click:Connect(function()
			if not opts.disabled then
				local Core = require(script.Parent.Parent.Core)
				if Core.C.Audio then
					Core.C.Audio.play("ui")
				end
				opts.onClick()
			end
		end)
	end
	if opts.parent then
		b.Parent = opts.parent
	end
	return b
end

-- Soft top-lit gradient so flat colours read like lacquer
function Kit.sheen(amount)
	local a = amount or 0.82
	return Kit.new("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.new(a, a, a)),
		Rotation = 90,
	})
end

-- Washi panel framed like a lacquer box (dark wood edge, soft paper gradient)
function Kit.panel(props, children)
	local base = { BackgroundColor3 = T.paper, Size = UDim2.fromScale(1, 1) }
	for k, v in pairs(props or {}) do
		base[k] = v
	end
	local f = Kit.new("Frame", base, children)
	Kit.corner(12).Parent = f
	Kit.stroke(T.wood, 3).Parent = f
	Kit.new("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.new(0.94, 0.92, 0.88)), Rotation = 90, Parent = f })
	return f
end

-- Thin inner gold line (only for frames without UIPadding, which would shift it)
function Kit.goldLine(parent, inset)
	local i = inset or 5
	return Kit.new("Frame", {
		Name = "GoldLine",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(i, i),
		Size = UDim2.new(1, -2 * i, 1, -2 * i),
		ZIndex = 0,
		Active = false,
		Parent = parent,
	}, { Kit.corner(9), Kit.stroke(T.gold, 1, 0.35) })
end

function Kit.card(props, children)
	local base = { BackgroundColor3 = Color.hex("#FBF5EA"), Size = UDim2.new(1, 0, 0, 80) }
	for k, v in pairs(props or {}) do
		base[k] = v
	end
	local f = Kit.new("Frame", base, children)
	Kit.corner(10).Parent = f
	Kit.stroke(T.paperDark, 2).Parent = f
	return f
end

-- Scrolling container with automatic canvas size
function Kit.scroll(props, layout)
	local base = {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = T.woodLight,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		ScrollingDirection = Enum.ScrollingDirection.Y,
	}
	for k, v in pairs(props or {}) do
		base[k] = v
	end
	local s = Kit.new("ScrollingFrame", base)
	local l = layout or Kit.list(Enum.FillDirection.Vertical, 8)
	l.Parent = s
	Kit.padding(6).Parent = s
	return s
end

function Kit.bar(value, color, props)
	local base = { BackgroundColor3 = T.paperDark, Size = UDim2.new(1, 0, 0, 10) }
	for k, v in pairs(props or {}) do
		base[k] = v
	end
	local bg = Kit.new("Frame", base, { Kit.corner(5) })
	local fill = Kit.new("Frame", { BackgroundColor3 = color or T.green, Size = UDim2.fromScale(math.clamp(value or 0, 0, 1), 1), Name = "Fill" }, { Kit.corner(5) })
	fill.Parent = bg
	return bg, fill
end

function Kit.clear(container)
	for _, c in ipairs(container:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
end

-- Standard modal window. Returns { frame, content, title }
function Kit.window(parent, size, titleText, onClose)
	local frame = Kit.panel({
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = size or UDim2.fromScale(0.62, 0.72),
		Visible = false,
		Parent = parent,
	})
	Kit.new("UISizeConstraint", { MaxSize = Vector2.new(980, 720), MinSize = Vector2.new(320, 260), Parent = frame })
	Kit.goldLine(frame, 5)
	local header = Kit.new("Frame", { BackgroundColor3 = T.wood, Size = UDim2.new(1, 0, 0, 48), Parent = frame }, { Kit.corner(10), Kit.sheen(0.7) })
	-- lacquer red and gold trim under the header, and a little red seal before the title
	Kit.new("Frame", { BackgroundColor3 = T.red, BorderSizePixel = 0, Position = UDim2.new(0, 6, 0, 44), Size = UDim2.new(1, -12, 0, 4), Parent = header })
	Kit.new("Frame", { BackgroundColor3 = T.gold, BorderSizePixel = 0, Position = UDim2.new(0, 6, 0, 48), Size = UDim2.new(1, -12, 0, 2), Parent = header })
	local seal = Kit.new("Frame", { BackgroundColor3 = T.red, Size = UDim2.fromOffset(30, 30), Position = UDim2.fromOffset(12, 8), Rotation = -4, Parent = header }, { Kit.corner(6), Kit.stroke(T.gold, 1, 0.2) })
	Kit.new("TextLabel", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = "和", TextScaled = true, TextColor3 = T.paper, FontFace = T.title, AutoLocalize = false, Parent = seal })
	local title = Kit.title(titleText or "", { Parent = header, Size = UDim2.new(1, -150, 1, 0), Position = UDim2.fromOffset(52, 0), TextColor3 = T.paper, TextSize = 24, TextYAlignment = Enum.TextYAlignment.Center })
	title.TextStrokeTransparency = 0.7
	Kit.button("✕", { parent = header, size = UDim2.fromOffset(38, 38), position = UDim2.new(1, -44, 0, 5), style = "primary", onClick = onClose })
	local content = Kit.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 56), Size = UDim2.new(1, -24, 1, -66), Parent = frame, Name = "Content" })
	return { frame = frame, content = content, title = title }
end

-- Tabs row; returns the row frame. tabs = { {id, label} }, onSelect(id)
function Kit.tabs(parent, tabs, onSelect, current)
	local row = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), Parent = parent }, { Kit.list(Enum.FillDirection.Horizontal, 6) })
	local buttons = {}
	local function paint(sel)
		for id, b in pairs(buttons) do
			b.BackgroundColor3 = id == sel and T.red or T.paperDark
			b.TextColor3 = id == sel and T.white or T.ink
		end
	end
	for i, t in ipairs(tabs) do
		local b = Kit.button(t.label, { size = UDim2.fromOffset(t.width or 130, 36), style = "plain", order = i, textSize = 16 })
		b.Parent = row
		buttons[t.id] = b
		b.MouseButton1Click:Connect(function()
			paint(t.id)
			onSelect(t.id)
		end)
	end
	paint(current or (tabs[1] and tabs[1].id))
	return row, paint
end

-- Row with an emoji icon, title, subtitle and a right side area. Returns card, right
function Kit.row(icon, titleText, subtitle, height)
	local card = Kit.card({ Size = UDim2.new(1, -8, 0, height or 72) })
	-- red accent along the left edge of every list row
	Kit.new("Frame", { BackgroundColor3 = T.red, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 10), Size = UDim2.new(0, 4, 1, -20), Parent = card }, { Kit.corner(2) })
	Kit.label(icon or "", { Parent = card, Size = UDim2.fromOffset(52, 52), Position = UDim2.fromOffset(10, ((height or 72) - 52) / 2), TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center })
	Kit.label(titleText or "", { Parent = card, Position = UDim2.fromOffset(70, 8), Size = UDim2.new(1, -250, 0, 24), FontFace = T.bold, TextSize = 19, TextTruncate = Enum.TextTruncate.AtEnd })
	Kit.label(subtitle or "", { Parent = card, Position = UDim2.fromOffset(70, 32), Size = UDim2.new(1, -250, 0, (height or 72) - 38), TextSize = 15, TextColor3 = T.muted, TextYAlignment = Enum.TextYAlignment.Top })
	local right = Kit.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(170, (height or 72) - 16), Parent = card }, { Kit.list(Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center) })
	return card, right
end

return Kit
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX000124"><Properties><string name="Name">Screens</string></Properties><Item class="ModuleScript" referent="RBX000109"><Properties><string name="Name">Build</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Build panel: catalog by category, inventory, floor/wall styles, grid & rotation tools,
-- selection actions (move / rotate / store / sell).
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Format = require(Shared.Util.Format)
local Items = require(Shared.Config.Items)
local Surfaces = require(Shared.Config.Surfaces)
local Events = require(Shared.Config.Events)
local GameConfig = require(Shared.Config.GameConfig)
local Footprint = require(Shared.Logic.Footprint)
local Kit = require(script.Parent.Parent.Kit)
local Icons = require(script.Parent.Parent.Icons)
local Core = require(script.Parent.Parent.Parent.Core)

local Screen = { modal = false }
local T = Kit.Theme
local t = Locale.t
local refs = {}
local category = "seating"

local function visibleItem(w, item)
	if item.event then
		local ev = Events.active(workspace:GetServerTimeNow())
		return ev and ev.id == item.event
	end
	if item.franchise then
		return w.franchise and w.franchise.cities and w.franchise.cities[item.franchise]
	end
	return true
end

local function itemLocked(w, item)
	if (w.level or 1) < (item.lv or 1) then
		return true, t("ui.req_level", { level = item.lv })
	end
	if item.license and not (w.licenses and w.licenses[item.license]) then
		return true, "🔒 " .. t("lic." .. item.license)
	end
	return false
end

local function zoneHere()
	local char = Players.LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return nil
	end
	local geo = Core.C.Build.geometry()
	local f = math.floor((hrp.Position.Y + 2) / GameConfig.FloorHeight)
	for _, z in ipairs(geo.zones) do
		if z.floor == f and not z.outdoor and Footprint.pointInRect(hrp.Position.X, hrp.Position.Z, z.rect) then
			return z
		end
	end
	return nil
end

function Screen.create(root)
	local frame = Kit.panel({ Name = "BuildPanel", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -96), Size = UDim2.new(0.96, 0, 0, 250), Visible = false, Parent = root })
	refs.frame = frame
	refs.tabs = Kit.new("ScrollingFrame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(8, 6), Size = UDim2.new(1, -330, 0, 44), ScrollingDirection = Enum.ScrollingDirection.X, AutomaticCanvasSize = Enum.AutomaticSize.X, CanvasSize = UDim2.new(), ScrollBarThickness = 3, Parent = frame }, { Kit.list(Enum.FillDirection.Horizontal, 4) })
	refs.items = Kit.new("ScrollingFrame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(8, 54), Size = UDim2.new(1, -330, 1, -60), ScrollingDirection = Enum.ScrollingDirection.X, AutomaticCanvasSize = Enum.AutomaticSize.X, CanvasSize = UDim2.new(), ScrollBarThickness = 6, Parent = frame }, { Kit.list(Enum.FillDirection.Horizontal, 8) })
	local tools = Kit.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 6), Size = UDim2.fromOffset(310, 238), Parent = frame })
	refs.tools = tools
	refs.status = Kit.label("", { Parent = tools, Size = UDim2.new(1, 0, 0, 40), TextSize = 15, FontFace = T.bold, TextYAlignment = Enum.TextYAlignment.Top })
	local gridRow = Kit.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 42), Size = UDim2.new(1, 0, 0, 36), Parent = tools }, { Kit.list(Enum.FillDirection.Horizontal, 4) })
	refs.gridLabel = Kit.label("", { Parent = gridRow, Size = UDim2.fromOffset(70, 34), TextSize = 15, FontFace = T.bold, LayoutOrder = 0 })
	refs.gridButtons = {}
	for i, g in ipairs(GameConfig.GridSizes) do
		refs.gridButtons[g] = Kit.button(tostring(g), { parent = gridRow, size = UDim2.fromOffset(48, 34), style = "plain", order = i, onClick = function()
			Core.C.Build.setGrid(g)
		end })
	end
	Kit.button("🔄", { parent = gridRow, size = UDim2.fromOffset(48, 34), style = "dark", order = 5, onClick = function()
		Core.C.Build.rotate()
	end })
	local actRow = Kit.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 82), Size = UDim2.new(1, 0, 0, 80), Parent = tools }, { Kit.grid(150, 36, 6) })
	refs.actions = actRow
	local bottom = Kit.new("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 1, -40), Size = UDim2.new(1, 0, 0, 38), Parent = tools }, { Kit.list(Enum.FillDirection.Horizontal, 6) })
	refs.topView = Kit.button("", { parent = bottom, size = UDim2.fromOffset(150, 36), style = "plain", order = 1, textSize = 15, onClick = function()
		Core.C.Camera.toggleTop()
		Screen.refresh()
	end })
	refs.exit = Kit.button("", { parent = bottom, size = UDim2.fromOffset(150, 36), style = "primary", order = 2, onClick = function()
		Core.C.Build.exit()
	end })
	refs.confirm = Kit.button("✓", { parent = root, size = UDim2.fromOffset(120, 60), position = UDim2.new(1, -140, 1, -420), style = "green", textSize = 30, onClick = function()
		Core.C.Build.place()
	end })
	refs.confirm.Visible = false
	Core.C.Build.Changed:Connect(function()
		if refs.frame.Visible then
			Screen.refreshTools()
		end
	end)
end

local function itemCard(item, order, opts)
	local w = Core.C.Data.world or {}
	local L = Locale.get()
	local locked, why = itemLocked(w, item)
	if opts.inventory then
		locked = false
	end
	local card = Kit.new("TextButton", { Text = "", Size = UDim2.fromOffset(132, 178), BackgroundColor3 = locked and T.paperDark or Color3.fromRGB(251, 245, 234), LayoutOrder = order, Parent = refs.items }, { Kit.corner(10), Kit.stroke(T.woodLight, 2) })
	Kit.label(Icons.forItem(item), { Parent = card, Size = UDim2.new(1, 0, 0, 56), Position = UDim2.fromOffset(0, 6), TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center })
	Kit.label(t("item." .. item.id), { Parent = card, Position = UDim2.fromOffset(6, 64), Size = UDim2.new(1, -12, 0, 40), TextSize = 15, FontFace = T.bold, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top })
	local price
	if opts.inventory then
		price = "×" .. opts.count
	elseif item.sakura then
		price = "🌸" .. item.sakura
	else
		price = Format.yen(item.price, L)
	end
	Kit.label(price, { Parent = card, Position = UDim2.fromOffset(6, 106), Size = UDim2.new(1, -12, 0, 22), TextSize = 16, FontFace = T.title, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = T.wood })
	local info = locked and why or ((item.amb or 0) > 0 and ("✨ " .. item.amb) or (item.fn and item.fn.comfort and ("🪑 " .. item.fn.comfort) or ""))
	Kit.label(info or "", { Parent = card, Position = UDim2.fromOffset(6, 130), Size = UDim2.new(1, -12, 0, 40), TextSize = 13, TextColor3 = T.muted, TextXAlignment = Enum.TextXAlignment.Center })
	card.MouseButton1Click:Connect(function()
		if locked then
			Core.C.UI.toast(why or "", "error")
			return
		end
		Core.C.Build.startPlace(item.id, opts.inventory == true)
	end)
	return card
end

local function renderItems()
	Kit.clear(refs.items)
	local w = Core.C.Data.world or {}
	local L = Locale.get()
	if category == "inventory" then
		local inv = w.inventory or {}
		local order = 0
		for _, item in ipairs(Items.list) do
			local n = inv[item.id] or 0
			if n > 0 then
				order += 1
				itemCard(item, order, { inventory = true, count = n })
			end
		end
		if order == 0 then
			Kit.label(t("ui.inventory_empty"), { Parent = refs.items, Size = UDim2.fromOffset(400, 60), TextSize = 17 })
		end
	elseif category == "surfaces" then
		local zone = zoneHere()
		if not zone then
			Kit.label(t("ui.stand_in_zone"), { Parent = refs.items, Size = UDim2.fromOffset(420, 60), TextSize = 17 })
			return
		end
		Kit.label("📍 " .. t("ui.room", { name = "zone." .. zone.id }), { Parent = refs.items, Size = UDim2.fromOffset(150, 178), TextSize = 17, FontFace = T.bold, LayoutOrder = 0 })
		local current = (w.surfaces and w.surfaces[zone.id]) or {}
		for _, s in ipairs(Surfaces.list) do
			local active = current[s.kind] == s.id or (not current[s.kind] and (s.id == (s.kind == "floor" and (zone.floorStyle or Surfaces.DefaultFloor) or (zone.wallStyle or Surfaces.DefaultWall))))
			local locked = (w.level or 1) < s.lv
			local card = Kit.new("TextButton", { Text = "", Size = UDim2.fromOffset(132, 178), BackgroundColor3 = T.paper, LayoutOrder = s.order, Parent = refs.items }, { Kit.corner(10), Kit.stroke(active and T.gold or T.woodLight, active and 4 or 2) })
			local swatch = Kit.new("Frame", { BackgroundColor3 = require(Shared.Util.Color).hex(s.color), Size = UDim2.new(1, -20, 0, 56), Position = UDim2.fromOffset(10, 10), Parent = card }, { Kit.corner(8) })
			local _ = swatch
			Kit.label((s.kind == "floor" and "⬜ " or "🧱 ") .. t("surf." .. s.id), { Parent = card, Position = UDim2.fromOffset(6, 70), Size = UDim2.new(1, -12, 0, 40), TextSize = 14, FontFace = T.bold, TextXAlignment = Enum.TextXAlignment.Center })
			Kit.label(s.price > 0 and Format.yen(s.price, L) or t("ui.free"), { Parent = card, Position = UDim2.fromOffset(6, 112), Size = UDim2.new(1, -12, 0, 22), TextSize = 16, FontFace = T.title, TextXAlignment = Enum.TextXAlignment.Center })
			Kit.label(locked and t("ui.req_level", { level = s.lv }) or ("✨ " .. math.floor(s.amb)), { Parent = card, Position = UDim2.fromOffset(6, 136), Size = UDim2.new(1, -12, 0, 30), TextSize = 13, TextColor3 = T.muted, TextXAlignment = Enum.TextXAlignment.Center })
			card.MouseButton1Click:Connect(function()
				if not locked then
					NetDef.event("PaintSurface"):FireServer(zone.id, s.kind, s.id)
				end
			end)
		end
	else
		local order = 0
		for _, item in ipairs(Items.list) do
			if item.cat == category and visibleItem(w, item) then
				order += 1
				itemCard(item, item.order, {})
			end
		end
	end
end

local function renderTabs()
	Kit.clear(refs.tabs)
	local tabs = {}
	for _, c in ipairs(Items.Categories) do
		table.insert(tabs, { id = c, label = (Icons.cat[c] or "") .. " " .. t("cat." .. c) })
	end
	table.insert(tabs, { id = "surfaces", label = "🎨 " .. t("ui.surfaces") })
	table.insert(tabs, { id = "inventory", label = "🎒 " .. t("ui.inventory") })
	for i, tb in ipairs(tabs) do
		local b = Kit.button(tb.label, { parent = refs.tabs, size = UDim2.fromOffset(128, 38), style = tb.id == category and "primary" or "plain", order = i, textSize = 14, onClick = function()
			category = tb.id
			Screen.refresh()
		end })
		local _ = b
	end
end

function Screen.refreshTools()
	local Build = Core.C.Build
	local L = Locale.get()
	refs.gridLabel.Text = t("ui.grid")
	for g, b in pairs(refs.gridButtons) do
		b.BackgroundColor3 = (Build.grid == g) and T.red or T.paperDark
		b.TextColor3 = (Build.grid == g) and T.white or T.ink
	end
	refs.topView.Text = Core.C.Camera.top and ("🎥 " .. t("ui.normal_view")) or ("🗺️ " .. t("ui.top_view"))
	refs.exit.Text = "✕ " .. t("ui.exit_build")
	if Build.itemId then
		local status = Build.valid and ("✅ " .. t("ui.can_place")) or ("❌ " .. t(Build.reason or "msg.place_invalid"))
		refs.status.Text = t("item." .. Build.itemId) .. "\n" .. status
		refs.status.TextColor3 = Build.valid and T.green or T.red
	elseif Build.selected then
		local entry = nil
		for _, e in ipairs(Core.C.Data.w("placed") or {}) do
			if e.u == Build.selected then
				entry = e
			end
		end
		refs.status.Text = entry and t("item." .. entry.i) or ""
		refs.status.TextColor3 = T.ink
	else
		refs.status.Text = t("ui.build_hint")
		refs.status.TextColor3 = T.muted
	end
	Kit.clear(refs.actions)
	if Build.selected and not Build.itemId then
		local entry = nil
		for _, e in ipairs(Core.C.Data.w("placed") or {}) do
			if e.u == Build.selected then
				entry = e
			end
		end
		local item = entry and Items.byId[entry.i]
		Kit.button("✋ " .. t("ui.move"), { parent = refs.actions, style = "dark", order = 1, textSize = 15, onClick = function()
			Build.startMove(Build.selected)
		end })
		Kit.button("🔄 " .. t("ui.rotate"), { parent = refs.actions, style = "dark", order = 2, textSize = 15, onClick = function()
			Build.rotate()
		end })
		Kit.button("🎒 " .. t("ui.store"), { parent = refs.actions, style = "plain", order = 3, textSize = 15, onClick = function()
			Build.removeSelected("store")
		end })
		local refund = item and math.floor((entry.paid or item.price) * GameConfig.SellRefund) or 0
		Kit.button("💴 " .. t("ui.sell") .. " " .. Format.yen(refund, L), { parent = refs.actions, style = "primary", order = 4, textSize = 14, onClick = function()
			Build.removeSelected("sell")
		end })
	elseif Build.itemId then
		Kit.button("✕ " .. t("ui.cancel"), { parent = refs.actions, style = "plain", order = 1, textSize = 15, onClick = function()
			Build.cancel()
		end })
	end
	refs.confirm.Visible = Build.itemId ~= nil and UserInputService.TouchEnabled
end

function Screen.refresh()
	if not refs.frame or not refs.frame.Visible then
		return
	end
	renderTabs()
	renderItems()
	Screen.refreshTools()
end

function Screen.visible()
	return refs.frame and refs.frame.Visible
end

function Screen.open()
	refs.frame.Visible = true
	Screen.refresh()
end

function Screen.close()
	refs.frame.Visible = false
	refs.confirm.Visible = false
end

return Screen
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000110"><Properties><string name="Name">DayReport</string><ProtectedString name="Source"><![CDATA[--!nonstrict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Format = require(Shared.Util.Format)
local Kit = require(script.Parent.Parent.Kit)
local Base = require(script.Parent.Parent.Base)
local Core = require(script.Parent.Parent.Parent.Core)

local t = Locale.t
local T = Kit.Theme

local screen
screen = Base.make("DayReport", "ui.report", UDim2.fromScale(0.42, 0.74), function(content)
	local r = screen.arg or (Core.C.Data.day and Core.C.Data.day.report)
	if not r then
		return
	end
	local L = Locale.get()
	local list = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -60), Parent = content }, { Kit.list(Enum.FillDirection.Vertical, 4) })
	Kit.title(t("ui.day_n", { n = r.day }), { Parent = list, Size = UDim2.new(1, 0, 0, 34), LayoutOrder = 0 })
	local rows = {
		{ "💴", "ui.r_sales", Format.yen(r.sales, L), T.green },
		{ "💝", "ui.r_tips", Format.yen(r.tips, L), T.green },
		{ "📦", "ui.r_supplies", "-" .. Format.yen(r.supplies, L), T.red },
		{ "👥", "ui.r_salaries", "-" .. Format.yen(r.salaries, L), T.red },
		{ "🔨", "ui.r_build", "-" .. Format.yen(r.build + r.other, L), T.red },
		{ "📈", "ui.r_profit", Format.yen(r.profit, L), r.profit >= 0 and T.green or T.red },
		{ "🙂", "ui.r_customers", tostring(r.customers), T.ink },
		{ "🍜", "ui.r_served", tostring(r.served), T.ink },
		{ "😠", "ui.r_walkouts", tostring(r.walkouts), T.ink },
		{ "⭐", "ui.r_rating", Format.decimal(r.rating, 1, L), T.ink },
	}
	if r.best then
		table.insert(rows, { "🏆", "ui.r_best", t("rec." .. r.best) .. " ×" .. r.bestCount, T.ink })
	end
	for i, row in ipairs(rows) do
		local f = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = i, Parent = list })
		Kit.label(row[1] .. "  " .. t(row[2]), { Parent = f, Size = UDim2.new(0.6, 0, 1, 0), TextSize = 18 })
		Kit.label(row[3], { Parent = f, Position = UDim2.fromScale(0.6, 0), Size = UDim2.new(0.4, 0, 1, 0), TextSize = 18, FontFace = T.bold, TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = row[4] })
	end
	Kit.button("🌅 " .. t("ui.next_day"), { parent = content, size = UDim2.new(1, 0, 0, 50), position = UDim2.new(0, 0, 1, -52), style = "green", onClick = function()
		NetDef.event("SetDayState"):FireServer("next")
		Core.C.UI.close("DayReport")
	end })
end)

return screen
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000111"><Properties><string name="Name">Dev</string><ProtectedString name="Source"><![CDATA[--!nonstrict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Kit = require(script.Parent.Parent.Kit)
local Base = require(script.Parent.Parent.Base)

local CMDS = {
	{ "💴 +10.000", "yen", 10000 }, { "💴 +1M", "yen", 1000000 }, { "🌸 +50", "sakura", 50 }, { "⬆️ +1 level", "level", nil },
	{ "Level 25", "level", 25 }, { "Level 45", "level", 45 }, { "🎫 All licenses", "licenses" }, { "🏗️ All zones", "zones" }, { "🪚 All renovations", "renos" }, { "🧱 Plain look", "plain" },
	{ "📦 Stock boxes", "stock" }, { "🧍 Spawn customer", "spawn" }, { "🕚 Close day", "time" }, { "⭐ 5-star reviews", "rating" },
	{ "🧪 Self-test", "selftest" },
	{ "♻️ Reset (Studio)", "reset" },
}

return Base.make("Dev", "ui.dev", UDim2.fromScale(0.5, 0.6), function(content)
	local grid = Kit.scroll({ Parent = content }, Kit.grid(200, 44, 8))
	for i, c in ipairs(CMDS) do
		Kit.button(c[1], { parent = grid, size = UDim2.fromOffset(200, 44), style = c[2] == "reset" and "primary" or "dark", order = i, textSize = 15, onClick = function()
			NetDef.event("Dev"):FireServer(c[2], c[3])
		end })
	end
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000112"><Properties><string name="Name">Expansions</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Expansions screen: new rooms and floors ("zones" tab) and renovations that turn the plain
-- starting restaurant into the detailed one ("reno" tab, grouped by exterior/interior/furniture).
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Format = require(Shared.Util.Format)
local Expansions = require(Shared.Config.Expansions)
local Kit = require(script.Parent.Parent.Kit)
local Base = require(script.Parent.Parent.Base)
local Icons = require(script.Parent.Parent.Icons)
local Core = require(script.Parent.Parent.Parent.Core)

local t = Locale.t
local tab = "zones"
local GROUPS = {
	{ id = "exterior", key = "ui.reno_exterior" },
	{ id = "interior", key = "ui.reno_interior" },
	{ id = "furniture", key = "ui.reno_furniture" },
}

local function row(scroll, e, w, can, L, order)
	local owned = w.zones and w.zones[e.id]
	local req = t("ui.req_level", { level = e.lv })
	local reqOk = true
	for _, r in ipairs(e.requires) do
		if r ~= "zone_base" then
			req ..= "  ·  " .. t("zone." .. r)
		end
		if not (w.zones and w.zones[r]) then
			reqOk = false
		end
	end
	if e.ambience then
		req ..= "  ·  " .. t("ui.reno_amb", { n = e.ambience })
	end
	local card, right = Kit.row(Icons.zone[e.id] or "🏗️", t("zone." .. e.id), t("zonedesc." .. e.id) .. "\n" .. req, 86)
	card.Parent = scroll
	card.LayoutOrder = order
	if owned then
		Kit.label("✅ " .. t("ui.owned"), { Parent = right, Size = UDim2.fromOffset(150, 26), TextXAlignment = Enum.TextXAlignment.Right, FontFace = Kit.Theme.bold, TextColor3 = Kit.Theme.green })
	else
		Kit.button(Format.yen(e.cost, L), { parent = right, size = UDim2.fromOffset(150, 40), style = "gold", disabled = not can or not reqOk or (w.level or 1) < e.lv, onClick = function()
			NetDef.event("BuyExpansion"):FireServer(e.id)
		end })
	end
end

local screen
screen = Base.make("Expansions", "ui.expansions", UDim2.fromScale(0.66, 0.76), function(content)
	local w = Core.C.Data.world or {}
	local L = Locale.get()
	local can = Core.C.Data.canBuild()
	local done, total = 0, 0
	for _, e in ipairs(Expansions.list) do
		if e.reno then
			total += 1
			if w.zones and w.zones[e.id] then
				done += 1
			end
		end
	end
	Kit.tabs(content, {
		{ id = "zones", label = t("ui.tab_zones"), width = 150 },
		{ id = "reno", label = t("ui.tab_reno") .. " " .. done .. "/" .. total, width = 210 },
	}, function(id)
		tab = id
		screen.refresh()
	end, tab)
	local scroll = Kit.scroll({ Position = UDim2.fromOffset(0, 46), Size = UDim2.new(1, 0, 1, -46), Parent = content })
	if tab == "zones" then
		for _, e in ipairs(Expansions.list) do
			if e.id ~= "zone_base" and not e.reno then
				row(scroll, e, w, can, L, e.order)
			end
		end
		return
	end
	-- renovations: a short hint, then one block per group
	Kit.label(t("ui.reno_hint"), { Parent = scroll, Size = UDim2.new(1, -8, 0, 40), TextWrapped = true, TextSize = 15, TextColor3 = Kit.Theme.muted, LayoutOrder = 0 })
	for gi, g in ipairs(GROUPS) do
		local base = gi * 1000
		Kit.title(t(g.key), { Parent = scroll, Size = UDim2.new(1, -8, 0, 30), TextSize = 20, LayoutOrder = base })
		for _, e in ipairs(Expansions.list) do
			if e.reno == g.id then
				row(scroll, e, w, can, L, base + e.order)
			end
		end
	end
end)

return screen
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000113"><Properties><string name="Name">Goals</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Daily quests, achievements, login calendar, leaderboards and franchise.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Format = require(Shared.Util.Format)
local Quests = require(Shared.Config.Quests)
local Achievements = require(Shared.Config.Achievements)
local DailyRewards = require(Shared.Config.DailyRewards)
local Franchise = require(Shared.Config.Franchise)
local Kit = require(script.Parent.Parent.Kit)
local Base = require(script.Parent.Parent.Base)
local Core = require(script.Parent.Parent.Parent.Core)

local t = Locale.t
local T = Kit.Theme
local tab = "quests"
local board = nil
local boardTime = 0

local function statValue(me, stat)
	if stat == "staff" then
		return #(me.staff or {})
	elseif stat == "level" then
		return me.level or 1
	elseif stat == "licenses" then
		local n = 0
		for _ in pairs(me.licenses or {}) do
			n += 1
		end
		return n
	elseif stat == "zones" then
		local n = 0
		for id in pairs(me.zones or {}) do
			if string.sub(id, 1, 5) == "zone_" then
				n += 1
			end
		end
		return n
	elseif stat == "franchise" then
		return me.franchise and me.franchise.stars or 0
	end
	return me.stats and me.stats[stat] or 0
end

local screen
screen = Base.make("Goals", "ui.goals", UDim2.fromScale(0.68, 0.78), function(content)
	local me = Core.C.Data.me or {}
	local L = Locale.get()
	Kit.tabs(content, {
		{ id = "quests", label = t("ui.tab_quests"), width = 120 },
		{ id = "achievements", label = t("ui.tab_achievements"), width = 120 },
		{ id = "daily", label = t("ui.tab_daily"), width = 120 },
		{ id = "leaderboard", label = t("ui.tab_leaderboard"), width = 120 },
		{ id = "franchise", label = t("ui.tab_franchise"), width = 120 },
	}, function(id)
		tab = id
		screen.refresh()
	end, tab)
	local scroll = Kit.scroll({ Position = UDim2.fromOffset(0, 46), Size = UDim2.new(1, 0, 1, -46), Parent = content })
	if tab == "quests" then
		for i, q in ipairs(me.meta and me.meta.quests or {}) do
			local cfg = Quests.byId[q.id]
			local card, right = Kit.row("🎯", t("quest." .. q.id, { n = q.target }), q.progress .. " / " .. q.target, 76)
			card.Parent = scroll
			card.LayoutOrder = i
			local _, fill = Kit.bar(q.progress / q.target, T.green, { Parent = card, Position = UDim2.new(0, 70, 1, -16), Size = UDim2.new(1, -260, 0, 8) })
			local _ = fill
			if q.claimed then
				Kit.label("✅", { Parent = right, Size = UDim2.fromOffset(40, 30), TextScaled = true })
			else
				Kit.button(t("ui.claim"), { parent = right, size = UDim2.fromOffset(120, 36), style = "gold", disabled = q.progress < q.target, onClick = function()
					NetDef.event("ClaimQuest"):FireServer(q.id)
				end })
			end
			local _2 = cfg
		end
		Kit.label(t("ui.quests_reward", { yen = Quests.RewardYenPerLevel * (me.level or 1), sakura = Quests.RewardSakura, bonus = Quests.BonusSakura }), { Parent = scroll, Size = UDim2.new(1, 0, 0, 44), TextSize = 15, TextColor3 = T.muted, LayoutOrder = 10 })
	elseif tab == "achievements" then
		for _, a in ipairs(Achievements.list) do
			local state = me.meta and me.meta.achievements and me.meta.achievements[a.id]
			local value = statValue(me, a.stat)
			local card, right = Kit.row(state and "🏆" or "🔒", t("ach." .. a.stat, { n = a.target }), Format.number(math.min(value, a.target), L) .. " / " .. Format.number(a.target, L) .. "  ·  🌸" .. a.sakura, 64)
			card.Parent = scroll
			if state == "done" then
				Kit.button(t("ui.claim"), { parent = right, size = UDim2.fromOffset(120, 34), style = "gold", onClick = function()
					NetDef.event("ClaimAchievement"):FireServer(a.id)
				end })
			elseif state == "claimed" then
				Kit.label("✅", { Parent = right, Size = UDim2.fromOffset(34, 30), TextScaled = true })
			end
		end
	elseif tab == "daily" then
		local daily = me.meta and me.meta.daily or { streak = 0, last = 0 }
		local today = math.floor(workspace:GetServerTimeNow() / 86400)
		local claimedToday = daily.last == today
		local nextDay = claimedToday and daily.streak or ((daily.last == today - 1) and (daily.streak % 7 + 1) or 1)
		local row = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 130) }, { Kit.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center) })
		row.Parent = scroll
		for i, r in ipairs(DailyRewards.days) do
			local c = Kit.card({ Size = UDim2.fromOffset(92, 120), LayoutOrder = i, Parent = row })
			if i == nextDay then
				c:FindFirstChildOfClass("UIStroke").Color = T.gold
				c:FindFirstChildOfClass("UIStroke").Thickness = 3
			end
			Kit.label(t("ui.day_n", { n = i }), { Parent = c, Size = UDim2.new(1, 0, 0, 22), TextXAlignment = Enum.TextXAlignment.Center, FontFace = T.bold, TextSize = 15 })
			local reward = r.yen and Format.yen(math.floor(r.yen * (1 + (me.level or 1) / 10)), L) or ("🌸" .. r.sakura)
			Kit.label(r.yen and "💴" or "🌸", { Parent = c, Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 0, 44), TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center })
			Kit.label(reward .. (r.item and " +🎁" or ""), { Parent = c, Position = UDim2.fromOffset(2, 74), Size = UDim2.new(1, -4, 0, 40), TextSize = 14, TextXAlignment = Enum.TextXAlignment.Center })
		end
		Kit.button(claimedToday and t("ui.daily_tomorrow") or t("ui.claim"), { parent = scroll, size = UDim2.new(1, -8, 0, 46), style = "green", disabled = claimedToday, onClick = function()
			NetDef.event("ClaimDaily"):FireServer()
		end })
	elseif tab == "leaderboard" then
		if not board or os.clock() - boardTime > 60 then
			boardTime = os.clock()
			task.spawn(function()
				local ok, result = pcall(function()
					return NetDef.func("GetLeaderboard"):InvokeServer()
				end)
				if ok and result then
					board = result
					if screen.visible() and tab == "leaderboard" then
						screen.refresh()
					end
				end
			end)
		end
		for _, stat in ipairs({ "dishes", "earned" }) do
			Kit.title(t("lb." .. stat), { Parent = scroll, Size = UDim2.new(1, 0, 0, 30) })
			for _, entry in ipairs(board and board[stat] or {}) do
				local row = Kit.card({ Size = UDim2.new(1, -8, 0, 34), Parent = scroll })
				Kit.label("#" .. entry.rank .. "  " .. entry.name, { Parent = row, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(0.6, 0, 1, 0), FontFace = T.bold })
				Kit.label(stat == "earned" and Format.yen(entry.value, L) or Format.number(entry.value, L), { Parent = row, Position = UDim2.fromScale(0.6, 0), Size = UDim2.new(0.38, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Right })
			end
		end
	elseif tab == "franchise" then
		local w = Core.C.Data.world or me
		local stars = w.franchise and w.franchise.stars or 0
		local nextCity = nil
		for _, c in ipairs(Franchise.list) do
			if c.star == stars + 1 then
				nextCity = c
			end
		end
		Kit.label(t("ui.franchise_info", { stars = stars, yen = math.floor(stars * Franchise.YenPerStar * 100), xp = math.floor(stars * Franchise.XpPerStar * 100) }), { Parent = scroll, Size = UDim2.new(1, 0, 0, 60), TextSize = 17 })
		for _, c in ipairs(Franchise.list) do
			local mark = (w.franchise and w.franchise.city == c.id) and "📍" or ((c.star <= stars) and "✅" or "🔒")
			local card = Kit.row(mark, t("city." .. c.id), t("citydesc." .. c.id), 60)
			card.Parent = scroll
		end
		if nextCity then
			local reqs = t("ui.franchise_req", { level = Franchise.RequiredLevel, rating = Franchise.RequiredRating })
			Kit.label(reqs, { Parent = scroll, Size = UDim2.new(1, 0, 0, 44), TextSize = 15, TextColor3 = T.muted })
			Kit.button("🗾 " .. t("ui.franchise_open", { city = "city." .. nextCity.id }), { parent = scroll, size = UDim2.new(1, -8, 0, 50), style = "primary", disabled = Core.C.Data.role() ~= "owner", onClick = function()
				NetDef.event("Franchise"):FireServer(nextCity.id)
			end })
		end
	end
end)

return screen
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000114"><Properties><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Always-visible HUD: wallet, level, clock/day controls, rating, tickets, hands and menu bar.
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Format = require(Shared.Util.Format)
local Formulas = require(Shared.Logic.Formulas)
local Recipes = require(Shared.Config.Recipes)
local Ingredients = require(Shared.Config.Ingredients)
local Kit = require(script.Parent.Parent.Kit)
local Core = require(script.Parent.Parent.Parent.Core)

local HUD = { modal = false }
local T = Kit.Theme
local t = Locale.t
local refs = {}
local player = Players.LocalPlayer

local BUTTONS = {
	{ id = "Build", icon = "🔨", key = "ui.build", build = true },
	{ id = "Supplier", icon = "📦", key = "ui.supplier", build = true },
	{ id = "Menu", icon = "📜", key = "ui.menu" },
	{ id = "Licenses", icon = "🎫", key = "ui.licenses" },
	{ id = "Upgrades", icon = "⬆️", key = "ui.upgrades" },
	{ id = "Staff", icon = "👥", key = "ui.staff" },
	{ id = "Expansions", icon = "🏗️", key = "ui.expansions" },
	{ id = "Goals", icon = "🎯", key = "ui.goals" },
	{ id = "Shop", icon = "🛒", key = "ui.shop" },
	{ id = "Invite", icon = "👋", key = "ui.invite" },
	{ id = "Settings", icon = "⚙️", key = "ui.settings" },
	{ id = "Dev", icon = "🛠️", key = "ui.dev", dev = true },
}

local function lang()
	return Locale.get()
end

local function open(id)
	local UIc = Core.C.UI
	if id == "Build" then
		Core.C.Build.toggle()
		return
	end
	UIc.toggle(id)
end

function HUD.create(root)
	local top = Kit.new("Frame", { Name = "HUD", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = root })
	HUD.frame = top
	-- wallet & level (top-left)
	local wallet = Kit.panel({ Size = UDim2.fromOffset(250, 92), Position = UDim2.fromOffset(12, 10), Parent = top })
	Kit.padding(10, 8).Parent = wallet
	refs.yen = Kit.label("¥0", { Parent = wallet, Size = UDim2.new(1, 0, 0, 28), TextSize = 26, FontFace = T.title, TextColor3 = T.wood })
	refs.sakura = Kit.label("🌸0", { Parent = wallet, Position = UDim2.fromOffset(150, 2), Size = UDim2.fromOffset(80, 24), TextSize = 18, FontFace = T.bold, TextXAlignment = Enum.TextXAlignment.Right })
	refs.level = Kit.label("", { Parent = wallet, Position = UDim2.fromOffset(0, 32), Size = UDim2.new(1, 0, 0, 20), TextSize = 16, FontFace = T.bold })
	local bar, fill = Kit.bar(0, T.gold, { Parent = wallet, Position = UDim2.fromOffset(0, 56), Size = UDim2.new(1, 0, 0, 12) })
	refs.xpFill = fill
	local _ = bar
	-- day / clock (top-center)
	local day = Kit.panel({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.fromOffset(330, 70), Parent = top })
	refs.clock = Kit.label("", { Parent = day, Position = UDim2.fromOffset(12, 6), Size = UDim2.fromOffset(160, 26), TextSize = 22, FontFace = T.title, TextColor3 = T.wood })
	refs.dayInfo = Kit.label("", { Parent = day, Position = UDim2.fromOffset(12, 36), Size = UDim2.fromOffset(170, 24), TextSize = 16 })
	refs.dayButton = Kit.button("", {
		size = UDim2.fromOffset(140, 50), position = UDim2.new(1, -150, 0, 10), style = "green", textSize = 16,
		onClick = function()
			local phase = Core.C.Data.day.phase
			if phase == "prep" then
				NetDef.event("SetDayState"):FireServer("open")
			elseif phase == "open" then
				NetDef.event("SetDayState"):FireServer("close")
			elseif phase == "report" then
				Core.C.UI.open("DayReport", Core.C.Data.day.report)
			end
		end,
	})
	refs.dayButton.Parent = day
	-- rating & ambience (top-right)
	local info = Kit.panel({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 10), Size = UDim2.fromOffset(230, 70), Parent = top })
	refs.rating = Kit.label("", { Parent = info, Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -24, 0, 24), TextSize = 20, FontFace = T.bold })
	refs.ambience = Kit.label("", { Parent = info, Position = UDim2.fromOffset(12, 36), Size = UDim2.new(1, -24, 0, 22), TextSize = 15, TextColor3 = T.muted })
	-- tickets (right)
	refs.tickets = Kit.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 90), Size = UDim2.fromOffset(200, 460), Parent = top }, { Kit.list(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Right) })
	-- hands (bottom-center, above the bar)
	refs.hands = Kit.panel({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -96), Size = UDim2.fromOffset(380, 46), Visible = false, Parent = top })
	refs.handsLabel = Kit.label("", { Parent = refs.hands, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -120, 1, 0), TextSize = 17, FontFace = T.bold, TextYAlignment = Enum.TextYAlignment.Center })
	Kit.button("🗑️ " .. t("ui.drop"), {
		parent = refs.hands, size = UDim2.fromOffset(100, 34), position = UDim2.new(1, -106, 0, 6), style = "plain", textSize = 15,
		onClick = function()
			NetDef.event("DropHands"):FireServer()
		end,
	})
	-- dishes + hint (bottom-left)
	refs.dishes = Kit.label("", { Parent = top, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 14, 1, -96), Size = UDim2.fromOffset(240, 24), TextSize = 17, FontFace = T.bold, TextStrokeTransparency = 0.6, TextColor3 = T.white })
	-- bottom bar
	local barFrame = Kit.panel({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Size = UDim2.new(0.96, 0, 0, 78), BackgroundColor3 = T.wood, Parent = top })
	local scroll = Kit.new("ScrollingFrame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, -12, 1, -8), Position = UDim2.fromOffset(6, 4), ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = 4, AutomaticCanvasSize = Enum.AutomaticSize.X, CanvasSize = UDim2.new(0, 0, 0, 0), Parent = barFrame,
	}, { Kit.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
	refs.buttons = {}
	for i, b in ipairs(BUTTONS) do
		local btn = Kit.new("TextButton", { Size = UDim2.fromOffset(78, 66), BackgroundColor3 = T.paper, Text = "", LayoutOrder = i, Parent = scroll }, { Kit.corner(10) })
		Kit.label(b.icon, { Parent = btn, Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 4), TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center })
		local lbl = Kit.label("", { Parent = btn, Size = UDim2.new(1, -4, 0, 22), Position = UDim2.fromOffset(2, 40), TextSize = 13, FontFace = T.bold, TextXAlignment = Enum.TextXAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd })
		btn.MouseButton1Click:Connect(function()
			if Core.C.Audio then
				Core.C.Audio.play("ui")
			end
			open(b.id)
		end)
		refs.buttons[b.id] = { button = btn, label = lbl, def = b }
	end
	player:GetAttributeChangedSignal("Hands"):Connect(HUD.refreshHands)
	player:GetAttributeChangedSignal("HandsKind"):Connect(HUD.refreshHands)
	task.spawn(function()
		while true do
			task.wait(1)
			HUD.refreshTickets()
			HUD.refreshInfo()
		end
	end)
	Core.C.Data.TicketsChanged:Connect(HUD.refreshTickets)
end

function HUD.refreshHands()
	local kind = player:GetAttribute("HandsKind") or ""
	local raw = player:GetAttribute("Hands") or "[]"
	local ok, list = pcall(HttpService.JSONDecode, HttpService, raw)
	if not ok or kind == "" or #list == 0 then
		refs.hands.Visible = false
		return
	end
	local parts = {}
	for _, id in ipairs(list) do
		if kind == "dish" then
			table.insert(parts, (Recipes.byId[id] and Recipes.byId[id].icon or "🍽️") .. " " .. t("rec." .. id))
		elseif kind == "dirty" then
			table.insert(parts, "🧽")
		else
			local ing = Ingredients.byId[id]
			table.insert(parts, (ing and ing.icon or "📦") .. (kind == "box" and (" " .. t("ui.box_of", { name = "ing." .. id })) or ""))
		end
	end
	refs.handsLabel.Text = t("ui.holding") .. " " .. table.concat(parts, "  ")
	refs.hands.Visible = true
end

function HUD.day(state)
	local phase = state.phase
	refs.clock.Text = "🕒 " .. Format.clock(state.clock or 9.5)
	refs.dayInfo.Text = t("ui.day_n", { n = state.day or 1 }) .. " · " .. t("day." .. phase)
	local b = refs.dayButton
	if phase == "prep" then
		b.Text = t("ui.open_restaurant")
		b.BackgroundColor3 = T.green
	elseif phase == "open" then
		b.Text = t("ui.close_early")
		b.BackgroundColor3 = T.red
	elseif phase == "closing" then
		b.Text = t("ui.closing")
		b.BackgroundColor3 = T.locked
	else
		b.Text = t("ui.see_report")
		b.BackgroundColor3 = T.gold
	end
	b.Visible = Core.C.Data.canBuild() or phase == "report"
end

function HUD.refreshInfo()
	local rating = workspace:GetAttribute("Rating") or 3
	local stars = string.rep("★", math.floor(rating + 0.5)) .. string.rep("☆", 5 - math.floor(rating + 0.5))
	refs.rating.Text = stars .. "  " .. Format.decimal(rating, 1, lang())
	local tier = workspace:GetAttribute("AmbienceTier") or 0
	refs.ambience.Text = t("ui.ambience") .. ": " .. t("amb.tier" .. tier) .. " (" .. (workspace:GetAttribute("Ambience") or 0) .. ")"
	local d = Core.C.Data.w("dishes")
	if d then
		refs.dishes.Text = "🍽️ " .. t("ui.dishes_clean", { clean = d.clean, total = d.total }) .. "   🧽 " .. (workspace:GetAttribute("SinkPile") or 0)
	end
	local day = Core.C.Data.day
	if day and day.phase == "open" then
		refs.clock.Text = "🕒 " .. Format.clock(game:GetService("Lighting").ClockTime)
	end
end

function HUD.refreshTickets()
	local holder = refs.tickets
	if not holder then
		return
	end
	Kit.clear(holder)
	local now = workspace:GetServerTimeNow()
	for i, tk in ipairs(Core.C.Data.tickets or {}) do
		local r = Recipes.byId[tk.recipe]
		local age = now - (tk.created or now)
		local col = age < 30 and T.paper or (age < 60 and Kit.Theme.gold or Kit.Theme.red)
		local card = Kit.new("TextButton", { Text = "", Size = UDim2.fromOffset(200, 52), BackgroundColor3 = col, LayoutOrder = i, Parent = holder }, { Kit.corner(8), Kit.stroke(T.wood, 2) })
		Kit.label((r and r.icon or "🍽️"), { Parent = card, Size = UDim2.fromOffset(40, 40), Position = UDim2.fromOffset(6, 6), TextScaled = true })
		Kit.label(t("rec." .. tk.recipe), { Parent = card, Position = UDim2.fromOffset(50, 4), Size = UDim2.new(1, -56, 0, 24), TextSize = 16, FontFace = T.bold, TextTruncate = Enum.TextTruncate.AtEnd })
		Kit.label("⏱ " .. Format.duration(age) .. (tk.claimed and "  👨‍🍳" or ""), { Parent = card, Position = UDim2.fromOffset(50, 26), Size = UDim2.new(1, -56, 0, 20), TextSize = 14, TextColor3 = T.muted })
		card.MouseButton1Click:Connect(function()
			Core.C.Interaction.highlightRecipe(tk.recipe)
		end)
	end
end

function HUD.refresh()
	local Data = Core.C.Data
	if not Data.ready then
		return
	end
	refs.yen.Text = Format.yen(Data.wallet(), lang())
	refs.sakura.Text = Format.sakura(Data.m("sakura") or 0, lang())
	local level = Data.w("level") or 1
	local xp = Data.w("xp") or 0
	refs.level.Text = t("ui.level_n", { n = level }) .. "  ·  " .. Format.number(xp, lang()) .. "/" .. Format.number(Formulas.xpForLevel(level), lang()) .. " XP"
	refs.xpFill.Size = UDim2.fromScale(math.clamp(xp / Formulas.xpForLevel(level), 0, 1), 1)
	for id, b in pairs(refs.buttons) do
		b.label.Text = t(b.def.key)
		local visible = true
		if b.def.dev then
			visible = player:GetAttribute("Dev") == true
		end
		b.button.Visible = visible
		b.button.BackgroundColor3 = (b.def.build and not Data.canBuild()) and T.locked or T.paper
	end
	HUD.day(Data.day)
	HUD.refreshHands()
	HUD.refreshInfo()
end

function HUD.open() end
function HUD.close() end

return HUD
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000115"><Properties><string name="Name">Invite</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Invite friends to the personal world and set their permissions.
local Players = game:GetService("Players")
local SocialService = game:GetService("SocialService")
local HttpService = game:GetService("HttpService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Kit = require(script.Parent.Parent.Kit)
local Base = require(script.Parent.Parent.Base)
local Core = require(script.Parent.Parent.Parent.Core)

local t = Locale.t

return Base.make("Invite", "ui.invite", UDim2.fromScale(0.5, 0.66), function(content)
	local session = Core.C.Data.session or {}
	local me = Players.LocalPlayer
	Kit.label(t("ui.invite_text"), { Parent = content, Size = UDim2.new(1, 0, 0, 60), TextSize = 17 })
	Kit.button("📨 " .. t("ui.invite_friends"), { parent = content, size = UDim2.new(1, 0, 0, 48), position = UDim2.fromOffset(0, 64), style = "green", onClick = function()
		local ok, can = pcall(function()
			return SocialService:CanSendGameInviteAsync(me)
		end)
		if ok and can then
			local opts = Instance.new("ExperienceInviteOptions")
			opts.PromptMessage = t("ui.invite_prompt")
			opts.LaunchData = HttpService:JSONEncode({ owner = session.ownerId or me.UserId })
			pcall(function()
				SocialService:PromptGameInvite(me, opts)
			end)
		else
			Core.C.UI.toast(t("msg.invite_unavailable"), "warning")
		end
	end })
	local scroll = Kit.scroll({ Position = UDim2.fromOffset(0, 124), Size = UDim2.new(1, 0, 1, -124), Parent = content })
	local perms = (Core.C.Data.world and Core.C.Data.world.perms) or {}
	for _, p in ipairs(Players:GetPlayers()) do
		local role = p.UserId == session.ownerId and "owner" or (perms[tostring(p.UserId)] == "comanager" and "comanager" or "helper")
		local card, right = Kit.row(role == "owner" and "👑" or "🧑‍🍳", p.DisplayName, t("role." .. role), 64)
		card.Parent = scroll
		if session.role == "owner" and role ~= "owner" then
			Kit.button(role == "comanager" and t("ui.make_helper") or t("ui.make_comanager"), { parent = right, size = UDim2.fromOffset(160, 36), style = "plain", textSize = 14, onClick = function()
				NetDef.event("SetPermission"):FireServer(p.UserId, role == "comanager" and "helper" or "comanager")
			end })
		end
	end
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000116"><Properties><string name="Name">Licenses</string><ProtectedString name="Source"><![CDATA[--!nonstrict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Format = require(Shared.Util.Format)
local Licenses = require(Shared.Config.Licenses)
local Recipes = require(Shared.Config.Recipes)
local Kit = require(script.Parent.Parent.Kit)
local Base = require(script.Parent.Parent.Base)
local Core = require(script.Parent.Parent.Parent.Core)

local t = Locale.t
local BRANCH_ICON = { base = "🏠", sushi = "🍣", ramen = "🍜", extra = "🥟", master = "🎌" }

return Base.make("Licenses", "ui.licenses", UDim2.fromScale(0.66, 0.76), function(content)
	local w = Core.C.Data.world or {}
	local L = Locale.get()
	local scroll = Kit.scroll({ Parent = content })
	for _, lic in ipairs(Licenses.list) do
		local owned = w.licenses and w.licenses[lic.id]
		local icons = {}
		for _, rid in ipairs(lic.recipes) do
			local r = Recipes.byId[rid]
			table.insert(icons, (r and r.icon or "") .. " " .. t("rec." .. rid))
		end
		local req = t("ui.req_level", { level = lic.level })
		if lic.rating > 0 then
			req ..= "  ·  ★" .. lic.rating
		end
		for _, rq in ipairs(lic.requires) do
			if rq ~= "lic_base" then
				req ..= "  ·  " .. t("lic." .. rq)
			end
		end
		local card, right = Kit.row(BRANCH_ICON[lic.branch] or "🎫", t("lic." .. lic.id), table.concat(icons, ", ") .. "\n" .. req, 86)
		card.Parent = scroll
		card.LayoutOrder = lic.order
		if owned then
			Kit.label("✅ " .. t("ui.owned"), { Parent = right, Size = UDim2.fromOffset(160, 26), TextXAlignment = Enum.TextXAlignment.Right, FontFace = Kit.Theme.bold, TextColor3 = Kit.Theme.green })
		else
			local can = (w.level or 1) >= lic.level and Core.C.Data.canBuild()
			for _, rq in ipairs(lic.requires) do
				if not (w.licenses and w.licenses[rq]) then
					can = false
				end
			end
			Kit.button(Format.yen(lic.cost, L), { parent = right, size = UDim2.fromOffset(150, 40), style = "gold", disabled = not can, onClick = function()
				NetDef.event("BuyLicense"):FireServer(lic.id)
			end })
		end
	end
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000117"><Properties><string name="Name">Menu</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Menu board: enable dishes, set prices (-30%..+30%), recipe book with mastery.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Format = require(Shared.Util.Format)
local Recipes = require(Shared.Config.Recipes)
local Licenses = require(Shared.Config.Licenses)
local Franchise = require(Shared.Config.Franchise)
local Formulas = require(Shared.Logic.Formulas)
local Kit = require(script.Parent.Parent.Kit)
local Base = require(script.Parent.Parent.Base)
local Core = require(script.Parent.Parent.Parent.Core)

local t = Locale.t
local T = Kit.Theme
local tab = "menu"

local function isUnlocked(w, r)
	if r.city then
		return w.franchise and w.franchise.city == r.city and (w.level or 1) >= Franchise.RegionalLevel
	end
	return w.licenses and w.licenses[r.license] == true
end

local function licenseOf(recipeId)
	for _, l in ipairs(Licenses.list) do
		if table.find(l.recipes, recipeId) then
			return l
		end
	end
	return nil
end

local screen
screen = Base.make("Menu", "ui.menu", UDim2.fromScale(0.66, 0.76), function(content)
	local w = Core.C.Data.world or {}
	local L = Locale.get()
	Kit.tabs(content, { { id = "menu", label = t("ui.tab_menu") }, { id = "book", label = t("ui.tab_book") } }, function(id)
		tab = id
		screen.refresh()
	end, tab)
	local scroll = Kit.scroll({ Position = UDim2.fromOffset(0, 46), Size = UDim2.new(1, 0, 1, -46), Parent = content })
	local canEdit = Core.C.Data.canBuild()
	for _, r in ipairs(Recipes.list) do
		local unlocked = isUnlocked(w, r)
		local served = (w.mastery and w.mastery[r.id]) or 0
		local mastery = Formulas.masteryLevel(served)
		if tab == "menu" and unlocked then
			local m = (w.menu and w.menu[r.id]) or { on = true, price = 1 }
			local price = Formulas.dishPrice(r.price, served, m.price)
			local stars = string.rep("★", mastery) .. string.rep("☆", 5 - mastery)
			local card, right = Kit.row(r.icon, t("rec." .. r.id), Format.yen(price, L) .. "  ·  " .. t("station." .. r.station) .. "  ·  " .. stars, 74)
			card.Parent = scroll
			card.LayoutOrder = r.order
			local controls = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(170, 30), Parent = right }, { Kit.list(Enum.FillDirection.Horizontal, 4, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center) })
			Kit.button("−", { parent = controls, size = UDim2.fromOffset(30, 28), style = "plain", order = 1, disabled = not canEdit, onClick = function()
				NetDef.event("SetMenu"):FireServer(r.id, nil, m.price - 0.1)
			end })
			Kit.label(math.floor(m.price * 100 + 0.5) .. "%", { Parent = controls, Size = UDim2.fromOffset(52, 28), TextXAlignment = Enum.TextXAlignment.Center, FontFace = T.bold, LayoutOrder = 2 })
			Kit.button("+", { parent = controls, size = UDim2.fromOffset(30, 28), style = "plain", order = 3, disabled = not canEdit, onClick = function()
				NetDef.event("SetMenu"):FireServer(r.id, nil, m.price + 0.1)
			end })
			Kit.button(m.on and t("ui.on") or t("ui.off"), { parent = controls, size = UDim2.fromOffset(52, 28), style = m.on and "green" or "plain", order = 4, disabled = not canEdit, onClick = function()
				NetDef.event("SetMenu"):FireServer(r.id, not m.on, nil)
			end })
		elseif tab == "book" then
			local sub
			if unlocked then
				local nextT = Formulas.MasteryThresholds[mastery + 1]
				sub = t("ui.mastery", { level = mastery }) .. "  ·  " .. served .. (nextT and ("/" .. nextT) or "") .. "  ·  " .. t("ui.ingredients") .. ": "
				local names = {}
				for _, g in ipairs(r.ing) do
					table.insert(names, t("ing." .. g))
				end
				sub ..= table.concat(names, ", ")
			elseif r.city then
				sub = "🔒 " .. t("ui.regional", { city = "city." .. r.city })
			else
				local l = licenseOf(r.id)
				sub = "🔒 " .. (l and t("lic." .. l.id) or "")
			end
			local card = Kit.row(unlocked and r.icon or "🔒", t("rec." .. r.id), sub, 74)
			card.Parent = scroll
			card.LayoutOrder = r.order
			if mastery >= 5 then
				card.BackgroundColor3 = Kit.Theme.gold
			end
		end
	end
end)

return screen
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000118"><Properties><string name="Name">Offline</string><ProtectedString name="Source"><![CDATA[--!nonstrict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Format = require(Shared.Util.Format)
local Kit = require(script.Parent.Parent.Kit)
local Base = require(script.Parent.Parent.Base)
local Core = require(script.Parent.Parent.Parent.Core)

local t = Locale.t

return Base.make("Offline", "ui.offline", UDim2.fromScale(0.36, 0.4), function(content)
	local meta = Core.C.Data.m("meta") or {}
	local amount = meta.offlinePending or 0
	Kit.label("💰", { Parent = content, Size = UDim2.new(1, 0, 0, 60), TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center })
	Kit.label(t("ui.offline_text", { hours = math.floor((meta.offlineHours or 0) * 10) / 10, yen = amount }), { Parent = content, Position = UDim2.fromOffset(0, 70), Size = UDim2.new(1, 0, 0, 60), TextSize = 20, TextXAlignment = Enum.TextXAlignment.Center })
	Kit.button(t("ui.claim") .. " " .. Format.yen(amount, Locale.get()), { parent = content, size = UDim2.new(1, 0, 0, 48), position = UDim2.new(0, 0, 1, -50), style = "green", onClick = function()
		NetDef.event("ClaimOffline"):FireServer()
		Core.C.UI.close("Offline")
	end })
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000119"><Properties><string name="Name">Settings</string><ProtectedString name="Source"><![CDATA[--!nonstrict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local GameConfig = require(Shared.Config.GameConfig)
local Kit = require(script.Parent.Parent.Kit)
local Base = require(script.Parent.Parent.Base)
local Core = require(script.Parent.Parent.Parent.Core)

local t = Locale.t

local function set(key, value)
	NetDef.event("SetSetting"):FireServer(key, value)
end

return Base.make("Settings", "ui.settings", UDim2.fromScale(0.5, 0.72), function(content)
	local s = Core.C.Data.m("settings") or {}
	local scroll = Kit.scroll({ Parent = content })
	local function choice(order, label, options, current, key)
		local row = Kit.card({ Size = UDim2.new(1, -8, 0, 60), LayoutOrder = order, Parent = scroll })
		Kit.label(label, { Parent = row, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(0.4, 0, 1, 0), FontFace = Kit.Theme.bold })
		local holder = Kit.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromScale(0.4, 0), Size = UDim2.new(0.6, -10, 1, 0), Parent = row }, { Kit.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center) })
		for i, o in ipairs(options) do
			Kit.button(o.label, { parent = holder, size = UDim2.fromOffset(o.width or 86, 38), style = (current == o.value) and "primary" or "plain", order = i, textSize = 15, onClick = function()
				set(key, o.value)
			end })
		end
	end
	choice(1, "🌐 " .. t("ui.language"), { { label = t("ui.auto"), value = "auto" }, { label = "English", value = "en" }, { label = "Italiano", value = "it" } }, s.lang or "auto", "lang")
	local grids = {}
	for _, g in ipairs(GameConfig.GridSizes) do
		table.insert(grids, { label = g .. " stud", value = g })
	end
	choice(2, "📐 " .. t("ui.grid_size"), grids, s.grid or 1, "grid")
	local rots = {}
	for _, r in ipairs(GameConfig.RotationSteps) do
		table.insert(rots, { label = r .. "°", value = r })
	end
	choice(3, "🔄 " .. t("ui.rotation_step"), rots, s.rot or 90, "rot")
	local vols = { { label = "0%", value = 0 }, { label = "25%", value = 0.25 }, { label = "50%", value = 0.5 }, { label = "100%", value = 1 } }
	choice(4, "🎵 " .. t("ui.music"), vols, s.music or 0.5, "music")
	choice(5, "🔊 " .. t("ui.sfx"), vols, s.sfx or 0.8, "sfx")
	choice(6, "🖥️ " .. t("ui.low_graphics"), { { label = t("ui.on"), value = true }, { label = t("ui.off"), value = false } }, s.lowGfx == true, "lowGfx")
	Kit.button("🎓 " .. t("ui.restart_tutorial"), { parent = scroll, size = UDim2.new(1, -8, 0, 44), style = "plain", order = 10, onClick = function()
		NetDef.event("TutorialStep"):FireServer(0)
		Core.C.UI.close("Settings")
		if Core.C.Tutorial then
			Core.C.Tutorial.restart()
		end
	end })
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000120"><Properties><string name="Name">Shop</string><ProtectedString name="Source"><![CDATA[--!nonstrict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Monetization = require(Shared.Config.Monetization)
local Kit = require(script.Parent.Parent.Kit)
local Base = require(script.Parent.Parent.Base)

local t = Locale.t
local ICON = { gp_vip = "👑", gp_double_yen = "💴", gp_big_tray = "🍱", gp_express = "🚀", gp_starter = "🎁", dp_rush_hour = "🔔", dp_golden_sign = "🌟" }

return Base.make("Shop", "ui.shop", UDim2.fromScale(0.6, 0.72), function(content)
	local scroll = Kit.scroll({ Parent = content })
	local any = false
	for i, gp in ipairs(Monetization.GamePasses) do
		if gp.assetId ~= 0 then
			any = true
			local card, right = Kit.row(ICON[gp.id] or "🎟️", t("gp." .. gp.id), t("gpdesc." .. gp.id), 76)
			card.Parent = scroll
			card.LayoutOrder = i
			Kit.button("R$", { parent = right, size = UDim2.fromOffset(120, 38), style = "green", onClick = function()
				NetDef.event("BuyWithRobux"):FireServer("gamepass", gp.id)
			end })
		end
	end
	for i, p in ipairs(Monetization.Products) do
		if p.productId ~= 0 then
			any = true
			local icon = ICON[p.id] or (string.find(p.id, "sakura") and "🌸" or "💴")
			local card, right = Kit.row(icon, t("dp." .. p.id), t("dpdesc." .. p.id), 70)
			card.Parent = scroll
			card.LayoutOrder = 100 + i
			Kit.button("R$", { parent = right, size = UDim2.fromOffset(120, 38), style = "green", onClick = function()
				NetDef.event("BuyWithRobux"):FireServer("product", p.id)
			end })
		end
	end
	if not any then
		Kit.label("🛒 " .. t("ui.shop_soon"), { Parent = scroll, Size = UDim2.new(1, 0, 0, 80), TextSize = 20, TextXAlignment = Enum.TextXAlignment.Center })
	end
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000121"><Properties><string name="Name">Staff</string><ProtectedString name="Source"><![CDATA[--!nonstrict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Format = require(Shared.Util.Format)
local StaffCfg = require(Shared.Config.Staff)
local GameConfig = require(Shared.Config.GameConfig)
local Formulas = require(Shared.Logic.Formulas)
local Kit = require(script.Parent.Parent.Kit)
local Base = require(script.Parent.Parent.Base)
local Core = require(script.Parent.Parent.Parent.Core)

local t = Locale.t

local function slots(w)
	local n = StaffCfg.BaseSlots
	for zone, extra in pairs(StaffCfg.SlotsByZone) do
		if w.zones and w.zones[zone] then
			n += extra
		end
	end
	return math.min(n, GameConfig.MaxStaff)
end

return Base.make("Staff", "ui.staff", UDim2.fromScale(0.66, 0.78), function(content)
	local w = Core.C.Data.world or {}
	local L = Locale.get()
	local can = Core.C.Data.canBuild()
	local staff = w.staff or {}
	local scroll = Kit.scroll({ Parent = content })
	Kit.title(t("ui.staff_team", { n = #staff, max = slots(w) }), { Parent = scroll, Size = UDim2.new(1, 0, 0, 32), LayoutOrder = 0 })
	local hasManager = false
	for i, s in ipairs(staff) do
		local cfg = StaffCfg.byId[s.role]
		if cfg and cfg.manager then
			hasManager = true
		end
		local card, right = Kit.row(cfg and cfg.icon or "🧑", s.name .. " · " .. t("staff." .. s.role), t("ui.level_of", { level = s.lvl, max = StaffCfg.MaxTrainLevel }) .. "  ·  " .. t("ui.salary", { yen = cfg and cfg.salary or 0 }), 76)
		card.Parent = scroll
		card.LayoutOrder = i
		local row = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(170, 36), Parent = right }, { Kit.list(Enum.FillDirection.Horizontal, 4, Enum.HorizontalAlignment.Right) })
		if s.lvl < StaffCfg.MaxTrainLevel then
			Kit.button("⬆️ " .. Format.yen(Formulas.staffTrainCost(cfg.hire, s.lvl + 1), L), { parent = row, size = UDim2.fromOffset(120, 34), style = "gold", textSize = 14, order = 1, disabled = not can, onClick = function()
				NetDef.event("TrainStaff"):FireServer(s.u)
			end })
		end
		Kit.button("✕", { parent = row, size = UDim2.fromOffset(40, 34), style = "plain", order = 2, disabled = not can, onClick = function()
			NetDef.event("FireStaff"):FireServer(s.u)
		end })
	end
	if hasManager and can then
		local auto = Core.C.Data.m("settings") and Core.C.Data.m("settings").autoDay
		Kit.button((auto and "✅ " or "⬜ ") .. t("ui.auto_day"), { parent = scroll, size = UDim2.fromOffset(260, 40), style = "plain", order = 50, onClick = function()
			NetDef.event("SetSetting"):FireServer("autoDay", not auto)
		end })
	end
	Kit.title(t("ui.hire"), { Parent = scroll, Size = UDim2.new(1, 0, 0, 32), LayoutOrder = 60 })
	for _, cfg in ipairs(StaffCfg.list) do
		local card, right = Kit.row(cfg.icon, t("staff." .. cfg.id), t("staffdesc." .. cfg.id) .. "\n" .. t("ui.req_level", { level = cfg.lv }) .. "  ·  " .. t("ui.salary", { yen = cfg.salary }), 86)
		card.Parent = scroll
		card.LayoutOrder = 60 + cfg.order
		Kit.button(Format.yen(cfg.hire, L), { parent = right, size = UDim2.fromOffset(150, 38), style = "green", disabled = not can or (w.level or 1) < cfg.lv or #staff >= slots(w), onClick = function()
			NetDef.event("HireStaff"):FireServer(cfg.id)
		end })
	end
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000122"><Properties><string name="Name">Supplier</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Supplier tablet: order boxes of ingredients and dish sets.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Format = require(Shared.Util.Format)
local Ingredients = require(Shared.Config.Ingredients)
local Recipes = require(Shared.Config.Recipes)
local Upgrades = require(Shared.Config.Upgrades)
local GameConfig = require(Shared.Config.GameConfig)
local Kit = require(script.Parent.Parent.Kit)
local Base = require(script.Parent.Parent.Base)
local Core = require(script.Parent.Parent.Parent.Core)

local t = Locale.t
local T = Kit.Theme
local cart = {}

local function unlocked(w, ing)
	if w.licenses and w.licenses[ing.license] then
		return true
	end
	for _, r in ipairs(Recipes.list) do
		if r.city and w.franchise and r.city == w.franchise.city and table.find(r.ing, ing.id) then
			return true
		end
	end
	return false
end

local function stock(w, g)
	local shelf, boxes = 0, 0
	for _, slots in pairs(w.shelves or {}) do
		for _, s in pairs(slots) do
			if s.g == g then
				shelf += s.n
			end
		end
	end
	for _, b in ipairs(w.storage or {}) do
		if b.g == g then
			boxes += 1
		end
	end
	return shelf, boxes
end

local screen
screen = Base.make("Supplier", "ui.supplier", UDim2.fromScale(0.72, 0.78), function(content)
	local w = Core.C.Data.world or {}
	local discount = Upgrades.value(w.upgrades, "up_supplier")
	local L = Locale.get()
	local header = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), Parent = content })
	Kit.label(t("ui.supplier_info", { seconds = Upgrades.value(w.upgrades, "up_delivery"), boxes = #(w.storage or {}) }), { Parent = header, Size = UDim2.new(1, 0, 1, 0), TextSize = 16, TextColor3 = T.muted })
	local scroll = Kit.scroll({ Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 1, -100), Parent = content }, Kit.grid(200, discount > 0 and 170 or 140, 8))
	local total = 0
	for _, ing in ipairs(Ingredients.list) do
		if unlocked(w, ing) then
			local q = cart[ing.id] or { small = 0, big = 0 }
			total += q.small * ing.price + math.floor(q.big * ing.price * GameConfig.BigBoxMultiplier * (1 - discount) + 0.5)
			local card = Kit.card({ Size = UDim2.fromOffset(200, 140), LayoutOrder = ing.order, Parent = scroll })
			Kit.label(ing.icon, { Parent = card, Size = UDim2.fromOffset(36, 36), Position = UDim2.fromOffset(8, 6), TextScaled = true })
			Kit.label(t("ing." .. ing.id), { Parent = card, Position = UDim2.fromOffset(50, 6), Size = UDim2.new(1, -56, 0, 22), TextSize = 17, FontFace = T.bold, TextTruncate = Enum.TextTruncate.AtEnd })
			local shelf, boxes = stock(w, ing.id)
			Kit.label("🗄️ " .. shelf .. "   📦 " .. boxes, { Parent = card, Position = UDim2.fromOffset(50, 28), Size = UDim2.new(1, -56, 0, 18), TextSize = 14, TextColor3 = T.muted })
			local function qtyRow(y, kind, label, price)
				Kit.label(label .. "  " .. Format.yen(price, L), { Parent = card, Position = UDim2.fromOffset(8, y), Size = UDim2.new(1, -16, 0, 18), TextSize = 14 })
				local row = Kit.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(8, y + 20), Size = UDim2.new(1, -16, 0, 30), Parent = card }, { Kit.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center) })
				Kit.button("−", { parent = row, size = UDim2.fromOffset(36, 28), style = "plain", order = 1, onClick = function()
					q[kind] = math.max(0, q[kind] - 1)
					cart[ing.id] = q
					screen.refresh()
				end })
				Kit.label(tostring(q[kind]), { Parent = row, Size = UDim2.fromOffset(34, 28), TextXAlignment = Enum.TextXAlignment.Center, FontFace = T.bold, LayoutOrder = 2 })
				Kit.button("+", { parent = row, size = UDim2.fromOffset(36, 28), style = "green", order = 3, onClick = function()
					q[kind] = math.min(30, q[kind] + 1)
					cart[ing.id] = q
					screen.refresh()
				end })
			end
			qtyRow(52, "small", t("ui.box_units", { n = ing.units }), ing.price)
			if discount > 0 then
				card.Size = UDim2.fromOffset(200, 170)
				qtyRow(104, "big", t("ui.big_box_units", { n = ing.units * GameConfig.BigBoxMultiplier }), math.floor(ing.price * GameConfig.BigBoxMultiplier * (1 - discount) + 0.5))
			end
		end
	end
	local footer = Kit.new("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 1, -58), Size = UDim2.new(1, 0, 0, 56), Parent = content })
	Kit.label(t("ui.total") .. ": " .. Format.yen(total, L), { Parent = footer, Size = UDim2.new(0.4, 0, 1, 0), TextSize = 22, FontFace = T.title })
	Kit.button("🍽️ " .. t("ui.buy_dishes", { n = GameConfig.DishSetSize, price = GameConfig.DishSetPrice }), {
		parent = footer, size = UDim2.fromOffset(220, 46), position = UDim2.new(1, -400, 0, 5), style = "gold", textSize = 15,
		onClick = function()
			NetDef.event("BuyDishes"):FireServer(1)
		end,
	})
	Kit.button("🚚 " .. t("ui.order"), {
		parent = footer, size = UDim2.fromOffset(170, 46), position = UDim2.new(1, -170, 0, 5), style = "green", disabled = total == 0,
		onClick = function()
			NetDef.event("OrderSupplies"):FireServer(cart)
			cart = {}
			screen.refresh()
		end,
	})
end)

return screen
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000123"><Properties><string name="Name">Upgrades</string><ProtectedString name="Source"><![CDATA[--!nonstrict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Format = require(Shared.Util.Format)
local Upgrades = require(Shared.Config.Upgrades)
local Ads = require(Shared.Config.Ads)
local Kit = require(script.Parent.Parent.Kit)
local Base = require(script.Parent.Parent.Base)
local Core = require(script.Parent.Parent.Parent.Core)

local t = Locale.t

local function effectText(u, value, lvl)
	local L = Locale.get()
	if u.effect == "step" or u.effect == "walk" or u.effect == "shelf" then
		return math.floor(value * 100 + 0.5) .. "%"
	elseif u.effect == "delivery" then
		return value .. "s"
	elseif u.effect == "discount" then
		return "-" .. math.floor(value * 100 + 0.5) .. "%"
	elseif u.effect == "popularity" then
		return "+" .. Format.decimal(value, 2, L)
	elseif u.effect == "offline" then
		return value .. "h · " .. math.floor((u.pct[lvl + 1] or 0) * 100) .. "%"
	elseif u.effect == "autorestock" then
		return value > 0 and "✓" or "—"
	end
	return tostring(value)
end

return Base.make("Upgrades", "ui.upgrades", UDim2.fromScale(0.66, 0.76), function(content)
	local w = Core.C.Data.world or {}
	local L = Locale.get()
	local scroll = Kit.scroll({ Parent = content })
	local can = Core.C.Data.canBuild()
	for _, u in ipairs(Upgrades.list) do
		local lvl = (w.upgrades and w.upgrades[u.id]) or 0
		local now = effectText(u, u.values[lvl + 1], lvl)
		local sub = t("upgdesc." .. u.effect) .. "\n" .. t("ui.level_of", { level = lvl, max = u.max }) .. "  ·  " .. now
		if lvl < u.max then
			sub ..= " → " .. effectText(u, u.values[lvl + 2], lvl + 1)
		end
		local card, right = Kit.row(u.icon, t("upg." .. u.id), sub, 86)
		card.Parent = scroll
		card.LayoutOrder = u.order
		if lvl >= u.max then
			Kit.label("✅ MAX", { Parent = right, Size = UDim2.fromOffset(150, 26), TextXAlignment = Enum.TextXAlignment.Right, FontFace = Kit.Theme.bold, TextColor3 = Kit.Theme.green })
		else
			local need = u.levels[lvl + 1]
			Kit.label(t("ui.req_level", { level = need }), { Parent = right, Size = UDim2.fromOffset(150, 18), TextSize = 14, TextXAlignment = Enum.TextXAlignment.Right })
			Kit.button(Format.yen(u.costs[lvl + 1], L), { parent = right, size = UDim2.fromOffset(150, 36), style = "gold", disabled = not can or (w.level or 1) < need, onClick = function()
				NetDef.event("BuyUpgrade"):FireServer(u.id)
			end })
		end
	end
	Kit.title(t("ui.ads"), { Parent = scroll, Size = UDim2.new(1, 0, 0, 34), LayoutOrder = 100 })
	local day = (w.stats and w.stats.days or 0) + 1
	for _, ad in ipairs(Ads.list) do
		local active = w.ads and w.ads[ad.id] == day
		local card, right = Kit.row(ad.icon, t("ad." .. ad.id), t("ui.ad_desc", { pop = ad.popularity }) .. "\n" .. t("ui.req_level", { level = ad.lv }), 76)
		card.Parent = scroll
		card.LayoutOrder = 100 + ad.order
		if active then
			Kit.label("📣 " .. t("ui.active"), { Parent = right, Size = UDim2.fromOffset(150, 26), TextXAlignment = Enum.TextXAlignment.Right, FontFace = Kit.Theme.bold })
		else
			Kit.button(Format.yen(ad.cost, L), { parent = right, size = UDim2.fromOffset(150, 36), style = "gold", disabled = not can or (w.level or 1) < ad.lv, onClick = function()
				NetDef.event("BuyAd"):FireServer(ad.id)
			end })
		end
	end
end)
]]></ProtectedString></Properties></Item></Item></Item></Item></Item></Item><Item class="Workspace" referent="RBX000129"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">false</bool></Properties></Item><Item class="Lighting" referent="RBX000130"><Properties><string name="Name">Lighting</string><token name="Technology">4</token><bool name="GlobalShadows">true</bool><float name="Brightness">2.4</float><float name="EnvironmentDiffuseScale">1</float><float name="EnvironmentSpecularScale">1</float><float name="ClockTime">10</float></Properties></Item><Item class="SoundService" referent="RBX000131"><Properties><string name="Name">SoundService</string></Properties></Item></roblox>