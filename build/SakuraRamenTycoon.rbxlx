-- Ambience score, tiers and decoration set bonuses (pure).
local Ambience = {}

Ambience.Tiers = {
	{ min = 0, patience = 0, tip = 0, popularity = 0 },
	{ min = 30, patience = 0.10, tip = 0.05, popularity = 0.10 },
	{ min = 100, patience = 0.20, tip = 0.10, popularity = 0.25 },
	{ min = 250, patience = 0.30, tip = 0.18, popularity = 0.45 },
	{ min = 600, patience = 0.40, tip = 0.25, popularity = 0.70 },
}

function Ambience.tier(points)
	local idx = 1
	for i, t in ipairs(Ambience.Tiers) do
		if points >= t.min then
			idx = i
		end
	end
	return idx - 1, Ambience.Tiers[idx]
end

-- placed: list of placed entries; items: Items.byId; surfaces: Surfaces.byId;
-- zoneSurfaces: { [zoneId] = {floor = id, wall = id} }; extra: flat bonus points
-- sets: Sets.list
function Ambience.compute(placed, items, surfaces, zoneSurfaces, extra, sets)
	local counts = {}
	for _, e in ipairs(placed) do
		counts[e.i] = (counts[e.i] or 0) + 1
	end
	local points = extra or 0
	local maneki = 0
	for id, n in pairs(counts) do
		local item = items[id]
		if item then
			local amb = item.amb or 0
			for k = 1, n do
				points = points + amb * 0.8 ^ (k - 1)
			end
			if item.tipBonus then
				maneki = maneki + item.tipBonus * math.min(n, item.tipMax or n)
			end
		end
	end
	for _, s in pairs(zoneSurfaces or {}) do
		for _, sid in pairs(s) do
			local surf = surfaces[sid]
			if surf then
				points = points + surf.amb
			end
		end
	end
	local setTip, setPop, complete = 0, 0, {}
	for _, set in ipairs(sets or {}) do
		local all = true
		for _, id in ipairs(set.items) do
			if not counts[id] then
				all = false
				break
			end
		end
		if all then
			complete[set.id] = true
			setTip = setTip + (set.bonus.tip or 0)
			setPop = setPop + (set.bonus.popularity or 0)
		end
	end
	local tierIndex, tier = Ambience.tier(points)
	return {
		points = math.floor(points),
		tier = tierIndex,
		patience = tier.patience,
		tip = tier.tip + setTip + maneki,
		popularity = tier.popularity + setPop,
		sets = complete,
	}
end

return Ambience
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000029"><Properties><string name="Name">Footprint</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- 2D oriented rectangles on the XZ plane (pure). A footprint is {x, z, w, d, r} (r in degrees).
local Footprint = {}

function Footprint.new(x, z, w, d, r)
	return { x = x, z = z, w = w, d = d, r = r or 0 }
end

function Footprint.axes(fp)
	local a = math.rad(fp.r)
	-- local X axis and local Z axis expressed in world XZ (rotation around Y)
	local c, s = math.cos(a), math.sin(a)
	return { x = c, z = -s }, { x = s, z = c }
end

function Footprint.corners(fp)
	local ax, az = Footprint.axes(fp)
	local hw, hd = fp.w / 2, fp.d / 2
	local out = {}
	for _, sgn in ipairs({ { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }) do
		table.insert(out, {
			x = fp.x + ax.x * hw * sgn[1] + az.x * hd * sgn[2],
			z = fp.z + ax.z * hw * sgn[1] + az.z * hd * sgn[2],
		})
	end
	return out
end

function Footprint.bounds(fp)
	local minX, minZ, maxX, maxZ = math.huge, math.huge, -math.huge, -math.huge
	for _, c in ipairs(Footprint.corners(fp)) do
		minX = math.min(minX, c.x)
		minZ = math.min(minZ, c.z)
		maxX = math.max(maxX, c.x)
		maxZ = math.max(maxZ, c.z)
	end
	return minX, minZ, maxX, maxZ
end

local function project(corners, axis)
	local mn, mx = math.huge, -math.huge
	for _, c in ipairs(corners) do
		local p = c.x * axis.x + c.z * axis.z
		mn = math.min(mn, p)
		mx = math.max(mx, p)
	end
	return mn, mx
end

-- True when the rectangles overlap by more than `eps` (touching is allowed).
function Footprint.overlaps(a, b, eps)
	eps = eps or 0.05
	local ca, cb = Footprint.corners(a), Footprint.corners(b)
	local a1, a2 = Footprint.axes(a)
	local b1, b2 = Footprint.axes(b)
	for _, axis in ipairs({ a1, a2, b1, b2 }) do
		local amin, amax = project(ca, axis)
		local bmin, bmax = project(cb, axis)
		if amax - eps <= bmin or bmax - eps <= amin then
			return false
		end
	end
	return true
end

function Footprint.inflate(fp, by)
	return { x = fp.x, z = fp.z, w = fp.w + by * 2, d = fp.d + by * 2, r = fp.r }
end

function Footprint.rectToFp(rect)
	local x0, z0, x1, z1 = rect[1], rect[2], rect[3], rect[4]
	return { x = (x0 + x1) / 2, z = (z0 + z1) / 2, w = x1 - x0, d = z1 - z0, r = 0 }
end

function Footprint.pointInRect(x, z, rect, tol)
	tol = tol or 0
	return x >= rect[1] - tol and x <= rect[3] + tol and z >= rect[2] - tol and z <= rect[4] + tol
end

function Footprint.pointIn(fp, x, z, tol)
	tol = tol or 0
	local ax, az = Footprint.axes(fp)
	local dx, dz = x - fp.x, z - fp.z
	local lx = dx * ax.x + dz * ax.z
	local lz = dx * az.x + dz * az.z
	return math.abs(lx) <= fp.w / 2 + tol and math.abs(lz) <= fp.d / 2 + tol
end

-- Sample points (corners, edge midpoints, center) all inside the union of rects.
function Footprint.insideRects(fp, rects, tol)
	tol = tol or 0.01
	local pts = Footprint.corners(fp)
	local n = #pts
	for i = 1, n do
		local a, b = pts[i], pts[i % n + 1]
		table.insert(pts, { x = (a.x + b.x) / 2, z = (a.z + b.z) / 2 })
	end
	table.insert(pts, { x = fp.x, z = fp.z })
	for _, p in ipairs(pts) do
		local inside = false
		for _, r in ipairs(rects) do
			if Footprint.pointInRect(p.x, p.z, r, tol) then
				inside = true
				break
			end
		end
		if not inside then
			return false
		end
	end
	return true
end

-- Footprint of a wall segment {axis, line, a, b} with given thickness.
function Footprint.wallFp(seg, thickness)
	if seg.axis == "z" then
		return { x = (seg.a + seg.b) / 2, z = seg.line, w = seg.b - seg.a, d = thickness, r = 0 }
	end
	return { x = seg.line, z = (seg.a + seg.b) / 2, w = thickness, d = seg.b - seg.a, r = 0 }
end

-- Subtracts rect `hole` from rect `r`; returns up to 4 rects.
function Footprint.subtractRect(r, hole)
	local x0, z0, x1, z1 = r[1], r[2], r[3], r[4]
	local hx0, hz0 = math.max(x0, hole[1]), math.max(z0, hole[2])
	local hx1, hz1 = math.min(x1, hole[3]), math.min(z1, hole[4])
	if hx0 >= hx1 or hz0 >= hz1 then
		return { r }
	end
	local out = {}
	if hz0 > z0 then
		table.insert(out, { x0, z0, x1, hz0 })
	end
	if hz1 < z1 then
		table.insert(out, { x0, hz1, x1, z1 })
	end
	if hx0 > x0 then
		table.insert(out, { x0, hz0, hx0, hz1 })
	end
	if hx1 < x1 then
		table.insert(out, { hx1, hz0, x1, hz1 })
	end
	return out
end

return Footprint
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000030"><Properties><string name="Name">Formulas</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Pure game formulas (no Roblox APIs). See docs/03-BILANCIAMENTO.md §1.
local Formulas = {}

Formulas.MaxLevel = 50
Formulas.MasteryThresholds = { 25, 100, 500, 2000, 10000 }

function Formulas.round(x)
	return math.floor(x + 0.5)
end

function Formulas.xpForLevel(level)
	return Formulas.round(100 * level ^ 1.65)
end

-- Adds xp to (level, xp) and returns newLevel, newXp, levelsGained
function Formulas.addXp(level, xp, amount)
	xp = xp + amount
	local gained = 0
	while level < Formulas.MaxLevel and xp >= Formulas.xpForLevel(level) do
		xp = xp - Formulas.xpForLevel(level)
		level = level + 1
		gained = gained + 1
	end
	if level >= Formulas.MaxLevel then
		xp = math.min(xp, Formulas.xpForLevel(level))
	end
	return level, xp, gained
end

function Formulas.levelReward(level)
	return 50 * level * level, (level % 5 == 0) and 5 or 0
end

function Formulas.masteryLevel(served)
	local lvl = 0
	for i, t in ipairs(Formulas.MasteryThresholds) do
		if (served or 0) >= t then
			lvl = i
		end
	end
	return lvl
end

-- Price paid for a dish before tips.
function Formulas.dishPrice(basePrice, served, priceMult)
	local m = Formulas.masteryLevel(served)
	return Formulas.round(basePrice * (1 + 0.05 * m) * (priceMult or 1))
end

-- Relative order probability for a menu price multiplier (0.7 .. 1.3)
function Formulas.demandFactor(priceMult)
	return math.max(0.1, 1 - 1.2 * ((priceMult or 1) - 1))
end

function Formulas.patienceFactor(priceMult)
	return math.clamp(1 - 0.5 * ((priceMult or 1) - 1), 0.75, 1.2)
end

-- opts: fresh(bool), ambienceTip, comfort (0-5), patienceLeft (0-1), customerTip, extraTip
function Formulas.tip(price, opts)
	local pct = 0.05
	if opts.fresh then
		pct = pct + (opts.freshBonus or 0.10)
	end
	pct = pct + (opts.ambienceTip or 0)
	pct = pct + 0.02 * (opts.comfort or 0)
	pct = pct + 0.10 * math.clamp(opts.patienceLeft or 0, 0, 1)
	pct = pct + (opts.extraTip or 0)
	return Formulas.round(price * pct * (opts.customerTip or 1))
end

-- Review stars (1..5). opts: patienceLeft, dirtyNearby, fresh, ambienceTier (0..4), comfort (0..5), left (walked out)
function Formulas.review(opts)
	if opts.left then
		return 1
	end
	local used = 1 - math.clamp(opts.patienceLeft or 1, 0, 1)
	local wait = 0
	if used > 0.5 then
		wait = (used - 0.5) / 0.5 * 2
	end
	local stars = 4.2 - wait
	if opts.dirtyNearby then
		stars = stars - 0.5
	end
	if opts.fresh then
		stars = stars + (opts.freshBonus or 0.3)
	end
	stars = stars + 0.125 * (opts.ambienceTier or 0)
	stars = stars + 0.06 * (opts.comfort or 0)
	return math.clamp(Formulas.round(stars * 2) / 2, 1, 5)
end

-- Weighted average of recent reviews { {s = stars, w = weight}, ... }
function Formulas.rating(recent, default)
	local sum, weight = 0, 0
	for _, r in ipairs(recent or {}) do
		sum = sum + r.s * (r.w or 1)
		weight = weight + (r.w or 1)
	end
	if weight == 0 then
		return default or 3
	end
	return sum / weight
end

-- opts: level, rating, ambience (tier popularity), sign, ads, sets, event, extra
function Formulas.popularity(opts)
	local p = 0.15 * ((opts.level or 1) / 10)
		+ 0.35 * ((opts.rating or 3) - 3)
		+ (opts.ambience or 0)
		+ (opts.sign or 0)
		+ (opts.ads or 0)
		+ (opts.sets or 0)
		+ (opts.event or 0)
		+ (opts.extra or 0)
	return math.max(0, p)
end

function Formulas.customerInterval(base, minInterval, popularity, peak, peakFactor, rush)
	local v = math.max(minInterval, base / (1 + popularity))
	if peak then
		v = v * (peakFactor or 0.6)
	end
	if rush then
		v = v * 0.5
	end
	return math.max(minInterval * 0.5, v)
end

function Formulas.staffTrainCost(hire, nextLevel)
	return Formulas.round(hire * 0.8 * 2.2 ^ (nextLevel - 2))
end

function Formulas.staffSpeed(level, perLevel, managerBonus)
	return 1 + (perLevel or 0.15) * ((level or 1) - 1) + (managerBonus or 0)
end

function Formulas.offlineEarnings(hourly, pct, hours)
	return Formulas.round(math.max(0, hourly) * pct * hours)
end

function Formulas.questTarget(base, perLevel, level)
	return math.max(1, Formulas.round(base + perLevel * level))
end

function Formulas.yenPack(baseYen, level, scale)
	return Formulas.round(baseYen * (1 + level * (scale or 0.2)))
end

-- Multiplier applied to every yen income: VIP/2x passes, franchise stars, boosts
function Formulas.incomeMultiplier(opts)
	local m = 1 + (opts.franchiseStars or 0) * (opts.yenPerStar or 0.25)
	m = m * (opts.passMult or 1)
	return m
end

return Formulas
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000031"><Properties><string name="Name">Geometry</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Unlocked restaurant geometry (zones, openings, stairs, walls, door clearances) computed from
-- the owner's `zones` map. Shared by the server world builder and the client build preview.
local Walls = require(script.Parent.Walls)

local Geometry = {}

-- expansions: Config.Expansions.list ; unlocked: { [expansionId] = true }
function Geometry.compute(expansions, unlocked, supplier)
	local zones, openings, stairs, exps = {}, {}, {}, {}
	for _, e in ipairs(expansions) do
		if unlocked[e.id] then
			table.insert(exps, e)
			for _, z in ipairs(e.zones or {}) do
				table.insert(zones, z)
			end
			for _, o in ipairs(e.openings or {}) do
				table.insert(openings, o)
			end
			for _, s in ipairs(e.stairs or {}) do
				table.insert(stairs, s)
			end
		end
	end
	local fixed = {}
	for _, o in ipairs(openings) do
		if o.axis == "z" then
			table.insert(fixed, { floor = o.floor, rect = { o.from, o.at - 2.5, o.to, o.at + 2.5 } })
		else
			table.insert(fixed, { floor = o.floor, rect = { o.at - 2.5, o.from, o.at + 2.5, o.to } })
		end
	end
	for _, s in ipairs(stairs) do
		local r = s.rect
		table.insert(fixed, { floor = s.floor, rect = { r[1], r[2] - 2.5, r[3], r[2] } })
		table.insert(fixed, { floor = s.floor + 1, rect = { r[1], r[4], r[3], r[4] + 2.5 } })
	end
	-- machiya facade details (lattice, bamboo fence, pines, menu board) in front of the street wall
	table.insert(fixed, { floor = 0, rect = { -60, -1.6, 50, 0 } })
	table.insert(fixed, { floor = 0, rect = { -10.2, -3.6, -7, -1.6 } })
	if supplier then
		table.insert(fixed, { floor = 0, rect = { supplier.x - 1.2, supplier.z - 1.5, supplier.x + 0.3, supplier.z + 1.5 } })
	end
	return {
		zones = zones,
		openings = openings,
		stairs = stairs,
		expansions = exps,
		walls = Walls.compute(zones, openings, stairs),
		fixed = fixed,
	}
end

function Geometry.ctx(geo, items, placed, cfg)
	return {
		items = items,
		zones = geo.zones,
		walls = geo.walls,
		stairs = geo.stairs,
		placed = placed,
		fixed = geo.fixed,
		entrance = { x = 0, z = 0.75 },
		floorHeight = cfg.FloorHeight,
		wallHeight = cfg.WallHeight,
		wallThickness = 0.8,
	}
end

return Geometry
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000032"><Properties><string name="Name">Grid</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Grid snapping helpers (pure).
local Grid = {}

function Grid.normRot(deg)
	deg = deg % 360
	if deg < 0 then
		deg = deg + 360
	end
	return deg
end

-- Axis-aligned extents of a w x d rectangle rotated by deg around Y.
function Grid.aabb(w, d, deg)
	local r = math.rad(deg)
	local c, s = math.abs(math.cos(r)), math.abs(math.sin(r))
	return w * c + d * s, w * s + d * c
end

function Grid.snapValue(v, g)
	return math.floor(v / g + 0.5) * g
end

-- Snaps the footprint's minimum corner to the grid (relative to origin 0,0) and returns the center.
function Grid.snapFloor(x, z, w, d, deg, g)
	local ew, ed = Grid.aabb(w, d, deg)
	local minX = Grid.snapValue(x - ew / 2, g)
	local minZ = Grid.snapValue(z - ed / 2, g)
	return minX + ew / 2, minZ + ed / 2
end

-- Snaps a position along a wall (1D) and a height.
function Grid.snapWall(along, y, w, h, g, floorY)
	local a = Grid.snapValue(along - w / 2, g) + w / 2
	local yy = Grid.snapValue(y - h / 2 - floorY, math.min(g, 5)) + h / 2 + floorY
	return a, yy
end

function Grid.nextRotation(deg, step)
	return Grid.normRot(deg + step)
end

return Grid
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000033"><Properties><string name="Name">Pathgrid</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Walkability check used when placing objects: every seat must stay reachable from the
-- entrance, the kitchen and the storage must stay reachable, stairs must stay usable.
-- Works on a 0.5-stud grid per floor (pure).
local Footprint = require(script.Parent.Footprint)
local Walls = require(script.Parent.Walls)

local Pathgrid = {}

local CELL = 0.5
local WALL_CLEAR = 0.4 + 0.6 -- half wall thickness + body radius

-- ctx: { zones = {...}, walls = Walls.compute(...) result, stairs = {...}, entrance = {x, z} }
-- obstacles: list of { fp = footprint, floor = n }
-- targets: list of { floor, x, z, radius, label }
function Pathgrid.check(ctx, obstacles, targets, clearance)
	clearance = clearance or 0.8
	local byFloor = {}
	for _, z in ipairs(ctx.zones) do
		byFloor[z.floor] = byFloor[z.floor] or { rects = {} }
		table.insert(byFloor[z.floor].rects, z.rect)
	end
	local grids = {}
	local function grid(floor)
		if grids[floor] then
			return grids[floor]
		end
		local f = byFloor[floor]
		if not f then
			return nil
		end
		local minX, minZ, maxX, maxZ = math.huge, math.huge, -math.huge, -math.huge
		for _, r in ipairs(f.rects) do
			minX, minZ = math.min(minX, r[1]), math.min(minZ, r[2])
			maxX, maxZ = math.max(maxX, r[3]), math.max(maxZ, r[4])
		end
		local nx = math.floor((maxX - minX) / CELL + 0.5)
		local nz = math.floor((maxZ - minZ) / CELL + 0.5)
		local g = { minX = minX, minZ = minZ, nx = nx, nz = nz, free = {} }
		local floorWalls = ctx.walls[floor] or { walls = {}, rails = {} }
		local free = g.free
		-- visit every cell whose center lies inside the box [x0,x1] x [z0,z1]
		local function each(x0, z0, x1, z1, fn)
			local i0 = math.max(0, math.ceil((x0 - minX) / CELL - 0.5))
			local i1 = math.min(nx - 1, math.floor((x1 - minX) / CELL - 0.5))
			local j0 = math.max(0, math.ceil((z0 - minZ) / CELL - 0.5))
			local j1 = math.min(nz - 1, math.floor((z1 - minZ) / CELL - 0.5))
			for i = i0, i1 do
				for j = j0, j1 do
					fn(i, j, minX + (i + 0.5) * CELL, minZ + (j + 0.5) * CELL)
				end
			end
		end
		for _, r in ipairs(f.rects) do
			each(r[1], r[2], r[3], r[4], function(i, j)
				free[i * nz + j] = true
			end)
		end
		local function clearBox(x0, z0, x1, z1)
			each(x0, z0, x1, z1, function(i, j)
				free[i * nz + j] = nil
			end)
		end
		for _, s in ipairs(ctx.stairs or {}) do
			if s.floor == floor - 1 then
				clearBox(s.rect[1], s.rect[2], s.rect[3], s.rect[4])
			end
		end
		for _, list in ipairs({ floorWalls.walls, floorWalls.rails }) do
			for _, seg in ipairs(list) do
				if seg.axis == "z" then
					clearBox(seg.a - WALL_CLEAR, seg.line - WALL_CLEAR, seg.b + WALL_CLEAR, seg.line + WALL_CLEAR)
				else
					clearBox(seg.line - WALL_CLEAR, seg.a - WALL_CLEAR, seg.line + WALL_CLEAR, seg.b + WALL_CLEAR)
				end
			end
		end
		for _, o in ipairs(obstacles) do
			if o.floor == floor then
				local fp = Footprint.inflate(o.fp, clearance)
				local bx0, bz0, bx1, bz1 = Footprint.bounds(fp)
				each(bx0, bz0, bx1, bz1, function(i, j, x, z)
					if Footprint.pointIn(fp, x, z) then
						free[i * nz + j] = nil
					end
				end)
			end
		end
		grids[floor] = g
		return g
	end

	local function cellOf(g, x, z)
		return math.floor((x - g.minX) / CELL), math.floor((z - g.minZ) / CELL)
	end

	local reached = {}
	local function flood(floor, sx, sz)
		local g = grid(floor)
		if not g then
			return
		end
		reached[floor] = reached[floor] or {}
		local seen = reached[floor]
		-- start from the nearest free cell within 2 studs of the start point
		local si, sj = cellOf(g, sx, sz)
		local start = nil
		for radius = 0, 4 do
			for di = -radius, radius do
				for dj = -radius, radius do
					local i, j = si + di, sj + dj
					if not start and i >= 0 and j >= 0 and i < g.nx and j < g.nz and g.free[i * g.nz + j] then
						start = { i, j }
					end
				end
			end
			if start then
				break
			end
		end
		if not start then
			return
		end
		local queue = { start }
		local head = 1
		seen[start[1] * g.nz + start[2]] = true
		while head <= #queue do
			local c = queue[head]
			head = head + 1
			local i, j = c[1], c[2]
			for _, d in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
				local ni, nj = i + d[1], j + d[2]
				if ni >= 0 and nj >= 0 and ni < g.nx and nj < g.nz then
					local id = ni * g.nz + nj
					if g.free[id] and not seen[id] then
						seen[id] = true
						table.insert(queue, { ni, nj })
					end
				end
			end
		end
	end

	local function isReached(floor, x, z, radius)
		local g = grid(floor)
		if not g or not reached[floor] then
			return false
		end
		local ci, cj = cellOf(g, x, z)
		local cells = math.ceil(radius / CELL)
		for di = -cells, cells do
			for dj = -cells, cells do
				local i, j = ci + di, cj + dj
				if i >= 0 and j >= 0 and i < g.nx and j < g.nz and reached[floor][i * g.nz + j] then
					local px = g.minX + (i + 0.5) * CELL
					local pz = g.minZ + (j + 0.5) * CELL
					if (px - x) ^ 2 + (pz - z) ^ 2 <= radius * radius then
						return true
					end
				end
			end
		end
		return false
	end

	-- Floor 0 from the entrance, upper floors from the top of their stairs
	flood(0, ctx.entrance.x, ctx.entrance.z)
	local stairs = ctx.stairs or {}
	table.sort(stairs, function(a, b)
		return a.floor < b.floor
	end)
	for _, s in ipairs(stairs) do
		local r = s.rect
		local cx = (r[1] + r[3]) / 2
		if isReached(s.floor, cx, r[2] - 0.5, 1.6) then
			flood(s.floor + 1, cx, r[4] + 1)
		end
	end
	local function isReachedRect(floor, rect)
		local g = grid(floor)
		if not g or not reached[floor] then
			return false
		end
		for id in pairs(reached[floor]) do
			local i = math.floor(id / g.nz)
			local j = id - i * g.nz
			local px = g.minX + (i + 0.5) * CELL
			local pz = g.minZ + (j + 0.5) * CELL
			if Footprint.pointInRect(px, pz, rect) then
				return true
			end
		end
		return false
	end
	for _, t in ipairs(targets) do
		local ok
		if t.rect then
			ok = isReachedRect(t.floor, t.rect)
		else
			ok = isReached(t.floor, t.x, t.z, t.radius or 2)
		end
		if not ok then
			return false, t.label
		end
	end
	return true
end

return Pathgrid
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000034"><Properties><string name="Name">Placement</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Placement validation shared by the client preview and the server (pure).
--
-- ctx = {
--   items = Items.byId, zones = { unlocked zone configs }, walls = Walls.compute(...),
--   stairs = { {floor, rect} }, placed = { placed entries }, fixed = { {floor, rect} },
--   entrance = {x, z}, floorHeight = 15, wallHeight = 14, wallThickness = 0.8,
--   extraTargets = { pathgrid targets },
-- }
-- req = { i = itemId, x, y, z, r, f, s, p, u (when moving an existing object) }
local Footprint = require(script.Parent.Footprint)
local Walls = require(script.Parent.Walls)
local Pathgrid = require(script.Parent.Pathgrid)

local Placement = {}

local PLACE_CODE = { floor = "f", wall = "w", ceiling = "c", top = "t" }
Placement.PlaceCode = PLACE_CODE

local SURFACE_FN = { counter = true, table = true, booth = true }

local function contains(list, v)
	for _, x in ipairs(list) do
		if x == v then
			return true
		end
	end
	return false
end

function Placement.floorY(ctx, f)
	return (f or 0) * ctx.floorHeight
end

function Placement.footprint(ctx, entry)
	local item = ctx.items[entry.i]
	return Footprint.new(entry.x, entry.z, item.size[1], item.size[3], entry.r or 0)
end

-- World-space axis aligned box {x0,y0,z0,x1,y1,z1} of a placed entry (rotations multiple of 90 for walls)
function Placement.box(ctx, entry)
	local item = ctx.items[entry.i]
	local fp = Placement.footprint(ctx, entry)
	local x0, z0, x1, z1 = Footprint.bounds(fp)
	local y0
	if entry.s == "f" then
		y0 = Placement.floorY(ctx, entry.f)
	elseif entry.s == "c" then
		y0 = Placement.floorY(ctx, entry.f) + ctx.wallHeight - item.size[2]
	else
		y0 = (entry.y or 0) - item.size[2] / 2
	end
	return { x0, y0, z0, x1, y0 + item.size[2], z1 }
end

local function boxesOverlap(a, b, eps)
	eps = eps or 0.05
	return a[1] < b[4] - eps and b[1] < a[4] - eps and a[2] < b[5] - eps and b[2] < a[5] - eps and a[3] < b[6] - eps and b[3] < a[6] - eps
end

local function zoneRects(ctx, floor, areas, indoorOnly)
	local out = {}
	for _, z in ipairs(ctx.zones) do
		if z.floor == floor and contains(areas, z.area) and not (indoorOnly and z.outdoor) then
			table.insert(out, z.rect)
		end
	end
	return out
end

-- Pathgrid targets for the current layout (seats, kitchen, storage, stairs, terrace gap)
function Placement.pathTargets(ctx, placed)
	local targets = {}
	for _, e in ipairs(placed) do
		local item = ctx.items[e.i]
		if item and item.fn and e.s == "f" then
			if item.fn.type == "seat" then
				table.insert(targets, { floor = e.f or 0, x = e.x, z = e.z, radius = math.max(item.size[1], item.size[3]) / 2 + 1.5, label = "msg.place_blocks_seat" })
			elseif item.fn.type == "booth" then
				table.insert(targets, { floor = e.f or 0, x = e.x, z = e.z, radius = math.max(item.size[1], item.size[3]) / 2 + 1.5, label = "msg.place_blocks_seat" })
			elseif item.fn.type == "shelf" or item.fn.type == "station" or item.fn.type == "rack" then
				table.insert(targets, { floor = e.f or 0, x = e.x, z = e.z, radius = math.max(item.size[1], item.size[3]) / 2 + 1.5, label = "msg.place_blocks_work" })
			end
		end
	end
	for _, z in ipairs(ctx.zones) do
		if z.area == "kitchen" or z.area == "storage" then
			table.insert(targets, { floor = z.floor, rect = z.rect, label = "msg.place_blocks_path" })
		end
	end
	for _, s in ipairs(ctx.stairs or {}) do
		local r = s.rect
		table.insert(targets, { floor = s.floor, x = (r[1] + r[3]) / 2, z = r[2] - 0.5, radius = 1.6, label = "msg.place_blocks_stairs" })
	end
	for _, t in ipairs(ctx.extraTargets or {}) do
		table.insert(targets, t)
	end
	return targets
end

function Placement.pathOk(ctx, placed)
	local obstacles = {}
	for _, e in ipairs(placed) do
		local item = ctx.items[e.i]
		if item and e.s == "f" and not item.walkable then
			table.insert(obstacles, { fp = Placement.footprint(ctx, e), floor = e.f or 0 })
		end
	end
	return Pathgrid.check(ctx, obstacles, Placement.pathTargets(ctx, placed))
end

-- Returns ok, reasonKey, resolved (req with y filled in)
function Placement.validate(ctx, req, skipPath)
	local item = ctx.items[req.i]
	if not item then
		return false, "msg.invalid"
	end
	local code = PLACE_CODE[item.place]
	if req.s ~= code then
		return false, "msg.invalid"
	end
	local f = req.f or 0
	local floorY = Placement.floorY(ctx, f)
	local w, h, d = item.size[1], item.size[2], item.size[3]
	local fp = Footprint.new(req.x, req.z, w, d, req.r or 0)
	local resolved = { i = req.i, x = req.x, z = req.z, r = req.r or 0, f = f, s = code, p = req.p, u = req.u }
	local floorWalls = ctx.walls[f] or { walls = {}, rails = {} }

	local others = {}
	for _, e in ipairs(ctx.placed) do
		if e.u ~= req.u then
			table.insert(others, e)
		end
	end

	if code == "f" then
		resolved.y = floorY
		if not Footprint.insideRects(fp, zoneRects(ctx, f, item.areas, false)) then
			return false, "msg.place_area"
		end
		for _, list in ipairs({ floorWalls.walls, floorWalls.rails }) do
			for _, seg in ipairs(list) do
				if Footprint.overlaps(fp, Footprint.wallFp(seg, ctx.wallThickness), 0.02) then
					return false, "msg.place_wall"
				end
			end
		end
		for _, s in ipairs(ctx.stairs or {}) do
			if (s.floor == f or s.floor == f - 1) and Footprint.overlaps(fp, Footprint.rectToFp(s.rect), 0.02) then
				return false, "msg.place_stairs"
			end
		end
		for _, fx in ipairs(ctx.fixed or {}) do
			if fx.floor == f and Footprint.overlaps(fp, Footprint.rectToFp(fx.rect), 0.02) then
				return false, "msg.place_door"
			end
		end
		for _, e in ipairs(others) do
			if e.s == "f" and (e.f or 0) == f then
				if Footprint.overlaps(fp, Placement.footprint(ctx, e)) then
					return false, "msg.place_overlap"
				end
			elseif e.s == "w" and (e.f or 0) == f then
				local box = { 0, floorY, 0, 0, floorY + h, 0 }
				local x0, z0, x1, z1 = Footprint.bounds(fp)
				box[1], box[3], box[4], box[6] = x0, z0, x1, z1
				if boxesOverlap(box, Placement.box(ctx, e)) then
					return false, "msg.place_overlap"
				end
			end
		end
		if not skipPath and not item.walkable then
			local layout = table.clone(others)
			table.insert(layout, resolved)
			local ok, reason = Placement.pathOk(ctx, layout)
			if not ok then
				return false, reason or "msg.place_blocks_path"
			end
		end
		return true, nil, resolved
	elseif code == "w" then
		local half = ctx.wallThickness / 2 + d / 2
		local best, bestErr = nil, math.huge
		for _, seg in ipairs(floorWalls.walls) do
			local dist
			if seg.axis == "z" then
				dist = math.abs(req.z - seg.line)
			else
				dist = math.abs(req.x - seg.line)
			end
			local along = Walls.along(seg, req.x, req.z)
			if math.abs(dist - half) < 0.2 and along - w / 2 >= seg.a - 0.01 and along + w / 2 <= seg.b + 0.01 then
				if math.abs(dist - half) < bestErr then
					best, bestErr = seg, math.abs(dist - half)
				end
			end
		end
		if not best then
			return false, "msg.place_wall_only"
		end
		-- facing away from the wall
		local rot
		if best.axis == "z" then
			rot = (req.z < best.line) and 0 or 180
			resolved.z = best.line + ((req.z < best.line) and -half or half)
		else
			rot = (req.x < best.line) and 90 or 270
			resolved.x = best.line + ((req.x < best.line) and -half or half)
		end
		resolved.r = rot
		local y = req.y or (floorY + 6)
		if y - h / 2 < floorY + 0.3 or y + h / 2 > floorY + ctx.wallHeight - 0.3 then
			return false, "msg.place_height"
		end
		resolved.y = y
		local insideArea = false
		for _, z in ipairs(ctx.zones) do
			if z.floor == f and not z.outdoor and contains(item.areas, z.area) and Footprint.pointInRect(resolved.x, resolved.z, z.rect) then
				insideArea = true
			end
		end
		if not insideArea then
			return false, "msg.place_area"
		end
		local myBox = Placement.box(ctx, resolved)
		for _, e in ipairs(others) do
			if (e.f or 0) == f and (e.s == "w" or e.s == "f") then
				if boxesOverlap(myBox, Placement.box(ctx, e)) then
					return false, "msg.place_overlap"
				end
			end
		end
		return true, nil, resolved
	elseif code == "c" then
		resolved.y = floorY + ctx.wallHeight - h / 2
		if not Footprint.insideRects(fp, zoneRects(ctx, f, item.areas, true)) then
			return false, "msg.place_area"
		end
		for _, s in ipairs(ctx.stairs or {}) do
			if s.floor == f and Footprint.overlaps(fp, Footprint.rectToFp(s.rect), 0.02) then
				return false, "msg.place_stairs"
			end
		end
		for _, e in ipairs(others) do
			if e.s == "c" and (e.f or 0) == f and Footprint.overlaps(fp, Placement.footprint(ctx, e)) then
				return false, "msg.place_overlap"
			end
		end
		return true, nil, resolved
	elseif code == "t" then
		local parent = nil
		for _, e in ipairs(others) do
			if e.u == req.p then
				parent = e
			end
		end
		if not parent then
			return false, "msg.place_top_only"
		end
		local pItem = ctx.items[parent.i]
		if not (pItem and pItem.fn and SURFACE_FN[pItem.fn.type]) then
			return false, "msg.place_top_only"
		end
		resolved.f = parent.f or 0
		resolved.y = Placement.floorY(ctx, resolved.f) + pItem.size[2]
		local pfp = Placement.footprint(ctx, parent)
		for _, c in ipairs(Footprint.corners(fp)) do
			if not Footprint.pointIn(pfp, c.x, c.z, -0.05) then
				return false, "msg.place_top_only"
			end
		end
		for _, e in ipairs(others) do
			if e.s == "t" and e.p == req.p and Footprint.overlaps(fp, Placement.footprint(ctx, e)) then
				return false, "msg.place_overlap"
			end
		end
		return true, nil, resolved
	end
	return false, "msg.invalid"
end

return Placement
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000035"><Properties><string name="Name">Walls</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Computes wall and railing segments from the unlocked zones (pure).
-- Segment: { axis = "z" (runs along X at z = line) | "x" (runs along Z at x = line), line, a, b, floor, kind }
-- Wall segments separate indoor cells from outside or from another room.
-- Railings surround outdoor zones (and stair holes on upper floors).
local Walls = {}

local CELL = 1

local function key(x, z)
	return x .. "," .. z
end

local function floorCells(zones, floor)
	local cells = {}
	for _, z in ipairs(zones) do
		if z.floor == floor then
			local r = z.rect
			for x = r[1], r[3] - CELL, CELL do
				for zz = r[2], r[4] - CELL, CELL do
					cells[key(x, zz)] = { room = z.outdoor and "_outdoor" or (z.room or "main"), outdoor = z.outdoor, zone = z.id }
				end
			end
		end
	end
	return cells
end

local function merge(edges, floor, kind)
	-- edges: list of {axis, line, a, b}; merge contiguous ones on the same line
	local groups = {}
	for _, e in ipairs(edges) do
		local k = e.axis .. ":" .. e.line
		groups[k] = groups[k] or { axis = e.axis, line = e.line, list = {} }
		table.insert(groups[k].list, e)
	end
	local out = {}
	for _, g in pairs(groups) do
		table.sort(g.list, function(p, q)
			return p.a < q.a
		end)
		local cur = nil
		for _, e in ipairs(g.list) do
			if cur and math.abs(cur.b - e.a) < 1e-6 then
				cur.b = e.b
			else
				if cur then
					table.insert(out, cur)
				end
				cur = { axis = g.axis, line = g.line, a = e.a, b = e.b, floor = floor, kind = kind }
			end
		end
		if cur then
			table.insert(out, cur)
		end
	end
	table.sort(out, function(p, q)
		if p.axis ~= q.axis then
			return p.axis < q.axis
		end
		if p.line ~= q.line then
			return p.line < q.line
		end
		return p.a < q.a
	end)
	return out
end

-- Removes the intervals of `cuts` ({axis, at, from, to}) from the segments.
local function cut(segments, cuts)
	local result = segments
	for _, c in ipairs(cuts) do
		local next = {}
		for _, s in ipairs(result) do
			if s.axis == c.axis and math.abs(s.line - c.at) < 1e-6 and c.to > s.a and c.from < s.b then
				if c.from > s.a then
					table.insert(next, { axis = s.axis, line = s.line, a = s.a, b = c.from, floor = s.floor, kind = s.kind })
				end
				if c.to < s.b then
					table.insert(next, { axis = s.axis, line = s.line, a = c.to, b = s.b, floor = s.floor, kind = s.kind })
				end
			else
				table.insert(next, s)
			end
		end
		result = next
	end
	return result
end

-- zones: unlocked zone configs; openings: list; stairs: list {floor, rect}
function Walls.compute(zones, openings, stairs)
	local floors = {}
	for _, z in ipairs(zones) do
		floors[z.floor] = true
	end
	local result = {}
	for floor in pairs(floors) do
		local cells = floorCells(zones, floor)
		local below = floor > 0 and floorCells(zones, floor - 1) or nil
		local wallEdges, railEdges = {}, {}
		for k, c in pairs(cells) do
			local sx, sz = k:match("^(-?[%d%.]+),(-?[%d%.]+)$")
			local x, z = tonumber(sx), tonumber(sz)
			local neighbours = {
				{ dx = -CELL, dz = 0, axis = "x", line = x, a = z, b = z + CELL },
				{ dx = CELL, dz = 0, axis = "x", line = x + CELL, a = z, b = z + CELL },
				{ dx = 0, dz = -CELL, axis = "z", line = z, a = x, b = x + CELL },
				{ dx = 0, dz = CELL, axis = "z", line = z + CELL, a = x, b = x + CELL },
			}
			for _, nb in ipairs(neighbours) do
				local other = cells[key(x + nb.dx, z + nb.dz)]
				local edge = { axis = nb.axis, line = nb.line, a = nb.a, b = nb.b }
				if not c.outdoor then
					if not other then
						table.insert(wallEdges, edge)
					elseif other.room ~= c.room and not other.outdoor and c.room < other.room then
						table.insert(wallEdges, edge)
					elseif other.outdoor then
						table.insert(wallEdges, edge)
					end
				else
					if not other then
						-- outdoor edge that faces nothing: railing, unless the building below continues (rooftop parapet still needed)
						table.insert(railEdges, edge)
					end
				end
			end
		end
		local floorOpenings = {}
		for _, o in ipairs(openings) do
			if o.floor == floor then
				table.insert(floorOpenings, o)
			end
		end
		local walls = cut(merge(wallEdges, floor, "wall"), floorOpenings)
		local gaps = {}
		for _, z in ipairs(zones) do
			if z.floor == floor and z.gaps then
				for _, g in ipairs(z.gaps) do
					table.insert(gaps, g)
				end
			end
		end
		local rails = cut(merge(railEdges, floor, "rail"), gaps)
		-- railing around stair holes on this floor (stairs that start on floor - 1)
		for _, s in ipairs(stairs) do
			if s.floor == floor - 1 then
				local r = s.rect
				table.insert(rails, { axis = "x", line = r[1], a = r[2], b = r[4], floor = floor, kind = "rail" })
				table.insert(rails, { axis = "x", line = r[3], a = r[2], b = r[4], floor = floor, kind = "rail" })
				table.insert(rails, { axis = "z", line = r[2], a = r[1], b = r[3], floor = floor, kind = "rail" })
			end
		end
		local _ = below
		result[floor] = { walls = walls, rails = rails }
	end
	return result
end

-- Distance from point to segment (on the XZ plane)
function Walls.distance(seg, x, z)
	if seg.axis == "z" then
		local cx = math.clamp(x, seg.a, seg.b)
		return math.sqrt((x - cx) ^ 2 + (z - seg.line) ^ 2)
	end
	local cz = math.clamp(z, seg.a, seg.b)
	return math.sqrt((x - seg.line) ^ 2 + (z - cz) ^ 2)
end

-- Position along the segment for a point
function Walls.along(seg, x, z)
	if seg.axis == "z" then
		return x
	end
	return z
end

return Walls
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000050"><Properties><string name="Name">Models</string></Properties><Item class="Folder" referent="RBX000045"><Properties><string name="Name">Builders</string></Properties><Item class="ModuleScript" referent="RBX000037"><Properties><string name="Name">Building</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Building shell pieces used by the server WorldService (floors, walls, roof, stairs, facade).
-- All coordinates are world coordinates (the plot origin is the world origin).
local CollectionService = game:GetService("CollectionService")

local Kit = require(script.Parent.Parent.Kit)
local P = require(script.Parent.Parent.Palette)
local Color = require(script.Parent.Parent.Parent.Util.Color)
local M = P.M

local JP_FONT = Font.new("rbxasset://fonts/families/FredokaOne.json", Enum.FontWeight.Bold)
local B = {}

local function tag(part, name, attrs)
	CollectionService:AddTag(part, name)
	if attrs then
		for k, v in pairs(attrs) do
			part:SetAttribute(k, v)
		end
	end
	return part
end

function B.floorSkin(parent, rect, y, style, attrs)
	local w, d = rect[3] - rect[1], rect[4] - rect[2]
	local p = Kit.box(parent, w, 0.2, d, (rect[1] + rect[3]) / 2, y - 0.1, (rect[2] + rect[4]) / 2, style.color, style.material, { collide = true })
	p.Name = "Floor"
	tag(p, "Floor", attrs)
	return p
end

function B.slab(parent, rect, y0, thickness, color, material, name)
	local w, d = rect[3] - rect[1], rect[4] - rect[2]
	local p = Kit.box(parent, w, thickness, d, (rect[1] + rect[3]) / 2, y0 + thickness / 2, (rect[2] + rect[4]) / 2, color, material, { collide = true })
	p.Name = name or "Slab"
	return p
end

-- Wall segment. style = {color, material, lattice, stripes}; outsideSign = -1/1 side of the
-- exterior (nil when both sides are interior).
function B.wall(parent, seg, y0, height, thickness, style, outsideSign, exteriorStyle)
	local len = seg.b - seg.a
	local cx, cz, sx, sz
	if seg.axis == "z" then
		cx, cz = (seg.a + seg.b) / 2, seg.line
		sx, sz = len + thickness, thickness
	else
		cx, cz = seg.line, (seg.a + seg.b) / 2
		sx, sz = thickness, len + thickness
	end
	local wall = Kit.box(parent, sx, height, sz, cx, y0 + height / 2, cz, style.color, style.material, { collide = true })
	wall.Name = "Wall"
	tag(wall, "Wall", { FloorIndex = seg.floor })
	-- baseboard on both faces
	local base = Kit.box(parent, sx + 0.06, 0.6, sz + 0.06, cx, y0 + 0.3, cz, P.wood_dark, M.wood, { collide = false })
	tag(base, "Wall", { FloorIndex = seg.floor })
	-- interior decoration
	if style.lattice or style.stripes then
		local step = style.lattice and 2 or 0.8
		local n = math.floor(len / step)
		for i = 1, n - 1 do
			local along = seg.a + i * step
			for side = -1, 1, 2 do
				if side ~= outsideSign then
					local off = side * (thickness / 2 + 0.03)
					local x, z = (seg.axis == "z") and along or seg.line + off, (seg.axis == "z") and seg.line + off or along
					local bar = Kit.box(parent, seg.axis == "z" and 0.12 or 0.06, height - 1, seg.axis == "z" and 0.06 or 0.12, x, y0 + 0.6 + (height - 1) / 2, z, style.lattice and P.wood_dark or Color.hex("#8A7A3A"), M.wood, { collide = false, shadow = false })
					tag(bar, "Wall", { FloorIndex = seg.floor })
				end
			end
		end
	end
	if outsideSign then
		local ext = exteriorStyle or { color = P.cream, material = M.plaster }
		local off = outsideSign * (thickness / 2 + 0.1)
		local ex, ez = cx, cz
		local esx, esz = sx, sz
		if seg.axis == "z" then
			ez = cz + off
			esz = 0.2
		else
			ex = cx + off
			esx = 0.2
		end
		local skin = Kit.box(parent, esx, height, esz, ex, y0 + height / 2, ez, ext.color, ext.material, { collide = false })
		tag(skin, "Roof")
		local stone = Kit.box(parent, esx + (seg.axis == "x" and 0.1 or 0), 1.4, esz + (seg.axis == "z" and 0.1 or 0), ex, y0 + 0.7, ez, P.stone_dark, M.slate, { collide = false })
		tag(stone, "Roof")
		local beam = Kit.box(parent, esx + (seg.axis == "x" and 0.2 or 0), 0.7, esz + (seg.axis == "z" and 0.2 or 0), ex, y0 + height - 0.35, ez, P.wood_dark, M.wood, { collide = false })
		tag(beam, "Roof")
		local posts = math.floor(len / 6)
		for i = 0, posts do
			local along = seg.a + (len) * (posts == 0 and 0.5 or i / posts)
			local px = seg.axis == "z" and along or ex + outsideSign * 0.08
			local pz = seg.axis == "z" and ez + outsideSign * 0.08 or along
			local post = Kit.box(parent, seg.axis == "z" and 0.5 or 0.25, height, seg.axis == "z" and 0.25 or 0.5, px, y0 + height / 2, pz, P.wood_dark, M.wood, { collide = false })
			tag(post, "Roof")
		end
	end
	return wall
end

function B.doorFrame(parent, o, y0, height)
	local h = height or 9
	local function post(along)
		local x = o.axis == "z" and along or o.at
		local z = o.axis == "z" and o.at or along
		Kit.box(parent, 0.6, h, 0.6, x, y0 + h / 2, z, P.wood_dark, M.wood, { collide = true })
	end
	post(o.from + 0.3)
	post(o.to - 0.3)
	local len = o.to - o.from
	local cx = o.axis == "z" and (o.from + o.to) / 2 or o.at
	local cz = o.axis == "z" and o.at or (o.from + o.to) / 2
	Kit.box(parent, o.axis == "z" and len or 0.9, 0.6, o.axis == "z" and 0.9 or len, cx, y0 + h + 0.3, cz, P.wood_dark, M.wood, { collide = true })
	-- fill above the door up to the wall top
	Kit.box(parent, o.axis == "z" and len or 0.8, 14 - h - 0.6, o.axis == "z" and 0.8 or len, cx, y0 + h + 0.6 + (14 - h - 0.6) / 2, cz, P.cream, M.plaster, { collide = true })
end

-- Fixed noren curtain hanging in the entrance (customers walk through it)
function B.entranceNoren(parent, o, y0)
	local len = o.to - o.from
	local cx = (o.from + o.to) / 2
	local z = o.at - 0.6
	Kit.cylH(parent, 0.18, len, cx, y0 + 8.7, z, P.wood_dark, M.wood, { collide = false })
	local panels = 4
	for i = 0, panels - 1 do
		local x = o.from + len / panels * (i + 0.5)
		local cloth = Kit.box(parent, len / panels - 0.12, 3.2, 0.06, x, y0 + 7, z, P.indigo, M.fabric, { collide = false })
		cloth.CanQuery = false
		cloth:SetAttribute("Animate", "sway")
	end
	local label = Kit.box(parent, len - 0.3, 1.1, 0.02, cx, y0 + 7.95, z - 0.05, P.white, M.smooth, { transparency = 1, collide = false, shadow = false })
	label.CanQuery = false
	Kit.text(label, Enum.NormalId.Front, "ら ー め ん", { color = "#FFFFFF", font = JP_FONT, pps = 30 })
	-- white ramen bowl crest: bowl, rim cut-out, noodles and chopsticks
	local NC = { collide = false, shadow = false }
	local function icon(p)
		p.CanQuery = false
		return p
	end
	icon(Kit.blob(parent, 1.7, 0.95, 0.04, cx, y0 + 6.25, z - 0.06, P.white, M.fabric, NC))
	icon(Kit.blob(parent, 1.55, 0.36, 0.04, cx, y0 + 6.62, z - 0.08, P.indigo, M.fabric, NC))
	for k = -1, 1 do
		icon(Kit.box(parent, 0.08, 0.55, 0.03, cx + k * 0.22, y0 + 6.95, z - 0.08, P.white, M.fabric, NC))
	end
	for k = 0, 1 do
		icon(Kit.part(parent, Vector3.new(0.07, 1.0, 0.03), CFrame.new(cx + 0.35 + k * 0.16, y0 + 7.1, z - 0.08) * CFrame.Angles(0, 0, math.rad(-30)), P.white, M.fabric, NC))
	end
end

function B.railing(parent, seg, y0, color)
	local len = seg.b - seg.a
	local h = 3
	local cx = seg.axis == "z" and (seg.a + seg.b) / 2 or seg.line
	local cz = seg.axis == "z" and seg.line or (seg.a + seg.b) / 2
	local rail = Kit.box(parent, seg.axis == "z" and len or 0.3, 0.25, seg.axis == "z" and 0.3 or len, cx, y0 + h, cz, color or P.wood_dark, M.wood, { collide = true })
	tag(rail, "Wall", { FloorIndex = seg.floor, Rail = true })
	Kit.box(parent, seg.axis == "z" and len or 0.15, 0.15, seg.axis == "z" and 0.15 or len, cx, y0 + h / 2, cz, color or P.wood_dark, M.wood, { collide = false })
	-- invisible blocker so nobody falls off
	local block = Kit.box(parent, seg.axis == "z" and len or 0.4, h + 1, seg.axis == "z" and 0.4 or len, cx, y0 + (h + 1) / 2, cz, P.white, M.smooth, { collide = true, transparency = 1, shadow = false })
	block.CanQuery = false
	local n = math.max(1, math.floor(len / 2))
	for i = 0, n do
		local along = seg.a + len * i / n
		local x = seg.axis == "z" and along or seg.line
		local z = seg.axis == "z" and seg.line or along
		Kit.box(parent, 0.3, h, 0.3, x, y0 + h / 2, z, color or P.wood_dark, M.wood, { collide = false })
	end
end

-- Stairs rising toward +Z inside rect, from y0 to y0 + rise
function B.stairs(parent, rect, y0, rise)
	local w = rect[3] - rect[1]
	local len = rect[4] - rect[2]
	local steps = math.floor(rise)
	local depth = len / steps
	local cx = (rect[1] + rect[3]) / 2
	for k = 0, steps - 1 do
		local stepTop = y0 + (k + 1) * rise / steps
		local z = rect[2] + (k + 0.5) * depth
		local s = Kit.box(parent, w, stepTop - y0, depth, cx, y0 + (stepTop - y0) / 2, z, P.wood, M.planks, { collide = true })
		s.Name = "Step"
		tag(s, "Floor", { FloorIndex = -1, Stairs = true })
		Kit.box(parent, w, 0.1, 0.15, cx, stepTop + 0.02, z - depth / 2 + 0.08, P.wood_dark, M.wood, { collide = false, shadow = false })
	end
	for _, x in ipairs({ rect[1] + 0.15, rect[3] - 0.15 }) do
		local a = Vector3.new(x, y0 + 3.5, rect[2])
		local b = Vector3.new(x, y0 + rise + 3.5, rect[4])
		local mid = (a + b) / 2
		Kit.part(parent, Vector3.new(0.2, 0.2, (b - a).Magnitude), CFrame.lookAt(mid, b), P.lacquer, M.smooth, { collide = false })
	end
end

-- Tiled eave (hisashi) projecting from a street facing wall (axis "z" segment).
-- outsideSign -1 means the street is at -Z. Tiles rows, round tile channels, rafter tails, end caps.
-- Street eave. tiled = renovation "tiled eaves" (kawara channels, ridge, rafters, onigawara);
-- otherwise a plain sheet-metal canopy.
function B.eave(parent, seg, y, outsideSign, depth, tiled)
	depth = depth or 3
	local len = seg.b - seg.a + 2
	local cx = (seg.a + seg.b) / 2
	local z = seg.line + outsideSign * (depth / 2 + 0.5)
	local yaw = outsideSign < 0 and 0 or 180
	local rise = tiled and 1.6 or 0.8
	local roof = Kit.wedge(parent, len, rise, depth, CFrame.new(cx, y + rise / 2, z) * CFrame.Angles(0, math.rad(yaw), 0), tiled and P.tile or P.steel, tiled and M.roof or M.metal, { collide = false })
	tag(roof, "Roof")
	if not tiled then
		local edge = Kit.box(parent, len, 0.2, 0.12, cx, y - 0.05, seg.line + outsideSign * (depth + 0.45), P.steel_dark, M.metal, { collide = false })
		tag(edge, "Roof")
		return
	end
	-- round tile channels running down the slope
	local slope = math.sqrt(depth * depth + rise * rise)
	local n = math.floor(len / 0.7)
	for i = 0, n do
		local x = seg.a - 1 + len * i / n
		local top = Vector3.new(x, y + rise + 0.08, seg.line + outsideSign * 0.5)
		local bottom = Vector3.new(x, y + 0.08, seg.line + outsideSign * (depth + 0.5))
		local mid = (top + bottom) / 2
		local cf = CFrame.lookAt(mid, bottom) * CFrame.Angles(0, math.rad(90), 0)
		local ch = Kit.part(parent, Vector3.new(slope, 0.22, 0.22), cf, P.charcoal, M.roof, { collide = false, shadow = false, shape = Enum.PartType.Cylinder })
		ch.CanQuery = false
		tag(ch, "Roof")
		-- round end tile (tomoe) facing the street
		local cap = Kit.cylH(parent, 0.34, 0.12, x, y + 0.1, seg.line + outsideSign * (depth + 0.56), P.charcoal, M.roof, { collide = false, shadow = false }, "z")
		cap.CanQuery = false
		tag(cap, "Roof")
	end
	-- ridge, fascia board and rafter tails
	local ridge = Kit.box(parent, len, 0.55, 0.7, cx, y + rise + 0.2, seg.line + outsideSign * 0.65, P.charcoal, M.roof, { collide = false })
	tag(ridge, "Roof")
	local ridgeTop = Kit.cylH(parent, 0.4, len, cx, y + rise + 0.5, seg.line + outsideSign * 0.65, P.tile, M.roof, { collide = false, shadow = false })
	tag(ridgeTop, "Roof")
	local fascia = Kit.box(parent, len, 0.32, 0.18, cx, y - 0.05, seg.line + outsideSign * (depth + 0.42), P.wood_dark, M.wood, { collide = false })
	tag(fascia, "Roof")
	for i = 0, math.floor(len / 1.1) do
		local x = seg.a - 1 + 0.55 + i * 1.1
		if x < seg.b + 1 then
			local tail = Kit.box(parent, 0.22, 0.22, depth - 0.3, x, y - 0.3, seg.line + outsideSign * (depth / 2 + 0.35), P.wood_dark, M.wood, { collide = false, shadow = false })
			tail.CanQuery = false
			tag(tail, "Roof")
		end
	end
	for _, sx in ipairs({ seg.a - 1.05, seg.b + 1.05 }) do
		local cap = Kit.box(parent, 0.5, 0.9, 0.6, sx, y + 0.5, seg.line + outsideSign * (depth + 0.2), P.charcoal, M.roof, { collide = false })
		tag(cap, "Roof")
		local oni = Kit.box(parent, 0.55, 0.9, 0.7, sx, y + rise + 0.45, seg.line + outsideSign * 0.65, P.charcoal, M.roof, { collide = false })
		tag(oni, "Roof")
	end
end

-- Coordinates on the face of a wall segment: along the wall, height, distance from the wall
-- line towards `side` (+1 / -1). Returns the created part.
local function faceBox(parent, seg, side, sa, sy, so, along, y, out, color, mat, props)
	if seg.axis == "z" then
		return Kit.box(parent, sa, sy, so, along, y, seg.line + side * out, color, mat, props)
	end
	return Kit.box(parent, so, sy, sa, seg.line + side * out, y, along, color, mat, props)
end
B.faceBox = faceBox

local function inAvoid(along, avoid)
	for _, r in ipairs(avoid or {}) do
		if along > r[1] and along < r[2] then
			return true
		end
	end
	return false
end

-- Interior finishes on one side of a wall: koshi-ita wainscot, hashira posts and nageshi beam
-- in dining rooms; white tiles in kitchens; plain concrete wainscot in storage rooms.
-- reno = { wainscot, beams, tiles, storage } (owned renovations); the plain room only gets
-- a skirting board.
function B.wallTrim(parent, seg, y0, side, area, height, reno)
	reno = reno or {}
	local len = seg.b - seg.a
	local mid = (seg.a + seg.b) / 2
	local NC = { collide = false, shadow = false }
	local parts = {}
	local function add(p)
		p.CanQuery = true
		tag(p, "Wall", { FloorIndex = seg.floor })
		table.insert(parts, p)
		return p
	end
	local skirting = area == "kitchen" and P.steel or (area == "storage" and P.stone_dark or P.wood_dark)
	add(faceBox(parent, seg, side, len, 0.35, 0.06, mid, y0 + 0.175, 0.43, skirting, area == "kitchen" and M.metal or M.wood, NC))
	if area == "kitchen" then
		if reno.tiles then
			add(faceBox(parent, seg, side, len, 6.4, 0.06, mid, y0 + 0.6 + 3.2, 0.44, P.white, M.tiles, NC))
			add(faceBox(parent, seg, side, len, 0.12, 0.12, mid, y0 + 7.05, 0.47, P.metal, M.metal, NC))
		end
	elseif area == "storage" then
		if reno.storage then
			add(faceBox(parent, seg, side, len, 3, 0.06, mid, y0 + 1.5, 0.44, P.concrete, M.concrete, NC))
			add(faceBox(parent, seg, side, len, 0.15, 0.1, mid, y0 + 3.05, 0.46, P.neon_yellow, M.smooth, NC))
		end
	else
		if reno.wainscot then
			local panel = area == "tatami" and P.hinoki or P.wood_dark
			add(faceBox(parent, seg, side, len, 2.7, 0.08, mid, y0 + 1.35, 0.45, panel, M.planks, NC))
			add(faceBox(parent, seg, side, len, 0.18, 0.16, mid, y0 + 2.75, 0.49, P.wood_light, M.wood, NC))
		end
		if reno.beams then
			add(faceBox(parent, seg, side, len, 0.4, 0.2, mid, y0 + 10.2, 0.5, P.wood_dark, M.wood, NC))
			local posts = math.max(1, math.floor(len / 6))
			for i = 0, posts do
				local along = seg.a + len * i / posts
				along = math.clamp(along, seg.a + 0.25, seg.b - 0.25)
				add(faceBox(parent, seg, side, 0.45, height - 0.2, 0.14, along, y0 + (height - 0.2) / 2, 0.48, P.wood_dark, M.wood, NC))
			end
		end
	end
	return parts
end

-- Kyoto machiya street front: koshi lattice band, timber frame and inu-yarai bamboo fence.
-- avoid = list of {from, to} ranges along the wall to keep clear (doors).
-- opts = { koshi = bool (timber bands and lattice), bamboo = bool (inu-yarai fence) }
function B.facadeDetail(parent, seg, y0, side, avoid, opts)
	opts = opts or { koshi = true, bamboo = true }
	local len = seg.b - seg.a
	local mid = (seg.a + seg.b) / 2
	local NC = { collide = false, shadow = false }
	local function add(p)
		p.CanQuery = false
		tag(p, "Roof")
		return p
	end
	if opts.koshi then
		-- timber frame bands
		add(faceBox(parent, seg, side, len, 0.35, 0.16, mid, y0 + 4.5, 0.68, P.wood_dark, M.wood, NC))
		add(faceBox(parent, seg, side, len, 0.3, 0.16, mid, y0 + 9.6, 0.68, P.wood_dark, M.wood, NC))
		-- koshi lattice (lower band)
		add(faceBox(parent, seg, side, len, 0.18, 0.2, mid, y0 + 1.5, 0.72, P.wood_dark, M.wood, NC))
		add(faceBox(parent, seg, side, len, 0.18, 0.2, mid, y0 + 4.15, 0.72, P.wood_dark, M.wood, NC))
		local step = 0.42
		for i = 0, math.floor(len / step) do
			local along = seg.a + 0.2 + i * step
			if along < seg.b - 0.2 and not inAvoid(along, avoid) then
				add(faceBox(parent, seg, side, 0.13, 2.6, 0.12, along, y0 + 2.85, 0.76, P.wood, M.wood, NC))
			end
	end
	end
	if not opts.bamboo then
		return
	end
	-- inu-yarai: curved bamboo fence leaning against the base of the wall
	for i = 0, math.floor(len / 0.55) do
		local along = seg.a + 0.3 + i * 0.55
		if along < seg.b - 0.3 and not inAvoid(along, avoid) then
			local a = (seg.axis == "z") and Vector3.new(along, y0 + 0.02, seg.line + side * 1.45) or Vector3.new(seg.line + side * 1.45, y0 + 0.02, along)
			local b = (seg.axis == "z") and Vector3.new(along, y0 + 1.25, seg.line + side * 0.8) or Vector3.new(seg.line + side * 0.8, y0 + 1.25, along)
			local midp = (a + b) / 2
			local rod = Kit.part(parent, Vector3.new((b - a).Magnitude, 0.14, 0.14), CFrame.lookAt(midp, b) * CFrame.Angles(0, math.rad(90), 0), P.bamboo, M.wood, { collide = false, shadow = false, shape = Enum.PartType.Cylinder })
			add(rod)
		end
	end
	for _, h in ipairs({ 0.45, 0.95 }) do
		local out = 1.45 - (h / 1.25) * 0.65
		add(faceBox(parent, seg, side, len, 0.08, 0.08, mid, y0 + h, out + 0.04, P.bamboo_green, M.wood, NC))
	end
end

-- Details around the main entrance: parked sliding lattice doors, stone step, salt cones, pines
function B.entranceDetail(parent, o, y0)
	local NC = { collide = false, shadow = false }
	local z = o.at - 0.75
	for _, sgn in ipairs({ -1, 1 }) do
		local edge = sgn < 0 and o.from or o.to
		local cx = edge + sgn * 1.45
		-- sliding koshi-do door pushed aside
		Kit.box(parent, 2.8, 8.4, 0.12, cx, y0 + 4.3, z, P.wood_dark, M.wood, NC)
		Kit.box(parent, 2.4, 3.6, 0.04, cx, y0 + 6.3, z - 0.08, P.paper_warm, M.fabric, NC)
		for k = 0, 5 do
			Kit.box(parent, 0.1, 7.8, 0.08, cx - 1.1 + k * 0.44, y0 + 4.3, z - 0.11, P.wood, M.wood, NC)
		end
		Kit.box(parent, 2.8, 0.12, 0.1, cx, y0 + 4.3, z - 0.12, P.wood, M.wood, NC)
		-- morishio: salt cone on a small dish
		local sx = edge - sgn * 0.45
		Kit.cyl(parent, 0.6, 0.06, sx, y0 + 0.03, o.at - 1.0, P.porcelain, M.smooth, NC)
		for k = 0, 3 do
			Kit.cyl(parent, 0.42 - k * 0.1, 0.12, sx, y0 + 0.12 + k * 0.11, o.at - 1.0, P.white, M.sand, NC)
		end
		-- potted pine
		local px = edge + sgn * 3.6
		Kit.cyl(parent, 1.1, 0.9, px, y0 - 0.4 + 0.45, o.at - 1.25, P.indigo, M.smooth, NC)
		Kit.cyl(parent, 0.18, 1.3, px, y0 + 1.1, o.at - 1.25, P.wood_dark, M.wood, NC)
		Kit.blob(parent, 1.4, 0.5, 1.1, px - 0.2, y0 + 1.75, o.at - 1.25, P.leaf_dark, M.leafy, NC)
		Kit.blob(parent, 1.0, 0.4, 0.9, px + 0.25, y0 + 2.15, o.at - 1.25, P.leaf_dark, M.leafy, NC)
	end
	-- stone step
	Kit.box(parent, o.to - o.from - 0.6, 0.3, 1.2, (o.from + o.to) / 2, -0.25, o.at - 1.0, P.stone, M.granite, { collide = true })
end

-- Loading door: rolled-up shutter, hazard stripe and a small sign
-- marked = renovation "tidy storage" (hazard stripes and the loading sign)
function B.shutter(parent, o, y0, height, marked)
	local NC = { collide = false, shadow = false }
	local len = o.to - o.from
	local cx = (o.from + o.to) / 2
	local z = o.at - 0.5
	Kit.box(parent, len + 0.4, 1.1, 0.9, cx, y0 + height + 0.1, z - 0.2, P.steel, M.metal, NC)
	for k = 0, 3 do
		Kit.box(parent, len, 0.22, 0.06, cx, y0 + height - 0.4 - k * 0.3, z, P.metal, M.metal, NC)
	end
	if not marked then
		return
	end
	for k = 0, math.floor(len / 0.6) do
		local stripe = Kit.box(parent, 0.3, 0.02, 0.6, o.from + 0.3 + k * 0.6, y0 - 0.33, o.at - 1.2, k % 2 == 0 and P.neon_yellow or P.black, M.smooth, NC)
		stripe.CanQuery = false
	end
	local plate = Kit.box(parent, 2.2, 0.7, 0.06, o.to + 1.6, y0 + 7, z, P.white, M.smooth, NC)
	Kit.text(plate, Enum.NormalId.Front, "搬入口", { color = "#2B2320", font = JP_FONT })
end

function B.parapet(parent, seg, y0)
	local len = seg.b - seg.a
	local cx = seg.axis == "z" and (seg.a + seg.b) / 2 or seg.line
	local cz = seg.axis == "z" and seg.line or (seg.a + seg.b) / 2
	local p = Kit.box(parent, seg.axis == "z" and len + 0.8 or 0.7, 0.8, seg.axis == "z" and 0.7 or len + 0.8, cx, y0 + 0.4, cz, P.cream, M.plaster, { collide = true })
	tag(p, "Roof")
	local cap = Kit.box(parent, seg.axis == "z" and len + 1 or 1, 0.22, seg.axis == "z" and 1 or len + 1, cx, y0 + 0.9, cz, P.tile, M.roof, { collide = false, shadow = false })
	tag(cap, "Roof")
	return p
end

-- Paper-lit lattice window on an exterior wall
-- fancy = renovation "lattice windows" (kumiko grid, sill and flower box); else a plain frame
function B.window(parent, along, y, seg, outsideSign, w, h, fancy)
	local off = outsideSign * 0.65
	local x = seg.axis == "z" and along or seg.line + off
	local z = seg.axis == "z" and seg.line + off or along
	local sx, sz = seg.axis == "z" and w or 0.1, seg.axis == "z" and 0.1 or w
	local glow = Kit.box(parent, sx, h, sz, x, y, z, P.paper_warm, M.neon, { collide = false })
	glow.Transparency = 0.15
	tag(glow, "Roof")
	local cols, rows = math.max(2, math.floor(w / 0.8)), math.max(2, math.floor(h / 0.8))
	if not fancy then
		cols, rows = 2, 1
	end
	for i = 0, cols do
		local a = along - w / 2 + w * i / cols
		local bx = seg.axis == "z" and a or x + outsideSign * 0.06
		local bz = seg.axis == "z" and z + outsideSign * 0.06 or a
		local bar = Kit.box(parent, seg.axis == "z" and 0.1 or 0.08, h, seg.axis == "z" and 0.08 or 0.1, bx, y, bz, P.wood_dark, M.wood, { collide = false, shadow = false })
		tag(bar, "Roof")
	end
	if fancy then
		-- sill with a flower box
		local sillA = seg.axis == "z" and w + 0.6 or 0.5
		local sillB = seg.axis == "z" and 0.5 or w + 0.6
		local sill = Kit.box(parent, sillA, 0.18, sillB, x + (seg.axis == "x" and outsideSign * 0.2 or 0), y - h / 2 - 0.12, z + (seg.axis == "z" and outsideSign * 0.2 or 0), P.wood_dark, M.wood, { collide = false, shadow = false })
		tag(sill, "Roof")
		for k = 0, math.floor(w / 0.6) do
			local fa = along - w / 2 + 0.3 + k * 0.6
			local fx = seg.axis == "z" and fa or x + outsideSign * 0.3
			local fz = seg.axis == "z" and z + outsideSign * 0.3 or fa
			local leaf = Kit.blob(parent, 0.55, 0.4, 0.55, fx, y - h / 2 + 0.12, fz, k % 3 == 1 and P.sakura_dark or P.leaf, M.leafy, { collide = false, shadow = false })
			tag(leaf, "Roof")
	end
	end
	for j = 0, rows do
		local yy = y - h / 2 + h * j / rows
		local bar = Kit.box(parent, sx + (seg.axis == "x" and 0.04 or 0), 0.1, sz + (seg.axis == "z" and 0.04 or 0), x + (seg.axis == "x" and outsideSign * 0.06 or 0), yy, z + (seg.axis == "z" and outsideSign * 0.06 or 0), P.wood_dark, M.wood, { collide = false, shadow = false })
		tag(bar, "Roof")
	end
end

-- Big shop sign above the entrance
function B.sign(parent, x, y, z, w, text, deluxe)
	local board = Kit.box(parent, w, 2.6, 0.4, x, y, z, deluxe and P.black or P.wood_dark, M.wood, { collide = false })
	tag(board, "Roof")
	local face = Kit.box(parent, w - 0.4, 2.1, 0.05, x, y, z - 0.23, deluxe and P.black or P.hinoki, M.wood, { collide = false })
	tag(face, "Roof")
	Kit.text(face, Enum.NormalId.Front, text, { color = deluxe and "#FFD23B" or "#2B2320", font = JP_FONT, glow = deluxe, pps = 30 })
	if deluxe then
		for _, dy in ipairs({ -1.25, 1.25 }) do
			local tube = Kit.box(parent, w, 0.1, 0.1, x, y + dy, z - 0.25, P.neon_yellow, M.neon, { collide = false })
			tag(tube, "Roof")
		end
		Kit.light(face, "Surface", P.neon_yellow, 12, 2, { face = Enum.NormalId.Front })
	end
	return face
end

-- "Open / preparing" plate next to the door; returns the TextLabel
function B.openSign(parent, x, y, z)
	local plate = Kit.box(parent, 1.6, 0.8, 0.1, x, y, z, P.wood_light, M.wood, { collide = false })
	Kit.cyl(parent, 0.04, 0.8, x, y + 0.6, z, P.black, M.fabric, { collide = false })
	local _, label = Kit.text(plate, Enum.NormalId.Front, "準備中", { color = "#2B2320", font = JP_FONT })
	return label, plate
end

function B.tag(part, name, attrs)
	return tag(part, name, attrs)
end

return function(Registry)
	Registry.Building = B
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000038"><Properties><string name="Name">Decor</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Decorations: lighting, plants, art, statues, garden, festival, seasonal and city items.
-- Parts with the attribute "Animate" are animated by the client (AmbientController).
local Kit = require(script.Parent.Parent.Kit)
local P = require(script.Parent.Parent.Palette)
local M = P.M

local function size(item)
	return Vector3.new(item.size[1], item.size[2], item.size[3])
end

local JP_FONT = Font.new("rbxasset://fonts/families/FredokaOne.json", Enum.FontWeight.Bold)

-- Paper lantern hanging from the top of its box
local function chochin(m, item, bodyColor, text, textColor, scale)
	Kit.finish(m, size(item))
	local h = item.size[2]
	scale = scale or 1
	local bodyH, bodyD = 1.5 * scale, 1.15 * scale
	local cy = h - 0.6 - bodyH / 2
	Kit.cyl(m, 0.05, 0.6, 0, h - 0.3, 0, P.black, M.fabric, { collide = false })
	Kit.cyl(m, 0.7 * scale, 0.18, 0, cy + bodyH / 2 + 0.05, 0, P.black, M.smooth, { collide = false })
	Kit.cyl(m, 0.7 * scale, 0.18, 0, cy - bodyH / 2 - 0.05, 0, P.black, M.smooth, { collide = false })
	local body = Kit.blob(m, bodyD, bodyH, bodyD, 0, cy, 0, bodyColor, M.fabric, { collide = false })
	body.Material = M.smooth
	for i = -2, 2 do
		local yy = cy + i * bodyH * 0.18
		local ring = 1 - (i * 0.18) ^ 2 * 1.2
		Kit.cyl(m, bodyD * ring + 0.02, 0.03, 0, yy, 0, Color3.new(0, 0, 0):Lerp(bodyColor, 0.6), M.smooth, { collide = false, shadow = false })
	end
	if text then
		local panel = Kit.box(m, bodyD * 0.55, bodyH * 0.8, 0.02, 0, cy, -bodyD / 2 - 0.01, P.white, M.smooth, { transparency = 1, collide = false, shadow = false })
		Kit.text(panel, Enum.NormalId.Front, text, { color = textColor or "#141414", font = JP_FONT, pps = 40 })
	end
	Kit.light(body, "Point", P.lamp_warm, 12 * scale, 1.2)
	body:SetAttribute("Animate", "sway")
	return body
end

local function plantPot(m, d, h, color)
	Kit.cyl(m, d, h, 0, h / 2, 0, color or P.charcoal, M.smooth)
	Kit.cyl(m, d + 0.1, 0.1, 0, h - 0.05, 0, color or P.charcoal, M.smooth, { collide = false })
	Kit.cyl(m, d - 0.15, 0.05, 0, h - 0.04, 0, P.wood_dark, M.sand, { collide = false })
end

local function foliage(m, list, color, material)
	for _, b in ipairs(list) do
		Kit.blob(m, b[4], b[5] or b[4] * 0.6, b[6] or b[4], b[1], b[2], b[3], color, material or M.leafy, { collide = false })
	end
end

local function tree(m, item, leafColor, petals)
	Kit.finish(m, size(item))
	local w, h = item.size[1], item.size[2]
	Kit.cyl(m, 0.9, h * 0.5, 0, h * 0.25, 0, P.wood_dark, M.wood)
	Kit.cyl(m, 0.5, h * 0.35, -0.8, h * 0.55, 0.2, P.wood_dark, M.wood, { rot = CFrame.Angles(0, 0, math.rad(30)) })
	Kit.cyl(m, 0.5, h * 0.35, 0.9, h * 0.55, -0.3, P.wood_dark, M.wood, { rot = CFrame.Angles(0, 0, math.rad(-35)) })
	local blobs = {
		{ 0, h * 0.78, 0, w * 0.55 }, { -w * 0.28, h * 0.68, 0.4, w * 0.42 }, { w * 0.3, h * 0.7, -0.3, w * 0.45 },
		{ 0.3, h * 0.88, -0.6, w * 0.4 }, { -0.4, h * 0.62, -w * 0.25, w * 0.35 }, { 0.5, h * 0.6, w * 0.25, w * 0.35 },
	}
	foliage(m, blobs, leafColor, M.leafy)
	if petals then
		local emitter = Kit.box(m, w * 0.6, 0.2, w * 0.6, 0, h * 0.7, 0, P.white, M.smooth, { transparency = 1, collide = false, shadow = false })
		Kit.particles(emitter, "petals")
	end
	Kit.cyl(m, 2, 0.15, 0, 0.075, 0, P.wood_dark, M.ground or M.sand, { collide = false })
end

local function stoneLantern(m, item, stoneColor, roofColor, glowColor)
	Kit.finish(m, size(item))
	local h = item.size[2]
	local s = h / 4.5
	Kit.cyl(m, 1.6 * s, 0.4 * s, 0, 0.2 * s, 0, stoneColor, M.granite)
	Kit.cyl(m, 0.6 * s, 1.6 * s, 0, 1.2 * s, 0, stoneColor, M.granite)
	Kit.box(m, 1.4 * s, 0.25 * s, 1.4 * s, 0, 2.1 * s, 0, stoneColor, M.granite)
	local light = Kit.box(m, 0.9 * s, 0.9 * s, 0.9 * s, 0, 2.7 * s, 0, glowColor or P.paper_warm, M.neon, { collide = false })
	Kit.box(m, 1.05 * s, 0.95 * s, 0.3 * s, 0, 2.7 * s, 0, stoneColor, M.granite)
	Kit.box(m, 0.3 * s, 0.95 * s, 1.05 * s, 0, 2.7 * s, 0, stoneColor, M.granite)
	Kit.light(light, "Point", P.lamp_warm, 10, 1)
	-- roof: four wedges forming a shallow pyramid
	local ry = 3.35 * s
	for i = 0, 3 do
		local rot = CFrame.Angles(0, math.rad(90 * i), 0)
		Kit.wedge(m, 1.9 * s, 0.5 * s, 0.95 * s, CFrame.new(0, ry, 0) * rot * CFrame.new(0, 0, -0.475 * s), roofColor or stoneColor, M.granite)
	end
	Kit.ball(m, 0.4 * s, 0, ry + 0.45 * s, 0, roofColor or stoneColor, M.granite)
end

local function neon(m, item, text, color)
	Kit.finish(m, size(item))
	local w, h, d = item.size[1], item.size[2], item.size[3]
	local board = Kit.box(m, w, h, 0.15, 0, h / 2, d / 2 - 0.075, P.charcoal, M.smooth)
	local face = Kit.box(m, w - 0.2, h - 0.2, 0.05, 0, h / 2, d / 2 - 0.18, P.charcoal, M.smooth, { collide = false })
	Kit.text(face, Enum.NormalId.Front, text, { color = color, glow = true, font = JP_FONT, pps = 40 })
	Kit.light(face, "Surface", color, 10, 1.5, { face = Enum.NormalId.Front, angle = 120 })
	for _, x in ipairs({ -w / 2 + 0.05, w / 2 - 0.05 }) do
		Kit.box(m, 0.06, h - 0.1, 0.06, x, h / 2, d / 2 - 0.2, color, M.neon, { collide = false })
	end
	local _ = board
end

local function noren(m, item, color, text, textColor)
	Kit.finish(m, size(item))
	local w, h, d = item.size[1], item.size[2], item.size[3]
	Kit.cylH(m, 0.15, w + 0.3, 0, h - 0.1, d / 2 - 0.1, P.wood_dark, M.wood, { collide = false })
	local panels = 3
	local pw = w / panels
	for i = 0, panels - 1 do
		local x = -w / 2 + pw * (i + 0.5)
		local cloth = Kit.box(m, pw - 0.08, h - 0.25, 0.05, x, (h - 0.25) / 2 + 0.05, d / 2 - 0.12, color, M.fabric, { collide = false })
		cloth:SetAttribute("Animate", "sway")
	end
	if text then
		local panel = Kit.box(m, w - 0.2, h * 0.5, 0.02, 0, h * 0.55, d / 2 - 0.16, P.white, M.smooth, { transparency = 1, collide = false, shadow = false })
		Kit.text(panel, Enum.NormalId.Front, text, { color = textColor or "#FFFFFF", font = JP_FONT, pps = 40 })
	end
end

local function frame(m, w, h, d, color)
	for _, s in ipairs({ { 0, h - 0.1, w, 0.2 }, { 0, 0.1, w, 0.2 } }) do
		Kit.box(m, s[3], s[4], d, s[1], s[2], 0, color, M.wood, { collide = false })
	end
	for _, x in ipairs({ -w / 2 + 0.1, w / 2 - 0.1 }) do
		Kit.box(m, 0.2, h, d, x, h / 2, 0, color, M.wood, { collide = false })
	end
end

local function torii(m, item, color, capColor)
	Kit.finish(m, size(item))
	local w, h = item.size[1], item.size[2]
	for _, x in ipairs({ -w / 2 + 0.9, w / 2 - 0.9 }) do
		Kit.cyl(m, 0.7, h - 0.8, x, (h - 0.8) / 2, 0, color, M.smooth)
		Kit.cyl(m, 0.85, 0.5, x, 0.25, 0, capColor, M.smooth)
	end
	Kit.box(m, w - 0.8, 0.4, 0.5, 0, h - 2.2, 0, color, M.smooth)
	Kit.box(m, w + 0.4, 0.45, 0.8, 0, h - 0.7, 0, color, M.smooth)
	Kit.box(m, w + 0.8, 0.3, 0.9, 0, h - 0.3, 0, capColor, M.smooth)
	for _, sgn in ipairs({ -1, 1 }) do
		Kit.wedge(m, 0.9, 0.35, 0.6, CFrame.new(sgn * (w / 2 + 0.55), h - 0.25, 0) * CFrame.Angles(0, math.rad(sgn * 90), 0), capColor, M.smooth)
	end
	Kit.box(m, 0.4, 1.2, 0.3, 0, h - 1.45, 0, color, M.smooth)
end

local function shisa(m, x, color, mouthOpen)
	Kit.box(m, 1.6, 0.5, 1.4, x, 0.25, 0, P.stone, M.granite)
	Kit.blob(m, 1.2, 1.2, 1.1, x, 1.05, 0.1, color, M.granite)
	Kit.ball(m, 0.9, x, 1.9, -0.15, color, M.granite)
	Kit.blob(m, 1.2, 0.5, 0.4, x, 2.2, 0.1, P.wood, M.granite, { collide = false })
	for _, ex in ipairs({ -0.22, 0.22 }) do
		Kit.ball(m, 0.18, x + ex, 2.0, -0.55, P.white, M.smooth, { collide = false })
		Kit.ball(m, 0.08, x + ex, 2.0, -0.63, P.black, M.smooth, { collide = false })
	end
	Kit.box(m, 0.5, mouthOpen and 0.25 or 0.08, 0.1, x, 1.7, -0.6, P.lacquer_dark, M.smooth, { collide = false })
end

return function(Registry)
	-- Lighting --------------------------------------------------------------------------------
	Registry.register("chochin_red", function(m, item)
		chochin(m, item, P.lacquer, "ラーメン", "#141414")
	end)
	Registry.register("chochin_white", function(m, item)
		chochin(m, item, P.paper, "寿司", "#B3262E")
	end)
	Registry.register("fireworks_lantern", function(m, item)
		chochin(m, item, P.neon_blue, "花火", "#FFFFFF")
	end)
	Registry.register("andon_lamp", function(m, item)
		Kit.finish(m, size(item))
		local h = item.size[2]
		for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }) do
			Kit.box(m, 0.12, h, 0.12, c[1] * 0.6, h / 2, c[2] * 0.6, P.wood_black, M.wood)
		end
		local paper = Kit.box(m, 1.1, h - 0.9, 1.1, 0, (h - 0.9) / 2 + 0.6, 0, P.paper_warm, M.neon, { collide = false })
		paper.Transparency = 0.1
		for i = 0, 3 do
			Kit.box(m, 1.25, 0.08, 1.25, 0, 0.6 + i * (h - 0.9) / 3, 0, P.wood_black, M.wood, { collide = false })
		end
		Kit.light(paper, "Point", P.lamp_warm, 12, 1)
	end)
	Registry.register("paper_pendant", function(m, item)
		Kit.finish(m, size(item))
		local h = item.size[2]
		Kit.cyl(m, 0.05, 0.8, 0, h - 0.4, 0, P.black, M.fabric, { collide = false })
		local globe = Kit.ball(m, 1.7, 0, h - 1.65, 0, P.paper, M.neon, { collide = false })
		globe.Transparency = 0.05
		for i = -1, 1 do
			Kit.cyl(m, 1.7 - math.abs(i) * 0.5, 0.03, 0, h - 1.65 + i * 0.5, 0, P.paper_warm, M.smooth, { collide = false })
		end
		Kit.light(globe, "Point", P.lamp_warm, 14, 1.1)
		globe:SetAttribute("Animate", "sway")
	end)
	Registry.register("toro_stone", function(m, item)
		stoneLantern(m, item, P.stone, P.stone_dark)
	end)
	Registry.register("kyoto_lantern", function(m, item)
		stoneLantern(m, item, P.stone_light, P.moss, P.lamp)
	end)
	Registry.register("snow_lantern", function(m, item)
		stoneLantern(m, item, P.stone, P.white, P.paper_warm)
	end)
	Registry.register("neon_ramen", function(m, item)
		neon(m, item, "ラーメン", P.neon_red)
	end)
	Registry.register("neon_sushi", function(m, item)
		neon(m, item, "寿司", P.neon_blue)
	end)
	local function lanternString(m, item, colors, scale)
		Kit.finish(m, size(item))
		local w, h = item.size[1], item.size[2]
		Kit.cylH(m, 0.05, w, 0, h - 0.1, 0, P.black, M.fabric, { collide = false })
		local n = 5
		for i = 0, n - 1 do
			local x = -w / 2 + 0.6 + (w - 1.2) * i / (n - 1)
			local sag = 0.4 * math.sin(math.pi * i / (n - 1))
			local c = colors[i % #colors + 1]
			local b = Kit.blob(m, 0.7 * scale, 1 * scale, 0.7 * scale, x, h - 0.75 * scale - sag, 0, c, M.smooth, { collide = false })
			Kit.cyl(m, 0.45 * scale, 0.1, x, h - 0.2 * scale - sag, 0, P.black, M.smooth, { collide = false })
			b:SetAttribute("Animate", "sway")
			if i % 2 == 0 then
				Kit.light(b, "Point", P.lamp_warm, 9, 0.8)
			end
		end
	end
	Registry.register("lantern_string", function(m, item)
		lanternString(m, item, { P.lacquer, P.paper }, 1)
	end)
	Registry.register("yatai_lanterns", function(m, item)
		lanternString(m, item, { P.lacquer, P.lacquer, P.gold }, 1.4)
	end)

	-- Plants ------------------------------------------------------------------------------------
	Registry.register("bamboo_pot", function(m, item)
		Kit.finish(m, size(item))
		local h = item.size[2]
		plantPot(m, 1.4, 1.1, P.charcoal)
		for i, c in ipairs({ { -0.3, -0.2 }, { 0.25, -0.25 }, { 0, 0.3 }, { 0.35, 0.2 }, { -0.35, 0.25 } }) do
			local sh = h - 1.2 - (i % 3) * 0.4
			Kit.cyl(m, 0.16, sh, c[1], 1.1 + sh / 2, c[2], P.bamboo_green, M.wood)
			for k = 1, 3 do
				Kit.cyl(m, 0.19, 0.06, c[1], 1.1 + sh * k / 4, c[2], P.leaf_dark, M.wood, { collide = false })
			end
			Kit.box(m, 0.6, 0.04, 0.18, c[1] + 0.3, 1.1 + sh - 0.1, c[2], P.leaf, M.leafy, { collide = false, rot = CFrame.Angles(0, math.rad(i * 70), math.rad(-25)) })
			Kit.box(m, 0.6, 0.04, 0.18, c[1] - 0.3, 1.1 + sh - 0.4, c[2], P.leaf_light, M.leafy, { collide = false, rot = CFrame.Angles(0, math.rad(i * 40), math.rad(25)) })
		end
	end)
	Registry.register("kokedama", function(m, item)
		Kit.finish(m, size(item))
		local h = item.size[2]
		Kit.cyl(m, 0.04, 1.2, 0, h - 0.6, 0, P.wood, M.fabric, { collide = false })
		local ball = Kit.ball(m, 0.9, 0, h - 1.6, 0, P.moss, M.leafy, { collide = false })
		ball:SetAttribute("Animate", "sway")
		foliage(m, { { 0, h - 1.05, 0, 0.6, 0.4 }, { 0.25, h - 1.0, 0.1, 0.4, 0.3 } }, P.leaf_light)
	end)
	local function bonsai(m, item, scale, pot)
		Kit.finish(m, size(item))
		local s = scale
		Kit.box(m, 1.6 * s, 0.35 * s, 1.0 * s, 0, 0.175 * s, 0, pot or P.indigo, M.smooth)
		Kit.box(m, 1.5 * s, 0.05, 0.9 * s, 0, 0.36 * s, 0, P.moss, M.leafy, { collide = false })
		Kit.cyl(m, 0.22 * s, 0.7 * s, -0.1 * s, 0.7 * s, 0, P.wood_dark, M.wood, { rot = CFrame.Angles(0, 0, math.rad(-20)) })
		Kit.cyl(m, 0.16 * s, 0.6 * s, 0.2 * s, 1.05 * s, 0, P.wood_dark, M.wood, { rot = CFrame.Angles(0, 0, math.rad(45)) })
		foliage(m, {
			{ -0.35 * s, 1.15 * s, 0, 0.8 * s, 0.3 * s }, { 0.45 * s, 1.3 * s, 0.05 * s, 0.7 * s, 0.25 * s },
			{ 0.05 * s, 1.45 * s, -0.05 * s, 0.6 * s, 0.25 * s },
		}, P.leaf_dark)
	end
	Registry.register("bonsai_pine", function(m, item)
		bonsai(m, item, 1)
	end)
	Registry.register("bonsai_ancient", function(m, item)
		Kit.finish(m, size(item))
		Kit.box(m, 2.6, 1.2, 2.2, 0, 0.6, 0, P.wood_black, M.wood)
		local sub = Kit.model("b")
		sub.Parent = m
		local fake = { size = { 2.6, 2.6, 2.2 } }
		bonsai(sub, fake, 1.6, P.lacquer_dark)
		sub.PrimaryPart:Destroy()
		for _, d in ipairs(sub:GetDescendants()) do
			if d:IsA("BasePart") then
				d.CFrame = CFrame.new(0, 1.2, 0) * d.CFrame
			end
		end
	end)
	Registry.register("ikebana", function(m, item)
		Kit.finish(m, size(item))
		Kit.cyl(m, 0.6, 0.7, 0, 0.35, 0, P.ink, M.smooth)
		Kit.cyl(m, 0.05, 1.1, -0.1, 1.2, 0, P.leaf, M.wood, { collide = false, rot = CFrame.Angles(0, 0, math.rad(15)) })
		Kit.cyl(m, 0.05, 0.9, 0.15, 1.1, 0.05, P.leaf, M.wood, { collide = false, rot = CFrame.Angles(0, 0, math.rad(-20)) })
		Kit.ball(m, 0.3, -0.25, 1.7, 0, P.sakura, M.smooth, { collide = false })
		Kit.ball(m, 0.25, 0.32, 1.5, 0.05, P.lacquer, M.smooth, { collide = false })
		Kit.ball(m, 0.2, 0, 1.35, -0.15, P.white, M.smooth, { collide = false })
	end)
	Registry.register("maple_tree", function(m, item)
		tree(m, item, P.maple, false)
	end)
	Registry.register("sakura_tree", function(m, item)
		tree(m, item, P.sakura, true)
	end)

	-- Art & walls --------------------------------------------------------------------------------
	Registry.register("noren_red", function(m, item)
		noren(m, item, P.lacquer, "ラーメン", "#FFFFFF")
	end)
	Registry.register("noren_indigo", function(m, item)
		noren(m, item, P.indigo, "寿司", "#FFFFFF")
	end)
	Registry.register("menu_plaques", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		Kit.box(m, w, 0.15, d, 0, h - 0.1, 0, P.wood_dark, M.wood, { collide = false })
		local words = { "醤油", "塩", "味噌", "鮭", "鮪", "茶" }
		for i, word in ipairs(words) do
			local x = -w / 2 + w / #words * (i - 0.5)
			local tag = Kit.box(m, w / #words - 0.1, h - 0.35, 0.08, x, (h - 0.35) / 2, d / 2 - 0.1, P.hinoki, M.wood, { collide = false })
			Kit.text(tag, Enum.NormalId.Front, word, { color = "#2B2320", font = JP_FONT, pps = 40 })
		end
	end)
	Registry.register("fan_wall", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		local cx, cy = 0, 0.2
		for i = 0, 8 do
			local a = math.rad(-80 + i * 20)
			local len = h - 0.3
			local cf = CFrame.new(cx, cy, d / 2 - 0.1) * CFrame.Angles(0, 0, a) * CFrame.new(0, len / 2, 0)
			Kit.part(m, Vector3.new(w / 6, len, 0.04), cf, (i % 2 == 0) and P.lacquer or P.gold, M.fabric, { collide = false })
		end
		Kit.ball(m, 0.25, cx, cy, d / 2 - 0.05, P.wood_black, M.smooth, { collide = false })
	end)
	Registry.register("kakejiku", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		local paper = Kit.box(m, w - 0.2, h - 0.7, 0.04, 0, h / 2, d / 2 - 0.1, P.paper, M.fabric, { collide = false })
		Kit.box(m, w, h - 0.4, 0.03, 0, h / 2, d / 2 - 0.07, P.indigo, M.fabric, { collide = false })
		Kit.text(paper, Enum.NormalId.Front, "和", { color = "#141414", font = JP_FONT, pps = 30 })
		Kit.cylH(m, 0.12, w + 0.2, 0, h - 0.15, d / 2 - 0.1, P.wood_dark, M.wood, { collide = false })
		Kit.cylH(m, 0.16, w + 0.4, 0, 0.15, d / 2 - 0.1, P.wood_black, M.wood, { collide = false })
	end)
	Registry.register("wagasa", function(m, item)
		Kit.finish(m, size(item))
		local w, h = item.size[1], item.size[2]
		Kit.cyl(m, 0.8, 0.3, 0, 0.15, 0, P.wood_black, M.wood)
		Kit.cyl(m, 0.12, h - 0.4, 0, (h - 0.4) / 2 + 0.3, 0, P.wood_dark, M.wood)
		local canopy = Kit.cyl(m, w, 0.12, 0, h - 0.5, 0, P.lacquer, M.fabric, { collide = false })
		local _ = canopy
		Kit.cyl(m, w * 0.6, 0.2, 0, h - 0.35, 0, P.lacquer, M.fabric, { collide = false })
		Kit.ball(m, 0.3, 0, h - 0.15, 0, P.wood_black, M.smooth, { collide = false })
		for i = 0, 7 do
			local a = math.rad(i * 45)
			local cf = CFrame.new(0, h - 0.55, 0) * CFrame.Angles(0, a, 0) * CFrame.new(w / 4, -0.02, 0)
			Kit.part(m, Vector3.new(w / 2, 0.03, 0.06), cf, P.gold, M.wood, { collide = false })
		end
	end)
	Registry.register("wave_painting", function(m, item)
		Kit.finish(m, size(item))
		local w, h, d = item.size[1], item.size[2], item.size[3]
		local z = d / 2 - 0.08
		Kit.box(m, w - 0.3, h - 0.3, 0.04, 0, h / 2, z, P.paper_warm, M.fabric, { collide = false })
		local bands = { P.navy, P.indigo, P.water_dark, P.water }
		for i, c in ipairs(bands) do
			local bh = (h - 0.6) * 0.5 / #bands
			Kit.box(m, w - 0.5, bh, 0.03, 0, 0.3 + bh * (i - 0.5), z - 0.02, c, M.fabric, { collide = false })
		end
		for i = 0, 5 do
			Kit.blob(m, 0.6, 0.35, 0.02, -w / 2 + 0.6 + i * (w - 1.2) / 5, 0.3 + (h - 0.6) * 0.5 + 0.05 * (i % 2), z - 0.04, P.white, M.smooth, { collide = false })
		end
		Kit.ball(m, 0.6, w / 2 - 0.9, h - 0.8, z - 0.03, P.lacquer, M.smooth, { collide = false })
		frame(m, w, h, 0.2, P.wood_black)
	end)
	Registry.register("byobu", function(m, item)
		Kit.finish(m, size(item))
		local w, h = item.size[1], item.size[2]
		local n = 6
		local pw = w / n
		for i = 0, n - 1 do
			local x = -w / 2 + pw * (i + 0.5)
			local z = (i % 2 == 0) and -0.15 or 0.15
			local yaw = (i % 2 == 0) and 12 or -12
			local cf = CFrame.new(x, h / 2, z) * CFrame.Angles(0, math.rad(yaw), 0)
			Kit.part(m, Vector3.new(pw - 0.04, h, 0.1), cf, P.gold, M.foil)
			Kit.part(m, Vector3.new(pw + 0.02, 0.15, 0.14), cf * CFrame.new(0, h / 2 - 0.07, 0), P.wood_black, M.wood, { collide = false })
			Kit.part(m, Vector3.new(pw + 0.02, 0.15, 0.14), cf * CFrame.new(0, -h / 2 + 0.07, 0), P.wood_black, M.wood, { collide = false })
			Kit.blob(m, pw * 0.8, 0.6, 0.05, x, h * 0.62 + (i % 3) * 0.2, z - 0.08, P.leaf_dark, M.smooth, { collide = false })
		end
	end)
	Registry.register("kimono_display", function(m, item)
		Kit.finish(m, size(item))
		local w, h = item.size[1], item.size[2]
		Kit.box(m, w * 0.6, 0.3, 0.8, 0, 0.15, 0, P.wood_black, M.wood)
		Kit.box(m, 0.15, h - 0.4, 0.15, 0, h / 2, 0.2, P.wood_black, M.wood)
		Kit.cylH(m, 0.12, w, 0, h - 0.6, 0.1, P.wood_black, M.wood, { collide = false })
		Kit.box(m, 1.6, h - 1.8, 0.25, 0, (h - 1.8) / 2 + 0.6, 0, P.lacquer, M.fabric)
		Kit.box(m, w - 0.2, 1.4, 0.2, 0, h - 1.4, 0, P.lacquer, M.fabric, { collide = false })
		Kit.box(m, 1.65, 0.5, 0.3, 0, h - 2.6, 0, P.gold, M.fabric, { collide = false })
		for i = 0, 4 do
			Kit.ball(m, 0.35, -0.6 + i * 0.3, 1.2 + (i % 2) * 0.9, -0.14, P.sakura, M.fabric, { collide = false })
		end
	end)

	-- Statues & objects ------------------------------------------------------------------------
	local function maneki(m, item, body, accent)
		Kit.finish(m, size(item))
		local s = item.size[2] / 1.3
		Kit.blob(m, 0.75 * s, 0.7 * s, 0.6 * s, 0, 0.35 * s, 0, body, M.smooth)
		Kit.ball(m, 0.62 * s, 0, 0.95 * s, -0.02 * s, body, M.smooth, { collide = false })
		for _, x in ipairs({ -0.2, 0.2 }) do
			Kit.wedge(m, 0.05, 0.22 * s, 0.18 * s, CFrame.new(x * s, 1.27 * s, 0) * CFrame.Angles(0, math.rad(90), 0), body, M.smooth, { collide = false })
			Kit.ball(m, 0.08 * s, x * 0.6 * s, 1.0 * s, -0.3 * s, P.black, M.smooth, { collide = false })
		end
		Kit.cyl(m, 0.55 * s, 0.06 * s, 0, 0.68 * s, 0, P.lacquer, M.smooth, { collide = false })
		Kit.ball(m, 0.12 * s, 0, 0.64 * s, -0.27 * s, accent, M.metal, { collide = false })
		Kit.cyl(m, 0.3 * s, 0.05, 0.15 * s, 0.35 * s, -0.31 * s, accent, M.metal, { collide = false, rot = CFrame.Angles(math.rad(90), 0, 0) })
		local paw = Kit.blob(m, 0.18 * s, 0.4 * s, 0.18 * s, -0.33 * s, 1.0 * s, -0.12 * s, body, M.smooth, { collide = false, name = "Paw" })
		paw:SetAttribute("Animate", "paw")
	end
	Registry.register("maneki_neko", function(m, item)
		maneki(m, item, P.white, P.gold)
	end)
	Registry.register("maneki_gold", function(m, item)
		maneki(m, item, P.gold, P.lacquer)
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("BasePart") and d.Color == P.gold then
				d.Material = M.foil
			end
		end
	end)
	Registry.register("daruma", function(m, item)
		Kit.finish(m, size(item))
		Kit.blob(m, 1, 1.1, 0.95, 0, 0.55, 0, P.lacquer, M.smooth)
		Kit.blob(m, 0.6, 0.5, 0.1, 0, 0.62, -0.42, P.porcelain, M.smooth, { collide = false })
		Kit.ball(m, 0.14, -0.13, 0.68, -0.47, P.black, M.smooth, { collide = false })
		Kit.ball(m, 0.14, 0.13, 0.68, -0.47, P.white, M.smooth, { collide = false })
		Kit.box(m, 0.4, 0.15, 0.02, 0, 0.3, -0.47, P.gold, M.smooth, { collide = false })
	end)
	Registry.register("soy_barrel", function(m, item)
		Kit.finish(m, size(item))
		local w, h = item.size[1], item.size[2]
		local body = Kit.cyl(m, w - 0.1, h - 0.2, 0, (h - 0.2) / 2, 0, P.wood, M.wood)
		Kit.cyl(m, w - 0.2, 0.2, 0, h - 0.1, 0, P.paper_warm, M.fabric, { collide = false })
		for _, y in ipairs({ 0.4, h / 2, h - 0.5 }) do
			Kit.cyl(m, w + 0.02, 0.12, 0, y, 0, P.bamboo, M.fabric, { collide = false })
