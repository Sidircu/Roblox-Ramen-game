	skin = { "#F5D6BA", "#E8B996", "#D19A6E", "#A8714A", "#7A4E30", "#FBE3CC" },
	hair = { "#1A1412", "#2E2018", "#4A3020", "#6A4A2A", "#B8B0A8", "#E8D8B0", "#3A2A4A" },
