]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000008"><Properties><string name="Name">Events</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Seasonal events (UTC dates). While active: themed items in the catalog and a popularity bonus.
local list = {
	{ id = "hanami", from = { 3, 20 }, to = { 4, 30 }, popularity = 0.15, color = "#F7B7C9" },
	{ id = "tanabata", from = { 7, 1 }, to = { 8, 20 }, popularity = 0.15, color = "#7FB7E8" },
	{ id = "tsukimi", from = { 9, 10 }, to = { 10, 31 }, popularity = 0.15, color = "#F2D27A" },
	{ id = "shogatsu", from = { 12, 20 }, to = { 1, 15 }, popularity = 0.20, color = "#D9363E" },
}
local byId = {}
for i, e in ipairs(list) do
	e.order = i
	byId[e.id] = e
end

local function inRange(month, day, from, to)
	local v = month * 100 + day
	local a = from[1] * 100 + from[2]
	local b = to[1] * 100 + to[2]
	if a <= b then
		return v >= a and v <= b
	end
	return v >= a or v <= b -- wraps over new year
end

-- Returns the active event (or nil) for a unix time.
local function active(now)
	local d = os.date("!*t", now)
	for _, e in ipairs(list) do
		if inRange(d.month, d.day, e.from, e.to) then
			return e
		end
	end
	return nil
end

return { list = list, byId = byId, active = active }
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000009"><Properties><string name="Name">Expansions</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Restaurant zones. Rects are { x0, z0, x1, z1 } relative to the plot origin (street side is -Z).
-- area: dining | kitchen | storage | outdoor | garden | tatami
-- room: walls are generated between different rooms and around the building.
-- openings: doors in walls ({ floor, axis = "z" (wall along X at z = at) | "x" (wall along Z at x = at), from, to }).
-- stairs: { floor (bottom floor), rect } rising towards +Z; the floor above gets a hole.
local list = {
	{
		id = "zone_base", lv = 1, cost = 0, requires = {},
		zones = {
			{ id = "base_dining", rect = { -18, 0, 18, 16 }, floor = 0, area = "dining", room = "main" },
			{ id = "base_kitchen", rect = { -18, 16, 18, 28 }, floor = 0, area = "kitchen", room = "main" },
			{ id = "base_storage", rect = { 18, 12, 30, 28 }, floor = 0, area = "storage", room = "storage" },
		},
		openings = {
			{ floor = 0, axis = "z", at = 0, from = -3, to = 3, kind = "entrance" },
			{ floor = 0, axis = "x", at = 18, from = 20, to = 24, kind = "door" },
			{ floor = 0, axis = "z", at = 12, from = 21, to = 27, kind = "loading" },
		},
	},
	{ id = "zone_east", lv = 3, cost = 5000, requires = { "zone_base" }, zones = { { id = "east_dining", rect = { -34, 0, -18, 16 }, floor = 0, area = "dining", room = "main" } } },
	{ id = "zone_storage2", lv = 5, cost = 8000, requires = { "zone_base" }, zones = { { id = "storage2", rect = { 30, 12, 42, 28 }, floor = 0, area = "storage", room = "storage" } } },
	{ id = "zone_west", lv = 8, cost = 25000, requires = { "zone_east" }, zones = { { id = "west_dining", rect = { -50, 0, -34, 28 }, floor = 0, area = "dining", room = "main" } } },
	{ id = "zone_terrace", lv = 12, cost = 60000, requires = { "zone_base" }, zones = { { id = "terrace", rect = { -18, -9, 18, 0 }, floor = 0, area = "outdoor", outdoor = true, gaps = { { axis = "z", at = -9, from = -3, to = 3 } } } } },
	{
		id = "zone_garden", lv = 15, cost = 100000, requires = { "zone_base" },
		zones = { { id = "garden", rect = { -18, 28, 6, 46 }, floor = 0, area = "garden", outdoor = true } },
		openings = { { floor = 0, axis = "z", at = 28, from = -8, to = -4, kind = "door" } },
	},
	{
		id = "zone_tatami", lv = 18, cost = 180000, requires = { "zone_west" },
		zones = { { id = "tatami", rect = { -50, 28, -34, 44 }, floor = 0, area = "tatami", room = "tatami", floorStyle = "floor_tatami", wallStyle = "wall_shoji" } },
		openings = { { floor = 0, axis = "z", at = 28, from = -44, to = -40, kind = "door" } },
	},
	{ id = "zone_kitchen_pro", lv = 20, cost = 250000, requires = { "zone_east" }, zones = { { id = "kitchen_pro", rect = { -34, 16, -18, 28 }, floor = 0, area = "kitchen", room = "main" } } },
	{
		id = "zone_floor2", lv = 25, cost = 600000, requires = { "zone_base" },
		zones = { { id = "floor2", rect = { -18, 0, 18, 28 }, floor = 1, area = "dining", room = "f2" } },
		stairs = { { floor = 0, rect = { -17.5, 1, -13.5, 15 } } },
	},
	{ id = "sign_rooftop", lv = 28, cost = 500000, requires = { "zone_base" }, popularity = 0.3, cosmetic = true, reno = "exterior" },
	{ id = "facade_deluxe", lv = 30, cost = 1000000, requires = { "zone_base" }, ambience = 60, cosmetic = true, reno = "exterior" },
	{
		id = "zone_rooftop", lv = 35, cost = 2000000, requires = { "zone_floor2" },
		zones = { { id = "rooftop", rect = { -18, 0, 18, 28 }, floor = 2, area = "outdoor", outdoor = true } },
		stairs = { { floor = 1, rect = { 13.5, 1, 17.5, 15 } } },
	},
	-- Renovations: the starting restaurant is plain; these add the detailed look piece by piece.
	-- reno = tab group; the shell builder reads the owned ids, `style` keeps the matching
	-- Detail_<style> group inside placeable models (see Registry.build).
	{ id = "reno_storage", lv = 2, cost = 1500, requires = { "zone_base" }, cosmetic = true, reno = "interior", ambience = 2 },
	{ id = "reno_wainscot", lv = 3, cost = 3500, requires = { "zone_base" }, cosmetic = true, reno = "interior", ambience = 5 },
	{ id = "reno_kitchen_tiles", lv = 4, cost = 4000, requires = { "zone_base" }, cosmetic = true, reno = "interior", ambience = 3 },
	{ id = "reno_facade", lv = 4, cost = 6000, requires = { "zone_base" }, cosmetic = true, reno = "exterior", ambience = 6, popularity = 0.03 },
	{ id = "reno_entrance", lv = 5, cost = 8000, requires = { "zone_base" }, cosmetic = true, reno = "exterior", ambience = 8, popularity = 0.04 },
	{ id = "reno_counter", lv = 6, cost = 10000, requires = { "zone_base" }, cosmetic = true, reno = "furniture", style = "counter", ambience = 10 },
	{ id = "reno_eaves", lv = 7, cost = 14000, requires = { "zone_base" }, cosmetic = true, reno = "exterior", ambience = 10, popularity = 0.04 },
	{ id = "reno_kitchen_gear", lv = 8, cost = 16000, requires = { "zone_base" }, cosmetic = true, reno = "furniture", style = "kitchen", ambience = 6 },
	{ id = "reno_windows", lv = 9, cost = 18000, requires = { "zone_base" }, cosmetic = true, reno = "exterior", ambience = 10 },
	{ id = "reno_beams", lv = 10, cost = 22000, requires = { "reno_wainscot" }, cosmetic = true, reno = "interior", ambience = 14 },
	{ id = "reno_tableware", lv = 11, cost = 28000, requires = { "zone_base" }, cosmetic = true, reno = "furniture", style = "tableware", ambience = 16 },
	{ id = "reno_bamboo", lv = 13, cost = 40000, requires = { "reno_facade" }, cosmetic = true, reno = "exterior", ambience = 18 },
	{ id = "reno_furnish", lv = 15, cost = 60000, requires = { "zone_base" }, cosmetic = true, reno = "furniture", style = "furnish", ambience = 24 },
}

local byId = {}
for i, e in ipairs(list) do
	e.order = i
	byId[e.id] = e
end

-- Set of detail styles owned with these zones/renovations ({ counter = true, ... })
local function styles(zones)
	local out = {}
	for _, e in ipairs(list) do
		if e.style and zones and zones[e.id] then
			out[e.style] = true
		end
	end
	return out
end

-- Every style (used by previews and thumbnails that show the finished look)
local function allStyles()
	local out = {}
	for _, e in ipairs(list) do
		if e.style then
			out[e.style] = true
		end
	end
	return out
end

return {
	list = list,
	byId = byId,
	styles = styles,
	allStyles = allStyles,
	-- Fixed points of the plot (relative to origin)
	Entrance = { x = 0, z = -1.5 },
	StreetWalkZ = -11.5,
	StreetEnds = { -110, 110 },
	LoadingBay = { x = 24, z = 5 },
	Supplier = { x = 17.7, y = 5, z = 17.5 },
	MenuBoard = { x = -8.6, z = -2.6 },
	PlotBounds = { -60, -14, 52, 52 },
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000010"><Properties><string name="Name">Franchise</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Franchise cities (prestige). Each star: +25% yen, +10% XP permanently.
local list = {
	{ id = "tokyo", star = 0, palette = { road = "#2A2A2E", building = "#6B5A4E", accent = "#B3262E", sky = "#9EC3E6" } },
	{ id = "kyoto", star = 1, palette = { road = "#4A4038", building = "#7A5A3A", accent = "#C8462E", sky = "#E6C9A0" } },
	{ id = "osaka", star = 2, palette = { road = "#26262C", building = "#4A4A5A", accent = "#E8B83A", sky = "#8FB0E0" } },
	{ id = "sapporo", star = 3, palette = { road = "#E8ECF0", building = "#5A6A7A", accent = "#3A6EB3", sky = "#C9D9E8" }, snow = true },
	{ id = "fukuoka", star = 4, palette = { road = "#2E2A2A", building = "#6A4A4A", accent = "#D9363E", sky = "#F0B07A" } },
	{ id = "okinawa", star = 5, palette = { road = "#B8A88A", building = "#E8DCC8", accent = "#2EA3B3", sky = "#7FD0F0" } },
}
local byId = {}
for i, c in ipairs(list) do
	c.order = i
	byId[c.id] = c
end
return {
	list = list,
	byId = byId,
	RequiredLevel = 40,
	RequiredRating = 4.5,
	RequiredZones = { "zone_east", "zone_west", "zone_storage2", "zone_terrace", "zone_garden", "zone_tatami", "zone_kitchen_pro", "zone_floor2" },
	YenPerStar = 0.25,
	XpPerStar = 0.10,
	StartYen = 2000,
	RegionalLevel = 5,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000011"><Properties><string name="Name">GameConfig</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- General tuning constants. Balance tables live in the sibling Config modules.
return {
	PlaceName = "Sakura Ramen & Sushi Tycoon",

	-- Interaction
	InteractRange = 11, -- studs between character and object
	IngredientHandCapacity = 6,

	-- Building
	FloorHeight = 15, -- floor-to-floor distance
	WallHeight = 14,
	CellSize = 2, -- wall generation grid
	PathCell = 1, -- walkability grid for placement validation
	PathClearance = 0.9, -- obstacles are inflated by this (corridors >= 2 studs)
	GridSizes = { 1, 5, 10 },
	RotationSteps = { 90, 45, 15 },
	SellRefund = 0.75,
	FullRefundSeconds = 30,

	-- Day cycle (1 game hour = 1 real minute)
	Day = {
		OpenHour = 11,
		CloseHour = 23,
		SecondsPerHour = 60,
		PrepClock = 9.5,
		Peaks = { { 12, 14 }, { 19, 21 } },
		PeakFactor = 0.6,
		ReportAutoClose = 15,
		ManagerAutoOpenDelay = 20,
	},

	-- Customers
	Customers = {
		MaxNpcs = 40,
		BaseInterval = 18,
		MinInterval = 2.5,
		MenuReadTime = { 2, 4 },
		EatTime = { sushi = 12, ramen = 18, side = 8, drink = 6, dessert = 8 },
		ExtraOrderChance = 0.4,
		SecondOrderChance = 0.15,
		QueuePerBench = 3,
		BaseQueue = 2,
		StuckTeleportSeconds = 8,
		SeatHeightOffset = 1.05,
		WalkSpeed = 10,
		DefaultRating = 3.0,
		RecentReviews = 50,
	},

	-- Cooking step durations (seconds) and which upgrade speeds them up
	Steps = {
		combine = { time = 0.9, tool = "up_knife" },
		cut = { time = 1.0, tool = "up_knife" },
		roll = { time = 1.1, tool = "up_mat" },
		mold = { time = 1.0, tool = "up_mat" },
