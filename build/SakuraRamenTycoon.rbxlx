<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" version="4"><Item class="ReplicatedFirst" referent="RBX000002"><Properties><string name="Name">ReplicatedFirst</string></Properties><Item class="LocalScript" referent="RBX000001"><Properties><string name="Name">Loading</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Loading screen (shown while the world is prepared or while teleporting to the personal world).
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local isItalian = string.sub(string.lower(player.LocaleId or ""), 1, 2) == "it"

local gui = Instance.new("ScreenGui")
gui.Name = "Loading"
gui.IgnoreGuiInset = true
gui.DisplayOrder = 100
gui.ResetOnSpawn = false

local bg = Instance.new("Frame")
bg.Size = UDim2.fromScale(1, 1)
bg.BackgroundColor3 = Color3.fromRGB(244, 235, 221)
bg.Parent = gui
local grad = Instance.new("UIGradient")
grad.Color = ColorSequence.new(Color3.fromRGB(247, 227, 192), Color3.fromRGB(244, 210, 200))
grad.Rotation = 90
grad.Parent = bg

local title = Instance.new("TextLabel")
title.AnchorPoint = Vector2.new(0.5, 0.5)
title.Position = UDim2.fromScale(0.5, 0.38)
title.Size = UDim2.fromScale(0.8, 0.12)
title.BackgroundTransparency = 1
title.Text = "Sakura Ramen & Sushi Tycoon"
title.TextScaled = true
title.TextColor3 = Color3.fromRGB(179, 38, 46)
title.FontFace = Font.new("rbxasset://fonts/families/FredokaOne.json")
title.AutoLocalize = false
title.Parent = bg

local kanji = Instance.new("TextLabel")
kanji.AnchorPoint = Vector2.new(0.5, 0.5)
kanji.Position = UDim2.fromScale(0.5, 0.5)
kanji.Size = UDim2.fromScale(0.5, 0.07)
kanji.BackgroundTransparency = 1
kanji.Text = "ら ー め ん ・ 寿 司"
kanji.TextScaled = true
kanji.TextColor3 = Color3.fromRGB(43, 35, 32)
kanji.FontFace = Font.new("rbxasset://fonts/families/FredokaOne.json")
kanji.AutoLocalize = false
kanji.Parent = bg

local flower = Instance.new("TextLabel")
flower.AnchorPoint = Vector2.new(0.5, 0.5)
flower.Position = UDim2.fromScale(0.5, 0.64)
flower.Size = UDim2.fromOffset(70, 70)
flower.BackgroundTransparency = 1
flower.Text = "🌸"
flower.TextScaled = true
flower.AutoLocalize = false
flower.Parent = bg

local status = Instance.new("TextLabel")
status.AnchorPoint = Vector2.new(0.5, 0.5)
status.Position = UDim2.fromScale(0.5, 0.76)
status.Size = UDim2.fromScale(0.8, 0.045)
status.BackgroundTransparency = 1
status.Text = isItalian and "Stiamo preparando il tuo ristorante…" or "Preparing your restaurant…"
status.TextScaled = true
status.TextColor3 = Color3.fromRGB(91, 58, 36)
status.FontFace = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.SemiBold)
status.AutoLocalize = false
status.Parent = bg

gui.Parent = player:WaitForChild("PlayerGui")
pcall(function()
	ReplicatedFirst:RemoveDefaultLoadingScreen()
end)
pcall(function()
	TeleportService:SetTeleportGui(gui)
end)

local spin = RunService.RenderStepped:Connect(function(dt)
	flower.Rotation = (flower.Rotation + dt * 90) % 360
end)

if not game:IsLoaded() then
	game.Loaded:Wait()
end

local t0 = os.clock()
while os.clock() - t0 < 25 do
	local mode = workspace:GetAttribute("SessionMode")
	if mode == "lobby" then
		status.Text = isItalian and "Ti stiamo portando nel tuo mondo…" or "Taking you to your own world…"
	elseif workspace:GetAttribute("WorldReady") then
		break
	end
	task.wait(0.2)
end

if workspace:GetAttribute("SessionMode") ~= "lobby" then
	task.wait(0.5)
	local info = TweenInfo.new(0.6)
	for _, d in ipairs(bg:GetDescendants()) do
		if d:IsA("TextLabel") then
			TweenService:Create(d, info, { TextTransparency = 1 }):Play()
		end
	end
	TweenService:Create(bg, info, { BackgroundTransparency = 1 }):Play()
	task.wait(0.7)
	spin:Disconnect()
	gui:Destroy()
end
]]></ProtectedString></Properties></Item></Item><Item class="ReplicatedStorage" referent="RBX000061"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX000059"><Properties><string name="Name">Shared</string></Properties><Item class="Folder" referent="RBX000024"><Properties><string name="Name">Config</string></Properties><Item class="ModuleScript" referent="RBX000003"><Properties><string name="Name">Achievements</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Achievements are generated from tiered templates. Name key: "ach.<stat>" with {n}.
local templates = {
	{ stat = "dishes", tiers = { 10, 100, 1000, 10000, 100000 }, sakura = { 5, 10, 20, 35, 50 } },
	{ stat = "customers", tiers = { 10, 250, 2500, 25000 }, sakura = { 5, 10, 25, 50 } },
	{ stat = "earned", tiers = { 10000, 250000, 5000000, 100000000 }, sakura = { 5, 15, 30, 50 } },
	{ stat = "decor", tiers = { 5, 25, 75, 150 }, sakura = { 5, 10, 20, 40 } },
	{ stat = "staff", tiers = { 1, 4, 8, 12 }, sakura = { 5, 10, 20, 30 } },
	{ stat = "gold_mastery", tiers = { 1, 5, 15, 30 }, sakura = { 10, 20, 35, 50 } },
	{ stat = "level", tiers = { 5, 10, 20, 30, 40, 50 }, sakura = { 5, 10, 15, 20, 30, 50 } },
	{ stat = "licenses", tiers = { 3, 8, 17 }, sakura = { 5, 15, 40 } },
	{ stat = "zones", tiers = { 2, 5, 9 }, sakura = { 5, 15, 40 } },
	{ stat = "renos", tiers = { 3, 8, 15 }, sakura = { 5, 15, 40 } },
	{ stat = "five_stars", tiers = { 10, 100, 1000, 10000 }, sakura = { 5, 10, 25, 50 } },
	{ stat = "franchise", tiers = { 1, 2, 3, 4, 5 }, sakura = { 20, 30, 40, 50, 100 } },
	{ stat = "days", tiers = { 1, 10, 50, 200 }, sakura = { 3, 10, 25, 50 } },
	{ stat = "washed", tiers = { 50, 1000, 20000 }, sakura = { 5, 15, 40 } },
}

local list = {}
local byId = {}
for _, t in ipairs(templates) do
	for i, n in ipairs(t.tiers) do
		local a = { id = "ach_" .. t.stat .. "_" .. i, stat = t.stat, target = n, sakura = t.sakura[i], tier = i }
		table.insert(list, a)
		byId[a.id] = a
	end
end

return { list = list, byId = byId }
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000004"><Properties><string name="Name">Ads</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- One-day advertising campaigns.
local list = {
	{ id = "ad_flyers", icon = "📰", cost = 500, lv = 1, popularity = 0.20 },
	{ id = "ad_radio", icon = "📻", cost = 5000, lv = 10, popularity = 0.35 },
	{ id = "ad_tv", icon = "📺", cost = 50000, lv = 25, popularity = 0.60, tourists = true },
}
