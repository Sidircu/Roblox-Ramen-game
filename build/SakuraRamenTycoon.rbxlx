]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000122"><Properties><string name="Name">Kit</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Tiny declarative UI toolkit + the visual theme (washi paper, dark wood, lacquer red, gold).
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Color = require(Shared.Util.Color)
local Locale = require(Shared.Locale)

local Kit = {}

Kit.Theme = {
	paper = Color.hex("#F4EBDD"),
	paperDark = Color.hex("#E6D7BF"),
	wood = Color.hex("#5B3A24"),
	woodLight = Color.hex("#8A5A36"),
	ink = Color.hex("#2B2320"),
	muted = Color.hex("#7A6A5A"),
	red = Color.hex("#B3262E"),
	redDark = Color.hex("#7A1A1F"),
	gold = Color.hex("#D4A23C"),
	green = Color.hex("#5E8F3A"),
	blue = Color.hex("#2E5A8C"),
	white = Color.hex("#FFFFFF"),
	shadow = Color.hex("#000000"),
	locked = Color.hex("#B8AFA2"),
	title = Font.new("rbxasset://fonts/families/FredokaOne.json"),
	body = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Medium),
	bold = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold),
}
local T = Kit.Theme

-- "phone" | "tablet" | "desktop": set by Controllers/UI from the screen size (see UI.rescale)
Kit.profile = "desktop"

function Kit.T(key, params)
	return Locale.t(key, params)
end

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local function tween(o, t, goal, style, dir)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end
Kit.tween = tween

-- Press feedback for any button: a quick squash while pressed, a small grow under the mouse
function Kit.press(b)
	local s = b:FindFirstChild("Press") or Kit.new("UIScale", { Name = "Press", Parent = b })
	local hover = false
	if UserInputService.MouseEnabled then
		b.MouseEnter:Connect(function()
			hover = true
			tween(s, 0.12, { Scale = 1.04 })
		end)
		b.MouseLeave:Connect(function()
			hover = false
			tween(s, 0.12, { Scale = 1 })
		end)
	end
	b.MouseButton1Down:Connect(function()
		tween(s, 0.06, { Scale = 0.92 })
	end)
	b.MouseButton1Up:Connect(function()
		tween(s, 0.2, { Scale = hover and 1.04 or 1 }, Enum.EasingStyle.Back)
	end)
	return b
end

-- A window or card springs open
function Kit.popIn(frame, from)
	local s = frame:FindFirstChild("Pop") or Kit.new("UIScale", { Name = "Pop", Parent = frame })
	s.Scale = from or 0.86
	tween(s, 0.24, { Scale = 1 }, Enum.EasingStyle.Back)
end

-- A short bump (a value changed, something was bought)
function Kit.bump(frame, amount)
	local s = frame:FindFirstChild("Bump") or Kit.new("UIScale", { Name = "Bump", Parent = frame })
	local up = tween(s, 0.08, { Scale = amount or 1.15 })
	up.Completed:Connect(function()
		tween(s, 0.22, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
end

-- Kit.new("Frame", { props }, { children })
function Kit.new(class, props, children)
	local inst = Instance.new(class)
	local parent = nil
	for k, v in pairs(props or {}) do
		if k == "Parent" then
			parent = v
		elseif type(k) == "string" and string.sub(k, 1, 2) == "On" and type(v) == "function" then
			local event = string.sub(k, 3)
			inst[event]:Connect(v)
		else
			inst[k] = v
		end
	end
	if inst:IsA("GuiObject") and props and props.BorderSizePixel == nil then
		inst.BorderSizePixel = 0
	end
	if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
		inst.AutoLocalize = false
		if not (props and props.FontFace) then
			inst.FontFace = T.body
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Kit.corner(r)
	return Kit.new("UICorner", { CornerRadius = UDim.new(0, r or 10) })
end

function Kit.stroke(color, thickness, transparency)
	return Kit.new("UIStroke", { Color = color or T.wood, Thickness = thickness or 2, Transparency = transparency or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

function Kit.padding(px, py)
	py = py or px
	return Kit.new("UIPadding", { PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px), PaddingTop = UDim.new(0, py), PaddingBottom = UDim.new(0, py) })
end

function Kit.list(direction, pad, halign, valign)
	return Kit.new("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, pad or 6),
		HorizontalAlignment = halign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = valign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function Kit.grid(cellW, cellH, pad)
	return Kit.new("UIGridLayout", { CellSize = UDim2.fromOffset(cellW, cellH), CellPadding = UDim2.fromOffset(pad or 8, pad or 8), SortOrder = Enum.SortOrder.LayoutOrder })
end

function Kit.label(text, props)
	props = props or {}
	local base = {
		BackgroundTransparency = 1,
		Text = text or "",
		TextColor3 = T.ink,
		TextSize = 18,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 22),
	}
	for k, v in pairs(props) do
		base[k] = v
	end
	return Kit.new("TextLabel", base)
end

function Kit.title(text, props)
	props = props or {}
	props.FontFace = T.title
	props.TextSize = props.TextSize or 24
	props.TextColor3 = props.TextColor3 or T.wood
	return Kit.label(text, props)
end

-- Button styles: "primary" (red), "gold", "green", "plain", "dark"
function Kit.button(text, opts)
	opts = opts or {}
	local style = opts.style or "primary"
	local bg = ({ primary = T.red, gold = T.gold, green = T.green, plain = T.paperDark, dark = T.wood, blue = T.blue })[style] or T.red
	local fg = (style == "plain" or style == "gold") and T.ink or T.white
	local b = Kit.new("TextButton", {
		Text = text,
		Size = opts.size or UDim2.fromOffset(140, 40),
		BackgroundColor3 = bg,
		TextColor3 = fg,
		TextSize = opts.textSize or 18,
		FontFace = T.bold,
		AutoButtonColor = true,
		LayoutOrder = opts.order or 0,
		Position = opts.position,
		AnchorPoint = opts.anchor,
		TextWrapped = true,
	}, {
		Kit.corner(opts.radius or 10),
		Kit.stroke(style == "plain" and T.woodLight or Color3.new(0, 0, 0), 2, style == "plain" and 0 or 0.7),
		Kit.sheen(),
	})
	if opts.disabled then
		b.BackgroundColor3 = T.locked
		b.AutoButtonColor = false
		b.TextColor3 = T.muted
	else
		Kit.press(b)
	end
	if opts.onClick then
		b.MouseButton1Click:Connect(function()
			if not opts.disabled then
				local Core = require(script.Parent.Parent.Core)
				if Core.C.Audio then
					Core.C.Audio.play("ui")
				end
				opts.onClick()
			end
		end)
	end
	if opts.parent then
		b.Parent = opts.parent
	end
	return b
end

-- Soft top-lit gradient so flat colours read like lacquer
function Kit.sheen(amount)
	local a = amount or 0.82
	return Kit.new("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.new(a, a, a)),
		Rotation = 90,
	})
end

-- Washi panel framed like a lacquer box (dark wood edge, soft paper gradient)
function Kit.panel(props, children)
	local base = { BackgroundColor3 = T.paper, Size = UDim2.fromScale(1, 1) }
	for k, v in pairs(props or {}) do
		base[k] = v
	end
	local f = Kit.new("Frame", base, children)
	Kit.corner(12).Parent = f
	Kit.stroke(T.wood, 3).Parent = f
	Kit.new("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.new(0.94, 0.92, 0.88)), Rotation = 90, Parent = f })
	return f
end

-- Thin inner gold line (only for frames without UIPadding, which would shift it)
function Kit.goldLine(parent, inset)
	local i = inset or 5
	return Kit.new("Frame", {
		Name = "GoldLine",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(i, i),
		Size = UDim2.new(1, -2 * i, 1, -2 * i),
		ZIndex = 0,
		Active = false,
		Parent = parent,
	}, { Kit.corner(9), Kit.stroke(T.gold, 1, 0.35) })
end

function Kit.card(props, children)
	local base = { BackgroundColor3 = Color.hex("#FBF5EA"), Size = UDim2.new(1, 0, 0, 80) }
	for k, v in pairs(props or {}) do
		base[k] = v
	end
	local f = Kit.new("Frame", base, children)
	Kit.corner(10).Parent = f
	Kit.stroke(T.paperDark, 2).Parent = f
	return f
end

-- Scrolling container with automatic canvas size
function Kit.scroll(props, layout)
	local base = {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = T.woodLight,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		ScrollingDirection = Enum.ScrollingDirection.Y,
	}
	for k, v in pairs(props or {}) do
		base[k] = v
	end
	local s = Kit.new("ScrollingFrame", base)
	local l = layout or Kit.list(Enum.FillDirection.Vertical, 8)
	l.Parent = s
	Kit.padding(6).Parent = s
	return s
end

function Kit.bar(value, color, props)
	local base = { BackgroundColor3 = T.paperDark, Size = UDim2.new(1, 0, 0, 10) }
	for k, v in pairs(props or {}) do
		base[k] = v
	end
	local bg = Kit.new("Frame", base, { Kit.corner(5) })
	local fill = Kit.new("Frame", { BackgroundColor3 = color or T.green, Size = UDim2.fromScale(math.clamp(value or 0, 0, 1), 1), Name = "Fill" }, { Kit.corner(5) })
	fill.Parent = bg
	return bg, fill
end

function Kit.clear(container)
	for _, c in ipairs(container:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
end

-- every window and the size it asked for (phones get almost the whole screen)
local windows = {}

local function fitWindow(frame)
	local size = windows[frame]
	if not size then
		return
	end
	if Kit.profile == "phone" then
		frame.Size = UDim2.new(1, -16, 1, -12)
		frame.Position = UDim2.fromScale(0.5, 0.5)
	else
		frame.Size = size
		frame.Position = UDim2.fromScale(0.5, 0.52)
	end
end

function Kit.fitWindows()
	for frame in pairs(windows) do
		if frame.Parent then
			fitWindow(frame)
		else
			windows[frame] = nil
		end
	end
end

-- Standard modal window. Returns { frame, content, title }
function Kit.window(parent, size, titleText, onClose)
	-- windows draw above the HUD (ZIndex order of the screen's children: HUD 1, guide 5,
	-- tutorial 7, phone 9, windows 10, messages 20)
	local frame = Kit.panel({
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = size or UDim2.fromScale(0.62, 0.72),
		Visible = false,
		ZIndex = 10,
		Parent = parent,
	})
	windows[frame] = size or UDim2.fromScale(0.62, 0.72)
	fitWindow(frame)
	Kit.new("UISizeConstraint", { MaxSize = Vector2.new(1040, 760), MinSize = Vector2.new(320, 260), Parent = frame })
	Kit.goldLine(frame, 5)
	local header = Kit.new("Frame", { BackgroundColor3 = T.wood, Size = UDim2.new(1, 0, 0, 48), Parent = frame }, { Kit.corner(10), Kit.sheen(0.7) })
	-- lacquer red and gold trim under the header, and a little red seal before the title
	Kit.new("Frame", { BackgroundColor3 = T.red, BorderSizePixel = 0, Position = UDim2.new(0, 6, 0, 44), Size = UDim2.new(1, -12, 0, 4), Parent = header })
	Kit.new("Frame", { BackgroundColor3 = T.gold, BorderSizePixel = 0, Position = UDim2.new(0, 6, 0, 48), Size = UDim2.new(1, -12, 0, 2), Parent = header })
	local seal = Kit.new("Frame", { BackgroundColor3 = T.red, Size = UDim2.fromOffset(30, 30), Position = UDim2.fromOffset(12, 8), Rotation = -4, Parent = header }, { Kit.corner(6), Kit.stroke(T.gold, 1, 0.2) })
	Kit.new("TextLabel", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = "和", TextScaled = true, TextColor3 = T.paper, FontFace = T.title, AutoLocalize = false, Parent = seal })
	local title = Kit.title(titleText or "", { Parent = header, Size = UDim2.new(1, -150, 1, 0), Position = UDim2.fromOffset(52, 0), TextColor3 = T.paper, TextSize = 24, TextYAlignment = Enum.TextYAlignment.Center })
	title.TextStrokeTransparency = 0.7
	Kit.button("✕", { parent = header, size = UDim2.fromOffset(44, 40), position = UDim2.new(1, -50, 0, 4), style = "primary", textSize = 20, onClick = onClose })
	local content = Kit.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 56), Size = UDim2.new(1, -24, 1, -66), Parent = frame, Name = "Content" })
	return { frame = frame, content = content, title = title, header = header }
end

-- Red notification dot with a number in the top-right corner of `parent`; returns set(n)
function Kit.badge(parent, size)
	local d = size or 22
	local dot = Kit.new("Frame", {
		Name = "Badge", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -4, 0, 4), Size = UDim2.fromOffset(d, d),
		BackgroundColor3 = T.red, Visible = false, ZIndex = 5, Parent = parent,
	}, { Kit.corner(d / 2), Kit.stroke(T.white, 2, 0) })
	local label = Kit.label("", { Parent = dot, Size = UDim2.fromScale(1, 1), TextSize = math.floor(d * 0.62), FontFace = T.bold, TextColor3 = T.white, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 6 })
	local shown = 0
	return function(n)
		n = n or 0
		dot.Visible = n > 0
		label.Text = n > 9 and "9+" or tostring(n)
		if n > shown then
			Kit.bump(dot, 1.35)
		end
		shown = n
	end
end

-- Tabs row; returns the row frame, paint(id) and badges[id] = set(n).
-- tabs = { {id, label, width} }, onSelect(id)
function Kit.tabs(parent, tabs, onSelect, current, height)
	local h = height or 40
	local row = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, h), Parent = parent }, { Kit.list(Enum.FillDirection.Horizontal, 6) })
	local buttons, badges = {}, {}
	local function paint(sel)
		for id, b in pairs(buttons) do
			b.BackgroundColor3 = id == sel and T.red or T.paperDark
			b.TextColor3 = id == sel and T.white or T.ink
		end
	end
	for i, t in ipairs(tabs) do
		local b = Kit.button(t.label, { size = UDim2.fromOffset(t.width or 130, h - 4), style = "plain", order = i, textSize = t.textSize or 16 })
		b.Parent = row
		buttons[t.id] = b
		badges[t.id] = Kit.badge(b, 20)
		b.MouseButton1Click:Connect(function()
			paint(t.id)
			onSelect(t.id)
		end)
	end
	paint(current or (tabs[1] and tabs[1].id))
	return row, paint, badges
end

-- Row with an emoji icon, title, subtitle and a right side area. Returns card, right
function Kit.row(icon, titleText, subtitle, height)
	local card = Kit.card({ Size = UDim2.new(1, -8, 0, height or 72) })
	-- red accent along the left edge of every list row
	Kit.new("Frame", { BackgroundColor3 = T.red, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 10), Size = UDim2.new(0, 4, 1, -20), Parent = card }, { Kit.corner(2) })
	Kit.label(icon or "", { Parent = card, Size = UDim2.fromOffset(52, 52), Position = UDim2.fromOffset(10, ((height or 72) - 52) / 2), TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center })
	Kit.label(titleText or "", { Parent = card, Position = UDim2.fromOffset(70, 8), Size = UDim2.new(1, -250, 0, 24), FontFace = T.bold, TextSize = 19, TextTruncate = Enum.TextTruncate.AtEnd })
	Kit.label(subtitle or "", { Parent = card, Position = UDim2.fromOffset(70, 32), Size = UDim2.new(1, -250, 0, (height or 72) - 38), TextSize = 15, TextColor3 = T.muted, TextYAlignment = Enum.TextYAlignment.Top })
	local right = Kit.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(170, (height or 72) - 16), Parent = card }, { Kit.list(Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center) })
	return card, right
end

return Kit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000123"><Properties><string name="Name">Pointer</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Arrows that show where to go next, used by the tutorial and the one-time tips:
--   pointer:world(model)  a glowing beam from the player to the thing, with a bouncing ⬇️ above it
--   pointer:gui(button)   a bouncing 👇 and a pulsing ring on a button of the interface
--   pointer:hide()
-- Pointer.new(hexColour) makes one; each user keeps its own.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Color = require(Shared.Util.Color)
local Kit = require(script.Parent.Kit)
local Core = require(script.Parent.Parent.Core)

local Pointer = {}
Pointer.__index = Pointer
local player = Players.LocalPlayer

-- the button and all its parents are visible
local function shown(g)
	local n = g
	while n and not n:IsA("LayerCollector") do
		if n:IsA("GuiObject") and not n.Visible then
			return false
		end
		n = n.Parent
	end
	return n ~= nil and n.Enabled
end

function Pointer.new(hex)
	local self = setmetatable({ t0 = os.clock() }, Pointer)
	local color = Color.hex(hex or "#FFD23B")
	-- in the world: a beam from the player and a marker above the thing
	self.a0 = Instance.new("Attachment")
	self.a1 = Instance.new("Attachment")
	local holder = Instance.new("Part")
	holder.Name = "PointerTarget"
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.new(0.2, 0.2, 0.2)
	self.holder = holder
	self.a1.Parent = holder
	local beam = Instance.new("Beam")
	beam.Attachment0 = self.a0
	beam.Attachment1 = self.a1
	beam.Width0 = 0.6
	beam.Width1 = 0.6
	beam.FaceCamera = true
	beam.Color = ColorSequence.new(color)
	beam.LightEmission = 1
	beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	beam.TextureMode = Enum.TextureMode.Wrap
	beam.TextureSpeed = 2
	beam.Enabled = false
	beam.Parent = holder
	self.beam = beam
	local marker = Instance.new("BillboardGui")
	marker.Size = UDim2.fromOffset(64, 64)
	marker.StudsOffsetWorldSpace = Vector3.new(0, 4, 0)
	marker.AlwaysOnTop = true
	marker.Enabled = false
	marker.Adornee = holder
	marker.Parent = player:WaitForChild("PlayerGui")
	local arrow = Instance.new("TextLabel")
	arrow.Size = UDim2.fromScale(1, 1)
	arrow.BackgroundTransparency = 1
	arrow.Text = "⬇️"
	arrow.TextScaled = true
	arrow.AutoLocalize = false
	arrow.Parent = marker
	self.marker = marker
	-- on the screen: a ring and a hand on a button (drawn above windows)
	local root = Core.C.UI.root()
	self.ring = Kit.new("Frame", { Name = "PointerRing", BackgroundTransparency = 1, ZIndex = 30, Visible = false, Parent = root }, { Kit.corner(18), Kit.stroke(color, 4, 0) })
	self.hand = Kit.label("👇", { Name = "PointerHand", Size = UDim2.fromOffset(46, 46), TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 31, Visible = false, Parent = root })
	RunService.RenderStepped:Connect(function()
		self:step()
	end)
	return self
end

function Pointer:world(model)
	self.target = model
	self.guiTarget = nil
end

function Pointer:gui(button)
	self.guiTarget = button
	self.target = nil
end

function Pointer:hide()
	self.target = nil
	self.guiTarget = nil
end

function Pointer:step()
	local bob = math.sin((os.clock() - self.t0) * 5)
	local target = self.target
	if target and target.Parent and target:IsDescendantOf(workspace) then
		local rootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if rootPart and self.a0.Parent ~= rootPart then
			self.a0.Parent = rootPart
		end
		if self.holder.Parent ~= workspace.CurrentCamera then
			self.holder.Parent = workspace.CurrentCamera
		end
		self.holder.Position = target:GetPivot().Position + Vector3.new(0, 2, 0)
		self.marker.StudsOffsetWorldSpace = Vector3.new(0, 4 + bob * 0.6, 0)
		self.beam.Enabled = rootPart ~= nil
		self.marker.Enabled = true
	else
		self.beam.Enabled = false
		self.marker.Enabled = false
	end
	local g = self.guiTarget
	local UI = Core.C.UI
	if g and g.Parent and shown(g) and UI.gui then
		local scale = math.max(UI.scale or 1, 0.01)
		local pos = (g.AbsolutePosition - UI.gui.AbsolutePosition) / scale
		local size = g.AbsoluteSize / scale
		self.ring.Position = UDim2.fromOffset(pos.X - 6, pos.Y - 6)
		self.ring.Size = UDim2.fromOffset(size.X + 12, size.Y + 12)
		local stroke = self.ring:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Transparency = 0.15 + 0.35 * (bob + 1) / 2
		end
		-- the hand points down from above, or up from below for buttons near the top
		local below = pos.Y < 60
		self.hand.Text = below and "👆" or "👇"
		local y = below and (pos.Y + size.Y + 6 + bob * 6) or (pos.Y - 52 + bob * 6)
		self.hand.Position = UDim2.fromOffset(pos.X + size.X / 2 - 23, y)
		self.ring.Visible = true
		self.hand.Visible = true
	else
		self.ring.Visible = false
		self.hand.Visible = false
	end
end

return Pointer
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX000140"><Properties><string name="Name">Screens</string></Properties><Item class="ModuleScript" referent="RBX000124"><Properties><string name="Name">Build</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Build panel: catalog by category, inventory, floor/wall styles, grid & rotation tools,
-- selection actions (move / rotate / store / sell).
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Format = require(Shared.Util.Format)
local Items = require(Shared.Config.Items)
local Surfaces = require(Shared.Config.Surfaces)
local Events = require(Shared.Config.Events)
local GameConfig = require(Shared.Config.GameConfig)
local Footprint = require(Shared.Logic.Footprint)
local Kit = require(script.Parent.Parent.Kit)
local Icons = require(script.Parent.Parent.Icons)
local Core = require(script.Parent.Parent.Parent.Core)

local Screen = { modal = false }
local T = Kit.Theme
local t = Locale.t
local refs = {}
local category = "seating"

local function visibleItem(w, item)
	if item.event then
		local ev = Events.active(workspace:GetServerTimeNow())
		return ev and ev.id == item.event
	end
	if item.franchise then
		return w.franchise and w.franchise.cities and w.franchise.cities[item.franchise]
	end
	return true
end

local function itemLocked(w, item)
	if (w.level or 1) < (item.lv or 1) then
		return true, t("ui.req_level", { level = item.lv })
	end
	if item.license and not (w.licenses and w.licenses[item.license]) then
		return true, "🔒 " .. t("lic." .. item.license)
	end
	return false
end

local function zoneHere()
	local char = Players.LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return nil
	end
	local geo = Core.C.Build.geometry()
	local f = math.floor((hrp.Position.Y + 2) / GameConfig.FloorHeight)
	for _, z in ipairs(geo.zones) do
		if z.floor == f and not z.outdoor and Footprint.pointInRect(hrp.Position.X, hrp.Position.Z, z.rect) then
			return z
		end
	end
	return nil
end

-- Compact layout: a short catalog drawer at the bottom while browsing; while an object is being
-- placed or is selected the drawer hides and a small action bar takes its place.
function Screen.create(root)
	local frame = Kit.panel({ Name = "BuildPanel", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), Size = UDim2.new(0.94, 0, 0, 178), Visible = false, Parent = root })
	refs.frame = frame
	refs.tabs = Kit.new("ScrollingFrame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(8, 6), Size = UDim2.new(1, -16, 0, 36), ScrollingDirection = Enum.ScrollingDirection.X, AutomaticCanvasSize = Enum.AutomaticSize.X, CanvasSize = UDim2.new(), ScrollBarThickness = 3, Parent = frame }, { Kit.list(Enum.FillDirection.Horizontal, 4) })
	refs.items = Kit.new("ScrollingFrame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(8, 46), Size = UDim2.new(1, -16, 1, -52), ScrollingDirection = Enum.ScrollingDirection.X, AutomaticCanvasSize = Enum.AutomaticSize.X, CanvasSize = UDim2.new(), ScrollBarThickness = 5, Parent = frame }, { Kit.list(Enum.FillDirection.Horizontal, 6) })
	-- floating toolbar (right): grid, top view, exit
	local tools = Kit.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -10, 1, -196), Size = UDim2.fromOffset(150, 132), Visible = false, Parent = root }, { Kit.list(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Right) })
	refs.tools = tools
	refs.gridButton = Kit.button("", { parent = tools, size = UDim2.fromOffset(150, 38), style = "plain", order = 1, textSize = 14, radius = 19, onClick = function()
		Core.C.Build.cycleGrid()
	end })
	refs.topView = Kit.button("", { parent = tools, size = UDim2.fromOffset(150, 38), style = "plain", order = 2, textSize = 14, radius = 19, onClick = function()
		Core.C.Camera.toggleTop()
		Screen.refreshTools()
	end })
	refs.exit = Kit.button("", { parent = tools, size = UDim2.fromOffset(150, 38), style = "primary", order = 3, textSize = 14, radius = 19, onClick = function()
		Core.C.Build.exit()
	end })
	-- action bar (bottom-centre) used while placing or with a selected object
	local bar = Kit.panel({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), Size = UDim2.fromOffset(560, 92), Visible = false, Parent = root })
	refs.bar = bar
	refs.status = Kit.label("", { Parent = bar, Position = UDim2.fromOffset(14, 6), Size = UDim2.new(1, -28, 0, 22), TextSize = 16, FontFace = T.bold, TextTruncate = Enum.TextTruncate.AtEnd })
	refs.howto = Kit.label("", { Parent = bar, Position = UDim2.fromOffset(14, 28), Size = UDim2.new(1, -28, 0, 18), TextSize = 13, TextColor3 = T.muted, TextTruncate = Enum.TextTruncate.AtEnd })
	refs.actions = Kit.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 50), Size = UDim2.new(1, -20, 0, 36), Parent = bar }, { Kit.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center) })
	Core.C.Build.Changed:Connect(function()
		if refs.frame.Visible or refs.bar.Visible then
			Screen.refreshTools()
		end
	end)
end

local function itemCard(item, order, opts)
	local w = Core.C.Data.restaurant()
	local L = Locale.get()
	local locked, why = itemLocked(w, item)
	if opts.inventory then
		locked = false
	end
	local card = Kit.new("TextButton", { Text = "", Size = UDim2.fromOffset(104, 118), BackgroundColor3 = locked and T.paperDark or Color3.fromRGB(251, 245, 234), LayoutOrder = order, Parent = refs.items }, { Kit.corner(10), Kit.stroke(T.woodLight, 2) })
	Kit.label(Icons.forItem(item), { Parent = card, Size = UDim2.new(1, 0, 0, 36), Position = UDim2.fromOffset(0, 4), TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center })
	Kit.label(t("item." .. item.id), { Parent = card, Position = UDim2.fromOffset(4, 42), Size = UDim2.new(1, -8, 0, 30), TextSize = 12, FontFace = T.bold, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true })
	local price
	if opts.inventory then
		price = "×" .. opts.count
	elseif item.sakura then
		price = "🌸" .. item.sakura
	else
		price = Format.yen(item.price, L)
	end
	Kit.label(price, { Parent = card, Position = UDim2.fromOffset(4, 74), Size = UDim2.new(1, -8, 0, 18), TextSize = 14, FontFace = T.title, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = T.wood })
	local info = locked and why or ((item.amb or 0) > 0 and ("✨ " .. item.amb) or (item.fn and item.fn.comfort and ("🪑 " .. item.fn.comfort) or ""))
	Kit.label(info or "", { Parent = card, Position = UDim2.fromOffset(4, 94), Size = UDim2.new(1, -8, 0, 18), TextSize = 11, TextColor3 = T.muted, TextXAlignment = Enum.TextXAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd })
	card.MouseButton1Click:Connect(function()
		if locked then
			Core.C.UI.toast(why or "", "error")
			return
		end
		Core.C.Build.startPlace(item.id, opts.inventory == true)
	end)
	return card
end

local function renderItems()
	Kit.clear(refs.items)
	local w = Core.C.Data.restaurant()
	local L = Locale.get()
	if category == "inventory" then
		local inv = w.inventory or {}
		local order = 0
		for _, item in ipairs(Items.list) do
			local n = inv[item.id] or 0
			if n > 0 then
				order += 1
				itemCard(item, order, { inventory = true, count = n })
			end
		end
		if order == 0 then
			Kit.label(t("ui.inventory_empty"), { Parent = refs.items, Size = UDim2.fromOffset(400, 60), TextSize = 17 })
		end
	elseif category == "surfaces" then
		local zone = zoneHere()
		if not zone then
			Kit.label(t("ui.stand_in_zone"), { Parent = refs.items, Size = UDim2.fromOffset(420, 60), TextSize = 17 })
			return
		end
		Kit.label("📍 " .. t("ui.room", { name = "zone." .. zone.id }), { Parent = refs.items, Size = UDim2.fromOffset(120, 118), TextSize = 14, FontFace = T.bold, LayoutOrder = 0, TextWrapped = true })
		local current = (w.surfaces and w.surfaces[zone.id]) or {}
		for _, s in ipairs(Surfaces.list) do
			local active = current[s.kind] == s.id or (not current[s.kind] and (s.id == (s.kind == "floor" and (zone.floorStyle or Surfaces.DefaultFloor) or (zone.wallStyle or Surfaces.DefaultWall))))
			local locked = (w.level or 1) < s.lv
			local card = Kit.new("TextButton", { Text = "", Size = UDim2.fromOffset(104, 118), BackgroundColor3 = T.paper, LayoutOrder = s.order, Parent = refs.items }, { Kit.corner(10), Kit.stroke(active and T.gold or T.woodLight, active and 4 or 2) })
			local swatch = Kit.new("Frame", { BackgroundColor3 = require(Shared.Util.Color).hex(s.color), Size = UDim2.new(1, -16, 0, 34), Position = UDim2.fromOffset(8, 6), Parent = card }, { Kit.corner(8) })
			local _ = swatch
			Kit.label((s.kind == "floor" and "⬜ " or "🧱 ") .. t("surf." .. s.id), { Parent = card, Position = UDim2.fromOffset(4, 42), Size = UDim2.new(1, -8, 0, 30), TextSize = 12, FontFace = T.bold, TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = true })
			Kit.label(s.price > 0 and Format.yen(s.price, L) or t("ui.free"), { Parent = card, Position = UDim2.fromOffset(4, 74), Size = UDim2.new(1, -8, 0, 18), TextSize = 14, FontFace = T.title, TextXAlignment = Enum.TextXAlignment.Center })
			Kit.label(locked and t("ui.req_level", { level = s.lv }) or ("✨ " .. math.floor(s.amb)), { Parent = card, Position = UDim2.fromOffset(4, 94), Size = UDim2.new(1, -8, 0, 18), TextSize = 11, TextColor3 = T.muted, TextXAlignment = Enum.TextXAlignment.Center })
			card.MouseButton1Click:Connect(function()
				if not locked then
					NetDef.event("PaintSurface"):FireServer(zone.id, s.kind, s.id)
				end
			end)
		end
	else
		local order = 0
		for _, item in ipairs(Items.list) do
			if item.cat == category and visibleItem(w, item) then
				order += 1
				itemCard(item, item.order, {})
			end
		end
	end
end

local function renderTabs()
	Kit.clear(refs.tabs)
	local tabs = {}
	for _, c in ipairs(Items.Categories) do
		table.insert(tabs, { id = c, label = (Icons.cat[c] or "") .. " " .. t("cat." .. c) })
	end
	table.insert(tabs, { id = "surfaces", label = "🎨 " .. t("ui.surfaces") })
	table.insert(tabs, { id = "inventory", label = "🎒 " .. t("ui.inventory") })
	for i, tb in ipairs(tabs) do
		local b = Kit.button(tb.label, { parent = refs.tabs, size = UDim2.fromOffset(118, 32), style = tb.id == category and "primary" or "plain", order = i, textSize = 13, radius = 16, onClick = function()
			category = tb.id
			Screen.refresh()
		end })
		local _ = b
	end
end

local function selectedEntry()
	local Build = Core.C.Build
	for _, e in ipairs(Core.C.Data.w("placed") or {}) do
		if e.u == Build.selected then
			return e
		end
	end
	return nil
end

function Screen.refreshTools()
	local Build = Core.C.Build
	local L = Locale.get()
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	refs.gridButton.Text = "▦ " .. t("ui.grid") .. " " .. tostring(Build.grid)
	refs.topView.Text = Core.C.Camera.top and ("🎥 " .. t("ui.normal_view")) or ("🗺️ " .. t("ui.top_view"))
	refs.exit.Text = "✕ " .. t("ui.exit_build")
	local placing = Build.itemId ~= nil
	local entry = (not placing) and Build.selected and selectedEntry() or nil
	-- the catalog hides while something is being placed or is selected
	local active = refs.frame.Visible or refs.bar.Visible
	refs.frame.Visible = active and not placing and entry == nil
	refs.bar.Visible = active and (placing or entry ~= nil)
	refs.tools.Visible = active
	-- the catalog covers the bottom of the screen: no thumbstick over it (walking is back while
	-- an object is being placed)
	Core.C.UI.blockTouch("catalog", refs.frame.Visible)
	Kit.clear(refs.actions)
	if placing then
		local status = Build.valid and ("✅ " .. t("ui.can_place")) or ("❌ " .. t(Build.reason or "msg.place_invalid"))
		refs.status.Text = t("item." .. Build.itemId) .. "   " .. status
		refs.status.TextColor3 = Build.valid and T.green or T.red
		refs.howto.Text = touch and t("ui.place_howto_touch") or t("ui.place_howto_pc")
		Kit.button("🔄 " .. t("ui.rotate"), { parent = refs.actions, size = UDim2.fromOffset(130, 34), style = "dark", order = 1, textSize = 14, radius = 17, onClick = function()
			Build.rotate()
		end })
		Kit.button("✔ " .. t("ui.place"), { parent = refs.actions, size = UDim2.fromOffset(150, 34), style = Build.valid and "green" or "plain", order = 2, textSize = 15, radius = 17, onClick = function()
			Build.place()
		end })
		Kit.button("✕ " .. t("ui.cancel"), { parent = refs.actions, size = UDim2.fromOffset(130, 34), style = "plain", order = 3, textSize = 14, radius = 17, onClick = function()
			Build.cancel()
		end })
	elseif entry then
		local item = Items.byId[entry.i]
		refs.status.Text = t("item." .. entry.i)
		refs.status.TextColor3 = T.ink
		refs.howto.Text = t("ui.selected_howto")
		Kit.button("✋ " .. t("ui.move"), { parent = refs.actions, size = UDim2.fromOffset(110, 34), style = "dark", order = 1, textSize = 14, radius = 17, onClick = function()
			Build.startMove(Build.selected)
		end })
		Kit.button("🔄 " .. t("ui.rotate"), { parent = refs.actions, size = UDim2.fromOffset(100, 34), style = "dark", order = 2, textSize = 14, radius = 17, onClick = function()
			Build.rotate()
		end })
		Kit.button("🎒 " .. t("ui.store"), { parent = refs.actions, size = UDim2.fromOffset(110, 34), style = "plain", order = 3, textSize = 14, radius = 17, onClick = function()
			Build.removeSelected("store")
		end })
		local refund = item and math.floor((entry.paid or item.price) * GameConfig.SellRefund) or 0
		Kit.button("💴 " .. Format.yen(refund, L), { parent = refs.actions, size = UDim2.fromOffset(110, 34), style = "primary", order = 4, textSize = 14, radius = 17, onClick = function()
			Build.removeSelected("sell")
		end })
		Kit.button("✕", { parent = refs.actions, size = UDim2.fromOffset(44, 34), style = "plain", order = 5, textSize = 14, radius = 17, onClick = function()
			Build.select(nil)
		end })
	end
end

function Screen.refresh()
	if not refs.frame or not (refs.frame.Visible or refs.bar.Visible) then
		return
	end
	renderTabs()
	renderItems()
	Screen.refreshTools()
end

function Screen.visible()
	return refs.frame and (refs.frame.Visible or refs.bar.Visible)
end

function Screen.open()
	refs.frame.Visible = true
	refs.tools.Visible = true
	Screen.refresh()
	local hud = Core.C.UI.screens.HUD
	if hud and hud.setBuilding then
		hud.setBuilding(true)
	end
end

function Screen.close()
	refs.frame.Visible = false
	refs.bar.Visible = false
	refs.tools.Visible = false
	Core.C.UI.blockTouch("catalog", false)
	local hud = Core.C.UI.screens.HUD
	if hud and hud.setBuilding then
		hud.setBuilding(false)
	end
end

return Screen
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000125"><Properties><string name="Name">Codes</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Redeem a code (Config/Rewards.Codes): each code works once per player.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Kit = require(script.Parent.Parent.Kit)
local Base = require(script.Parent.Parent.Base)

local t = Locale.t
local T = Kit.Theme

return Base.make("Codes", "ui.codes", UDim2.fromScale(0.4, 0.42), function(content)
	Kit.label("🎟️", { Parent = content, Size = UDim2.new(1, 0, 0, 56), TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center })
	Kit.label(t("ui.codes_hint"), { Parent = content, Position = UDim2.fromOffset(0, 60), Size = UDim2.new(1, 0, 0, 44), TextSize = 16, TextColor3 = T.muted, TextXAlignment = Enum.TextXAlignment.Center })
	local box = Kit.new("TextBox", {
		Parent = content, Position = UDim2.fromOffset(0, 112), Size = UDim2.new(1, 0, 0, 46), Text = "", PlaceholderText = t("ui.codes_placeholder"),
		ClearTextOnFocus = false, TextSize = 22, FontFace = T.bold, TextColor3 = T.ink, BackgroundColor3 = T.white,
	}, { Kit.corner(10), Kit.stroke(T.wood, 2) })
	local function redeem()
		if box.Text ~= "" then
			NetDef.event("RedeemCode"):FireServer(box.Text)
			box.Text = ""
		end
	end
	box.FocusLost:Connect(function(enter)
		if enter then
			redeem()
		end
	end)
	Kit.button(t("ui.redeem"), { parent = content, size = UDim2.new(1, 0, 0, 46), position = UDim2.new(0, 0, 1, -48), style = "green", onClick = redeem })
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000126"><Properties><string name="Name">DayReport</string><ProtectedString name="Source"><![CDATA[--!nonstrict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Locale = require(Shared.Locale)
local Format = require(Shared.Util.Format)
local Kit = require(script.Parent.Parent.Kit)
local Base = require(script.Parent.Parent.Base)
local Core = require(script.Parent.Parent.Parent.Core)

local t = Locale.t
local T = Kit.Theme

local screen
screen = Base.make("DayReport", "ui.report", UDim2.fromScale(0.42, 0.74), function(content)
	local r = screen.arg or (Core.C.Data.day and Core.C.Data.day.report)
	if not r then
		return
	end
	local L = Locale.get()
	local list = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -60), Parent = content }, { Kit.list(Enum.FillDirection.Vertical, 4) })
	Kit.title(t("ui.day_n", { n = r.day }), { Parent = list, Size = UDim2.new(1, 0, 0, 34), LayoutOrder = 0 })
	local rows = {
		{ "💴", "ui.r_sales", Format.yen(r.sales, L), T.green },
		{ "💝", "ui.r_tips", Format.yen(r.tips, L), T.green },
		{ "📦", "ui.r_supplies", "-" .. Format.yen(r.supplies, L), T.red },
		{ "👥", "ui.r_salaries", "-" .. Format.yen(r.salaries, L), T.red },
		{ "🔨", "ui.r_build", "-" .. Format.yen(r.build + r.other, L), T.red },
		{ "📈", "ui.r_profit", Format.yen(r.profit, L), r.profit >= 0 and T.green or T.red },
		{ "🙂", "ui.r_customers", tostring(r.customers), T.ink },
		{ "🍜", "ui.r_served", tostring(r.served), T.ink },
		{ "😠", "ui.r_walkouts", tostring(r.walkouts), T.ink },
		{ "⭐", "ui.r_rating", Format.decimal(r.rating, 1, L), T.ink },
	}
	if r.best then
		table.insert(rows, { "🏆", "ui.r_best", t("rec." .. r.best) .. " ×" .. r.bestCount, T.ink })
	end
	for i, row in ipairs(rows) do
		local f = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = i, Parent = list })
		Kit.label(row[1] .. "  " .. t(row[2]), { Parent = f, Size = UDim2.new(0.6, 0, 1, 0), TextSize = 18 })
		Kit.label(row[3], { Parent = f, Position = UDim2.fromScale(0.6, 0), Size = UDim2.new(0.4, 0, 1, 0), TextSize = 18, FontFace = T.bold, TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = row[4] })
	end
	Kit.button("✓ " .. t("ui.ok"), { parent = content, size = UDim2.new(1, 0, 0, 50), position = UDim2.new(0, 0, 1, -52), style = "green", onClick = function()
		Core.C.UI.close("DayReport")
	end })
end)

return screen
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000127"><Properties><string name="Name">Dev</string><ProtectedString name="Source"><![CDATA[--!nonstrict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Kit = require(script.Parent.Parent.Kit)
local Base = require(script.Parent.Parent.Base)

local CMDS = {
	{ "💴 +10.000", "yen", 10000 }, { "💴 +1M", "yen", 1000000 }, { "🌸 +50", "sakura", 50 }, { "⬆️ +1 level", "level", nil },
	{ "Level 25", "level", 25 }, { "Level 45", "level", 45 }, { "🎫 All licenses", "licenses" }, { "🏗️ All zones", "zones" }, { "🪚 All renovations", "renos" }, { "🧱 Plain look", "plain" },
	{ "📦 Stock boxes", "stock" }, { "🧍 Spawn customer", "spawn" }, { "🕚 Close day", "time" }, { "⭐ 5-star reviews", "rating" },
	{ "🧪 Self-test", "selftest" },
	{ "♻️ Reset (Studio)", "reset" },
}

return Base.make("Dev", "ui.dev", UDim2.fromScale(0.5, 0.6), function(content)
	local grid = Kit.scroll({ Parent = content }, Kit.grid(200, 44, 8))
	for i, c in ipairs(CMDS) do
		Kit.button(c[1], { parent = grid, size = UDim2.fromOffset(200, 44), style = c[2] == "reset" and "primary" or "dark", order = i, textSize = 15, onClick = function()
			NetDef.event("Dev"):FireServer(c[2], c[3])
		end })
	end
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000128"><Properties><string name="Name">Gifts</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Free gifts for the minutes played in this session (Config/Rewards.Gifts). Timers tick every
-- second without rebuilding the list.
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Format = require(Shared.Util.Format)
local Rewards = require(Shared.Config.Rewards)
local Ingredients = require(Shared.Config.Ingredients)
local Kit = require(script.Parent.Parent.Kit)
local Base = require(script.Parent.Parent.Base)
local Core = require(script.Parent.Parent.Parent.Core)

local t = Locale.t
local T = Kit.Theme
local player = Players.LocalPlayer

local function claimedSet()
	local set = {}
	for _, s in ipairs(string.split(player:GetAttribute("GiftsClaimed") or "", ",")) do
		if s ~= "" then
			set[tonumber(s)] = true
		end
	end
	return set
end

local function elapsed()
	local joined = player:GetAttribute("JoinedAt")
	if not joined then
		return 0
	end
	return workspace:GetServerTimeNow() - joined
end

local function rewardText(g)
	local me = Core.C.Data.me or {}
	if g.yen then
		return Format.yen(math.floor(g.yen * (1 + (me.level or 1) * Rewards.GiftYenPerLevel) + 0.5), Locale.get())
	elseif g.sakura then
		return "🌸 " .. g.sakura
	elseif g.boxes then
		local parts = {}
		for id, n in pairs(g.boxes) do
			local ing = Ingredients.byId[id]
			table.insert(parts, n .. "× " .. (ing and ing.icon or "📦"))
		end
		table.sort(parts)
		return "📦 " .. table.concat(parts, " ")
	end
	return ""
end

-- index of the next gift not yet claimed and seconds until it is ready (0 = ready now)
local function nextGift()
	local set = claimedSet()
	local e = elapsed()
	for i, g in ipairs(Rewards.Gifts) do
		if not set[i] then
			return i, math.max(0, g.min * 60 - e)
		end
	end
	return nil, nil
end

local screen = Base.make("Gifts", "ui.gifts", UDim2.fromScale(0.5, 0.66), function(content, s)
	s.rows = {}
	Kit.label(t("ui.gifts_hint"), { Parent = content, Size = UDim2.new(1, 0, 0, 24), TextSize = 15, TextColor3 = T.muted })
	local grid = Kit.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 1, -30), Parent = content }, { Kit.grid(132, 132, 8) })
	local set = claimedSet()
	for i, g in ipairs(Rewards.Gifts) do
		local card = Kit.card({ LayoutOrder = i, Parent = grid })
		Kit.label("🎁", { Parent = card, Position = UDim2.fromOffset(0, 6), Size = UDim2.new(1, 0, 0, 36), TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center })
		Kit.label(rewardText(g), { Parent = card, Position = UDim2.fromOffset(4, 44), Size = UDim2.new(1, -8, 0, 22), TextSize = 15, FontFace = T.bold, TextXAlignment = Enum.TextXAlignment.Center })
		local btn = Kit.button("", { parent = card, size = UDim2.new(1, -16, 0, 34), position = UDim2.new(0, 8, 1, -42), style = "plain", textSize = 15, onClick = function()
			NetDef.event("ClaimGift"):FireServer(i)
		end })
		s.rows[i] = { button = btn, gift = g, claimed = set[i] }
	end
	s.tick()
end)

-- updates the countdowns and buttons in place
function screen.tick()
	if not screen.rows then
		return
	end
	local e = elapsed()
	for _, row in pairs(screen.rows) do
		local left = row.gift.min * 60 - e
		if row.claimed then
			row.button.Text = "✅ " .. t("ui.claimed")
			row.button.BackgroundColor3 = T.paperDark
		elseif left <= 0 then
			row.button.Text = t("ui.claim")
			row.button.BackgroundColor3 = T.green
			row.button.TextColor3 = T.white
		else
			row.button.Text = "⏳ " .. Format.duration(left)
			row.button.BackgroundColor3 = T.paperDark
		end
	end
end

screen.nextGift = nextGift

task.spawn(function()
	while true do
		task.wait(1)
		if screen.visible() then
			screen.tick()
		end
	end
end)

player:GetAttributeChangedSignal("GiftsClaimed"):Connect(function()
	if screen.visible() then
		screen.refresh()
	end
end)

return screen
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000129"><Properties><string name="Name">Goals</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Daily quests, achievements, login calendar, leaderboards and franchise.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Format = require(Shared.Util.Format)
local Quests = require(Shared.Config.Quests)
local Achievements = require(Shared.Config.Achievements)
local DailyRewards = require(Shared.Config.DailyRewards)
local Franchise = require(Shared.Config.Franchise)
local Kit = require(script.Parent.Parent.Kit)
local Base = require(script.Parent.Parent.Base)
local Core = require(script.Parent.Parent.Parent.Core)

local t = Locale.t
local T = Kit.Theme
local tab = "quests"
local board = nil
local boardTime = 0

local function statValue(me, stat)
	if stat == "staff" then
		return #(me.staff or {})
	elseif stat == "level" then
		return me.level or 1
	elseif stat == "licenses" then
		local n = 0
		for _ in pairs(me.licenses or {}) do
			n += 1
		end
		return n
	elseif stat == "zones" then
		local n = 0
		for id in pairs(me.zones or {}) do
			if string.sub(id, 1, 5) == "zone_" then
				n += 1
			end
		end
		return n
	elseif stat == "franchise" then
		return me.franchise and me.franchise.stars or 0
	end
	return me.stats and me.stats[stat] or 0
end

local screen
screen = Base.make("Goals", "ui.goals", UDim2.fromScale(0.68, 0.78), function(content)
	local me = Core.C.Data.me or {}
	local L = Locale.get()
	Kit.tabs(content, {
		{ id = "quests", label = t("ui.tab_quests"), width = 120 },
		{ id = "achievements", label = t("ui.tab_achievements"), width = 120 },
		{ id = "daily", label = t("ui.tab_daily"), width = 120 },
		{ id = "leaderboard", label = t("ui.tab_leaderboard"), width = 120 },
		{ id = "franchise", label = t("ui.tab_franchise"), width = 120 },
	}, function(id)
		tab = id
		screen.refresh()
	end, tab)
	local scroll = Kit.scroll({ Position = UDim2.fromOffset(0, 46), Size = UDim2.new(1, 0, 1, -46), Parent = content })
	if tab == "quests" then
		for i, q in ipairs(me.meta and me.meta.quests or {}) do
			local cfg = Quests.byId[q.id]
			local card, right = Kit.row("🎯", t("quest." .. q.id, { n = q.target }), q.progress .. " / " .. q.target, 76)
			card.Parent = scroll
			card.LayoutOrder = i
			local _, fill = Kit.bar(q.progress / q.target, T.green, { Parent = card, Position = UDim2.new(0, 70, 1, -16), Size = UDim2.new(1, -260, 0, 8) })
			local _ = fill
			if q.claimed then
				Kit.label("✅", { Parent = right, Size = UDim2.fromOffset(40, 30), TextScaled = true })
			else
				Kit.button(t("ui.claim"), { parent = right, size = UDim2.fromOffset(120, 36), style = "gold", disabled = q.progress < q.target, onClick = function()
					NetDef.event("ClaimQuest"):FireServer(q.id)
				end })
			end
			local _2 = cfg
		end
		Kit.label(t("ui.quests_reward", { yen = Quests.RewardYenPerLevel * (me.level or 1), sakura = Quests.RewardSakura, bonus = Quests.BonusSakura }), { Parent = scroll, Size = UDim2.new(1, 0, 0, 44), TextSize = 15, TextColor3 = T.muted, LayoutOrder = 10 })
	elseif tab == "achievements" then
		for _, a in ipairs(Achievements.list) do
			local state = me.meta and me.meta.achievements and me.meta.achievements[a.id]
			local value = statValue(me, a.stat)
			local card, right = Kit.row(state and "🏆" or "🔒", t("ach." .. a.stat, { n = a.target }), Format.number(math.min(value, a.target), L) .. " / " .. Format.number(a.target, L) .. "  ·  🌸" .. a.sakura, 64)
			card.Parent = scroll
			if state == "done" then
				Kit.button(t("ui.claim"), { parent = right, size = UDim2.fromOffset(120, 34), style = "gold", onClick = function()
					NetDef.event("ClaimAchievement"):FireServer(a.id)
				end })
			elseif state == "claimed" then
				Kit.label("✅", { Parent = right, Size = UDim2.fromOffset(34, 30), TextScaled = true })
			end
		end
	elseif tab == "daily" then
		local daily = me.meta and me.meta.daily or { streak = 0, last = 0 }
		local today = math.floor(workspace:GetServerTimeNow() / 86400)
		local claimedToday = daily.last == today
		local nextDay = claimedToday and daily.streak or ((daily.last == today - 1) and (daily.streak % 7 + 1) or 1)
		local row = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 130) }, { Kit.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center) })
		row.Parent = scroll
		for i, r in ipairs(DailyRewards.days) do
			local c = Kit.card({ Size = UDim2.fromOffset(92, 120), LayoutOrder = i, Parent = row })
			if i == nextDay then
				c:FindFirstChildOfClass("UIStroke").Color = T.gold
				c:FindFirstChildOfClass("UIStroke").Thickness = 3
			end
			Kit.label(t("ui.day_n", { n = i }), { Parent = c, Size = UDim2.new(1, 0, 0, 22), TextXAlignment = Enum.TextXAlignment.Center, FontFace = T.bold, TextSize = 15 })
			local reward = r.yen and Format.yen(math.floor(r.yen * (1 + (me.level or 1) / 10)), L) or ("🌸" .. r.sakura)
			Kit.label(r.yen and "💴" or "🌸", { Parent = c, Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 0, 44), TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center })
			Kit.label(reward .. (r.item and " +🎁" or ""), { Parent = c, Position = UDim2.fromOffset(2, 74), Size = UDim2.new(1, -4, 0, 40), TextSize = 14, TextXAlignment = Enum.TextXAlignment.Center })
		end
		Kit.button(claimedToday and t("ui.daily_tomorrow") or t("ui.claim"), { parent = scroll, size = UDim2.new(1, -8, 0, 46), style = "green", disabled = claimedToday, onClick = function()
			NetDef.event("ClaimDaily"):FireServer()
		end })
	elseif tab == "leaderboard" then
		if not board or os.clock() - boardTime > 60 then
			boardTime = os.clock()
			task.spawn(function()
				local ok, result = pcall(function()
					return NetDef.func("GetLeaderboard"):InvokeServer()
				end)
				if ok and result then
					board = result
					if screen.visible() and tab == "leaderboard" then
						screen.refresh()
					end
				end
			end)
		end
		for _, stat in ipairs({ "likes", "dishes", "earned" }) do
			Kit.title(t("lb." .. stat), { Parent = scroll, Size = UDim2.new(1, 0, 0, 30) })
			for _, entry in ipairs(board and board[stat] or {}) do
				local row = Kit.card({ Size = UDim2.new(1, -8, 0, 34), Parent = scroll })
				Kit.label("#" .. entry.rank .. "  " .. entry.name, { Parent = row, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(0.6, 0, 1, 0), FontFace = T.bold })
				Kit.label(stat == "earned" and Format.yen(entry.value, L) or Format.number(entry.value, L), { Parent = row, Position = UDim2.fromScale(0.6, 0), Size = UDim2.new(0.38, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Right })
			end
		end
	elseif tab == "franchise" then
		local w = Core.C.Data.restaurant()
		local stars = w.franchise and w.franchise.stars or 0
		local nextCity = nil
		for _, c in ipairs(Franchise.list) do
			if c.star == stars + 1 then
				nextCity = c
			end
		end
		Kit.label(t("ui.franchise_info", { stars = stars, yen = math.floor(stars * Franchise.YenPerStar * 100), xp = math.floor(stars * Franchise.XpPerStar * 100) }), { Parent = scroll, Size = UDim2.new(1, 0, 0, 50), TextSize = 17, LayoutOrder = 1 })
		-- first what the next city asks for, ticked off one by one, and the button
		local step = Franchise.nextStep(stars)
		if nextCity and step then
			local rating = Core.C.Data.plotAttr("Rating") or 3
			local level = w.level or 1
			local all = true
			local order = 10
			local function need(ok, text)
				all = all and ok
				order += 1
				Kit.label((ok and "✅ " or "🔒 ") .. text, { Parent = scroll, Size = UDim2.new(1, -8, 0, 26), TextSize = 16, FontFace = ok and T.body or T.bold, TextColor3 = ok and T.muted or T.ink, LayoutOrder = order })
			end
			Kit.title(t("ui.franchise_next", { city = "city." .. nextCity.id }), { Parent = scroll, Size = UDim2.new(1, -8, 0, 30), TextSize = 20, LayoutOrder = 10 })
			need(level >= step.level, t("ui.req_level", { level = step.level }) .. "  (" .. level .. ")")
			need(rating >= step.rating, "★ " .. Format.decimal(step.rating, 1, L) .. "  (" .. Format.decimal(rating, 1, L) .. ")")
			for _, z in ipairs(step.zones) do
				need(w.zones and w.zones[z] == true, t("zone." .. z))
			end
			local b = Kit.button("🗾 " .. t("ui.franchise_open", { city = "city." .. nextCity.id }), { parent = scroll, size = UDim2.new(1, -8, 0, 50), style = all and "primary" or "plain", disabled = Core.C.Data.role() ~= "owner" or not all, onClick = function()
				NetDef.event("Franchise"):FireServer(nextCity.id)
			end })
			b.LayoutOrder = 50
		end
		-- then the cities
		for i, c in ipairs(Franchise.list) do
			local mark = (w.franchise and w.franchise.city == c.id) and "📍" or ((c.star <= stars) and "✅" or "🔒")
			local card = Kit.row(mark, t("city." .. c.id), t("citydesc." .. c.id), 60)
			card.LayoutOrder = 100 + i
			card.Parent = scroll
		end
	end
end)

return screen
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000130"><Properties><string name="Name">Guide</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Order guide: tapping an order ticket (right) shows what to do, in a few short lines with live
-- ticks, highlights the shelf slots and the station to use and draws a glowing arrow from you to
-- the next thing to click. The card stands on the left, under the wallet; on phones the second
-- line of each step is left out.
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Locale = require(Shared.Locale)
local Recipes = require(Shared.Config.Recipes)
local Ingredients = require(Shared.Config.Ingredients)
local Items = require(Shared.Config.Items)
local Color = require(Shared.Util.Color)
local Kit = require(script.Parent.Parent.Kit)
local Core = require(script.Parent.Parent.Parent.Core)

local Guide = { modal = false, recipe = nil, ticket = nil }
local T = Kit.Theme
local t = Locale.t
local player = Players.LocalPlayer

local frame, title, list
local marks = {}
local beam, a0, a1, holder, marker
local lastBuild = 0

local STATION_ICON = { sushi = "🍣", ramen = "🍜", drink = "🍵", griddle = "🥟", fryer = "🍤", takoyaki = "🐙", dessert = "🍡" }

local function hands()
	local kind = player:GetAttribute("HandsKind") or ""
	local ok, list = pcall(HttpService.JSONDecode, HttpService, player:GetAttribute("Hands") or "[]")
	return kind, ok and list or {}
end

local function interactables(kind)
	local out = {}
	for _, m in ipairs(CollectionService:GetTagged("Interactable")) do
		if m:GetAttribute("Kind") == kind and m:IsDescendantOf(workspace) and Core.C.Data.isMine(m) then
			table.insert(out, m)
		end
	end
	return out
end

local function stationType(m)
	local item = Items.byId[m.Name]
	return item and item.fn and item.fn.station
end

local function distance(m)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return 0
	end
	return (m:GetPivot().Position - root.Position).Magnitude
end

local function nearest(models, filter)
	local best, bestD = nil, math.huge
	for _, m in ipairs(models) do
		if not filter or filter(m) then
			local d = distance(m)
			if d < bestD then
				best, bestD = m, d
			end
		end
	end
	return best
end

local function clearMarks()
	for _, m in ipairs(marks) do
		m:Destroy()
	end
	marks = {}
end

local function mark(adornee, color)
	local box = Instance.new("SelectionBox")
	box.Adornee = adornee
	box.Color3 = color
	box.LineThickness = 0.09
	box.SurfaceColor3 = color
	box.SurfaceTransparency = 0.8
	box.Parent = player.PlayerGui
	table.insert(marks, box)
end

local function pointAt(target)
	if target then
		holder.Position = target:GetPivot().Position + Vector3.new(0, 2.5, 0)
		marker.Adornee = holder
		beam.Enabled = true
		marker.Enabled = true
	else
		beam.Enabled = false
		marker.Enabled = false
	end
end

-- One line of the guide: state = "done" | "now" | "todo"
local function line(order, state, text, sub)
	if Kit.profile == "phone" and state ~= "now" then
		sub = nil
	end
	local icon = state == "done" and "✅" or (state == "now" and "👉" or "▫️")
	local row = Kit.new("Frame", { BackgroundColor3 = state == "now" and Color.hex("#FFF4D6") or T.paper, BackgroundTransparency = state == "now" and 0 or 1, Size = UDim2.new(1, 0, 0, sub and 46 or 28), LayoutOrder = order, Parent = list }, { Kit.corner(8) })
	Kit.label(icon, { Parent = row, Position = UDim2.fromOffset(4, 3), Size = UDim2.fromOffset(22, 22), TextScaled = true })
	Kit.label(text, { Parent = row, Position = UDim2.fromOffset(30, 3), Size = UDim2.new(1, -34, 0, 22), TextSize = 15, FontFace = state == "now" and T.bold or T.body, TextColor3 = state == "done" and T.muted or T.ink, TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false })
	if sub then
		Kit.label(sub, { Parent = row, Position = UDim2.fromOffset(30, 24), Size = UDim2.new(1, -34, 0, 18), TextSize = 13, TextColor3 = T.muted, TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false })
	end
end

-- Builds the steps for the current recipe from what is happening in the world
local function update()
	local r = Recipes.byId[Guide.recipe or ""]
	if not r or not frame.Visible then
		return
	end
	Kit.clear(list)
	clearMarks()
	local kind, held = hands()
	local stations = interactables("station")
	local myStations = {}
	for _, m in ipairs(stations) do
		if stationType(m) == r.station then
			table.insert(myStations, m)
		end
	end
	local readyStation = nearest(myStations, function(m)
		return m:GetAttribute("Ready") == r.id
	end)
	local workStation = nearest(myStations, function(m)
		return m:GetAttribute("Recipe") == r.id and (m:GetAttribute("Ready") or "") == ""
	end)
	local holdingDish = kind == "dish" and table.find(held, r.id) ~= nil
	local target = nil
	local order = 0
	local function add(state, text, sub)
		order += 1
		line(order, state, text, sub)
	end

	-- 1. rice / broth ready in the appliances
	local baseOk = true
	if r.rice then
		local cooker = nearest(interactables("ricecooker"), function(m)
			return (m:GetAttribute("N") or 0) > 0
		end)
		baseOk = cooker ~= nil
		add(baseOk and "done" or "now", "🍚 " .. t("guide.rice"), not baseOk and t("guide.rice_how") or nil)
		if not baseOk then
			target = nearest(interactables("ricecooker"))
		end
	end
	if r.broth then
		local pot = nearest(interactables("pot"), function(m)
			return m:GetAttribute("G") == r.broth and (m:GetAttribute("N") or 0) > 0
		end)
		local ok = pot ~= nil
		add(ok and "done" or (baseOk and "now" or "todo"), "🥣 " .. t("guide.broth", { name = "ing." .. r.broth }), not ok and t("guide.broth_how") or nil)
		if not ok and not target then
			target = nearest(interactables("pot"))
		end
		baseOk = baseOk and ok
	end

	-- 2. ingredients on the shelves (the station takes them by itself)
	local need = {}
	for _, g in ipairs(r.ing) do
		need[g] = (need[g] or 0) + 1
	end
	local stock = {}
	for _, shelf in ipairs(interactables("shelf")) do
		for _, part in ipairs(shelf:GetChildren()) do
			local g = part:IsA("BasePart") and part:GetAttribute("Slot") and part:GetAttribute("G") or ""
			if g ~= "" then
				stock[g] = (stock[g] or 0) + (part:GetAttribute("N") or 0)
			end
		end
	end
	local workStation0 = workStation or readyStation
	local onBoard = workStation0 ~= nil or holdingDish
	local chips, missing = {}, nil
	for _, g in ipairs(r.ing) do
		local ing = Ingredients.byId[g]
		local got = onBoard or (stock[g] or 0) >= need[g]
		table.insert(chips, (got and "✓" or "✗") .. (ing and ing.icon or "") .. " " .. t("ing." .. g))
		if not got and not missing then
			missing = g
		end
	end
	add(missing == nil and "done" or "now", "🧺 " .. t("guide.on_shelves"), table.concat(chips, "   "))
	if missing and not target then
		-- a box of what is missing, else the supplier
		target = nearest(interactables("box"), function(m)
			return m:GetAttribute("Ingredient") == missing
		end)
		add("now", "📦 " .. t("guide.no_stock", { name = "ing." .. missing }), t("guide.no_stock_how"))
	end

	-- 3. the station: one press per step (the first press brings the ingredients)
	local stName = (STATION_ICON[r.station] or "🔪") .. " " .. t("station." .. r.station)
	local steps = {}
	for _, s in ipairs(r.steps) do
		table.insert(steps, t("step." .. s))
	end
	local stepDone = workStation and (workStation:GetAttribute("Step") or 0) or 0
	if readyStation or holdingDish then
		add("done", t("guide.press_steps", { station = stName, n = #r.steps }), table.concat(steps, " → "))
	elseif workStation then
		add("now", t("guide.press_steps", { station = stName, n = #r.steps }) .. "  (" .. stepDone .. "/" .. #r.steps .. ")", table.concat(steps, " → "))
		target = target or workStation
		mark(workStation.PrimaryPart or workStation, Color.hex("#6DDC5A"))
	else
		local free = nearest(myStations, function(m)
			return (m:GetAttribute("Board") or "") == "" and (m:GetAttribute("Ready") or "") == ""
		end) or nearest(myStations)
		local state = (missing == nil and not target) and "now" or "todo"
		add(state, t("guide.press_steps", { station = stName, n = #r.steps }), #myStations == 0 and t("guide.no_station") or table.concat(steps, " → "))
		if free then
			mark(free.PrimaryPart or free, Color.hex("#6DDC5A"))
			if state == "now" then
				target = free
			end
		end
	end

	-- 4. take the dish and serve the customer
	if holdingDish then
		add("done", t("guide.pick"))
		local customer = nearest(interactables("customer"), function(m)
			return m:GetAttribute("Order") == r.id and (m:GetAttribute("State") == "waiting" or m:GetAttribute("State") == "order")
		end)
		add("now", t("guide.serve"))
		target = customer
	elseif readyStation then
		add("now", t("guide.pick"))
		add("todo", t("guide.serve"))
		target = readyStation
	else
		add("todo", t("guide.pick"))
		add("todo", t("guide.serve"))
	end
	pointAt(target)
	local h = 50
	for _, c in ipairs(list:GetChildren()) do
		if c:IsA("Frame") then
			h += c.Size.Y.Offset + 3
		end
	end
	frame.Size = UDim2.fromOffset(Kit.profile == "phone" and 290 or 320, h + 8)
end

function Guide.create(root)
	frame = Kit.panel({ Name = "Guide", Position = UDim2.fromOffset(10, 124), Size = UDim2.fromOffset(320, 300), Visible = false, ZIndex = 5, Parent = root })
	title = Kit.title("", { Parent = frame, Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -54, 0, 30), TextSize = 18, TextTruncate = Enum.TextTruncate.AtEnd })
	Kit.button("✕", { parent = frame, size = UDim2.fromOffset(32, 32), position = UDim2.new(1, -40, 0, 6), style = "plain", textSize = 14, radius = 16, onClick = function()
		Guide.hide()
	end })
	list = Kit.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 42), Size = UDim2.new(1, -20, 1, -48), Parent = frame }, { Kit.list(Enum.FillDirection.Vertical, 3) })
	-- glowing arrow from the player to the next thing to click
	a0 = Instance.new("Attachment")
	a1 = Instance.new("Attachment")
	beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Width0 = 0.5
	beam.Width1 = 0.5
	beam.FaceCamera = true
	beam.Color = ColorSequence.new(Color.hex("#6DDC5A"))
	beam.LightEmission = 1
	beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	beam.TextureMode = Enum.TextureMode.Wrap
	beam.TextureSpeed = 2
	beam.Enabled = false
	holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.new(0.2, 0.2, 0.2)
	a1.Parent = holder
	beam.Parent = holder
	marker = Instance.new("BillboardGui")
	marker.Size = UDim2.fromOffset(56, 56)
	marker.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
	marker.AlwaysOnTop = true
	marker.Enabled = false
	marker.Parent = player:WaitForChild("PlayerGui")
	local arrow = Instance.new("TextLabel")
	arrow.Size = UDim2.fromScale(1, 1)
	arrow.BackgroundTransparency = 1
	arrow.Text = "⬇️"
	arrow.TextScaled = true
	arrow.AutoLocalize = false
	arrow.Parent = marker
	RunService.Heartbeat:Connect(function()
		if not frame.Visible then
			return
		end
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and a0.Parent ~= root then
			a0.Parent = root
		end
		if holder.Parent ~= workspace.CurrentCamera then
			holder.Parent = workspace.CurrentCamera
		end
		if os.clock() - lastBuild > 0.3 then
			lastBuild = os.clock()
			local ok, err = pcall(update)
			if not ok then
				warn("[Guide] " .. tostring(err))
			end
		end
		-- the order is gone (served or the customer left)
		local still = false
		for _, tk in ipairs(Core.C.Data.tickets or {}) do
			if tk.recipe == Guide.recipe then
				still = true
			end
		end
		local kind, held = hands()
		if not still and not (kind == "dish" and table.find(held, Guide.recipe)) then
			Guide.hide()
		end
	end)
end

-- Shows the guide for a recipe; tapping the same order again hides it
function Guide.show(recipeId)
	if Guide.recipe == recipeId and frame.Visible then
		Guide.hide()
		return
	end
	Guide.recipe = recipeId
	local r = Recipes.byId[recipeId]
	title.Text = (r and r.icon or "🍽️") .. " " .. t("rec." .. recipeId)
	frame.Visible = true
	lastBuild = 0
	update()
end

function Guide.hide()
	Guide.recipe = nil
	frame.Visible = false
	clearMarks()
	beam.Enabled = false
	marker.Enabled = false
	local hud = Core.C.UI.screens.HUD
	if hud and hud.refreshTickets then
		hud.refreshTickets()
	end
end

function Guide.visible()
	return frame ~= nil and frame.Visible
end

function Guide.refresh()
	if frame and frame.Visible then
		update()
	end
end

function Guide.open(recipeId)
	if recipeId then
		Guide.show(recipeId)
	end
end

function Guide.close()
	Guide.hide()
end

return Guide
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000131"><Properties><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Always-visible HUD, as little as possible:
--   top-left    wallet: yen, sakura, level badge and XP bar; under it the free gift timer
--   top-centre  clock and day (tap: last day's summary), today's objective under it
--   top-right   the restaurant you stand in (rating and likes; someone else's: like / go home),
--               a dishes chip when there is washing to do, then the orders (oldest first)
--   bottom      what you hold, and four big buttons: shop, build, supplier, more (the phone)
-- On phones the buttons sit in the middle of the bottom edge, clear of the thumbstick (bottom-
-- left) and of the jump button (bottom-right); fewer orders are listed.
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Format = require(Shared.Util.Format)
local Formulas = require(Shared.Logic.Formulas)
local ShopLogic = require(Shared.Logic.Shop)
local Recipes = require(Shared.Config.Recipes)
local Ingredients = require(Shared.Config.Ingredients)
local Upgrades = require(Shared.Config.Upgrades)
local Licenses = require(Shared.Config.Licenses)
local Expansions = require(Shared.Config.Expansions)
local StaffCfg = require(Shared.Config.Staff)
local Ads = require(Shared.Config.Ads)
local GameConfig = require(Shared.Config.GameConfig)
local Kit = require(script.Parent.Parent.Kit)
local Core = require(script.Parent.Parent.Parent.Core)

local HUD = { modal = false }
local T = Kit.Theme
local t = Locale.t
local refs = {}
local player = Players.LocalPlayer
local SHOP_CFG = { Upgrades = Upgrades, Ads = Ads, Licenses = Licenses, Expansions = Expansions, Staff = StaffCfg, MaxStaff = GameConfig.MaxStaff }

-- the four big buttons (keyboard shortcuts in Controllers/FirstPerson)
local BUTTONS = {
	{ id = "Shop", icon = "🛒", key = "ui.shop", build = true, hotkey = "U" },
	{ id = "Build", icon = "🔨", key = "ui.build", build = true, hotkey = "B" },
	{ id = "Supplier", icon = "📦", key = "ui.supplier", build = true, hotkey = "O" },
	{ id = "Phone", icon = "📱", key = "ui.more", hotkey = "P" },
}

-- sizes per kind of screen (units, see Controllers/UI)
-- (dockX: centre of the dock as a fraction of the width; on touch screens it sits right of the
-- middle, past the thumbstick area, which covers the left 40% of the screen)
local LAYOUT = {
	phone = { dockW = 82, dockH = 62, dockX = 0.57, tickets = 3, ticketW = 214, ticketH = 58 },
	tablet = { dockW = 86, dockH = 70, dockX = 0.56, tickets = 4, ticketW = 236, ticketH = 62 },
	desktop = { dockW = 86, dockH = 70, dockX = 0.5, tickets = 5, ticketW = 236, ticketH = 62 },
}

local function L()
	return LAYOUT[Kit.profile] or LAYOUT.desktop
end

local function lang()
	return Locale.get()
end

local function keyboard()
	return UserInputService.KeyboardEnabled
end

local function open(id)
	if id == "Build" then
		Core.C.Build.toggle()
		return
	end
	Core.C.UI.toggle(id)
end

-- small rounded pill (a frame, or a button when onClick is given)
local function pill(props, onClick)
	local f = Kit.new(onClick and "TextButton" or "Frame", props, { Kit.corner(18), Kit.stroke(T.wood, 2, 0.2), Kit.sheen(0.92) })
	f.BackgroundColor3 = props.BackgroundColor3 or T.paper
	if onClick then
		f.Text = ""
		f.AutoButtonColor = true
		Kit.press(f)
		f.MouseButton1Click:Connect(function()
			if Core.C.Audio then
				Core.C.Audio.play("ui")
			end
			onClick()
		end)
	end
	return f
end

local function pillLabel(parent, size, props)
	local base = { Parent = parent, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -24, 1, 0), TextSize = size or 16, FontFace = T.bold, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false }
	for k, v in pairs(props or {}) do
		base[k] = v
	end
	return Kit.label("", base)
end

function HUD.create(root)
	local top = Kit.new("Frame", { Name = "HUD", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = root })
	HUD.frame = top

	-- wallet: yen and sakura on top, level badge and XP bar under them
	local wallet = pill({ Name = "Wallet", Size = UDim2.fromOffset(258, 66), Position = UDim2.fromOffset(10, 8), Parent = top })
	refs.wallet = wallet
	refs.yen = Kit.label("¥0", { Parent = wallet, Position = UDim2.fromOffset(14, 4), Size = UDim2.new(1, -110, 0, 32), TextSize = 27, FontFace = T.title, TextColor3 = T.wood, TextWrapped = false, TextYAlignment = Enum.TextYAlignment.Center })
	refs.sakura = Kit.label("🌸0", { Parent = wallet, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 8), Size = UDim2.fromOffset(92, 24), TextSize = 17, FontFace = T.bold, TextXAlignment = Enum.TextXAlignment.Right, TextWrapped = false })
	local badge = Kit.new("Frame", { Name = "Level", Position = UDim2.fromOffset(10, 36), Size = UDim2.fromOffset(26, 26), BackgroundColor3 = T.gold, Parent = wallet }, { Kit.corner(13), Kit.stroke(T.wood, 2, 0.1) })
	refs.levelBadge = badge
	refs.level = Kit.label("1", { Parent = badge, Size = UDim2.fromScale(1, 1), TextSize = 15, FontFace = T.bold, TextColor3 = T.ink, TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false })
	local bar, fill = Kit.bar(0, T.gold, { Parent = wallet, Position = UDim2.fromOffset(42, 42), Size = UDim2.new(1, -56, 0, 14) })
	refs.xpFill = fill
	refs.xpText = Kit.label("", { Parent = bar, Size = UDim2.fromScale(1, 1), TextSize = 11, FontFace = T.bold, TextColor3 = T.wood, TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, ZIndex = 2 })

	-- free gift for minutes played (Screens/Gifts): countdown, then "claim!"
	refs.gift = pill({ Name = "Gift", Position = UDim2.fromOffset(10, 82), Size = UDim2.fromOffset(150, 34), Visible = false, Parent = top }, function()
		Core.C.UI.toggle("Gifts")
	end)
	refs.giftLabel = pillLabel(refs.gift, 16)

	-- clock and day (tap: the summary of the last day)
	refs.day = pill({ Name = "Clock", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8), Size = UDim2.fromOffset(214, 36), Parent = top }, function()
		local report = Core.C.Data.day and Core.C.Data.day.report
		if report then
			Core.C.UI.open("DayReport", report)
		end
	end)
	refs.clock = pillLabel(refs.day, 17)

	-- today's objective (first daily quest not claimed yet): tap to claim it or see all of them
	refs.goal = pill({ Name = "Goal", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 50), Size = UDim2.fromOffset(360, 32), Visible = false, Parent = top }, function()
		local q = HUD.currentGoal and HUD.currentGoal()
		if q and q.progress >= q.target then
			NetDef.event("ClaimQuest"):FireServer(q.id)
		else
			Core.C.UI.toggle("Goals")
		end
	end)
	refs.goalLabel = pillLabel(refs.goal, 15)

	-- the restaurant you stand in (top-right)
	refs.place = pill({ Name = "Place", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8), Size = UDim2.fromOffset(176, 36), Parent = top })
	refs.placeLabel = pillLabel(refs.place, 16)
	refs.visit = Kit.new("Frame", { Name = "Visit", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 50), Size = UDim2.fromOffset(300, 38), Visible = false, Parent = top }, { Kit.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Right) })
	refs.like = Kit.button("❤️ " .. t("ui.like"), { parent = refs.visit, size = UDim2.fromOffset(140, 36), style = "primary", textSize = 15, order = 1, onClick = function()
		NetDef.event("Like"):FireServer()
	end })
	refs.home = Kit.button("🏠 " .. t("ui.home"), { parent = refs.visit, size = UDim2.fromOffset(120, 36), style = "plain", textSize = 15, order = 2, onClick = function()
		NetDef.event("GoHome"):FireServer()
	end })
	-- dishes: shown when some are dirty
	refs.dishes = pill({ Name = "Dishes", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 50), Size = UDim2.fromOffset(150, 32), Visible = false, Parent = top })
	refs.dishesLabel = pillLabel(refs.dishes, 15)

	-- the orders, oldest first (tap one for the step-by-step guide)
	refs.tickets = Kit.new("Frame", { Name = "Tickets", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 52), Size = UDim2.fromOffset(236, 420), Parent = top }, { Kit.list(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Right) })

	-- what you are holding, with a put-down button
	refs.hands = pill({ Name = "Hands", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -88), Size = UDim2.fromOffset(380, 40), Visible = false, Parent = top })
	refs.handsLabel = Kit.label("", { Parent = refs.hands, Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -140, 1, 0), TextSize = 16, FontFace = T.bold, TextYAlignment = Enum.TextYAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false })
	refs.drop = Kit.button("⬇ " .. t("ui.drop") .. (keyboard() and " [G]" or ""), {
		parent = refs.hands, size = UDim2.fromOffset(118, 32), position = UDim2.new(1, -122, 0, 4), style = "plain", textSize = 14, radius = 16,
		onClick = function()
			NetDef.event("DropHands"):FireServer()
		end,
	})

	-- the four big buttons
	refs.dock = Kit.new("Frame", { Name = "Dock", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), Size = UDim2.fromOffset(310, 74), Parent = top }, { Kit.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Bottom) })
	refs.buttons = {}
	for i, b in ipairs(BUTTONS) do
		local btn = Kit.new("TextButton", { Name = b.id, Size = UDim2.fromOffset(70, 70), BackgroundColor3 = T.paper, Text = "", LayoutOrder = i, AutoButtonColor = true, Parent = refs.dock }, { Kit.corner(18), Kit.stroke(T.wood, 2.5, 0.05), Kit.sheen(0.88) })
		local icon = Kit.label(b.icon, { Parent = btn, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 5), Size = UDim2.new(1, -16, 0.52, 0), TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center })
		local lbl = Kit.label("", { Parent = btn, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -4), Size = UDim2.new(1, -6, 0, 17), TextSize = 13, FontFace = T.bold, TextXAlignment = Enum.TextXAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false })
		if b.hotkey and keyboard() then
			local key = Kit.new("Frame", { AnchorPoint = Vector2.new(0, 0), Position = UDim2.fromOffset(-5, -5), Size = UDim2.fromOffset(20, 20), BackgroundColor3 = T.wood, Parent = btn }, { Kit.corner(6) })
			Kit.label(b.hotkey, { Parent = key, Size = UDim2.fromScale(1, 1), TextSize = 13, FontFace = T.bold, TextColor3 = T.white, TextXAlignment = Enum.TextXAlignment.Center })
		end
		Kit.press(btn)
		btn.MouseButton1Click:Connect(function()
			if Core.C.Audio then
				Core.C.Audio.play("ui")
			end
			open(b.id)
		end)
		refs.buttons[b.id] = { button = btn, label = lbl, icon = icon, def = b, badge = Kit.badge(btn, 24) }
	end

	player:GetAttributeChangedSignal("Hands"):Connect(HUD.refreshHands)
	player:GetAttributeChangedSignal("HandsKind"):Connect(HUD.refreshHands)
	-- G puts down what you hold (keyboard)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.G and refs.hands.Visible then
			NetDef.event("DropHands"):FireServer()
		end
	end)
	HUD.layout()
	Core.C.UI.ProfileChanged:Connect(function()
		HUD.layout()
		HUD.refreshTickets()
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			HUD.refreshTickets()
			HUD.refreshInfo()
			HUD.refreshGift()
			HUD.refreshGoal()
		end
	end)
	Core.C.Data.TicketsChanged:Connect(HUD.refreshTickets)
end

-- positions and sizes for the kind of screen
function HUD.layout()
	local l = L()
	refs.dock.Position = UDim2.new(l.dockX, 0, 1, -8)
	refs.dock.Size = UDim2.fromOffset(4 * l.dockW + 3 * 8, l.dockH + 4)
	for _, b in pairs(refs.buttons) do
		b.button.Size = UDim2.fromOffset(l.dockW, l.dockH)
	end
	refs.hands.Position = UDim2.new(l.dockX, 0, 1, -(l.dockH + 20))
	refs.xpText.Visible = Kit.profile ~= "phone"
	refs.tickets.Size = UDim2.fromOffset(l.ticketW, (l.ticketH + 6) * (l.tickets + 1))
end

-- where flying coins land (screen pixels, without the top bar inset)
function HUD.walletPoint()
	local l = refs.yen
	if not l then
		return nil
	end
	return l.AbsolutePosition + Vector2.new(30, l.AbsoluteSize.Y / 2)
end

-- the wallet pops a little when a coin lands
local bumping = false
function HUD.bumpWallet()
	local l = refs.yen
	if not l or bumping then
		return
	end
	bumping = true
	Kit.bump(l, 1.18)
	task.delay(0.3, function()
		bumping = false
	end)
end

-- the yen counter runs up to the new amount instead of jumping
local shownYen = nil
local yenTween = nil
local function showYen(amount)
	local Lg = Locale.get()
	if not shownYen or amount < shownYen or amount - shownYen > 1e7 then
		shownYen = amount
		refs.yen.Text = Format.yen(amount, Lg)
		return
	end
	if amount == shownYen then
		return
	end
	local value = Instance.new("NumberValue")
	value.Value = shownYen
	value.Changed:Connect(function(v)
		refs.yen.Text = Format.yen(math.floor(v + 0.5), Lg)
	end)
	if yenTween then
		yenTween:Cancel()
	end
	yenTween = game:GetService("TweenService"):Create(value, TweenInfo.new(0.6, Enum.EasingStyle.Quad), { Value = amount })
	yenTween:Play()
	shownYen = amount
end

-- first daily quest that is not claimed yet
function HUD.currentGoal()
	local meta = Core.C.Data.m("meta") or {}
	for _, q in ipairs(meta.quests or {}) do
		if not q.claimed then
			return q
		end
	end
	return nil
end

function HUD.refreshGoal()
	local q = HUD.currentGoal()
	-- the tutorial uses the top of the screen while it runs (Controllers/Tutorial)
	local tut = Core.C.Tutorial
	if not q or (tut and tut.active and tut.active()) then
		refs.goal.Visible = false
		return
	end
	refs.goal.Visible = true
	local text = t("quest." .. q.id, { n = q.target })
	if q.progress >= q.target then
		refs.goalLabel.Text = "🎯 " .. text .. "  ·  ✅ " .. t("ui.objective_claim")
		refs.goal.BackgroundColor3 = T.gold
	else
		refs.goalLabel.Text = "🎯 " .. text .. "  ·  " .. math.floor(q.progress) .. "/" .. q.target
		refs.goal.BackgroundColor3 = T.paper
	end
end

local giftToasted = {}
function HUD.refreshGift()
	local screen = Core.C.UI and Core.C.UI.screens.Gifts
	local idx, left = nil, nil
	if screen and screen.nextGift then
		idx, left = screen.nextGift()
	end
	if not idx then
		refs.gift.Visible = false
		return
	end
	refs.gift.Visible = true
	if left <= 0 then
		refs.giftLabel.Text = "🎁 " .. t("ui.gift_ready") .. (keyboard() and " [R]" or "")
		refs.gift.BackgroundColor3 = T.gold
		if not giftToasted[idx] then
			giftToasted[idx] = true
			Kit.bump(refs.gift, 1.2)
			Core.C.UI.toast("🎁 " .. t("msg.gift_ready"), "success")
			if Core.C.Audio then
				Core.C.Audio.play("gift")
			end
		end
	else
		refs.giftLabel.Text = "🎁 " .. Format.duration(left)
		refs.gift.BackgroundColor3 = T.paper
	end
end

function HUD.refreshHands()
	local kind = player:GetAttribute("HandsKind") or ""
	local raw = player:GetAttribute("Hands") or "[]"
	local ok, list = pcall(HttpService.JSONDecode, HttpService, raw)
	if not ok or kind == "" or #list == 0 then
		refs.hands.Visible = false
		return
	end
	local parts = {}
	for _, id in ipairs(list) do
		if kind == "dish" then
			table.insert(parts, (Recipes.byId[id] and Recipes.byId[id].icon or "🍽️") .. " " .. t("rec." .. id))
		elseif kind == "dirty" then
			table.insert(parts, "🧽")
		else
			local ing = Ingredients.byId[id]
			table.insert(parts, (ing and ing.icon or "📦") .. (kind == "box" and (" " .. t("ui.box_of", { name = "ing." .. id })) or ""))
		end
	end
	refs.handsLabel.Text = t("ui.holding") .. " " .. table.concat(parts, "  ")
	refs.hands.Visible = not (Core.C.Build and Core.C.Build.active)
end

function HUD.day(state)
	refs.clock.Text = (state.night and "🌙 " or "🕒 ") .. Format.clock(state.clock or 10) .. "  ·  " .. t("ui.day_n", { n = state.day or 1 })
end

-- the restaurant the player stands in: own (rating and likes) or someone else's (like, go home)
local function placeHere()
	local rootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	return rootPart and Core.C.Data.plotAt(rootPart.Position) or nil
end

function HUD.refreshInfo()
	local Data = Core.C.Data
	local here = placeHere()
	local folder = here and Data.plotFolder(here.id)
	local likes = folder and folder:GetAttribute("Likes") or 0
	local rating = (folder and folder:GetAttribute("Rating")) or Data.plotAttr("Rating") or 3
	local visiting = here ~= nil and here.ownerId ~= 0 and here.ownerId ~= player.UserId
	local text = "★ " .. Format.decimal(rating, 1, lang()) .. "   ❤️ " .. likes
	if visiting then
		text = "🏮 " .. (here.ownerName or "") .. "  ·  ★ " .. Format.decimal(rating, 1, lang())
	end
	refs.placeLabel.Text = text
	refs.place.Size = UDim2.fromOffset(visiting and 260 or 176, 36)
	refs.visit.Visible = visiting
	refs.like.Text = "❤️ " .. t("ui.like") .. "  " .. likes
	-- dishes: only when there is washing to do (or few clean ones are left)
	local d = Data.w("dishes")
	local pile = Data.plotAttr("SinkPile") or 0
	local showDishes = not visiting and d ~= nil and (pile > 0 or d.clean < d.total)
	refs.dishes.Visible = showDishes
	if showDishes then
		refs.dishesLabel.Text = "🍽️ " .. d.clean .. "/" .. d.total .. (pile > 0 and ("   🧽 " .. pile) or "")
		refs.dishes.BackgroundColor3 = (d.clean <= math.max(2, d.total * 0.2)) and T.gold or T.paper
	end
	local below = 50
	if visiting then
		below = 94
	elseif showDishes then
		below = 90
	end
	refs.tickets.Position = UDim2.new(1, -10, 0, below)
	local day = Data.day
	if day then
		local Lighting = game:GetService("Lighting")
		refs.clock.Text = (day.night and "🌙 " or "🕒 ") .. Format.clock(Lighting.ClockTime) .. "  ·  " .. t("ui.day_n", { n = day.day or 1 })
	end
end

-- patience (0..1) of the customer who ordered, read from their model
local function patienceOf(customerUid)
	for _, m in ipairs(CollectionService:GetTagged("Interactable")) do
		if m:GetAttribute("Uid") == customerUid then
			return m:GetAttribute("Patience") or 1
		end
	end
	return nil
end

-- Order tickets (right): big dish icon and name, what goes into it, and the customer's patience
-- as a coloured bar. The oldest order is the one to cook now (gold edge). Tap one for the guide.
function HUD.refreshTickets()
	local holder = refs.tickets
	if not holder then
		return
	end
	Kit.clear(holder)
	local l = L()
	local guide = Core.C.UI.screens.Guide
	local selected = guide and guide.recipe
	local tickets = Core.C.Data.tickets or {}
	for i, tk in ipairs(tickets) do
		if i > l.tickets then
			local more = pill({ Size = UDim2.fromOffset(84, 28), LayoutOrder = i, Parent = holder })
			pillLabel(more, 15).Text = "+" .. (#tickets - l.tickets)
			break
		end
		local r = Recipes.byId[tk.recipe]
		local p = patienceOf(tk.customer) or 1
		local barColor = p > 0.5 and T.green or (p > 0.25 and T.gold or T.red)
		local edge = selected == tk.recipe and T.red or (i == 1 and T.gold or (p <= 0.25 and T.red or T.wood))
		local card = Kit.new("TextButton", { Name = "Ticket", Text = "", Size = UDim2.fromOffset(l.ticketW, l.ticketH), BackgroundColor3 = Color3.fromRGB(255, 251, 242), LayoutOrder = i, AutoButtonColor = true, Parent = holder }, {
			Kit.corner(12), Kit.stroke(edge, (i == 1 or selected == tk.recipe) and 3 or 2),
		})
		Kit.label((r and r.icon or "🍽️"), { Parent = card, Size = UDim2.fromOffset(l.ticketH - 18, l.ticketH - 18), Position = UDim2.fromOffset(8, 5), TextScaled = true })
		Kit.label(t("rec." .. tk.recipe), { Parent = card, Position = UDim2.fromOffset(l.ticketH - 4, 4), Size = UDim2.new(1, -(l.ticketH + 22), 0, 22), TextSize = 17, FontFace = T.bold, TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false })
		Kit.label("#" .. i, { Parent = card, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 5), Size = UDim2.fromOffset(26, 18), TextSize = 13, FontFace = T.bold, TextColor3 = T.muted, TextXAlignment = Enum.TextXAlignment.Right, TextWrapped = false })
		-- what goes into it: ingredients, plus broth / rice
		local need = {}
		for _, g in ipairs(r and r.ing or {}) do
			local ing = Ingredients.byId[g]
			table.insert(need, ing and ing.icon or "?")
		end
		if r and r.broth then
			table.insert(need, "🥣")
		end
		if r and r.rice then
			table.insert(need, "🍚")
		end
		Kit.label(table.concat(need, " ") .. (tk.claimed and "   👨‍🍳" or ""), { Parent = card, Position = UDim2.fromOffset(l.ticketH - 4, 26), Size = UDim2.new(1, -(l.ticketH + 2), 0, 18), TextSize = 15, TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false })
		local bar = Kit.new("Frame", { Position = UDim2.new(0, 10, 1, -11), Size = UDim2.new(1, -20, 0, 6), BackgroundColor3 = Color3.fromRGB(216, 200, 174), Parent = card }, { Kit.corner(3) })
		Kit.new("Frame", { Size = UDim2.fromScale(math.clamp(p, 0, 1), 1), BackgroundColor3 = barColor, Parent = bar }, { Kit.corner(3) })
		Kit.press(card)
		card.MouseButton1Click:Connect(function()
			if Core.C.UI.screens.Guide then
				Core.C.UI.screens.Guide.show(tk.recipe)
			else
				Core.C.Interaction.highlightRecipe(tk.recipe)
			end
			HUD.refreshTickets()
		end)
	end
	holder.Visible = not (Core.C.Build and Core.C.Build.active)
end

-- how many things the restaurant can buy right now (the shop button's badge)
local lastBuyable = 0
local function refreshShopBadge()
	local Data = Core.C.Data
	local b = refs.buttons.Shop
	if not b then
		return
	end
	if not Data.canBuild() or not (Data.world or Data.me) then
		b.badge(0)
		return
	end
	local rating = Data.plotAttr("Rating") or 3
	local w = Data.restaurant()
	local total = ShopLogic.buyable(w, SHOP_CFG, rating)
	if total > lastBuyable then
		Kit.bump(b.button, 1.12)
	end
	lastBuyable = total
	b.badge(total)
end

function HUD.refresh()
	local Data = Core.C.Data
	if not Data.ready then
		return
	end
	showYen(Data.wallet())
	refs.sakura.Text = Format.sakura(Data.m("sakura") or 0, lang())
	local level = Data.w("level") or 1
	local xp = Data.w("xp") or 0
	local need = Formulas.xpForLevel(level)
	refs.level.Text = tostring(level)
	refs.xpText.Text = Format.number(xp, lang()) .. " / " .. Format.number(need, lang()) .. " XP"
	refs.xpFill.Size = UDim2.fromScale(math.clamp(xp / need, 0, 1), 1)
	for _, b in pairs(refs.buttons) do
		b.label.Text = t(b.def.key)
		b.button.BackgroundColor3 = (b.def.build and not Data.canBuild()) and T.locked or T.paper
	end
	refreshShopBadge()
	-- texts made before the language was known
	refs.home.Text = "🏠 " .. t("ui.home")
	refs.drop.Text = "⬇ " .. t("ui.drop") .. (keyboard() and " [G]" or "")
	HUD.day(Data.day)
	HUD.refreshHands()
	HUD.refreshInfo()
end

-- While building, the dock, the orders and the hands bar step aside for the catalog
function HUD.setBuilding(on)
	if not HUD.frame then
		return
	end
	refs.dock.Visible = not on
	refs.tickets.Visible = not on
	if on then
		refs.hands.Visible = false
	else
		HUD.refreshHands()
	end
end

function HUD.open() end
function HUD.close() end

return HUD
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000132"><Properties><string name="Name">Invite</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Friends and helpers: invite friends to this street (they get a restaurant of their own and can
-- help in yours), choose who may help in your restaurant (friends or everyone), give players a
-- role in your restaurant (helper / co-manager / none) and go back to your own door.
local Players = game:GetService("Players")
local SocialService = game:GetService("SocialService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Kit = require(script.Parent.Parent.Kit)
local Base = require(script.Parent.Parent.Base)
local Core = require(script.Parent.Parent.Parent.Core)

local t = Locale.t

return Base.make("Invite", "ui.invite", UDim2.fromScale(0.5, 0.7), function(content)
	local Data = Core.C.Data
	local me = Players.LocalPlayer
	local scroll = Kit.scroll({ Parent = content })
	Kit.label(t("ui.invite_text"), { Parent = scroll, Size = UDim2.new(1, -8, 0, 48), TextSize = 16, LayoutOrder = 1 })
	Kit.button("📨 " .. t("ui.invite_friends"), { parent = scroll, size = UDim2.new(1, -8, 0, 46), style = "green", order = 2, onClick = function()
		local ok, can = pcall(function()
			return SocialService:CanSendGameInviteAsync(me)
		end)
		if ok and can then
			local opts = Instance.new("ExperienceInviteOptions")
			opts.PromptMessage = t("ui.invite_prompt")
			pcall(function()
				SocialService:PromptGameInvite(me, opts)
			end)
		else
			Core.C.UI.toast(t("msg.invite_unavailable"), "warning")
		end
	end })
	Kit.button("🏠 " .. t("ui.go_home"), { parent = scroll, size = UDim2.new(1, -8, 0, 40), style = "plain", order = 3, onClick = function()
		NetDef.event("GoHome"):FireServer()
		Core.C.UI.close("Invite")
	end })
	-- who may help in my restaurant
	local settings = Data.m("settings") or {}
	local coop = settings.coop or "friends"
	local row = Kit.card({ Size = UDim2.new(1, -8, 0, 56), LayoutOrder = 4, Parent = scroll })
	Kit.label("🤝 " .. t("ui.coop_who"), { Parent = row, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(0.45, 0, 1, 0), FontFace = Kit.Theme.bold, TextYAlignment = Enum.TextYAlignment.Center })
	local holder = Kit.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromScale(0.45, 0), Size = UDim2.new(0.55, -10, 1, 0), Parent = row }, { Kit.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center) })
	for i, o in ipairs({ { value = "friends", label = t("ui.coop_friends") }, { value = "everyone", label = t("ui.coop_everyone") } }) do
		Kit.button(o.label, { parent = holder, size = UDim2.fromOffset(110, 36), style = coop == o.value and "primary" or "plain", order = i, textSize = 14, onClick = function()
			NetDef.event("SetSetting"):FireServer("coop", o.value)
		end })
	end
	-- the players on this street and their role in my restaurant
	local perms = Data.m("perms") or {}
	Kit.title(t("ui.street_players"), { Parent = scroll, Size = UDim2.new(1, -8, 0, 30), LayoutOrder = 5, TextSize = 20 })
	local order = 10
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= me then
			order += 1
			local perm = perms[tostring(p.UserId)]
			local role = perm == "comanager" and "comanager" or (perm == "helper" and "helper" or "default")
			local card, right = Kit.row(role == "comanager" and "🛠️" or "🧑‍🍳", p.DisplayName, t("perm." .. role), 64)
			card.LayoutOrder = order
			card.Parent = scroll
			local actions = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(170, 36), Parent = right }, { Kit.list(Enum.FillDirection.Horizontal, 4, Enum.HorizontalAlignment.Right) })
			Kit.button(role == "comanager" and t("ui.make_helper") or t("ui.make_comanager"), { parent = actions, size = UDim2.fromOffset(120, 34), style = "plain", textSize = 13, order = 1, onClick = function()
				NetDef.event("SetPermission"):FireServer(p.UserId, role == "comanager" and "helper" or "comanager")
			end })
			if perm then
				Kit.button("✕", { parent = actions, size = UDim2.fromOffset(40, 34), style = "plain", order = 2, onClick = function()
					NetDef.event("SetPermission"):FireServer(p.UserId, "none")
				end })
			end
		end
	end
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000133"><Properties><string name="Name">Menu</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Menu board: enable dishes, set prices (-30%..+30%), recipe book with mastery.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Format = require(Shared.Util.Format)
local Recipes = require(Shared.Config.Recipes)
local Licenses = require(Shared.Config.Licenses)
local Franchise = require(Shared.Config.Franchise)
local Formulas = require(Shared.Logic.Formulas)
local Kit = require(script.Parent.Parent.Kit)
local Base = require(script.Parent.Parent.Base)
local Core = require(script.Parent.Parent.Parent.Core)

local t = Locale.t
local T = Kit.Theme
local tab = "menu"

local function isUnlocked(w, r)
	if r.city then
		return w.franchise and w.franchise.city == r.city and (w.level or 1) >= Franchise.RegionalLevel
	end
	return w.licenses and w.licenses[r.license] == true
end

local function licenseOf(recipeId)
	for _, l in ipairs(Licenses.list) do
		if table.find(l.recipes, recipeId) then
			return l
		end
	end
	return nil
end

local screen
screen = Base.make("Menu", "ui.menu", UDim2.fromScale(0.66, 0.76), function(content)
	local w = Core.C.Data.restaurant()
	local L = Locale.get()
	Kit.tabs(content, { { id = "menu", label = t("ui.tab_menu") }, { id = "book", label = t("ui.tab_book") } }, function(id)
		tab = id
		screen.refresh()
	end, tab)
	local scroll = Kit.scroll({ Position = UDim2.fromOffset(0, 46), Size = UDim2.new(1, 0, 1, -46), Parent = content })
	local canEdit = Core.C.Data.canBuild()
	for _, r in ipairs(Recipes.list) do
		local unlocked = isUnlocked(w, r)
		local served = (w.mastery and w.mastery[r.id]) or 0
		local mastery = Formulas.masteryLevel(served)
		if tab == "menu" and unlocked then
			local m = (w.menu and w.menu[r.id]) or { on = true, price = 1 }
			local price = Formulas.dishPrice(r.price, served, m.price)
			local stars = string.rep("★", mastery) .. string.rep("☆", 5 - mastery)
			local card, right = Kit.row(r.icon, t("rec." .. r.id), Format.yen(price, L) .. "  ·  " .. t("station." .. r.station) .. "  ·  " .. stars, 74)
			card.Parent = scroll
			card.LayoutOrder = r.order
			local controls = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(170, 30), Parent = right }, { Kit.list(Enum.FillDirection.Horizontal, 4, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center) })
			Kit.button("−", { parent = controls, size = UDim2.fromOffset(30, 28), style = "plain", order = 1, disabled = not canEdit, onClick = function()
				NetDef.event("SetMenu"):FireServer(r.id, nil, m.price - 0.1)
			end })
			Kit.label(math.floor(m.price * 100 + 0.5) .. "%", { Parent = controls, Size = UDim2.fromOffset(52, 28), TextXAlignment = Enum.TextXAlignment.Center, FontFace = T.bold, LayoutOrder = 2 })
			Kit.button("+", { parent = controls, size = UDim2.fromOffset(30, 28), style = "plain", order = 3, disabled = not canEdit, onClick = function()
				NetDef.event("SetMenu"):FireServer(r.id, nil, m.price + 0.1)
			end })
			Kit.button(m.on and t("ui.on") or t("ui.off"), { parent = controls, size = UDim2.fromOffset(52, 28), style = m.on and "green" or "plain", order = 4, disabled = not canEdit, onClick = function()
				NetDef.event("SetMenu"):FireServer(r.id, not m.on, nil)
			end })
		elseif tab == "book" then
			local sub
			if unlocked then
				local nextT = Formulas.MasteryThresholds[mastery + 1]
				sub = t("ui.mastery", { level = mastery }) .. "  ·  " .. served .. (nextT and ("/" .. nextT) or "") .. "  ·  " .. t("ui.ingredients") .. ": "
				local names = {}
				for _, g in ipairs(r.ing) do
					table.insert(names, t("ing." .. g))
				end
				sub ..= table.concat(names, ", ")
			elseif r.city then
				sub = "🔒 " .. t("ui.regional", { city = "city." .. r.city })
			else
				local l = licenseOf(r.id)
				sub = "🔒 " .. (l and t("lic." .. l.id) or "")
			end
			local card = Kit.row(unlocked and r.icon or "🔒", t("rec." .. r.id), sub, 74)
			card.Parent = scroll
			card.LayoutOrder = r.order
			if mastery >= 5 then
				card.BackgroundColor3 = Kit.Theme.gold
			end
		end
	end
end)

return screen
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000134"><Properties><string name="Name">Offline</string><ProtectedString name="Source"><![CDATA[--!nonstrict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Format = require(Shared.Util.Format)
local Kit = require(script.Parent.Parent.Kit)
local Base = require(script.Parent.Parent.Base)
local Core = require(script.Parent.Parent.Parent.Core)

local t = Locale.t

return Base.make("Offline", "ui.offline", UDim2.fromScale(0.36, 0.4), function(content)
	local meta = Core.C.Data.m("meta") or {}
	local amount = meta.offlinePending or 0
	Kit.label("💰", { Parent = content, Size = UDim2.new(1, 0, 0, 60), TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center })
	Kit.label(t("ui.offline_text", { hours = math.floor((meta.offlineHours or 0) * 10) / 10, yen = amount }), { Parent = content, Position = UDim2.fromOffset(0, 70), Size = UDim2.new(1, 0, 0, 60), TextSize = 20, TextXAlignment = Enum.TextXAlignment.Center })
	Kit.button(t("ui.claim") .. " " .. Format.yen(amount, Locale.get()), { parent = content, size = UDim2.new(1, 0, 0, 48), position = UDim2.new(0, 0, 1, -50), style = "green", onClick = function()
		NetDef.event("ClaimOffline"):FireServer()
		Core.C.UI.close("Offline")
	end })
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000135"><Properties><string name="Name">Phone</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Phone ("More"): the screens that are not needed every minute, as apps. Opens from the 📱 button
-- of the HUD and closes when an app is opened. Everything bought with yen is in the shop.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Locale = require(Shared.Locale)
local Format = require(Shared.Util.Format)
local Color = require(Shared.Util.Color)
local Kit = require(script.Parent.Parent.Kit)
local Core = require(script.Parent.Parent.Parent.Core)

local T = Kit.Theme
local t = Locale.t
local player = Players.LocalPlayer

local APPS = {
	{ id = "Menu", icon = "📜", key = "ui.menu", color = "#B3262E" },
	{ id = "Goals", icon = "🎯", key = "ui.goals", color = "#F27A2E" },
	{ id = "Gifts", icon = "🎁", key = "ui.gifts", color = "#E0405A" },
	{ id = "Invite", icon = "👋", key = "ui.invite", color = "#7F3AB3" },
	{ id = "Premium", icon = "💎", key = "ui.premium", color = "#2E5A8C" },
	{ id = "Codes", icon = "🎟️", key = "ui.codes", color = "#3A8F8A" },
	{ id = "Help", icon = "❓", key = "ui.howto", color = "#2EA3B3" },
	{ id = "Settings", icon = "⚙️", key = "ui.settings", color = "#5A5A64" },
	{ id = "Dev", icon = "🛠️", key = "ui.dev", color = "#1E1E22", dev = true },
}

local Phone = {}
local frame, grid, clock

local function launch(app)
	if Core.C.Audio then
		Core.C.Audio.play("ui")
	end
	Core.C.UI.close("Phone")
	if app.id == "Help" then
		if Core.C.Tutorial and Core.C.Tutorial.restart then
			Core.C.Tutorial.restart()
		end
		return
	end
	Core.C.UI.open(app.id)
end

function Phone.create(root)
	frame = Kit.new("Frame", {
		Name = "Phone", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -92), Size = UDim2.fromOffset(300, 400),
		BackgroundColor3 = Color3.fromRGB(28, 26, 30), Visible = false, ZIndex = 9, Parent = root,
	}, { Kit.corner(30), Kit.stroke(Color3.fromRGB(70, 66, 72), 3) })
	-- screen
	local screen = Kit.new("Frame", { Position = UDim2.fromOffset(10, 12), Size = UDim2.new(1, -20, 1, -34), BackgroundColor3 = T.paper, Parent = frame }, { Kit.corner(22) })
	Kit.new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(255, 240, 244), Color3.fromRGB(244, 235, 221)), Rotation = 90, Parent = screen })
	-- status bar with the time and a little notch
	clock = Kit.label("", { Parent = screen, Position = UDim2.fromOffset(16, 6), Size = UDim2.fromOffset(80, 18), TextSize = 13, FontFace = T.bold })
	Kit.label("📶 🔋", { Parent = screen, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 6), Size = UDim2.fromOffset(60, 18), TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right })
	Kit.new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 6), Size = UDim2.fromOffset(70, 14), BackgroundColor3 = Color3.fromRGB(28, 26, 30), Parent = screen }, { Kit.corner(7) })
	Kit.title("🌸 Sakura", { Parent = screen, Position = UDim2.fromOffset(16, 30), Size = UDim2.new(1, -32, 0, 28), TextSize = 22 })
	grid = Kit.new("Frame", { Position = UDim2.fromOffset(10, 66), Size = UDim2.new(1, -20, 1, -76), BackgroundTransparency = 1, Parent = screen }, { Kit.grid(82, 92, 4) })
	-- home bar
	Kit.new("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), Size = UDim2.fromOffset(90, 5), BackgroundColor3 = Color3.fromRGB(120, 116, 124), Parent = frame }, { Kit.corner(3) })
end

function Phone.refresh()
	if not grid then
		return
	end
	Kit.clear(grid)
	clock.Text = Format.clock(game:GetService("Lighting").ClockTime)
	local order = 0
	for _, app in ipairs(APPS) do
		local visible = not app.dev or player:GetAttribute("Dev") == true
		if visible then
			order += 1
			local cell = Kit.new("TextButton", { Text = "", BackgroundTransparency = 1, LayoutOrder = order, Parent = grid })
			local icon = Kit.new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 4), Size = UDim2.fromOffset(58, 58), BackgroundColor3 = Color.hex(app.color), Parent = cell }, { Kit.corner(16), Kit.sheen(0.75) })
			Kit.label(app.icon, { Parent = icon, Size = UDim2.new(1, -12, 1, -12), Position = UDim2.fromOffset(6, 6), TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center })
			local name = Kit.label(t(app.key), { Parent = cell, Position = UDim2.fromOffset(0, 65), Size = UDim2.new(1, 0, 0, 20), TextScaled = true, FontFace = T.bold, TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false })
			Kit.new("UITextSizeConstraint", { MaxTextSize = 14, MinTextSize = 9, Parent = name })
			Kit.press(cell)
			cell.MouseButton1Click:Connect(function()
				launch(app)
			end)
		end
	end
end

function Phone.visible()
	return frame ~= nil and frame.Visible
end

function Phone.open()
	Phone.refresh()
	frame.Visible = true
	-- slides up above the dock; on a phone screen there is no room above it, so it stands on the
	-- left half of the screen, clear of the dock
	local goal
	if Kit.profile == "phone" then
		frame.AnchorPoint = Vector2.new(0.5, 0.5)
		frame.Size = UDim2.fromOffset(300, 380)
		goal = UDim2.new(0.25, 0, 0.5, 0)
		frame.Position = UDim2.new(0.25, 0, 1.2, 0)
	else
		local x = Kit.profile == "desktop" and 0.5 or 0.55
		frame.AnchorPoint = Vector2.new(0.5, 1)
		frame.Size = UDim2.fromOffset(300, 400)
		goal = UDim2.new(x, 0, 1, -92)
		frame.Position = UDim2.new(x, 0, 1, 40)
	end
	TweenService:Create(frame, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = goal }):Play()
end

function Phone.close()
	if frame then
		frame.Visible = false
	end
end

return Phone
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000136"><Properties><string name="Name">Premium</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Robux shop: game passes and products (only the ones with an id in Config/Monetization).
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Monetization = require(Shared.Config.Monetization)
local Kit = require(script.Parent.Parent.Kit)
local Base = require(script.Parent.Parent.Base)

local t = Locale.t
local ICON = { gp_vip = "👑", gp_double_yen = "💴", gp_big_tray = "🍱", gp_express = "🚀", gp_starter = "🎁", dp_rush_hour = "🔔", dp_golden_sign = "🌟" }

return Base.make("Premium", "ui.premium", UDim2.fromScale(0.6, 0.72), function(content)
	local scroll = Kit.scroll({ Parent = content })
	local any = false
	for i, gp in ipairs(Monetization.GamePasses) do
		if gp.assetId ~= 0 then
			any = true
			local card, right = Kit.row(ICON[gp.id] or "🎟️", t("gp." .. gp.id), t("gpdesc." .. gp.id), 76)
			card.Parent = scroll
			card.LayoutOrder = i
			Kit.button("R$", { parent = right, size = UDim2.fromOffset(120, 38), style = "green", onClick = function()
				NetDef.event("BuyWithRobux"):FireServer("gamepass", gp.id)
			end })
		end
	end
	for i, p in ipairs(Monetization.Products) do
		if p.productId ~= 0 then
			any = true
			local icon = ICON[p.id] or (string.find(p.id, "sakura") and "🌸" or "💴")
			local card, right = Kit.row(icon, t("dp." .. p.id), t("dpdesc." .. p.id), 70)
			card.Parent = scroll
			card.LayoutOrder = 100 + i
			Kit.button("R$", { parent = right, size = UDim2.fromOffset(120, 38), style = "green", onClick = function()
				NetDef.event("BuyWithRobux"):FireServer("product", p.id)
			end })
		end
	end
	if not any then
		Kit.label("🛒 " .. t("ui.shop_soon"), { Parent = scroll, Size = UDim2.new(1, 0, 0, 80), TextSize = 20, TextXAlignment = Enum.TextXAlignment.Center })
	end
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000137"><Properties><string name="Name">Settings</string><ProtectedString name="Source"><![CDATA[--!nonstrict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local GameConfig = require(Shared.Config.GameConfig)
local Kit = require(script.Parent.Parent.Kit)
local Base = require(script.Parent.Parent.Base)
local Core = require(script.Parent.Parent.Parent.Core)

local t = Locale.t

local function set(key, value)
	NetDef.event("SetSetting"):FireServer(key, value)
end

return Base.make("Settings", "ui.settings", UDim2.fromScale(0.5, 0.72), function(content)
	local s = Core.C.Data.m("settings") or {}
	local scroll = Kit.scroll({ Parent = content })
	local function choice(order, label, options, current, key)
		local row = Kit.card({ Size = UDim2.new(1, -8, 0, 60), LayoutOrder = order, Parent = scroll })
		Kit.label(label, { Parent = row, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(0.4, 0, 1, 0), FontFace = Kit.Theme.bold })
		local holder = Kit.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromScale(0.4, 0), Size = UDim2.new(0.6, -10, 1, 0), Parent = row }, { Kit.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center) })
		for i, o in ipairs(options) do
			Kit.button(o.label, { parent = holder, size = UDim2.fromOffset(o.width or 86, 38), style = (current == o.value) and "primary" or "plain", order = i, textSize = 15, onClick = function()
				set(key, o.value)
			end })
		end
	end
	choice(1, "🌐 " .. t("ui.language"), { { label = t("ui.auto"), value = "auto" }, { label = "English", value = "en" }, { label = "Italiano", value = "it" } }, s.lang or "auto", "lang")
	local grids = {}
	for _, g in ipairs(GameConfig.GridSizes) do
		table.insert(grids, { label = g .. " stud", value = g })
	end
	choice(2, "📐 " .. t("ui.grid_size"), grids, s.grid or 1, "grid")
	local rots = {}
	for _, r in ipairs(GameConfig.RotationSteps) do
		table.insert(rots, { label = r .. "°", value = r })
	end
	choice(3, "🔄 " .. t("ui.rotation_step"), rots, s.rot or 90, "rot")
	local vols = { { label = "0%", value = 0 }, { label = "25%", value = 0.25 }, { label = "50%", value = 0.5 }, { label = "100%", value = 1 } }
	choice(4, "🎵 " .. t("ui.music"), vols, s.music or 0.5, "music")
	choice(5, "🔊 " .. t("ui.sfx"), vols, s.sfx or 0.8, "sfx")
	choice(7, "🎥 " .. t("ui.camera"), { { label = t("ui.auto"), value = "auto", width = 70 }, { label = t("ui.cam_first"), value = "first", width = 110 }, { label = t("ui.cam_game"), value = "game", width = 110 }, { label = "Roblox", value = "roblox", width = 76 } }, s.cam or "auto", "cam")
	choice(8, "🐢 " .. t("ui.cam_speed"), { { label = t("ui.slow"), value = 0.6 }, { label = t("ui.medium"), value = 1 }, { label = t("ui.fast"), value = 1.6 } }, s.camSpeed or 1, "camSpeed")
	choice(6, "🖥️ " .. t("ui.low_graphics"), { { label = t("ui.on"), value = true }, { label = t("ui.off"), value = false } }, s.lowGfx == true, "lowGfx")
	Kit.button("🎓 " .. t("ui.restart_tutorial"), { parent = scroll, size = UDim2.new(1, -8, 0, 44), style = "plain", order = 10, onClick = function()
		NetDef.event("TutorialStep"):FireServer(0)
		Core.C.UI.close("Settings")
		if Core.C.Tutorial then
			Core.C.Tutorial.restart()
		end
	end })
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000138"><Properties><string name="Name">Shop</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The shop: everything the restaurant buys with yen, in five tabs of big cards (upgrades and
-- adverts, recipes, staff, rooms, renovations). Every card says what it is and what it does, and
-- has one clear button:
--   green with the price      tap to buy
--   price in red              not enough yen yet (the card says how much is missing)
--   grey with a lock          something comes first (a level, a recipe, a room...)
--   a tick / MAX              already yours
-- Things to buy now come first, cheapest first. The tabs count what can be bought right now, like
-- the shop button in the HUD (Logic/Shop). Purchases go to the server, which checks everything
-- again (Services/Progression, Services/Staff).
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Format = require(Shared.Util.Format)
local Color = require(Shared.Util.Color)
local ShopLogic = require(Shared.Logic.Shop)
local Formulas = require(Shared.Logic.Formulas)
local Upgrades = require(Shared.Config.Upgrades)
local Ads = require(Shared.Config.Ads)
local Licenses = require(Shared.Config.Licenses)
local Recipes = require(Shared.Config.Recipes)
local Expansions = require(Shared.Config.Expansions)
local StaffCfg = require(Shared.Config.Staff)
local GameConfig = require(Shared.Config.GameConfig)
local Kit = require(script.Parent.Parent.Kit)
local Base = require(script.Parent.Parent.Base)
local Icons = require(script.Parent.Parent.Icons)
local Core = require(script.Parent.Parent.Parent.Core)

local t = Locale.t
local T = Kit.Theme
local CFG = { Upgrades = Upgrades, Ads = Ads, Licenses = Licenses, Expansions = Expansions, Staff = StaffCfg, MaxStaff = GameConfig.MaxStaff }

local TABS = {
	{ id = "upgrades", icon = "⬆️", key = "ui.upgrades" },
	{ id = "recipes", icon = "🍜", key = "ui.tab_recipes" },
	{ id = "staff", icon = "👥", key = "ui.staff" },
	{ id = "rooms", icon = "🏗️", key = "ui.tab_rooms" },
	{ id = "reno", icon = "🪚", key = "ui.tab_renos" },
}
local BRANCH_ICON = { base = "🏠", sushi = "🍣", ramen = "🍜", extra = "🥟", master = "🎌" }
local BRANCH_TINT = { base = "#E9D9BE", sushi = "#F6D2C8", ramen = "#F4DDB0", extra = "#E3E8C4", master = "#F1D58E" }
local RENO_GROUPS = {
	{ id = "exterior", key = "ui.reno_exterior" },
	{ id = "interior", key = "ui.reno_interior" },
	{ id = "furniture", key = "ui.reno_furniture" },
}

local tab = "upgrades"
local lastBought = nil -- { key, progress } of the card whose purchase was just sent (it springs when it lands)

local function cardSize()
	if Kit.profile == "phone" then
		return 172, 226
	end
	return 192, 240
end

-- what an upgrade does now and at the next level
local function effectText(u, value, lvl)
	local L = Locale.get()
	if value == nil then
		return ""
	end
	if u.effect == "step" or u.effect == "walk" or u.effect == "shelf" then
		return math.floor(value * 100 + 0.5) .. "%"
	elseif u.effect == "cart" then
		return value .. " 📦"
	elseif u.effect == "delivery" then
		return value .. "s"
	elseif u.effect == "discount" then
		return "-" .. math.floor(value * 100 + 0.5) .. "%"
	elseif u.effect == "popularity" then
		return "+" .. Format.decimal(value, 2, L)
	elseif u.effect == "offline" then
		return value .. "h · " .. math.floor((u.pct[lvl + 1] or 0) * 100) .. "%"
	elseif u.effect == "autorestock" then
		return value > 0 and "✓" or "—"
	end
	return tostring(value)
end

local function needText(need)
	if not need then
		return ""
	end
	if need.kind == "level" then
		return t("ui.req_level", { level = need.level })
	elseif need.kind == "license" then
		return t("lic." .. need.id)
	elseif need.kind == "zone" then
		return t("zone." .. need.id)
	elseif need.kind == "staff" then
		return t("staff." .. need.id)
	elseif need.kind == "rating" then
		return "★ " .. need.rating
	elseif need.kind == "slots" then
		return t("ui.need_slots")
	elseif need.kind == "manager" then
		return t("ui.need_manager")
	end
	return ""
end

local function wiggle(frame)
	local s = frame
	Kit.tween(s, 0.05, { Rotation = 3 })
	task.delay(0.05, function()
		Kit.tween(s, 0.08, { Rotation = -3 })
		task.delay(0.08, function()
			Kit.tween(s, 0.08, { Rotation = 0 })
		end)
	end)
end

-- A card: o = { key, progress, icon, tint, title, sub, corner (level pips...), st, onBuy }
local function card(parent, order, o)
	local cw, ch = cardSize()
	local st = o.st
	if o.progress == nil then
		o.progress = st.state
	end
	local done = st.state == "owned" or st.state == "max" or st.state == "active"
	local locked = st.state == "locked"
	local c = Kit.card({ Name = "Card", Size = UDim2.fromOffset(cw, ch), LayoutOrder = order, Parent = parent, BackgroundColor3 = done and Color.hex("#F3EEE4") or Color.hex("#FFFBF3") })
	local stroke = c:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = st.state == "buy" and T.green or (done and T.paperDark or T.woodLight)
		stroke.Thickness = st.state == "buy" and 3 or 2
	end
	-- big icon on a round tile
	local tile = Kit.new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8), Size = UDim2.fromOffset(64, 64), BackgroundColor3 = Color.hex(o.tint or "#EBDDC4"), Parent = c }, { Kit.corner(32) })
	Kit.label(o.icon or "🎁", { Parent = tile, Position = UDim2.fromOffset(10, 10), Size = UDim2.new(1, -20, 1, -20), TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center, TextTransparency = locked and 0.45 or 0 })
	if locked then
		Kit.label("🔒", { Parent = tile, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, 6, 1, 4), Size = UDim2.fromOffset(28, 28), TextScaled = true })
	end
	if o.corner and o.corner ~= "" then
		local tag = Kit.new("Frame", { Position = UDim2.fromOffset(8, 8), Size = UDim2.fromOffset(0, 22), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = T.wood, Parent = c }, { Kit.corner(11), Kit.padding(8, 0) })
		Kit.label(o.corner, { Parent = tag, Size = UDim2.fromOffset(0, 22), AutomaticSize = Enum.AutomaticSize.X, TextSize = 13, FontFace = T.bold, TextColor3 = T.white, TextWrapped = false })
	end
	Kit.label(o.title or "", { Parent = c, Position = UDim2.fromOffset(6, 76), Size = UDim2.new(1, -12, 0, 22), TextSize = 16, FontFace = T.bold, TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
	Kit.label(o.sub or "", { Parent = c, Position = UDim2.fromOffset(8, 100), Size = UDim2.new(1, -16, 0, ch - 100 - 74), TextSize = 14, TextColor3 = T.muted, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top, TextTruncate = Enum.TextTruncate.AtEnd })
	-- one clear action at the bottom
	local L = Locale.get()
	local note = Kit.label("", { Parent = c, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -54), Size = UDim2.new(1, -12, 0, 18), TextSize = 14, FontFace = T.bold, TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
	local canBuy = Core.C.Data.canBuild()
	local text, style = "", "green"
	if st.state == "owned" then
		text, style = "✅ " .. t("ui.owned"), "plain"
	elseif st.state == "max" then
		text, style = "✅ MAX", "plain"
	elseif st.state == "active" then
		text, style = "📣 " .. t("ui.active"), "plain"
	elseif locked then
		text, style = "🔒 " .. needText(st.need), "dark"
	elseif st.state == "poor" then
		text, style = Format.yen(st.price, L), "plain"
		note.Text = t("ui.missing", { yen = Format.yen(st.missing, L) })
		note.TextColor3 = T.red
	else
		text, style = Format.yen(st.price, L), canBuy and "green" or "plain"
	end
	local btn = Kit.button(text, {
		parent = c, size = UDim2.new(1, -16, 0, 44), position = UDim2.new(0, 8, 1, -50), style = style, textSize = 17, radius = 12,
		onClick = function()
			if done then
				return
			end
			if not canBuy then
				Core.C.UI.toast(t("ui.only_owner"), "warning")
				wiggle(c)
				return
			end
			if locked then
				Core.C.UI.toast("🔒 " .. needText(st.need), "warning")
				wiggle(c)
				if Core.C.Audio then
					Core.C.Audio.play("error")
				end
				return
			end
			if st.state == "poor" then
				Core.C.UI.toast(t("ui.missing", { yen = Format.yen(st.missing, L) }), "warning")
				wiggle(c)
				if Core.C.Audio then
					Core.C.Audio.play("error")
				end
				return
			end
			lastBought = { key = o.key, progress = o.progress }
			Kit.bump(c, 1.06)
			if Core.C.Audio then
				Core.C.Audio.play("coin")
			end
			o.onBuy()
		end,
	})
	btn.Name = "Buy"
	if st.state == "poor" then
		btn.TextColor3 = T.red
	elseif done then
		btn.TextColor3 = T.green
		btn.AutoButtonColor = false
	end
	if lastBought and lastBought.key == o.key and lastBought.progress ~= o.progress then
		-- the purchase landed: the card springs once
		lastBought = nil
		Kit.popIn(c, 0.8)
		if Core.C.Audio then
			Core.C.Audio.play("sparkle")
		end
	end
	return c
end

-- a titled block of cards (a section of a tab)
local function section(scroll, order, title)
	local cw, ch = cardSize()
	if title then
		Kit.title(title, { Parent = scroll, Size = UDim2.new(1, -8, 0, 30), TextSize = 20, LayoutOrder = order })
	end
	local layout = Kit.grid(cw, ch, 10)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	local grid = Kit.new("Frame", { Name = "Cards", BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order + 1, Parent = scroll }, { layout })
	return grid
end

local function fill(grid, entries)
	ShopLogic.sort(entries)
	for i, e in ipairs(entries) do
		card(grid, i, e)
	end
end

local function pips(level, max)
	if max > 6 then
		return level .. "/" .. max
	end
	return string.rep("●", level) .. string.rep("○", max - level)
end

------------------------------------------------------------------ the tabs
local BUILD = {}

function BUILD.upgrades(scroll, w)
	local entries = {}
	for _, u in ipairs(Upgrades.list) do
		local st = ShopLogic.upgrade(w, u)
		local lvl = st.level
		local now = effectText(u, u.values[lvl + 1], lvl)
		local sub = t("upgdesc." .. u.effect) .. "\n" .. now
		if lvl < u.max then
			sub ..= " → " .. effectText(u, u.values[lvl + 2], lvl + 1)
		end
		table.insert(entries, {
			key = "u:" .. u.id, progress = lvl, icon = u.icon, tint = "#F4E3C2", title = t("upg." .. u.id), sub = sub, corner = pips(lvl, u.max), st = st, order = u.order,
			onBuy = function()
				NetDef.event("BuyUpgrade"):FireServer(u.id)
			end,
		})
	end
	fill(section(scroll, 10, nil), entries)
	local ads = {}
	for _, ad in ipairs(Ads.list) do
		table.insert(ads, {
			key = "a:" .. ad.id, progress = "", icon = ad.icon, tint = "#DDE6F2", title = t("ad." .. ad.id), sub = t("ui.ad_desc", { pop = ad.popularity }), st = ShopLogic.ad(w, ad), order = ad.order,
			onBuy = function()
				NetDef.event("BuyAd"):FireServer(ad.id)
			end,
		})
	end
	fill(section(scroll, 20, "📣 " .. t("ui.ads")), ads)
end

function BUILD.recipes(scroll, w, rating)
	local entries = {}
	for _, lic in ipairs(Licenses.list) do
		local dishes = {}
		for _, rid in ipairs(lic.recipes) do
			local r = Recipes.byId[rid]
			table.insert(dishes, (r and r.icon or "") .. " " .. t("rec." .. rid))
		end
		table.insert(entries, {
			key = "l:" .. lic.id, icon = BRANCH_ICON[lic.branch] or "🎫", tint = BRANCH_TINT[lic.branch], title = t("lic." .. lic.id), sub = table.concat(dishes, "\n"),
			st = ShopLogic.license(w, lic, rating), order = lic.order,
			onBuy = function()
				NetDef.event("BuyLicense"):FireServer(lic.id)
			end,
		})
	end
	fill(section(scroll, 10, nil), entries)
end

function BUILD.staff(scroll, w)
	local L = Locale.get()
	local staff = w.staff or {}
	local slots = ShopLogic.staffSlots(w, StaffCfg, GameConfig.MaxStaff)
	local can = Core.C.Data.canBuild()
	-- the team: train or let go
	if #staff > 0 then
		local cw, ch = cardSize()
		local grid = section(scroll, 10, t("ui.staff_team", { n = #staff, max = slots }))
		for i, s in ipairs(staff) do
			local cfg = StaffCfg.byId[s.role]
			local c = Kit.card({ Name = "Card", Size = UDim2.fromOffset(cw, ch), LayoutOrder = i, Parent = grid, BackgroundColor3 = Color.hex("#FFFBF3") })
			local tile = Kit.new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.fromOffset(72, 72), BackgroundColor3 = Color.hex("#DCE7F0"), Parent = c }, { Kit.corner(36) })
			Kit.label(cfg and cfg.icon or "🧑", { Parent = tile, Position = UDim2.fromOffset(10, 10), Size = UDim2.new(1, -20, 1, -20), TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center })
			Kit.label(s.name, { Parent = c, Position = UDim2.fromOffset(8, 88), Size = UDim2.new(1, -16, 0, 22), TextSize = 17, FontFace = T.bold, TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
			Kit.label(t("staff." .. s.role) .. "\n" .. pips(s.lvl, StaffCfg.MaxTrainLevel) .. "  ·  " .. t("ui.salary", { yen = cfg and cfg.salary or 0 }), { Parent = c, Position = UDim2.fromOffset(8, 112), Size = UDim2.new(1, -16, 0, 50), TextSize = 14, TextColor3 = T.muted, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top })
			local row = Kit.new("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 8, 1, -50), Size = UDim2.new(1, -16, 0, 44), Parent = c }, { Kit.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center) })
			if cfg and s.lvl < StaffCfg.MaxTrainLevel then
				local price = Formulas.staffTrainCost(cfg.hire, s.lvl + 1)
				local rich = (w.yen or 0) >= price
				local b = Kit.button("⬆️ " .. Format.yen(price, L), { parent = row, size = UDim2.new(1, -50, 1, 0), style = (can and rich) and "gold" or "plain", textSize = 15, order = 1, onClick = function()
					if not can then
						return Core.C.UI.toast(t("ui.only_owner"), "warning")
					end
					if not rich then
						return Core.C.UI.toast(t("ui.missing", { yen = Format.yen(price - (w.yen or 0), L) }), "warning")
					end
					Kit.bump(c, 1.06)
					NetDef.event("TrainStaff"):FireServer(s.u)
				end })
				if not rich then
					b.TextColor3 = T.red
				end
			end
			Kit.button("✕", { parent = row, size = UDim2.fromOffset(44, 44), style = "plain", order = 2, onClick = function()
				if can then
					NetDef.event("FireStaff"):FireServer(s.u)
				end
			end })
		end
	end
	local entries = {}
	for _, cfg in ipairs(StaffCfg.list) do
		table.insert(entries, {
			key = "s:" .. cfg.id, progress = #staff, icon = cfg.icon, tint = "#DCE7F0", title = t("staff." .. cfg.id), sub = t("staffdesc." .. cfg.id) .. "\n" .. t("ui.salary", { yen = cfg.salary }),
			st = ShopLogic.hire(w, cfg, slots), order = cfg.order,
			onBuy = function()
				NetDef.event("HireStaff"):FireServer(cfg.id)
			end,
		})
	end
	fill(section(scroll, 30, "🤝 " .. t("ui.hire") .. "  (" .. #staff .. "/" .. slots .. ")"), entries)
end

local function expansionEntry(w, e)
	local sub = t("zonedesc." .. e.id)
	if e.ambience then
		sub ..= "\n" .. t("ui.reno_amb", { n = e.ambience })
	end
	return {
		key = "e:" .. e.id, icon = Icons.zone[e.id] or "🏗️", tint = e.reno and "#E6E1F2" or "#E2EBD6", title = t("zone." .. e.id), sub = sub,
		st = ShopLogic.expansion(w, e), order = e.order,
		onBuy = function()
			NetDef.event("BuyExpansion"):FireServer(e.id)
		end,
	}
end

function BUILD.rooms(scroll, w)
	local entries = {}
	for _, e in ipairs(Expansions.list) do
		if e.id ~= "zone_base" and not e.reno then
			table.insert(entries, expansionEntry(w, e))
		end
	end
	fill(section(scroll, 10, nil), entries)
end

function BUILD.reno(scroll, w)
	Kit.label(t("ui.reno_hint"), { Parent = scroll, Size = UDim2.new(1, -8, 0, 40), TextSize = 15, TextColor3 = T.muted, LayoutOrder = 1 })
	for gi, g in ipairs(RENO_GROUPS) do
		local entries, done, total = {}, 0, 0
		for _, e in ipairs(Expansions.list) do
			if e.reno == g.id then
				table.insert(entries, expansionEntry(w, e))
				total += 1
				if w.zones and w.zones[e.id] then
					done += 1
				end
			end
		end
		fill(section(scroll, gi * 10, t(g.key) .. "  " .. done .. "/" .. total), entries)
	end
end

------------------------------------------------------------------ the screen
local screen
screen = Base.make("Shop", "ui.shop", UDim2.fromScale(0.8, 0.84), function(content, s)
	if s.arg and BUILD[s.arg] then
		tab = s.arg
		s.arg = nil
	end
	local Data = Core.C.Data
	local w = Data.restaurant()
	local rating = Data.plotAttr("Rating") or 3
	local phone = Kit.profile == "phone"
	local tabs = {}
	for _, tb in ipairs(TABS) do
		table.insert(tabs, { id = tb.id, label = tb.icon .. " " .. t(tb.key), width = phone and 180 or (Kit.profile == "tablet" and 170 or 190), textSize = phone and 15 or 16 })
	end
	local _, _, badges = Kit.tabs(content, tabs, function(id)
		tab = id
		screen.refresh()
	end, tab, 44)
	local _, counts = ShopLogic.buyable(w, CFG, rating)
	if Data.canBuild() then
		for id, set in pairs(badges) do
			set(counts[id] or 0)
		end
	end
	-- the money to spend, in the title bar (on phones the window covers the wallet)
	local header = s.win.header
	local money = header:FindFirstChild("Money")
	if not money then
		money = Kit.new("Frame", { Name = "Money", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -60, 0.5, -1), Size = UDim2.fromOffset(0, 34), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = T.paper, Parent = header }, { Kit.corner(17), Kit.padding(14, 0), Kit.stroke(T.gold, 2, 0.1) })
		Kit.label("", { Name = "Amount", Parent = money, Size = UDim2.fromOffset(0, 34), AutomaticSize = Enum.AutomaticSize.X, TextSize = 20, FontFace = T.title, TextColor3 = T.wood, TextWrapped = false })
	end
	money:FindFirstChild("Amount").Text = Format.yen(Data.wallet(), Locale.get())
	local top = 50
	if not Data.canBuild() then
		Kit.label("🔒 " .. t("ui.only_owner"), { Parent = content, Position = UDim2.fromOffset(0, 48), Size = UDim2.new(1, 0, 0, 24), TextSize = 15, FontFace = T.bold, TextColor3 = T.red })
		top = 74
	end
	local scroll = Kit.scroll({ Name = "Cards_" .. tab, Position = UDim2.fromOffset(0, top), Size = UDim2.new(1, 0, 1, -top), Parent = content })
	BUILD[tab](scroll, w, rating)
end)

return screen
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000139"><Properties><string name="Name">Supplier</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Supplier tablet: order boxes of ingredients and dish sets.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local NetDef = require(Shared.Net)
local Locale = require(Shared.Locale)
local Format = require(Shared.Util.Format)
local Ingredients = require(Shared.Config.Ingredients)
local Recipes = require(Shared.Config.Recipes)
local Upgrades = require(Shared.Config.Upgrades)
local GameConfig = require(Shared.Config.GameConfig)
local Kit = require(script.Parent.Parent.Kit)
local Base = require(script.Parent.Parent.Base)
local Core = require(script.Parent.Parent.Parent.Core)

local t = Locale.t
local T = Kit.Theme
local cart = {}

local function unlocked(w, ing)
	if w.licenses and w.licenses[ing.license] then
		return true
	end
	for _, r in ipairs(Recipes.list) do
		if r.city and w.franchise and r.city == w.franchise.city and table.find(r.ing, ing.id) then
			return true
		end
	end
	return false
end

local function stock(w, g)
	local shelf, boxes = 0, 0
	for _, slots in pairs(w.shelves or {}) do
		for _, s in pairs(slots) do
			if s.g == g then
				shelf += s.n
			end
		end
	end
	for _, b in ipairs(w.storage or {}) do
		if b.g == g then
			boxes += 1
		end
	end
	return shelf, boxes
end

-- the ingredients the dishes on the menu need and that are running low (calls add(g) for each)
local function lowForMenu(w, add)
	for id, m in pairs(w.menu or {}) do
		local r = Recipes.byId[id]
		if r and m.on then
			local need = table.clone(r.ing)
			if r.broth then
				table.insert(need, r.broth)
			end
			if r.rice then
				table.insert(need, "rice")
			end
			for _, g in ipairs(need) do
				local ing = Ingredients.byId[g]
				if ing and unlocked(w, ing) then
					local shelf, boxes = stock(w, g)
					if shelf + boxes * ing.units < ing.units / 2 then
						add(g)
					end
				end
			end
		end
	end
end

-- one box of every ingredient the dishes on the menu need and that is running low
local function cartForMenu(w)
	lowForMenu(w, function(g)
		local q = cart[g] or { small = 0, big = 0 }
		q.small = math.max(q.small, 1)
		cart[g] = q
	end)
end

local screen
screen = Base.make("Supplier", "ui.supplier", UDim2.fromScale(0.72, 0.78), function(content)
	local w = Core.C.Data.restaurant()
	local discount = Upgrades.value(w.upgrades, "up_supplier")
	local L = Locale.get()
	local header = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), Parent = content })
	Kit.label(t("ui.supplier_info", { boxes = #(w.storage or {}) }), { Parent = header, Size = UDim2.new(1, 0, 1, 0), TextSize = 16, TextColor3 = T.muted })
	local scroll = Kit.scroll({ Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 1, -100), Parent = content }, Kit.grid(200, discount > 0 and 170 or 140, 8))
	local total = 0
	for _, ing in ipairs(Ingredients.list) do
		if unlocked(w, ing) then
			local q = cart[ing.id] or { small = 0, big = 0 }
			total += q.small * ing.price + math.floor(q.big * ing.price * GameConfig.BigBoxMultiplier * (1 - discount) + 0.5)
			local card = Kit.card({ Size = UDim2.fromOffset(200, 140), LayoutOrder = ing.order, Parent = scroll })
			Kit.label(ing.icon, { Parent = card, Size = UDim2.fromOffset(36, 36), Position = UDim2.fromOffset(8, 6), TextScaled = true })
			Kit.label(t("ing." .. ing.id), { Parent = card, Position = UDim2.fromOffset(50, 6), Size = UDim2.new(1, -56, 0, 22), TextSize = 17, FontFace = T.bold, TextTruncate = Enum.TextTruncate.AtEnd })
			local shelf, boxes = stock(w, ing.id)
			Kit.label("🗄️ " .. shelf .. "   📦 " .. boxes, { Parent = card, Position = UDim2.fromOffset(50, 28), Size = UDim2.new(1, -56, 0, 18), TextSize = 14, TextColor3 = T.muted })
			local function qtyRow(y, kind, label, price)
				Kit.label(label .. "  " .. Format.yen(price, L), { Parent = card, Position = UDim2.fromOffset(8, y), Size = UDim2.new(1, -16, 0, 18), TextSize = 14 })
				local row = Kit.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(8, y + 20), Size = UDim2.new(1, -16, 0, 30), Parent = card }, { Kit.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center) })
				Kit.button("−", { parent = row, size = UDim2.fromOffset(36, 28), style = "plain", order = 1, onClick = function()
					q[kind] = math.max(0, q[kind] - 1)
					cart[ing.id] = q
					screen.refresh()
				end })
				Kit.label(tostring(q[kind]), { Parent = row, Size = UDim2.fromOffset(34, 28), TextXAlignment = Enum.TextXAlignment.Center, FontFace = T.bold, LayoutOrder = 2 })
				Kit.button("+", { parent = row, size = UDim2.fromOffset(36, 28), style = "green", order = 3, onClick = function()
					q[kind] = math.min(30, q[kind] + 1)
					cart[ing.id] = q
					screen.refresh()
				end })
			end
			qtyRow(52, "small", t("ui.box_units", { n = ing.units }), ing.price)
			if discount > 0 then
				card.Size = UDim2.fromOffset(200, 170)
				qtyRow(104, "big", t("ui.big_box_units", { n = ing.units * GameConfig.BigBoxMultiplier }), math.floor(ing.price * GameConfig.BigBoxMultiplier * (1 - discount) + 0.5))
			end
		end
	end
	local footer = Kit.new("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 1, -58), Size = UDim2.new(1, 0, 0, 56), Parent = content })
	Kit.label(t("ui.total") .. ": " .. Format.yen(total, L), { Parent = footer, Size = UDim2.new(0.3, 0, 1, 0), TextSize = 22, FontFace = T.title })
	-- the easy way: everything the menu needs (stands out when something is running low)
	local guided = false
	lowForMenu(w, function()
		guided = true
	end)
	local menuBtn = Kit.button((guided and "👉 " or "") .. "🍜 " .. t("ui.cart_menu"), {
		parent = footer, size = UDim2.fromOffset(190, 46), position = UDim2.new(1, -600, 0, 5), style = guided and "gold" or "plain", textSize = 15,
		onClick = function()
			cartForMenu(w)
			screen.refresh()
		end,
	})
	if guided then
		Kit.stroke(T.red, 3).Parent = menuBtn
	end
	Kit.button("🍽️ " .. t("ui.buy_dishes", { n = GameConfig.DishSetSize, price = GameConfig.DishSetPrice }), {
		parent = footer, size = UDim2.fromOffset(220, 46), position = UDim2.new(1, -400, 0, 5), style = "gold", textSize = 15,
		onClick = function()
			NetDef.event("BuyDishes"):FireServer(1)
		end,
	})
	Kit.button("🚚 " .. t("ui.order"), {
		parent = footer, size = UDim2.fromOffset(170, 46), position = UDim2.new(1, -170, 0, 5), style = "green", disabled = total == 0,
		onClick = function()
			NetDef.event("OrderSupplies"):FireServer(cart)
			cart = {}
			screen.refresh()
		end,
	})
end)

return screen
]]></ProtectedString></Properties></Item></Item></Item></Item></Item></Item><Item class="Workspace" referent="RBX000145"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">false</bool></Properties></Item><Item class="Lighting" referent="RBX000146"><Properties><string name="Name">Lighting</string><token name="Technology">4</token><bool name="GlobalShadows">true</bool><float name="Brightness">2.4</float><float name="EnvironmentDiffuseScale">1</float><float name="EnvironmentSpecularScale">1</float><float name="ClockTime">10</float></Properties></Item><Item class="SoundService" referent="RBX000147"><Properties><string name="Name">SoundService</string></Properties></Item></roblox>